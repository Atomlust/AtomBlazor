@page "/recipes/mobile-shop"
@page "/components/mobile-controls"
@using AtomBlazor.Icons.Lucide

<PageTitle>@L.T("移动商城 - 配方 - Atom BlazorUI", "Mobile Shop - Recipes - Atom BlazorUI")</PageTitle>
<div class="max-w-4xl space-y-8">
    <div class="space-y-3">
        <a href="/recipes" class="text-sm text-muted-foreground hover:text-foreground">@L.T("配方", "Recipes")</a>
        <h1 class="text-4xl font-bold tracking-tight">@L.T("移动商城", "Mobile Shop")</h1>
        <p class="text-xl text-muted-foreground">@L.T("把导航、通知计数与数量编辑整合进一个小型购物体验。", "Combine navigation, notification counts and quantity editing into a small shopping experience.")</p>
    </div>
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("商店预览", "Shop preview")</h2>
        <p class="text-sm text-muted-foreground">@L.T("在 Home 浏览商品，在 Cart 管理数量，在 Account 查看偏好设置与示例订单。三个界面共享同一份状态。", "Browse products on Home, manage quantities in Cart, and view preferences and demo orders in Account. State is shared between all three screens.")</p>
<div class="mx-auto max-w-md overflow-hidden rounded-2xl border bg-background shadow-sm">
    <AppBar Title="@(L.T("原子小店", "Atom shop"))" Description="@(L.T("点亮好点子的日常工具", "Everyday tools for bright ideas"))" Sticky="false" ShowBack="@(mobileTab != "home")" OnBack="@(() => mobileTab = "home")">
        <Actions><NotificationBadge Count="cartCount"><Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" aria-label="@(L.T("打开购物车", "Open shopping cart"))" OnClick="@(() => mobileTab = "cart")"><LucideIcon Name="shopping-bag" Size="20" /></Button></NotificationBadge></Actions>
    </AppBar>
    <div class="min-h-96 space-y-5 p-5">
        @if (mobileTab == "home")
        {
            <div class="rounded-xl bg-primary/10 p-5 space-y-2">
                <span class="text-xs font-semibold uppercase tracking-wider text-primary">@L.T("桌面精选", "The desk edit")</span>
                <h3 class="text-2xl font-semibold">@L.T("为下一个灵感腾出空间。", "Make room for your next idea.")</h3>
                <p class="text-sm text-muted-foreground">@L.T("为笔记、草图与新的开始准备的称手小物。", "Thoughtful essentials for notes, sketches and fresh starts.")</p>
            </div>
            <SectionHeader Title="@(L.T("精选好物", "Featured essentials"))" Description="@(L.T("小工具，大可能。", "Small tools. Big possibilities."))" />
            <div class="grid grid-cols-2 gap-3">
                @foreach (var product in products)
                {
                    <div class="rounded-xl border overflow-hidden">
                        <div class="flex h-24 items-center justify-center bg-muted"><LucideIcon Name="@product.Icon" Size="40" Class="text-primary" /></div>
                        <div class="space-y-3 p-3">
                            <div><h3 class="font-medium text-sm">@product.Name</h3><p class="text-sm text-muted-foreground">$@product.Price</p></div>
                            <Button Size="ButtonSize.Small" Variant="ButtonVariant.Outline" Class="w-full" Disabled="@(Quantity(product.Id) >= 10)" OnClick="@(() => AddProduct(product.Id))">@L.T("加入购物车", "Add to cart")</Button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (mobileTab == "cart")
        {
            <SectionHeader Title="@(L.T("你的购物车", "Your cart"))" Description="@(L.T("下示例订单前先核对商品。", "Review your items before placing a demo order."))" Separator="true" />
            @if (cartCount == 0)
            {
                <div class="py-8 text-center space-y-3">
                    <LucideIcon Name="shopping-bag" Size="40" Class="mx-auto text-muted-foreground" />
                    <h3 class="font-semibold">@L.T("购物车还是空的", "Your cart is empty")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("为你的下一个项目挑点东西。", "Find something for your next project.")</p>
                    <Button OnClick="@(() => mobileTab = "home")">@L.T("去逛精选好物", "Browse essentials")</Button>
                </div>
            }
            else
            {
                @foreach (var product in products.Where(product => Quantity(product.Id) > 0))
                {
                    <div @key="product.Id" class="space-y-3 border-b pb-4">
                        <div class="flex items-center gap-3"><div class="rounded-lg bg-muted p-3"><LucideIcon Name="@product.Icon" Size="24" /></div><div class="flex-1"><h3 class="font-medium">@product.Name</h3><p class="text-sm text-muted-foreground">$@product.Price @L.T("每件", "each")</p></div><span class="font-medium">$@(Quantity(product.Id) * product.Price)</span></div>
                        <QuantityStepper Value="@Quantity(product.Id)" ValueChanged="@(value => quantities[product.Id] = value)" Min="1" Max="10" OnRemove="@(() => quantities.Remove(product.Id))" AriaLabel="@(product.Name + (L.IsChinese ? " 数量" : " quantity"))" />
                    </div>
                }
                <div class="flex justify-between font-semibold"><span>@L.T("合计", "Total")</span><span>$@cartTotal</span></div>
                <Button Class="w-full" OnClick="PlaceDemoOrder">@L.T("下示例订单", "Place demo order")</Button>
                <p class="text-xs text-muted-foreground">@L.T("仅预览用，不收集付款或个人信息。", "Preview only. No payment or personal details are collected.")</p>
            }
        }
        else
        {
            <div class="flex items-center gap-3 rounded-xl bg-muted p-4"><div class="rounded-full bg-background p-3"><LucideIcon Name="user" Size="28" /></div><div><h3 class="font-semibold">Alex Morgan</h3><p class="text-sm text-muted-foreground">@L.T("示例会员账户", "Sample member account")</p></div></div>
            <SectionHeader Title="@(L.T("偏好设置", "Preferences"))" Description="@(L.T("设置只保存在这个预览里。", "Settings stay in this preview."))" Separator="true" />
            <div class="flex items-center justify-between gap-4"><AtomBlazor.Label For="shop-updates">@L.T("产品更新", "Product updates")</AtomBlazor.Label><Switch Id="shop-updates" @bind-Checked="productUpdates" /></div>
            <div class="rounded-xl border p-4 space-y-2"><h3 class="font-medium">@L.T("示例订单", "Demo orders")</h3><p class="text-sm text-muted-foreground">@(orders == 0 ? L.T("还没有订单。从 Home 加入一件商品即可体验购物流程。", "No orders yet. Add an item from Home to try the shopping flow.") : L.IsChinese ? $"你在本次会话中已下 {orders} 笔示例订单。" : $"You placed {orders} demo order(s) in this session.")</p></div>
        }
        <p role="status" class="text-sm text-primary">@message</p>
    </div>
    <BottomNav @bind-Value="mobileTab" Fixed="false" AriaLabel="@(L.T("商店导航", "Shop navigation"))">
        <BottomNavItem Value="home" Label="@(L.T("首页", "Home"))"><Icon><LucideIcon Name="house" Size="20" /></Icon></BottomNavItem>
        <BottomNavItem Value="cart" Label="@(L.T("购物车", "Cart"))"><Icon><NotificationBadge Count="cartCount"><LucideIcon Name="shopping-bag" Size="20" /></NotificationBadge></Icon></BottomNavItem>
        <BottomNavItem Value="account" Label="@(L.T("账户", "Account"))"><Icon><LucideIcon Name="user" Size="20" /></Icon></BottomNavItem>
    </BottomNav>
</div>
        <CodeBlock Source="Recipes/MobileShop/shop.txt" />
    </section>
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("组件如何组合在一起", "How it fits together")</h2>
        <p>@L.T("配方自身掌管当前界面、商品与购物车。底部导航切换界面；数量步进器更新或移除购物车条目；通知徽标显示总数量。", "The recipe owns the active screen, products and cart. Bottom Navigation changes screens; Quantity Stepper updates or removes cart entries; Notification Badge shows the total quantity.")</p>
        <p class="text-sm text-muted-foreground">@L.T("本预览里 BottomNav 使用 Fixed=false。若要视口固定的导航，请在页面内容下方预留空间。安全区内边距需要在全屏移动端布局中设置 viewport-fit=cover。", "BottomNav uses Fixed=false in this preview. For viewport-fixed navigation, reserve space below page content. Safe-area padding requires viewport-fit=cover in full-screen mobile layouts.")</p>
        <div class="flex flex-wrap gap-3">
            <a href="/components/app-bar" class="text-primary underline">App Bar</a>
            <a href="/components/bottom-nav" class="text-primary underline">Bottom Navigation</a>
            <a href="/components/notification-badge" class="text-primary underline">Notification Badge</a>
            <a href="/components/quantity-stepper" class="text-primary underline">Quantity Stepper</a>
            <a href="/components/section-header" class="text-primary underline">Section Header</a>
        </div>
    </section>
    <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>@L.T("商店导航有自己的标签，并标识当前所在界面。图标按钮都带有无障碍名称。", "The shop navigation has its own label and identifies the current screen. Icon buttons have accessible names.")</AccessibilityItem>
            <AccessibilityItem>@L.T("每个数量输入控件都会标识所属商品。一个状态区域会播报加入购物车与完成示例订单。", "Each quantity input identifies its product. A status region announces additions and completed demo orders.")</AccessibilityItem>
        </AriaAttributes>
        <KeyboardNavigation>
            <KeyboardShortcutItem Description="@(L.T("在商店控件之间移动", "Move between shop controls"))"><Kbd>Tab / Shift + Tab</Kbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("激活按钮或复选框样式的控件", "Activate a button or checkbox-style control"))"><Kbd>Enter / Space</Kbd></KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    private string mobileTab = "home";
    private bool productUpdates = true;
    private int orders;
    private string message = "";
    private readonly Dictionary<string, int> quantities = [];
    private readonly Product[] products = [new("notebook", "Everyday notebook", "notebook-pen", 12), new("pencils", "Sketch pencils", "pencil", 8)];
    private int cartCount => quantities.Values.Sum();
    private int cartTotal => products.Sum(product => Quantity(product.Id) * product.Price);
    private int Quantity(string id) => quantities.GetValueOrDefault(id);
    private void AddProduct(string id)
    {
        quantities[id] = Math.Min(10, Quantity(id) + 1);
        message = L.IsChinese ? "已加入购物车。" : "Added to your cart.";
    }
    private void PlaceDemoOrder()
    {
        orders++;
        quantities.Clear();
        message = L.IsChinese ? "示例订单已下单，谢谢！" : "Demo order placed. Thank you!";
        mobileTab = "account";
    }
    private sealed record Product(string Id, string Name, string Icon, int Price);
}
