@page "/recipes"

<PageTitle>@L.T("配方 - Atom BlazorUI", "Recipes - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <h1 class="text-4xl font-bold">@L.T("配方", "Recipes")</h1>
        <p class="text-xl text-muted-foreground">
            @L.T("把多个组件组合成生产可用方案的真实场景模式。每个配方都演示各组件如何协作，来解决常见的界面挑战。", "Real-world patterns that combine multiple components into production-ready solutions. Each recipe demonstrates how components work together to solve common UI challenges.")
        </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
        <a href="recipes/filterable-datagrid" class="group block rounded-lg border bg-card p-6 transition-colors hover:bg-accent hover:text-accent-foreground">
            <div class="space-y-2">
                <h3 class="text-lg font-semibold group-hover:underline">@L.T("可筛选数据网格", "Filterable Data Grid")</h3>
                <p class="text-sm text-muted-foreground">
                    @L.T("将筛选构建器与数据网格结合，打造强大、可交互的数据探索界面，内含 1,000 条员工记录。", "Combine the Filter Builder with a Data Grid to create a powerful, interactive data exploration interface with 1,000 employee records.")
                </p>
            </div>
        </a>
        <a href="recipes/mobile-shop" class="group block rounded-lg border bg-card p-6 transition-colors hover:bg-accent hover:text-accent-foreground">
            <div class="space-y-2">
                <h3 class="text-lg font-semibold group-hover:underline">@L.T("移动商城", "Mobile Shop")</h3>
                <p class="text-sm text-muted-foreground">@L.T("使用应用栏、底部导航、通知徽标、数量步进器与分区标题，组合出商品目录、购物车与账户三个界面。", "Compose a product catalog, shopping cart and account screens with App Bar, Bottom Navigation, Notification Badge, Quantity Stepper and Section Header.")</p>
            </div>
        </a>
    </div>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;
}
