@page "/charts/pie"
@using AtomBlazor.Icons.Lucide
<PageTitle>@L.T("饼图 - Atom BlazorUI", "Pie Chart - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-6xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("饼图", "Pie Chart")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("用圆形图呈现占比与部分对整体的关系。", "Show proportions and part-to-whole relationships with circular visualizations.")
            </p>
        </div>
    </div>

    <!-- Grid of chart variants -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- Pie Chart -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("饼图", "Pie Chart")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <PieChart Data="@_browserData" Height="250px">
                        <ChartTooltip />
                        <Pie DataKey="visitors" NameKey="browser" />
                    </PieChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月增长 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/PieChart/default.txt" />
        </div>

        <!-- Separator None -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("饼图 - 无分隔线", "Pie Chart - Separator None")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <PieChart Data="@_browserData" Height="250px">
                        <ChartTooltip />
                        <Pie DataKey="visitors" NameKey="browser" PaddingAngle="0" />
                    </PieChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月增长 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/PieChart/separator-none.txt" />
        </div>

        <!-- Label -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("饼图 - 显示标签", "Pie Chart - Label")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <PieChart Data="@_browserData" Height="250px">
                        <ChartTooltip />
                        <Pie DataKey="visitors" NameKey="browser"
                             ShowLabels="true" LabelFormatter="{c}" />
                    </PieChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月增长 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/PieChart/label.txt" />
        </div>

        <!-- Custom Label -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("饼图 - 自定义标签", "Pie Chart - Custom Label")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <PieChart Data="@_browserData" Height="250px">
                        <ChartTooltip />
                        <Pie DataKey="visitors" NameKey="browser" OuterRadius="70"
                             ShowLabels="true" LabelFormatter="{c}" />
                    </PieChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月增长 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/PieChart/custom-label.txt" />
        </div>

        <!-- Label List -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("饼图 - 标签列表", "Pie Chart - Label List")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <PieChart Data="@_browserData" Height="250px">
                        <ChartTooltip />
                        <Pie DataKey="visitors" NameKey="browser"
                             ShowLabels="true" LabelPosition="LabelPosition.Inside" LabelFormatter="{b}"
                             LabelColor="white" LabelFontSize="10" />
                    </PieChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月增长 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/PieChart/label-list.txt" />
        </div>

        <!-- Legend -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("饼图 - 图例", "Pie Chart - Legend")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <PieChart Data="@_browserData" Height="250px">
                        <ChartTooltip />
                        <ChartLegend />
                        <Pie DataKey="visitors" NameKey="browser" />
                    </PieChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月增长 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/PieChart/legend.txt" />
        </div>

        <!-- Donut -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("饼图 - 环形图", "Pie Chart - Donut")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <PieChart Data="@_browserData" Height="250px">
                        <ChartTooltip />
                        <Pie DataKey="visitors" NameKey="browser" InnerRadius="60" />
                    </PieChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月增长 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/PieChart/donut.txt" />
        </div>

        <!-- Donut Active -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("饼图 - 环形图高亮扇区", "Pie Chart - Donut Active")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <PieChart Data="@_browserData" Height="250px">
                        <ChartTooltip />
                        <Pie DataKey="visitors" NameKey="browser" InnerRadius="60" ActiveIndex="0" />
                    </PieChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月增长 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/PieChart/donut-active.txt" />
        </div>

        <!-- Donut with Text -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("饼图 - 环形图带中心文字", "Pie Chart - Donut with Text")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <PieChart Data="@_browserData" Height="250px">
                        <ChartTooltip />
                        <Pie DataKey="visitors" NameKey="browser" InnerRadius="60">
                            <CenterLabel Value="@_browserData.Sum(d => d.Visitors).ToString("N0")" Title="@(L.T("访客", "Visitors"))" />
                        </Pie>
                    </PieChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月增长 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/PieChart/donut-text.txt" />
        </div>

        <!-- Stacked -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("饼图 - 堆叠", "Pie Chart - Stacked")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <PieChart Data="@_stackedData" Height="250px">
                        <ChartTooltip />
                        <Pie DataKey="desktop" NameKey="month" InnerRadius="60" OuterRadius="80" />
                        <Pie DataKey="mobile" NameKey="month" InnerRadius="25" OuterRadius="50" />
                    </PieChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月增长 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/PieChart/stacked.txt" />
        </div>

        <!-- Interactive -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex items-start justify-between p-6">
                    <div class="flex flex-col space-y-1.5">
                        <h3 class="font-semibold leading-none tracking-tight">@L.T("饼图 - 交互式", "Pie Chart - Interactive")</h3>
                        <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                    </div>
                    <select @bind="_selectedBrowser" @bind:event="onchange"
                            class="text-sm border rounded-lg px-3 py-1.5 bg-card">
                        @foreach (var item in _browserData)
                        {
                            <option value="@item.Browser">@item.Browser</option>
                        }
                    </select>
                </div>
                <div class="p-6 pt-0">
                    <PieChart Data="@_browserData" Height="250px">
                        <ChartTooltip />
                        <Pie DataKey="visitors" NameKey="browser" InnerRadius="60"
                             ActiveIndex="@SelectedIndex">
                            <CenterLabel Value="@SelectedVisitors.ToString("N0")" Title="@(L.T("访客", "Visitors"))" />
                        </Pie>
                    </PieChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月增长 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/PieChart/interactive.txt" />
        </div>

    </div>

    <!-- API Reference -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
        </div>
        <div class="border rounded-lg p-6 space-y-4">
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Pie.DataKey</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    @L.T("类型：", "Type:") <code class="text-xs bg-muted px-1 py-0.5 rounded">string</code>
                </p>
                <p class="text-sm text-muted-foreground">
                    @L.T("扇区数值对应的属性名。", "The property name for slice values.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Pie.NameKey</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    @L.T("类型：", "Type:") <code class="text-xs bg-muted px-1 py-0.5 rounded">string</code>
                </p>
                <p class="text-sm text-muted-foreground">
                    @L.T("扇区标签对应的属性名。", "The property name for slice labels.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Pie.InnerRadius</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    @L.T("类型：", "Type:") <code class="text-xs bg-muted px-1 py-0.5 rounded">int</code> — @L.T("默认值：", "Default:") <code class="text-xs bg-muted px-1 py-0.5 rounded">0</code>
                </p>
                <p class="text-sm text-muted-foreground">
                    @L.T("内半径的百分比。设为大于 0 即成为环形图。", "Inner radius as a percentage. Set greater than 0 for a donut chart.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Pie.OuterRadius</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    @L.T("类型：", "Type:") <code class="text-xs bg-muted px-1 py-0.5 rounded">int</code> — @L.T("默认值：", "Default:") <code class="text-xs bg-muted px-1 py-0.5 rounded">80</code>
                </p>
                <p class="text-sm text-muted-foreground">
                    @L.T("外半径的百分比，以图表容器为基准。", "Outer radius as a percentage of the chart container.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Pie.PaddingAngle</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    @L.T("类型：", "Type:") <code class="text-xs bg-muted px-1 py-0.5 rounded">int</code> — @L.T("默认值：", "Default:") <code class="text-xs bg-muted px-1 py-0.5 rounded">2</code>
                </p>
                <p class="text-sm text-muted-foreground">
                    @L.T("扇区之间分隔边的像素宽度。设为 0 即无分隔。", "Border width between slices in pixels. Set to 0 for no separator.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Pie.ShowLabels</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    @L.T("类型：", "Type:") <code class="text-xs bg-muted px-1 py-0.5 rounded">bool</code> — @L.T("默认值：", "Default:") <code class="text-xs bg-muted px-1 py-0.5 rounded">false</code>
                </p>
                <p class="text-sm text-muted-foreground">
                    @L.T("是否在每个扇区上显示标签。", "Whether to display labels on each slice.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Pie.LabelFormatter</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    @L.T("类型：", "Type:") <code class="text-xs bg-muted px-1 py-0.5 rounded">string?</code>
                </p>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground">
                        ECharts 的格式化字符串。用 <code class="text-xs bg-muted px-1 py-0.5 rounded">{b}</code> 表示名称，
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">{c}</code> 表示数值，
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">{d}</code> 表示百分比。
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground">
                        ECharts formatter string. Use <code class="text-xs bg-muted px-1 py-0.5 rounded">{b}</code> for name,
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">{c}</code> for value,
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">{d}</code> for percentage.
                    </p>
                                </text>
}
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Pie.ActiveIndex</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    @L.T("类型：", "Type:") <code class="text-xs bg-muted px-1 py-0.5 rounded">int?</code>
                </p>
                <p class="text-sm text-muted-foreground">
                    @L.T("预选（激活）扇区的索引，该扇区会从中心向外偏移。", "Index of the pre-selected (active) slice, offset from center.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">CenterLabel</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    @L.T("类型：", "Type:") <code class="text-xs bg-muted px-1 py-0.5 rounded">component</code>
                </p>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground">
                        <code>Pie</code> 的子元素。在环形中心显示 <code class="text-xs bg-muted px-1 py-0.5 rounded">Value</code>（大号加粗）与
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">Title</code>（小号 muted）。
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground">
                        Child of Pie. Displays <code class="text-xs bg-muted px-1 py-0.5 rounded">Value</code> (large, bold) and
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">Title</code> (small, muted) in the donut center.
                    </p>
                                </text>
}
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    public class BrowserData
    {
        public string Browser { get; set; } = "";
        public int Visitors { get; set; }
    }

    private readonly List<BrowserData> _browserData =
    [
        new() { Browser = "Chrome", Visitors = 275 },
        new() { Browser = "Safari", Visitors = 200 },
        new() { Browser = "Firefox", Visitors = 187 },
        new() { Browser = "Edge", Visitors = 173 },
        new() { Browser = "Other", Visitors = 90 }
    ];

    public class MonthlyDeviceData
    {
        public string Month { get; set; } = "";
        public int Desktop { get; set; }
        public int Mobile { get; set; }
    }

    private readonly List<MonthlyDeviceData> _stackedData =
    [
        new() { Month = "January", Desktop = 186, Mobile = 80 },
