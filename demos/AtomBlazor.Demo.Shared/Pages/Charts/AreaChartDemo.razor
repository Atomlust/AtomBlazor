@page "/charts/area"
@using AtomBlazor.Icons.Lucide
<PageTitle>@L.T("面积图 - Atom BlazorUI", "Area Chart - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-6xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("面积图", "Area Chart")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("用填充面积呈现数据，突出随时间累积的总量与幅度。", "Visualize data with filled areas that emphasize volume and magnitude over time.")
            </p>
        </div>
    </div>

    <!-- Interactive Area Chart (full width hero) -->
    <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
        <div class="flex items-center justify-between p-6">
            <div class="flex flex-col space-y-1.5">
                <h3 class="font-semibold leading-none tracking-tight">@L.T("面积图 - 交互示例", "Area Chart - Interactive")</h3>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground">展示最近 @(_subtitleTextZh)的访客总量</p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground">Showing total visitors for the @_subtitleText</p>
                                </text>
}
            </div>
            @if (L.IsChinese)
            {
                        <text>
                            <Select TValue="string" Value="@_selectedRange" ValueChanged="OnRangeChanged"
                        Options="@_zhRangeOptions" Class="w-[160px]" />
                        </text>
}
            else
            {
                        <text>
                            <Select TValue="string" Value="@_selectedRange" ValueChanged="OnRangeChanged"
                        Options="@_rangeOptions" Class="w-[160px]" />
                        </text>
}
        </div>
        <div class="p-6 pt-0">
            <AreaChart Data="@_filteredChartData" Height="300px">
                <XAxis DataKey="date" />
                <YAxis />
                <ChartTooltip />
                <ChartLegend />
                <AtomBlazor.Area DataKey="desktop" Name="@(L.T("桌面端", "Desktop"))" Color="var(--chart-1)" Curve="CurveType.Smooth" Stacked="true">
                    <Fill>
                        <LinearGradient>
                            <GradientStop Offset="0" Color="var(--chart-1)" Opacity="0.6" />
                            <GradientStop Offset="1" Color="var(--chart-1)" Opacity="0.05" />
                        </LinearGradient>
                    </Fill>
                </AtomBlazor.Area>
                <AtomBlazor.Area DataKey="mobile" Name="@(L.T("移动端", "Mobile"))" Color="var(--chart-2)" Curve="CurveType.Smooth" Stacked="true">
                    <Fill>
                        <LinearGradient>
                            <GradientStop Offset="0" Color="var(--chart-2)" Opacity="0.6" />
                            <GradientStop Offset="1" Color="var(--chart-2)" Opacity="0.05" />
                        </LinearGradient>
                    </Fill>
                </AtomBlazor.Area>
            </AreaChart>
        </div>
        <div class="flex flex-col gap-2 p-6 pt-0">
            <div class="flex gap-2 items-center font-medium leading-none">
                @L.T("本月上升 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
            </div>
            <div class="text-sm text-muted-foreground leading-none">
                @if (L.IsChinese)
                {
                                <text>
                                    @(_dateRangeTextZh)
                                </text>
}
                else
                {
                                <text>
                                    @_dateRangeText
                                </text>
}
            </div>
        </div>
    </div>
    <CodeBlock Source="Charts/AreaChart/interactive.txt" />

    <!-- Grid of chart variants -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- Default (Smooth) -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("面积图", "Area Chart")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")</p>
                </div>
                <div class="p-6 pt-0">
                    <AreaChart Data="@_monthlyData" Height="200px">
                        <XAxis DataKey="month" />
                        <YAxis Show="false" />
                        <ChartTooltip />
                        <AtomBlazor.Area DataKey="desktop" Name="@(L.T("桌面端", "Desktop"))" Color="var(--chart-1)" Curve="CurveType.Smooth">
                            <Fill>
                                <LinearGradient>
                                    <GradientStop Offset="0" Color="var(--chart-1)" Opacity="0.4" />
                                    <GradientStop Offset="1" Color="var(--chart-1)" Opacity="0.05" />
                                </LinearGradient>
                            </Fill>
                        </AtomBlazor.Area>
                    </AreaChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月上升 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("2024 年 1 月 - 6 月", "January - June 2024")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/AreaChart/default.txt" />
        </div>

        <!-- Linear -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("面积图 - 线性", "Area Chart - Linear")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")</p>
                </div>
                <div class="p-6 pt-0">
                    <AreaChart Data="@_monthlyData" Height="200px">
                        <XAxis DataKey="month" />
                        <YAxis Show="false" />
                        <ChartTooltip />
                        <AtomBlazor.Area DataKey="desktop" Name="@(L.T("桌面端", "Desktop"))" Color="var(--chart-1)">
                            <Fill>
                                <LinearGradient>
                                    <GradientStop Offset="0" Color="var(--chart-1)" Opacity="0.4" />
                                    <GradientStop Offset="1" Color="var(--chart-1)" Opacity="0.05" />
                                </LinearGradient>
                            </Fill>
                        </AtomBlazor.Area>
                    </AreaChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月上升 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("2024 年 1 月 - 6 月", "January - June 2024")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/AreaChart/linear.txt" />
        </div>

        <!-- Step -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("面积图 - 阶梯", "Area Chart - Step")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")</p>
                </div>
                <div class="p-6 pt-0">
                    <AreaChart Data="@_monthlyData" Height="200px">
                        <XAxis DataKey="month" />
                        <YAxis Show="false" />
                        <ChartTooltip />
                        <AtomBlazor.Area DataKey="desktop" Name="@(L.T("桌面端", "Desktop"))" Color="var(--chart-1)" Curve="CurveType.Step">
                            <Fill>
                                <LinearGradient>
                                    <GradientStop Offset="0" Color="var(--chart-1)" Opacity="0.4" />
                                    <GradientStop Offset="1" Color="var(--chart-1)" Opacity="0.05" />
                                </LinearGradient>
                            </Fill>
                        </AtomBlazor.Area>
                    </AreaChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月上升 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("2024 年 1 月 - 6 月", "January - June 2024")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/AreaChart/step.txt" />
        </div>

        <!-- Legend -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("面积图 - 图例", "Area Chart - Legend")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")</p>
                </div>
                <div class="p-6 pt-0">
                    <AreaChart Data="@_monthlyData" Height="200px">
                        <XAxis DataKey="month" />
                        <YAxis Show="false" />
                        <ChartTooltip />
                        <ChartLegend />
                        <AtomBlazor.Area DataKey="desktop" Name="@(L.T("桌面端", "Desktop"))" Color="var(--chart-1)" Curve="CurveType.Smooth">
                            <Fill>
                                <LinearGradient>
                                    <GradientStop Offset="0" Color="var(--chart-1)" Opacity="0.4" />
                                    <GradientStop Offset="1" Color="var(--chart-1)" Opacity="0.05" />
                                </LinearGradient>
                            </Fill>
                        </AtomBlazor.Area>
                        <AtomBlazor.Area DataKey="mobile" Name="@(L.T("移动端", "Mobile"))" Color="var(--chart-2)" Curve="CurveType.Smooth">
                            <Fill>
                                <LinearGradient>
                                    <GradientStop Offset="0" Color="var(--chart-2)" Opacity="0.4" />
                                    <GradientStop Offset="1" Color="var(--chart-2)" Opacity="0.05" />
                                </LinearGradient>
                            </Fill>
                        </AtomBlazor.Area>
                    </AreaChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月上升 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("2024 年 1 月 - 6 月", "January - June 2024")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/AreaChart/legend.txt" />
        </div>

        <!-- Stacked -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("面积图 - 堆叠", "Area Chart - Stacked")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")</p>
                </div>
                <div class="p-6 pt-0">
                    <AreaChart Data="@_monthlyData" Height="200px">
                        <XAxis DataKey="month" />
                        <YAxis Show="false" />
                        <ChartTooltip />
                        <AtomBlazor.Area DataKey="desktop" Name="@(L.T("桌面端", "Desktop"))" Color="var(--chart-1)" Curve="CurveType.Smooth" Stacked="true">
                            <Fill>
                                <LinearGradient>
                                    <GradientStop Offset="0" Color="var(--chart-1)" Opacity="0.4" />
                                    <GradientStop Offset="1" Color="var(--chart-1)" Opacity="0.05" />
                                </LinearGradient>
                            </Fill>
                        </AtomBlazor.Area>
                        <AtomBlazor.Area DataKey="mobile" Name="@(L.T("移动端", "Mobile"))" Color="var(--chart-2)" Curve="CurveType.Smooth" Stacked="true">
                            <Fill>
                                <LinearGradient>
                                    <GradientStop Offset="0" Color="var(--chart-2)" Opacity="0.4" />
                                    <GradientStop Offset="1" Color="var(--chart-2)" Opacity="0.05" />
                                </LinearGradient>
                            </Fill>
                        </AtomBlazor.Area>
                    </AreaChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月上升 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("2024 年 1 月 - 6 月", "January - June 2024")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/AreaChart/stacked.txt" />
        </div>

        <!-- Gradient -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("面积图 - 渐变", "Area Chart - Gradient")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")</p>
                </div>
                <div class="p-6 pt-0">
                    <AreaChart Data="@_monthlyData" Height="200px">
                        <XAxis DataKey="month" />
                        <YAxis Show="false" />
                        <ChartTooltip />
                        <AtomBlazor.Area DataKey="desktop" Name="@(L.T("桌面端", "Desktop"))" Color="var(--chart-1)" Curve="CurveType.Smooth" StrokeWidth="0">
                            <Fill>
                                <LinearGradient>
                                    <GradientStop Offset="0" Color="var(--chart-1)" Opacity="0.8" />
                                    <GradientStop Offset="1" Color="var(--chart-1)" Opacity="0.1" />
                                </LinearGradient>
                            </Fill>
                        </AtomBlazor.Area>
                    </AreaChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月上升 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("2024 年 1 月 - 6 月", "January - June 2024")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/AreaChart/gradient.txt" />
        </div>

        <!-- Axes -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("面积图 - 坐标轴", "Area Chart - Axes")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")</p>
                </div>
                <div class="p-6 pt-0">
                    <AreaChart Data="@_monthlyData" Height="200px">
                        <XAxis DataKey="month" ShowAxisLine="true" ShowTicks="true" />
                        <YAxis ShowGrid="true" />
                        <ChartTooltip />
                        <AtomBlazor.Area DataKey="desktop" Name="@(L.T("桌面端", "Desktop"))" Color="var(--chart-1)" Curve="CurveType.Smooth">
                            <Fill>
                                <LinearGradient>
                                    <GradientStop Offset="0" Color="var(--chart-1)" Opacity="0.4" />
                                    <GradientStop Offset="1" Color="var(--chart-1)" Opacity="0.05" />
                                </LinearGradient>
                            </Fill>
                        </AtomBlazor.Area>
                        <AtomBlazor.Area DataKey="mobile" Name="@(L.T("移动端", "Mobile"))" Color="var(--chart-2)" Curve="CurveType.Smooth">
                            <Fill>
                                <LinearGradient>
                                    <GradientStop Offset="0" Color="var(--chart-2)" Opacity="0.4" />
                                    <GradientStop Offset="1" Color="var(--chart-2)" Opacity="0.05" />
                                </LinearGradient>
                            </Fill>
                        </AtomBlazor.Area>
                    </AreaChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月上升 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("2024 年 1 月 - 6 月", "January - June 2024")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/AreaChart/axes.txt" />
        </div>

        <!-- Numeric X Axis -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("面积图 - 数值型 X 轴", "Area Chart - Numeric X Axis")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("按不规律间隔测得的负载读数", "Load measured at irregular intervals")</p>
                </div>
                <div class="p-6 pt-0">
                    <AreaChart Data="@_readingData" Height="200px">
                        <XAxis Type="AxisType.Value" />
                        <YAxis />
                        <ChartTooltip />
                        <AtomBlazor.Area XDataKey="elapsed" DataKey="value" Name="@(L.T("负载", "Load"))" Color="var(--chart-1)" FillOpacity="0.3" />
                    </AreaChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("点间距反映各次读数之间的间隔", "Spacing reflects the gaps between readings")
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("XDataKey 会把每个点画在它自己的 X 坐标上", "XDataKey plots each point at its own X coordinate")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/AreaChart/numeric-x.txt" />
        </div>
    </div>

    <!-- API Reference -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
        </div>
        <div class="border rounded-lg p-6 space-y-4">
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Area.XDataKey</h3>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        类型：<code class="text-xs bg-muted px-1 py-0.5 rounded">string?</code>
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">string?</code>
                    </p>
                                </text>
}
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground">
                        保存每个点 X 值的属性名，让该点按自己的坐标画在
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">Value</code>、
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">Time</code> 或
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">Log</code> 轴上。
                        常规的类目型面积图不必设置：此时各点等距排布，标签由 X 轴自己给出。
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground">
                        Property name holding each point's X value, plotting it at its own coordinate on a
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">Value</code>,
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">Time</code> or
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">Log</code> axis. Leave it unset for the
                        usual categorical area, where points are spaced evenly and the X axis supplies its own labels.
                    </p>
                                </text>
}
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Area.Curve</h3>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        类型：<code class="text-xs bg-muted px-1 py-0.5 rounded">CurveType</code>
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">CurveType</code>
                    </p>
                                </text>
}
                <p class="text-sm text-muted-foreground">
                    @L.T("可选值：Linear（默认）、Smooth、Step、StepBefore、StepAfter", "Options: Linear (default), Smooth, Step, StepBefore, StepAfter")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Area.Stacked</h3>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        类型：<code class="text-xs bg-muted px-1 py-0.5 rounded">bool</code>（默认值：false）
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">bool</code> (default: false)
                    </p>
                                </text>
}
                <p class="text-sm text-muted-foreground">
                    @L.T("该面积系列是否参与堆叠。", "Whether this area series should be stacked.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Area.FillOpacity</h3>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        类型：<code class="text-xs bg-muted px-1 py-0.5 rounded">double</code>（默认值：0.4）
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">double</code> (default: 0.4)
                    </p>
                                </text>
}
                <p class="text-sm text-muted-foreground">
                    @L.T("面积填充的不透明度（0.0 到 1.0）；使用渐变 Fill 时会被覆盖。", "Opacity of the area fill (0.0 to 1.0). Overridden when using gradient Fill.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Area.Color</h3>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        类型：<code class="text-xs bg-muted px-1 py-0.5 rounded">string</code>
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
