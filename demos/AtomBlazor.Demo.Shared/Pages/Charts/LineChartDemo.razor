@page "/charts/line"
@using AtomBlazor.Icons.Lucide
<PageTitle>@L.T("折线图 - Atom BlazorUI", "Line Chart - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-6xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("折线图", "Line Chart")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("用相连的数据点呈现随时间的趋势与变化。", "Visualize trends and changes over time with connected data points.")
            </p>
        </div>
    </div>

    <!-- Interactive Line Chart (full width hero) -->
    <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
        <div class="flex items-start justify-between p-6">
            <div class="flex flex-col space-y-1.5">
                <h3 class="font-semibold leading-none tracking-tight">@L.T("折线图 - 交互示例", "Line Chart - Interactive")</h3>
                <p class="text-sm text-muted-foreground">@L.T("展示最近 3 个月的访客总量", "Showing total visitors for the last 3 months")</p>
            </div>
            <div class="flex">
                <div class="flex flex-col gap-1 border-l px-6 py-0.5">
                    <span class="text-xs text-muted-foreground">@L.T("桌面端", "Desktop")</span>
                    <span class="text-2xl font-bold leading-none">@_chartData.Sum(d => d.Desktop).ToString("N0")</span>
                </div>
                <div class="flex flex-col gap-1 border-l px-6 py-0.5">
                    <span class="text-xs text-muted-foreground">@L.T("移动端", "Mobile")</span>
                    <span class="text-2xl font-bold leading-none">@_chartData.Sum(d => d.Mobile).ToString("N0")</span>
                </div>
            </div>
        </div>
        <div class="p-6 pt-0">
            <LineChart Data="@_chartData" Height="300px">
                <XAxis DataKey="date" />
                <YAxis />
                <ChartTooltip />
                <Line DataKey="desktop" Name="@(L.T("桌面端", "Desktop"))" Color="var(--chart-1)" Curve="CurveType.Smooth" ShowDots="false" />
            </LineChart>
        </div>
    </div>
    <CodeBlock Source="Charts/LineChart/interactive.txt" />

    <!-- Grid of chart variants -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- Default -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("折线图", "Line Chart")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <LineChart Data="@_monthlyData" Height="200px">
                        <XAxis DataKey="month" />
                        <YAxis Show="false" />
                        <ChartTooltip />
                        <Line DataKey="desktop" Name="@(L.T("桌面端", "Desktop"))" Color="var(--chart-1)" Curve="CurveType.Smooth" ShowDots="false" />
                        <Line DataKey="mobile" Name="@(L.T("移动端", "Mobile"))" Color="var(--chart-2)" Curve="CurveType.Smooth" ShowDots="false" />
                    </LineChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月上升 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/LineChart/default.txt" />
        </div>

        <!-- Linear -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("折线图 - 线性", "Line Chart - Linear")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <LineChart Data="@_monthlyData" Height="200px">
                        <XAxis DataKey="month" />
                        <YAxis Show="false" />
                        <ChartTooltip />
                        <Line DataKey="desktop" Name="@(L.T("桌面端", "Desktop"))" Color="var(--chart-1)" ShowDots="false" />
                        <Line DataKey="mobile" Name="@(L.T("移动端", "Mobile"))" Color="var(--chart-2)" ShowDots="false" />
                    </LineChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月上升 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/LineChart/linear.txt" />
        </div>

        <!-- Step -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("折线图 - 阶梯", "Line Chart - Step")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <LineChart Data="@_monthlyData" Height="200px">
                        <XAxis DataKey="month" />
                        <YAxis Show="false" />
                        <ChartTooltip />
                        <Line DataKey="desktop" Name="@(L.T("桌面端", "Desktop"))" Color="var(--chart-1)" Curve="CurveType.Step" ShowDots="false" />
                    </LineChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月上升 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/LineChart/step.txt" />
        </div>

        <!-- Multiple -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("折线图 - 多系列", "Line Chart - Multiple")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <LineChart Data="@_monthlyData" Height="200px">
                        <XAxis DataKey="month" />
                        <YAxis Show="false" />
                        <ChartTooltip />
                        <ChartLegend />
                        <Line DataKey="desktop" Name="@(L.T("桌面端", "Desktop"))" Color="var(--chart-1)" Curve="CurveType.Smooth" ShowDots="false" />
                        <Line DataKey="mobile" Name="@(L.T("移动端", "Mobile"))" Color="var(--chart-2)" Curve="CurveType.Smooth" ShowDots="false" />
                    </LineChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月上升 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/LineChart/multiple.txt" />
        </div>

        <!-- Dots -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("折线图 - 数据点", "Line Chart - Dots")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <LineChart Data="@_monthlyData" Height="200px">
                        <XAxis DataKey="month" />
                        <YAxis Show="false" />
                        <ChartTooltip />
                        <Line DataKey="desktop" Name="@(L.T("桌面端", "Desktop"))" Color="var(--chart-1)" Curve="CurveType.Smooth" />
                        <Line DataKey="mobile" Name="@(L.T("移动端", "Mobile"))" Color="var(--chart-2)" Curve="CurveType.Smooth" />
                    </LineChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月上升 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/LineChart/dots.txt" />
        </div>

        <!-- Custom Dots -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("折线图 - 自定义数据点", "Line Chart - Custom Dots")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <LineChart Data="@_monthlyData" Height="200px">
                        <XAxis DataKey="month" />
                        <YAxis Show="false" />
                        <ChartTooltip />
                        <Line DataKey="desktop" Name="@(L.T("桌面端", "Desktop"))" Color="var(--chart-1)" Curve="CurveType.Smooth" DotSize="8" />
                    </LineChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月上升 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/LineChart/custom-dots.txt" />
        </div>

        <!-- Numeric X Axis -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("折线图 - 数值型 X 轴", "Line Chart - Numeric X Axis")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("按不规律间隔采集的读数", "Readings at irregular intervals")</p>
                </div>
                <div class="p-6 pt-0">
                    <LineChart Data="@_readingData" Height="200px">
                        <XAxis Type="AxisType.Value" />
                        <YAxis />
                        <ChartTooltip />
                        <Line XDataKey="elapsed" DataKey="value" Name="@(L.T("读数", "Reading"))" Color="var(--chart-1)" ShowDots="true" />
                    </LineChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("点间距反映各次读数之间的间隔", "Spacing reflects the gaps between readings")
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("XDataKey 会把每个点画在它自己的 X 坐标上", "XDataKey plots each point at its own X coordinate")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/LineChart/numeric-x.txt" />
        </div>
    </div>

    <!-- API Reference -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
        </div>
        <div class="border rounded-lg p-6 space-y-4">
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Line.XDataKey</h3>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        类型：<code class="text-xs bg-muted px-1 py-0.5 rounded">string?</code>（默认值：null）
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">string?</code> (default: null)
                    </p>
                                </text>
}
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground">
                        保存每个点 X 值的属性名，让该点按自己的坐标画在
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">Value</code>、
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">Time</code> 或
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">Log</code> 轴上。
                        常规的类目型折线图不必设置：此时各点等距排布，标签由 X 轴自己给出。
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground">
                        Property name holding each point's X value, plotting it at its own coordinate on a
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">Value</code>,
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">Time</code> or
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">Log</code> axis. Leave it unset for the
                        usual categorical line, where points are spaced evenly and the X axis supplies its own labels.
                    </p>
                                </text>
}
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Line.Curve</h3>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        类型：<code class="text-xs bg-muted px-1 py-0.5 rounded">CurveType</code>（默认值：Linear）
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">CurveType</code> (default: Linear)
                    </p>
                                </text>
}
                <p class="text-sm text-muted-foreground">
                    @L.T("曲线插值类型。可选值：Linear、Smooth、Step、StepBefore、StepAfter。", "Curve interpolation type. Options: Linear, Smooth, Step, StepBefore, StepAfter.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Line.ShowDots</h3>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        类型：<code class="text-xs bg-muted px-1 py-0.5 rounded">bool</code>（默认值：true）
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">bool</code> (default: true)
                    </p>
                                </text>
}
                <p class="text-sm text-muted-foreground">
                    @L.T("是否在数据点处显示圆点标记。", "Whether to show dot markers at data points.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Line.DotSize</h3>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        类型：<code class="text-xs bg-muted px-1 py-0.5 rounded">int</code>（默认值：4）
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">int</code> (default: 4)
                    </p>
                                </text>
}
                <p class="text-sm text-muted-foreground">
                    @L.T("数据点圆点的像素尺寸。", "Size of data point dots in pixels.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Line.Dashed</h3>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        类型：<code class="text-xs bg-muted px-1 py-0.5 rounded">bool</code>（默认值：false）
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">bool</code> (default: false)
                    </p>
                                </text>
}
                <p class="text-sm text-muted-foreground">
                    @L.T("该折线是否以虚线描边渲染。", "Whether the line should be rendered with a dashed stroke.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Line.StrokeWidth</h3>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        类型：<code class="text-xs bg-muted px-1 py-0.5 rounded">int</code>（默认值：2）
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">int</code> (default: 2)
                    </p>
                                </text>
}
                <p class="text-sm text-muted-foreground">
                    @L.T("折线描边的像素宽度。", "Line stroke width in pixels.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Line.Color</h3>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        类型：<code class="text-xs bg-muted px-1 py-0.5 rounded">string?</code>
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">string?</code>
                    </p>
                                </text>
}
                <p class="text-sm text-muted-foreground">
                    @L.T("折线的 CSS 颜色；请用 var(--chart-N) 令牌以适配主题。", "CSS color for the line. Use var(--chart-N) tokens for theme-aware colors.")
                </p>
            </div>
        </div>
    </div>
</div>

