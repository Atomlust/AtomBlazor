@page "/charts/sankey"
@using AtomBlazor.Icons.Lucide

<PageTitle>@L.T("桑基图 - Atom BlazorUI", "Sankey Chart - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-6xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("桑基图", "Sankey Chart")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("展示一个量在各阶段之间如何拆分、又如何汇合。", "Shows how a quantity splits and recombines as it moves between stages.")
            </p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("桑基图", "Sankey Chart")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("流量流向何处", "Where the traffic goes")</p>
                </div>
                <div class="p-6 pt-0">
                    <SankeyChart Data="@_flows" Height="320px">
                        <ChartTooltip />
                        <Sankey SourceKey="from" TargetKey="to" DataKey="value" />
                    </SankeyChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("每条连线一行，节点自动", "One row per link, nodes derived")
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("悬停某个节点，即可追踪它所在的那条路径", "Hover a node to trace the path it belongs to")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/SankeyChart/default.txt" />
        </div>

        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("纵向", "Vertical")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("流向自上而下", "Flow runs down")</p>
                </div>
                <div class="p-6 pt-0">
                    <SankeyChart Data="@_flows" Height="320px">
                        <ChartTooltip />
                        <Sankey SourceKey="from" TargetKey="to" DataKey="value"
                                  Orientation="SankeyOrientation.Vertical"
                                  LabelPosition="LabelPosition.Bottom" />
                    </SankeyChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        SankeyOrientation.Vertical
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("标签也要一并挪开，否则会压在色带上", "Move the labels as well, or they sit over the ribbons")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/SankeyChart/vertical.txt" />
        </div>

        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("连线颜色", "Link Colour")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("按来源着色", "Coloured by source")</p>
                </div>
                <div class="p-6 pt-0">
                    <SankeyChart Data="@_flows" Height="320px">
                        <ChartTooltip />
                        <Sankey SourceKey="from" TargetKey="to" DataKey="value"
                                  LinkColor="SankeyLinkColor.Source" LinkOpacity="0.6" />
                    </SankeyChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        SankeyLinkColor.Source
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("沿同一个起点一路延伸到尽头", "Follows one origin all the way across")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/SankeyChart/link-color.txt" />
        </div>

        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("节点对齐", "Node Alignment")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("靠左排布", "Pulled to the left")</p>
                </div>
                <div class="p-6 pt-0">
                    <SankeyChart Data="@_flows" Height="320px">
                        <ChartTooltip />
                        <Sankey SourceKey="from" TargetKey="to" DataKey="value"
                                  NodeAlign="SankeyNodeAlign.Left" />
                    </SankeyChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        SankeyNodeAlign.Left
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("末端节点停在它自身的层级上，而不是最远的边缘", "A terminal node sits at its own depth, not at the far edge")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/SankeyChart/node-align.txt" />
        </div>

        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("平直色带", "Straight Ribbons")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("窄节点、不弯曲", "Narrow nodes, no bow")</p>
                </div>
                <div class="p-6 pt-0">
                    <SankeyChart Data="@_flows" Height="320px">
                        <ChartTooltip />
                        <Sankey SourceKey="from" TargetKey="to" DataKey="value"
                                  Curveness="0" NodeWidth="12" NodeGap="16" />
                    </SankeyChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("Curveness 设为 0", "Curveness set to 0")
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("用 NodeWidth 与 NodeGap 塑造各列的形态", "NodeWidth and NodeGap shape the columns")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/SankeyChart/straight.txt" />
        </div>

        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("可拖拽节点", "Draggable Nodes")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("手动重排", "Rearrange by hand")</p>
                </div>
                <div class="p-6 pt-0">
                    <SankeyChart Data="@_flows" Height="320px">
                        <ChartTooltip />
                        <Sankey SourceKey="from" TargetKey="to" DataKey="value" Draggable="true" />
                    </SankeyChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("默认关闭", "Off by default")
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("被拖动的节点会停在放手处，直到页面重新加载", "A dragged node stays put until the page reloads")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/SankeyChart/draggable.txt" />
        </div>
    </div>

    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("绑定数据", "Binding the data")</h2>
        </div>
        <div class="border rounded-lg p-6 space-y-3">
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    绑定一组<strong>连线</strong>，而不是一组节点。每一行给出来源名称、目标名称与一个数值，
                    节点列表由这些名称按首次出现的顺序——这个顺序同时也是它们从图表色板里取色的顺序。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Bind a collection of <strong>links</strong>, not of nodes. Each row gives a source name, a target
                    name and a value, and the node list is derived from the names in the order they are first seen —
                    which is also the order they take their colours from the chart palette.
                </p>
                        </text>
}
            <p class="text-sm text-muted-foreground">
                @L.T("桑基图是有向无环图。连线构成环时，ECharts 会直接报错而不再绘制，整张图因此一片空白；于是会闭合成环的那条连线（包括节点指向自己的连线）会被丢弃，其余部分照常绘制。缺少任一端名称、或数值不是数字的行，也出于同样的原因被丢弃。", "A sankey is a directed acyclic graph. ECharts throws rather than drawing when the links form a cycle, which leaves the whole chart blank, so a link that would close a cycle — including a link from a node to itself — is dropped and the rest of the diagram is drawn. A row missing either name, or carrying a value that is not a number, is dropped for the same reason.")
            </p>
        </div>
    </div>

    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
        </div>
        <div class="border rounded-lg p-6 space-y-4">
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Sankey.SourceKey / Sankey.TargetKey</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    @L.T("类型：", "Type:") <code class="text-xs bg-muted px-1 py-0.5 rounded">string?</code> (@L.T("默认值：", "default:") <code class="text-xs bg-muted px-1 py-0.5 rounded">null</code>)
                </p>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground">
                        保存每条连线离开与进入的节点名称的属性。与 <code class="text-xs bg-muted px-1 py-0.5 rounded">DataKey</code>
                        搭配使用，后者保存沿这条连线流动的量。
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground">
                        The properties holding the name of the node each link leaves and enters. Pair them with
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">DataKey</code>, which holds the value that flows along the link.
                    </p>
                                </text>
}
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Sankey.Orientation</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    @L.T("类型：", "Type:") <code class="text-xs bg-muted px-1 py-0.5 rounded">SankeyOrientation</code> (@L.T("默认值：", "default:") <code class="text-xs bg-muted px-1 py-0.5 rounded">Horizontal</code>)
                </p>
                <p class="text-sm text-muted-foreground">
                    @L.T("图形流动的朝向。可选值：Horizontal、Vertical。", "The direction the diagram flows in. Options: Horizontal, Vertical.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Sankey.NodeAlign</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    @L.T("类型：", "Type:") <code class="text-xs bg-muted px-1 py-0.5 rounded">SankeyNodeAlign</code> (@L.T("默认值：", "default:") <code class="text-xs bg-muted px-1 py-0.5 rounded">Justify</code>)
                </p>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground">
                        没有出向连线的节点被放在哪里。可选值：Justify、Left、Right。这些值用的是真实方位，
                        因为布局由 ECharts 计算，不会随 <code class="text-xs bg-muted px-1 py-0.5 rounded">dir="rtl"</code> 镜像翻转。
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground">
                        Where the nodes with no outgoing link are placed. Options: Justify, Left, Right. The values name
                        a physical side because ECharts computes the layout and does not mirror it under
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">dir="rtl"</code>.
                    </p>
                                </text>
}
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Sankey.NodeWidth / Sankey.NodeGap</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    @L.T("类型：", "Type:") <code class="text-xs bg-muted px-1 py-0.5 rounded">int</code> (@L.T("默认值：", "defaults:") <code class="text-xs bg-muted px-1 py-0.5 rounded">20</code> and <code class="text-xs bg-muted px-1 py-0.5 rounded">8</code>)
                </p>
                <p class="text-sm text-muted-foreground">
                    @L.T("节点的粗细，以及同一列中两个节点之间的间距，单位是像素。", "The thickness of a node, and the gap between two nodes in the same column, in pixels.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Sankey.LinkColor</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    @L.T("类型：", "Type:") <code class="text-xs bg-muted px-1 py-0.5 rounded">SankeyLinkColor</code> (@L.T("默认值：", "default:") <code class="text-xs bg-muted px-1 py-0.5 rounded">Gradient</code>)
                </p>
                <p class="text-sm text-muted-foreground">
                    @L.T("色带的着色方式。可选值：Gradient、Source、Target。", "How the ribbons are coloured. Options: Gradient, Source, Target.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Sankey.LinkOpacity / Sankey.Curveness</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    @L.T("类型：", "Type:") <code class="text-xs bg-muted px-1 py-0.5 rounded">double</code> (@L.T("默认值：", "defaults:") <code class="text-xs bg-muted px-1 py-0.5 rounded">0.4</code> and <code class="text-xs bg-muted px-1 py-0.5 rounded">0.5</code>)
                </p>
                <p class="text-sm text-muted-foreground">
                    @L.T("色带的不透明度，以及色带在两端节点之间弯曲的程度。两者的取值范围都是 0 到 1。", "The opacity of the ribbons, and how much they bow between their two nodes. Both run from 0 to 1.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Sankey.Draggable</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    @L.T("类型：", "Type:") <code class="text-xs bg-muted px-1 py-0.5 rounded">bool</code> (@L.T("默认值：", "default:") <code class="text-xs bg-muted px-1 py-0.5 rounded">false</code>)
                </p>
                <p class="text-sm text-muted-foreground">
                    @L.T("访客能否把节点拖到新的位置。与 ECharts 本身不同，这里默认关闭：被拖动的节点会停在放手的地方，不重新加载就无法复原。", "Whether a visitor can drag a node to a new position. Off by default, unlike ECharts itself: a dragged node stays where it was dropped with no way back short of a reload.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Sankey.FocusAdjacent</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    @L.T("类型：", "Type:") <code class="text-xs bg-muted px-1 py-0.5 rounded">bool</code> (@L.T("默认值：", "default:") <code class="text-xs bg-muted px-1 py-0.5 rounded">true</code>)
                </p>
                <p class="text-sm text-muted-foreground">
                    @L.T("悬停某个节点时，是否让与它不相连的一切都变暗。", "Whether hovering a node dims everything it is not connected to.")
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    public class FlowData
    {
        public string From { get; set; } = "";
        public string To { get; set; } = "";
        public int Value { get; set; }
    }

    private readonly List<FlowData> _flows =
    [
        new() { From = "Search", To = "Landing", Value = 4200 },
        new() { From = "Social", To = "Landing", Value = 1800 },
        new() { From = "Email", To = "Landing", Value = 900 },
        new() { From = "Search", To = "Blog", Value = 1600 },
        new() { From = "Social", To = "Blog", Value = 1100 },
        new() { From = "Landing", To = "Pricing", Value = 3100 },
        new() { From = "Landing", To = "Bounced", Value = 3800 },
        new() { From = "Blog", To = "Pricing", Value = 800 },
        new() { From = "Blog", To = "Bounced", Value = 1900 },
        new() { From = "Pricing", To = "Signed up", Value = 1400 },
        new() { From = "Pricing", To = "Bounced", Value = 2500 }
    ];
}
