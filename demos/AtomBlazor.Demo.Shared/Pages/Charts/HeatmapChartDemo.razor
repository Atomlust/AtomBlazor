@page "/charts/heatmap"
@using AtomBlazor.Icons.Lucide

<PageTitle>@L.T("热力图 - Atom BlazorUI", "Heatmap Chart - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-6xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("热力图", "Heatmap Chart")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("以单元格颜色强度表示数值的网格可视化。", "Color-coded grid visualizations where cell intensity represents data values.")
            </p>
        </div>
    </div>

    <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
        <div class="flex items-start justify-between p-6">
            <div class="flex flex-col space-y-1.5">
                <h3 class="font-semibold leading-none tracking-tight">@L.T("每周活跃度", "Weekly Activity")</h3>
                <p class="text-sm text-muted-foreground">@L.T("每天各时段对应的提交数", "Commits per day and time slot")</p>
            </div>
        </div>
        <div class="p-6 pt-0">
            <HeatmapChart Data="@_heatmapData" Height="300px">
                <XAxis DataKey="day" />
                <YAxis DataKey="timeSlot" />
                <VisualMap Min="0" Max="50" />
                <ChartTooltip />
                <Heatmap XKey="dayIndex" YKey="timeIndex" ValueKey="commits" />
            </HeatmapChart>
        </div>
    </div>
    <CodeBlock Source="Charts/HeatmapChart/default.txt" />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("默认", "Default")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("带视觉映射的基础热力图", "Basic heatmap with visual map")</p>
                </div>
                <div class="p-6 pt-0">
                    <HeatmapChart Data="@_simpleHeatmap" Height="200px">
                        <XAxis DataKey="x" />
                        <YAxis DataKey="y" />
                        <VisualMap Min="0" Max="100" />
                        <ChartTooltip />
                        <Heatmap XKey="xi" YKey="yi" ValueKey="value" />
                    </HeatmapChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("简单的 3x3 网格热力图", "Simple 3x3 grid heatmap")
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("默认颜色渐变", "Default color gradient")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/HeatmapChart/simple.txt" />
        </div>

        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("带标签", "With Labels")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("每个单元格内的数值标签", "Value labels in each cell")</p>
                </div>
                <div class="p-6 pt-0">
                    <HeatmapChart Data="@_simpleHeatmap" Height="200px">
                        <XAxis DataKey="x" />
                        <YAxis DataKey="y" />
                        <VisualMap Min="0" Max="100" Show="false" />
                        <ChartTooltip />
                        <Heatmap XKey="xi" YKey="yi" ValueKey="value" ShowLabel="true" />
                    </HeatmapChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("用 ShowLabel 显示单元格数值", "ShowLabel for cell values")
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("隐藏视觉映射，显示标签", "Visual map hidden, labels visible")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/HeatmapChart/labels.txt" />
        </div>

        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("自定义颜色", "Custom Colors")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("自定义渐变调色板", "Custom gradient palette")</p>
                </div>
                <div class="p-6 pt-0">
                    <HeatmapChart Data="@_simpleHeatmap" Height="200px">
                        <XAxis DataKey="x" />
                        <YAxis DataKey="y" />
                        <VisualMap Min="0" Max="100" Colors="@(new[] { "var(--chart-3)", "var(--chart-4)", "var(--chart-1)" })" />
                        <ChartTooltip />
                        <Heatmap XKey="xi" YKey="yi" ValueKey="value" />
                    </HeatmapChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("三段式颜色渐变", "Three-stop color gradient")
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("在 VisualMap 上自定义 Colors 数组", "Custom Colors array on VisualMap")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/HeatmapChart/custom-colors.txt" />
        </div>
    </div>

    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
        </div>
        <div class="border rounded-lg p-6 space-y-4">
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Heatmap.XKey / YKey / ValueKey</h3>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        类型：<code class="text-xs bg-muted px-1 py-0.5 rounded">string?</code>
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">string?</code>
                    </p>
                                </text>
}
                <p class="text-sm text-muted-foreground">
                    @L.T("X 坐标、Y 坐标与单元格数值对应的属性名。数据会被提取为 [x, y, value] 三元组。", "Property names for the X coordinate, Y coordinate, and cell value. Data is extracted as [x, y, value] triplets.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">VisualMap.Min / Max</h3>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        类型：<code class="text-xs bg-muted px-1 py-0.5 rounded">double</code>（默认值：<code class="text-xs bg-muted px-1 py-0.5 rounded">0</code> / <code class="text-xs bg-muted px-1 py-0.5 rounded">100</code>）
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">double</code> (defaults: <code class="text-xs bg-muted px-1 py-0.5 rounded">0</code> / <code class="text-xs bg-muted px-1 py-0.5 rounded">100</code>)
                    </p>
                                </text>
}
                <p class="text-sm text-muted-foreground">
                    @L.T("颜色渐变的取值范围；超出该范围的数值会被截断。", "Range of the color gradient. Values outside this range are clamped.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">VisualMap.Colors</h3>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        类型：<code class="text-xs bg-muted px-1 py-0.5 rounded">string[]?</code>（默认值：<code class="text-xs bg-muted px-1 py-0.5 rounded">["var(--chart-5)", "var(--chart-1)"]</code>）
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">string[]?</code> (default: <code class="text-xs bg-muted px-1 py-0.5 rounded">["var(--chart-5)", "var(--chart-1)"]</code>)
                    </p>
                                </text>
}
                <p class="text-sm text-muted-foreground">
                    @L.T("从 Min 到 Max 的渐变色标；接受 CSS 颜色或 var() 引用。", "Color gradient stops from Min to Max. Accepts CSS colors or var() references.")
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    public class HeatmapData
    {
        public string Day { get; set; } = "";
        public string TimeSlot { get; set; } = "";
        public int DayIndex { get; set; }
        public int TimeIndex { get; set; }
        public int Commits { get; set; }
    }

    public class SimpleHeatmapData
    {
        public string X { get; set; } = "";
        public string Y { get; set; } = "";
        public int Xi { get; set; }
        public int Yi { get; set; }
        public int Value { get; set; }
    }

    private readonly List<HeatmapData> _heatmapData = GenerateHeatmapData();
    private readonly List<SimpleHeatmapData> _simpleHeatmap = GenerateSimpleHeatmap();

    private static List<HeatmapData> GenerateHeatmapData()
    {
        var days = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
        var times = new[] { "Morning", "Afternoon", "Evening", "Night" };
        var values = new[,]
        {
            { 12, 25, 18, 5 },
            { 20, 35, 22, 8 },
            { 15, 42, 30, 10 },
            { 28, 38, 25, 6 },
            { 22, 30, 15, 3 },
            { 5, 10, 8, 2 },
            { 3, 8, 6, 1 }
        };

        var data = new List<HeatmapData>();
        for (var d = 0; d < days.Length; d++)
        {
            for (var t = 0; t < times.Length; t++)
            {
                data.Add(new HeatmapData
                {
                    Day = days[d],
                    TimeSlot = times[t],
                    DayIndex = d,
                    TimeIndex = t,
                    Commits = values[d, t]
                });
            }
        }

        return data;
    }

    private static List<SimpleHeatmapData> GenerateSimpleHeatmap()
    {
        var xs = new[] { "A", "B", "C" };
        var ys = new[] { "X", "Y", "Z" };
        var values = new[,] { { 20, 65, 40 }, { 85, 30, 70 }, { 50, 90, 15 } };

        var data = new List<SimpleHeatmapData>();
        for (var x = 0; x < 3; x++)
        {
            for (var y = 0; y < 3; y++)
            {
                data.Add(new SimpleHeatmapData
                {
                    X = xs[x],
                    Y = ys[y],
                    Xi = x,
                    Yi = y,
                    Value = values[x, y]
                });
            }
        }

        return data;
    }
}
