@page "/charts/radial"
@using AtomBlazor.Icons.Lucide
<PageTitle>@L.T("径向图 - Atom BlazorUI", "Radial Chart - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-6xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("径向图", "Radial Chart")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("用环形刻度与径向条形展示进度与百分比。", "Display progress and percentages with circular gauges and radial bars.")
            </p>
        </div>
    </div>

    <!-- Grid of chart variants -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- Radial Chart -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("径向图", "Radial Chart")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <RadialBarChart Data="@_browserData" Height="250px">
                        <ChartTooltip />
                        <RadialBar DataKey="visitors" NameKey="browser" />
                    </RadialBarChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月增长 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/RadialChart/default.txt" />
        </div>

        <!-- Label -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("径向图 - 显示标签", "Radial Chart - Label")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <RadialBarChart Data="@_browserData" Height="250px">
                        <ChartTooltip />
                        <RadialBar DataKey="visitors" NameKey="browser" ShowLabels="true" />
                    </RadialBarChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月增长 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/RadialChart/label.txt" />
        </div>

        <!-- Grid -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("径向图 - 背景网格", "Radial Chart - Grid")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <RadialBarChart Data="@_browserData" Height="250px">
                        <ChartTooltip />
                        <RadialBar DataKey="visitors" NameKey="browser" ShowBackground="true" />
                    </RadialBarChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月增长 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/RadialChart/grid.txt" />
        </div>

        <!-- Text -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("径向图 - 中心文字", "Radial Chart - Text")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <RadialBarChart Data="@_safariData" Height="250px" InnerRadius="60%" OuterRadius="80%">
                        <ChartTooltip />
                        <RadialBar DataKey="visitors" NameKey="browser" Color="var(--chart-2)">
                            <CenterLabel Value="200" Title="@(L.T("访客", "Visitors"))" />
                        </RadialBar>
                    </RadialBarChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月增长 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/RadialChart/text.txt" />
        </div>

        <!-- Shape -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("径向图 - 形状", "Radial Chart - Shape")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <RadialBarChart Data="@_safariShapeData" Height="250px" InnerRadius="40%" OuterRadius="80%">
                        <ChartTooltip />
                        <RadialBar DataKey="visitors" NameKey="browser" Color="var(--chart-2)" ShowBackground="true">
                            <CenterLabel Value="1,260" Title="@(L.T("访客", "Visitors"))" />
                        </RadialBar>
                    </RadialBarChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月增长 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/RadialChart/shape.txt" />
        </div>

        <!-- Stacked -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("径向图 - 堆叠", "Radial Chart - Stacked")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <RadialBarChart Data="@_stackedData" Height="250px" InnerRadius="40%" OuterRadius="80%">
                        <ChartTooltip />
                        <RadialBar DataKey="desktop" NameKey="month" Color="var(--chart-1)" Stacked="true" ShowBackground="true" />
                        <RadialBar DataKey="mobile" NameKey="month" Color="var(--chart-2)" Stacked="true">
                            <CenterLabel Value="1,830" Title="@(L.T("访客", "Visitors"))" />
                        </RadialBar>
                    </RadialBarChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月增长 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/RadialChart/stacked.txt" />
        </div>
    </div>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    public class BrowserData
    {
        public string Browser { get; set; } = "";
        public int Visitors { get; set; }
    }

    public class MonthlyData
    {
        public string Month { get; set; } = "";
        public int Desktop { get; set; }
        public int Mobile { get; set; }
    }

    private readonly List<BrowserData> _browserData =
    [
        new() { Browser = "Chrome", Visitors = 275 },
        new() { Browser = "Safari", Visitors = 200 },
        new() { Browser = "Firefox", Visitors = 187 },
        new() { Browser = "Edge", Visitors = 173 },
        new() { Browser = "Other", Visitors = 90 }
    ];

    private readonly List<BrowserData> _safariData =
    [
        new() { Browser = "Safari", Visitors = 200 }
    ];

    private readonly List<BrowserData> _safariShapeData =
    [
        new() { Browser = "Safari", Visitors = 1260 }
    ];

    private readonly List<MonthlyData> _stackedData =
    [
        new() { Month = "January", Desktop = 1260, Mobile = 570 }
    ];
}
