@page "/charts/bar"
@using AtomBlazor.Icons.Lucide
<PageTitle>@L.T("柱状图 - Atom BlazorUI", "Bar Chart - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-6xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("柱状图", "Bar Chart")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("用纵向或横向的柱子展示数据，便于在各类目之间比较数值。", "Display data with vertical or horizontal bars for comparing values across categories.")
            </p>
        </div>
    </div>

    <!-- Interactive Bar Chart (full width hero) -->
    <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
        <div class="flex items-start justify-between p-6">
            <div class="flex flex-col space-y-1.5">
                <h3 class="font-semibold leading-none tracking-tight">@L.T("柱状图 - 交互示例", "Bar Chart - Interactive")</h3>
                <p class="text-sm text-muted-foreground">@L.T("展示最近 3 个月的访客总量", "Showing total visitors for the last 3 months")</p>
            </div>
            <div class="flex">
                <div class="flex flex-col gap-1 border-l px-6 py-0.5">
                    <span class="text-xs text-muted-foreground">@L.T("桌面端", "Desktop")</span>
                    <span class="text-2xl font-bold leading-none">@_chartData.Sum(d => d.Desktop).ToString("N0")</span>
                </div>
                <div class="flex flex-col gap-1 border-l px-6 py-0.5">
                    <span class="text-xs text-muted-foreground">@L.T("移动端", "Mobile")</span>
                    <span class="text-2xl font-bold leading-none">@_chartData.Sum(d => d.Mobile).ToString("N0")</span>
                </div>
            </div>
        </div>
        <div class="p-6 pt-0">
            <BarChart Data="@_chartData" Height="300px">
                <XAxis DataKey="date" />
                <YAxis />
                <ChartTooltip />
                <Bar DataKey="desktop" Name="@(L.T("桌面端", "Desktop"))" Color="var(--chart-2)" />
            </BarChart>
        </div>
    </div>
    <CodeBlock Source="Charts/BarChart/interactive.txt" />

    <!-- Grid of chart variants -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- Default -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("柱状图", "Bar Chart")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <BarChart Data="@_monthlyData" Height="200px">
                        <XAxis DataKey="month" />
                        <YAxis Show="false" />
                        <ChartTooltip />
                        <Bar DataKey="desktop" Name="@(L.T("桌面端", "Desktop"))" Color="var(--chart-1)" />
                    </BarChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月上升 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/BarChart/default.txt" />
        </div>

        <!-- Horizontal -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("柱状图 - 横向", "Bar Chart - Horizontal")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <BarChart Data="@_monthlyData" Horizontal="true" Height="200px">
                        <XAxis DataKey="month" />
                        <YAxis Show="false" />
                        <ChartTooltip />
                        <Bar DataKey="desktop" Name="@(L.T("桌面端", "Desktop"))" Color="var(--chart-1)" />
                    </BarChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月上升 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/BarChart/horizontal.txt" />
        </div>

        <!-- Multiple -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("柱状图 - 多系列", "Bar Chart - Multiple")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <BarChart Data="@_monthlyData" Height="200px">
                        <XAxis DataKey="month" />
                        <YAxis Show="false" />
                        <ChartTooltip />
                        <Bar DataKey="desktop" Name="@(L.T("桌面端", "Desktop"))" Color="var(--chart-1)" />
                        <Bar DataKey="mobile" Name="@(L.T("移动端", "Mobile"))" Color="var(--chart-2)" />
                    </BarChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月上升 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/BarChart/multiple.txt" />
        </div>

        <!-- Stacked + Legend -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("柱状图 - 堆叠 + 图例", "Bar Chart - Stacked + Legend")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <BarChart Data="@_monthlyData" Height="200px">
                        <XAxis DataKey="month" />
                        <YAxis Show="false" />
                        <ChartTooltip />
                        <ChartLegend />
                        <Bar DataKey="desktop" Name="@(L.T("桌面端", "Desktop"))" Color="var(--chart-1)" Stacked="true" />
                        <Bar DataKey="mobile" Name="@(L.T("移动端", "Mobile"))" Color="var(--chart-2)" Stacked="true" BorderRadius="4" />
                    </BarChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月上升 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/BarChart/stacked-legend.txt" />
        </div>

        <!-- Label -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("柱状图 - 数据标签", "Bar Chart - Label")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <BarChart Data="@_monthlyData" Height="200px">
                        <XAxis DataKey="month" />
                        <YAxis Show="false" />
                        <ChartTooltip />
                        <Bar DataKey="desktop" Name="@(L.T("桌面端", "Desktop"))" Color="var(--chart-1)" ShowLabel="true" />
                    </BarChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月上升 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/BarChart/label.txt" />
        </div>

        <!-- Custom Label -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("柱状图 - 自定义标签", "Bar Chart - Custom Label")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <BarChart Data="@_labelData" Horizontal="true" Height="200px">
                        <XAxis DataKey="month" LabelInside="true" LabelColor="white" />
                        <YAxis Show="false" />
                        <ChartTooltip />
                        <Bar DataKey="desktop" Name="@(L.T("桌面端", "Desktop"))" Color="var(--chart-2)"
                             ShowLabel="true" LabelPosition="LabelPosition.Right" BorderRadius="8" />
                    </BarChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月上升 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/BarChart/custom-label.txt" />
        </div>

        <!-- Mixed -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("柱状图 - 混合堆叠", "Bar Chart - Mixed")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <BarChart Data="@_browserData" Horizontal="true" Height="200px">
                        <XAxis DataKey="browser" />
                        <YAxis Show="false" />
                        <ChartTooltip />
                        <Bar DataKey="chrome" Name="Chrome" Color="var(--chart-1)" Stacked="true" BorderRadius="8" />
                        <Bar DataKey="safari" Name="Safari" Color="var(--chart-2)" Stacked="true" BorderRadius="8" />
                        <Bar DataKey="firefox" Name="Firefox" Color="var(--chart-3)" Stacked="true" BorderRadius="8" />
                        <Bar DataKey="edge" Name="Edge" Color="var(--chart-4)" Stacked="true" BorderRadius="8" />
                        <Bar DataKey="other" Name="@(L.T("其他", "Other"))" Color="var(--chart-5)" Stacked="true" BorderRadius="8" />
                    </BarChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月上升 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("按浏览器统计的访客总量", "Showing total visitors by browser")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/BarChart/mixed.txt" />
        </div>

        <!-- Active -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("柱状图 - 选中高亮", "Bar Chart - Active")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("各浏览器的访客数", "Visitors by browser")</p>
                </div>
                <div class="p-6 pt-0">
                    <BarChart Data="@_activeData" Horizontal="false" Height="200px">
                        <XAxis DataKey="browser" />
                        <YAxis Show="false" />
                        <ChartTooltip />
                        <Bar DataKey="visitors" Name="@(L.T("访客数", "Visitors"))" FillKey="fill" BorderRadius="8" />
                    </BarChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月上升 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("按浏览器统计的访客总量", "Showing total visitors by browser")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/BarChart/active.txt" />
        </div>

        <!-- Negative -->
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">@L.T("柱状图 - 负值", "Bar Chart - Negative")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("2024 年 1 月 - 6 月", "January - June 2024")</p>
                </div>
                <div class="p-6 pt-0">
                    <BarChart Data="@_negativeData" Height="200px">
                        <XAxis DataKey="month" />
                        <YAxis Show="false" />
                        <ChartTooltip />
                        <Bar DataKey="visitors" Name="@(L.T("访客数", "Visitors"))" Color="var(--chart-1)" />
                    </BarChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        @L.T("本月上升 5.2%", "Trending up by 5.2% this month") <LucideIcon Name="trending-up" Size="16" />
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        @L.T("展示最近 6 个月的访客总量", "Showing total visitors for the last 6 months")
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/BarChart/negative.txt" />
        </div>
    </div>

    <!-- Click events -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("点击事件", "Click events") <span class="text-xs font-normal text-primary bg-primary/10 px-1.5 py-0.5 rounded">@L.T("新增", "New")</span></h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    <code class="bg-muted px-1 py-0.5 rounded">OnDataPointClick</code> 会上报你点到的那根柱子的系列、
                    序号与数值。<code class="bg-muted px-1 py-0.5 rounded">DataIndex</code> 直接对应你所绑定集合里的位置，
                    下钻因此很好做。<code class="bg-muted px-1 py-0.5 rounded">OnChartClick</code> 在你点到柱子之外时触发，
                    常用来清空选中。同一次点击不会让两者都触发。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    <code class="bg-muted px-1 py-0.5 rounded">OnDataPointClick</code> reports the series, index and value
                    of the bar you clicked. <code class="bg-muted px-1 py-0.5 rounded">DataIndex</code> maps straight back
                    to the position in the collection you bound, which is what makes a drill-down straightforward.
                    <code class="bg-muted px-1 py-0.5 rounded">OnChartClick</code> fires when you click away from any bar —
                    useful for clearing a selection. The two never both fire for one click.
                </p>
                        </text>
}
        </div>
        <div class="border rounded-lg p-6 space-y-4">
            <BarChart Data="@_chartData" Height="260px"
                        OnDataPointClick="HandlePointClick"
                        OnChartClick="ClearSelection">
                <XAxis DataKey="date" />
                <YAxis />
                <Bar DataKey="desktop" Name="@(L.T("桌面端", "Desktop"))" Color="var(--chart-2)" />
            </BarChart>
            <div class="text-sm" data-testid="chart-click-readout">
                @if (_clickReadout is null)
                {
                    <span class="text-muted-foreground">@L.T("点一根柱子试试…", "Click a bar…")</span>
                }
                else if (L.IsChinese)
                {
                    <span class="font-medium">@ClickReadoutZh</span>
                }
                else
                {
                    <span class="font-medium">@_clickReadout</span>
                }
            </div>
        </div>
        <CodeBlock Source="Charts/BarChart/click-events.txt" />
    </div>

    <!-- API Reference -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
        </div>
        <div class="border rounded-lg p-6 space-y-4">
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">BarChart.Horizontal</h3>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        类型：<code class="text-xs bg-muted px-1 py-0.5 rounded">bool</code>（默认值：false）
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">bool</code> (default: false)
                    </p>
                                </text>
}
                <p class="text-sm text-muted-foreground">
                    @L.T("柱子是否横向绘制。", "Whether bars are rendered horizontally.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Bar.Stacked</h3>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        类型：<code class="text-xs bg-muted px-1 py-0.5 rounded">bool</code>（默认值：false）
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">bool</code> (default: false)
                    </p>
                                </text>
}
                <p class="text-sm text-muted-foreground">
                    @L.T("该柱状系列是否参与堆叠。", "Whether this bar series should be stacked.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Bar.BorderRadius</h3>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        类型：<code class="text-xs bg-muted px-1 py-0.5 rounded">int?</code>（默认值：4；堆叠时为 0）
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">int?</code> (default: 4, or 0 when stacked)
                    </p>
                                </text>
}
                <p class="text-sm text-muted-foreground">
                    @L.T("柱子的圆角半径（像素）。会自动作用于起始端，负值时随之翻转。", "Corner radius for bars in pixels. Automatically applied to the leading end and flipped for negative values.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Bar.FillKey</h3>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        类型：<code class="text-xs bg-muted px-1 py-0.5 rounded">string?</code>
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">string?</code>
                    </p>
                                </text>
}
                <p class="text-sm text-muted-foreground">
                    @L.T("从数据中逐项取填充色的属性名，用来给单根柱子上色。", "Property name to extract per-item fill colors from data. Enables individual bar coloring.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Bar.ShowLabel</h3>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        类型：<code class="text-xs bg-muted px-1 py-0.5 rounded">bool</code>（默认值：false）
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">bool</code> (default: false)
                    </p>
                                </text>
}
                <p class="text-sm text-muted-foreground">
                    @L.T("是否在每根柱子上显示数据标签。", "Whether data labels are displayed on each bar.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Bar.LabelPosition</h3>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        类型：<code class="text-xs bg-muted px-1 py-0.5 rounded">string</code>（默认值："top"）
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">string</code> (default: "top")
                    </p>
                                </text>
}
                <p class="text-sm text-muted-foreground">
                    @L.T("数据标签的位置。可选值：\"top\"、\"inside\"、\"insideLeft\"、\"insideRight\"、\"right\"。", "Position of the data label. Options: \"top\", \"inside\", \"insideLeft\", \"insideRight\", \"right\".")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Bar.Color</h3>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        类型：<code class="text-xs bg-muted px-1 py-0.5 rounded">string</code>
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">string</code>
                    </p>
                                </text>
}
                <p class="text-sm text-muted-foreground">
                    @L.T("柱子的 CSS 颜色，请使用 var(--chart-N) 令牌。", "CSS color for the bar. Use var(--chart-N) tokens.")
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">ChartTooltip.AppendToBody</h3>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        类型：<code class="text-xs bg-muted px-1 py-0.5 rounded">bool?</code>（默认值：null）
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground mb-2">
                        Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">bool?</code> (default: null)
                    </p>
                                </text>
}
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm text-muted-foreground">
                        取 <code class="text-xs bg-muted px-1 py-0.5 rounded">true</code> 时，提示框挂到
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">&lt;body&gt;</code> 上，渲染在图表容器之外，
                        因而不会被带 <code class="text-xs bg-muted px-1 py-0.5 rounded">overflow: hidden</code> 的父元素裁掉。
                        所有图表类型都适用。
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm text-muted-foreground">
                        When <code class="text-xs bg-muted px-1 py-0.5 rounded">true</code>, renders the tooltip
                        outside the chart container by appending to <code class="text-xs bg-muted px-1 py-0.5 rounded">&lt;body&gt;</code>.
                        Prevents tooltip clipping by parent elements with <code class="text-xs bg-muted px-1 py-0.5 rounded">overflow: hidden</code>.
                        Applies to all chart types.
                    </p>
                                </text>
}
            </div>
        </div>
    </div>
</div>

