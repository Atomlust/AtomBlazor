@page "/primitives/label"

<PageTitle>@L.T("Label 标签原语 - Atom BlazorUI", "Label Primitive - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("Label 标签原语", "Label Primitive")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("无头、无样式的标签原语，提供完整的无障碍支持。", "Headless, unstyled label primitive with full accessibility support.")
            </p>
        </div>
    </div>

    <div class="space-y-6">
        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("无头原语基础用法", "Basic Headless Primitive")</h2>
                <p class="text-muted-foreground">
                    @L.T("该原语提供不带样式的语义化 HTML label 元素。", "The primitive provides semantic HTML label element without styling.")
                </p>
            </div>

            <div class="rounded-lg border bg-card p-6 max-w-md">
                <div class="space-y-2">
                    <AtomBlazor.Primitives.LabelPrimitive For="basic-input" class="text-sm font-medium">
                        @L.T("基础标签", "Basic label")
                    </AtomBlazor.Primitives.LabelPrimitive>
                    <input type="text" id="basic-input" placeholder="@(L.T("点击标签以聚焦", "Click the label to focus"))" class="w-full px-3 py-2 border border-input rounded-md bg-background" />
                </div>
                <p class="text-sm text-muted-foreground mt-3">
                    @L.T("点击标签即可让输入框获得焦点。", "Click the label to focus the input field.")
                </p>
            </div>

            <CodeBlock Source="Primitives/Label/basic.txt" />
        </section>

        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("配合表单元素", "With Form Elements")</h2>
                <p class="text-muted-foreground">
                    @L.T("标签适用于所有表单输入类型。", "Labels work with all form input types.")
                </p>
            </div>

            <div class="rounded-lg border bg-card p-6 max-w-md space-y-4">
                <div class="space-y-2">
                    <AtomBlazor.Primitives.LabelPrimitive For="text-input" class="block text-sm font-medium">
                        @L.T("文本输入", "Text Input")
                    </AtomBlazor.Primitives.LabelPrimitive>
                    <input type="text" id="text-input" class="w-full px-3 py-2 border border-input rounded-md bg-background" placeholder="@(L.T("输入文本", "Enter text"))" />
                </div>

                <div class="space-y-2">
                    <AtomBlazor.Primitives.LabelPrimitive For="select-input" class="block text-sm font-medium">
                        @L.T("下拉选择", "Select Dropdown")
                    </AtomBlazor.Primitives.LabelPrimitive>
                    <select id="select-input" class="w-full px-3 py-2 border border-input rounded-md bg-background">
                        <option>@L.T("选项 1", "Option 1")</option>
                        <option>@L.T("选项 2", "Option 2")</option>
                        <option>@L.T("选项 3", "Option 3")</option>
                    </select>
                </div>

                <div class="space-y-2">
                    <AtomBlazor.Primitives.LabelPrimitive For="textarea-input" class="block text-sm font-medium">
                        @L.T("多行文本", "Textarea")
                    </AtomBlazor.Primitives.LabelPrimitive>
                    <textarea id="textarea-input" rows="3" class="w-full px-3 py-2 border border-input rounded-md bg-background" placeholder="@(L.T("输入更长的文本……", "Enter longer text..."))"></textarea>
                </div>

                <div class="flex items-center gap-2">
                    <input type="checkbox" id="checkbox-input" class="h-4 w-4 border border-input rounded cursor-pointer" />
                    <AtomBlazor.Primitives.LabelPrimitive For="checkbox-input" class="text-sm font-medium cursor-pointer">
                        @L.T("复选框标签（可点击）", "Checkbox Label (clickable)")
                    </AtomBlazor.Primitives.LabelPrimitive>
                </div>

                <div class="flex items-center gap-2">
                    <input type="radio" id="radio-input" name="radio-group" class="h-4 w-4 border border-input rounded-full cursor-pointer" />
                    <AtomBlazor.Primitives.LabelPrimitive For="radio-input" class="text-sm font-medium cursor-pointer">
                        @L.T("单选框标签（可点击）", "Radio Label (clickable)")
                    </AtomBlazor.Primitives.LabelPrimitive>
                </div>
            </div>

            <CodeBlock Source="Primitives/Label/form-elements.txt" />
        </section>

        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("必填字段", "Required Fields")</h2>
                <p class="text-muted-foreground">
                    @L.T("展示必填字段的常见模式。", "Common pattern for showing required fields.")
                </p>
            </div>

            <div class="rounded-lg border bg-card p-6 max-w-md space-y-4">
                <div class="space-y-2">
                    <AtomBlazor.Primitives.LabelPrimitive For="required-input" class="block text-sm font-medium">
                        @L.T("用户名", "Username") <span class="text-red-500">*</span>
                    </AtomBlazor.Primitives.LabelPrimitive>
                    <input type="text" id="required-input" required class="w-full px-3 py-2 border border-input rounded-md bg-background" placeholder="@(L.T("必填字段", "Required field"))" />
                </div>

                <div class="space-y-2">
                    <AtomBlazor.Primitives.LabelPrimitive For="optional-input" class="block text-sm font-medium">
                        @L.T("昵称", "Nickname") <span class="text-muted-foreground text-xs">@L.T("（可选）", "(optional)")</span>
                    </AtomBlazor.Primitives.LabelPrimitive>
                    <input type="text" id="optional-input" class="w-full px-3 py-2 border border-input rounded-md bg-background" placeholder="@(L.T("可选字段", "Optional field"))" />
                </div>
            </div>

            <CodeBlock Source="Primitives/Label/required.txt" />
        </section>

        <AccessibilityList>
            <AriaAttributes>
                @if (L.IsChinese)
                {
                    <text>
                        <AccessibilityItem>
                            使用原生 <code class="text-xs bg-muted px-1 py-0.5 rounded">Semantic HTML</code> <code>&lt;label&gt;</code> 元素以获得正确的语义
                        </AccessibilityItem>
                        <AccessibilityItem>
                            <code class="text-xs bg-muted px-1 py-0.5 rounded">for</code> 属性会自动把标签与关联的输入框链接起来
                        </AccessibilityItem>
                        <AccessibilityItem>
                            点击范围扩展到标签文本，点击标签会聚焦关联的输入框
                        </AccessibilityItem>
                        <AccessibilityItem>
                            当关联的输入框获得焦点时，屏幕阅读器会播报标签文本
                        </AccessibilityItem>
                    </text>
                }
                else
                {
                    <text>
                        <AccessibilityItem>
                            <code class="text-xs bg-muted px-1 py-0.5 rounded">Semantic HTML</code> uses native <code>&lt;label&gt;</code> element for proper semantics
                        </AccessibilityItem>
                        <AccessibilityItem>
                            <code class="text-xs bg-muted px-1 py-0.5 rounded">for</code> attribute automatically links label to associated input
                        </AccessibilityItem>
                        <AccessibilityItem>
                            Click target expands to label text, clicking label focuses associated input
                        </AccessibilityItem>
                        <AccessibilityItem>
                            Screen readers announce label text when the associated input is focused
                        </AccessibilityItem>
                    </text>
                }
            </AriaAttributes>
            <KeyboardNavigation>
                <KeyboardShortcutItem Description="@(L.T("在表单输入框之间导航", "Navigate between form inputs"))">
                    <Kbd>Tab</Kbd>
                </KeyboardShortcutItem>
                <KeyboardShortcutItem Description="@(L.T("点击标签以聚焦关联的输入框", "Click label to focus associated input"))">
                    <Kbd>Click</Kbd>
                </KeyboardShortcutItem>
            </KeyboardNavigation>
        </AccessibilityList>

        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
                <p class="text-muted-foreground">
                    @L.T("组件属性与参数。", "Component properties and parameters.")
                </p>
            </div>

            <div class="space-y-4">
                <ApiReference ComponentName="Label">
                    @if (L.IsChinese)
                    {
                        <text>
                            <ApiParameter Name="For" Type="string?">
                                此标签所关联的表单元素的 ID。映射到 HTML 的 <code>for</code> 属性。
                            </ApiParameter>
                        </text>
                    }
                    else
                    {
                        <text>
                            <ApiParameter Name="For" Type="string?">
                                The ID of the form element this label is associated with. Maps to the HTML <code>for</code> attribute.
                            </ApiParameter>
                        </text>
                    }
                    <ApiParameter Name="ChildContent" Type="RenderFragment?">
                        @L.T("在 label 元素内部渲染的内容（标签文本）。", "The content to be rendered inside the label element (label text).")
                    </ApiParameter>
                    @if (L.IsChinese)
                    {
                        <text>
                            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                                应用到 label 元素上的附加 HTML 属性（例如 <code>class</code>、<code>style</code>）。
                            </ApiParameter>
                        </text>
                    }
                    else
                    {
                        <text>
                            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                                Additional HTML attributes applied to the label element (e.g. <code>class</code>, <code>style</code>).
                            </ApiParameter>
                        </text>
                    }
                </ApiReference>
            </div>
        </section>
    </div>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    // Label 原语演示页无需组件状态。
}
