@page "/primitives"

<PageTitle>@L.T("基础构件 - Atom BlazorUI", "Primitives - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-6xl">
    <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">@L.T("基础构件", "Primitives")</h1>
        <p class="text-xl text-muted-foreground">
            @L.T("无头、无样式的组件，负责行为、无障碍与状态管理。你可以按自己的意愿为它们添加样式，并拥有完全的控制权。", "Headless, unstyled components that provide behavior, accessibility, and state management. Style them however you want with complete control.")
        </p>
    </div>

    <div class="space-y-6">
        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("什么是基础构件？", "What are Primitives?")</h2>
                <p class="text-muted-foreground">
                    @L.T("基础构件是无头组件，它们处理所有复杂的行为、键盘导航、无障碍与状态管理，同时不提供任何样式。它们给你完全的控制权，去构建你恰好需要的东西。", "Primitives are headless components that handle all the complex behavior, keyboard navigation, accessibility, and state management while providing zero styling. They give you complete control to build exactly what you need.")
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-4">
                <div class="p-4 border rounded-lg">
                    <div class="flex items-start gap-2 mb-2">
                        <span class="text-green-600 dark:text-green-400 text-lg">✓</span>
                        <div>
                            <h3 class="font-semibold">@L.T("为无障碍而生", "Built for Accessibility")</h3>
                            <p class="text-sm text-muted-foreground mt-1">
                                @L.T("内置 ARIA 属性、键盘支持与语义化 HTML 结构", "Includes ARIA attributes, keyboard support, and semantic HTML structure")
                            </p>
                        </div>
                    </div>
                </div>
                <div class="p-4 border rounded-lg">
                    <div class="flex items-start gap-2 mb-2">
                        <span class="text-green-600 dark:text-green-400 text-lg">✓</span>
                        <div>
                            <h3 class="font-semibold">@L.T("完全无样式", "Completely Unstyled")</h3>
                            <p class="text-sm text-muted-foreground mt-1">
                                @L.T("没有 CSS，没有主观预设。套用你自己的设计系统与样式", "No CSS, no opinions. Apply your own design system and styling")
                            </p>
                        </div>
                    </div>
                </div>
                <div class="p-4 border rounded-lg">
                    <div class="flex items-start gap-2 mb-2">
                        <span class="text-green-600 dark:text-green-400 text-lg">✓</span>
                        <div>
                            <h3 class="font-semibold">@L.T("可组合", "Composable")</h3>
                            <p class="text-sm text-muted-foreground mt-1">
                                @L.T("把简单的构件组合起来，构建复杂的组件", "Build complex components by composing simple primitives together")
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("可用的基础构件", "Available Primitives")</h2>
                <p class="text-muted-foreground">
                    @L.T("点击任意构件即可查看演示、API 文档与代码示例。", "Click on any primitive to view demos, API documentation, and code examples.")
                </p>
            </div>

            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- Accordion -->
                <a href="/primitives/accordion" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Accordion</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("垂直堆叠的内容区块，可展开或折叠", "Vertically stacked sections of content that can be expanded or collapsed")
                    </p>
                </a>

                <!-- Alert Dialog -->
                <a href="/primitives/alert-dialog" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Alert Dialog</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("需要显式确认的模态框，不能通过遮罩或 Escape 关闭", "Modal requiring explicit acknowledgement, no dismiss via overlay or Escape")
                    </p>
                </a>

                <!-- Checkbox -->
                <a href="/primitives/checkbox" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Checkbox</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("支持不确定态的二元选择控件", "Binary selection control with indeterminate state support")
                    </p>
                </a>

                <!-- Collapsible -->
                <a href="/primitives/collapsible" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Collapsible</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("带触发器控制的可展开内容区域", "Expandable content area with trigger control")
                    </p>
                </a>

                <!-- Context Menu -->
                <a href="/primitives/context-menu" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Context Menu</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("带键盘导航与定位的右键上下文菜单", "Right-click context menu with keyboard navigation and positioning")
                    </p>
                </a>

                <!-- DataGrid -->
                <a href="/primitives/datagrid" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">DataGrid</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("支持多列排序、分页与选择的企业级数据网格", "Enterprise data grid with multi-column sorting, pagination, and selection")
                    </p>
                </a>

                <!-- Dialog -->
                <a href="/primitives/dialog" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Dialog</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("带遮罩、焦点陷阱与 Escape 处理的模态窗口", "Modal window with overlay, focus trap, and escape handling")
                    </p>
                </a>

                <!-- Dropdown Menu -->
                <a href="/primitives/dropdown-menu" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Dropdown Menu</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("带条目、键盘导航与定位的菜单", "Menu with items, keyboard navigation, and positioning")
                    </p>
                </a>

                <!-- Hover Card -->
                <a href="/primitives/hovercard" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Hover Card</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("悬停时呈现的富内容预览，延时可配置", "Rich content preview on hover with configurable delays")
                    </p>
                </a>

                <!-- Label -->
                <a href="/primitives/label" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Label</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("可自动关联输入框的无障碍标签元素", "Accessible label element with automatic input association")
                    </p>
                </a>

                <!-- Menubar -->
                <a href="/primitives/menubar" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Menubar</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("带键盘导航与悬停切换的横向菜单栏", "Horizontal menubar with keyboard navigation and hover-to-switch")
                    </p>
                </a>

                <!-- Navigation Menu -->
                <a href="/primitives/navigation-menu" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Navigation Menu</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("带悬停下拉与关闭计时的站点导航", "Site navigation with hover dropdowns and close timers")
                    </p>
                </a>

                <!-- Popover -->
                <a href="/primitives/popover" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Popover</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("锚定在触发元素上的浮动内容面板", "Floating content panel anchored to a trigger element")
                    </p>
                </a>

                <!-- Progress -->
                <a href="/primitives/progress" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Progress</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("支持确定态与不确定态的无障碍进度条", "Accessible progress bar with determinate and indeterminate states")
                    </p>
                </a>

                <!-- Radio Group -->
                <a href="/primitives/radio-group" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Radio Group</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("带方向键导航的互斥选择", "Mutually exclusive selection with arrow key navigation")
                    </p>
                </a>

                <!-- Scroll Area -->
                <a href="/primitives/scroll-area" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Scroll Area</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("带无障碍 ARIA scrollbar 角色与拖拽支持的自定义滚动条", "Custom scrollbar with accessible ARIA scrollbar role and drag support")
                    </p>
                </a>

                <!-- Select -->
                <a href="/primitives/select" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Select</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("带键盘导航与搜索的下拉选择菜单", "Dropdown selection menu with keyboard navigation and search")
                    </p>
                </a>

                <!-- Separator -->
                <a href="/primitives/separator" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Separator</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("支持方向的语义或装饰性分隔线", "Semantic or decorative divider with orientation support")
                    </p>
                </a>

                <!-- Sheet -->
                <a href="/primitives/sheet" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Sheet</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("带遮罩、从视口边缘滑入的侧边面板", "Side panel that slides in from edge of viewport with overlay")
                    </p>
                </a>

                <!-- Signature Pad -->
                <a href="/primitives/signature-pad" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Signature Pad</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("用于手写签名的绘制表面，支持 SVG、PNG 与笔画输出", "Drawing surface for a handwritten signature, with SVG, PNG and stroke output")
                    </p>
                </a>

                <!-- Slider -->
                <a href="/primitives/slider" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Slider</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("带键盘导航与指针拖拽支持的滑块输入", "Range input with keyboard navigation and pointer drag support")
                    </p>
                </a>

                <!-- Swipe Area -->
                <a href="/primitives/swipe-area" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Swipe Area</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("带轴锁定与浏览器滚动控制的滑动手势检测", "Swipe gesture detection with axis locking and browser scroll control")
                    </p>
                </a>

                <!-- Sortable -->
                <a href="/primitives/sortable" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Sortable</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("基于 Sortable.js 的无头拖拽排序列表", "Headless drag-and-drop sortable lists with Sortable.js")
                    </p>
                </a>

                <!-- Switch -->
                <a href="/primitives/switch" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Switch</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("用于二元开/关状态的切换控件", "Toggle control for binary on/off states")
                    </p>
                </a>

                <!-- Table -->
                <a href="/primitives/table" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Table</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("带排序、分页与选择的数据表格", "Data table with sorting, pagination, and selection")
                    </p>
                </a>

                <!-- Tabs -->
                <a href="/primitives/tabs" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Tabs</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("带键盘导航与方向支持的选项卡界面", "Tabbed interface with keyboard navigation and orientation support")
                    </p>
                </a>

                <!-- Toggle -->
                <a href="/primitives/toggle" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Toggle</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("带按下/激活状态与 aria-pressed 支持的按钮", "Button with pressed/active state and aria-pressed support")
                    </p>
                </a>

                <!-- Toggle Group -->
                <a href="/primitives/toggle-group" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Toggle Group</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("支持单选或多选并带键盘导航的一组开关", "Group of toggles with single or multiple selection and keyboard navigation")
                    </p>
                </a>

                <!-- Tooltip -->
                <a href="/primitives/tooltip" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Tooltip</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("悬停或聚焦时出现的简短信息提示，支持定位", "Brief informational popup on hover or focus with positioning")
                    </p>
                </a>

                <!-- Tree View -->
                <a href="/primitives/tree-view" class="group p-5 border rounded-lg hover:border-primary hover:bg-accent transition-colors no-underline">
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-primary">Tree View</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("带展开/折叠与键盘导航的层级数据展示", "Hierarchical data display with expand/collapse and keyboard navigation")
                    </p>
                </a>
            </div>
        </section>

        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("为什么要用基础构件？", "Why Use Primitives?")</h2>
            </div>

            <div class="rounded-lg border p-6 space-y-4 bg-muted/30">
                <div class="grid md:grid-cols-2 gap-6">
                    <div class="space-y-3">
                        <h3 class="font-semibold">@L.T("非常适合：", "Perfect For:")</h3>
                        <ul class="space-y-2 text-sm text-muted-foreground">
                            <li class="flex items-start gap-2">
                                <span class="text-green-600 dark:text-green-400">✓</span>
                                <span>@L.T("从零开始构建自定义设计系统", "Building custom design systems from scratch")</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-600 dark:text-green-400">✓</span>
                                <span>@L.T("实现独特的品牌专属设计", "Implementing unique brand-specific designs")</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-600 dark:text-green-400">✓</span>
                                <span>@L.T("使用你自己的 CSS 框架或方法论", "Using your own CSS framework or methodology")</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-600 dark:text-green-400">✓</span>
                                <span>@L.T("对外观拥有最大的灵活性与控制力", "Maximum flexibility and control over appearance")</span>
                            </li>
                        </ul>
                    </div>

                    <div class="space-y-3">
                        <h3 class="font-semibold">@L.T("需要带样式的组件？", "Need Styled Components?")</h3>
                        @if (L.IsChinese)
                        {
                            <text>
                                <p class="text-sm text-muted-foreground">
                                    如果你想要基于 shadcn/ui 设计、带有漂亮默认样式的预置组件，
                                    来看看我们的 <a href="/components" class="text-primary hover:underline">带样式组件</a>。
                                    它们正是构建在这些相同的基础构件之上的。
                                </p>
                            </text>
                        }
                        else
                        {
                            <text>
                                <p class="text-sm text-muted-foreground">
                                    If you want pre-styled components with beautiful defaults based on shadcn/ui design,
                                    check out our <a href="/components" class="text-primary hover:underline">styled components</a>.
                                    They're built on top of these same primitives.
                                </p>
                            </text>
                        }
                        <a href="/components" class="inline-flex items-center px-4 py-2 border rounded text-sm hover:bg-accent transition-colors no-underline">
                            @L.T("查看带样式组件 →", "View Styled Components →")
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;
}
