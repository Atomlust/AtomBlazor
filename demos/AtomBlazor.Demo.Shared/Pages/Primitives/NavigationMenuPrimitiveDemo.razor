@page "/primitives/navigation-menu"
<PageTitle>@L.T("Navigation Menu 导航菜单原语 - Atom BlazorUI", "Navigation Menu Primitive - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("Navigation Menu 导航菜单原语", "Navigation Menu Primitive")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("无头导航菜单，支持悬停打开下拉、关闭定时器与 ARIA 语义。", "Headless navigation menu with hover-to-open dropdowns, close timers, and ARIA semantics.")
            </p>
        </div>
    </div>

    <div class="space-y-6">
        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("基础导航菜单", "Basic Navigation Menu")</h2>
                <p class="text-muted-foreground">
                    @L.T("带下拉项与直接链接的无头导航菜单。悬停打开下拉时使用共享的关闭定时器以防止闪烁。导航事件会自动关闭已打开的菜单。", "A headless navigation menu with dropdown items and direct links. Hover opens dropdowns with a shared close timer to prevent flickering. Navigation events automatically close open menus.")
                </p>
            </div>

            <div class="rounded-lg border bg-card p-6">
                <AtomBlazor.Primitives.NavigationMenuPrimitive EnableKeyboardNavigation="true"
                    class="relative flex max-w-max items-center">
                    <AtomBlazor.Primitives.NavigationMenuList
                        class="flex list-none items-center gap-1">
                        <AtomBlazor.Primitives.NavigationMenuItem Value="getting-started">
                            <AtomBlazor.Primitives.NavigationMenuTrigger
                                class="inline-flex h-10 items-center justify-center rounded-md px-4 py-2 text-sm font-medium hover:bg-accent data-[state=open]:bg-accent/50 transition-colors">
                                @L.T("快速开始", "Getting Started")
                            </AtomBlazor.Primitives.NavigationMenuTrigger>
                            <AtomBlazor.Primitives.NavigationMenuContent
                                class="absolute left-0 top-full mt-1.5 z-50 w-[400px] rounded-md border bg-popover p-4 text-popover-foreground shadow-lg">
                                <div class="grid gap-3">
                                    <div class="space-y-1">
                                        <AtomBlazor.Primitives.NavigationMenuLink Href="/primitives" class="text-sm font-medium leading-none">@L.T("简介", "Introduction")</AtomBlazor.Primitives.NavigationMenuLink>
                                        <p class="text-sm text-muted-foreground">@L.T("了解 AtomBlazor 原语的基础知识。", "Learn the basics of AtomBlazor primitives.")</p>
                                    </div>
                                    <div class="space-y-1">
                                        <AtomBlazor.Primitives.NavigationMenuLink Href="/getting-started" class="text-sm font-medium leading-none">@L.T("安装", "Installation")</AtomBlazor.Primitives.NavigationMenuLink>
                                        <p class="text-sm text-muted-foreground">@L.T("如何安装与配置该库。", "How to install and configure the library.")</p>
                                    </div>
                                    <div class="space-y-1">
                                        <AtomBlazor.Primitives.NavigationMenuLink Href="/primitives/button" class="text-sm font-medium leading-none">@L.T("架构", "Architecture")</AtomBlazor.Primitives.NavigationMenuLink>
                                        <p class="text-sm text-muted-foreground">@L.T("理解两层组件设计。", "Understand the two-layer component design.")</p>
                                    </div>
                                </div>
                            </AtomBlazor.Primitives.NavigationMenuContent>
                        </AtomBlazor.Primitives.NavigationMenuItem>

                        <AtomBlazor.Primitives.NavigationMenuItem Value="components">
                            <AtomBlazor.Primitives.NavigationMenuTrigger
                                class="inline-flex h-10 items-center justify-center rounded-md px-4 py-2 text-sm font-medium hover:bg-accent data-[state=open]:bg-accent/50 transition-colors">
                                @L.T("组件", "Components")
                            </AtomBlazor.Primitives.NavigationMenuTrigger>
                            <AtomBlazor.Primitives.NavigationMenuContent
                                class="absolute left-0 top-full mt-1.5 z-50 w-[500px] rounded-md border bg-popover p-4 text-popover-foreground shadow-lg">
                                <div class="grid grid-cols-2 gap-3">
                                    <div class="space-y-1">
                                        <h3 class="text-sm font-medium leading-none">Button</h3>
                                        <p class="text-sm text-muted-foreground">@L.T("显示一个按钮或链接。", "Displays a button or link.")</p>
                                    </div>
                                    <div class="space-y-1">
                                        <h3 class="text-sm font-medium leading-none">Dialog</h3>
                                        <p class="text-sm text-muted-foreground">@L.T("带遮罩的模态对话框。", "Modal dialog with overlay.")</p>
                                    </div>
                                    <div class="space-y-1">
                                        <h3 class="text-sm font-medium leading-none">Tabs</h3>
                                        <p class="text-sm text-muted-foreground">@L.T("选项卡式内容界面。", "Tabbed content interface.")</p>
                                    </div>
                                    <div class="space-y-1">
                                        <h3 class="text-sm font-medium leading-none">Tooltip</h3>
                                        <p class="text-sm text-muted-foreground">@L.T("悬停时弹出信息。", "Popup info on hover.")</p>
                                    </div>
                                </div>
                            </AtomBlazor.Primitives.NavigationMenuContent>
                        </AtomBlazor.Primitives.NavigationMenuItem>

                        <li>
                            <AtomBlazor.Primitives.NavigationMenuLink
                                Href="/primitives"
                                class="inline-flex h-10 items-center justify-center rounded-md px-4 py-2 text-sm font-medium hover:bg-accent transition-colors">
                                @L.T("文档", "Documentation")
                            </AtomBlazor.Primitives.NavigationMenuLink>
                        </li>
                    </AtomBlazor.Primitives.NavigationMenuList>
                </AtomBlazor.Primitives.NavigationMenuPrimitive>
            </div>

            <CodeBlock Source="Primitives/NavigationMenu/basic.txt" />
        </section>

        <!-- Accessibility Notes -->
        <AccessibilityList>
            <AriaAttributes>
                @if (L.IsChinese)
                {
                    <text>
                        <AccessibilityItem>
                            根元素渲染为 <code class="text-xs bg-muted px-1 py-0.5 rounded">&lt;nav&gt;</code> 以提供语义化导航
                        </AccessibilityItem>
                    </text>
                }
                else
                {
                    <text>
                        <AccessibilityItem>
                    Root renders as <code class="text-xs bg-muted px-1 py-0.5 rounded">&lt;nav&gt;</code> for semantic navigation
                </AccessibilityItem>
                    </text>
                }
                @if (L.IsChinese)
                {
                    <text>
                        <AccessibilityItem>
                            触发器上带有 <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-haspopup="menu"</code> 与 <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-expanded</code>
                        </AccessibilityItem>
                    </text>
                }
                else
                {
                    <text>
                        <AccessibilityItem>
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-haspopup="menu"</code> and <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-expanded</code> on triggers
                </AccessibilityItem>
                    </text>
                }
                @if (L.IsChinese)
                {
                    <text>
                        <AccessibilityItem>
                            内容面板上使用 <code class="text-xs bg-muted px-1 py-0.5 rounded">role="menu"</code>
                        </AccessibilityItem>
                    </text>
                }
                else
                {
                    <text>
                        <AccessibilityItem>
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">role="menu"</code> on content panels
                </AccessibilityItem>
                    </text>
                }
                @if (L.IsChinese)
                {
                    <text>
                        <AccessibilityItem>
                            导航链接上使用 <code class="text-xs bg-muted px-1 py-0.5 rounded">role="menuitem"</code>
                        </AccessibilityItem>
                    </text>
                }
                else
                {
                    <text>
                        <AccessibilityItem>
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">role="menuitem"</code> on navigation links
                </AccessibilityItem>
                    </text>
                }
                @if (L.IsChinese)
                {
                    <text>
                        <AccessibilityItem>
                            <code class="text-xs bg-muted px-1 py-0.5 rounded">data-state="open|closed"</code> 用于 CSS 动画钩子
                        </AccessibilityItem>
                    </text>
                }
                else
                {
                    <text>
                        <AccessibilityItem>
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">data-state="open|closed"</code> for CSS animation hooks
                </AccessibilityItem>
                    </text>
                }
            </AriaAttributes>
            <KeyboardNavigation>
                <KeyboardShortcutItem Description="@(L.T("悬停打开下拉，带 150ms 关闭延迟以防止闪烁", "Hover opens dropdowns with a 150ms close delay to prevent flickering"))">
                    <Kbd>Hover</Kbd>
                </KeyboardShortcutItem>
                <KeyboardShortcutItem Description="@(L.T("路由变化会自动关闭已打开的菜单", "Route changes automatically close open menus"))">
                    <Kbd>Navigate</Kbd>
                </KeyboardShortcutItem>
            </KeyboardNavigation>
        </AccessibilityList>
    </div>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;
}
