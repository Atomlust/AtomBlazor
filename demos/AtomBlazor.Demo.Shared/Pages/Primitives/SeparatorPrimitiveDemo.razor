@page "/primitives/separator"
<PageTitle>@L.T("Separator 分隔线原语 - Atom BlazorUI", "Separator Primitive - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("Separator 分隔线原语", "Separator Primitive")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("无头、无样式的分隔线原语，具有正确的 ARIA 语义。", "Headless, unstyled separator primitive with proper ARIA semantics.")
            </p>
        </div>
    </div>

    <div class="space-y-6">
        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("水平分隔线（语义化）", "Horizontal Separator (Semantic)")</h2>
                <p class="text-muted-foreground">
                    @if (L.IsChinese)
                    {
                        <text>
                            带有 <code class="text-xs bg-muted px-1 py-0.5 rounded">role="separator"</code> 的语义化分隔线，会被屏幕阅读器播报。
                        </text>
                    }
                    else
                    {
                        <text>
                            A semantic separator with <code class="text-xs bg-muted px-1 py-0.5 rounded">role="separator"</code> announced to screen readers.
                        </text>
                    }
                </p>
            </div>

            <div class="rounded-lg border bg-card p-6 space-y-4">
                <div>
                    <h3 class="text-lg font-medium">@L.T("区块一", "Section One")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("分隔线上方的内容。", "Content above the separator.")</p>
                </div>

                <AtomBlazor.Primitives.SeparatorPrimitive
                    Decorative="false"
                    style="height: 1px; width: 100%; background-color: var(--border);" />

                <div>
                    <h3 class="text-lg font-medium">@L.T("区块二", "Section Two")</h3>
                    <p class="text-sm text-muted-foreground">@L.T("分隔线下方的内容。", "Content below the separator.")</p>
                </div>
            </div>

            <CodeBlock Source="Primitives/Separator/horizontal.txt" />
        </section>

        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("装饰性分隔线", "Decorative Separator")</h2>
                <p class="text-muted-foreground">
                    @if (L.IsChinese)
                    {
                        <text>
                            带有 <code class="text-xs bg-muted px-1 py-0.5 rounded">role="none"</code> 的装饰性分隔线，对屏幕阅读器隐藏。
                        </text>
                    }
                    else
                    {
                        <text>
                            A decorative separator with <code class="text-xs bg-muted px-1 py-0.5 rounded">role="none"</code>, hidden from screen readers.
                        </text>
                    }
                </p>
            </div>

            <div class="rounded-lg border bg-card p-6 space-y-4">
                <p class="text-sm text-muted-foreground">@L.T("装饰性分隔线上方。", "Above decorative separator.")</p>

                <AtomBlazor.Primitives.SeparatorPrimitive
                    style="height: 1px; width: 100%; background-color: var(--border);" />

                <p class="text-sm text-muted-foreground">@L.T("装饰性分隔线下方（默认即为装饰性）。", "Below decorative separator (default is decorative).")</p>
            </div>

            <CodeBlock Source="Primitives/Separator/decorative.txt" />
        </section>

        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("垂直分隔线", "Vertical Separator")</h2>
                <p class="text-muted-foreground">
                    @L.T("在水平排列的元素之间的垂直分隔线。", "A vertical separator between horizontally arranged elements.")
                </p>
            </div>

            <div class="rounded-lg border bg-card p-6">
                <div class="flex items-center gap-4" style="height: 40px;">
                    <span class="text-sm font-medium">@L.T("项目 A", "Item A")</span>

                    <AtomBlazor.Primitives.SeparatorPrimitive
                        Orientation="AtomBlazor.Primitives.SeparatorOrientation.Vertical"
                        Decorative="false"
                        style="width: 1px; height: 100%; background-color: var(--border);" />

                    <span class="text-sm font-medium">@L.T("项目 B", "Item B")</span>

                    <AtomBlazor.Primitives.SeparatorPrimitive
                        Orientation="AtomBlazor.Primitives.SeparatorOrientation.Vertical"
                        Decorative="false"
                        style="width: 1px; height: 100%; background-color: var(--border);" />

                    <span class="text-sm font-medium">@L.T("项目 C", "Item C")</span>
                </div>
            </div>

            <CodeBlock Source="Primitives/Separator/vertical.txt" />
        </section>

    <!-- Accessibility Notes -->
    <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>
                @if (L.IsChinese)
                {
                    <text>
                        语义模式下为 <code class="text-xs bg-muted px-1 py-0.5 rounded">role="separator"</code>，会连同方向一起播报给屏幕阅读器
                    </text>
                }
                else
                {
                    <text>
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">role="separator"</code> in semantic mode, announced to screen readers with orientation
                    </text>
                }
            </AccessibilityItem>
            <AccessibilityItem>
                @if (L.IsChinese)
                {
                    <text>
                        装饰模式（默认）下为 <code class="text-xs bg-muted px-1 py-0.5 rounded">role="none"</code>，对辅助技术隐藏
                    </text>
                }
                else
                {
                    <text>
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">role="none"</code> in decorative mode (default), hidden from assistive technologies
                    </text>
                }
            </AccessibilityItem>
            <AccessibilityItem>
                @if (L.IsChinese)
                {
                    <text>
                        语义模式下将 <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-orientation</code> 设为 "horizontal" 或 "vertical"
                    </text>
                }
                else
                {
                    <text>
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-orientation</code> set to "horizontal" or "vertical" in semantic mode
                    </text>
                }
            </AccessibilityItem>
            <AccessibilityItem>
                @if (L.IsChinese)
                {
                    <text>
                        始终带有 <code class="text-xs bg-muted px-1 py-0.5 rounded">data-orientation</code>，作为 CSS 样式钩子
                    </text>
                }
                else
                {
                    <text>
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">data-orientation</code> always present for CSS styling hooks
                    </text>
                }
            </AccessibilityItem>
        </AriaAttributes>
    </AccessibilityList>

    <!-- API Reference -->
    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件的属性与参数。", "Component properties and parameters.")</p>
        </div>
        <div class="space-y-4">
            <ApiReference ComponentName="Separator">
                <ApiParameter Name="Orientation" Type="SeparatorOrientation" Default="AtomBlazor.SeparatorOrientation.Horizontal">
                    @if (L.IsChinese)
                    {
                        <text>
                            分隔线的方向。决定渲染出的 <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-orientation</code> 属性。
                        </text>
                    }
                    else
                    {
                        <text>
                            The orientation of the separator. Determines the rendered <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-orientation</code> attribute.
                        </text>
                    }
                </ApiParameter>
                <ApiParameter Name="Decorative" Type="bool" Default="true">
                    @if (L.IsChinese)
                    {
                        <text>
                            为 true 时渲染 <code class="text-xs bg-muted px-1 py-0.5 rounded">role="none"</code> 并对辅助技术隐藏。为 false 时渲染 <code class="text-xs bg-muted px-1 py-0.5 rounded">role="separator"</code>。
                        </text>
                    }
                    else
                    {
                        <text>
                            When true, renders <code class="text-xs bg-muted px-1 py-0.5 rounded">role="none"</code> and hides from assistive technology. When false, renders <code class="text-xs bg-muted px-1 py-0.5 rounded">role="separator"</code>.
                        </text>
                    }
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    @if (L.IsChinese)
                    {
                        <text>
                            应用到根 <code>&lt;div&gt;</code> 元素的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                        </text>
                    }
                    else
                    {
                        <text>
                            Additional HTML attributes applied to the root <code>&lt;div&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                        </text>
                    }
                </ApiParameter>
            </ApiReference>
        </div>
    </section>
    </div>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;
}
