@page "/primitives/datagrid"
@using AtomBlazor.Icons.Lucide

<PageTitle>@L.T("DataGrid 基础件 - Atom BlazorUI", "DataGrid Primitive - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-7xl">
    <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">@L.T("DataGrid 基础件", "DataGrid Primitive")</h1>
        <p class="text-xl text-muted-foreground">
            @L.T("无头、无样式的数据网格基础件，支持多列排序、分页与选择。面向企业场景设计，支持 IQueryable、IEnumerable 与异步 ItemsProvider。", "Headless, unstyled data grid primitive with multi-column sorting, pagination, and selection. Designed for enterprise scenarios with IQueryable, IEnumerable, and async ItemsProvider support.")
        </p>
    </div>

    <div class="space-y-6">

    @* Basic DataGrid *@
    <section class="space-y-4">
        <div>
            <h2 class="text-2xl font-semibold">@L.T("基础 DataGrid", "Basic DataGrid")</h2>
            <p class="text-sm text-muted-foreground">@L.T("不带排序、分页或选择的简单数据网格。使用无头基础件配合内联样式。", "Simple data grid with no sorting, pagination, or selection. Uses headless primitives with inline styling.")</p>
        </div>

        <div class="rounded-md border">
            <AtomBlazor.Primitives.DataGridPrimitive TData="Person" Items="@people" ManualPagination="true" AriaLabel="@(L.T("基础人员表格", "Basic people grid"))" Class="w-full caption-bottom text-sm">
                <DataGridHeader Class="[&_tr]:border-b">
                    <tr class="border-b transition-colors hover:bg-muted/50">
                        <DataGridHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("姓名", "Name")</DataGridHeaderCell>
                        <DataGridHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("邮箱", "Email")</DataGridHeaderCell>
                        <DataGridHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("年龄", "Age")</DataGridHeaderCell>
                        <DataGridHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("部门", "Department")</DataGridHeaderCell>
                    </tr>
                </DataGridHeader>
                <DataGridBody Class="[&_tr:last-child]:border-0">
                    @foreach (var person in people)
                    {
                        <DataGridRow TData="Person" Class="border-b transition-colors hover:bg-muted/50">
                            <DataGridCell Class="p-4 align-middle">@person.Name</DataGridCell>
                            <DataGridCell Class="p-4 align-middle">@person.Email</DataGridCell>
                            <DataGridCell Class="p-4 align-middle">@person.Age</DataGridCell>
                            <DataGridCell Class="p-4 align-middle">@person.Department</DataGridCell>
                        </DataGridRow>
                    }
                </DataGridBody>
            </AtomBlazor.Primitives.DataGridPrimitive>
        </div>
        <CodeBlock Source="Primitives/DataGrid/basic.txt" />
    </section>

    @* Sortable DataGrid (Multi-Sort) *@
    <section class="space-y-4">
        <div>
            <h2 class="text-2xl font-semibold">@L.T("可排序 DataGrid（多列排序）", "Sortable DataGrid (Multi-Sort)")</h2>
            @if (L.IsChinese)
            {
                <text>
                    <p class="text-sm text-muted-foreground">
                        点击列头即可排序。三态循环：无 → 升序 → 降序 → 无。
                        按住 <kbd class="px-1.5 py-0.5 text-xs border rounded bg-muted">Ctrl</kbd> 并点击可追加多列排序。
                    </p>
                </text>
            }
            else
            {
                <text>
                    <p class="text-sm text-muted-foreground">
                        Click column headers to sort. Three-state cycle: None → Ascending → Descending → None.
                        Hold <kbd class="px-1.5 py-0.5 text-xs border rounded bg-muted">Ctrl</kbd> and click to add multi-column sorting.
                    </p>
                </text>
            }
        </div>

        <div class="rounded-md border">
            <AtomBlazor.Primitives.DataGridPrimitive TData="Person" Items="@GetSortedPeople()" @bind-State="@sortableGridState" ManualPagination="true"
                        OnSortChange="@HandleSortChanged" AriaLabel="@(L.T("可排序人员表格", "Sortable people grid"))" Class="w-full caption-bottom text-sm">
                <DataGridHeader Class="[&_tr]:border-b">
                    <tr class="border-b transition-colors hover:bg-muted/50">
                        <DataGridHeaderCell TData="Person" ColumnId="name" Sortable="true"
                                              Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground cursor-pointer select-none hover:bg-accent">
                            <div class="flex items-center gap-2">
                                <span>@L.T("姓名", "Name")</span>
                                @{ var nameDir = sortableGridState.Sorting.GetDirection("name"); }
                                @if (nameDir == SortDirection.Ascending)
                                {
                                    <span class="text-xs">↑</span>
                                }
                                else if (nameDir == SortDirection.Descending)
                                {
                                    <span class="text-xs">↓</span>
                                }
                                @{ var namePri = sortableGridState.Sorting.GetPriority("name"); }
                                @if (namePri > 0 && sortableGridState.Sorting.Definitions.Count > 1)
                                {
                                    <span class="text-[10px] bg-primary text-primary-foreground rounded-full w-4 h-4 inline-flex items-center justify-center">@namePri</span>
                                }
                            </div>
                        </DataGridHeaderCell>
                        <DataGridHeaderCell TData="Person" ColumnId="email" Sortable="true"
                                              Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground cursor-pointer select-none hover:bg-accent">
                            <div class="flex items-center gap-2">
                                <span>@L.T("邮箱", "Email")</span>
                                @{ var emailDir = sortableGridState.Sorting.GetDirection("email"); }
                                @if (emailDir == SortDirection.Ascending)
                                {
                                    <span class="text-xs">↑</span>
                                }
                                else if (emailDir == SortDirection.Descending)
                                {
                                    <span class="text-xs">↓</span>
                                }
                                @{ var emailPri = sortableGridState.Sorting.GetPriority("email"); }
                                @if (emailPri > 0 && sortableGridState.Sorting.Definitions.Count > 1)
                                {
                                    <span class="text-[10px] bg-primary text-primary-foreground rounded-full w-4 h-4 inline-flex items-center justify-center">@emailPri</span>
                                }
                            </div>
                        </DataGridHeaderCell>
                        <DataGridHeaderCell TData="Person" ColumnId="age" Sortable="true"
                                              Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground cursor-pointer select-none hover:bg-accent">
                            <div class="flex items-center gap-2">
                                <span>@L.T("年龄", "Age")</span>
                                @{ var ageDir = sortableGridState.Sorting.GetDirection("age"); }
                                @if (ageDir == SortDirection.Ascending)
                                {
                                    <span class="text-xs">↑</span>
                                }
                                else if (ageDir == SortDirection.Descending)
                                {
                                    <span class="text-xs">↓</span>
                                }
                                @{ var agePri = sortableGridState.Sorting.GetPriority("age"); }
                                @if (agePri > 0 && sortableGridState.Sorting.Definitions.Count > 1)
                                {
                                    <span class="text-[10px] bg-primary text-primary-foreground rounded-full w-4 h-4 inline-flex items-center justify-center">@agePri</span>
                                }
                            </div>
                        </DataGridHeaderCell>
                        <DataGridHeaderCell TData="Person" ColumnId="department" Sortable="true"
                                              Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground cursor-pointer select-none hover:bg-accent">
                            <div class="flex items-center gap-2">
                                <span>@L.T("部门", "Department")</span>
                                @{ var deptDir = sortableGridState.Sorting.GetDirection("department"); }
                                @if (deptDir == SortDirection.Ascending)
                                {
                                    <span class="text-xs">↑</span>
                                }
                                else if (deptDir == SortDirection.Descending)
                                {
                                    <span class="text-xs">↓</span>
                                }
                                @{ var deptPri = sortableGridState.Sorting.GetPriority("department"); }
                                @if (deptPri > 0 && sortableGridState.Sorting.Definitions.Count > 1)
                                {
                                    <span class="text-[10px] bg-primary text-primary-foreground rounded-full w-4 h-4 inline-flex items-center justify-center">@deptPri</span>
                                }
                            </div>
                        </DataGridHeaderCell>
                    </tr>
                </DataGridHeader>
                <DataGridBody Class="[&_tr:last-child]:border-0">
                    @foreach (var person in GetSortedPeople())
                    {
                        <DataGridRow TData="Person" Class="border-b transition-colors hover:bg-muted/50">
                            <DataGridCell Class="p-4 align-middle">@person.Name</DataGridCell>
                            <DataGridCell Class="p-4 align-middle">@person.Email</DataGridCell>
                            <DataGridCell Class="p-4 align-middle">@person.Age</DataGridCell>
                            <DataGridCell Class="p-4 align-middle">@person.Department</DataGridCell>
                        </DataGridRow>
                    }
                </DataGridBody>
            </AtomBlazor.Primitives.DataGridPrimitive>
        </div>

        <div class="rounded-lg border bg-card p-4">
            <h3 class="font-semibold mb-2">@L.T("当前排序状态", "Current Sort State")</h3>
            <div class="text-sm space-y-1">
                @if (sortableGridState.Sorting.Definitions.Count == 0)
                {
                    @if (L.IsChinese)
                    {
                        <text><p><span class="font-medium">排序：</span> 无</p></text>
                    }
                    else
                    {
                        <text><p><span class="font-medium">Sorting:</span> None</p></text>
                    }
                }
                else
                {
                    @foreach (var def in sortableGridState.Sorting.Definitions)
                    {
                        @if (L.IsChinese)
                        {
                            <text>
                                <p>
                                    <span class="font-medium">@def.ColumnId：</span> @def.Direction
                                    <span class="text-muted-foreground">（优先级 @sortableGridState.Sorting.GetPriority(def.ColumnId)）</span>
                                </p>
                            </text>
                        }
                        else
                        {
                            <text>
                                <p>
                                    <span class="font-medium">@def.ColumnId:</span> @def.Direction
                                    <span class="text-muted-foreground">(priority @sortableGridState.Sorting.GetPriority(def.ColumnId))</span>
                                </p>
                            </text>
                        }
                    }
                }
            </div>
        </div>
        <CodeBlock Source="Primitives/DataGrid/sortable.txt" />
    </section>

    @* Paginated DataGrid *@
    <section class="space-y-4">
        <div>
            <h2 class="text-2xl font-semibold">@L.T("分页 DataGrid", "Paginated DataGrid")</h2>
            <p class="text-sm text-muted-foreground">@L.T("带有手动分页控件、可配置每页条数的数据网格", "Data grid with manual pagination controls and configurable page size")</p>
        </div>

        <div class="space-y-4">
            <div class="rounded-md border">
                <AtomBlazor.Primitives.DataGridPrimitive TData="Person" Items="@GetPaginatedData()" @bind-State="@paginatedGridState" ManualPagination="true"
                            AriaLabel="@(L.T("分页人员表格", "Paginated people grid"))" Class="w-full caption-bottom text-sm">
                    <DataGridHeader Class="[&_tr]:border-b">
                        <tr class="border-b transition-colors hover:bg-muted/50">
                            <DataGridHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("姓名", "Name")</DataGridHeaderCell>
                            <DataGridHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("邮箱", "Email")</DataGridHeaderCell>
                            <DataGridHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("年龄", "Age")</DataGridHeaderCell>
                            <DataGridHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("部门", "Department")</DataGridHeaderCell>
                        </tr>
                    </DataGridHeader>
                    <DataGridBody Class="[&_tr:last-child]:border-0">
                        @foreach (var person in GetPaginatedData())
                        {
                            <DataGridRow TData="Person" Class="border-b transition-colors hover:bg-muted/50">
                                <DataGridCell Class="p-4 align-middle">@person.Name</DataGridCell>
                                <DataGridCell Class="p-4 align-middle">@person.Email</DataGridCell>
                                <DataGridCell Class="p-4 align-middle">@person.Age</DataGridCell>
                                <DataGridCell Class="p-4 align-middle">@person.Department</DataGridCell>
                            </DataGridRow>
                        }
                    </DataGridBody>
                </AtomBlazor.Primitives.DataGridPrimitive>
            </div>

            <div class="flex items-center justify-between px-2">
                <div class="flex-1 text-sm text-muted-foreground">
                    @if (L.IsChinese)
                    {
                        <text>显示 @paginatedGridState.Pagination.FirstItemIndex-@paginatedGridState.Pagination.LastItemIndex 条，共 @paginatedGridState.Pagination.TotalItems 条</text>
                    }
                    else
                    {
                        <text>Showing @paginatedGridState.Pagination.FirstItemIndex-@paginatedGridState.Pagination.LastItemIndex of @paginatedGridState.Pagination.TotalItems</text>
                    }
                </div>
                <div class="flex items-center space-x-6 lg:space-x-8">
                    <div class="flex items-center space-x-2">
                        <p class="text-sm font-medium">@L.T("每页行数", "Rows per page")</p>
                        <select @onchange="@HandlePaginatedPageSizeChange"
                                class="h-8 w-[70px] rounded-md border border-input bg-background px-2 py-1 text-sm">
                            @foreach (var size in new[] { 5, 10, 20 })
                            {
                                <option value="@size" selected="@(paginatedGridState.Pagination.PageSize == size)">@size</option>
                            }
                        </select>
                    </div>
                    <div class="flex w-[100px] items-center justify-center text-sm font-medium">
                        @L.F("第 {0} 页，共 {1} 页", "Page {0} of {1}", paginatedGridState.Pagination.CurrentPage, paginatedGridState.Pagination.TotalPages)
                    </div>
                    <div class="flex items-center space-x-2">
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon"
                                  OnClick="@(() => { paginatedGridState.Pagination.FirstPage(); StateHasChanged(); })"
                                  Disabled="@(!paginatedGridState.Pagination.CanGoPrevious)" AriaLabel="@(L.T("跳转到第一页", "Go to first page"))">
                            <LucideIcon Name="chevrons-left" Size="16" />
                        </Button>
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon"
                                  OnClick="@(() => { paginatedGridState.Pagination.PreviousPage(); StateHasChanged(); })"
                                  Disabled="@(!paginatedGridState.Pagination.CanGoPrevious)" AriaLabel="@(L.T("跳转到上一页", "Go to previous page"))">
                            <LucideIcon Name="chevron-left" Size="16" />
                        </Button>
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon"
                                  OnClick="@(() => { paginatedGridState.Pagination.NextPage(); StateHasChanged(); })"
                                  Disabled="@(!paginatedGridState.Pagination.CanGoNext)" AriaLabel="@(L.T("跳转到下一页", "Go to next page"))">
                            <LucideIcon Name="chevron-right" Size="16" />
                        </Button>
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon"
                                  OnClick="@(() => { paginatedGridState.Pagination.LastPage(); StateHasChanged(); })"
                                  Disabled="@(!paginatedGridState.Pagination.CanGoNext)" AriaLabel="@(L.T("跳转到最后一页", "Go to last page"))">
                            <LucideIcon Name="chevrons-right" Size="16" />
                        </Button>
                    </div>
                </div>
            </div>
        </div>
        <CodeBlock Source="Primitives/DataGrid/paginated.txt" />
    </section>

    @* Selectable DataGrid (Multi-Select) *@
    <section class="space-y-4">
        <div>
            <h2 class="text-2xl font-semibold">@L.T("可选择 DataGrid（多选）", "Selectable DataGrid (Multi-Select)")</h2>
            <p class="text-sm text-muted-foreground">@L.T("点击行或复选框进行选择。点击表头复选框可全选或取消全选。使用方向键移动焦点，按 Enter/Space 选择。", "Click rows or checkboxes to select. Click header checkbox to select/deselect all. Use arrow keys to navigate and Enter/Space to select.")</p>
        </div>

        <div class="space-y-4">
            <div class="rounded-md border">
                <AtomBlazor.Primitives.DataGridPrimitive TData="Person" Items="@people" @bind-State="@selectableGridState" ManualPagination="true"
                            SelectionMode="SelectionMode.Multiple" EnableKeyboardNavigation="true"
                            OnSelectionChange="@HandleSelectionChange" AriaLabel="@(L.T("可选择人员表格", "Selectable people grid"))" Class="w-full caption-bottom text-sm">
                    <DataGridHeader Class="[&_tr]:border-b">
                        <tr class="border-b transition-colors hover:bg-muted/50">
                            @* AriaLabel names a header cell whose content carries no text of its own *@
                            <DataGridHeaderCell TData="Person" AriaLabel="@(L.T("选择", "Select"))" Class="h-12 w-12 px-4">
                                <input type="checkbox"
                                       checked="@selectAllChecked"
                                       @onchange="@HandleSelectAllChanged"
                                       @onclick:stopPropagation="true"
                                       class="h-4 w-4 rounded border-gray-300 text-primary focus:ring-2 focus:ring-primary"
                                       aria-label="@(L.T("全选", "Select all"))" />
                            </DataGridHeaderCell>
                            <DataGridHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("姓名", "Name")</DataGridHeaderCell>
                            <DataGridHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("邮箱", "Email")</DataGridHeaderCell>
                            <DataGridHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("年龄", "Age")</DataGridHeaderCell>
                            <DataGridHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("部门", "Department")</DataGridHeaderCell>
                        </tr>
                    </DataGridHeader>
                    <DataGridBody Class="[&_tr:last-child]:border-0">
                        @foreach (var person in people)
                        {
                            var isSelected = selectableGridState.Selection.IsSelected(person);
                            <DataGridRow TData="Person" Item="@person" Class="@($"border-b transition-colors hover:bg-muted/50 cursor-pointer {(isSelected ? "bg-muted" : "")}")">
                                <DataGridCell Class="w-12 px-4">
                                    <input type="checkbox"
                                           checked="@isSelected"
                                           @onchange="@(() => ToggleRowSelection(person))"
                                           @onclick:stopPropagation="true"
                                           @onkeydown:stopPropagation="true"
                                           tabindex="-1"
                                           class="h-4 w-4 rounded border-gray-300 text-primary focus:ring-2 focus:ring-primary"
                                           aria-label="@(L.IsChinese ? $"选择 {person.Name}" : $"Select {person.Name}")" />
                                </DataGridCell>
                                <DataGridCell Class="p-4 align-middle">@person.Name</DataGridCell>
                                <DataGridCell Class="p-4 align-middle">@person.Email</DataGridCell>
                                <DataGridCell Class="p-4 align-middle">@person.Age</DataGridCell>
                                <DataGridCell Class="p-4 align-middle">@person.Department</DataGridCell>
                            </DataGridRow>
                        }
                    </DataGridBody>
                </AtomBlazor.Primitives.DataGridPrimitive>
            </div>

            <div class="rounded-lg border bg-card p-4">
                <h3 class="font-semibold mb-2">@L.T("选择状态", "Selection State")</h3>
                <div class="text-sm space-y-1">
                    @if (L.IsChinese)
                    {
                        <text><p><span class="font-medium">已选择：</span> @selectableGridState.Selection.SelectedCount 行</p></text>
                    }
                    else
                    {
                        <text><p><span class="font-medium">Selected:</span> @selectableGridState.Selection.SelectedCount rows</p></text>
                    }
                    @if (selectableGridState.Selection.SelectedCount > 0)
                    {
                        <div class="mt-2">
                            <button @onclick="@(() => { selectableGridState.Selection.Clear(); selectAllChecked = false; StateHasChanged(); })"
                                    class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-8 px-4">
                                @L.T("清除选择", "Clear Selection")
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
        <CodeBlock Source="Primitives/DataGrid/selectable.txt" />
    </section>

    @* Column Visibility *@
    <section class="space-y-4">
        <div>
            <h2 class="text-2xl font-semibold">@L.T("列可见性", "Column Visibility")</h2>
            @if (L.IsChinese)
            {
                <text>
                    <p class="text-sm text-muted-foreground">
                        使用 <code class="bg-muted px-1 py-0.5 rounded">DataGridColumnState</code> 以编程方式切换列的
                        可见性。可见性变化时触发 <code class="bg-muted px-1 py-0.5 rounded">OnColumnVisibilityChange</code>
                        回调。
                    </p>
                </text>
            }
            else
            {
                <text>
                    <p class="text-sm text-muted-foreground">
                        Use <code class="bg-muted px-1 py-0.5 rounded">DataGridColumnState</code> to toggle column
                        visibility programmatically. The <code class="bg-muted px-1 py-0.5 rounded">OnColumnVisibilityChange</code>
                        callback fires when visibility changes.
                    </p>
                </text>
            }
        </div>

        <div class="space-y-4">
            <div class="flex items-center gap-2 flex-wrap">
                @foreach (var colId in visibilityColumnIds)
                {
                    var isVisible = visibilityGridState.Columns.IsVisible(colId);
                    <button @onclick="@(() => ToggleColumnVisibility(colId))"
                            class="@($"inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors h-8 px-3 border {(isVisible ? "bg-primary text-primary-foreground border-primary" : "bg-background text-foreground border-input hover:bg-accent")}")">
                        @colId
                    </button>
                }
            </div>

            <div class="rounded-md border">
                <AtomBlazor.Primitives.DataGridPrimitive TData="Person" Items="@people" @bind-State="@visibilityGridState" ManualPagination="true"
                            OnColumnVisibilityChange="@HandleVisibilityChange" AriaLabel="@(L.T("列可见性表格", "Column visibility grid"))" Class="w-full caption-bottom text-sm">
                    <DataGridHeader Class="[&_tr]:border-b">
                        <tr class="border-b transition-colors hover:bg-muted/50">
                            @foreach (var colId in visibilityColumnIds)
                            {
                                @if (visibilityGridState.Columns.IsVisible(colId))
                                {
                                    <DataGridHeaderCell TData="Person" ColumnId="@colId"
                                                          Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">
                                        @GetColumnTitle(colId)
                                    </DataGridHeaderCell>
                                }
                            }
                        </tr>
                    </DataGridHeader>
                    <DataGridBody Class="[&_tr:last-child]:border-0">
                        @foreach (var person in people)
                        {
                            <DataGridRow TData="Person" Class="border-b transition-colors hover:bg-muted/50">
                                @if (visibilityGridState.Columns.IsVisible("name"))
                                {
                                    <DataGridCell Class="p-4 align-middle">@person.Name</DataGridCell>
                                }
                                @if (visibilityGridState.Columns.IsVisible("email"))
                                {
                                    <DataGridCell Class="p-4 align-middle">@person.Email</DataGridCell>
                                }
                                @if (visibilityGridState.Columns.IsVisible("age"))
                                {
                                    <DataGridCell Class="p-4 align-middle">@person.Age</DataGridCell>
                                }
                                @if (visibilityGridState.Columns.IsVisible("department"))
                                {
                                    <DataGridCell Class="p-4 align-middle">@person.Department</DataGridCell>
                                }
                            </DataGridRow>
                        }
                    </DataGridBody>
                </AtomBlazor.Primitives.DataGridPrimitive>
            </div>

            <div class="rounded-lg border bg-card p-4">
                <h3 class="font-semibold mb-2">@L.T("可见性状态", "Visibility State")</h3>
                <div class="text-sm space-y-1">
                    @foreach (var colId in visibilityColumnIds)
                    {
                        <p>
                            <span class="font-medium">@colId:</span>
                            @(visibilityGridState.Columns.IsVisible(colId) ? L.T("可见", "Visible") : L.T("已隐藏", "Hidden"))
                        </p>
                    }
                </div>
            </div>
        </div>
        <CodeBlock Source="Primitives/DataGrid/column-visibility.txt" />
    </section>

    @* Reorderable Headers *@
    <section class="space-y-4">
        <div>
            <h2 class="text-2xl font-semibold">@L.T("可重排表头", "Reorderable Headers")</h2>
            @if (L.IsChinese)
            {
                <text>
                    <p class="text-sm text-muted-foreground">
                        在 <code class="bg-muted px-1 py-0.5 rounded">DataGridHeaderCell</code> 上设置
                        <code class="bg-muted px-1 py-0.5 rounded">Reorderable="true"</code> 即可渲染
                        <code class="bg-muted px-1 py-0.5 rounded">draggable="true"</code> 与
                        <code class="bg-muted px-1 py-0.5 rounded">data-column-id</code> 属性。
                        使用 <code class="bg-muted px-1 py-0.5 rounded">OnColumnReorder</code> 处理重排事件。
                        本示例用按钮通过 <code class="bg-muted px-1 py-0.5 rounded">DataGridColumnState.ReorderColumn()</code> 以编程方式重排。
                    </p>
                </text>
            }
            else
            {
                <text>
                    <p class="text-sm text-muted-foreground">
                        Set <code class="bg-muted px-1 py-0.5 rounded">Reorderable="true"</code> on
                        <code class="bg-muted px-1 py-0.5 rounded">DataGridHeaderCell</code> to render
                        <code class="bg-muted px-1 py-0.5 rounded">draggable="true"</code> and
                        <code class="bg-muted px-1 py-0.5 rounded">data-column-id</code> attributes.
                        Use <code class="bg-muted px-1 py-0.5 rounded">OnColumnReorder</code> to handle reorder events.
                        This example uses buttons to reorder programmatically via <code class="bg-muted px-1 py-0.5 rounded">DataGridColumnState.ReorderColumn()</code>.
                    </p>
                </text>
            }
        </div>

        <div class="space-y-4">
            <div class="flex items-center gap-2 flex-wrap">
                @foreach (var colId in GetReorderableVisibleColumns())
                {
                    var order = reorderGridState.Columns.Entries.FirstOrDefault(e => e.ColumnId == colId)?.Order ?? 0;
                    <div class="inline-flex items-center gap-1 rounded-md border px-2 py-1 text-sm">
                        <button @onclick="@(() => MoveColumnLeft(colId))" disabled="@(order == 0)"
                                class="h-5 w-5 inline-flex items-center justify-center rounded hover:bg-accent disabled:opacity-30"
                                aria-label="@(L.IsChinese ? $"将 {colId} 左移" : $"Move {colId} left")">
                            <LucideIcon Name="chevron-left" Size="14" />
                        </button>
                        <span class="font-medium px-1">@GetColumnTitle(colId)</span>
                        <button @onclick="@(() => MoveColumnRight(colId))" disabled="@(order >= reorderColumnIds.Length - 1)"
                                class="h-5 w-5 inline-flex items-center justify-center rounded hover:bg-accent disabled:opacity-30"
                                aria-label="@(L.IsChinese ? $"将 {colId} 右移" : $"Move {colId} right")">
                            <LucideIcon Name="chevron-right" Size="14" />
                        </button>
                    </div>
                }
            </div>

            <div class="rounded-md border">
                <AtomBlazor.Primitives.DataGridPrimitive TData="Person" Items="@people" @bind-State="@reorderGridState" ManualPagination="true"
                            OnColumnReorder="@HandleReorder" AriaLabel="@(L.T("可重排表头表格", "Reorderable headers grid"))" Class="w-full caption-bottom text-sm">
                    <DataGridHeader Class="[&_tr]:border-b">
                        <tr class="border-b transition-colors hover:bg-muted/50">
                            @foreach (var colId in GetReorderableVisibleColumns())
                            {
                                <DataGridHeaderCell TData="Person" ColumnId="@colId" Reorderable="true"
                                                      Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">
                                    @GetColumnTitle(colId)
                                </DataGridHeaderCell>
                            }
                        </tr>
                    </DataGridHeader>
                    <DataGridBody Class="[&_tr:last-child]:border-0">
                        @foreach (var person in people)
                        {
                            <DataGridRow TData="Person" Class="border-b transition-colors hover:bg-muted/50">
                                @foreach (var colId in GetReorderableVisibleColumns())
                                {
                                    <DataGridCell Class="p-4 align-middle">
                                        @GetCellValue(person, colId)
                                    </DataGridCell>
                                }
                            </DataGridRow>
                        }
                    </DataGridBody>
                </AtomBlazor.Primitives.DataGridPrimitive>
            </div>

            <div class="rounded-lg border bg-card p-4">
                <h3 class="font-semibold mb-2">@L.T("列顺序", "Column Order")</h3>
                <div class="text-sm">
                    @string.Join(" → ", GetReorderableVisibleColumns().Select(c => GetColumnTitle(c)))
                </div>
            </div>
        </div>
        <CodeBlock Source="Primitives/DataGrid/reorderable.txt" />
    </section>

    @* Column Resize *@
    <section class="space-y-4">
        <div>
            <h2 class="text-2xl font-semibold">@L.T("列缩放", "Column Resize")</h2>
            @if (L.IsChinese)
            {
                <text>
                    <p class="text-sm text-muted-foreground">
                        使用 <code class="bg-muted px-1 py-0.5 rounded">DataGridColumnState.SetWidth()</code> 与
                        <code class="bg-muted px-1 py-0.5 rounded">GetWidth()</code> 以编程方式控制列宽。
                        列宽变化时触发 <code class="bg-muted px-1 py-0.5 rounded">OnColumnResize</code> 回调。
                        基础件负责状态管理；可拖拽的缩放交互位于 Component 层。
                    </p>
                </text>
            }
            else
            {
                <text>
                    <p class="text-sm text-muted-foreground">
                        Use <code class="bg-muted px-1 py-0.5 rounded">DataGridColumnState.SetWidth()</code> and
                        <code class="bg-muted px-1 py-0.5 rounded">GetWidth()</code> to control column widths programmatically.
                        The <code class="bg-muted px-1 py-0.5 rounded">OnColumnResize</code> callback fires when column widths change.
                        The primitive provides the state management; interactive drag resize lives in the Component layer.
                    </p>
                </text>
            }
        </div>

        <div class="space-y-4">
            <div class="flex items-center gap-2 flex-wrap">
                @foreach (var colId in resizeColumnIds)
                {
                    var currentWidth = resizeGridState.Columns.GetWidth(colId);
                    <div class="inline-flex items-center gap-1 rounded-md border px-2 py-1 text-sm">
                        <span class="font-medium">@GetColumnTitle(colId):</span>
                        <button @onclick="@(() => SetColumnWidth(colId, "100px"))"
                                class="@($"h-6 px-2 rounded text-xs {(currentWidth == "100px" ? "bg-primary text-primary-foreground" : "hover:bg-accent")}")">
                            100px
                        </button>
                        <button @onclick="@(() => SetColumnWidth(colId, "200px"))"
                                class="@($"h-6 px-2 rounded text-xs {(currentWidth == "200px" ? "bg-primary text-primary-foreground" : "hover:bg-accent")}")">
                            200px
                        </button>
                        <button @onclick="@(() => SetColumnWidth(colId, null))"
                                class="@($"h-6 px-2 rounded text-xs {(currentWidth == null ? "bg-primary text-primary-foreground" : "hover:bg-accent")}")">
                            @L.T("自动", "Auto")
                        </button>
                    </div>
                }
            </div>

            <div class="rounded-md border">
                <AtomBlazor.Primitives.DataGridPrimitive TData="Person" Items="@people" @bind-State="@resizeGridState" ManualPagination="true"
                            OnColumnResize="@HandleResize" AriaLabel="@(L.T("可缩放列表格", "Resizable columns grid"))" Class="w-full caption-bottom text-sm"
                            style="table-layout: fixed;">
                    <DataGridHeader Class="[&_tr]:border-b">
                        <tr class="border-b transition-colors hover:bg-muted/50">
                            @foreach (var colId in resizeColumnIds)
                            {
                                var width = resizeGridState.Columns.GetWidth(colId);
                                <DataGridHeaderCell TData="Person" ColumnId="@colId"
                                                      Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground overflow-hidden text-ellipsis whitespace-nowrap"
                                                      style="@(width != null ? $"width: {width}" : null)">
                                    @GetColumnTitle(colId)
                                </DataGridHeaderCell>
                            }
                        </tr>
                    </DataGridHeader>
                    <DataGridBody Class="[&_tr:last-child]:border-0">
                        @foreach (var person in people)
                        {
                            <DataGridRow TData="Person" Class="border-b transition-colors hover:bg-muted/50">
                                @foreach (var colId in resizeColumnIds)
                                {
                                    <DataGridCell Class="p-4 align-middle overflow-hidden text-ellipsis whitespace-nowrap">
                                        @GetCellValue(person, colId)
                                    </DataGridCell>
                                }
                            </DataGridRow>
                        }
                    </DataGridBody>
                </AtomBlazor.Primitives.DataGridPrimitive>
            </div>

            <div class="rounded-lg border bg-card p-4">
                <h3 class="font-semibold mb-2">@L.T("列宽", "Column Widths")</h3>
                <div class="text-sm space-y-1">
                    @foreach (var colId in resizeColumnIds)
                    {
                        <p>
                            <span class="font-medium">@GetColumnTitle(colId):</span>
                            @(resizeGridState.Columns.GetWidth(colId) ?? L.T("自动", "auto"))
                        </p>
                    }
                </div>
            </div>
        </div>
        <CodeBlock Source="Primitives/DataGrid/column-resize.txt" />
    </section>

    @* Pinned Columns *@
    <section class="space-y-4">
        <div>
            <h2 class="text-2xl font-semibold">@L.T("固定列", "Pinned Columns")</h2>
            @if (L.IsChinese)
            {
                <text>
                    <p class="text-sm text-muted-foreground">
                        使用 CSS <code class="text-xs bg-muted px-1 py-0.5 rounded">position: sticky</code> 与计算出的像素偏移，
                        把列固定到左侧或右侧边缘。固定列在中间内容水平滚动时保持可见。
                    </p>
                </text>
            }
            else
            {
                <text>
                    <p class="text-sm text-muted-foreground">
                        Pin columns to the left or right edge using CSS <code class="text-xs bg-muted px-1 py-0.5 rounded">position: sticky</code>
                        with computed pixel offsets. Pinned columns remain visible while the middle content scrolls horizontally.
                    </p>
                </text>
            }
        </div>
        <div class="space-y-4">
            <div class="max-w-[700px] overflow-x-auto rounded-md border">
                <AtomBlazor.Primitives.DataGridPrimitive TData="Person" Items="@people"
                        AriaLabel="@(L.T("固定列表格", "Pinned columns grid"))" Class="w-full caption-bottom text-sm table-fixed" style="min-width: 1000px;">
                    <colgroup>
                        <col style="width: 120px" />
                        <col style="width: 200px" />
                        <col style="width: 200px" />
                        <col style="width: 100px" />
                        <col style="width: 180px" />
                        <col style="width: 120px" />
                    </colgroup>
                    <DataGridHeader Class="[&_tr]:border-b">
                        <tr class="border-b transition-colors hover:bg-muted/50">
                            @* Left-pinned: Name *@
                            <DataGridHeaderCell TData="Person" ColumnId="name"
                                                  Class="h-12 px-4 text-left align-middle font-medium bg-background border-r border-border"
                                                  style="position: sticky; left: 0; z-index: 2;">
                                @L.T("姓名", "Name")
                            </DataGridHeaderCell>
                            @* Scrollable middle columns *@
                            <DataGridHeaderCell TData="Person" ColumnId="email"
                                                  Class="h-12 px-4 text-left align-middle font-medium">
                                @L.T("邮箱", "Email")
                            </DataGridHeaderCell>
                            <DataGridHeaderCell TData="Person" ColumnId="department"
                                                  Class="h-12 px-4 text-left align-middle font-medium">
                                @L.T("部门", "Department")
                            </DataGridHeaderCell>
                            <DataGridHeaderCell TData="Person" ColumnId="age"
                                                  Class="h-12 px-4 text-left align-middle font-medium">
                                @L.T("年龄", "Age")
                            </DataGridHeaderCell>
                            <DataGridHeaderCell TData="Person" ColumnId="id"
                                                  Class="h-12 px-4 text-left align-middle font-medium">
                                ID
                            </DataGridHeaderCell>
                            @* Right-pinned: Actions *@
                            <DataGridHeaderCell TData="Person" ColumnId="actions"
                                                  Class="h-12 px-4 text-left align-middle font-medium bg-background border-l border-border"
                                                  style="position: sticky; right: 0; z-index: 2;">
                                @L.T("操作", "Actions")
                            </DataGridHeaderCell>
                        </tr>
                    </DataGridHeader>
                    <DataGridBody>
                        @foreach (var person in people)
                        {
                            <DataGridRow TData="Person">
                                @* Left-pinned cell *@
                                <DataGridCell Class="p-4 align-middle bg-background border-r border-border"
                                                style="position: sticky; left: 0; z-index: 1;">
                                    @person.Name
                                </DataGridCell>
                                @* Scrollable cells *@
                                <DataGridCell Class="p-4 align-middle overflow-hidden text-ellipsis whitespace-nowrap">
                                    @person.Email
                                </DataGridCell>
                                <DataGridCell Class="p-4 align-middle">
                                    @person.Department
                                </DataGridCell>
                                <DataGridCell Class="p-4 align-middle">
                                    @person.Age
                                </DataGridCell>
                                <DataGridCell Class="p-4 align-middle">
                                    @person.Id
                                </DataGridCell>
                                @* Right-pinned cell *@
                                <DataGridCell Class="p-4 align-middle bg-background border-l border-border"
                                                style="position: sticky; right: 0; z-index: 1;">
                                    <button class="text-sm text-primary hover:underline">@L.T("编辑", "Edit")</button>
                                </DataGridCell>
                            </DataGridRow>
                        }
                    </DataGridBody>
                </AtomBlazor.Primitives.DataGridPrimitive>
            </div>
        </div>
        <CodeBlock Source="Primitives/DataGrid/pinned-columns.txt" />
    </section>

    @* All Features Combined *@
    <section class="space-y-4">
        <div>
            <h2 class="text-2xl font-semibold">@L.T("全部特性组合", "All Features Combined")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("多列排序、分页、行选择、列可见性、列重排与列缩放全部协同工作。它演示完整的 DataGrid 基础件 API。", "Multi-column sorting, pagination, row selection, column visibility, column reorder, and column resize all working together. This demonstrates the full DataGrid primitive API.")
            </p>
        </div>

        <div class="space-y-4">
            @* Column visibility toggles *@
            <div class="flex items-center gap-2 flex-wrap">
                <span class="text-sm font-medium text-muted-foreground">@L.T("列：", "Columns:")</span>
                @foreach (var colId in combinedColumnIds)
                {
                    var isVisible = combinedGridState.Columns.IsVisible(colId);
                    <button @onclick="@(() => ToggleCombinedColumnVisibility(colId))"
                            class="@($"inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors h-7 px-2 border {(isVisible ? "bg-primary text-primary-foreground border-primary" : "bg-background text-foreground border-input hover:bg-accent")}")">
                        @GetColumnTitle(colId)
                    </button>
                }
            </div>

            @* Reorder controls *@
            <div class="flex items-center gap-2 flex-wrap">
                <span class="text-sm font-medium text-muted-foreground">@L.T("顺序：", "Order:")</span>
                @foreach (var colId in GetCombinedVisibleColumns())
                {
                    var entry = combinedGridState.Columns.Entries.FirstOrDefault(e => e.ColumnId == colId);
                    var order = entry?.Order ?? 0;
                    <div class="inline-flex items-center gap-1 rounded-md border px-2 py-1 text-sm">
                        <button @onclick="@(() => MoveCombinedColumnLeft(colId))" disabled="@(order == 0)"
                                class="h-5 w-5 inline-flex items-center justify-center rounded hover:bg-accent disabled:opacity-30"
                                aria-label="@(L.IsChinese ? $"将 {colId} 左移" : $"Move {colId} left")">
                            <LucideIcon Name="chevron-left" Size="14" />
                        </button>
                        <span class="font-medium px-1">@GetColumnTitle(colId)</span>
                        <button @onclick="@(() => MoveCombinedColumnRight(colId))" disabled="@(order >= combinedColumnIds.Length - 1)"
                                class="h-5 w-5 inline-flex items-center justify-center rounded hover:bg-accent disabled:opacity-30"
                                aria-label="@(L.IsChinese ? $"将 {colId} 右移" : $"Move {colId} right")">
                            <LucideIcon Name="chevron-right" Size="14" />
                        </button>
                    </div>
                }
            </div>

            @* Width controls *@
            <div class="flex items-center gap-2 flex-wrap">
                <span class="text-sm font-medium text-muted-foreground">@L.T("列宽：", "Widths:")</span>
                @foreach (var colId in GetCombinedVisibleColumns())
                {
                    var currentWidth = combinedGridState.Columns.GetWidth(colId);
                    <div class="inline-flex items-center gap-1 rounded-md border px-2 py-1 text-xs">
                        <span class="font-medium">@GetColumnTitle(colId)</span>
                        <button @onclick="@(() => SetCombinedColumnWidth(colId, "120px"))"
                                class="@($"h-5 px-1 rounded {(currentWidth == "120px" ? "bg-primary text-primary-foreground" : "hover:bg-accent")}")">
                            120
                        </button>
                        <button @onclick="@(() => SetCombinedColumnWidth(colId, null))"
                                class="@($"h-5 px-1 rounded {(currentWidth == null ? "bg-primary text-primary-foreground" : "hover:bg-accent")}")">
                            @L.T("自动", "Auto")
                        </button>
                    </div>
                }
            </div>

            @* Grid with all features *@
            <div class="rounded-md border">
                <AtomBlazor.Primitives.DataGridPrimitive TData="Person" Items="@GetCombinedPageData()"
                            @bind-State="@combinedGridState" ManualPagination="true"
                            SelectionMode="SelectionMode.Multiple"
                            OnSortChange="@HandleCombinedSortChanged"
                            OnSelectionChange="@HandleCombinedSelectionChange"
                            OnColumnVisibilityChange="@HandleCombinedVisibilityChange"
                            OnColumnReorder="@HandleCombinedReorder"
                            OnColumnResize="@HandleCombinedResize"
                            AriaLabel="@(L.T("组合特性表格", "Combined features grid"))" Class="w-full caption-bottom text-sm"
                            style="table-layout: fixed;">
                    <DataGridHeader Class="[&_tr]:border-b">
                        <tr class="border-b transition-colors hover:bg-muted/50">
                            <DataGridHeaderCell TData="Person" Class="h-12 w-12 px-4 text-center align-middle" style="width: 48px">
                                <input type="checkbox" checked="@CombinedIsAllOnPageSelected()"
                                       @onchange="@HandleCombinedSelectAllChanged"
                                       @onclick:stopPropagation="true"
                                       class="rounded border-input"
                                       aria-label="@(L.T("全选本页所有行", "Select all rows on page"))" />
                            </DataGridHeaderCell>
                            @foreach (var colId in GetCombinedVisibleColumns())
                            {
                                var sortDirection = combinedGridState.Sorting.GetDirection(colId);
                                var width = combinedGridState.Columns.GetWidth(colId);
                                <DataGridHeaderCell TData="Person" ColumnId="@colId" Sortable="true" Reorderable="true"
                                                      Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground cursor-pointer select-none overflow-hidden"
                                                      style="@(width != null ? $"width: {width}" : null)">
                                    <div class="flex items-center gap-2">
                                        <span>@GetColumnTitle(colId)</span>
                                        @if (sortDirection != SortDirection.None)
                                        {
                                            @if (sortDirection == SortDirection.Ascending)
                                            {
                                                <LucideIcon Name="arrow-up" Size="16" />
                                            }
                                            else
                                            {
                                                <LucideIcon Name="arrow-down" Size="16" />
                                            }
                                        }
                                    </div>
                                </DataGridHeaderCell>
                            }
                        </tr>
                    </DataGridHeader>
                    <DataGridBody Class="[&_tr:last-child]:border-0">
                        @foreach (var person in GetCombinedPageData())
                        {
                            var isSelected = combinedGridState.Selection.IsSelected(person);
                            <DataGridRow TData="Person" Item="@person" Class="@($"border-b transition-colors hover:bg-muted/50 {(isSelected ? "bg-muted" : "")}")">
                                <DataGridCell Class="p-4 w-12 text-center align-middle" style="width: 48px">
                                    <input type="checkbox" checked="@isSelected"
                                           @onchange="@(() => ToggleCombinedRowSelection(person))"
                                           @onclick:stopPropagation="true"
                                           class="rounded border-input" />
                                </DataGridCell>
                                @foreach (var colId in GetCombinedVisibleColumns())
                                {
                                    <DataGridCell Class="p-4 align-middle overflow-hidden text-ellipsis whitespace-nowrap">
                                        @GetCellValue(person, colId)
                                    </DataGridCell>
                                }
                            </DataGridRow>
                        }
                    </DataGridBody>
                </AtomBlazor.Primitives.DataGridPrimitive>
            </div>

            @* Pagination controls *@
            <div class="flex items-center justify-between">
                <div class="text-sm text-muted-foreground">
                    @L.F("已选择 {0} 项，共 {1} 项。", "{0} of {1} row(s) selected", combinedGridState.Selection.SelectedCount, combinedGridState.Pagination.TotalItems)
                </div>
                <div class="flex items-center gap-4">
                    <div class="flex items-center gap-2">
                        <span class="text-sm">@L.T("每页行数：", "Rows per page:")</span>
                        <select value="@combinedGridState.Pagination.PageSize"
                                @onchange="@HandleCombinedPageSizeChange"
                                class="h-8 rounded-md border bg-background px-2 text-sm">
                            <option value="5">5</option>
                            <option value="10">10</option>
                            <option value="20">20</option>
                        </select>
                    </div>
                    <span class="text-sm">
                        @L.F("第 {0} 页，共 {1} 页", "Page {0} of {1}", combinedGridState.Pagination.CurrentPage, combinedGridState.Pagination.TotalPages)
                    </span>
                    <div class="flex items-center gap-1">
                        <button disabled="@(!combinedGridState.Pagination.CanGoPrevious)"
                                @onclick="@(() => combinedGridState.Pagination.FirstPage())"
                                class="h-8 w-8 inline-flex items-center justify-center rounded-md border hover:bg-accent disabled:opacity-50"
                                aria-label="@(L.T("第一页", "First page"))">
                            <LucideIcon Name="chevrons-left" Size="16" />
                        </button>
                        <button disabled="@(!combinedGridState.Pagination.CanGoPrevious)"
                                @onclick="@(() => combinedGridState.Pagination.PreviousPage())"
                                class="h-8 w-8 inline-flex items-center justify-center rounded-md border hover:bg-accent disabled:opacity-50"
                                aria-label="@(L.T("上一页", "Previous page"))">
                            <LucideIcon Name="chevron-left" Size="16" />
                        </button>
                        <button disabled="@(!combinedGridState.Pagination.CanGoNext)"
                                @onclick="@(() => combinedGridState.Pagination.NextPage())"
                                class="h-8 w-8 inline-flex items-center justify-center rounded-md border hover:bg-accent disabled:opacity-50"
                                aria-label="@(L.T("下一页", "Next page"))">
                            <LucideIcon Name="chevron-right" Size="16" />
                        </button>
                        <button disabled="@(!combinedGridState.Pagination.CanGoNext)"
                                @onclick="@(() => combinedGridState.Pagination.LastPage())"
                                class="h-8 w-8 inline-flex items-center justify-center rounded-md border hover:bg-accent disabled:opacity-50"
                                aria-label="@(L.T("最后一页", "Last page"))">
                            <LucideIcon Name="chevrons-right" Size="16" />
                        </button>
