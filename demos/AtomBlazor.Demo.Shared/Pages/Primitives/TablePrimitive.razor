                <div class="text-sm space-y-1">
                    <p><span class="font-medium">@L.T("生效筛选：", "Active Filters:")</span> @(new[] { nameFilter, emailFilter, departmentFilter }.Count(f => !string.IsNullOrWhiteSpace(f)))</p>
                    <p><span class="font-medium">@L.T("结果：", "Results:")</span> @GetFilteredPeople().Count() / @people.Count</p>
                    @if (new[] { nameFilter, emailFilter, departmentFilter }.Any(f => !string.IsNullOrWhiteSpace(f)))
