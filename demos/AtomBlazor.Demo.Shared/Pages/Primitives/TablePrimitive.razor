        </div>

        <div class="space-y-4">
            <div class="rounded-md border">
                <AtomBlazor.Primitives.TablePrimitive TData="Person" Data="@GetFilteredPeople()" @bind-State="@filteredTableState"
                       OnPageChange="@HandleFilteredPaginationChange"
                       OnPageSizeChange="@HandleFilteredPaginationChange"
