@page "/primitives/table"
@using AtomBlazor.Primitives.Services
@using AtomBlazor.Icons.Lucide

<PageTitle>@L.T("Table 原语 - Atom BlazorUI", "Table Primitive - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-7xl">
    <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">@L.T("Table 原语", "Table Primitive")</h1>
        <p class="text-xl text-muted-foreground">
            @L.T("无头、无样式的表格原语，具备排序、分页与选择能力。", "Headless, unstyled table primitive with sorting, pagination, and selection capabilities.")
        </p>
    </div>

    <div class="space-y-6">

    @* Basic Table Example *@
    <section class="space-y-4">
        <div>
            <h2 class="text-2xl font-semibold">@L.T("基础表格", "Basic Table")</h2>
            <p class="text-sm text-muted-foreground">@L.T("不含排序、分页或选择的简单表格", "Simple table with no sorting, pagination, or selection")</p>
        </div>

        <div class="rounded-md border">
            <AtomBlazor.Primitives.TablePrimitive TData="Person" Data="@people" Class="w-full caption-bottom text-sm">
                <AtomBlazor.Primitives.TableHeader Class="[&_tr]:border-b">
                    <AtomBlazor.Primitives.TableRow TData="Person" Class="border-b transition-colors hover:bg-muted/50">
                        <AtomBlazor.Primitives.TableHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("名称", "Name")</AtomBlazor.Primitives.TableHeaderCell>
                        <AtomBlazor.Primitives.TableHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("邮箱", "Email")</AtomBlazor.Primitives.TableHeaderCell>
                        <AtomBlazor.Primitives.TableHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("年龄", "Age")</AtomBlazor.Primitives.TableHeaderCell>
                        <AtomBlazor.Primitives.TableHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("部门", "Department")</AtomBlazor.Primitives.TableHeaderCell>
                    </AtomBlazor.Primitives.TableRow>
                </AtomBlazor.Primitives.TableHeader>
                <AtomBlazor.Primitives.TableBody Class="[&_tr:last-child]:border-0">
                    @foreach (var person in people)
                    {
                        <AtomBlazor.Primitives.TableRow TData="Person" Class="border-b transition-colors hover:bg-muted/50">
                            <AtomBlazor.Primitives.TableCell Class="p-4 align-middle">@person.Name</AtomBlazor.Primitives.TableCell>
                            <AtomBlazor.Primitives.TableCell Class="p-4 align-middle">@person.Email</AtomBlazor.Primitives.TableCell>
                            <AtomBlazor.Primitives.TableCell Class="p-4 align-middle">@person.Age</AtomBlazor.Primitives.TableCell>
                            <AtomBlazor.Primitives.TableCell Class="p-4 align-middle">@person.Department</AtomBlazor.Primitives.TableCell>
                        </AtomBlazor.Primitives.TableRow>
                    }
                </AtomBlazor.Primitives.TableBody>
            </AtomBlazor.Primitives.TablePrimitive>
        </div>
    </section>

    @* Row Actions Example *@
    <section class="space-y-4">
        <div>
            <h2 class="text-2xl font-semibold">@L.T("行操作", "Row Actions")</h2>
            <p class="text-sm text-muted-foreground">@L.T("为每一行提供操作下拉菜单的表格", "Table with an actions dropdown menu for each row")</p>
        </div>

        <div class="rounded-md border">
            <AtomBlazor.Primitives.TablePrimitive TData="Person" Data="@people" Class="w-full caption-bottom text-sm">
                <AtomBlazor.Primitives.TableHeader Class="[&_tr]:border-b">
                    <AtomBlazor.Primitives.TableRow TData="Person" Class="border-b transition-colors hover:bg-muted/50">
                        <AtomBlazor.Primitives.TableHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("名称", "Name")</AtomBlazor.Primitives.TableHeaderCell>
                        <AtomBlazor.Primitives.TableHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("邮箱", "Email")</AtomBlazor.Primitives.TableHeaderCell>
                        <AtomBlazor.Primitives.TableHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("部门", "Department")</AtomBlazor.Primitives.TableHeaderCell>
                        <AtomBlazor.Primitives.TableHeaderCell TData="Person" Class="h-12 px-4 text-right align-middle font-medium text-muted-foreground w-[70px]">@L.T("操作", "Actions")</AtomBlazor.Primitives.TableHeaderCell>
                    </AtomBlazor.Primitives.TableRow>
                </AtomBlazor.Primitives.TableHeader>
                <AtomBlazor.Primitives.TableBody Class="[&_tr:last-child]:border-0">
                    @foreach (var person in people)
                    {
                        <AtomBlazor.Primitives.TableRow TData="Person" Class="border-b transition-colors hover:bg-muted/50">
                            <AtomBlazor.Primitives.TableCell Class="p-4 align-middle font-medium">@person.Name</AtomBlazor.Primitives.TableCell>
                            <AtomBlazor.Primitives.TableCell Class="p-4 align-middle">@person.Email</AtomBlazor.Primitives.TableCell>
                            <AtomBlazor.Primitives.TableCell Class="p-4 align-middle">@person.Department</AtomBlazor.Primitives.TableCell>
                            <AtomBlazor.Primitives.TableCell Class="p-4 align-middle text-right">
                                <AtomBlazor.Primitives.DropdownMenuPrimitive>
                                    <AtomBlazor.Primitives.DropdownMenuTrigger>
                                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="h-8 w-8" AriaLabel="@(L.T("打开菜单", "Open menu"))">
                                            <LucideIcon Name="ellipsis" Size="16" />
                                        </Button>
                                    </AtomBlazor.Primitives.DropdownMenuTrigger>
                                    <AtomBlazor.Primitives.DropdownMenuContent Class="w-48 rounded-md border bg-popover p-1 text-popover-foreground shadow-md" Align="PopoverAlign.End">
                                        <DropdownMenuLabel Class="px-2 py-1.5 text-sm font-semibold">@L.T("操作", "Actions")</DropdownMenuLabel>
                                        <DropdownMenuSeparator Class="my-1 h-px bg-muted" />
                                        <AtomBlazor.Primitives.DropdownMenuItem Class="relative flex cursor-pointer select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none transition-colors hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground"
                                                          OnClick="@(() => HandleViewDetails(person))">
                                            <LucideIcon Name="eye" Size="16" Class="mr-2" />
                                            @L.T("查看详情", "View details")
                                        </AtomBlazor.Primitives.DropdownMenuItem>
                                        <AtomBlazor.Primitives.DropdownMenuItem Class="relative flex cursor-pointer select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none transition-colors hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground"
                                                          OnClick="@(() => HandleEdit(person))">
                                            <LucideIcon Name="pencil" Size="16" Class="mr-2" />
                                            @L.T("编辑", "Edit")
                                        </AtomBlazor.Primitives.DropdownMenuItem>
                                        <AtomBlazor.Primitives.DropdownMenuItem Class="relative flex cursor-pointer select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none transition-colors hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground"
                                                          OnClick="@(() => HandleDuplicate(person))">
                                            <LucideIcon Name="copy" Size="16" Class="mr-2" />
                                            @L.T("复制", "Duplicate")
                                        </AtomBlazor.Primitives.DropdownMenuItem>
                                        <DropdownMenuSeparator Class="my-1 h-px bg-muted" />
                                        <AtomBlazor.Primitives.DropdownMenuItem Class="relative flex cursor-pointer select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none transition-colors hover:bg-destructive hover:text-destructive-foreground focus:bg-destructive focus:text-destructive-foreground text-destructive"
                                                          OnClick="@(() => HandleDelete(person))">
                                            <LucideIcon Name="trash-2" Size="16" Class="mr-2" />
                                            @L.T("删除", "Delete")
                                        </AtomBlazor.Primitives.DropdownMenuItem>
                                    </AtomBlazor.Primitives.DropdownMenuContent>
                                </AtomBlazor.Primitives.DropdownMenuPrimitive>
                            </AtomBlazor.Primitives.TableCell>
                        </AtomBlazor.Primitives.TableRow>
                    }
                </AtomBlazor.Primitives.TableBody>
            </AtomBlazor.Primitives.TablePrimitive>
        </div>

        @if (!string.IsNullOrEmpty(actionMessage))
        {
            <div class="rounded-lg border bg-card p-4">
                <p class="text-sm">@actionMessage</p>
            </div>
        }
    </section>

    @* Sortable Table Example *@
    <section class="space-y-4">
        <div>
            <h2 class="text-2xl font-semibold">@L.T("可排序表格", "Sortable Table")</h2>
            <p class="text-sm text-muted-foreground">@L.T("点击列标题进行排序。三态循环：None → Ascending → Descending → None", "Click column headers to sort. Three-state cycle: None → Ascending → Descending → None")</p>
        </div>

        <div class="rounded-md border">
            <AtomBlazor.Primitives.TablePrimitive TData="Person" Data="@GetSortedPeople()" @bind-State="@sortableTableState" Class="w-full caption-bottom text-sm">
                <AtomBlazor.Primitives.TableHeader Class="[&_tr]:border-b">
                    <AtomBlazor.Primitives.TableRow TData="Person" Class="border-b transition-colors hover:bg-muted/50">
                        <AtomBlazor.Primitives.TableHeaderCell TData="Person" ColumnId="name" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground cursor-pointer select-none hover:bg-accent">
                            <div class="flex items-center gap-2">
                                <span>@L.T("名称", "Name")</span>
                                @if (sortableTableState.Sorting.SortedColumn == "name")
                                {
                                    @if (sortableTableState.Sorting.Direction == SortDirection.Ascending)
                                    {
                                        <span class="text-xs">↑</span>
                                    }
                                    else if (sortableTableState.Sorting.Direction == SortDirection.Descending)
                                    {
                                        <span class="text-xs">↓</span>
                                    }
                                }
                            </div>
                        </AtomBlazor.Primitives.TableHeaderCell>
                        <AtomBlazor.Primitives.TableHeaderCell TData="Person" ColumnId="email" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground cursor-pointer select-none hover:bg-accent">
                            <div class="flex items-center gap-2">
                                <span>@L.T("邮箱", "Email")</span>
                                @if (sortableTableState.Sorting.SortedColumn == "email")
                                {
                                    @if (sortableTableState.Sorting.Direction == SortDirection.Ascending)
                                    {
                                        <span class="text-xs">↑</span>
                                    }
                                    else if (sortableTableState.Sorting.Direction == SortDirection.Descending)
                                    {
                                        <span class="text-xs">↓</span>
                                    }
                                }
                            </div>
                        </AtomBlazor.Primitives.TableHeaderCell>
                        <AtomBlazor.Primitives.TableHeaderCell TData="Person" ColumnId="age" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground cursor-pointer select-none hover:bg-accent">
                            <div class="flex items-center gap-2">
                                <span>@L.T("年龄", "Age")</span>
                                @if (sortableTableState.Sorting.SortedColumn == "age")
                                {
                                    @if (sortableTableState.Sorting.Direction == SortDirection.Ascending)
                                    {
                                        <span class="text-xs">↑</span>
                                    }
                                    else if (sortableTableState.Sorting.Direction == SortDirection.Descending)
                                    {
                                        <span class="text-xs">↓</span>
                                    }
                                }
                            </div>
                        </AtomBlazor.Primitives.TableHeaderCell>
                        <AtomBlazor.Primitives.TableHeaderCell TData="Person" ColumnId="department" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground cursor-pointer select-none hover:bg-accent">
                            <div class="flex items-center gap-2">
                                <span>@L.T("部门", "Department")</span>
                                @if (sortableTableState.Sorting.SortedColumn == "department")
                                {
                                    @if (sortableTableState.Sorting.Direction == SortDirection.Ascending)
                                    {
                                        <span class="text-xs">↑</span>
                                    }
                                    else if (sortableTableState.Sorting.Direction == SortDirection.Descending)
                                    {
                                        <span class="text-xs">↓</span>
                                    }
                                }
                            </div>
                        </AtomBlazor.Primitives.TableHeaderCell>
                    </AtomBlazor.Primitives.TableRow>
                </AtomBlazor.Primitives.TableHeader>
                <AtomBlazor.Primitives.TableBody Class="[&_tr:last-child]:border-0">
                    @foreach (var person in GetSortedPeople())
                    {
                        <AtomBlazor.Primitives.TableRow TData="Person" Class="border-b transition-colors hover:bg-muted/50">
                            <AtomBlazor.Primitives.TableCell Class="p-4 align-middle">@person.Name</AtomBlazor.Primitives.TableCell>
                            <AtomBlazor.Primitives.TableCell Class="p-4 align-middle">@person.Email</AtomBlazor.Primitives.TableCell>
                            <AtomBlazor.Primitives.TableCell Class="p-4 align-middle">@person.Age</AtomBlazor.Primitives.TableCell>
                            <AtomBlazor.Primitives.TableCell Class="p-4 align-middle">@person.Department</AtomBlazor.Primitives.TableCell>
                        </AtomBlazor.Primitives.TableRow>
                    }
                </AtomBlazor.Primitives.TableBody>
            </AtomBlazor.Primitives.TablePrimitive>
        </div>

        <div class="rounded-lg border bg-card p-4">
            <h3 class="font-semibold mb-2">@L.T("当前排序状态", "Current Sort State")</h3>
            <div class="text-sm space-y-1">
                <p><span class="font-medium">@L.T("列：", "Column:")</span> @(sortableTableState.Sorting.SortedColumn ?? L.T("无", "None"))</p>
                <p><span class="font-medium">@L.T("方向：", "Direction:")</span> @sortableTableState.Sorting.Direction</p>
            </div>
        </div>
    </section>

    @* Paginated Table Example *@
    <section class="space-y-4">
        <div>
            <h2 class="text-2xl font-semibold">@L.T("分页表格", "Paginated Table")</h2>
            <p class="text-sm text-muted-foreground">@L.T("带分页控件且可配置每页条数的表格", "Table with pagination controls and configurable page size")</p>
        </div>

        <div class="space-y-4">
            <div class="rounded-md border">
                <AtomBlazor.Primitives.TablePrimitive TData="Person" Data="@largePeopleDataset" @bind-State="@paginatedTableState"
                       OnPageChange="@HandlePaginationChange"
                       OnPageSizeChange="@HandlePaginationChange"
                       Class="w-full caption-bottom text-sm">
                    <AtomBlazor.Primitives.TableHeader Class="[&_tr]:border-b">
                        <AtomBlazor.Primitives.TableRow TData="Person" Class="border-b transition-colors hover:bg-muted/50">
                            <AtomBlazor.Primitives.TableHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("名称", "Name")</AtomBlazor.Primitives.TableHeaderCell>
                            <AtomBlazor.Primitives.TableHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("邮箱", "Email")</AtomBlazor.Primitives.TableHeaderCell>
                            <AtomBlazor.Primitives.TableHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("年龄", "Age")</AtomBlazor.Primitives.TableHeaderCell>
                            <AtomBlazor.Primitives.TableHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("部门", "Department")</AtomBlazor.Primitives.TableHeaderCell>
                        </AtomBlazor.Primitives.TableRow>
                    </AtomBlazor.Primitives.TableHeader>
                    <AtomBlazor.Primitives.TableBody Class="[&_tr:last-child]:border-0">
                        @foreach (var person in GetPaginatedData())
                        {
                            <AtomBlazor.Primitives.TableRow TData="Person" Class="border-b transition-colors hover:bg-muted/50">
                                <AtomBlazor.Primitives.TableCell Class="p-4 align-middle">@person.Name</AtomBlazor.Primitives.TableCell>
                                <AtomBlazor.Primitives.TableCell Class="p-4 align-middle">@person.Email</AtomBlazor.Primitives.TableCell>
                                <AtomBlazor.Primitives.TableCell Class="p-4 align-middle">@person.Age</AtomBlazor.Primitives.TableCell>
                                <AtomBlazor.Primitives.TableCell Class="p-4 align-middle">@person.Department</AtomBlazor.Primitives.TableCell>
                            </AtomBlazor.Primitives.TableRow>
                        }
                    </AtomBlazor.Primitives.TableBody>
                </AtomBlazor.Primitives.TablePrimitive>
            </div>

            <AtomBlazor.Primitives.TablePagination TData="Person" State="@paginatedTableState.Pagination"
                             OnPageChange="@HandlePaginationChange"
                             OnPageSizeChange="@HandlePaginationChange">
                <PaginationTemplate Context="context">
                    <div class="flex items-center justify-between px-2">
                        <div class="flex-1 text-sm text-muted-foreground">
                            @context.GetPageInfoText()
                        </div>
                        <div class="flex items-center space-x-6 lg:space-x-8">
                            <div class="flex items-center space-x-2">
                                <p class="text-sm font-medium">@L.T("每页条数", "Rows per page")</p>
                                <select @onchange="@((e) => context.ChangePageSize(int.Parse(e.Value?.ToString() ?? "10")))"
                                        class="h-8 w-[70px] rounded-md border border-input bg-background px-2 py-1 text-sm">
                                    @foreach (var size in context.PageSizeOptions)
                                    {
                                        <option value="@size" selected="@(context.State.PageSize == size)">@size</option>
                                    }
                                </select>
                            </div>
                            <div class="flex w-[100px] items-center justify-center text-sm font-medium">
                                @L.F("第 {0} 页，共 {1} 页", "Page {0} of {1}", context.State.CurrentPage, context.State.TotalPages)
                            </div>
                            <div class="flex items-center space-x-2">
                                <Button Variant="ButtonVariant.Outline"
                                        Size="ButtonSize.Icon"
                                        OnClick="@context.GoToFirstPage"
                                        Disabled="@(!context.State.CanGoPrevious)"
                                        AriaLabel="@(L.T("跳转到第一页", "Go to first page"))">
                                    <LucideIcon Name="chevrons-left" Size="16" />
                                </Button>
                                <Button Variant="ButtonVariant.Outline"
                                        Size="ButtonSize.Icon"
                                        OnClick="@context.GoToPreviousPage"
                                        Disabled="@(!context.State.CanGoPrevious)"
                                        AriaLabel="@(L.T("跳转到上一页", "Go to previous page"))">
                                    <LucideIcon Name="chevron-left" Size="16" />
                                </Button>
                                <Button Variant="ButtonVariant.Outline"
                                        Size="ButtonSize.Icon"
                                        OnClick="@context.GoToNextPage"
                                        Disabled="@(!context.State.CanGoNext)"
                                        AriaLabel="@(L.T("跳转到下一页", "Go to next page"))">
                                    <LucideIcon Name="chevron-right" Size="16" />
                                </Button>
                                <Button Variant="ButtonVariant.Outline"
                                        Size="ButtonSize.Icon"
                                        OnClick="@context.GoToLastPage"
                                        Disabled="@(!context.State.CanGoNext)"
                                        AriaLabel="@(L.T("跳转到最后一页", "Go to last page"))">
                                    <LucideIcon Name="chevrons-right" Size="16" />
                                </Button>
                            </div>
                        </div>
                    </div>
                </PaginationTemplate>
            </AtomBlazor.Primitives.TablePagination>
        </div>
    </section>

    @* Selectable Table Example *@
    <section class="space-y-4">
        <div>
            <h2 class="text-2xl font-semibold">@L.T("可选择表格（多选）", "Selectable Table (Multi-Select)")</h2>
            <p class="text-sm text-muted-foreground">@L.T("点击行或复选框进行选择。点击表头复选框可全选/取消全选。使用方向键导航，按 Enter/空格进行选择。", "Click rows or checkboxes to select. Click header checkbox to select/deselect all. Use arrow keys to navigate and Enter/Space to select.")</p>
        </div>

        <div class="flex items-center gap-2 mb-2">
            <input type="checkbox"
                   id="enableKeyboardNav"
                   checked="@enableKeyboardNavigation"
                   @onchange="@((e) => enableKeyboardNavigation = (bool)(e.Value ?? true))"
                   class="h-4 w-4 rounded border-gray-300 text-primary focus:ring-2 focus:ring-primary" />
            <label for="enableKeyboardNav" class="text-sm font-medium">@L.T("启用键盘导航", "Enable keyboard navigation")</label>
        </div>

        <div class="space-y-4">
            <div class="rounded-md border">
                <AtomBlazor.Primitives.TablePrimitive TData="Person" Data="@people" @bind-State="@selectableTableState"
                       SelectionMode="SelectionMode.Multiple"
                       EnableKeyboardNavigation="@enableKeyboardNavigation"
                       OnSelectionChange="@HandleSelectionChange"
                       Class="w-full caption-bottom text-sm">
                    <AtomBlazor.Primitives.TableHeader Class="[&_tr]:border-b">
                        <AtomBlazor.Primitives.TableRow TData="Person" Class="border-b transition-colors hover:bg-muted/50">
                            <AtomBlazor.Primitives.TableHeaderCell TData="Person" Class="h-12 w-12 px-4">
                                <input type="checkbox"
                                       checked="@selectAllChecked"
                                       @onchange="@((e) => { selectAllChecked = (bool)(e.Value ?? false); HandleSelectAllChanged(); })"
                                       class="h-4 w-4 rounded border-gray-300 text-primary focus:ring-2 focus:ring-primary"
                                       aria-label="@(L.T("全选", "Select all"))" />
                            </AtomBlazor.Primitives.TableHeaderCell>
                            <AtomBlazor.Primitives.TableHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("名称", "Name")</AtomBlazor.Primitives.TableHeaderCell>
                            <AtomBlazor.Primitives.TableHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("邮箱", "Email")</AtomBlazor.Primitives.TableHeaderCell>
                            <AtomBlazor.Primitives.TableHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("年龄", "Age")</AtomBlazor.Primitives.TableHeaderCell>
                            <AtomBlazor.Primitives.TableHeaderCell TData="Person" Class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">@L.T("部门", "Department")</AtomBlazor.Primitives.TableHeaderCell>
                            <AtomBlazor.Primitives.TableHeaderCell TData="Person" Class="h-12 px-4 text-right align-middle font-medium text-muted-foreground w-[70px]">@L.T("操作", "Actions")</AtomBlazor.Primitives.TableHeaderCell>
                        </AtomBlazor.Primitives.TableRow>
                    </AtomBlazor.Primitives.TableHeader>
                    <AtomBlazor.Primitives.TableBody Class="[&_tr:last-child]:border-0">
                        @foreach (var person in people)
                        {
                            var isSelected = selectableTableState.Selection.IsSelected(person);
                            <AtomBlazor.Primitives.TableRow TData="Person" Item="@person" Class="@($"border-b transition-colors hover:bg-muted/50 {(isSelected ? "bg-muted" : "")}")">
                                <AtomBlazor.Primitives.TableCell Class="w-12 px-4">
                                    <input type="checkbox"
                                           checked="@isSelected"
                                           @onchange="@(() => ToggleRowSelection(person))"
                                           @onclick:stopPropagation="true"
                                           @onkeydown:stopPropagation="true"
                                           tabindex="-1"
                                           class="h-4 w-4 rounded border-gray-300 text-primary focus:ring-2 focus:ring-primary"
