    private string? toolbarDemoValue;
    private RichTextEditor? tableEditor;
    private string? imageValue;
    private int imageUploads;

    private async Task<string?> UploadImageAsync(EditorImageUpload image)
    {
        if (image.Size > 1024 * 1024)
        {
            return null;
        }

        using var buffer = new MemoryStream();
        await image.Content.CopyToAsync(buffer);
        imageUploads++;

        // A real handler writes the bytes to blob storage or disk and returns that URL.
        return $"data:{image.ContentType};base64,{Convert.ToBase64String(buffer.ToArray())}";
    }
    private string? tableValue = @"<p>Quarterly numbers:</p>
