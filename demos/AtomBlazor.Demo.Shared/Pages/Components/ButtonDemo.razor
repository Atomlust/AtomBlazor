@page "/components/button"

<PageTitle>@L.T("Button 按钮 - Atom BlazorUI", "Button Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">@L.T("Button 按钮组件", "Button Component")</h1>
        <p class="text-xl text-muted-foreground">
            @L.T("显示一个按钮，或一个看起来像按钮的元素。", "Displays a button or a component that looks like a button.")
        </p>
        </div>
    </div>

    <div class="space-y-6">
    </div>

    <!-- All Variants -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("样式变体", "Variants")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("六种按钮变体，与 shadcn/ui 设计体系一致。", "All six button variants matching shadcn/ui design system.")
            </p>
        </div>
        <div class="flex flex-wrap gap-4">
            <Button Variant="ButtonVariant.Default">Default</Button>
            <Button Variant="ButtonVariant.Destructive">Destructive</Button>
            <Button Variant="ButtonVariant.Outline">Outline</Button>
            <Button Variant="ButtonVariant.Secondary">Secondary</Button>
            <Button Variant="ButtonVariant.Ghost">Ghost</Button>
            <Button Variant="ButtonVariant.Link">Link</Button>
        </div>
        <CodeBlock Source="Components/Button/variants.txt" />
    </div>

    <!-- As Link -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("作为链接", "As Link")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    提供了 <code>Href</code> 时，按钮会渲染成 <code>&lt;a&gt;</code> 元素用于导航，外观样式保持不变。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    When <code>Href</code> is provided, the button renders as an <code>&lt;a&gt;</code> element for navigation while preserving all visual styling.
                </p>
                        </text>
}
        </div>
        <div class="space-y-4">
            <div class="space-y-2">
                <h3 class="text-lg font-medium">@L.T("导航链接", "Navigation Links")</h3>
                <div class="flex flex-wrap gap-4">
                    <Button Href="/components/badge">@L.T("前往 Badge", "Go to Badge")</Button>
                    <Button Href="https://github.com" Target="_blank" Variant="ButtonVariant.Outline" IconPosition="IconPosition.End">
                        <Icon>
                            <LucideIcon Name="external-link" Size="16" />
                        </Icon>
                        <ChildContent>GitHub</ChildContent>
                    </Button>
                </div>
            </div>
            <div class="space-y-2">
                <h3 class="text-lg font-medium">@L.T("各变体的链接形态", "Variants as Links")</h3>
                <div class="flex flex-wrap gap-4">
                    <Button Href="/components/badge" Variant="ButtonVariant.Default">Default</Button>
                    <Button Href="/components/badge" Variant="ButtonVariant.Destructive">Destructive</Button>
                    <Button Href="/components/badge" Variant="ButtonVariant.Outline">Outline</Button>
                    <Button Href="/components/badge" Variant="ButtonVariant.Secondary">Secondary</Button>
                    <Button Href="/components/badge" Variant="ButtonVariant.Ghost">Ghost</Button>
                    <Button Href="/components/badge" Variant="ButtonVariant.Link">Link</Button>
                </div>
            </div>
            <div class="space-y-2">
                <h3 class="text-lg font-medium">@L.T("禁用的链接", "Disabled Links")</h3>
                <div class="flex flex-wrap gap-4">
                    <Button Href="/components/badge" Disabled="true">@L.T("禁用的链接", "Disabled Link")</Button>
                    <Button Href="/components/badge" Disabled="true" Variant="ButtonVariant.Outline">@L.T("禁用的描边链接", "Disabled Outline Link")</Button>
                </div>
            </div>
        </div>
        <CodeBlock Source="Components/Button/as-link.txt" />
    </div>

    <!-- All Sizes -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("尺寸", "Sizes")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("六种尺寸，含纯图标尺寸。", "Six size options including icon-only variants.")
            </p>
        </div>
        <div class="flex flex-wrap gap-4 items-center">
            <Button Size="ButtonSize.Small">Small</Button>
            <Button Size="ButtonSize.Default">Default</Button>
            <Button Size="ButtonSize.Large">Large</Button>
            <Button Size="ButtonSize.Icon" AriaLabel="@(L.T("图标按钮", "Icon button"))">
                <LucideIcon Name="arrow-right" Size="16" />
            </Button>
            <Button Size="ButtonSize.IconSmall" AriaLabel="@(L.T("小号图标按钮", "Small icon button"))">
                <LucideIcon Name="minus" Size="14" />
            </Button>
            <Button Size="ButtonSize.IconLarge" AriaLabel="@(L.T("大号图标按钮", "Large icon button"))">
                <LucideIcon Name="arrow-right" Size="18" />
            </Button>
        </div>
        <CodeBlock Source="Components/Button/sizes.txt" />
    </div>

    <!-- Icon Buttons with Text -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("带图标的按钮", "Buttons with Icons")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("图标放在文字的起始侧或结束侧（随 RTL 调整）。", "Buttons with icons at start or end position (RTL-aware).")
            </p>
        </div>
        <div class="space-y-4">
            <div class="space-y-2">
                <h3 class="text-lg font-medium">@L.T("图标在起始侧", "Icon at Start")</h3>
                <div class="flex flex-wrap gap-4">
                    <Button IconPosition="IconPosition.Start">
                        <Icon>
                            <LucideIcon Name="arrow-left" Size="16" />
                        </Icon>
                        <ChildContent>@L.T("返回", "Back")</ChildContent>
                    </Button>
                    <Button IconPosition="IconPosition.Start" Variant="ButtonVariant.Outline">
                        <Icon>
                            <LucideIcon Name="search" Size="16" />
                        </Icon>
                        <ChildContent>@L.T("搜索", "Search")</ChildContent>
                    </Button>
                </div>
            </div>
            <div class="space-y-2">
                <h3 class="text-lg font-medium">@L.T("图标在结束侧", "Icon at End")</h3>
                <div class="flex flex-wrap gap-4">
                    <Button IconPosition="IconPosition.End">
                        <Icon>
                            <LucideIcon Name="arrow-right" Size="16" />
                        </Icon>
                        <ChildContent>@L.T("下一步", "Next")</ChildContent>
                    </Button>
                    <Button IconPosition="IconPosition.End" Variant="ButtonVariant.Secondary">
                        <Icon>
                            <LucideIcon Name="external-link" Size="16" />
                        </Icon>
                        <ChildContent>@L.T("外部链接", "External Link")</ChildContent>
                    </Button>
                </div>
            </div>
        </div>
        <CodeBlock Source="Components/Button/with-icons.txt" />
    </div>

    <!-- RTL Support -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("RTL（从右到左）支持", "RTL (Right-to-Left) Support")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("在 RTL 布局里图标位置会自动翻转。", "Icon positioning automatically flips in RTL layouts.")
            </p>
        </div>
        <div class="flex gap-4 items-center mb-4">
            @if (L.IsChinese)
            {
                        <text>
                            <button @onclick="ToggleRTL" class="px-4 py-2 rounded border border-input bg-background hover:bg-accent">
                    切换 RTL（@(isRTL ? "RTL" : "LTR")）
                </button>
                        </text>
}
            else
            {
                        <text>
                            <button @onclick="ToggleRTL" class="px-4 py-2 rounded border border-input bg-background hover:bg-accent">
                    Toggle RTL (@(isRTL ? "RTL" : "LTR"))
                </button>
                        </text>
}
        </div>
        <div dir="@(isRTL ? "rtl" : "ltr")" class="p-6 bg-card rounded-lg border">
            <div class="flex flex-wrap gap-4">
                <Button IconPosition="IconPosition.Start">
                    <Icon>
                        <LucideIcon Name="arrow-left" Size="16" />
                    </Icon>
                    <ChildContent>@L.T("返回（Start）", "Back (Start)")</ChildContent>
                </Button>
                <Button IconPosition="IconPosition.End">
                    <Icon>
                        <LucideIcon Name="arrow-right" Size="16" />
                    </Icon>
                    <ChildContent>@L.T("下一步（End）", "Next (End)")</ChildContent>
                </Button>
            </div>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground mt-4">
                    说明：在 RTL 模式下，“Start”图标出现在右侧，“End”图标出现在左侧。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground mt-4">
                    Note: In RTL mode, "Start" icons appear on the right, "End" icons on the left.
                </p>
                        </text>
}
        </div>
        <CodeBlock Source="Components/Button/rtl.txt" />
    </div>

    <!-- Loading State -->
    <div class="space-y-4">
        <div class="space-y-2">
            <div class="flex items-center gap-2">
                <h2 class="text-2xl font-semibold">@L.T("加载状态", "Loading State")</h2>
                <span class="inline-flex items-center rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary ring-1 ring-inset ring-primary/20">v3</span>
            </div>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    用 <code class="text-xs bg-muted px-1 py-0.5 rounded">Loading</code> 显示转圈并禁用按钮；再给一个 <code class="text-xs bg-muted px-1 py-0.5 rounded">LoadingText</code>，就能在加载期间替换按钮文字。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use <code class="text-xs bg-muted px-1 py-0.5 rounded">Loading</code> to show a spinner and disable the button. Optionally provide <code class="text-xs bg-muted px-1 py-0.5 rounded">LoadingText</code> to replace the label during loading.
                </p>
                        </text>
}
        </div>
        <div class="space-y-4">
            <div class="flex flex-wrap gap-4">
                <Button Loading="true">@L.T("保存更改", "Save Changes")</Button>
                <Button Loading="true" LoadingText="@(L.T("正在保存…", "Saving..."))" Variant="ButtonVariant.Outline">@L.T("保存更改", "Save Changes")</Button>
                @if (L.IsChinese)
                {
                                <text>
                                    <Button Loading="@_isLoading" OnClick="SimulateLoading">
                        @(_isLoading ? "正在提交…" : "提交")
                    </Button>
                                </text>
}
                else
                {
                                <text>
                                    <Button Loading="@_isLoading" OnClick="SimulateLoading">
                        @(_isLoading ? "Submitting..." : "Submit")
                    </Button>
                                </text>
}
            </div>
            <div class="flex flex-wrap gap-4">
                <Button Loading="true" Variant="ButtonVariant.Destructive">@L.T("删除", "Delete")</Button>
                <Button Loading="true" Variant="ButtonVariant.Secondary">@L.T("处理中", "Processing")</Button>
                <Button Loading="true" Variant="ButtonVariant.Ghost">@L.T("加载中", "Loading")</Button>
            </div>
        </div>
        <CodeBlock Source="Components/Button/loading.txt" />
    </div>

    <!-- Disabled States -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("禁用状态", "Disabled State")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("降低透明度，并显示 not-allowed 光标。", "Buttons with reduced opacity and not-allowed cursor.")
            </p>
        </div>
        <div class="flex flex-wrap gap-4">
            <Button Disabled="true">@L.T("默认禁用", "Default Disabled")</Button>
            <Button Variant="ButtonVariant.Destructive" Disabled="true">@L.T("危险按钮禁用", "Destructive Disabled")</Button>
            <Button Variant="ButtonVariant.Outline" Disabled="true">@L.T("描边按钮禁用", "Outline Disabled")</Button>
            <Button Variant="ButtonVariant.Secondary" Disabled="true">@L.T("次要按钮禁用", "Secondary Disabled")</Button>
            <Button Variant="ButtonVariant.Ghost" Disabled="true">@L.T("幽灵按钮禁用", "Ghost Disabled")</Button>
            <Button Variant="ButtonVariant.Link" Disabled="true">@L.T("链接按钮禁用", "Link Disabled")</Button>
        </div>
        <CodeBlock Source="Components/Button/disabled.txt" />
    </div>

    <!-- Cursor Behavior -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("光标行为", "Cursor Behavior")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    按钮默认使用 <code class="text-xs bg-muted px-1 py-0.5 rounded">cursor-pointer</code>，禁用时改用 <code class="text-xs bg-muted px-1 py-0.5 rounded">cursor-not-allowed</code>。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Buttons show <code class="text-xs bg-muted px-1 py-0.5 rounded">cursor-pointer</code> by default and <code class="text-xs bg-muted px-1 py-0.5 rounded">cursor-not-allowed</code> when disabled.
                </p>
                        </text>
}
        </div>
        <div class="flex flex-wrap gap-4">
            <Button>@L.T("手型光标", "Pointer Cursor")</Button>
            <Button Disabled="true">@L.T("禁止光标", "Not-Allowed Cursor")</Button>
            <Button Variant="ButtonVariant.Outline" Disabled="true">@L.T("禁用的描边按钮", "Disabled Outline")</Button>
            <Button Variant="ButtonVariant.Link">@L.T("链接光标", "Link Cursor")</Button>
            <Button Href="/components/badge" Disabled="true">@L.T("禁用的链接", "Disabled Link")</Button>
        </div>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                用 <code class="text-xs bg-muted px-1 py-0.5 rounded">Class</code> 参数可以覆盖光标行为（例如 <code class="text-xs bg-muted px-1 py-0.5 rounded">Class="cursor-default"</code>）。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                Use the <code class="text-xs bg-muted px-1 py-0.5 rounded">Class</code> parameter to override cursor behavior (e.g., <code class="text-xs bg-muted px-1 py-0.5 rounded">Class="cursor-default"</code>).
            </p>
                </text>
}
        <div class="flex flex-wrap gap-4">
            <Button Class="cursor-default">@L.T("自定义：默认光标", "Custom: Default Cursor")</Button>
        </div>
        <CodeBlock Source="Components/Button/cursor.txt" />
    </div>

    <!-- Interactive Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("交互示例", "Interactive")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("点击处理器与事件回调。", "Click handlers and event callbacks.")
            </p>
        </div>
        <div class="space-y-4">
            <div class="flex gap-4 items-center">
                <Button OnClick="HandleClick">@L.T("点我", "Click Me")</Button>
                <span class="text-sm">@clickMessage</span>
            </div>
            <div class="flex gap-4 items-center">
                @if (L.IsChinese)
                {
                                <text>
                                    <Button OnClick="IncrementCounter">
                        已点击 @counter 次
                    </Button>
                                </text>
}
                else
                {
                                <text>
                                    <Button OnClick="IncrementCounter">
                        Clicked @counter times
                    </Button>
                                </text>
}
                <Button Variant="ButtonVariant.Outline" OnClick="ResetCounter">@L.T("重置", "Reset")</Button>
            </div>
        </div>
        <CodeBlock Source="Components/Button/interactive.txt" />
    </div>

    <!-- Form Button Types -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("按钮类型", "Button Types")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("不同的 HTML 按钮 type 特性（submit、reset、button）。", "Different HTML button type attributes (submit, reset, button).")
            </p>
        </div>
        <div class="flex flex-wrap gap-4">
            <Button Type="ButtonType.Button">@L.T("类型：Button", "Type: Button")</Button>
            <Button Type="ButtonType.Submit" Variant="ButtonVariant.Default">@L.T("类型：Submit", "Type: Submit")</Button>
            <Button Type="ButtonType.Reset" Variant="ButtonVariant.Secondary">@L.T("类型：Reset", "Type: Reset")</Button>
        </div>
        <CodeBlock Source="Components/Button/types.txt" />
    </div>

    <!-- Custom Styling -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("自定义类", "Custom Classes")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("通过 Class 参数给按钮加额外 CSS 类。", "Buttons with additional CSS classes via Class parameter.")
            </p>
        </div>
        <div class="space-y-2">
            <Button Class="w-full">@L.T("整行宽度按钮", "Full Width Button")</Button>
            <div class="flex flex-wrap gap-4">
                <Button Class="shadow-lg">@L.T("带阴影", "With Shadow")</Button>
                <Button Variant="ButtonVariant.Outline" Class="border-2 border-blue-500">@L.T("自定义边框", "Custom Border")</Button>
            </div>
        </div>
        <CodeBlock Source="Components/Button/custom-classes.txt" />
    </div>

    <!-- Custom Variants -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("自定义变体", "Custom Variants")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    用 <code class="text-xs bg-muted px-1 py-0.5 rounded">Class</code> 参数做出你自己的变体。TailwindMerge 会保证你的类覆盖内置变体样式。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Create your own variants using the <code class="text-xs bg-muted px-1 py-0.5 rounded">Class</code> parameter. TailwindMerge ensures your classes override the built-in variant styles.
                </p>
                        </text>
}
        </div>
        <div class="flex flex-wrap gap-4">
            <Button Class="bg-green-600 text-white hover:bg-green-700">@L.T("成功", "Success")</Button>
            <Button Class="bg-amber-500 text-white hover:bg-amber-600">@L.T("警告", "Warning")</Button>
            <Button Class="bg-gradient-to-r from-purple-500 to-pink-500 text-white hover:from-purple-600 hover:to-pink-600 border-0">@L.T("品牌", "Brand")</Button>
        </div>
        <CodeBlock Source="Components/Button/custom-variants.txt" />
    </div>

    <!-- All Variants in Dark Mode -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("深色模式", "Dark Mode")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("切换上方的深色模式，看看各变体在深色主题下的效果。", "Toggle dark mode above to test all variants in dark theme.")
            </p>
        </div>
        <div class="p-6 bg-card rounded-lg border">
            <div class="flex flex-wrap gap-4">
                <Button Variant="ButtonVariant.Default">Default</Button>
                <Button Variant="ButtonVariant.Destructive">Destructive</Button>
                <Button Variant="ButtonVariant.Outline">Outline</Button>
                <Button Variant="ButtonVariant.Secondary">Secondary</Button>
                <Button Variant="ButtonVariant.Ghost">Ghost</Button>
                <Button Variant="ButtonVariant.Link">Link</Button>
            </div>
        </div>
        <CodeBlock Source="Components/Button/dark-mode.txt" />
    </div>

    <!-- Accessibility Notes -->


    <AccessibilityList>
        <AriaAttributes>
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    禁用的按钮不可聚焦（tabindex="-1"）
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    Disabled buttons are not focusable (tabindex="-1")
                </AccessibilityItem>
                        </text>
}
            <AccessibilityItem>
                @L.T("ARIA 特性设置正确（aria-label、aria-disabled）", "ARIA attributes set correctly (aria-label, aria-disabled)")
            </AccessibilityItem>
            <AccessibilityItem>
                @L.T("键盘聚焦时出现焦点环（focus-visible:ring-2）", "Focus ring appears on keyboard focus (focus-visible:ring-2)")
            </AccessibilityItem>
            <AccessibilityItem>
                @L.T("颜色对比按可读性标准设计", "Color contrast designed for readability")
            </AccessibilityItem>
            <AccessibilityItem>
                @L.T("使用语义化的 HTML button 元素并带上正确的 role", "Semantic HTML button element with proper role")
            </AccessibilityItem>
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    提供了 Href 时渲染成 &lt;a&gt;，保留链接的导航语义
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    Renders as &lt;a&gt; when Href is provided, preserving link semantics for navigation
                </AccessibilityItem>
                        </text>
}
            <AccessibilityItem>
                @L.T("禁用的链接会去掉 href、设置 aria-disabled，并阻止聚焦", "Disabled links remove href, set aria-disabled, and prevent focus")
            </AccessibilityItem>
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    带 target="_blank" 的链接会自动加上 rel="noopener noreferrer"
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    Automatically adds rel="noopener noreferrer" for target="_blank" links
                </AccessibilityItem>
                        </text>
}
            <AccessibilityItem>
                @L.T("读屏器能正确播报按钮文字与状态", "Screen readers announce button text and state correctly")
            </AccessibilityItem>
        </AriaAttributes>
        <KeyboardNavigation>
            <KeyboardShortcutItem Description="@(L.T("依次聚焦按钮", "Focus buttons in sequence"))">
                <Kbd>Tab</Kbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("激活已聚焦的按钮", "Activate focused button"))">
                <Kbd>Enter</Kbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("激活已聚焦的按钮", "Activate focused button"))">
                <Kbd>Space</Kbd>
            </KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>

    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件的属性与参数。", "Component properties and parameters.")</p>
        </div>

        <ApiReference ComponentName="Button">
            <ApiParameter Name="Variant" Type="ButtonVariant" Default="ButtonVariant.Default">@L.T("获取或设置按钮的视觉样式变体。", "Gets or sets the visual style variant of the button.")</ApiParameter>
            <ApiParameter Name="Size" Type="ButtonSize" Default="ButtonSize.Default">@L.T("获取或设置按钮的尺寸。", "Gets or sets the size of the button.")</ApiParameter>
            <ApiParameter Name="Type" Type="ButtonType" Default="ButtonType.Button">@L.T("获取或设置 HTML 按钮的 type 特性。", "Gets or sets the HTML button type attribute.")</ApiParameter>
            <ApiParameter Name="Disabled" Type="bool">@L.T("获取或设置按钮是否禁用。", "Gets or sets whether the button is disabled.")</ApiParameter>
            <ApiParameter Name="Class" Type="string?">@L.T("获取或设置追加到按钮上的额外 CSS 类。", "Gets or sets additional CSS classes to apply to the button.")</ApiParameter>
            <ApiParameter Name="OnClick" Type="EventCallback&lt;MouseEventArgs&gt;">@L.T("获取或设置点击按钮时触发的回调。", "Gets or sets the callback invoked when the button is clicked.")</ApiParameter>
            <ApiParameter Name="ChildContent" Type="RenderFragment?">@L.T("获取或设置在按钮内部渲染的内容。", "Gets or sets the content to be rendered inside the button.")</ApiParameter>
            <ApiParameter Name="AriaLabel" Type="string?">@L.T("获取或设置按钮的 ARIA 标签。", "Gets or sets the ARIA label for the button.")</ApiParameter>
            <ApiParameter Name="Icon" Type="RenderFragment?">@L.T("获取或设置按钮内显示的图标。", "Gets or sets the icon to display in the button.")</ApiParameter>
            <ApiParameter Name="IconPosition" Type="IconPosition" Default="IconPosition.Start">@L.T("获取或设置图标相对于按钮文字的位置。", "Gets or sets the position of the icon relative to the button text.")</ApiParameter>
            <ApiParameter Name="Loading" Type="bool">@L.T("获取或设置按钮是否处于加载状态。", "Gets or sets whether the button is in a loading state.")</ApiParameter>
            <ApiParameter Name="LoadingText" Type="string?">@L.T("获取或设置按钮加载期间显示的文字。", "Gets or sets the text to display while the button is loading.")</ApiParameter>
            <ApiParameter Name="LoadingTemplate" Type="RenderFragment?">@L.T("获取或设置自定义的加载指示模板。", "Gets or sets a custom loading indicator template.")</ApiParameter>
            <ApiParameter Name="Href" Type="string?">@if (L.IsChinese) {
<text> 获取或设置要跳转到的地址。设置后组件渲染成 &lt;a&gt; 而不是 &lt;button&gt;。 </text>
} else {
<text>Gets or sets the URL to navigate to. When set, the component renders as an &lt;a&gt; element instead of &lt;button&gt;.</text>
}</ApiParameter>
            <ApiParameter Name="Target" Type="string?">@if (L.IsChinese) {
<text> 获取或设置锚点的 target 特性（例如 &quot;_blank&quot;）。仅在设置了 Href 时生效。 </text>
} else {
<text>Gets or sets the anchor target attribute (e.g., &quot;_blank&quot;). Only applies when Href is set.</text>
}</ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">@L.T("获取或设置追加到按钮元素上的额外 HTML 属性。", "Gets or sets additional HTML attributes to apply to the button element.")</ApiParameter>
        </ApiReference>
    </section>

</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    private string clickMessage = "";
    private int counter = 0;
    private bool isRTL = false;

    private Task HandleClick(MouseEventArgs e)
    {
        clickMessage = L.IsChinese
            ? $"按钮点击于 {DateTime.Now:HH:mm:ss}"
            : $"Button clicked at {DateTime.Now:HH:mm:ss}";
        return Task.CompletedTask;
    }

    private Task IncrementCounter(MouseEventArgs e)
    {
        counter++;
        return Task.CompletedTask;
    }

    private Task ResetCounter(MouseEventArgs e)
    {
        counter = 0;
        return Task.CompletedTask;
    }

    private void ToggleRTL()
    {
        isRTL = !isRTL;
    }

    private bool _isLoading;

    private async Task SimulateLoading(MouseEventArgs e)
    {
        // 偏差：源此处显式 StateHasChanged()，本仓分析器（BL0012）判为多余，去掉后行为一致。
        _isLoading = true;
        await Task.Delay(2000);
        _isLoading = false;
    }
}
