@page "/components/form-field-checkbox"
@using System.ComponentModel.DataAnnotations

<PageTitle>@L.T("FormFieldCheckbox 复选框表单域 - Atom BlazorUI", "FormFieldCheckbox Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">FormFieldCheckbox</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("为 Checkbox 提供表单域包装，自带标签、辅助文字与错误提示。", "A form field wrapper for Checkbox with built-in label, helper text, and error messages.")
            </p>
        </div>
    </div>

    <!-- Which form component? -->
    <div class="rounded-lg border border-dashed bg-muted/30 p-6 space-y-3">
        <h2 class="text-lg font-semibold">@L.T("该用哪个表单组件？", "Which form component?")</h2>
        <div class="space-y-2 text-sm text-muted-foreground">
            <p><strong>@L.T("文本输入", "Text input")</strong> @L.T("（string、int、date 等）？", "(string, int, date, etc.)?") &rarr; <a href="/components/form-field-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldInput&lt;T&gt;</a></p>
            <p><strong>@L.T("多行文本", "Textarea")</strong>@L.T("？", "?") &rarr; <a href="/components/form-field-textarea" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldTextarea</a></p>
            <p><strong>@L.T("数字输入", "Numeric input")</strong>@L.T("？", "?") &rarr; <a href="/components/form-field-numeric-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldNumericInput</a></p>
            <p><strong>@L.T("货币输入", "Currency input")</strong>@L.T("？", "?") &rarr; <a href="/components/form-field-currency-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCurrencyInput</a></p>
            <p><strong>@L.T("掩码输入", "Masked input")</strong> @L.T("（phone、SSN 等）？", "(phone, SSN, etc.)?") &rarr; <a href="/components/form-field-masked-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldMaskedInput</a></p>
            <p><strong>@L.T("OTP / 验证码", "OTP / verification code")</strong>@L.T("？", "?") &rarr; <a href="/components/form-field-input-otp" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldInputOTP</a></p>
            <p><strong>@L.T("日期选择器", "Date picker")</strong>@L.T("？", "?") &rarr; <a href="/components/form-field-date-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldDatePicker</a></p>
            <p><strong>@L.T("日期区间选择器", "Date range picker")</strong>@L.T("？", "?") &rarr; <a href="/components/form-field-date-range-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldDateRangePicker</a></p>
            <p><strong>@L.T("时间选择器", "Time picker")</strong>@L.T("？", "?") &rarr; <a href="/components/form-field-time-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldTimePicker</a></p>
            <p><strong>@L.T("复选框", "Checkbox")</strong>@L.T("？", "?") &rarr; <strong>FormFieldCheckbox</strong> @L.T("（当前页）", "(this page)")</p>
            <p><strong>@L.T("复选框组", "Checkbox group")</strong>@L.T("？", "?") &rarr; <a href="/components/form-field-checkbox-group" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCheckboxGroup</a></p>
            <p><strong>@L.T("开关", "Switch")</strong>@L.T("？", "?") &rarr; <a href="/components/form-field-switch" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldSwitch</a></p>
            <p><strong>@L.T("单选组", "Radio group")</strong>@L.T("？", "?") &rarr; <a href="/components/form-field-radio-group" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldRadioGroup</a></p>
            <p><strong>@L.T("下拉选择", "Select dropdown")</strong>@L.T("？", "?") &rarr; <a href="/components/form-field-select" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldSelect</a></p>
            <p><strong>@L.T("原生下拉框", "Native select")</strong>@L.T("？", "?") &rarr; <a href="/components/form-field-native-select" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldNativeSelect</a></p>
            <p><strong>@L.T("可搜索下拉", "Searchable select")</strong>@L.T("？", "?") &rarr; <a href="/components/form-field-combobox" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCombobox</a></p>
            <p><strong>@L.T("多选", "Multi-select")</strong>@L.T("？", "?") &rarr; <a href="/components/form-field-multi-select" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldMultiSelect</a></p>
            <p><strong>@L.T("标签输入", "Tag input")</strong>@L.T("？", "?") &rarr; <a href="/components/form-field-tag-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldTagInput</a></p>
            <p><strong>@L.T("文件上传", "File upload")</strong>@L.T("？", "?") &rarr; <a href="/components/form-field-file-upload" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldFileUpload</a></p>
        </div>
    </div>

    <!-- Basic Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("基本用法", "Basic Usage")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("带自动关联标签与辅助文字的复选框。", "A checkbox with an auto-associated label and helper text.")
            </p>
        </div>
        <div class="max-w-md">
            <FormFieldCheckbox @bind-Checked="_acceptTerms"
                               Label="@(L.T("接受条款与条件", "Accept terms and conditions"))"
                               HelperText="@(L.T("必须接受后才能继续。", "You must accept before continuing."))" />
        </div>
        <div class="rounded-lg border p-4 bg-muted/50">
            <p class="text-sm font-medium mb-1">@L.T("已勾选：", "Checked:")</p>
            <p class="text-sm font-mono">@_acceptTerms</p>
        </div>
        <CodeBlock Source="Components/FormFieldCheckbox/basic.txt" />
    </div>

    <!-- Horizontal Layout -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("水平布局", "Horizontal Layout")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    用 <code class="text-xs bg-muted px-1 py-0.5 rounded">Orientation="FieldOrientation.Horizontal"</code> 把标签放到复选框旁边。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use <code class="text-xs bg-muted px-1 py-0.5 rounded">Orientation="FieldOrientation.Horizontal"</code> to place the label beside the checkbox.
                </p>
                        </text>
}
        </div>
        <div class="max-w-md">
            <FormFieldCheckbox @bind-Checked="_newsletter"
                               Label="@(L.T("订阅简报", "Subscribe to newsletter"))"
                               HelperText="@(L.T("每周获取更新。", "Get weekly updates."))"
                               Orientation="FieldOrientation.Horizontal" />
        </div>
        <CodeBlock Source="Components/FormFieldCheckbox/horizontal.txt" />
    </div>

    <!-- Label on Right -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("标签在右侧（默认）", "Label on Right (Default)")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    默认朝向是 <code class="text-xs bg-muted px-1 py-0.5 rounded">FieldOrientation.HorizontalEnd</code>，它会把标签放在复选框之后。这是内联复选框最常见的做法。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    The default orientation is <code class="text-xs bg-muted px-1 py-0.5 rounded">FieldOrientation.HorizontalEnd</code>, which places the label after the checkbox. This is the most common pattern for inline checkboxes.
                </p>
                        </text>
}
        </div>
        <div class="max-w-md">
            <FormFieldCheckbox @bind-Checked="_rightLabel"
                               Label="@(L.T("我同意条款与条件", "I agree to the terms and conditions"))"
                               HelperText="@(L.T("继续操作前必填。", "Required to continue."))" />
        </div>
        <CodeBlock Source="Components/FormFieldCheckbox/label-right.txt" />
    </div>

    <!-- Label on Bottom -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("标签在下方", "Label on Bottom")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    用 <code class="text-xs bg-muted px-1 py-0.5 rounded">Orientation="FieldOrientation.VerticalEnd"</code> 把标签放到复选框下方。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use <code class="text-xs bg-muted px-1 py-0.5 rounded">Orientation="FieldOrientation.VerticalEnd"</code> to place the label below the checkbox.
                </p>
                        </text>
}
        </div>
        <div class="max-w-md">
            <FormFieldCheckbox @bind-Checked="_bottomLabel"
                               Label="@(L.T("启用该功能", "Enable feature"))"
                               HelperText="@(L.T("之后还可以修改。", "This can be changed later."))"
                               Orientation="FieldOrientation.VerticalEnd" />
        </div>
        <CodeBlock Source="Components/FormFieldCheckbox/label-bottom.txt" />
    </div>

    <!-- Indeterminate (Select All) -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("不确定态", "Indeterminate")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("父级复选框会反映其子项的汇总状态。当只选中了部分（而非全部）条目时，父级会显示不确定态的横线。", "A parent checkbox that reflects the aggregate state of its children. When some (but not all) items are selected, the parent shows an indeterminate dash.")
            </p>
        </div>
        <div class="max-w-md space-y-3">
            <FormFieldCheckbox Checked="@_selectAllChecked"
                               CheckedChanged="HandleSelectAllChanged"
                               Indeterminate="@_selectAllIndeterminate"
                               Label="@(L.T("选择全部权限", "Select all permissions"))" />
            <div class="ml-6 space-y-1">
                <FormFieldCheckbox Checked="@_permRead"
                                   CheckedChanged="@(v => { _permRead = v; UpdatePermSelectAll(); })"
                                   Label="@(L.T("读取", "Read"))" />
                <FormFieldCheckbox Checked="@_permWrite"
                                   CheckedChanged="@(v => { _permWrite = v; UpdatePermSelectAll(); })"
                                   Label="@(L.T("写入", "Write"))" />
                <FormFieldCheckbox Checked="@_permDelete"
                                   CheckedChanged="@(v => { _permDelete = v; UpdatePermSelectAll(); })"
                                   Label="@(L.T("删除", "Delete"))" />
            </div>
        </div>
        <CodeBlock Source="Components/FormFieldCheckbox/indeterminate.txt" />
    </div>

    <!-- Error Text -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("覆盖错误提示", "Error Text Override")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    通过 <code class="text-xs bg-muted px-1 py-0.5 rounded">ErrorText</code> 提供一条静态错误提示。
                    放在 EditForm 里时，校验错误会自动显示。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Provide a static error message via <code class="text-xs bg-muted px-1 py-0.5 rounded">ErrorText</code>.
                    When used inside an EditForm, validation errors display automatically.
                </p>
                        </text>
}
        </div>
        <div class="max-w-md">
            <FormFieldCheckbox @bind-Checked="_errorDemo"
                               Label="@(L.T("必填复选框", "Required checkbox"))"
                               ErrorText="@(_errorDemoError)" />
        </div>
        <CodeBlock Source="Components/FormFieldCheckbox/error-text.txt" />
    </div>

    <!-- Disabled -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("禁用状态", "Disabled")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("一个被禁用的复选框表单域。", "A disabled checkbox form field.")
            </p>
        </div>
        <div class="max-w-md">
            <FormFieldCheckbox Checked="true"
                               Label="@(L.T("已锁定的偏好设置", "Locked preference"))"
                               HelperText="@(L.T("如需修改请联系客服。", "Contact support to change."))"
                               Disabled="true" />
        </div>
        <CodeBlock Source="Components/FormFieldCheckbox/disabled.txt" />
    </div>

    <!-- EditForm Integration -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("与 EditForm 集成", "EditForm Integration")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    在 <code class="text-xs bg-muted px-1 py-0.5 rounded">EditForm</code> 内部，
                    校验错误会自动显示。试着不勾选就提交看看。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Inside an <code class="text-xs bg-muted px-1 py-0.5 rounded">EditForm</code>,
                    validation errors are displayed automatically. Try submitting without checking the box.
                </p>
                        </text>
}
        </div>
        <div class="max-w-md">
            <EditForm Model="_formModel" OnValidSubmit="HandleFormSubmit">
                <DataAnnotationsValidator />
                <div class="space-y-4">
                    <FormFieldCheckbox @bind-Checked="_formModel.AgreeToTerms"
                                       Label="@(L.T("我同意服务条款", "I agree to the terms of service"))" />
                    <Button Type="ButtonType.Submit">@L.T("提交", "Submit")</Button>
                </div>
            </EditForm>
            @if (_formSubmitted)
            {
                <div class="mt-4 rounded-lg border border-green-200 bg-green-50 dark:bg-green-950 dark:border-green-800 p-4">
                    <p class="text-sm font-medium text-green-800 dark:text-green-200">@L.T("表单提交成功！", "Form submitted successfully!")</p>
                </div>
            }
        </div>
        <CodeBlock Source="Components/FormFieldCheckbox/edit-form.txt" />
    </div>

    <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>@L.T("通过自动生成的 ID 把标签与输入框关联起来。", "Automatically associates label with input via generated ID")</AccessibilityItem>
            <AccessibilityItem>@L.T("描述文字通过 aria-describedby 关联。", "Description linked via aria-describedby")</AccessibilityItem>
            <AccessibilityItem>@L.T("校验错误会带上 aria-invalid 显示。", "Validation errors displayed with aria-invalid")</AccessibilityItem>
        </AriaAttributes>
            <KeyboardNavigation>
            <KeyboardShortcutItem Description="@(L.T("在可用的表单控件之间移动", "Move between enabled form controls"))"><Kbd>Tab</Kbd> / <Kbd>Shift + Tab</Kbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("切换当前控件的勾选状态", "Toggle the focused control"))"><Kbd>Space</Kbd></KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>

    <!-- API Reference -->
    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件属性与参数。", "Component properties and parameters.")</p>
        </div>
        <div class="space-y-4">
            <ApiReference ComponentName="FormFieldCheckbox">
                <ApiParameter Name="Label" Type="string?" Default="null">
                    @L.T("显示在复选框上方或旁边的标签文本。", "The label text displayed above or beside the checkbox.")
                </ApiParameter>
                <ApiParameter Name="HelperText" Type="string?" Default="null">
                    @L.T("显示在复选框下方的辅助文字。出错时会被隐藏。", "Helper text displayed below the checkbox. Hidden during error state.")
                </ApiParameter>
                <ApiParameter Name="ErrorText" Type="string?" Default="null">
                    @L.T("手动覆盖的错误提示。当字段无效且设置了这一项时，会替换自动生成的提示。", "Manual error text override. When the field is invalid and this is set, replaces auto-generated messages.")
                </ApiParameter>
                <ApiParameter Name="Orientation" Type="FieldOrientation" Default="HorizontalEnd">
                    @L.T("布局朝向。默认把标签放在复选框之后。", "Layout orientation. Default places the label after the checkbox.")
                </ApiParameter>
                <ApiParameter Name="Checked" Type="bool" Default="false">
                    @L.T("复选框是否被勾选。请使用 @@bind-Checked 实现双向绑定。", "Whether the checkbox is checked. Use @bind-Checked for two-way binding.")
                </ApiParameter>
                <ApiParameter Name="CheckedChanged" Type="EventCallback&lt;bool&gt;">
                    @L.T("勾选状态发生变化时调用的回调。", "Callback invoked when the checked state changes.")
                </ApiParameter>
                <ApiParameter Name="Indeterminate" Type="bool" Default="false">
                    @L.T("复选框是否处于不确定态。", "Whether the checkbox is in an indeterminate state.")
                </ApiParameter>
                <ApiParameter Name="Disabled" Type="bool" Default="false">
                    @L.T("复选框是否被禁用。", "Whether the checkbox is disabled.")
                </ApiParameter>
                <ApiParameter Name="Required" Type="bool" Default="false">
                    @L.T("复选框在表单上下文中是否为必填。", "Whether the checkbox is required in a form context.")
                </ApiParameter>
                <ApiParameter Name="InputClass" Type="string?" Default="null">
                    @L.T("应用到底层 Checkbox 元素上的额外 CSS 类。", "Additional CSS classes applied to the inner Checkbox element.")
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?" Default="null">
                    @L.T("应用到外层 Field 容器上的额外 CSS 类。", "Additional CSS classes applied to the outer Field container.")
                </ApiParameter>
                <ApiParameter Name="AriaLabel" Type="string?" Default="null">
                    @L.T("该控件的 ARIA 标签。", "ARIA label for the control.")
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            应用到底层组件根元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                                        </text>
}
                    else
                    {
                                        <text>
                                            Additional HTML attributes applied to the component's root element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                                        </text>
}
                </ApiParameter>
            </ApiReference>
        </div>
    </section>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    private bool _acceptTerms;
    private bool _newsletter;
    private bool _rightLabel;
    private bool _bottomLabel;
    private bool _errorDemo;
    private bool _formSubmitted;

    // Indeterminate (Select All)
    private bool _selectAllChecked;
    private bool _selectAllIndeterminate;
    private bool _permRead = true;
    private bool _permWrite;
    private bool _permDelete;

    protected override void OnInitialized() => UpdatePermSelectAll();

    private void HandleSelectAllChanged(bool value)
    {
        _selectAllChecked = value;
        _selectAllIndeterminate = false;
        _permRead = value;
        _permWrite = value;
        _permDelete = value;
    }

    private void UpdatePermSelectAll()
    {
        var all = _permRead && _permWrite && _permDelete;
        var none = !_permRead && !_permWrite && !_permDelete;
        _selectAllChecked = all;
        _selectAllIndeterminate = !all && !none;
    }
    private CheckboxFormModel _formModel = new();

    private string? _errorDemoError => !_errorDemo ? L.T("该字段为必填项。", "This field is required.") : null;

    private void HandleFormSubmit()
    {
        _formSubmitted = true;
    }

    private class CheckboxFormModel
    {
        [Range(typeof(bool), "true", "true", ErrorMessage = "You must agree to the terms.")]
        public bool AgreeToTerms { get; set; }
    }
}
