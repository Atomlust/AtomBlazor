                <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(string.IsNullOrEmpty(compositionalValue) ? L.T("（无）", "(none)") : GetCompositionalLabel(compositionalValue))</p>
            </div>
