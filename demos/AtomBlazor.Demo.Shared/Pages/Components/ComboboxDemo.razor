    <!-- Async Compositional Mode -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("异步组合式模式", "Async Compositional Mode")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                把 <code class="bg-muted px-1 py-0.5 rounded text-sm">SearchQueryChanged</code> 与组合式的
                <code class="bg-muted px-1 py-0.5 rounded text-sm">ComboboxItem</code> 子内容结合，就能异步加载数据，
                同时对条目渲染保持完全控制。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                Combine <code class="bg-muted px-1 py-0.5 rounded text-sm">SearchQueryChanged</code> with compositional
                <code class="bg-muted px-1 py-0.5 rounded text-sm">ComboboxItem</code> children to load data asynchronously
                while retaining full control over item rendering.
            </p>
                </text>
}

        <div class="flex flex-col gap-2">
            <Combobox TValue="string"
                     @bind-Value="asyncCompSelectedUser"
                     SearchQueryChanged="@HandleUserSearch"
                     Placeholder="@(L.T("搜索用户……", "Search for a user..."))"
                     SearchPlaceholder="@(L.T("输入即可搜索用户……", "Type to search users..."))"
                     EmptyMessage="@(asyncCompIsLoading ? L.T("加载中……", "Loading...") : L.T("未找到用户。", "No users found."))"
                     PopoverWidth="w-[300px]">
                @foreach (var user in asyncCompUsers)
                {
                    <ComboboxItem Value="@user.Id" Text="@user.Name">
                        <div class="flex items-center gap-2">
                            <span class="@($"inline-block h-2 w-2 rounded-full {user.StatusColor}")"></span>
                            <div class="flex flex-col">
                                <span>@user.Name</span>
                                <span class="text-xs text-muted-foreground">@user.Role</span>
                            </div>
                        </div>
                    </ComboboxItem>
                }
            </Combobox>
            <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
                <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected value:")</span> <span class="font-mono">@(string.IsNullOrEmpty(asyncCompSelectedUser) ? L.T("（无）", "(none)") : asyncCompSelectedUser)</span></p>
                <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(string.IsNullOrEmpty(asyncCompSelectedUser) ? L.T("（无）", "(none)") : GetAsyncCompUserName(asyncCompSelectedUser))</p>
                <p class="text-sm"><span class="font-medium">@L.T("已载入结果数：", "Results loaded:")</span> @asyncCompUsers.Length</p>
            </div>
        </div>

        <CodeBlock Source="Components/Combobox/async-compositional.txt" />
    </section>

