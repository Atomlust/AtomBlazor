@page "/components/combobox"
@using System.ComponentModel.DataAnnotations

<PageTitle>@L.T("Combobox 组合框 - Atom BlazorUI", "Combobox Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("Combobox 组合框", "Combobox Component")</h1>
            <span class="inline-flex items-center rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary ring-1 ring-inset ring-primary/20">v3</span>
        </div>
        <p class="text-xl text-muted-foreground">
            @L.T("可搜索的选择组件，把自动完成与下拉界面结合在一起。",
                 "A searchable select component that combines autocomplete with a dropdown interface.")
        </p>
        </div>
    </div>

    <div class="space-y-6">
    </div>

    <!-- Basic Combobox -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("基础组合框", "Basic Combobox")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("从可搜索的列表里选择一个框架。再次点击可取消选择。",
                 "Select a framework from the searchable list. Click to deselect.")
        </p>

        <div class="flex flex-col gap-2">
            <Combobox AriaLabel="@(L.T("选择一个选项", "Choose an option"))" TValue="string"
                     Options="frameworks"
                     @bind-Value="selectedFramework"
                     Placeholder="@(L.T("选择框架……", "Select framework..."))"
                     SearchPlaceholder="@(L.T("搜索框架……", "Search framework..."))"
                     EmptyMessage="@(L.T("未找到框架。", "No framework found."))"
                     PopoverWidth="w-[200px]" />
            <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
                <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected value:")</span> <span class="font-mono">@(string.IsNullOrEmpty(selectedFramework) ? L.T("（无）", "(none)") : selectedFramework)</span></p>
                <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(string.IsNullOrEmpty(selectedFramework) ? L.T("（无）", "(none)") : frameworks.GetText(selectedFramework))</p>
            </div>
        </div>

        <CodeBlock Source="Components/Combobox/basic.txt" />
    </section>

    <!-- Language Selector -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("编程语言", "Programming Language")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("更宽一些的组合框，列出编程语言。", "Wider combobox with programming languages.")
        </p>

        <div class="flex flex-col gap-2">
            <Combobox TValue="string"
                     Options="languages"
                     @bind-Value="selectedLanguage"
                     Placeholder="@(L.T("选择语言……", "Select language..."))"
                     SearchPlaceholder="@(L.T("搜索语言……", "Search language..."))"
                     EmptyMessage="@(L.T("未找到语言。", "No language found."))"
                     PopoverWidth="w-[250px]" />
            <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
                <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected value:")</span> <span class="font-mono">@(string.IsNullOrEmpty(selectedLanguage) ? L.T("（无）", "(none)") : selectedLanguage)</span></p>
                <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(string.IsNullOrEmpty(selectedLanguage) ? L.T("（无）", "(none)") : languages.GetText(selectedLanguage))</p>
            </div>
        </div>

        <CodeBlock Source="Components/Combobox/language.txt" />
    </section>

    <!-- Country Selector -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("国家选择", "Country Selector")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("带搜索功能的大数据集。", "Large dataset with search functionality.")
        </p>

        <div class="flex flex-col gap-2">
            <Combobox TValue="string"
                     Options="countries"
                     @bind-Value="selectedCountry"
                     Placeholder="@(L.T("选择国家……", "Select country..."))"
                     SearchPlaceholder="@(L.T("搜索国家……", "Search country..."))"
                     EmptyMessage="@(L.T("未找到国家。", "No country found."))"
                     PopoverWidth="w-[280px]" />
            <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
                <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected value:")</span> <span class="font-mono">@(string.IsNullOrEmpty(selectedCountry) ? L.T("（无）", "(none)") : selectedCountry)</span></p>
                <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(string.IsNullOrEmpty(selectedCountry) ? L.T("（无）", "(none)") : countries.GetText(selectedCountry))</p>
            </div>
        </div>

        <CodeBlock Source="Components/Combobox/country.txt" />
    </section>

    <!-- Non-String Value Types -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("非字符串值类型", "Non-String Value Types")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                用 <code class="text-xs bg-muted px-1 py-0.5 rounded">TValue="int?"</code> 绑定到
                <code class="text-xs bg-muted px-1 py-0.5 rounded">int?</code> 值，
                类型转换由组件自动处理。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                Bind to <code class="text-xs bg-muted px-1 py-0.5 rounded">int?</code> values using
                <code class="text-xs bg-muted px-1 py-0.5 rounded">TValue="int?"</code>.
                The component handles conversion automatically.
            </p>
                </text>
}

        <div class="flex flex-col gap-2">
            <Combobox TValue="int?"
                     Options="priorities"
                     @bind-Value="selectedPriority"
                     Placeholder="@(L.T("选择优先级……", "Select priority..."))"
                     SearchPlaceholder="@(L.T("搜索优先级……", "Search priority..."))"
                     EmptyMessage="@(L.T("未找到优先级。", "No priority found."))"
                     PopoverWidth="w-[200px]" />
            <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
                <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected value:")</span> <span class="font-mono">@(selectedPriority.HasValue ? selectedPriority.Value.ToString() : L.T("（无）", "(none)"))</span></p>
                <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(selectedPriority.HasValue ? priorities.GetText(selectedPriority) : L.T("（无）", "(none)"))</p>
            </div>
        </div>

        <CodeBlock Source="Components/Combobox/non-string-values.txt" />
    </section>

    <!-- Enum Values -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("枚举值", "Enum Values")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                用 <code class="text-xs bg-muted px-1 py-0.5 rounded">TValue="Status?"</code> 绑定到可空枚举，
                每个选项把一个枚举值映射到一个显示标签。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                Bind to a nullable enum using
                <code class="text-xs bg-muted px-1 py-0.5 rounded">TValue="Status?"</code>.
                Each option maps an enum value to a display label.
            </p>
                </text>
}

        <div class="flex flex-col gap-2">
            <Combobox TValue="Status?"
                     Options="statusOptions"
                     @bind-Value="selectedStatus"
                     Placeholder="@(L.T("选择状态……", "Select status..."))"
                     SearchPlaceholder="@(L.T("搜索状态……", "Search status..."))"
                     EmptyMessage="@(L.T("未找到状态。", "No status found."))"
                     PopoverWidth="w-[200px]" />
            <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
                <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected value:")</span> <span class="font-mono">@(selectedStatus.HasValue ? selectedStatus.Value.ToString() : L.T("（无）", "(none)"))</span></p>
                <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(selectedStatus.HasValue ? statusOptions.GetText(selectedStatus) : L.T("（无）", "(none)"))</p>
            </div>
        </div>

        <CodeBlock Source="Components/Combobox/enum-values.txt" />
    </section>

    <!-- Guid Values -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("Guid 值", "Guid Values")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                用 <code class="text-xs bg-muted px-1 py-0.5 rounded">TValue="Guid?"</code> 绑定到
                <code class="text-xs bg-muted px-1 py-0.5 rounded">Guid?</code> 值。
                适合挑选以 GUID 标识的实体，例如项目、租户或资源。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                Bind to a <code class="text-xs bg-muted px-1 py-0.5 rounded">Guid?</code> value using
                <code class="text-xs bg-muted px-1 py-0.5 rounded">TValue="Guid?"</code>.
                Useful for selecting entities identified by GUIDs such as projects, tenants, or resources.
            </p>
                </text>
}

        <div class="flex flex-col gap-2">
            <Combobox TValue="Guid?"
                     Options="projects"
                     @bind-Value="selectedProject"
                     Placeholder="@(L.T("选择项目……", "Select project..."))"
                     SearchPlaceholder="@(L.T("搜索项目……", "Search project..."))"
                     EmptyMessage="@(L.T("未找到项目。", "No project found."))"
                     PopoverWidth="w-[280px]" />
            <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
                <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected value:")</span> <span class="font-mono">@(selectedProject.HasValue ? selectedProject.Value.ToString() : L.T("（无）", "(none)"))</span></p>
                <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(selectedProject.HasValue ? projects.GetText(selectedProject) : L.T("（无）", "(none)"))</p>
            </div>
        </div>

        <CodeBlock Source="Components/Combobox/guid-values.txt" />
    </section>

    <!-- Match Trigger Width -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("匹配触发器宽度", "Match Trigger Width")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                打开 <code class="bg-muted px-1 py-0.5 rounded text-sm">MatchTriggerWidth="true"</code> 后，
                下拉面板会自动与触发元素的宽度保持一致。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                With <code class="bg-muted px-1 py-0.5 rounded text-sm">MatchTriggerWidth="true"</code>,
                the dropdown automatically matches the width of the trigger element.
            </p>
                </text>
}

        <div class="flex flex-col gap-4">
            <div class="w-64">
                <label class="text-sm font-medium mb-2 block">@L.T("固定宽度容器（w-64）", "Fixed width container (w-64)")</label>
                <Combobox TValue="string"
                         Options="frameworks"
                         @bind-Value="matchWidthValue1"
                         Placeholder="@(L.T("选择框架……", "Select framework..."))"
                         SearchPlaceholder="@(L.T("搜索……", "Search..."))"
                         MatchTriggerWidth="true"
                         Class="w-full" />
            </div>

            <div class="w-96">
                <label class="text-sm font-medium mb-2 block">@L.T("更宽的容器（w-96）", "Wider container (w-96)")</label>
                <Combobox TValue="string"
                         Options="countries"
                         @bind-Value="matchWidthValue2"
                         Placeholder="@(L.T("选择国家……", "Select country..."))"
                         SearchPlaceholder="@(L.T("搜索国家……", "Search country..."))"
                         MatchTriggerWidth="true"
                         Class="w-full" />
            </div>
        </div>

        <CodeBlock Source="Components/Combobox/match-trigger-width.txt" />
    </section>

    <!-- Async Data Loading -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("异步数据加载", "Async Data Loading")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                用 <code class="bg-muted px-1 py-0.5 rounded text-sm">SearchQueryChanged</code> 响应筛选变化，
                并从外部来源加载数据。搜索词通过 <code class="bg-muted px-1 py-0.5 rounded text-sm">@@bind-SearchQuery</code> 暴露。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                Use <code class="bg-muted px-1 py-0.5 rounded text-sm">SearchQueryChanged</code> to react to filter changes
                and load data from an external source. The search query is exposed via
                <code class="bg-muted px-1 py-0.5 rounded text-sm">@@bind-SearchQuery</code>.
            </p>
                </text>
}

        <div class="flex flex-col gap-2">
            <Combobox TValue="string"
                     Options="asyncCities"
                     @bind-Value="asyncSelectedCity"
                     SearchQueryChanged="@HandleCitySearch"
                     Placeholder="@(L.T("搜索城市……", "Search for a city..."))"
                     SearchPlaceholder="@(L.T("输入即可搜索城市……", "Type to search cities..."))"
                     EmptyMessage="@(asyncIsLoading ? L.T("加载中……", "Loading...") : L.T("未找到城市。", "No cities found."))"
                     PopoverWidth="w-[280px]" />
            <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
                <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected value:")</span> <span class="font-mono">@(string.IsNullOrEmpty(asyncSelectedCity) ? L.T("（无）", "(none)") : asyncSelectedCity)</span></p>
                <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(string.IsNullOrEmpty(asyncSelectedCity) ? L.T("（无）", "(none)") : asyncCities.GetText(asyncSelectedCity))</p>
                <p class="text-sm"><span class="font-medium">@L.T("已载入结果数：", "Results loaded:")</span> @asyncCities.Length</p>
            </div>
        </div>

        <CodeBlock Source="Components/Combobox/async-data-loading.txt" />
    </section>

    <!-- Infinite Scroll -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("无限滚动", "Infinite Scroll")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                面对大数据集，用 <code class="bg-muted px-1 py-0.5 rounded text-sm">OnLoadMore</code>
                在用户滚动时按批次载入条目，并配合
                <code class="bg-muted px-1 py-0.5 rounded text-sm">IsLoading</code> 显示加载动画、避免重复请求。
                本例有 200 件商品，每次载入 20 件。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                For large datasets, use <code class="bg-muted px-1 py-0.5 rounded text-sm">OnLoadMore</code> to load items
                in batches as the user scrolls. Combine with
                <code class="bg-muted px-1 py-0.5 rounded text-sm">IsLoading</code> to show a spinner and prevent duplicate requests.
                This example has 200 products and loads 20 at a time.
            </p>
                </text>
}

        <div class="flex flex-col gap-2">
            <Combobox TValue="string"
                     Options="infiniteScrollProducts"
                     @bind-Value="infiniteScrollSelected"
                     SearchQueryChanged="@HandleProductSearch"
                     OnLoadMore="@HandleLoadMoreProducts"
                     IsLoading="@infiniteScrollIsLoading"
                     EndOfListMessage="@(infiniteScrollProducts.Length >= infiniteScrollFilteredTotal && infiniteScrollFilteredTotal > 0 ? L.T("已加载全部商品。", "All products loaded.") : null)"
                     Placeholder="@(L.T("选择商品……", "Select a product..."))"
                     SearchPlaceholder="@(L.T("搜索商品……", "Search products..."))"
                     EmptyMessage="@(infiniteScrollIsLoading ? L.T("加载中……", "Loading...") : L.T("未找到商品。", "No products found."))"
                     MatchTriggerWidth="true"
                     Class="w-[320px]" />
            <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
                <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected value:")</span> <span class="font-mono">@(string.IsNullOrEmpty(infiniteScrollSelected) ? L.T("（无）", "(none)") : infiniteScrollSelected)</span></p>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm"><span class="font-medium">已载入：</span> @infiniteScrollProducts.Length / @infiniteScrollFilteredTotal 条匹配</p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm"><span class="font-medium">Loaded:</span> @infiniteScrollProducts.Length of @infiniteScrollFilteredTotal matching</p>
                                </text>
}
            </div>
        </div>

        <CodeBlock Source="Components/Combobox/infinite-scroll.txt" />
    </section>

    <!-- Infinite Scroll (Compositional) -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("无限滚动（组合式）", "Infinite Scroll (Compositional)")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                无限滚动在组合式模式下同样可用。本例用 <code class="bg-muted px-1 py-0.5 rounded text-sm">ComboboxItem</code> 子内容
                渲染 100 个带国旗 emoji 的国家，每次载入 20 个。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                Infinite scroll works with compositional mode too. This example renders 100 countries with flag emojis
                using <code class="bg-muted px-1 py-0.5 rounded text-sm">ComboboxItem</code> children, loading 20 at a time.
            </p>
                </text>
}

        <div class="flex flex-col gap-2">
            <Combobox TValue="string"
                     @bind-Value="countryScrollSelected"
                     SearchQueryChanged="@HandleCountrySearch"
                     OnLoadMore="@HandleLoadMoreCountries"
                     IsLoading="@countryScrollIsLoading"
                     Placeholder="@(L.T("选择国家……", "Select a country..."))"
                     SearchPlaceholder="@(L.T("搜索国家……", "Search countries..."))"
                     EmptyMessage="@(countryScrollIsLoading ? L.T("加载中……", "Loading...") : L.T("未找到国家。", "No countries found."))"
                     MatchTriggerWidth="true"
                     Class="w-[320px]">
                @foreach (var c in countryScrollVisible)
                {
                    <ComboboxItem Value="@c.Code" Text="@($"{c.Flag} {c.Name}")">
                        <div class="flex items-center gap-2">
                            <span>@c.Flag</span>
                            <span>@c.Name</span>
                        </div>
                    </ComboboxItem>
                }
            </Combobox>
            <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
                <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected value:")</span> <span class="font-mono">@(string.IsNullOrEmpty(countryScrollSelected) ? L.T("（无）", "(none)") : countryScrollSelected)</span></p>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm"><span class="font-medium">已载入：</span> @countryScrollVisible.Length / @countryScrollFilteredTotal 条匹配</p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm"><span class="font-medium">Loaded:</span> @countryScrollVisible.Length of @countryScrollFilteredTotal matching</p>
                                </text>
}
            </div>
        </div>

        <CodeBlock Source="Components/Combobox/infinite-scroll-compositional.txt" />
    </section>

    <!-- Disabled State -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("禁用状态", "Disabled State")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("处于禁用状态的组合框。", "Combobox in disabled state.")
        </p>

        <Combobox TValue="string"
                 Options="frameworks"
                 @bind-Value="disabledValue"
                 Placeholder="@(L.T("已禁用的组合框", "Disabled combobox"))"
                 Disabled="true"
                 PopoverWidth="w-[200px]" />

        <CodeBlock Source="Components/Combobox/disabled.txt" />
    </section>

    <!-- Form Validation with EditForm -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("EditForm 校验", "EditForm Validation")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                Combobox 与 Blazor 的 EditForm、EditContext 集成以做模型校验。
                在 EditForm 内使用 <code class="text-xs bg-muted px-1 py-0.5 rounded">@@bind-Value</code>，
                校验错误会通过 <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-invalid</code> 自动套用错误样式。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                Combobox integrates with Blazor's EditForm and EditContext for model validation.
                Use <code class="text-xs bg-muted px-1 py-0.5 rounded">@@bind-Value</code> within an EditForm and
                validation errors will automatically apply error styling via <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-invalid</code>.
            </p>
                </text>
}

        <EditForm Model="comboboxFormModel" OnValidSubmit="HandleComboboxFormSubmit" class="max-w-md space-y-4">
            <DataAnnotationsValidator />

            <div class="space-y-2">
                <label class="text-sm font-medium">@L.T("框架", "Framework")</label>
                <Combobox TValue="string"
                         Options="frameworks"
                         @bind-Value="comboboxFormModel.Framework"
                         Placeholder="@(L.T("选择框架……", "Select framework..."))"
                         SearchPlaceholder="@(L.T("搜索框架……", "Search framework..."))"
                         EmptyMessage="@(L.T("未找到框架。", "No framework found."))"
                         Class="w-full"
                         MatchTriggerWidth="true" />
                <ValidationMessage For="@(() => comboboxFormModel.Framework)" class="text-sm text-destructive" />
            </div>

            <div class="flex gap-4">
                <Button Type="ButtonType.Submit" Variant="ButtonVariant.Default">@L.T("提交", "Submit")</Button>
                <Button Type="ButtonType.Button" Variant="ButtonVariant.Outline" OnClick="ResetComboboxForm">@L.T("重置", "Reset")</Button>
            </div>

            @if (!string.IsNullOrEmpty(comboboxFormMessage))
            {
                <div class="p-4 bg-card rounded-lg border">
                    <p class="text-sm">@comboboxFormMessage</p>
