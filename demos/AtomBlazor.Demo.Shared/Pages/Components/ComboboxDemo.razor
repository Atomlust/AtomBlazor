                    <ComboboxItem Value="@("jobTitle")" Text="@(L.T("职位", "Job Title"))">@L.T("职位", "Job Title")</ComboboxItem>
                    <ComboboxItem Value="@("department")" Text="@(L.T("部门", "Department"))">@L.T("部门", "Department")</ComboboxItem>
