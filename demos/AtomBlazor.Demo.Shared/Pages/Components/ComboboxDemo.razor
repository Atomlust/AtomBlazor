                {
                    defaults = [selected, .. defaults];
                }
            }

            asyncCompUsers = defaults;
        }
        else
        {
            asyncCompUsers = allUsers
                .Where(u => u.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
                         || u.Role.Contains(query, StringComparison.OrdinalIgnoreCase))
                .ToArray();
        }

        asyncCompIsLoading = false;
    }

    private string GetAsyncCompUserName(string? id) =>
        id is not null ? allUsers.FirstOrDefault(u => u.Id == id)?.Name ?? (L.IsChinese ? "（无）" : "(none)") : (L.IsChinese ? "（无）" : "(none)");

    private record UserInfo(string Id, string Name, string Role, string StatusColor);

    private void HandleFormSubmit()
    {
        formSubmitted = true;
        // BL0012（.NET 11）：事件处理器触发的重渲染由框架自动完成，此处的显式 StateHasChanged 无需保留。
    }

    private ComboboxFormModel comboboxFormModel = new();
    private string? comboboxFormMessage;

    private void HandleComboboxFormSubmit()
    {
        if (L.IsChinese)
        {
            comboboxFormMessage = $"已提交值：{comboboxFormModel.Framework} ｜ 已选文本：{frameworks.GetText(comboboxFormModel.Framework)}";
        }
        else
        {
            comboboxFormMessage = $"Submitted value: {comboboxFormModel.Framework} | Submitted text: {frameworks.GetText(comboboxFormModel.Framework)}";
        }
    }

    private void ResetComboboxForm()
    {
        comboboxFormModel = new();
        comboboxFormMessage = null;
    }

    public enum Status { Active, Inactive, Pending, Archived }

    private class ComboboxFormModel
    {
        [Required(ErrorMessage = "Please select a framework.")]
        public string? Framework { get; set; }
    }
}
