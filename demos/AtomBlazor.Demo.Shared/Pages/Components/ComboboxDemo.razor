    <!-- API Reference -->
    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件属性与参数。", "Component properties and parameters.")</p>
        </div>

        <div class="space-y-4">
            <ApiReference ComponentName="Combobox&lt;TValue&gt;">
                <ApiParameter Name="AriaLabel" Type="string?" Default="null">@L.T("转发给交互控件或分组的可访问名称。", "Accessible name forwarded to the interactive control or group.")</ApiParameter>
                <ApiParameter Name="Options" Type="IEnumerable&lt;SelectOption&lt;TValue&gt;&gt;?">
                    @L.T("数据驱动模式下的选项集合。为 null 时改用组合式模式，由 ChildContent 提供内容。", "Collection of options for data-driven mode. When null, uses compositional mode with ChildContent.")
                </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="Value" Type="TValue?">
                        当前选中的值。支持用 <code>@@bind-Value</code> 双向绑定。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="Value" Type="TValue?">
                        Currently selected value. Supports two-way binding with <code>@@bind-Value</code>.
                    </ApiParameter>
                                </text>
}
                <ApiParameter Name="ValueChanged" Type="EventCallback&lt;TValue?&gt;">
                    @L.T("选中值发生变化时触发的回调。", "Callback invoked when the selected value changes.")
                </ApiParameter>
                <ApiParameter Name="Placeholder" Type="string" Default="&quot;Select an option...&quot;">
                    @L.T("未选择任何条目时显示的占位文本。", "Placeholder text shown when no item is selected.")
                </ApiParameter>
                <ApiParameter Name="SearchPlaceholder" Type="string" Default="&quot;Search...&quot;">
                    @L.T("搜索输入框里的占位文本。", "Placeholder text shown in the search input.")
                </ApiParameter>
                <ApiParameter Name="EmptyMessage" Type="string" Default="&quot;No results found.&quot;">
                    @L.T("没有条目匹配搜索时显示的消息。", "Message displayed when no items match the search.")
                </ApiParameter>
                <ApiParameter Name="Disabled" Type="bool" Default="false">
                    @L.T("组合框是否被禁用。", "Whether the combobox is disabled.")
                </ApiParameter>
                <ApiParameter Name="Required" Type="bool" Default="false">
                    @L.T("组合框是否为必填。", "Whether the combobox is required.")
                </ApiParameter>
                <ApiParameter Name="MatchTriggerWidth" Type="bool" Default="false">
                    @L.T("是否让下拉面板宽度与触发元素一致。", "Whether to match dropdown width to the trigger element width.")
                </ApiParameter>
                <ApiParameter Name="PopoverWidth" Type="string" Default="&quot;w-[200px]&quot;">
                    @L.T("弹层宽度。MatchTriggerWidth 为 true 时忽略。", "Width of the popover. Ignored when MatchTriggerWidth is true.")
                </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="ActiveClass" Type="string?" Default="&quot;bg-accent text-accent-foreground&quot;">
                        下拉展开时应用到触发器的 CSS 类。设为 <code>null</code> 或空串即可关闭。
                        也可用来贴合所在上下文（例如侧边栏里的 <code>"bg-sidebar-accent text-sidebar-accent-foreground"</code>）。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="ActiveClass" Type="string?" Default="&quot;bg-accent text-accent-foreground&quot;">
                        CSS classes applied to the trigger when the dropdown is open. Set to <code>null</code> or empty to disable.
                        Use to match the context (e.g., <code>"bg-sidebar-accent text-sidebar-accent-foreground"</code> in sidebars).
                    </ApiParameter>
                                </text>
}
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="SearchQuery" Type="string" Default="&quot;&quot;">
                        当前的搜索词文本。支持用 <code>@@bind-SearchQuery</code> 双向绑定以响应筛选变化。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="SearchQuery" Type="string" Default="&quot;&quot;">
                        Current search query text. Supports two-way binding with <code>@@bind-SearchQuery</code> for reacting to filter changes.
                    </ApiParameter>
                                </text>
}
                <ApiParameter Name="SearchQueryChanged" Type="EventCallback&lt;string&gt;">
                    @L.T("搜索词变化时触发的回调。可用于服务端筛选或加载外部数据。", "Callback invoked when the search query changes. Use for server-side filtering or loading external data.")
                </ApiParameter>
                <ApiParameter Name="OnLoadMore" Type="EventCallback">
                    @L.T("用户滚动到下拉列表底部附近时触发的回调。用于在无限滚动场景里追加更多条目。", "Callback invoked when the user scrolls near the bottom of the dropdown list. Use to load additional items for infinite scroll scenarios.")
                </ApiParameter>
                <ApiParameter Name="IsLoading" Type="bool" Default="false">
                    @L.T("是否正在追加加载条目。为 true 时底部显示加载动画，并暂停触发 OnLoadMore 直到加载完成。", "Whether additional items are currently being loaded. Shows a spinner at the bottom and suppresses OnLoadMore until loading completes.")
                </ApiParameter>
                <ApiParameter Name="EndOfListMessage" Type="string?" Default="null">
                    @L.T("全部条目加载完毕后显示在下拉底部的消息。可根据是否还有更多条目动态设置。", "Message displayed at the bottom of the dropdown when all items have been loaded. Set dynamically based on whether more items are available.")
                </ApiParameter>
                <ApiParameter Name="ChildContent" Type="RenderFragment?">
                    @L.T("组合式模式的内容。把 ComboboxItem 作为子内容使用。", "Content for compositional mode. Use ComboboxItem components as children.")
                </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        应用到根 <code>&lt;div&gt;</code> 元素的附加 HTML 特性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        Additional HTML attributes applied to the root <code>&lt;div&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                    </ApiParameter>
                                </text>
}
            </ApiReference>

            <ApiReference ComponentName="ComboboxItem&lt;TValue&gt;">
                <ApiParameter Name="Value" Type="TValue">
                    @L.T("该条目的值。必填。", "The value of this item. Required.")
                </ApiParameter>
                <ApiParameter Name="Text" Type="string">
                    @L.T("用于筛选与触发器显示的文本。必填。", "Display text for filtering and trigger display. Required.")
                </ApiParameter>
                <ApiParameter Name="Disabled" Type="bool" Default="false">
                    @L.T("该条目是否被禁用。", "Whether this item is disabled.")
                </ApiParameter>
                <ApiParameter Name="ChildContent" Type="RenderFragment?">
                    @L.T("自定义渲染内容。为 null 时把 Text 以纯文本呈现。", "Custom content to render. When null, renders Text as plain text.")
                </ApiParameter>
                @if (L.IsChinese)
