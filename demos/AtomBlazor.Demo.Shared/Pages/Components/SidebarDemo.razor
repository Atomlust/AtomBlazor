                        </thead>
                        <tbody>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">Tooltip</code></td>
                                <td class="p-3 text-sm">string?</td>
                                <td class="p-3 text-sm">null</td>
                                <td class="p-3 text-sm">@L.T("折叠状态下显示的提示", "Tooltip shown in collapsed state")</td>
                            </tr>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">Size</code></td>
                                <td class="p-3 text-sm">SidebarMenuButtonSize</td>
                                <td class="p-3 text-sm">Default</td>
                                <td class="p-3 text-sm">@L.T("尺寸变体（Small、Default、Large）", "Size variant (Small, Default, Large)")</td>
                            </tr>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">Variant</code></td>
                                <td class="p-3 text-sm">SidebarMenuButtonVariant</td>
                                <td class="p-3 text-sm">Default</td>
                                <td class="p-3 text-sm">@L.T("样式变体（Default、Outline）", "Style variant (Default, Outline)")</td>
                            </tr>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">IsActive</code></td>
                                <td class="p-3 text-sm">bool?</td>
                                <td class="p-3 text-sm">null</td>
                                @if (L.IsChinese)
                                {
                                    <td class="p-3 text-sm">活动/选中状态。留空时由 <code class="text-sm">Href</code> 与 <code class="text-sm">Match</code> 推导。</td>
                                }
                                else
                                {
                                    <td class="p-3 text-sm">Active/selected state. Leave unset to derive it from <code class="text-sm">Href</code> and <code class="text-sm">Match</code>.</td>
                                }
                            </tr>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">AsChild</code></td>
                                <td class="p-3 text-sm">SidebarMenuButtonElement</td>
                                <td class="p-3 text-sm">Button</td>
                                <td class="p-3 text-sm">@L.T("渲染的元素（Button、Anchor）", "Element to render (Button, Anchor)")</td>
                            </tr>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">Href</code></td>
                                <td class="p-3 text-sm">string?</td>
                                <td class="p-3 text-sm">null</td>
                                @if (L.IsChinese)
                                {
                                    <td class="p-3 text-sm">导航目标。设置它会渲染一个锚点链接，并根据当前路由驱动 <code class="text-sm">IsActive</code>。</td>
                                }
                                else
                                {
                                    <td class="p-3 text-sm">Navigation target. Setting it renders an anchor and drives <code class="text-sm">IsActive</code> from the current route.</td>
                                }
                            </tr>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">Match</code></td>
                                <td class="p-3 text-sm">NavLinkMatch</td>
                                <td class="p-3 text-sm">Prefix</td>
                                @if (L.IsChinese)
                                {
                                    <td class="p-3 text-sm">活动状态下 <code class="text-sm">Href</code> 如何与路由匹配</td>
                                }
                                else
                                {
                                    <td class="p-3 text-sm">How <code class="text-sm">Href</code> is matched against the route for active state</td>
                                }
                            </tr>
                            <tr>
                                <td class="p-3"><code class="text-sm">OnClick</code></td>
                                <td class="p-3 text-sm">EventCallback&lt;MouseEventArgs&gt;</td>
                                <td class="p-3 text-sm">—</td>
                                <td class="p-3 text-sm">@L.T("点击按钮时调用", "Invoked when the button is clicked")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div>
                <h3 class="text-lg font-semibold mb-2">SidebarInset</h3>
                <p class="text-sm text-muted-foreground mb-3">@L.T("侧边栏旁边的主内容区。", "Main content area next to the sidebar.")</p>
                <div class="rounded-lg border overflow-hidden">
                    <table class="w-full">
                        <thead class="border-b bg-muted/50">
                            <tr>
                                <th class="p-3 text-left font-medium">@L.T("属性", "Prop")</th>
                                <th class="p-3 text-left font-medium">@L.T("类型", "Type")</th>
                                <th class="p-3 text-left font-medium">@L.T("默认值", "Default")</th>
                                <th class="p-3 text-left font-medium">@L.T("说明", "Description")</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">ResetScrollOnNavigation</code></td>
                                <td class="p-3 text-sm">bool</td>
                                <td class="p-3 text-sm">true</td>
                                <td class="p-3 text-sm">@L.T("路由变化时自动滚动到顶部", "Automatically scrolls to the top when the route changes")</td>
                            </tr>
                            <tr>
                                <td class="p-3"><code class="text-sm">Class</code></td>
                                <td class="p-3 text-sm">string?</td>
                                <td class="p-3 text-sm">null</td>
                                <td class="p-3 text-sm">@L.T("额外的 CSS 类", "Additional CSS classes")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        <ApiReference Since="v4" ComponentName="Sidebar pill navigation">
            <ApiParameter Name="SidebarProvider.CollapsedMode" Type="SidebarCollapsedMode" Default="Icon">@L.T("胶囊模式会完全隐藏折叠后的侧边栏，请将 SidebarPillNav 与之并列放置。现有的桌面/移动端打开绑定与快捷键行为保持不变。", "Pill completely hides the collapsed sidebar. Place SidebarPillNav alongside it. Existing desktop/mobile open bindings and shortcut behavior are retained.")</ApiParameter>
            <ApiParameter Name="PillNav.ChildContent / TrailingContent" Type="RenderFragment?">@L.T("导航项与可选的尾部操作。", "Navigation items and optional trailing actions.")</ApiParameter>
            <ApiParameter Name="PillNav.Fixed / AnimatedIndicator / AriaLabel" Type="bool / bool / string?" Default="true / true / Primary navigation">@L.T("视口定位、移动的活动指示器与地标名称。Fixed=false 需要一个已定位的祖先元素。", "Viewport placement, moving active indicator and landmark name. Fixed=false requires a positioned ancestor.")</ApiParameter>
            <ApiParameter Name="PillNavItem.Label / ChildContent / Href / Match" Type="string / RenderFragment / string? / NavLinkMatch" Default="Prefix">@L.T("可访问名称、图标与可选的原生链接。除非提供 IsActive，否则活动状态跟随 URL。", "Accessible name, icon and optional native link. Active state follows the URL unless IsActive is supplied.")</ApiParameter>
            <ApiParameter Name="PillNavItem.IsActive / Disabled / OnClick / Class" Type="bool? / bool / EventCallback&lt;MouseEventArgs&gt; / string?">@L.T("显式的活动状态、禁用状态、激活回调与 CSS 类。", "Explicit active state, disabled state, activation callback and classes.")</ApiParameter>
            <ApiParameter Name="PillInset.ChildContent / ExpandedClass / CollapsedClass / Class" Type="RenderFragment / string?">@L.T("在胶囊导航处于活动状态时预留顶部空间；可为每种状态自定义。PillNav 与 PillInset 也接受 AdditionalAttributes。", "Reserves top space while pill navigation is active; customization for each state. PillNav and PillInset also accept AdditionalAttributes.")</ApiParameter>
        </ApiReference>

        <ApiReference Since="v4" ComponentName="SidebarSelectionIndicator">
            <ApiParameter Name="SidebarSelectionIndicator.FollowHover / Duration / Class" Type="bool / int / string?" Default="false / 200 / null">@L.T("用于普通侧边栏菜单的可复用选中指示器。将其置于菜单之前、放在相对定位的包裹容器中，并把前景项设为相对定位。遵循减弱动效。", "Reusable selection indicator for normal sidebar menus. Place before the menu in a relative wrapper and position foreground items relative. Honors reduced motion.")</ApiParameter>
        </ApiReference>
        </div>
    </div>

    <LocalizationSection
        Description="@(L.T("侧边栏切换按钮的 aria 标签可配置。", "The sidebar toggle button aria label is configurable."))"
        Labels="@(new LocalizationSection.LabelInfo[]
        {
            new("ToggleSidebar", "Toggle Sidebar", L.T("侧边栏触发按钮/轨道按钮的 aria 标签。", "Aria label for the sidebar trigger/rail button")),
        })"
        CodeExample="@(@"builder.Services.AddAtomBlazorComponents(localizer =>
{
    localizer.Set(""Sidebar.ToggleSidebar"", ""Seitenleiste umschalten"");
});")" />
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    private string indicatorPage = "Overview";
    private bool pillOpen = true;
    private string pillPage = "Overview";
    private bool isBasicCollapsible = true;
    private bool _controlledOpen = true;
    private bool shortcutEnabled = true;
    private string selectedVersion = "v1.0.1";

    private string GetRandomIcon(int index)
    {
        var icons = new[] {
            "house", "file", "folder", "users", "settings", "search",
            "bell", "calendar", "mail", "star", "bookmark", "tag",
            "database", "server", "cloud", "package", "square", "table",
            "list", "inbox", "archive", "trash", "download", "upload",
            "share", "copy", "pencil", "filter", "arrow-up-down", "rotate-cw"
        };
        return icons[index % icons.Length];
    }
}
