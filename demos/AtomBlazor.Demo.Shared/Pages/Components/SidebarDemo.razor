                <button
                    @onclick="() => shortcutEnabled = false"
                    class="@(!shortcutEnabled ? "bg-primary text-primary-foreground" : "bg-background text-foreground") px-3 py-1.5 rounded-md text-sm font-medium transition-colors hover:opacity-90">
                    false
                </button>
            </div>
            <span class="text-xs text-muted-foreground ml-auto">@L.T("切换后按 Ctrl/Cmd + B", "Toggle, then press Ctrl/Cmd + B")</span>
        </div>

        <div class="border rounded-lg p-6 bg-background">
            <div class="h-[600px] w-full border rounded-lg overflow-hidden bg-background">
                <SidebarProvider EnableToggleShortcut="@shortcutEnabled" HeightClass="h-full">
