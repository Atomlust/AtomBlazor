@page "/components/sidebar"
@using AtomBlazor.Primitives.Services
@using AtomBlazor.Icons

<PageTitle>@L.T("侧边栏 - Atom BlazorUI", "Sidebar Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">@L.T("侧边栏组件", "Sidebar Component")</h1>
        <p class="text-xl text-muted-foreground">
            @L.T("一个可组合、可主题化、可自定义的侧边栏组件。", "A composable, themeable and customizable sidebar component.")
        </p>
        </div>
    </div>

    <div class="space-y-6">
    </div>

    <!-- Features Section -->
    <div class="space-y-4">
        <h2 class="text-2xl font-semibold border-b pb-2">@L.T("特性", "Features")</h2>
        <ul class="list-disc list-inside space-y-2 text-muted-foreground">
            <li>@L.T("响应式设计——移动端以 Sheet 遮罩呈现，桌面端为常驻侧边栏", "Responsive design - Sheet overlay on mobile, persistent sidebar on desktop")</li>
            <li>@L.T("可折叠，支持仅图标模式或浮动胶囊导航", "Collapsible with icon-only mode or floating pill navigation")</li>
            <li>@L.T("带动画的选中指示器，并遵循减弱动效偏好", "Animated selection indicators with reduced-motion support")</li>
            <li>@L.T("三种变体：Sidebar（默认）、Floating 与 Inset", "Three variants: Sidebar (default), Floating, and Inset")</li>
            <li>@L.T("通过 Cookie 持久化状态", "State persistence via cookies")</li>
            <li>@L.T("键盘快捷键（Ctrl/Cmd + B 切换，可通过 EnableToggleShortcut 关闭）", "Keyboard shortcuts (Ctrl/Cmd + B to toggle, opt-out via EnableToggleShortcut)")</li>
            <li>@L.T("折叠状态下自动显示提示", "Automatic tooltips in collapsed state")</li>
            <li>@L.T("灵活的组合方式，支持菜单分组、子菜单与操作", "Flexible composition with menu groups, submenus, and actions")</li>
            <li>@L.T("完全兼容 shadcn/ui", "Full shadcn/ui compatibility")</li>
        </ul>
    </div>

    <!-- Installation Section -->
    <div class="space-y-4">
        <h2 class="text-2xl font-semibold border-b pb-2">@L.T("安装", "Installation")</h2>
        <div class="bg-muted p-4 rounded-lg">
            <p class="text-sm text-muted-foreground mb-2">@L.T("侧边栏组件需要 Sheet 原语来实现移动端功能。", "The sidebar component requires the Sheet primitive for mobile functionality.")</p>
            <p class="text-sm text-muted-foreground">@L.T("把 SidebarProvider 加到你的 MainLayout.razor，即可在整个应用中启用侧边栏功能。", "Add the SidebarProvider to your MainLayout.razor to enable sidebar functionality throughout your app.")</p>
        </div>
    </div>

    <!-- Collapse Mode Toggle -->
    <div class="space-y-4">
        <h2 class="text-2xl font-semibold border-b pb-2">@L.T("菜单折叠模式", "Menu Collapse Mode")</h2>
        <div class="flex items-center gap-4 p-4 bg-muted/50 rounded-lg">
            <span class="text-sm font-medium">@L.T("折叠模式：", "Collapse Mode:")</span>
            <div class="flex items-center gap-2">
                <button
                    @onclick="() => isBasicCollapsible = true"
                    class="@(isBasicCollapsible ? "bg-primary text-primary-foreground" : "bg-background text-foreground") px-3 py-1.5 rounded-md text-sm font-medium transition-colors hover:opacity-90">
                    @L.T("收缩（仅图标）", "Shrink (Icon-only)")
                </button>
                <button
                    @onclick="() => isBasicCollapsible = false"
                    class="@(!isBasicCollapsible ? "bg-primary text-primary-foreground" : "bg-background text-foreground") px-3 py-1.5 rounded-md text-sm font-medium transition-colors hover:opacity-90">
                    @L.T("完全隐藏", "Hide Completely")
                </button>
            </div>
            <span class="text-xs text-muted-foreground ml-auto">@L.T("点击触发按钮以查看差异", "Click the trigger button to see the difference")</span>
        </div>
    </div>

    <!-- Basic Example -->
    <div class="space-y-4">
        <h2 class="text-2xl font-semibold border-b pb-2">@L.T("基础侧边栏", "Basic Sidebar")</h2>
        <p class="text-muted-foreground">@L.T("一个带菜单项的简单侧边栏。", "A simple sidebar with menu items.")</p>

        <!-- Collapse Mode Toggle -->


        <div class="border rounded-lg p-6 bg-background">
            <div class="h-[600px] w-full border rounded-lg overflow-hidden bg-background">
                <SidebarProvider CookieKey="sidebar:demo-basic" HeightClass="h-full">
                    <div class="flex h-full w-full">
                        <Sidebar Collapsible="@isBasicCollapsible">
                            <SidebarHeader>
                                <SidebarHeaderContent>
                                    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-primary-foreground">
                                        <LucideIcon Name="command" Size="16" />
                                    </div>
                                    <SidebarHeaderInfo>
                                        <span class="truncate font-semibold">Acme Inc</span>
                                        <span class="truncate text-xs text-muted-foreground">@L.T("企业版", "Enterprise")</span>
                                    </SidebarHeaderInfo>
                                </SidebarHeaderContent>
                            </SidebarHeader>

                            <SidebarContent>
                                <SidebarMenu>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton Tooltip="@(L.T("首页", "Home"))">
                                            <LucideIcon Name="house" Size="16" />
                                            <span>@L.T("首页", "Home")</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton Tooltip="@(L.T("收件箱", "Inbox"))" IsActive="true">
                                            <LucideIcon Name="inbox" Size="16" />
                                            <span>@L.T("收件箱", "Inbox")</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton Tooltip="@(L.T("日历", "Calendar"))">
                                            <LucideIcon Name="calendar" Size="16" />
                                            <span>@L.T("日历", "Calendar")</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton Tooltip="@(L.T("搜索", "Search"))">
                                            <LucideIcon Name="search" Size="16" />
                                            <span>@L.T("搜索", "Search")</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton Tooltip="@(L.T("设置", "Settings"))">
                                            <LucideIcon Name="settings" Size="16" />
                                            <span>@L.T("设置", "Settings")</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                </SidebarMenu>
                            </SidebarContent>

                            <SidebarFooter>
                                <SidebarMenu>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton Tooltip="@(L.T("用户资料", "User Profile"))">
                                            <LucideIcon Name="user" Size="16" />
                                            <span>John Doe</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                </SidebarMenu>
                            </SidebarFooter>
                        </Sidebar>

                        <SidebarInset>
                            <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                                <SidebarTrigger />
                                <h1 class="text-lg font-semibold">@L.T("仪表盘", "Dashboard")</h1>
                            </header>
                            <div class="flex flex-1 flex-col gap-4 p-4">
                                <div class="grid auto-rows-min gap-4 md:grid-cols-3">
                                    <div class="aspect-video rounded-xl bg-muted/50"></div>
                                    <div class="aspect-video rounded-xl bg-muted/50"></div>
                                    <div class="aspect-video rounded-xl bg-muted/50"></div>
                                </div>
                                <div class="min-h-[100vh] flex-1 rounded-xl bg-muted/50 md:min-h-min"></div>
                            </div>
                        </SidebarInset>
                    </div>
                </SidebarProvider>
            </div>
        </div>

        <CodeBlock Source="Components/Sidebar/basic.txt" />
    </div>

    <!-- With Navigation Example -->
    <div class="space-y-4">
        <h2 class="text-2xl font-semibold border-b pb-2">@L.T("带导航", "With Navigation")</h2>
        <p class="text-muted-foreground">@L.T("使用 Href 属性导航到不同页面的菜单项。", "Menu items that navigate to different pages using Href property.")</p>

        <div class="border rounded-lg p-6 bg-background">
            <div class="h-[600px] w-full border rounded-lg overflow-hidden bg-background">
                <SidebarProvider CookieKey="sidebar:demo-navigation" HeightClass="h-full">
                    <div class="flex h-full w-full">
                        <Sidebar Collapsible="@isBasicCollapsible">
                            <SidebarHeader>
                                <SidebarHeaderContent>
                                    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-primary-foreground">
                                        <LucideIcon Name="compass" Size="16" />
                                    </div>
                                    <SidebarHeaderInfo>
                                        <span class="truncate font-semibold">AtomBlazor Demo</span>
                                        <span class="truncate text-xs text-muted-foreground">@L.T("组件", "Components")</span>
                                    </SidebarHeaderInfo>
                                </SidebarHeaderContent>
                            </SidebarHeader>

                            <SidebarContent>
                                <SidebarMenu>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton Href="/" Match="NavLinkMatch.All" Tooltip="@(L.T("首页", "Home"))">
                                            <LucideIcon Name="house" Size="16" />
                                            <span>@L.T("首页", "Home")</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton Href="/components/sidebar" Match="NavLinkMatch.All" Tooltip="@(L.T("侧边栏", "Sidebar"))">
                                            <LucideIcon Name="panel-left" Size="16" />
                                            <span>@L.T("侧边栏", "Sidebar")</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton Href="/primitives" Match="NavLinkMatch.Prefix" Tooltip="@(L.T("原语", "Primitives"))">
                                            <LucideIcon Name="box" Size="16" />
                                            <span>@L.T("原语", "Primitives")</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton Href="/components" Match="NavLinkMatch.Prefix" Tooltip="@(L.T("组件", "Components"))">
                                            <LucideIcon Name="layers" Size="16" />
                                            <span>@L.T("组件", "Components")</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                </SidebarMenu>
                            </SidebarContent>

                            <SidebarFooter>
                                <SidebarMenu>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton Tooltip="@(L.T("在 GitHub 查看", "GitHub"))">
                                            <LucideIcon Name="github" Size="16" />
                                            <span>@L.T("在 GitHub 查看", "View on GitHub")</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                </SidebarMenu>
                            </SidebarFooter>
                        </Sidebar>

                        <SidebarInset>
                            <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                                <SidebarTrigger />
                                <h1 class="text-lg font-semibold">@L.T("导航示例", "Navigation Demo")</h1>
                            </header>
                            <div class="flex flex-1 flex-col gap-4 p-4">
                                <div class="rounded-xl bg-muted/50 p-4 space-y-3">
                                    @if (L.IsChinese)
                                    {
                                        <p class="text-sm text-muted-foreground">
                                            这个示例展示了使用 <code class="bg-muted px-1.5 py-0.5 rounded">Href</code> 属性进行导航的菜单按钮。
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="text-sm text-muted-foreground">
                                            This demo shows menu buttons that navigate using the <code class="bg-muted px-1.5 py-0.5 rounded">Href</code> property.
                                        </p>
                                    }
                                    <div class="text-sm">
                                        <p class="font-semibold mb-2">@L.T("关键特性：", "Key Features:")</p>
                                        <ul class="list-disc list-inside space-y-1 text-muted-foreground ml-2">
                                            <li>@L.T("提供 Href 时自动渲染 NavLink", "Automatic NavLink rendering when Href is provided")</li>
                                            <li>@L.T("基于当前路由的活动状态检测", "Active state detection based on current route")</li>
                                            <li>@L.T("Match 参数控制 URL 的匹配方式（All 或 Prefix）", "Match parameter controls how URLs are matched (All or Prefix)")</li>
                                            <li>@L.T("无需设置 AsChild——它是自动的！", "No need to set AsChild - it's automatic!")</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </SidebarInset>
                    </div>
                </SidebarProvider>
            </div>
        </div>

        <CodeBlock Source="Components/Sidebar/with-navigation.txt" />
    </div>

    <!-- With Groups Example -->
    <div class="space-y-4">
        <h2 class="text-2xl font-semibold border-b pb-2">@L.T("带菜单分组", "With Menu Groups")</h2>
        <p class="text-muted-foreground">@L.T("将菜单项组织成逻辑分组。", "Organize menu items into logical groups.")</p>

        <div class="border rounded-lg p-6 bg-background">
            <div class="h-[600px] w-full border rounded-lg overflow-hidden bg-background">
                <SidebarProvider CookieKey="sidebar:demo-groups" HeightClass="h-full">
                    <div class="flex h-full w-full">
                        <Sidebar Collapsible="@isBasicCollapsible">
                            <SidebarHeader>
                                <SidebarHeaderContent>
                                    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-primary-foreground">
                                        <LucideIcon Name="layers" Size="16" />
                                    </div>
                                    <SidebarHeaderInfo>
                                        <span class="truncate font-semibold">@L.T("我的应用", "My Application")</span>
                                        <span class="truncate text-xs text-muted-foreground">v1.0.0</span>
                                    </SidebarHeaderInfo>
                                </SidebarHeaderContent>
                            </SidebarHeader>

                            <SidebarContent>
                                <SidebarGroup>
                                    <SidebarGroupLabel>@L.T("平台", "Platform")</SidebarGroupLabel>
                                    <SidebarGroupContent>
                                        <SidebarMenu>
                                            <SidebarMenuItem>
                                                <SidebarMenuButton Tooltip="@(L.T("仪表盘", "Dashboard"))">
                                                    <LucideIcon Name="layout-dashboard" Size="16" />
                                                    <span>@L.T("仪表盘", "Dashboard")</span>
                                                </SidebarMenuButton>
                                            </SidebarMenuItem>
                                            <SidebarMenuItem>
                                                <SidebarMenuButton Tooltip="@(L.T("项目", "Projects"))" IsActive="true">
                                                    <LucideIcon Name="folder" Size="16" />
                                                    <span>@L.T("项目", "Projects")</span>
                                                </SidebarMenuButton>
                                            </SidebarMenuItem>
                                            <SidebarMenuItem>
                                                <SidebarMenuButton Tooltip="@(L.T("任务", "Tasks"))">
                                                    <LucideIcon Name="square-check" Size="16" />
                                                    <span>@L.T("任务", "Tasks")</span>
                                                </SidebarMenuButton>
                                            </SidebarMenuItem>
                                        </SidebarMenu>
                                    </SidebarGroupContent>
                                </SidebarGroup>

                                <SidebarSeparator />

                                <SidebarGroup>
                                    <SidebarGroupLabel>@L.T("设置", "Settings")</SidebarGroupLabel>
                                    <SidebarGroupContent>
                                        <SidebarMenu>
                                            <SidebarMenuItem>
                                                <SidebarMenuButton Tooltip="@(L.T("个人资料", "Profile"))">
                                                    <LucideIcon Name="user" Size="16" />
                                                    <span>@L.T("个人资料", "Profile")</span>
                                                </SidebarMenuButton>
                                            </SidebarMenuItem>
                                            <SidebarMenuItem>
                                                <SidebarMenuButton Tooltip="@(L.T("偏好设置", "Preferences"))">
                                                    <LucideIcon Name="settings" Size="16" />
                                                    <span>@L.T("偏好设置", "Preferences")</span>
                                                </SidebarMenuButton>
                                            </SidebarMenuItem>
                                        </SidebarMenu>
                                    </SidebarGroupContent>
                                </SidebarGroup>
                            </SidebarContent>

                            <SidebarFooter>
                                <SidebarMenu>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton Tooltip="@(L.T("帮助", "Help"))">
                                            <LucideIcon Name="life-buoy" Size="16" />
                                            <span>@L.T("帮助与支持", "Help & Support")</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                </SidebarMenu>
                            </SidebarFooter>
                        </Sidebar>

                        <SidebarInset>
                            <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                                <SidebarTrigger />
                                <h1 class="text-lg font-semibold">@L.T("项目", "Projects")</h1>
                            </header>
                            <div class="flex flex-1 flex-col gap-4 p-4">
                                <div class="rounded-xl bg-muted/50 p-4">
                                    <p class="text-sm text-muted-foreground">@L.T("本示例展示带分隔线的菜单分组。", "This example shows menu groups with separators.")</p>
                                </div>
                            </div>
                        </SidebarInset>
                    </div>
                </SidebarProvider>
            </div>
        </div>

        <CodeBlock Source="Components/Sidebar/with-groups.txt" />
    </div>

    <!-- With Submenus Example -->
    <div class="space-y-4">
        <h2 class="text-2xl font-semibold border-b pb-2">@L.T("带子菜单", "With Submenus")</h2>
        <p class="text-muted-foreground">@L.T("带子菜单项的嵌套导航。", "Nested navigation with submenu items.")</p>

        <div class="border rounded-lg p-6 bg-background">
            <div class="h-[600px] w-full border rounded-lg overflow-hidden bg-background">
                <SidebarProvider CookieKey="sidebar:demo-submenus" HeightClass="h-full">
                    <div class="flex h-full w-full">
                        <Sidebar Collapsible="@isBasicCollapsible">
                            <SidebarHeader>
                                <SidebarHeaderContent>
                                    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-primary-foreground">
                                        <LucideIcon Name="building" Size="16" />
                                    </div>
                                    <SidebarHeaderInfo>
                                        <span class="truncate font-semibold">@L.T("公司门户", "Company Portal")</span>
                                    </SidebarHeaderInfo>
                                </SidebarHeaderContent>
                            </SidebarHeader>

                            <SidebarContent>
                                <SidebarMenu>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton Tooltip="@(L.T("首页", "Home"))">
                                            <LucideIcon Name="house" Size="16" />
                                            <span>@L.T("首页", "Home")</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>

                                    <SidebarMenuItem>
                                        <SidebarMenuButton Tooltip="@(L.T("团队", "Team"))">
                                            <LucideIcon Name="users" Size="16" />
                                            <span>@L.T("团队", "Team")</span>
                                        </SidebarMenuButton>
                                        <SidebarMenuSub>
                                            <SidebarMenuSubItem>
                                                <SidebarMenuSubButton>
                                                    <span>@L.T("工程", "Engineering")</span>
                                                </SidebarMenuSubButton>
                                            </SidebarMenuSubItem>
                                            <SidebarMenuSubItem>
                                                <SidebarMenuSubButton>
                                                    <span>@L.T("设计", "Design")</span>
                                                </SidebarMenuSubButton>
                                            </SidebarMenuSubItem>
                                            <SidebarMenuSubItem>
                                                <SidebarMenuSubButton>
                                                    <span>@L.T("市场", "Marketing")</span>
                                                </SidebarMenuSubButton>
                                            </SidebarMenuSubItem>
                                        </SidebarMenuSub>
                                    </SidebarMenuItem>

                                    <SidebarMenuItem>
                                        <SidebarMenuButton Tooltip="@(L.T("项目", "Projects"))">
                                            <LucideIcon Name="folder" Size="16" />
                                            <span>@L.T("项目", "Projects")</span>
                                        </SidebarMenuButton>
                                        <SidebarMenuSub>
                                            <SidebarMenuSubItem>
                                                <SidebarMenuSubButton>
                                                    <span>Project Alpha</span>
                                                </SidebarMenuSubButton>
                                            </SidebarMenuSubItem>
                                            <SidebarMenuSubItem>
                                                <SidebarMenuSubButton>
                                                    <span>Project Beta</span>
                                                </SidebarMenuSubButton>
                                            </SidebarMenuSubItem>
                                        </SidebarMenuSub>
                                    </SidebarMenuItem>
                                </SidebarMenu>
                            </SidebarContent>
                        </Sidebar>

                        <SidebarInset>
                            <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
                                <SidebarTrigger />
                                <h1 class="text-lg font-semibold">@L.T("团队门户", "Team Portal")</h1>
                            </header>
                            <div class="flex flex-1 flex-col gap-4 p-4">
                                <div class="rounded-xl bg-muted/50 p-4">
                                    <p class="text-sm text-muted-foreground">@L.T("点击 Team 或 Projects 查看子菜单项。", "Click on Team or Projects to see submenu items.")</p>
                                </div>
                            </div>
                        </SidebarInset>
                    </div>
                </SidebarProvider>
            </div>
        </div>

        <CodeBlock Source="Components/Sidebar/with-submenus.txt" />
    </div>

    <!-- Floating Variant Example -->
    <div class="space-y-4">
        <h2 class="text-2xl font-semibold border-b pb-2">@L.T("浮动变体", "Floating Variant")</h2>
        <p class="text-muted-foreground">@L.T("具有浮动外观与圆角的侧边栏。", "Sidebar with floating appearance and rounded corners.")</p>

        <div class="border rounded-lg p-6 bg-background">
            <div class="relative h-[600px] w-full border rounded-lg overflow-hidden bg-background">
                <SidebarProvider Variant="SidebarVariant.Floating" CookieKey="sidebar:demo-floating" HeightClass="h-full">
                    <div class="flex h-full w-full relative">
                        <Sidebar Collapsible="@isBasicCollapsible" Class="!absolute !top-2 !bottom-2 !left-2 !right-2 !z-50">
                            <SidebarHeader>
                                <SidebarHeaderContent>
                                    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-primary-foreground">
                                        <LucideIcon Name="zap" Size="16" />
                                    </div>
                                    <SidebarHeaderInfo>
                                        <span class="truncate font-semibold">Floating UI</span>
                                    </SidebarHeaderInfo>
                                </SidebarHeaderContent>
                            </SidebarHeader>

                            <SidebarContent>
                                <SidebarMenu>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton Tooltip="@(L.T("仪表盘", "Dashboard"))">
                                            <LucideIcon Name="layout-dashboard" Size="16" />
                                            <span>@L.T("仪表盘", "Dashboard")</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton Tooltip="@(L.T("分析", "Analytics"))">
                                            <LucideIcon Name="line-chart" Size="16" />
                                            <span>@L.T("分析", "Analytics")</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton Tooltip="@(L.T("报表", "Reports"))">
                                            <LucideIcon Name="file-text" Size="16" />
                                            <span>@L.T("报表", "Reports")</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                </SidebarMenu>
                            </SidebarContent>
                        </Sidebar>

