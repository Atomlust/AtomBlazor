    <!-- API Reference -->
    <div class="space-y-4">
        <h2 class="text-2xl font-semibold border-b pb-2">@L.T("控制侧边栏", "Controlling the Sidebar")</h2>
        @if (L.IsChinese)
        {
            <p class="text-sm text-muted-foreground">
                打开状态位于 <code class="text-xs bg-muted px-1 py-0.5 rounded">SidebarProvider</code> 上，而非
                <code class="text-xs bg-muted px-1 py-0.5 rounded">Sidebar</code> 上。不去管它时，provider 自己拥有该状态——
                <code class="text-xs bg-muted px-1 py-0.5 rounded">DefaultOpen</code> 用于设定初值，
                <code class="text-xs bg-muted px-1 py-0.5 rounded">CookieKey</code> 用于持久化，
                <code class="text-xs bg-muted px-1 py-0.5 rounded">SidebarTrigger</code> 用于切换。绑定
                <code class="text-xs bg-muted px-1 py-0.5 rounded">@@bind-Open</code> 后，你的值就成为唯一来源，
                与 Dialog、Sheet、Popover 及库中其余部分相同的受控/非受控模式。
            </p>
        }
        else
        {
            <p class="text-sm text-muted-foreground">
                Open state lives on <code class="text-xs bg-muted px-1 py-0.5 rounded">SidebarProvider</code>, not on
                <code class="text-xs bg-muted px-1 py-0.5 rounded">Sidebar</code>. Leave it alone and the provider owns it —
                <code class="text-xs bg-muted px-1 py-0.5 rounded">DefaultOpen</code> seeds it,
                <code class="text-xs bg-muted px-1 py-0.5 rounded">CookieKey</code> persists it, and
                <code class="text-xs bg-muted px-1 py-0.5 rounded">SidebarTrigger</code> toggles it. Bind
                <code class="text-xs bg-muted px-1 py-0.5 rounded">@@bind-Open</code> and your value becomes the source of truth
                instead, the same controlled/uncontrolled pattern as Dialog, Sheet, Popover and the rest of the library.
            </p>
        }
        @if (L.IsChinese)
        {
            <p class="text-sm text-muted-foreground">
                <strong>绑定 <code class="text-xs bg-muted px-1 py-0.5 rounded">Open</code> 会关闭 Cookie 持久化</strong>
                ——包括启动时的读取与变化时的写入。当状态由组件外部持有时，重新加载时 Cookie 会与你的绑定值相互竞争，而非恢复它，
                因此若需要它得以保留，请自行持久化。
            </p>
        }
        else
        {
            <p class="text-sm text-muted-foreground">
                <strong>Binding <code class="text-xs bg-muted px-1 py-0.5 rounded">Open</code> turns cookie persistence off</strong>
                — both the read on startup and the write on change. With the state owned outside the component, a cookie would
                compete with your bound value on reload rather than restore it, so persist it yourself if you need it to survive.
            </p>
        }
        @if (L.IsChinese)
        {
            <p class="text-sm text-muted-foreground">
                <code class="text-xs bg-muted px-1 py-0.5 rounded">Open</code> 是<em>桌面端</em>状态，与
                <code class="text-xs bg-muted px-1 py-0.5 rounded">DefaultOpen</code> 对应。在移动端断点以下，侧边栏是带有自己状态的抽屉——
                若两者都需要，也请绑定 <code class="text-xs bg-muted px-1 py-0.5 rounded">@@bind-OpenMobile</code>；
                而当仅仅是从级联的
                <code class="text-xs bg-muted px-1 py-0.5 rounded">SidebarContext</code> 中<em>读取</em>时，优先用
                <code class="text-xs bg-muted px-1 py-0.5 rounded">IsOpen</code> 而非
                <code class="text-xs bg-muted px-1 py-0.5 rounded">Open</code>：它会解析为当前视口适用的那个值，因此在两端都保持正确。
            </p>
        }
        else
        {
            <p class="text-sm text-muted-foreground">
                <code class="text-xs bg-muted px-1 py-0.5 rounded">Open</code> is the <em>desktop</em> state, matching
                <code class="text-xs bg-muted px-1 py-0.5 rounded">DefaultOpen</code>. Below the mobile breakpoint the sidebar is a
                drawer with its own state — bind <code class="text-xs bg-muted px-1 py-0.5 rounded">@@bind-OpenMobile</code> as well
                if you need both, and when merely <em>reading</em> from the cascaded
                <code class="text-xs bg-muted px-1 py-0.5 rounded">SidebarContext</code>, prefer
                <code class="text-xs bg-muted px-1 py-0.5 rounded">IsOpen</code> over
                <code class="text-xs bg-muted px-1 py-0.5 rounded">Open</code>: it resolves to whichever applies to the current
                viewport, so it stays correct on both.
            </p>
        }

        <div class="flex items-center gap-4 p-4 bg-muted/50 rounded-lg">
            <span class="text-sm font-medium">@@bind-Open:</span>
            <div class="flex items-center gap-2">
                <button type="button"
                        @onclick="() => _controlledOpen = true"
                        class="@(_controlledOpen ? "bg-primary text-primary-foreground" : "bg-background text-foreground") px-3 py-1.5 rounded-md text-sm font-medium transition-colors hover:opacity-90">
                    @L.T("打开", "Open")
                </button>
                <button type="button"
                        @onclick="() => _controlledOpen = false"
                        class="@(!_controlledOpen ? "bg-primary text-primary-foreground" : "bg-background text-foreground") px-3 py-1.5 rounded-md text-sm font-medium transition-colors hover:opacity-90">
                    @L.T("关闭", "Closed")
                </button>
            </div>
            @if (L.IsChinese)
            {
                <span class="text-xs text-muted-foreground ml-auto">绑定值：<code class="text-xs">@_controlledOpen</code> ——侧边栏自身的触发按钮也会更新它</span>
            }
            else
            {
                <span class="text-xs text-muted-foreground ml-auto">Bound value: <code class="text-xs">@_controlledOpen</code> — the sidebar's own trigger updates it too</span>
            }
        </div>

        <div class="border rounded-lg overflow-hidden h-[300px]">
            <SidebarProvider @bind-Open="_controlledOpen" HeightClass="h-full" CookieKey="@null">
                <Sidebar>
                    <SidebarContent>
                        <SidebarGroup>
                            <SidebarGroupLabel>@L.T("受控", "Controlled")</SidebarGroupLabel>
                            <SidebarGroupContent>
                                <SidebarMenu>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton Tooltip="@(L.T("首页", "Home"))">
                                            <LucideIcon Name="house" Size="16" />
                                            <span>@L.T("首页", "Home")</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton Tooltip="@(L.T("设置", "Settings"))">
                                            <LucideIcon Name="settings" Size="16" />
                                            <span>@L.T("设置", "Settings")</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                </SidebarMenu>
                            </SidebarGroupContent>
                        </SidebarGroup>
                    </SidebarContent>
                </Sidebar>
                <SidebarInset>
                    <div class="p-4 space-y-2">
                        <SidebarTrigger />
                        @if (L.IsChinese)
                        {
                            <p class="text-sm text-muted-foreground">
                                从两侧任意一处切换——上方按钮设置绑定值，触发按钮引发
                                <code class="text-xs">OpenChanged</code>，两者保持同步。
                            </p>
                        }
                        else
                        {
                            <p class="text-sm text-muted-foreground">
                                Toggle from either side — the buttons above set the bound value, the trigger raises
                                <code class="text-xs">OpenChanged</code>, and both stay in sync.
                            </p>
                        }
                    </div>
                </SidebarInset>
            </SidebarProvider>
        </div>

        <CodeBlock Source="Components/Sidebar/programmatic-control.txt" />
    </div>

    <AccessibilityList>
            <AriaAttributes>
                <AccessibilityItem>
                    @L.T("响应式设计，移动端以 Sheet 遮罩呈现、桌面端为常驻侧边栏。", "Responsive design with Sheet overlay on mobile and persistent sidebar on desktop.")
                </AccessibilityItem>
                <AccessibilityItem>
                    @L.T("可折叠，支持仅图标模式，折叠状态下自动显示提示。", "Collapsible with icon-only mode and automatic tooltips in collapsed state.")
                </AccessibilityItem>
                <AccessibilityItem>
                    @L.T("通过 Cookie 持久化状态，记住用户的侧边栏偏好。", "State persistence via cookies to remember user's sidebar preference.")
                </AccessibilityItem>
                        <AccessibilityItem>@L.T("胶囊导航使用带标签的链接或按钮，并以 aria-current 标记当前页面。选中指示器为装饰性元素并遵循减弱动效。", "Pill navigation uses labelled links or buttons and marks the active page with aria-current. Selection indicators are decorative and respect reduced motion.")</AccessibilityItem>
        </AriaAttributes>
            <KeyboardNavigation>
                @if (L.IsChinese)
                {
                    <KeyboardShortcutItem Description="切换侧边栏开关（用 EnableToggleShortcut=&quot;false&quot; 禁用）">
                        <Kbd>Ctrl+B</Kbd> / <Kbd>Cmd+B</Kbd>
                    </KeyboardShortcutItem>
                }
                else
                {
                    <KeyboardShortcutItem Description="Toggle sidebar open/closed (disable with EnableToggleShortcut=&quot;false&quot;)">
                        <Kbd>Ctrl+B</Kbd> / <Kbd>Cmd+B</Kbd>
                    </KeyboardShortcutItem>
                }
            </KeyboardNavigation>
        </AccessibilityList>

    <div class="space-y-4">
        <h2 class="text-2xl font-semibold border-b pb-2">@L.T("API 参考", "API Reference")</h2>

        <div class="space-y-6">
            <div>
                <h3 class="text-lg font-semibold mb-2">SidebarProvider</h3>
                <p class="text-sm text-muted-foreground mb-3">@L.T("管理侧边栏状态的根 provider 组件。", "The root provider component that manages sidebar state.")</p>
                <div class="rounded-lg border overflow-hidden">
                    <table class="w-full">
                        <thead class="border-b bg-muted/50">
                            <tr>
                                <th class="p-3 text-left font-medium">@L.T("属性", "Prop")</th>
                                <th class="p-3 text-left font-medium">@L.T("类型", "Type")</th>
                                <th class="p-3 text-left font-medium">@L.T("默认值", "Default")</th>
                                <th class="p-3 text-left font-medium">@L.T("说明", "Description")</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">DefaultOpen</code></td>
                                <td class="p-3 text-sm">bool</td>
                                <td class="p-3 text-sm">true</td>
                                @if (L.IsChinese)
                                {
                                    <td class="p-3 text-sm">初始桌面打开状态，用于非受控用法；绑定 <code class="text-sm">Open</code> 时被忽略。</td>
                                }
                                else
                                {
                                    <td class="p-3 text-sm">Initial desktop open state, for uncontrolled usage. Ignored when <code class="text-sm">Open</code> is bound.</td>
                                }
                            </tr>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">Open</code></td>
                                <td class="p-3 text-sm">bool?</td>
                                <td class="p-3 text-sm">null</td>
                                @if (L.IsChinese)
                                {
                                    <td class="p-3 text-sm">桌面端打开状态，用于配合 <code class="text-sm">@@bind-Open</code> 的受控用法。留作 null 则由 provider 自行管理状态。绑定它会关闭 Cookie 持久化——见下文。</td>
                                }
                                else
                                {
                                    <td class="p-3 text-sm">Desktop open state, for controlled usage with <code class="text-sm">@@bind-Open</code>. Leave null and the provider owns the state. Binding it turns cookie persistence off — see below.</td>
                                }
                            </tr>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">OpenChanged</code></td>
                                <td class="p-3 text-sm">EventCallback&lt;bool&gt;</td>
                                <td class="p-3 text-sm">—</td>
                                @if (L.IsChinese)
                                {
                                    <td class="p-3 text-sm">当桌面端状态改变时触发，来源可能是触发按钮、轨道、键盘快捷键或 <code class="text-sm">SetOpen</code></td>
                                }
                                else
                                {
                                    <td class="p-3 text-sm">Raised when the desktop state changes, from the trigger, the rail, the keyboard shortcut or <code class="text-sm">SetOpen</code></td>
                                }
                            </tr>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">OpenMobile</code></td>
                                <td class="p-3 text-sm">bool?</td>
                                <td class="p-3 text-sm">null</td>
                                @if (L.IsChinese)
                                {
                                    <td class="p-3 text-sm">移动端抽屉状态，用于配合 <code class="text-sm">@@bind-OpenMobile</code> 的受控用法。与 <code class="text-sm">Open</code> 相互独立。</td>
                                }
                                else
                                {
                                    <td class="p-3 text-sm">Mobile drawer state, for controlled usage with <code class="text-sm">@@bind-OpenMobile</code>. Independent of <code class="text-sm">Open</code>.</td>
                                }
                            </tr>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">OpenMobileChanged</code></td>
                                <td class="p-3 text-sm">EventCallback&lt;bool&gt;</td>
                                <td class="p-3 text-sm">—</td>
                                <td class="p-3 text-sm">@L.T("移动抽屉的开合状态发生变化时触发。", "Raised when the mobile drawer state changes")</td>
                            </tr>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">Variant</code></td>
                                <td class="p-3 text-sm">SidebarVariant</td>
                                <td class="p-3 text-sm">Sidebar</td>
                                <td class="p-3 text-sm">@L.T("视觉变体（Sidebar、Floating、Inset）", "Visual variant (Sidebar, Floating, Inset)")</td>
                            </tr>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">Side</code></td>
                                <td class="p-3 text-sm">SidebarSide</td>
                                <td class="p-3 text-sm">Left</td>
                                <td class="p-3 text-sm">@L.T("渲染所在侧（Left、Right）", "Side to render (Left, Right)")</td>
                            </tr>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">CookieKey</code></td>
                                <td class="p-3 text-sm">string</td>
                                <td class="p-3 text-sm">"sidebar:state"</td>
                                @if (L.IsChinese)
                                {
                                    <td class="p-3 text-sm">用于持久化的 Cookie 键。设为 null 可禁用。绑定 <code class="text-sm">Open</code> 时被忽略。</td>
                                }
                                else
                                {
                                    <td class="p-3 text-sm">Cookie key for persistence. Set null to disable. Ignored while <code class="text-sm">Open</code> is bound.</td>
                                }
                            </tr>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">EnableToggleShortcut</code></td>
                                <td class="p-3 text-sm">bool</td>
                                <td class="p-3 text-sm">true</td>
                                <td class="p-3 text-sm">@L.T("Ctrl/Cmd + B 是否切换侧边栏", "Whether Ctrl/Cmd + B toggles the sidebar")</td>
                            </tr>
                            <tr>
                                <td class="p-3"><code class="text-sm">HeightClass</code></td>
                                <td class="p-3 text-sm">string</td>
                                <td class="p-3 text-sm">"min-h-screen"</td>
                                <td class="p-3 text-sm">@L.T("控制容器高度的 CSS 类", "CSS class controlling container height")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div>
                <h3 class="text-lg font-semibold mb-2">Sidebar</h3>
                <p class="text-sm text-muted-foreground mb-3">@L.T("侧边栏面板本身。打开状态位于 provider 上而非此处——见下文 SidebarContext。", "The sidebar panel itself. Open state lives on the provider, not here — see SidebarContext below.")</p>
                <div class="rounded-lg border overflow-hidden">
                    <table class="w-full">
                        <thead class="border-b bg-muted/50">
                            <tr>
                                <th class="p-3 text-left font-medium">@L.T("属性", "Prop")</th>
                                <th class="p-3 text-left font-medium">@L.T("类型", "Type")</th>
                                <th class="p-3 text-left font-medium">@L.T("默认值", "Default")</th>
                                <th class="p-3 text-left font-medium">@L.T("说明", "Description")</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">Collapsible</code></td>
                                <td class="p-3 text-sm">bool</td>
                                <td class="p-3 text-sm">true</td>
                                <td class="p-3 text-sm">@L.T("侧边栏是否可折叠。设为 false 可将其固定展开。", "Whether the sidebar can collapse. Set false to pin it open.")</td>
                            </tr>
                            <tr>
                                <td class="p-3"><code class="text-sm">Class</code></td>
                                <td class="p-3 text-sm">string?</td>
                                <td class="p-3 text-sm">null</td>
                                <td class="p-3 text-sm">@L.T("额外的 CSS 类", "Additional CSS classes")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div>
                <h3 class="text-lg font-semibold mb-2">SidebarTrigger</h3>
                <p class="text-sm text-muted-foreground mb-3">@L.T("切换侧边栏。这是从标记中打开与关闭它的受支持方式。", "Toggles the sidebar. This is the supported way to open and close it from markup.")</p>
                <div class="rounded-lg border overflow-hidden">
                    <table class="w-full">
                        <thead class="border-b bg-muted/50">
                            <tr>
                                <th class="p-3 text-left font-medium">@L.T("属性", "Prop")</th>
                                <th class="p-3 text-left font-medium">@L.T("类型", "Type")</th>
                                <th class="p-3 text-left font-medium">@L.T("默认值", "Default")</th>
                                <th class="p-3 text-left font-medium">@L.T("说明", "Description")</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">OnClick</code></td>
                                <td class="p-3 text-sm">EventCallback&lt;MouseEventArgs&gt;</td>
                                <td class="p-3 text-sm">—</td>
                                <td class="p-3 text-sm">@L.T("除切换外还会调用，用于观察切换动作", "Invoked in addition to toggling, for observing the toggle")</td>
                            </tr>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">ChildContent</code></td>
                                <td class="p-3 text-sm">RenderFragment?</td>
                                <td class="p-3 text-sm">null</td>
                                <td class="p-3 text-sm">@L.T("替换默认的切换图标", "Replaces the default toggle icon")</td>
                            </tr>
                            <tr>
                                <td class="p-3"><code class="text-sm">Class</code></td>
                                <td class="p-3 text-sm">string?</td>
                                <td class="p-3 text-sm">null</td>
                                <td class="p-3 text-sm">@L.T("额外的 CSS 类", "Additional CSS classes")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div>
                <h3 class="text-lg font-semibold mb-2">SidebarContext</h3>
                @if (L.IsChinese)
                {
                    <p class="text-sm text-muted-foreground mb-3">
                        由 <code class="text-sm">SidebarProvider</code> 级联下发。用
                        <code class="text-sm">[CascadingParameter]</code> 取用它，即可在你自己的代码中读取或改变打开状态。
                        <code class="text-sm">Sidebar</code> 上没有 <code class="text-sm">Open</code>/<code class="text-sm">OpenChanged</code> 参数对——
                        状态由 provider 持有，并通过此 context 访问。
                    </p>
                }
                else
                {
                    <p class="text-sm text-muted-foreground mb-3">
                        Cascaded by <code class="text-sm">SidebarProvider</code>. Take it with a
                        <code class="text-sm">[CascadingParameter]</code> to read or change the open state from your own code.
                        There is no <code class="text-sm">Open</code>/<code class="text-sm">OpenChanged</code> parameter pair on
                        <code class="text-sm">Sidebar</code> — state is owned by the provider and reached through this context.
                    </p>
                }
                <div class="rounded-lg border overflow-hidden">
                    <table class="w-full">
                        <thead class="border-b bg-muted/50">
                            <tr>
                                <th class="p-3 text-left font-medium">@L.T("成员", "Member")</th>
                                <th class="p-3 text-left font-medium">@L.T("类型", "Type")</th>
                                <th class="p-3 text-left font-medium">@L.T("说明", "Description")</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">IsOpen</code></td>
                                <td class="p-3 text-sm">bool</td>
                                <td class="p-3 text-sm">@L.T("有效的打开状态——解析为当前视口对应的移动端或桌面端值。除非你特别需要另外两个，否则请读取这一个。", "Effective open state — resolves to the mobile or desktop value for the current viewport. Read this one unless you specifically need the other two.")</td>
                            </tr>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">Open</code></td>
                                <td class="p-3 text-sm">bool</td>
                                <td class="p-3 text-sm">@L.T("桌面端打开状态（只读）", "Desktop open state (read-only)")</td>
                            </tr>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">OpenMobile</code></td>
                                <td class="p-3 text-sm">bool</td>
                                <td class="p-3 text-sm">@L.T("移动端抽屉打开状态（只读）", "Mobile drawer open state (read-only)")</td>
                            </tr>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">IsMobile</code></td>
                                <td class="p-3 text-sm">bool</td>
                                <td class="p-3 text-sm">@L.T("视口当前是否处于移动端断点以下", "Whether the viewport is currently below the mobile breakpoint")</td>
                            </tr>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">Side</code></td>
                                <td class="p-3 text-sm">SidebarSide</td>
                                <td class="p-3 text-sm">@L.T("侧边栏渲染所在侧", "Side the sidebar renders on")</td>
                            </tr>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">ToggleSidebar()</code></td>
                                <td class="p-3 text-sm">void</td>
                                <td class="p-3 text-sm">@L.T("切换适用于当前视口的状态", "Toggles whichever state applies to the current viewport")</td>
                            </tr>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">SetOpen(bool)</code></td>
                                <td class="p-3 text-sm">void</td>
                                <td class="p-3 text-sm">@L.T("设置桌面端打开状态", "Sets the desktop open state")</td>
                            </tr>
                            <tr class="border-b">
                                <td class="p-3"><code class="text-sm">SetOpenMobile(bool)</code></td>
                                <td class="p-3 text-sm">void</td>
                                <td class="p-3 text-sm">@L.T("设置移动端抽屉打开状态", "Sets the mobile drawer open state")</td>
                            </tr>
                            <tr>
                                <td class="p-3"><code class="text-sm">StateChanged</code></td>
                                <td class="p-3 text-sm">event EventHandler?</td>
                                <td class="p-3 text-sm">@L.T("每当上述任一项变化时触发——订阅它以便在切换时重渲染，并在释放时取消订阅", "Raised whenever any of the above changes — subscribe to re-render on toggle, and unsubscribe on dispose")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div>
                <h3 class="text-lg font-semibold mb-2">SidebarMenuButton</h3>
                <p class="text-sm text-muted-foreground mb-3">@L.T("可点击的菜单项，支持提示。", "Clickable menu item with tooltip support.")</p>
                <div class="rounded-lg border overflow-hidden">
                    <table class="w-full">
                        <thead class="border-b bg-muted/50">
                            <tr>
                                <th class="p-3 text-left font-medium">@L.T("属性", "Prop")</th>
                                <th class="p-3 text-left font-medium">@L.T("类型", "Type")</th>
                                <th class="p-3 text-left font-medium">@L.T("默认值", "Default")</th>
                                <th class="p-3 text-left font-medium">@L.T("说明", "Description")</th>
