@page "/components/form-field-multi-select"
@using System.ComponentModel.DataAnnotations

<PageTitle>@L.T("FormFieldMultiSelect 表单多选 - Atom BlazorUI", "FormFieldMultiSelect Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <div class="flex items-center gap-3">
                <h1 class="text-4xl font-bold tracking-tight">FormFieldMultiSelect</h1>
                <span class="inline-flex items-center rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary ring-1 ring-inset ring-primary/20">v3</span>
            </div>
            <p class="text-xl text-muted-foreground">
                @L.T("MultiSelect 的表单字段封装，内置标签、提示文本与错误信息。",
                     "A form field wrapper for MultiSelect with built-in label, helper text, and error messages.")
            </p>
        </div>
    </div>

    <!-- Which form component? -->
    <div class="rounded-lg border border-dashed bg-muted/30 p-6 space-y-3">
        <h2 class="text-lg font-semibold">@L.T("该用哪个表单组件？", "Which form component?")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <div class="space-y-2 text-sm text-muted-foreground">
                <p><strong>文本输入</strong>（string、int、日期等）？ &rarr; <a href="/components/form-field-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldInput&lt;T&gt;</a></p>
                <p><strong>多行文本</strong>？ &rarr; <a href="/components/form-field-textarea" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldTextarea</a></p>
                <p><strong>数字输入</strong>？ &rarr; <a href="/components/form-field-numeric-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldNumericInput</a></p>
                <p><strong>货币输入</strong>？ &rarr; <a href="/components/form-field-currency-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCurrencyInput</a></p>
                <p><strong>掩码输入</strong>（电话、社保号等）？ &rarr; <a href="/components/form-field-masked-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldMaskedInput</a></p>
                <p><strong>OTP / 验证码</strong>？ &rarr; <a href="/components/form-field-input-otp" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldInputOTP</a></p>
                <p><strong>日期选择器</strong>？ &rarr; <a href="/components/form-field-date-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldDatePicker</a></p>
                <p><strong>日期区间选择器</strong>？ &rarr; <a href="/components/form-field-date-range-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldDateRangePicker</a></p>
                <p><strong>时间选择器</strong>？ &rarr; <a href="/components/form-field-time-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldTimePicker</a></p>
                <p><strong>复选框</strong>？ &rarr; <a href="/components/form-field-checkbox" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCheckbox</a></p>
                <p><strong>复选框组</strong>？ &rarr; <a href="/components/form-field-checkbox-group" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCheckboxGroup</a></p>
                <p><strong>开关</strong>？ &rarr; <a href="/components/form-field-switch" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldSwitch</a></p>
                <p><strong>单选组</strong>？ &rarr; <a href="/components/form-field-radio-group" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldRadioGroup</a></p>
                <p><strong>下拉选择</strong>？ &rarr; <a href="/components/form-field-select" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldSelect</a></p>
                <p><strong>原生 select</strong>？ &rarr; <a href="/components/form-field-native-select" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldNativeSelect</a></p>
                <p><strong>可搜索选择</strong>？ &rarr; <a href="/components/form-field-combobox" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCombobox</a></p>
                <p><strong>多选</strong>？ &rarr; <strong>FormFieldMultiSelect</strong>（当前页面）</p>
                <p><strong>标签输入</strong>？ &rarr; <a href="/components/form-field-tag-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldTagInput</a></p>
                <p><strong>文件上传</strong>？ &rarr; <a href="/components/form-field-file-upload" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldFileUpload</a></p>
            </div>
                </text>
}
        else
        {
                <text>
                    <div class="space-y-2 text-sm text-muted-foreground">
                <p><strong>Text input</strong> (string, int, date, etc.)? &rarr; <a href="/components/form-field-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldInput&lt;T&gt;</a></p>
                <p><strong>Textarea</strong>? &rarr; <a href="/components/form-field-textarea" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldTextarea</a></p>
                <p><strong>Numeric input</strong>? &rarr; <a href="/components/form-field-numeric-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldNumericInput</a></p>
                <p><strong>Currency input</strong>? &rarr; <a href="/components/form-field-currency-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCurrencyInput</a></p>
                <p><strong>Masked input</strong> (phone, SSN, etc.)? &rarr; <a href="/components/form-field-masked-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldMaskedInput</a></p>
                <p><strong>OTP / verification code</strong>? &rarr; <a href="/components/form-field-input-otp" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldInputOTP</a></p>
                <p><strong>Date picker</strong>? &rarr; <a href="/components/form-field-date-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldDatePicker</a></p>
                <p><strong>Date range picker</strong>? &rarr; <a href="/components/form-field-date-range-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldDateRangePicker</a></p>
                <p><strong>Time picker</strong>? &rarr; <a href="/components/form-field-time-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldTimePicker</a></p>
                <p><strong>Checkbox</strong>? &rarr; <a href="/components/form-field-checkbox" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCheckbox</a></p>
                <p><strong>Checkbox group</strong>? &rarr; <a href="/components/form-field-checkbox-group" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCheckboxGroup</a></p>
                <p><strong>Switch</strong>? &rarr; <a href="/components/form-field-switch" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldSwitch</a></p>
                <p><strong>Radio group</strong>? &rarr; <a href="/components/form-field-radio-group" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldRadioGroup</a></p>
                <p><strong>Select dropdown</strong>? &rarr; <a href="/components/form-field-select" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldSelect</a></p>
                <p><strong>Native select</strong>? &rarr; <a href="/components/form-field-native-select" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldNativeSelect</a></p>
                <p><strong>Searchable select</strong>? &rarr; <a href="/components/form-field-combobox" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCombobox</a></p>
                <p><strong>Multi-select</strong>? &rarr; <strong>FormFieldMultiSelect</strong> (this page)</p>
                <p><strong>Tag input</strong>? &rarr; <a href="/components/form-field-tag-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldTagInput</a></p>
                <p><strong>File upload</strong>? &rarr; <a href="/components/form-field-file-upload" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldFileUpload</a></p>
            </div>
                </text>
}
    </div>

    <!-- Basic Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("基本用法", "Basic Usage")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("带标签、提示文本与搜索功能的多选框，选中项以标签形式展示。",
                     "A multi-select with label, helper text, and search. Selected items appear as tags.")
            </p>
        </div>
        <div class="max-w-md">
            <FormFieldMultiSelect Required="true" AriaLabel="@(L.T("编程语言", "Programming languages"))" TValue="string"
                                  Options="_languages"
                                  @bind-Values="_selectedLanguages"
                                  Label="@(L.T("编程语言", "Programming languages"))"
                                  Placeholder="@(L.T("选择语言……", "Select languages..."))"
                                  SearchPlaceholder="@(L.T("搜索语言……", "Search languages..."))"
                                  HelperText="@(L.T("选择你精通的所有语言。", "Select all languages you are proficient in."))"
                                  MatchTriggerWidth="true"
                                  InputClass="w-full" />
        </div>
        <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
            <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected values:")</span> <span class="font-mono">@(_selectedLanguages?.Any() == true ? string.Join(", ", _selectedLanguages) : L.T("（无）", "(none)"))</span></p>
            <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(_selectedLanguages?.Any() == true ? string.Join(", ", _languages.GetTexts(_selectedLanguages)) : L.T("（无）", "(none)"))</p>
        </div>
        <CodeBlock Source="Components/FormFieldMultiSelect/basic.txt" />
    </div>

    <!-- Compositional Mode -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("组合式模式", "Compositional Mode")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    想要完全控制条目渲染时，省略 <code class="text-xs bg-muted px-1 py-0.5 rounded">Options</code>，
                    改为使用 <code class="text-xs bg-muted px-1 py-0.5 rounded">MultiSelectItem</code> 子内容。
                    搜索、全选、键盘导航与复选框指示的行为完全一致。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    For full control over item rendering, omit <code class="text-xs bg-muted px-1 py-0.5 rounded">Options</code>
                    and use <code class="text-xs bg-muted px-1 py-0.5 rounded">MultiSelectItem</code> children instead.
                    Search, Select All, keyboard navigation, and checkbox indicators work identically.
                </p>
                        </text>
}
        </div>
        <div class="max-w-md">
            <FormFieldMultiSelect TValue="string"
                                  @bind-Values="_compositionalValues"
                                  Label="@(L.T("权限", "Permissions"))"
                                  Placeholder="@(L.T("选择权限……", "Select permissions..."))"
                                  SearchPlaceholder="@(L.T("搜索……", "Search..."))"
                                  ShowSelectAll="true"
                                  SelectAllLabel="@(L.T("全选", "Select All"))"
                                  HelperText="@(L.T("分配访问权限。", "Assign access permissions."))"
                                  MatchTriggerWidth="true"
                                  InputClass="w-full">
                <MultiSelectItem Value="@("read")" Text="Read">
                    <div class="flex items-center gap-2">
                        <span class="inline-block h-2 w-2 rounded-full bg-green-500"></span>
                        Read
                    </div>
                </MultiSelectItem>
                <MultiSelectItem Value="@("write")" Text="Write">
                    <div class="flex items-center gap-2">
                        <span class="inline-block h-2 w-2 rounded-full bg-yellow-500"></span>
                        Write
                    </div>
                </MultiSelectItem>
                <MultiSelectItem Value="@("delete")" Text="Delete">
                    <div class="flex items-center gap-2">
                        <span class="inline-block h-2 w-2 rounded-full bg-red-500"></span>
                        Delete
                    </div>
                </MultiSelectItem>
                <MultiSelectItem Value="@("admin")" Text="Admin">
                    <div class="flex items-center gap-2">
                        <span class="inline-block h-2 w-2 rounded-full bg-purple-500"></span>
                        Admin
                    </div>
                </MultiSelectItem>
            </FormFieldMultiSelect>
        </div>
        <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
            <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected values:")</span> <span class="font-mono">@(_compositionalValues?.Any() == true ? string.Join(", ", _compositionalValues) : L.T("（无）", "(none)"))</span></p>
            <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(_compositionalValues?.Any() == true ? string.Join(", ", _compositionalValues.Select(GetCompositionalLabel)) : L.T("（无）", "(none)"))</p>
        </div>
        <CodeBlock Source="Components/FormFieldMultiSelect/compositional.txt" />
    </div>

    <!-- Non-String Value Types -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("非字符串值类型", "Non-String Value Types")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    用 <code class="text-xs bg-muted px-1 py-0.5 rounded">TValue</code> 绑定到
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">IEnumerable&lt;int&gt;?</code> 这类非字符串类型，
                    组件会自动处理转换。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use <code class="text-xs bg-muted px-1 py-0.5 rounded">TValue</code> to bind to non-string types such as
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">IEnumerable&lt;int&gt;?</code>. The component handles
                    conversion automatically.
                </p>
                        </text>
}
        </div>
        <div class="max-w-md">
            <FormFieldMultiSelect TValue="int"
                                  Options="_permissions"
                                  @bind-Values="_selectedPermissions"
                                  Label="@(L.T("权限", "Permissions"))"
                                  Placeholder="@(L.T("选择权限……", "Select permissions..."))"
                                  SearchPlaceholder="@(L.T("搜索权限……", "Search permissions..."))"
                                  HelperText="@(L.T("为该角色分配权限。", "Assign permissions to this role."))"
                                  MatchTriggerWidth="true"
                                  InputClass="w-full" />
        </div>
        <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
            <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected values:")</span> <span class="font-mono">@(_selectedPermissions?.Any() == true ? string.Join(", ", _selectedPermissions) : L.T("（无）", "(none)"))</span></p>
            <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(_selectedPermissions?.Any() == true ? string.Join(", ", _permissions.GetTexts(_selectedPermissions)) : L.T("（无）", "(none)"))</p>
        </div>
        <CodeBlock Source="Components/FormFieldMultiSelect/non-string.txt" />
    </div>

    <!-- Guid Values -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("Guid 值", "Guid Values")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    当条目使用唯一标识符时，可绑定到 <code class="text-xs bg-muted px-1 py-0.5 rounded">IEnumerable&lt;Guid&gt;?</code> 值。
                    设置 <code class="text-xs bg-muted px-1 py-0.5 rounded">TValue="Guid"</code> 后，
                    组件会处理序列化与比较。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Bind to <code class="text-xs bg-muted px-1 py-0.5 rounded">IEnumerable&lt;Guid&gt;?</code> values when your items use
                    unique identifiers. Set <code class="text-xs bg-muted px-1 py-0.5 rounded">TValue="Guid"</code> and
                    the component handles serialization and comparison.
                </p>
                        </text>
}
        </div>
        <div class="max-w-md">
            <FormFieldMultiSelect TValue="Guid"
                                  Options="_projects"
                                  @bind-Values="_selectedProjects"
                                  Label="@(L.T("项目", "Projects"))"
                                  Placeholder="@(L.T("选择项目……", "Select projects..."))"
                                  SearchPlaceholder="@(L.T("搜索项目……", "Search projects..."))"
                                  HelperText="@(L.T("选择要包含的项目。", "Choose projects to include."))"
                                  MatchTriggerWidth="true"
                                  InputClass="w-full" />
        </div>
        <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
            <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected values:")</span> <span class="font-mono">@(_selectedProjects?.Any() == true ? string.Join(", ", _selectedProjects) : L.T("（无）", "(none)"))</span></p>
            <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(_selectedProjects?.Any() == true ? string.Join(", ", _projects.GetTexts(_selectedProjects)) : L.T("（无）", "(none)"))</p>
        </div>
        <CodeBlock Source="Components/FormFieldMultiSelect/guid.txt" />
    </div>

    <!-- Without Select All -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("不带全选", "Without Select All")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    用 <code class="text-xs bg-muted px-1 py-0.5 rounded">ShowSelectAll="false"</code>
                    隐藏全选选项。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use <code class="text-xs bg-muted px-1 py-0.5 rounded">ShowSelectAll="false"</code> to
                    hide the Select All option.
                </p>
                        </text>
}
        </div>
        <div class="max-w-md">
            <FormFieldMultiSelect TValue="string"
                                  Options="_technologies"
                                  @bind-Values="_selectedTechnologies"
                                  Label="@(L.T("技术栈", "Tech stack"))"
                                  Placeholder="@(L.T("选择技术栈……", "Select technologies..."))"
                                  SearchPlaceholder="@(L.T("搜索……", "Search..."))"
                                  ShowSelectAll="false"
                                  MaxDisplayTags="2"
                                  MatchTriggerWidth="true"
                                  InputClass="w-full" />
        </div>
        <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
            <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected values:")</span> <span class="font-mono">@(_selectedTechnologies?.Any() == true ? string.Join(", ", _selectedTechnologies) : L.T("（无）", "(none)"))</span></p>
            <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(_selectedTechnologies?.Any() == true ? string.Join(", ", _technologies.GetTexts(_selectedTechnologies)) : L.T("（无）", "(none)"))</p>
        </div>
        <CodeBlock Source="Components/FormFieldMultiSelect/without-select-all.txt" />
    </div>

    <!-- Disabled -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("禁用", "Disabled")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("一个禁用的多选表单字段，已预选若干值。",
                     "A disabled multi-select form field with pre-selected values.")
            </p>
        </div>
        <div class="max-w-md">
            <FormFieldMultiSelect TValue="string"
                                  Options="_languages"
                                  Values="@(new[] { "csharp", "typescript" })"
                                  Label="@(L.T("必备技能", "Required skills"))"
                                  HelperText="@(L.T("这些技能是担任该角色所必需的。", "These skills are required for this role."))"
                                  MatchTriggerWidth="true"
                                  InputClass="w-full"
                                  Disabled="true" />
        </div>
        <CodeBlock Source="Components/FormFieldMultiSelect/disabled.txt" />
    </div>

    <!-- EditForm Integration -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("EditForm 集成", "EditForm Integration")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("在 EditForm 中，校验错误会自动显示。试试不选择任何技能直接提交。",
                     "Validation errors display automatically inside an EditForm. Try submitting without selecting any skills.")
            </p>
        </div>
        <div class="max-w-md">
            <EditForm Model="_formModel" OnValidSubmit="HandleFormSubmit">
                <DataAnnotationsValidator />
                <div class="space-y-4">
                    <FormFieldMultiSelect TValue="string"
                                          Options="_languages"
                                          @bind-Values="_formModel.Skills"
                                          Label="@(L.T("技能", "Skills"))"
                                          Placeholder="@(L.T("选择你的技能……", "Select your skills..."))"
                                          SearchPlaceholder="@(L.T("搜索技能……", "Search skills..."))"
                                          MatchTriggerWidth="true"
                                          InputClass="w-full" />
                    <Button Type="ButtonType.Submit">@L.T("提交", "Submit")</Button>
                </div>
            </EditForm>
            @if (_formSubmitted)
            {
                <div class="mt-4 rounded-lg border border-green-200 bg-green-50 dark:bg-green-950 dark:border-green-800 p-4 space-y-1">
                    <p class="text-sm font-medium text-green-800 dark:text-green-200">
                        @L.T("已提交值：", "Submitted values:") <span class="font-mono">@(_formModel.Skills != null ? string.Join(", ", _formModel.Skills) : L.T("（无）", "(none)"))</span>
                    </p>
                    <p class="text-sm font-medium text-green-800 dark:text-green-200">
                        @L.T("已提交文本：", "Submitted text:") @(_formModel.Skills != null ? string.Join(", ", _languages.GetTexts(_formModel.Skills)) : L.T("（无）", "(none)"))
                    </p>
                </div>
            }
        </div>
        <CodeBlock Source="Components/FormFieldMultiSelect/edit-form.txt" />
    </div>

    <!-- Infinite Scroll (Options mode) -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("无限滚动", "Infinite Scroll")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    用 <code class="text-xs bg-muted px-1 py-0.5 rounded">OnLoadMore</code> 与
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">IsLoading</code> 分批加载条目。
                    本例有约 80 个带国旗的国家，每次载入 20 个。
