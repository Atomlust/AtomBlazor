            new("Placeholder", "Select date range", L.T("未选择范围时显示的占位文本", "Placeholder text when no range is selected")),
            new("QuickSelect", "Quick Select", L.T("预设面板的标题", "Header for the preset panel")),
            new("SelectEndDate", "Select end date", L.T("选完起始日期后显示的提示", "Shown after selecting the start date")),
            new("DaysSelected", "{days} day(s) selected", L.T("显示所选天数的底部文本（Func<int, string>）", "Footer text showing the number of days (Func<int, string>)")),
            new("Clear", "Clear", L.T("清空按钮的文案", "Label for the clear button")),
            new("Apply", "Apply", L.T("应用按钮的文案", "Label for the apply button")),
            new("Today", "Today", L.T("预设标签", "Preset label")),
            new("Yesterday", "Yesterday", L.T("预设标签", "Preset label")),
            new("Last7Days", "Last 7 days", L.T("预设标签", "Preset label")),
            new("Last30Days", "Last 30 days", L.T("预设标签", "Preset label")),
            new("ThisMonth", "This month", L.T("预设标签", "Preset label")),
            new("LastMonth", "Last month", L.T("预设标签", "Preset label")),
            new("ThisYear", "This year", L.T("预设标签", "Preset label")),
            new("Custom", "Custom", L.T("预设标签", "Preset label")),
        })"
        CultureAware="true"
        CultureDescription="@(L.T("内部日历用 CultureInfo.CurrentCulture 取月份名、星期名与每周起始日。", "The internal calendars use CultureInfo.CurrentCulture for month/day names and first day of week."))"
        CodeExample="@(@"builder.Services.AddAtomBlazorComponents(localizer =>
