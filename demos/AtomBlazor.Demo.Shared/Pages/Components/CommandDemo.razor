@page "/components/command"
@using AtomBlazor.Icons.Lucide.Data
@using AtomBlazor.Icons.Feather.Data
@using AtomBlazor.Icons.Heroicons.Data
@using AtomBlazor.Icons.Feather
@using AtomBlazor.Icons.Heroicons
@using AtomBlazor.Primitives.Services
@inject IKeyboardShortcutService KeyboardShortcuts
@implements IDisposable

<PageTitle>@L.T("Command 命令面板 - Atom BlazorUI", "Command Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">@L.T("Command 命令面板", "Command Component")</h1>
        <p class="text-xl text-muted-foreground">
            @L.T("轻量、可组合的命令菜单，检索与选择全程可用键盘操作。",
                 "A fast, composable command menu with keyboard-driven search and selection.")
        </p>
        </div>
    </div>

    <div class="space-y-6">
    </div>

    <!-- Command Palette Overlay (Modal) -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("命令面板（浮层）", "Command Palette (Overlay)")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                一个以浮层形式出现在屏幕上的完整命令面板。点击按钮或按 <Kbd>Ctrl+I</Kbd> 即可打开。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                A proper command palette that appears as an overlay on the screen. Click the button or press <Kbd>Ctrl+I</Kbd> to open.
            </p>
                </text>
}

        <div class="flex flex-col gap-2">
            <Button Variant="ButtonVariant.Outline" OnClick="@(() => isCommandPaletteOpen = true)">
                <LucideIcon Name="command" Size="16" Class="mr-2" />
                @L.T("打开命令面板", "Open Command Palette")
                <span class="ml-auto text-xs text-muted-foreground">Ctrl+I</span>
            </Button>
            @if (!string.IsNullOrEmpty(paletteSelected))
            {
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm">上一次选择：<strong>@paletteSelected</strong></p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm">Last selected: <strong>@paletteSelected</strong></p>
                                </text>
}
            }
        </div>

        <!-- Command Palette Overlay -->
        @if (isCommandPaletteOpen)
        {
            <div class="fixed inset-0 z-50 flex items-start justify-center pt-[20vh]" @onclick="@(() => isCommandPaletteOpen = false)">
                <!-- Backdrop -->
                <div class="fixed inset-0 bg-black/50 backdrop-blur-sm"></div>

                <!-- Command Palette -->
                <div class="relative w-full max-w-lg mx-4" @onclick:stopPropagation="true">
                    <div class="border rounded-lg shadow-2xl bg-background animate-in fade-in-0 zoom-in-95">
                        <AtomBlazor.Command OnValueChange="@HandlePaletteSelect">
                            <CommandInput Placeholder="@(L.T("输入命令或搜索……", "Type a command or search..."))" AutoFocus="true" />
                            <CommandList>
                                <CommandEmpty>@L.T("未找到结果。", "No results found.")</CommandEmpty>
                                <CommandGroup Heading="@(L.T("建议", "Suggestions"))">
                                    <CommandItem Value="calendar">
                                        <LucideIcon Name="calendar" Size="16" Class="mr-2" />
                                        @L.T("日历", "Calendar")
                                    </CommandItem>
                                    <CommandItem Value="search-emoji">
                                        <LucideIcon Name="smile" Size="16" Class="mr-2" />
                                        @L.T("搜索表情", "Search Emoji")
                                    </CommandItem>
                                    <CommandItem Value="calculator">
                                        <LucideIcon Name="calculator" Size="16" Class="mr-2" />
                                        @L.T("计算器", "Calculator")
                                    </CommandItem>
                                </CommandGroup>
                                <CommandSeparator />
                                <CommandGroup Heading="@(L.T("设置", "Settings"))">
                                    <CommandItem Value="profile">
                                        <LucideIcon Name="user" Size="16" Class="mr-2" />
                                        @L.T("个人资料", "Profile")
                                        <CommandShortcut>⌘P</CommandShortcut>
                                    </CommandItem>
                                    <CommandItem Value="billing">
                                        <LucideIcon Name="credit-card" Size="16" Class="mr-2" />
                                        @L.T("账单", "Billing")
                                        <CommandShortcut>⌘B</CommandShortcut>
                                    </CommandItem>
                                    <CommandItem Value="settings">
                                        <LucideIcon Name="settings" Size="16" Class="mr-2" />
                                        @L.T("设置", "Settings")
                                        <CommandShortcut>⌘S</CommandShortcut>
                                    </CommandItem>
                                </CommandGroup>
                            </CommandList>
                        </AtomBlazor.Command>
                    </div>
                </div>
            </div>
        }

        <CodeBlock Source="Components/Command/palette.txt" />
    </section>

    <!-- CommandDialog with Shortcut -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("带快捷键的 CommandDialog", "CommandDialog with Shortcut")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                用 <code class="bg-muted px-1 py-0.5 rounded">CommandDialog</code> 得到一个自带键盘快捷键的命令面板。按 <Kbd>Ctrl+J</Kbd> 即可打开。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                Use <code class="bg-muted px-1 py-0.5 rounded">CommandDialog</code> to get a command palette with a built-in keyboard shortcut. Press <Kbd>Ctrl+J</Kbd> to open.
            </p>
                </text>
}

        <div class="flex flex-col gap-2">
            <Button Variant="ButtonVariant.Outline" OnClick="@(() => isCommandDialogOpen = true)">
                <LucideIcon Name="command" Size="16" Class="mr-2" />
                @L.T("打开命令对话框", "Open Command Dialog")
                <span class="ml-auto text-xs text-muted-foreground">Ctrl+J</span>
            </Button>
            @if (!string.IsNullOrEmpty(dialogSelected))
            {
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm">上一次选择：<strong>@dialogSelected</strong></p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm">Last selected: <strong>@dialogSelected</strong></p>
                                </text>
}
            }
        </div>

        <CommandDialog @bind-Open="isCommandDialogOpen" Shortcut="Ctrl+J" OnValueChange="HandleDialogSelect">
            <CommandInput Placeholder="@(L.T("输入命令或搜索……", "Type a command or search..."))" AutoFocus="true" />
            <CommandList>
                <CommandEmpty>@L.T("未找到结果。", "No results found.")</CommandEmpty>
                <CommandGroup Heading="@(L.T("建议", "Suggestions"))">
                    <CommandItem Value="calendar">
                        <Icon><LucideIcon Name="calendar" Size="16" /></Icon>
                        <ChildContent>@L.T("日历", "Calendar")</ChildContent>
                    </CommandItem>
                    <CommandItem Value="search-emoji">
                        <Icon><LucideIcon Name="smile" Size="16" /></Icon>
                        <ChildContent>@L.T("搜索表情", "Search Emoji")</ChildContent>
                    </CommandItem>
                    <CommandItem Value="calculator">
                        <Icon><LucideIcon Name="calculator" Size="16" /></Icon>
                        <ChildContent>@L.T("计算器", "Calculator")</ChildContent>
                    </CommandItem>
                </CommandGroup>
                <CommandSeparator />
                <CommandGroup Heading="@(L.T("设置", "Settings"))">
                    <CommandItem Value="profile">
                        <Icon><LucideIcon Name="user" Size="16" /></Icon>
                        <ChildContent>@L.T("个人资料", "Profile")</ChildContent>
                    </CommandItem>
                    <CommandItem Value="settings">
                        <Icon><LucideIcon Name="settings" Size="16" /></Icon>
                        <ChildContent>@L.T("设置", "Settings")</ChildContent>
                    </CommandItem>
                </CommandGroup>
            </CommandList>
        </CommandDialog>

        <CodeBlock Source="Components/Command/command-dialog.txt" />
    </section>

    <!-- Basic Command -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("基本命令菜单", "Basic Command Menu")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("一个简单的命令菜单，可搜索可选择。试着输入内容来筛选项。", "A simple command menu with search and selection. Try typing to filter items.")
        </p>

        <div class="flex flex-col gap-2">
            <div class="border rounded-lg shadow-sm max-w-md">
                <AtomBlazor.Command OnValueChange="@HandleBasicSelect">
                    <CommandInput Placeholder="@(L.T("输入命令或搜索……", "Type a command or search..."))" />
                    <CommandList>
                        <CommandEmpty>@L.T("未找到结果。", "No results found.")</CommandEmpty>
                        <CommandGroup>
                            <CommandItem Value="calendar">@L.T("日历", "Calendar")</CommandItem>
                            <CommandItem Value="search-emoji">@L.T("搜索表情", "Search Emoji")</CommandItem>
                            <CommandItem Value="calculator">@L.T("计算器", "Calculator")</CommandItem>
                            <CommandItem Value="settings">@L.T("设置", "Settings")</CommandItem>
                        </CommandGroup>
                    </CommandList>
                </AtomBlazor.Command>
            </div>
            @if (!string.IsNullOrEmpty(basicSelected))
            {
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm">已选择：<strong>@basicSelected</strong></p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm">Selected: <strong>@basicSelected</strong></p>
                                </text>
}
            }
        </div>

        <CodeBlock Source="Components/Command/basic.txt" />
    </section>

    <!-- With Groups -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("分组命令", "Grouped Commands")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("把命令按逻辑分组，并配上分组标题。", "Organize commands into logical groups with headings.")
        </p>

        <div class="flex flex-col gap-2">
            <div class="border rounded-lg shadow-sm max-w-md">
                <AtomBlazor.Command OnValueChange="@HandleGroupSelect">
                    <CommandInput Placeholder="@(L.T("搜索命令……", "Search commands..."))" />
                    <CommandList>
                        <CommandEmpty>@L.T("未找到结果。", "No results found.")</CommandEmpty>
                        <CommandGroup Heading="@(L.T("建议", "Suggestions"))">
                            <CommandItem Value="calendar">
                                <LucideIcon Name="calendar" Size="16" Class="mr-2" />
                                @L.T("日历", "Calendar")
                            </CommandItem>
                            <CommandItem Value="search-emoji">
                                <LucideIcon Name="smile" Size="16" Class="mr-2" />
                                @L.T("搜索表情", "Search Emoji")
                            </CommandItem>
                            <CommandItem Value="calculator">
                                <LucideIcon Name="calculator" Size="16" Class="mr-2" />
                                @L.T("计算器", "Calculator")
                            </CommandItem>
                        </CommandGroup>
                        <CommandSeparator />
                        <CommandGroup Heading="@(L.T("设置", "Settings"))">
                            <CommandItem Value="profile">
                                <LucideIcon Name="user" Size="16" Class="mr-2" />
                                @L.T("个人资料", "Profile")
                            </CommandItem>
                            <CommandItem Value="billing">
                                <LucideIcon Name="credit-card" Size="16" Class="mr-2" />
                                @L.T("账单", "Billing")
                            </CommandItem>
                            <CommandItem Value="settings">
                                <LucideIcon Name="settings" Size="16" Class="mr-2" />
                                @L.T("设置", "Settings")
                            </CommandItem>
                        </CommandGroup>
                    </CommandList>
                </AtomBlazor.Command>
            </div>
            @if (!string.IsNullOrEmpty(groupSelected))
            {
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm">已选择：<strong>@groupSelected</strong></p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm">Selected: <strong>@groupSelected</strong></p>
                                </text>
}
            }
        </div>

        <CodeBlock Source="Components/Command/grouped.txt" />
    </section>

    <!-- With Keyboard Shortcuts -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("带键盘快捷键", "With Keyboard Shortcuts")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("在命令旁显示键盘快捷键（仅作展示）。用方向键导航，用 Enter 选择。", "Display keyboard shortcuts alongside commands (visual only). Use arrow keys to navigate and Enter to select.")
        </p>

        <div class="flex flex-col gap-2">
            <div class="border rounded-lg shadow-sm max-w-md">
                <AtomBlazor.Command OnValueChange="@HandleShortcutSelect">
                    <CommandInput Placeholder="@(L.T("搜索命令……", "Search commands..."))" />
                    <CommandList>
                        <CommandEmpty>@L.T("未找到结果。", "No results found.")</CommandEmpty>
                        <CommandGroup Heading="@(L.T("文件", "File"))">
                            <CommandItem Value="new">
                                @L.T("新建文件", "New File")
                                <CommandShortcut>⌘N</CommandShortcut>
                            </CommandItem>
                            <CommandItem Value="open">
                                @L.T("打开文件", "Open File")
                                <CommandShortcut>⌘O</CommandShortcut>
                            </CommandItem>
                            <CommandItem Value="save">
                                @L.T("保存文件", "Save File")
                                <CommandShortcut>⌘S</CommandShortcut>
                            </CommandItem>
                        </CommandGroup>
                        <CommandSeparator />
                        <CommandGroup Heading="@(L.T("编辑", "Edit"))">
                            <CommandItem Value="copy">
                                @L.T("复制", "Copy")
                                <CommandShortcut>⌘C</CommandShortcut>
                            </CommandItem>
                            <CommandItem Value="paste">
                                @L.T("粘贴", "Paste")
                                <CommandShortcut>⌘V</CommandShortcut>
                            </CommandItem>
                            <CommandItem Value="cut">
                                @L.T("剪切", "Cut")
                                <CommandShortcut>⌘X</CommandShortcut>
                            </CommandItem>
                        </CommandGroup>
                    </CommandList>
                </AtomBlazor.Command>
            </div>
            @if (!string.IsNullOrEmpty(shortcutSelected))
            {
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm">已选择：<strong>@shortcutSelected</strong></p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm">Selected: <strong>@shortcutSelected</strong></p>
                                </text>
}
            }
        </div>

        <CodeBlock Source="Components/Command/keyboard-shortcuts.txt" />
    </section>

    <!-- With Disabled Items -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("禁用条目", "Disabled Items")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("可以把条目设为禁用，使其无法被选中。", "Items can be disabled to prevent selection.")
        </p>

        <div class="flex flex-col gap-2">
            <div class="border rounded-lg shadow-sm max-w-md">
                <AtomBlazor.Command OnValueChange="@HandleDisabledSelect">
                    <CommandInput Placeholder="@(L.T("搜索命令……", "Search commands..."))" />
                    <CommandList>
                        <CommandEmpty>@L.T("未找到结果。", "No results found.")</CommandEmpty>
                        <CommandGroup>
                            <CommandItem Value="cut">@L.T("剪切", "Cut")</CommandItem>
                            <CommandItem Value="copy">@L.T("复制", "Copy")</CommandItem>
                            <CommandItem Value="paste" Disabled="true">@L.T("粘贴（已禁用）", "Paste (Disabled)")</CommandItem>
                            <CommandItem Value="select-all">@L.T("全选", "Select All")</CommandItem>
                            <CommandItem Value="delete" Disabled="true">@L.T("删除（已禁用）", "Delete (Disabled)")</CommandItem>
                        </CommandGroup>
                    </CommandList>
                </AtomBlazor.Command>
            </div>
            @if (!string.IsNullOrEmpty(disabledSelected))
            {
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm">已选择：<strong>@disabledSelected</strong></p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm">Selected: <strong>@disabledSelected</strong></p>
                                </text>
}
            }
        </div>

        <CodeBlock Source="Components/Command/disabled.txt" />
    </section>

    <!-- Empty State -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("空状态", "Empty State")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                当搜索词没有匹配结果时显示自定义提示。试着搜索“xyz”。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                Shows a custom message when no results match the search query. Try searching for "xyz".
            </p>
                </text>
}

        <div class="flex flex-col gap-2">
            <div class="border rounded-lg shadow-sm max-w-md">
                <AtomBlazor.Command>
                    <CommandInput Placeholder="@(L.T("试试搜索 xyz……", "Try searching for xyz..."))" />
                    <CommandList>
                        <CommandEmpty>
                            <div class="flex flex-col items-center gap-2">
                                <LucideIcon Name="search-x" Size="32" Class="text-muted-foreground" />
                                <p class="text-sm">@L.T("没有找到与你的搜索匹配的结果。", "No results found for your query.")</p>
                            </div>
                        </CommandEmpty>
                        <CommandGroup>
                            <CommandItem Value="apple">Apple</CommandItem>
                            <CommandItem Value="banana">Banana</CommandItem>
                            <CommandItem Value="cherry">Cherry</CommandItem>
                        </CommandGroup>
                    </CommandList>
                </AtomBlazor.Command>
            </div>
        </div>

        <CodeBlock Source="Components/Command/empty.txt" />
    </section>

    <!-- Complex Example -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("综合示例", "Complex Example")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("把全部特性用到一起：分组、图标、快捷键、禁用条目与搜索筛选。", "Combining all features: groups, icons, shortcuts, disabled items, and search filtering.")
        </p>

        <div class="flex flex-col gap-2">
            <div class="border rounded-lg shadow-sm max-w-lg">
                <AtomBlazor.Command OnValueChange="@HandleComplexSelect">
                    <CommandInput Placeholder="@(L.T("输入命令或搜索……", "Type a command or search..."))" />
                    <CommandList>
                        <CommandEmpty>@L.T("未找到结果。", "No results found.")</CommandEmpty>
                        <CommandGroup Heading="@(L.T("建议", "Suggestions"))">
                            <CommandItem Value="calendar">
                                <LucideIcon Name="calendar" Size="16" Class="mr-2" />
                                @L.T("日历", "Calendar")
                            </CommandItem>
                            <CommandItem Value="search-emoji">
                                <LucideIcon Name="smile" Size="16" Class="mr-2" />
                                @L.T("搜索表情", "Search Emoji")
                            </CommandItem>
                            <CommandItem Value="calculator">
                                <LucideIcon Name="calculator" Size="16" Class="mr-2" />
                                @L.T("计算器", "Calculator")
                            </CommandItem>
                        </CommandGroup>
                        <CommandSeparator />
                        <CommandGroup Heading="@(L.T("文件", "File"))">
                            <CommandItem Value="new-file">
                                <LucideIcon Name="file-plus" Size="16" Class="mr-2" />
                                @L.T("新建文件", "New File")
                                <CommandShortcut>⌘N</CommandShortcut>
                            </CommandItem>
                            <CommandItem Value="open-file">
                                <LucideIcon Name="folder-open" Size="16" Class="mr-2" />
                                @L.T("打开文件", "Open File")
                                <CommandShortcut>⌘O</CommandShortcut>
                            </CommandItem>
                            <CommandItem Value="save-file">
                                <LucideIcon Name="save" Size="16" Class="mr-2" />
                                @L.T("保存文件", "Save File")
                                <CommandShortcut>⌘S</CommandShortcut>
                            </CommandItem>
                            <CommandItem Value="save-as" Disabled="true">
                                <LucideIcon Name="save" Size="16" Class="mr-2" />
                                @L.T("另存为……（已禁用）", "Save As... (Disabled)")
                                <CommandShortcut>⇧⌘S</CommandShortcut>
                            </CommandItem>
                        </CommandGroup>
                        <CommandSeparator />
                        <CommandGroup Heading="@(L.T("设置", "Settings"))">
                            <CommandItem Value="profile">
                                <LucideIcon Name="user" Size="16" Class="mr-2" />
                                @L.T("个人资料", "Profile")
                                <CommandShortcut>⌘P</CommandShortcut>
                            </CommandItem>
                            <CommandItem Value="billing">
                                <LucideIcon Name="credit-card" Size="16" Class="mr-2" />
                                @L.T("账单", "Billing")
                                <CommandShortcut>⌘B</CommandShortcut>
                            </CommandItem>
                            <CommandItem Value="settings">
                                <LucideIcon Name="settings" Size="16" Class="mr-2" />
                                @L.T("设置", "Settings")
                                <CommandShortcut>⌘,</CommandShortcut>
                            </CommandItem>
                        </CommandGroup>
                    </CommandList>
                </AtomBlazor.Command>
            </div>
            @if (!string.IsNullOrEmpty(complexSelected))
            {
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm">已选择：<strong>@complexSelected</strong></p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm">Selected: <strong>@complexSelected</strong></p>
                                </text>
}
            }
        </div>

        <CodeBlock Source="Components/Command/complex.txt" />
    </section>

    <!-- Lazy Loading (Large Lists) -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("懒加载（大型列表）", "Lazy Loading (Large Lists)")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                用懒加载高效处理大数据集。条目随你滚动按需载入。
                本例含 <strong>@TotalIconCount 个图标</strong>，来自三个图标库：Lucide (@_lucideIcons.Length)、Feather (@_featherIcons.Length) 与 Heroicons (@_heroIcons.Length)。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                Efficiently handle large datasets with lazy loading. Items are loaded on-demand as you scroll.
                This example contains <strong>@TotalIconCount icons</strong> across three libraries: Lucide (@_lucideIcons.Length), Feather (@_featherIcons.Length), and Heroicons (@_heroIcons.Length).
            </p>
                </text>
}

        <div class="flex flex-col gap-2">
            <div class="border rounded-lg shadow-sm max-w-md">
                <AtomBlazor.Command OnValueChange="@HandleLazySelect">
                    <CommandInput Placeholder="@(L.IsChinese ? $"搜索 {TotalIconCount} 个图标……" : $"Search {TotalIconCount} icons...")" />
                    <CommandList Class="max-h-[300px]">
