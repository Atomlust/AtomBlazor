    <!-- Server-Side Lazy Loading (ItemsProvider) -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("服务端懒加载（ItemsProvider）", "Server-Side Lazy Loading (ItemsProvider)")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                用 <code class="text-xs bg-muted px-1 py-0.5 rounded">EnableLazyLoading</code> 配合
                <code class="text-xs bg-muted px-1 py-0.5 rounded">Items</code> 参数时，仍然得提前把整个集合实例化。
                改用 <code class="text-xs bg-muted px-1 py-0.5 rounded">ItemsProvider</code> 就只需取回当前可见的那一段——
                特别适合存放在数据库或 API 里的数据。提供方会收到滚动区间与当前搜索词，返回匹配的那一段以及总数。
                本例分 <strong>25,000</strong> 条记录逐页取用（并模拟了 150&nbsp;ms 的延迟），
                组件内始终不会持超过一屏的数据。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                With <code class="text-xs bg-muted px-1 py-0.5 rounded">EnableLazyLoading</code> plus the
                <code class="text-xs bg-muted px-1 py-0.5 rounded">Items</code> parameter you still have to
                materialize the whole collection up front. Supply an
                <code class="text-xs bg-muted px-1 py-0.5 rounded">ItemsProvider</code> instead to fetch only
                the slice currently in view — ideal for data that lives in a database or API. The provider
                receives the scroll range and the current search text and returns the matching slice plus a
                total count. This example pages through <strong>25,000</strong> records (with a simulated
                150&nbsp;ms latency) and never holds more than a screenful in the component.
            </p>
                </text>
}

        <div class="flex flex-col gap-2">
            <div class="border rounded-lg shadow-sm max-w-md">
                <AtomBlazor.Command OnValueChange="@HandleProviderSelect">
                    <CommandInput Placeholder="@(L.T("搜索 25,000 条记录……", "Search 25,000 records..."))" />
                    <CommandList Class="max-h-[300px]">
                        <CommandEmpty>@L.T("未找到记录。", "No records found.")</CommandEmpty>
                        <CommandVirtualizedGroup TItem="(string Name, int Index)"
                            Heading="@(L.T("记录", "Records"))"
                            ItemsProvider="@LoadProductsAsync"
                            ItemValue="@(p => p.Name)"
                            EnableLazyLoading="true">
                            <ItemTemplate Context="product">
                                <span class="flex-1">@product.Name</span>
                                <span class="text-xs text-muted-foreground ml-2">#@product.Index</span>
                            </ItemTemplate>
                        </CommandVirtualizedGroup>
                    </CommandList>
                </AtomBlazor.Command>
            </div>
            @if (!string.IsNullOrEmpty(providerSelected))
            {
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-sm">已选择：<strong>@providerSelected</strong></p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-sm">Selected: <strong>@providerSelected</strong></p>
                                </text>
}
            }
        </div>

        <CodeBlock Source="Components/Command/items-provider.txt" />
    </section>

    <!-- Debounce -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("防抖", "Debounce")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                默认情况下，CommandInput 会对搜索筛选做防抖，以减少每次按键带来的重渲染。
                把 <code class="text-xs bg-muted px-1 py-0.5 rounded">DisableDebounce="true"</code> 打开即可恢复即时筛选。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                By default, CommandInput debounces search filtering to reduce re-renders on every keystroke.
                Set <code class="text-xs bg-muted px-1 py-0.5 rounded">DisableDebounce="true"</code> to restore immediate filtering.
            </p>
                </text>
}

        <div class="grid gap-6 md:grid-cols-2 max-w-4xl">
            <div class="space-y-2">
                <p class="text-sm font-medium">@L.T("防抖（默认，500ms）", "Debounced (default, 500ms)")</p>
                <div class="border rounded-lg shadow-sm">
                    <AtomBlazor.Command>
                        <CommandInput Placeholder="@(L.T("搜索（防抖）……", "Search (debounced)..."))" />
                        <CommandList>
                            <CommandEmpty>@L.T("未找到结果。", "No results found.")</CommandEmpty>
                            <CommandGroup>
                                <CommandItem Value="apple">Apple</CommandItem>
                                <CommandItem Value="banana">Banana</CommandItem>
                                <CommandItem Value="cherry">Cherry</CommandItem>
                                <CommandItem Value="date">Date</CommandItem>
                            </CommandGroup>
                        </CommandList>
                    </AtomBlazor.Command>
                </div>
                <p class="text-xs text-muted-foreground">@L.T("停止输入 500ms 后才执行筛选。", "Filtering happens after you stop typing for 500ms.")</p>
            </div>
            <div class="space-y-2">
                <p class="text-sm font-medium">@L.T("立即（DisableDebounce）", "Immediate (DisableDebounce)")</p>
                <div class="border rounded-lg shadow-sm">
                    <AtomBlazor.Command>
                        <CommandInput Placeholder="@(L.T("搜索（立即）……", "Search (immediate)..."))" DisableDebounce="true" />
                        <CommandList>
                            <CommandEmpty>@L.T("未找到结果。", "No results found.")</CommandEmpty>
                            <CommandGroup>
                                <CommandItem Value="apple">Apple</CommandItem>
                                <CommandItem Value="banana">Banana</CommandItem>
                                <CommandItem Value="cherry">Cherry</CommandItem>
                                <CommandItem Value="date">Date</CommandItem>
                            </CommandGroup>
                        </CommandList>
                    </AtomBlazor.Command>
                </div>
                <p class="text-xs text-muted-foreground">@L.T("每次按键都会执行筛选。", "Filtering happens on every keystroke.")</p>
            </div>
        </div>

