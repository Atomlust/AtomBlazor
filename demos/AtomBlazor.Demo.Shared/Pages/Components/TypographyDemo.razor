@page "/components/typography"

<PageTitle>@L.T("Typography 排版组件 - Atom BlazorUI", "Typography Components - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("Typography 排版组件", "Typography Components")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("一组带样式的文本组件，帮助整个应用保持统一的排版。", "Styled text components for consistent typography across your application.")
            </p>
        </div>
    </div>

    <!-- H1 -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">H1</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("页面主标题。", "Main page heading.")
            </p>
        </div>
        <div class="border rounded-lg p-6">
            <TypographyH1>@L.T("笑话税的故事", "The Joke Tax Chronicles")</TypographyH1>
        </div>
        <CodeBlock Source="Components/Typography/h1.txt" />
    </div>

    <!-- H2 -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">H2</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("带边框的章节标题。", "Section heading with border.")
            </p>
        </div>
        <div class="border rounded-lg p-6">
            <TypographyH2>@L.T("王国的人们", "The People of the Kingdom")</TypographyH2>
        </div>
        <CodeBlock Source="Components/Typography/h2.txt" />
    </div>

    <!-- H3 -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">H3</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("小节标题。", "Subsection heading.")
            </p>
        </div>
        <div class="border rounded-lg p-6">
            <TypographyH3>@L.T("笑话税", "The Joke Tax")</TypographyH3>
        </div>
        <CodeBlock Source="Components/Typography/h3.txt" />
    </div>

    <!-- H4 -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">H4</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("次级小标题。", "Minor heading.")
            </p>
        </div>
        <div class="border rounded-lg p-6">
            <TypographyH4>@L.T("人们不再讲笑话了", "People stopped telling jokes")</TypographyH4>
        </div>
        <CodeBlock Source="Components/Typography/h4.txt" />
    </div>

    <!-- Paragraph -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("Paragraph 段落", "Paragraph")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("标准段落文本。", "Standard paragraph text.")
            </p>
        </div>
        <div class="border rounded-lg p-6">
            <TypographyP>
                @L.T("国王看到臣民们快乐了许多，于是上网搜索一个自己能用的闹钟。他在搜索框里输入 \"alarm clock\"，但因为打错了字，结果搜成了 \"alarm cock\"。", "The king, seeing how much happier his subjects were, googled for a alarm clock he could use. He googled \"alarm clock\" into the search bar but because he made a typo, he ended up searching for \"alarm cock\" instead.")
            </TypographyP>
        </div>
        <CodeBlock Source="Components/Typography/paragraph.txt" />
    </div>

    <!-- Lead -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("Lead 引导文本", "Lead")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("醒目的开场引导文本。", "Introductory text that stands out.")
            </p>
        </div>
        <div class="border rounded-lg p-6">
            <TypographyLead>
                @L.T("一个用重要内容打断用户并等待其响应的模态对话框。", "A modal dialog that interrupts the user with important content and expects a response.")
            </TypographyLead>
        </div>
        <CodeBlock Source="Components/Typography/lead.txt" />
    </div>

    <!-- Large -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("Large 大号文本", "Large")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("用于强调的较大文本。", "Larger text for emphasis.")
            </p>
        </div>
        <div class="border rounded-lg p-6">
            <TypographyLarge>@L.T("你确定吗？", "Are you absolutely sure?")</TypographyLarge>
        </div>
        <CodeBlock Source="Components/Typography/large.txt" />
    </div>

    <!-- Small -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("Small 小号文本", "Small")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("用于细则说明的小号文本。", "Smaller text for fine print.")
            </p>
        </div>
        <div class="border rounded-lg p-6">
            <TypographySmall>@L.T("电子邮箱地址", "Email address")</TypographySmall>
        </div>
        <CodeBlock Source="Components/Typography/small.txt" />
    </div>

    <!-- Muted -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("Muted 柔和文本", "Muted")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("用于次要信息的柔和文本。", "Subdued text for secondary information.")
            </p>
        </div>
        <div class="border rounded-lg p-6">
            <TypographyMuted>@L.T("请输入你的电子邮箱地址。", "Enter your email address.")</TypographyMuted>
        </div>
        <CodeBlock Source="Components/Typography/muted.txt" />
    </div>

    <!-- Blockquote -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("Blockquote 引用块", "Blockquote")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("带左侧边框的引用文本。", "Quoted text with a left border.")
            </p>
        </div>
        <div class="border rounded-lg p-6">
            <TypographyBlockquote>
                @L.T("“毕竟，”他说道，“人人都爱听好笑话，所以让他们为这份特权付费才公平。”", "\"After all,\" he said, \"everyone enjoys a good joke, so it's only fair that they should pay for the privilege.\"")
            </TypographyBlockquote>
        </div>
        <CodeBlock Source="Components/Typography/blockquote.txt" />
    </div>

    <!-- Inline Code -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("Inline Code 行内代码", "Inline Code")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("行内代码片段。", "Inline code snippets.")
            </p>
        </div>
        <div class="border rounded-lg p-6">
            @if (L.IsChinese)
            {
                <text>
                    <p>
                        使用 <TypographyInlineCode>Button</TypographyInlineCode> 组件来创建可交互的按钮。
                    </p>
                </text>
            }
            else
            {
                <text>
                    <p>
                Use the <TypographyInlineCode>Button</TypographyInlineCode> component to create interactive buttons.
            </p>
                </text>
            }
        </div>
        <CodeBlock Source="Components/Typography/inline-code.txt" />
    </div>

    <!-- Combined Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("综合示例", "Combined Example")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("排版组件组合使用的示例。", "Typography components used together.")
            </p>
        </div>
        <div class="border rounded-lg p-6">
            <TypographyH1>@L.T("快速开始", "Getting Started")</TypographyH1>
            <TypographyLead>
                @L.T("学习如何在你的项目中安装并使用 Atom BlazorUI 组件。", "Learn how to install and use Atom BlazorUI components in your project.")
            </TypographyLead>
            <TypographyH2>@L.T("安装", "Installation")</TypographyH2>
            @if (L.IsChinese)
            {
                <text>
                    <TypographyP>
                        首先，使用 <TypographyInlineCode>dotnet add package</TypographyInlineCode> 命令安装 Atom BlazorUI 包：
                    </TypographyP>
                </text>
            }
            else
            {
                <text>
                    <TypographyP>
                First, install the Atom BlazorUI package using the <TypographyInlineCode>dotnet add package</TypographyInlineCode> command:
            </TypographyP>
                </text>
            }
            <TypographyH3>@L.T("NuGet 包管理器", "NuGet Package Manager")</TypographyH3>
            <TypographyP>
                @L.T("你也可以在 Visual Studio 里用 NuGet 包管理器搜索并安装这个包。", "You can also use the NuGet Package Manager in Visual Studio to search for and install the package.")
            </TypographyP>
            <TypographyBlockquote>
                @L.T("“Atom BlazorUI 为 Blazor 应用提供了一整套 UI 组件。”", "\"Atom BlazorUI provides a comprehensive set of UI components for Blazor applications.\"")
            </TypographyBlockquote>
            <TypographyMuted>@L.T("最后更新：2025 年 1 月", "Last updated: January 2025")</TypographyMuted>
        </div>
        <CodeBlock Source="Components/Typography/combined.txt" />
    </div>

    <!-- Accessibility Notes -->

    <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>
                @if (L.IsChinese)
                {
                    <text>
                        使用语义化 HTML 元素（<code class="text-xs bg-muted px-1 py-0.5 rounded">h1</code>–<code class="text-xs bg-muted px-1 py-0.5 rounded">h4</code>、<code class="text-xs bg-muted px-1 py-0.5 rounded">p</code>、<code class="text-xs bg-muted px-1 py-0.5 rounded">blockquote</code>、<code class="text-xs bg-muted px-1 py-0.5 rounded">small</code>、<code class="text-xs bg-muted px-1 py-0.5 rounded">code</code>）构建规范的文档结构
                    </text>
                }
                else
                {
                    <text>
                        Uses semantic HTML elements (<code class="text-xs bg-muted px-1 py-0.5 rounded">h1</code>–<code class="text-xs bg-muted px-1 py-0.5 rounded">h4</code>, <code class="text-xs bg-muted px-1 py-0.5 rounded">p</code>, <code class="text-xs bg-muted px-1 py-0.5 rounded">blockquote</code>, <code class="text-xs bg-muted px-1 py-0.5 rounded">small</code>, <code class="text-xs bg-muted px-1 py-0.5 rounded">code</code>) for proper document structure
                    </text>
                }
            </AccessibilityItem>
            <AccessibilityItem>
                @L.T("标题层级为读屏软件与页面导航建立文档大纲", "Heading hierarchy establishes document outline for screen readers and navigation")
            </AccessibilityItem>
        </AriaAttributes>
    </AccessibilityList>

    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件属性与参数。", "Component properties and parameters.")</p>
        </div>

        <ApiReference ComponentName="TypographyBlockquote">
            <ApiParameter Name="ChildContent" Type="RenderFragment?">@L.T("组件 ChildContent 参数设置。", "Component ChildContent setting.")</ApiParameter>
            <ApiParameter Name="Class" Type="string?">@L.T("组件 Class 参数设置。", "Component Class setting.")</ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">@L.T("获取或设置应用到根元素的附加 HTML 属性。", "Gets or sets additional HTML attributes to apply to the root element.")</ApiParameter>
        </ApiReference>

        <ApiReference ComponentName="TypographyH1">
            <ApiParameter Name="ChildContent" Type="RenderFragment?">@L.T("组件 ChildContent 参数设置。", "Component ChildContent setting.")</ApiParameter>
            <ApiParameter Name="Class" Type="string?">@L.T("组件 Class 参数设置。", "Component Class setting.")</ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">@L.T("获取或设置应用到根元素的附加 HTML 属性。", "Gets or sets additional HTML attributes to apply to the root element.")</ApiParameter>
        </ApiReference>

        <ApiReference ComponentName="TypographyH2">
            <ApiParameter Name="ChildContent" Type="RenderFragment?">@L.T("组件 ChildContent 参数设置。", "Component ChildContent setting.")</ApiParameter>
            <ApiParameter Name="Class" Type="string?">@L.T("组件 Class 参数设置。", "Component Class setting.")</ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">@L.T("获取或设置应用到根元素的附加 HTML 属性。", "Gets or sets additional HTML attributes to apply to the root element.")</ApiParameter>
        </ApiReference>

        <ApiReference ComponentName="TypographyH3">
            <ApiParameter Name="ChildContent" Type="RenderFragment?">@L.T("组件 ChildContent 参数设置。", "Component ChildContent setting.")</ApiParameter>
            <ApiParameter Name="Class" Type="string?">@L.T("组件 Class 参数设置。", "Component Class setting.")</ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">@L.T("获取或设置应用到根元素的附加 HTML 属性。", "Gets or sets additional HTML attributes to apply to the root element.")</ApiParameter>
        </ApiReference>

        <ApiReference ComponentName="TypographyH4">
            <ApiParameter Name="ChildContent" Type="RenderFragment?">@L.T("组件 ChildContent 参数设置。", "Component ChildContent setting.")</ApiParameter>
            <ApiParameter Name="Class" Type="string?">@L.T("组件 Class 参数设置。", "Component Class setting.")</ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">@L.T("获取或设置应用到根元素的附加 HTML 属性。", "Gets or sets additional HTML attributes to apply to the root element.")</ApiParameter>
        </ApiReference>

        <ApiReference ComponentName="TypographyInlineCode">
            <ApiParameter Name="ChildContent" Type="RenderFragment?">@L.T("组件 ChildContent 参数设置。", "Component ChildContent setting.")</ApiParameter>
            <ApiParameter Name="Class" Type="string?">@L.T("组件 Class 参数设置。", "Component Class setting.")</ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">@L.T("获取或设置应用到根元素的附加 HTML 属性。", "Gets or sets additional HTML attributes to apply to the root element.")</ApiParameter>
        </ApiReference>

        <ApiReference ComponentName="TypographyLarge">
            <ApiParameter Name="ChildContent" Type="RenderFragment?">@L.T("组件 ChildContent 参数设置。", "Component ChildContent setting.")</ApiParameter>
            <ApiParameter Name="Class" Type="string?">@L.T("组件 Class 参数设置。", "Component Class setting.")</ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">@L.T("获取或设置应用到根元素的附加 HTML 属性。", "Gets or sets additional HTML attributes to apply to the root element.")</ApiParameter>
        </ApiReference>

        <ApiReference ComponentName="TypographyLead">
            <ApiParameter Name="ChildContent" Type="RenderFragment?">@L.T("组件 ChildContent 参数设置。", "Component ChildContent setting.")</ApiParameter>
            <ApiParameter Name="Class" Type="string?">@L.T("组件 Class 参数设置。", "Component Class setting.")</ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">@L.T("获取或设置应用到根元素的附加 HTML 属性。", "Gets or sets additional HTML attributes to apply to the root element.")</ApiParameter>
        </ApiReference>

        <ApiReference ComponentName="TypographyMuted">
            <ApiParameter Name="ChildContent" Type="RenderFragment?">@L.T("组件 ChildContent 参数设置。", "Component ChildContent setting.")</ApiParameter>
            <ApiParameter Name="Class" Type="string?">@L.T("组件 Class 参数设置。", "Component Class setting.")</ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">@L.T("获取或设置应用到根元素的附加 HTML 属性。", "Gets or sets additional HTML attributes to apply to the root element.")</ApiParameter>
        </ApiReference>

        <ApiReference ComponentName="TypographyP">
            <ApiParameter Name="ChildContent" Type="RenderFragment?">@L.T("组件 ChildContent 参数设置。", "Component ChildContent setting.")</ApiParameter>
            <ApiParameter Name="Class" Type="string?">@L.T("组件 Class 参数设置。", "Component Class setting.")</ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">@L.T("获取或设置应用到根元素的附加 HTML 属性。", "Gets or sets additional HTML attributes to apply to the root element.")</ApiParameter>
        </ApiReference>

        <ApiReference ComponentName="TypographySmall">
            <ApiParameter Name="ChildContent" Type="RenderFragment?">@L.T("组件 ChildContent 参数设置。", "Component ChildContent setting.")</ApiParameter>
            <ApiParameter Name="Class" Type="string?">@L.T("组件 Class 参数设置。", "Component Class setting.")</ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">@L.T("获取或设置应用到根元素的附加 HTML 属性。", "Gets or sets additional HTML attributes to apply to the root element.")</ApiParameter>
        </ApiReference>
    </section>

</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;
}
