                                <text>
                                    <ApiParameter Name="CollapseAllGroups()" Type="Task">
                        Public method. Collapses all groups, hiding their data rows. Call via a component reference (<code>@@ref</code>).
                    </ApiParameter>
                                </text>
}
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="GroupByColumnAsync(string, SortDirection)" Type="Task">
                        公共方法。按给定的列 ID 给行分组，并替换掉当前生效的分组。方向参数决定分组键的顺序，默认升序。需通过组件引用（@@ref）调用。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="GroupByColumnAsync(string, SortDirection)" Type="Task">
                        Public method. Groups rows by the given column id, replacing any active grouping. The direction orders the group keys and defaults to ascending. Call via a component reference (<code>@@ref</code>).
                    </ApiParameter>
                                </text>
}
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="ClearGroupingAsync()" Type="Task">
                        公共方法。清除当前生效的分组，让网格回到平铺的行。需通过组件引用（@@ref）调用。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="ClearGroupingAsync()" Type="Task">
                        Public method. Clears any active grouping, returning the grid to flat rows. Call via a component reference (<code>@@ref</code>).
                    </ApiParameter>
                                </text>
}
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="RefreshDataAsync()" Type="Task">
                        公共方法。重新读取数据源并重渲染。在就地修改 Items 集合（网格无法按引用察觉这种改动）之后调用它，或者用它强制 ItemsProvider 重新取数。实现了 INotifyCollectionChanged 的集合（例如 ObservableCollection）会被订阅并自动刷新，因此不需要它。需通过组件引用（@@ref）调用。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="RefreshDataAsync()" Type="Task">
                        Public method. Re-reads the data source and re-renders. Call after mutating the Items collection in place, which the grid cannot detect by reference, or to force an ItemsProvider re-fetch. Collections implementing INotifyCollectionChanged (such as ObservableCollection) are subscribed to and refreshed automatically, so they do not need this. Call via a component reference (<code>@@ref</code>).
                    </ApiParameter>
                                </text>
}
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        应用到根 <code>&lt;div&gt;</code> 元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        Additional HTML attributes applied to the root <code>&lt;div&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                    </ApiParameter>
                                </text>
}
            </ApiReference>

            <ApiReference ComponentName="DataGridPropertyColumn">
                <ApiParameter Name="Id" Type="string?"> @L.T("该列显式的唯一标识。未设置时回退到属性成员名（小写）。当属性名可能重名，或者持久化的状态必须保持稳定时提供它。", "Explicit unique identifier for this column. When not set, falls back to the property member name (lowercase). Provide this when property names may collide or when persisted state must remain stable.") </ApiParameter>
                <ApiParameter Name="Property" Type="Expression&lt;Func&lt;TData, TProp&gt;&gt;"> @L.T("访问列值的类型安全表达式。用于数据显示、标题自动推断，以及 IQueryable 排序表达式生成。", "Type-safe expression to access the column value. Used for data display, auto title inference, and IQueryable sort expression generation.") </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="Title" Type="string?">
                        覆盖自动推断出的标题。为 null 时，标题由属性名推导（例如 FirstName 变成 “First Name”）。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="Title" Type="string?">
                        Override the auto-inferred title. If null, the title is derived from the property name (e.g., FirstName becomes "First Name").
                    </ApiParameter>
                                </text>
}
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="Format" Type="string?">
                        显示属性值所用的格式串（例如 “C0” 表示货币、“N2” 表示数字、“d” 表示日期）。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="Format" Type="string?">
                        Format string for displaying the property value (e.g., "C0" for currency, "N2" for numbers, "d" for dates).
                    </ApiParameter>
                                </text>
}
                <ApiParameter Name="SortAndFilterBy" Type="Expression&lt;Func&lt;TData, object?&gt;&gt;?" Default="null"> @L.T("当该列排序与筛选所依据的值与 Property 不同时，用它投影出那个值。当单元格显示的内容并非原始属性——最常见的情形就是用 CellTemplate 把键解析成标签——设置它，点击表头就会按用户读到的内容排序，而不是背后的键。一个参数管住排序、按列筛选、全局搜索、分组与 CSV 导出，因此它们不可能各说各话；分成两个选择器就可能互相矛盾。它是一个表达式而不是委托，这样基于 IQueryable 的服务端 ItemsProvider 仍能翻译它，也就是说表达式体必须保持可被你的提供方翻译。Format 不会应用于投影后的值。", "Projects the value this column sorts and filters on, when that differs from Property. Set it when the cell displays something other than the raw property — the common case being a CellTemplate that resolves a key to a label — so the header click orders by what the user reads rather than by the key behind it. One parameter covers sorting, per-column filtering, global search, grouping and CSV export, so all of them agree; two separate selectors could disagree. It is an expression rather than a delegate so a server-side ItemsProvider over IQueryable can still translate it, which means the body must stay translatable by your provider. Format is not applied to the projected value.") </ApiParameter>
                <ApiParameter Name="Sortable" Type="bool" Default="false"> @L.T("该列是否可以通过点击表头排序。", "Whether this column can be sorted by clicking its header.") </ApiParameter>
                <ApiParameter Name="Visible" Type="bool" Default="true"> @L.T("该列是否在网格中可见。", "Whether this column is visible in the grid.") </ApiParameter>
                <ApiParameter Name="Order" Type="int?" Default="null"> @L.T("该列显式的位置，是在网格数据列之中从零开始的序号。未设置时该列保持注册顺序——也就是它的组件完成初始化的顺序，就直接写在网格标记里的列而言即声明顺序。若某个列是间接生成的（由包装组件、或只在 await 之后才渲染的片段产生），初始化顺序与声明顺序不一致，就在它上面设置这个。没有设置 Order 的列先按注册顺序排布，随后每个设置了 Order 的列被插入到该序号处，序号小的先插入；超出末尾的序号追加到末尾，共用同一个 Order 的列保持注册顺序。选择列与展开列固定在最前，不计入这个序号。该列向网格注册时读取。", "Explicit position for this column, as a zero-based index among the grid's data columns. When not set, the column keeps its registration order — the order its component initializes in, which for a column written directly in the grid's markup is the order it was declared. Set this on a column produced indirectly, by a wrapper component or by a fragment that only renders after an await, where initialization order does not match declaration order. Columns without Order are laid out first in registration order, then each column that sets it is inserted at that index, lowest value first; an index past the end appends, and columns sharing an Order keep their registration order. Select and expand columns hold their fixed leading positions and are not counted by this index. Read when the column registers with the grid.") </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="Width" Type="string?">
                        列宽（例如 “200px”、“20%”、“auto”）。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="Width" Type="string?">
                        Column width (e.g., "200px", "20%", "auto").
                    </ApiParameter>
                                </text>
}
                <ApiParameter Name="CellTemplate" Type="RenderFragment&lt;TData&gt;?"> @L.T("渲染单元格内容的自定义模板。它会取代默认的值显示。", "Custom template for rendering the cell content. Overrides the default value display.") </ApiParameter>
                <ApiParameter Name="HeaderTemplate" Type="RenderFragment?"> @L.T("自定义表头内容，例如在标题旁边（或取代标题）放一个图标。它只替换标题文本——网格仍会在它周围渲染排序指示、筛选图标、固定图标、列菜单与缩放手柄，因此 Sortable 与 Groupable 的列保留全部操作入口。提供模板期间，网格会用 Title 在表头单元格上设置 aria-label，所以只有图标的表头依旧会被朗读，你不必再加自己的 sr-only 标记。这个标签取代模板自身的文本成为可访问名称，让表头与列选择器、列菜单保持一致，因此请让 Title 保持有含义。若 Title 为空则不设置标签，单元格改由模板内容朗读。", "Custom header content, e.g. an icon next to (or instead of) the title. It replaces the title text only — the grid still renders the sort indicator, filter icon, pin icon, column menu and resize handle around it, so Sortable and Groupable columns keep every affordance. While a template is supplied the grid sets aria-label on the header cell from Title, so an icon-only header is still announced and no sr-only markup of your own is needed. That label replaces the template's own text as the accessible name, keeping the header consistent with the column chooser and column menu; keep Title meaningful for this reason. If Title is blank no label is applied and the cell is announced from the template's content.") </ApiParameter>
                <ApiParameter Name="CellClass" Type="string?"> @L.T("应用于该列单元格的额外 CSS 类。", "Additional CSS classes applied to cells in this column.") </ApiParameter>
                <ApiParameter Name="CellClassFunc" Type="Func&lt;TData, string?&gt;?"> @L.T("依据该行的数据项为一个单元格计算额外的 CSS 类，与 CellClass 叠加应用。用于按单元格的条件格式。", "Computes additional CSS classes for a cell from the row's data item, applied in addition to CellClass. Use for conditional per-cell formatting.") </ApiParameter>
                <ApiParameter Name="HeaderClass" Type="string?"> @L.T("应用于该列表头单元格的额外 CSS 类。", "Additional CSS classes applied to the header cell of this column.") </ApiParameter>
                <ApiParameter Name="Hideable" Type="bool" Default="true"> @L.T("该列是否可以通过列可见性下拉菜单切换。", "Whether this column can be toggled via the column visibility dropdown.") </ApiParameter>
                <ApiParameter Name="Resizable" Type="bool" Default="true"> @L.T("该列是否可以通过拖动缩放。", "Whether this column can be resized by dragging.") </ApiParameter>
                <ApiParameter Name="Reorderable" Type="bool" Default="true"> @L.T("该列是否可以通过拖动重排。", "Whether this column can be reordered by dragging.") </ApiParameter>
                <ApiParameter Name="Pinned" Type="ColumnPinning" Default="None"> @L.T("该列是否固定在可滚动视口的某一边。使用 AtomBlazor.Primitives.ColumnPinning.Left 或 AtomBlazor.Primitives.ColumnPinning.Right。", "Whether this column is pinned to an edge of the scrollable viewport. Use AtomBlazor.Primitives.ColumnPinning.Left or AtomBlazor.Primitives.ColumnPinning.Right.") </ApiParameter>
                <ApiParameter Name="Filterable" Type="bool" Default="false"> @L.T("该列是否支持按列筛选。为 true 时表头里会出现一个筛选图标，点击可打开筛选浮层。筛选类型会依据属性类型自动推断。", "Whether this column supports per-column filtering. When true, a filter icon appears in the column header that opens a filter popover. The filter field type is auto-inferred from the property type.") </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="Groupable" Type="bool" Default="false">
                        用户是否可以在运行时按该列分组。为 true 时表头里出现一个省略号菜单，其中有 “Group by” 操作。一次只按一个列分组，因此按另一列分组会替换掉当前分组。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="Groupable" Type="bool" Default="false">
                        Whether users can group rows by this column at runtime. When true, an ellipsis menu appears in the column header offering a "Group by" action. One column is grouped at a time, so grouping by another column replaces the current grouping.
                    </ApiParameter>
                                </text>
}
                <ApiParameter Name="FilterType" Type="FilterFieldType?" Default="null"> @L.T("覆盖自动推断出的筛选类型。当默认推断不正确时使用（例如对已知取值的字符串属性使用 FilterFieldType.Enum）。", "Override the auto-inferred filter field type. Use when the default inference is not correct (e.g., use FilterFieldType.Enum for string properties with known values).") </ApiParameter>
                <ApiParameter Name="FilterOptions" Type="IEnumerable&lt;SelectOption&lt;string&gt;&gt;?" Default="null"> @L.T("Enum 筛选类型的预定义选项。当属性类型是 C# 枚举时，选项会由枚举值自动生成。用它来覆盖，或者为基于字符串的枚举列提供选项。", "Predefined options for Enum filter fields. When the property type is a C# enum, options are auto-generated from the enum values. Use this to override or provide options for string-based enum columns.") </ApiParameter>
                <ApiParameter Name="NoWrap" Type="bool" Default="false"> @L.T("该列文本是否不换行。为 true 时单元格内容使用 white-space: nowrap，溢出时以省略号截断。", "Whether text in this column should not wrap. When true, cell content uses white-space: nowrap and truncates with an ellipsis on overflow.") </ApiParameter>
                <ApiParameter Name="Aggregate" Type="AggregateFunction" Default="None"> @L.T("分组生效时在分组表头里计算的聚合函数。可选：None、Count、Sum、Average、Min、Max。", "Aggregate function to compute in group headers when grouping is active. Options: None, Count, Sum, Average, Min, Max.") </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="AggregateFormat" Type="string?" Default="null">
                        显示聚合值所用的格式串（例如 “N0”、“C2”）。为 null 时，若设置了 Format 就用它，否则使用默认格式。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="AggregateFormat" Type="string?" Default="null">
                        Format string for displaying aggregate values (e.g., "N0", "C2"). When null, falls back to Format if set, otherwise uses default formatting.
                    </ApiParameter>
                                </text>
}
            </ApiReference>

            <ApiReference ComponentName="DataGridTemplateColumn">
                <ApiParameter Name="Id" Type="string?"> @L.T("该列显式的唯一标识。未设置时回退到由 Title 的短标识。当标题可能重名、会随本地化变化，或者持久化的状态必须保持稳定时提供它。", "Explicit unique identifier for this column. When not set, falls back to a slug derived from Title. Provide this when titles may collide, change under localization, or when persisted state must remain stable.") </ApiParameter>
                <ApiParameter Name="Title" Type="string"> @L.T("表头中显示的列标题。必填。", "The column title displayed in the header. Required.") </ApiParameter>
                <ApiParameter Name="ChildContent" Type="RenderFragment&lt;TData&gt;"> @L.T("自定义单元格模板。上下文提供当前行的数据项。", "Custom cell template. The context provides the data item for the current row.") </ApiParameter>
                <ApiParameter Name="HeaderTemplate" Type="RenderFragment?"> @L.T("自定义表头模板。它取代默认的标题文本，同时保留排序图标与缩放手柄。提供模板期间，网格会用 Title 在表头单元格上设置 aria-label，所以只有图标的表头依旧会被朗读，你不必再加自己的 sr-only 标记。这个标签取代模板自身的文本成为可访问名称，让表头与列选择器、列菜单保持一致，因此请让 Title 保持有含义。若 Title 为空则不设置标签，单元格改由模板内容朗读。", "Custom header template. Replaces the default title text while preserving sort icons and resize handles. While a template is supplied the grid sets aria-label on the header cell from Title, so an icon-only header is still announced and no sr-only markup of your own is needed. That label replaces the template's own text as the accessible name, keeping the header consistent with the column chooser and column menu; keep Title meaningful for this reason. If Title is blank no label is applied and the cell is announced from the template's content.") </ApiParameter>
                <ApiParameter Name="Sortable" Type="bool" Default="false"> @L.T("该列是否可排序。需要同时设置 SortBy。", "Whether this column can be sorted. Requires SortBy to be set.") </ApiParameter>
                <ApiParameter Name="SortBy" Type="Expression&lt;Func&lt;TData, object&gt;&gt;?"> @L.T("自定义排序表达式。当 Sortable 为 true 时必填。", "Custom sort expression. Required when Sortable is true.") </ApiParameter>
                <ApiParameter Name="Visible" Type="bool" Default="true"> @L.T("该列是否在网格中可见。", "Whether this column is visible in the grid.") </ApiParameter>
                <ApiParameter Name="Order" Type="int?" Default="null"> @L.T("该列显式的位置，是在网格数据列之中从零开始的序号。未设置时该列保持注册顺序——也就是它的组件完成初始化的顺序，就直接写在网格标记里的列而言即声明顺序。若某个列是间接生成的（由包装组件、或只在 await 之后才渲染的片段产生），初始化顺序与声明顺序不一致，就在它上面设置这个。没有设置 Order 的列先按注册顺序排布，随后每个设置了 Order 的列被插入到该序号处，序号小的先插入；超出末尾的序号追加到末尾，共用同一个 Order 的列保持注册顺序。选择列与展开列固定在最前，不计入这个序号。该列向网格注册时读取。", "Explicit position for this column, as a zero-based index among the grid's data columns. When not set, the column keeps its registration order — the order its component initializes in, which for a column written directly in the grid's markup is the order it was declared. Set this on a column produced indirectly, by a wrapper component or by a fragment that only renders after an await, where initialization order does not match declaration order. Columns without Order are laid out first in registration order, then each column that sets it is inserted at that index, lowest value first; an index past the end appends, and columns sharing an Order keep their registration order. Select and expand columns hold their fixed leading positions and are not counted by this index. Read when the column registers with the grid.") </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="Width" Type="string?">
                        列宽（例如 “200px”、“20%”、“auto”）。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="Width" Type="string?">
                        Column width (e.g., "200px", "20%", "auto").
                    </ApiParameter>
                                </text>
}
                <ApiParameter Name="CellClass" Type="string?"> @L.T("应用于该列单元格的额外 CSS 类。", "Additional CSS classes applied to cells in this column.") </ApiParameter>
                <ApiParameter Name="CellClassFunc" Type="Func&lt;TData, string?&gt;?"> @L.T("依据该行的数据项为一个单元格计算额外的 CSS 类，与 CellClass 叠加应用。用于按单元格的条件格式。", "Computes additional CSS classes for a cell from the row's data item, applied in addition to CellClass. Use for conditional per-cell formatting.") </ApiParameter>
                <ApiParameter Name="HeaderClass" Type="string?"> @L.T("应用于该列表头单元格的额外 CSS 类。", "Additional CSS classes applied to the header cell of this column.") </ApiParameter>
                <ApiParameter Name="Hideable" Type="bool" Default="true"> @L.T("该列是否可以通过列可见性下拉菜单切换。", "Whether this column can be toggled via the column visibility dropdown.") </ApiParameter>
                <ApiParameter Name="Resizable" Type="bool" Default="true"> @L.T("该列是否可以通过拖动缩放。", "Whether this column can be resized by dragging.") </ApiParameter>
                <ApiParameter Name="Reorderable" Type="bool" Default="true"> @L.T("该列是否可以通过拖动重排。", "Whether this column can be reordered by dragging.") </ApiParameter>
                <ApiParameter Name="Pinned" Type="ColumnPinning" Default="None"> @L.T("该列是否固定在可滚动视口的某一边。", "Whether this column is pinned to an edge of the scrollable viewport.") </ApiParameter>
                <ApiParameter Name="Filterable" Type="bool" Default="false"> @L.T("该列是否支持按列筛选。需要同时设置 FilterBy。", "Whether this column supports per-column filtering. Requires FilterBy to be set.") </ApiParameter>
                <ApiParameter Name="Groupable" Type="bool" Default="false"> @L.T("用户是否可以在运行时按该列分组（通过表头里的省略号菜单）。需要同时设置 SortBy，因为分组键要从它读取。", "Whether users can group rows by this column at runtime, via an ellipsis menu in the column header. Requires SortBy to be set, since the group key is read from it.") </ApiParameter>
                <ApiParameter Name="FilterBy" Type="Expression&lt;Func&lt;TData, object&gt;&gt;?" Default="null"> @L.T("用于构造筛选 Where 子句的表达式。当 Filterable 为 true 时必填。", "Expression used to build filter Where clauses. Required when Filterable is true.") </ApiParameter>
                <ApiParameter Name="FilterType" Type="FilterFieldType?" Default="null"> @L.T("覆盖筛选类型。未设置时默认为 FilterFieldType.Text。", "Override the filter field type. Defaults to FilterFieldType.Text when not set.") </ApiParameter>
