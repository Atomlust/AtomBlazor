                    </div>
                    <div>
                        <span class="font-medium text-muted-foreground">@L.T("状态：", "Status:")</span>
                        <span class="ml-2">@context.Status</span>
                    </div>
                    <div>
                        <span class="font-medium text-muted-foreground">@L.T("入职日期：", "Join Date:")</span>
                        <span class="ml-2">@context.JoinDate.ToShortDateString()</span>
                    </div>
                </div>
            </DetailTemplate>
        </DataGrid>
        <CodeBlock Source="Components/DataGrid/expandable-rows.txt" />
