                    </Button>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                              OnClick="@(() => nestedGroupingGrid!.SetGroupingAsync(new[] { "status", "department", "role" }))">
                        @L.T("按 Status › Department › Role 分组", "Status › Department › Role")
                    </Button>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                              OnClick="@(() => nestedGroupingGrid!.ClearGroupingAsync())">
                        @L.T("清除分组", "Clear grouping")
                    </Button>
                </div>
            </Toolbar>
            <Columns>
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Name)" Sortable />
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Department)" Sortable Groupable />
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Status)" Sortable Groupable />
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Role)" Groupable />
                <DataGridPropertyColumn TData="Person" TProp="int" Property="@(p => p.Salary)" Format="C0" Sortable
                    Aggregate="AtomBlazor.Primitives.AggregateFunction.Sum" />
            </Columns>
        </DataGrid>
        <CodeBlock Source="Components/DataGrid/nested-grouping.txt" />
    </div>

    <!-- ── Live Collection Updates ──────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("集合实时更新", "Live Collection Updates")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    网格按引用来识别新的数据集，因此就地修改一个集合并不会自行触发重渲染。
                    绑定一个 <code class="bg-muted px-1 py-0.5 rounded">ObservableCollection</code>，网格就会订阅它，
                    在行的增删时随之重渲染。若只是一个普通的 <code class="bg-muted px-1 py-0.5 rounded">List</code>，
                    改为在修改之后调用网格上的
                    <code class="bg-muted px-1 py-0.5 rounded">RefreshDataAsync()</code>。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    The grid detects a new data set by reference, so mutating a collection in place does not re-render
                    on its own. Bind an <code class="bg-muted px-1 py-0.5 rounded">ObservableCollection</code> and the grid
                    subscribes to it, re-rendering as rows are added or removed. For a plain
                    <code class="bg-muted px-1 py-0.5 rounded">List</code>, call
                    <code class="bg-muted px-1 py-0.5 rounded">RefreshDataAsync()</code> on the grid after mutating it instead.
                </p>
                        </text>
}
        </div>
        <DataGrid TData="Person" Items="@livePeople" InitialPageSize="10" ShowPagination>
            <Toolbar>
                <div class="flex items-center gap-2">
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@AddLivePerson">
                        <LucideIcon Name="plus" Class="w-4 h-4 mr-1" /> @L.T("新增一行", "Add row")
                    </Button>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@RemoveLivePerson"
                              Disabled="@(livePeople.Count == 0)">
                        <LucideIcon Name="minus" Class="w-4 h-4 mr-1" /> @L.T("移除最后一行", "Remove last")
                    </Button>
                    @if (L.IsChinese)
                    {
                                        <text>
                                            <span class="text-sm text-muted-foreground">共 @livePeople.Count 行</span>
                                        </text>
}
                    else
                    {
                                        <text>
                                            <span class="text-sm text-muted-foreground">@livePeople.Count rows</span>
                                        </text>
}
                </div>
            </Toolbar>
            <Columns>
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Name)" Sortable />
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Department)" Sortable />
                <DataGridPropertyColumn TData="Person" TProp="int" Property="@(p => p.Salary)" Format="C0" Sortable />
            </Columns>
        </DataGrid>
        <CodeBlock Source="Components/DataGrid/live-collection-updates.txt" />
    </div>

    <AccessibilityList>
        <AriaAttributes>
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>为屏幕阅读器使用 role="grid" 与 aria-rowcount</AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>Uses role="grid" with aria-rowcount for screen readers</AccessibilityItem>
                        </text>
}
            <AccessibilityItem>@L.T("列头上的 aria-sort 指示当前的排序方向", "aria-sort on column headers indicates current sort direction")</AccessibilityItem>
            <AccessibilityItem>@L.T("行上的 aria-selected 指示选中状态", "aria-selected on rows indicates selection state")</AccessibilityItem>
            <AccessibilityItem>@L.T("单行选择与批量选择的复选框都带有 aria-label", "aria-label on checkboxes for row and bulk selection")</AccessibilityItem>
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>可排序的列头可以通过 tabindex="0" 获得焦点</AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>Sortable column headers are focusable with tabindex="0"</AccessibilityItem>
                        </text>
}
        </AriaAttributes>
        <KeyboardNavigation>
            <KeyboardShortcutItem Description="@(L.T("对聚焦的列头排序", "Sort column (on focused header)"))">
                <Kbd>Enter</Kbd> / <Kbd>Space</Kbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("多列排序（加入已有排序）", "Multi-column sort (add to existing sort)"))">
                <Kbd>Ctrl</Kbd> + <Kbd>Click</Kbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("移动到下一行", "Navigate to next row"))">
                <Kbd>ArrowDown</Kbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("移动到上一行", "Navigate to previous row"))">
                <Kbd>ArrowUp</Kbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("切换该行的选中状态", "Toggle row selection"))">
                <Kbd>Enter</Kbd> / <Kbd>Space</Kbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("在可交互元素之间移动焦点", "Move focus through interactive elements"))">
                <Kbd>Tab</Kbd>
            </KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>

    <!-- API Reference -->
    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件属性与参数。", "Component properties and parameters.")</p>
        </div>
        <div class="space-y-4">
            <ApiReference ComponentName="DataGrid">
                <ApiParameter Name="Items" Type="IEnumerable&lt;TData&gt;"> @L.T("网格的数据源。支持 IQueryable（由 LINQ 组合排序与分页）或 IEnumerable（在内存中处理）。与 ItemsProvider 互斥。新的数据集按引用识别，因此换一个集合会自动重渲染；就地修改同一个集合，则要么调用 RefreshDataAsync()，要么改用 INotifyCollectionChanged 数据源（例如 ObservableCollection），网格会自动订阅它。", "The data source for the grid. Supports IQueryable for LINQ-composed sorting and pagination, or IEnumerable for in-memory processing. Mutually exclusive with ItemsProvider. A new data set is detected by reference, so assigning a different collection re-renders automatically; mutating the same collection in place needs either a RefreshDataAsync() call or an INotifyCollectionChanged source such as ObservableCollection, which the grid subscribes to.") </ApiParameter>
                <ApiParameter Name="ItemsProvider" Type="DataGridItemsProvider&lt;TData&gt;"> @L.T("用于服务端取数的异步委托。它会收到排序定义、分页参数与取消令牌。与 Items 互斥。", "Async delegate for server-side data fetching. Receives sort definitions, pagination parameters, and a cancellation token. Mutually exclusive with Items.") </ApiParameter>
                <ApiParameter Name="EditMode" Type="DataGridEditMode" Default="None"> @L.T("网格让用户就地编辑行的方式。Row 一次把整行置于编辑态：每个带 EditTemplate 的列都变成输入框，改动一起提交或一起丢弃。行进入编辑的入口有 DataGridEditColumn、EditOnRowClick，以及 StartEditAsync。Enter 提交，Escape 取消。取消会把该行在开始编辑时的值放回同一个实例。Cell 与 Batch 模式使用各自独立的编辑模型，参见单元格与批量编辑指南。", "How the grid lets a user edit rows in place. Row puts a whole row into edit at once: every column with an EditTemplate becomes an input, and the changes commit or discard together. A row goes into edit through DataGridEditColumn, through EditOnRowClick, or through StartEditAsync. Enter commits, Escape cancels. Cancel restores the values the row held when editing started, onto the same instance. Cell and Batch modes use independent edit models; see the cell and batch editing guide.") </ApiParameter>
                <ApiParameter Name="EditOnRowClick" Type="bool" Default="false"> @L.T("点击某行让该行进入编辑态。若网格同时会在行点击时做选择，就关掉它，否则一次点击会同时做两件事。", "Clicking a row puts it into edit. Leave this off when the grid also selects on row click, or a click would do both.") </ApiParameter>
                <ApiParameter Name="OnRowCommit" Type="EventCallback&lt;DataGridRowCommitContext&lt;TData&gt;&gt;"> @L.T("在一行的编辑提交之后、该行关闭之前调用。数据项此时已经带上改动。把 context.Cancel 置为 true 可以让行保持编辑态——例如服务端拒绝保存时——用户输入的内容因此原样保留。经由该行 EditContext 的校验先执行，所以模型上的 DataAnnotations 原样生效。", "Called when a row's edits are committed, before the row closes. The item already carries the changes. Set context.Cancel to keep the row in edit — for instance when a save is rejected by the server — so the user keeps their typing. Validation through the row's EditContext runs first, so DataAnnotations on the model apply unchanged.") </ApiParameter>
                <ApiParameter Name="OnRowCancel" Type="EventCallback&lt;TData&gt;"> @L.T("在一行的编辑被丢弃、并且原值已经放回去之后调用。", "Called when a row's edits are discarded, after the original values are put back.") </ApiParameter>
                <ApiParameter Name="ShowGroupingBreadcrumb" Type="bool" Default="true"> @L.T("在网格上方显示当前分组各层级的面包屑，每一级都带有去掉它或向外移动一级的控件。只在已有分组时出现。它是查看并修改嵌套分组的实用办法——超过两级之后，从各列菜单里读出顺序就不再可行了。当页面固定了分组、不希望用户改动时设为 false。", "Shows a breadcrumb of the active grouping levels above the grid, with a control on each to remove it or move it outward. Only appears while something is grouped. It is the practical way to see and change a nested grouping — past two levels, reading the order out of the per-column menus stops working. Set it false when the page fixes the grouping and the user should not change it.") </ApiParameter>
                <ApiParameter Name="ShowExport" Type="bool" Default="false"> @L.T("在工具栏中渲染一个导出按钮，把行下载为 CSV。导出的是用户所见的内容：在当前搜索、筛选与排序之后仍然保留的行，覆盖所有分页，只取可见列并保持当前顺序，写入每列的显示值。选择列与展开列会被跳过。", "Renders an Export button in the toolbar that downloads the rows as CSV. It exports what the user sees: the rows that survive the current search, filters and sort, across every page, in the visible columns, in their current order, using each column's display value. Select and expand columns are skipped.") </ApiParameter>
                <ApiParameter Name="ExportFileName" Type="string" Default="export.csv"> @L.T("CSV 下载时提供的文件名。名称没有扩展名时会自动补上 .csv。", "The file name offered for the CSV download. A .csv extension is appended when the name has none.") </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="ExportDelimiter" Type="string" Default=",">
                        写入 CSV 值之间的字段分隔符。若当地的电子表格期望分号，就把它设为“;”——CSV 打开后每行都挤在一列里，通常就是这个原因。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="ExportDelimiter" Type="string" Default=",">
                        The field delimiter written between CSV values. Set it to ";" for locales whose spreadsheet expects a semicolon, which is the usual reason a CSV opens with every row crammed into one column.
                    </ApiParameter>
                                </text>
}
                <ApiParameter Name="ExportScope" Type="DataGridExportScope" Default="FilteredRows"> @L.T("导出写入哪些行。FilteredRows 覆盖在当前筛选、搜索与排序之后仍然保留的每一行，包括所有分页。CurrentPage 只保留屏幕上的这一页。由 ItemsProvider 支撑的网格只持有它取回的那一页，因此它导出那一页并记录一条警告。", "Which rows the export writes. FilteredRows covers every row that survives the current filters, search and sort, across all pages. CurrentPage narrows it to the page on screen. A grid backed by an ItemsProvider only holds the page it fetched, so it exports that page and logs a warning.") </ApiParameter>
                <ApiParameter Name="OnExport" Type="EventCallback&lt;string&gt;"> @L.T("导出完成后调用，带上已下载的 CSV 文本。无论如何下载都会发生。", "Called after an export completes, with the CSV text that was downloaded. The download happens either way.") </ApiParameter>
                <ApiParameter Name="SelectionMode" Type="DataTableSelectionMode" Default="None"> @L.T("选择模式：None、Single 或 Multiple。", "The selection mode: None, Single, or Multiple.") </ApiParameter>
                <ApiParameter Name="SelectionBehavior" Type="DataGridSelectionBehavior" Default="Toggle"> @L.T("点击某行如何改变选择。Toggle 是默认值，也是长期以来的行为，每次点击只翻转一行并忽略修饰键。Replace 提供用户从文件管理器带来的那套习惯：普通单击只选中被点击的行，Shift+Click 选中从锚点行起的区间，Ctrl+Click（macOS 上是 Cmd+Click）逐行增删；点击唯一选中的那行会清空选择。区间从锚点——最后一次普通单击或 Ctrl+Click 所在的行——起算，而不是从最后被选中的行起算，连续的 Shift+Click 都从同一个锚点重新延伸。区间选择与累加选择都需要 SelectionMode.Multiple，并且区间覆盖当前页的行。在两种行为之下，选择列的复选框以及空格键与回车键仍保持切换语义。", "How clicking a row changes the selection. Toggle, the default and the long-standing behaviour, flips one row per click and ignores modifier keys. Replace gives the conventions a user brings from a file explorer: a plain click selects only the clicked row, Shift+Click selects the range from the anchor row, and Ctrl+Click (Cmd+Click on macOS) adds or removes one row; clicking the only selected row clears the selection. The range extends from the anchor — the row of the last plain click or Ctrl+Click — not from the last selected row, and repeated Shift+Clicks re-extend from that same anchor. Range and additive selection need SelectionMode.Multiple, and a range covers the current page's rows. Select-column checkboxes and the Space and Enter keys keep toggle semantics under either behaviour.") </ApiParameter>
                <ApiParameter Name="SelectedItemsChanged" Type="EventCallback&lt;IReadOnlyCollection&lt;TData&gt;&gt;"> @L.T("已选项发生变化时调用的事件回调。", "Event callback invoked when the selected items change.") </ApiParameter>
                <ApiParameter Name="ShowPagination" Type="bool" Default="true"> @L.T("是否显示带有页面导航与每页条数选择器的分页底栏。", "Whether to show the pagination footer with page navigation and page size selector.") </ApiParameter>
                <ApiParameter Name="InitialPageSize" Type="int" Default="10"> @L.T("每页初始显示的行数。", "The initial number of rows per page.") </ApiParameter>
                <ApiParameter Name="PageSizes" Type="int[]" Default="[5, 10, 20, 50, 100]"> @L.T("分页选择器中可选的每页条数。", "The available page size options in the pagination selector.") </ApiParameter>
                <ApiParameter Name="IsLoading" Type="bool" Default="false"> @L.T("网格是否处于加载状态。显示加载模板或默认的加载指示器。", "Whether the grid is in a loading state. Shows loading template or default loading indicator.") </ApiParameter>
                <ApiParameter Name="Virtualize" Type="bool" Default="false"> @L.T("为大型数据集启用行虚拟化。只有可见的行会进入 DOM。需要一个固定高度的滚动容器。", "Enable row virtualization for large datasets. Only visible rows are rendered in the DOM. Requires a fixed-height scroll container.") </ApiParameter>
                <ApiParameter Name="StickyHeader" Type="bool" Default="false"> @L.T("滚动时让表头行保持可见。适用于放在固定高度滚动容器里的虚拟化网格。", "Keep the header row visible while scrolling. Useful with virtualized grids inside a fixed-height scroll container.") </ApiParameter>
                <ApiParameter Name="ItemSize" Type="float" Default="48"> @L.T("虚拟化使用的行高（像素）。Virtualize 组件用它来计算滚动位置。", "Row height in pixels for virtualization. Used by the Virtualize component to calculate scroll position.") </ApiParameter>
                <ApiParameter Name="EnableKeyboardNavigation" Type="bool" Default="true"> @L.T("为网格行启用键盘导航（方向键移动，Enter/Space 选择）。", "Enable keyboard navigation for grid rows (arrow keys to navigate, Enter/Space to select).") </ApiParameter>
                <ApiParameter Name="OnSort" Type="EventCallback&lt;IReadOnlyList&lt;SortDefinition&gt;&gt;"> @L.T("排序发生变化时调用的事件回调。收到当前生效的排序定义列表。", "Event callback invoked when sorting changes. Receives the list of active sort definitions.") </ApiParameter>
                <ApiParameter Name="OnFilter" Type="EventCallback&lt;IReadOnlyDictionary&lt;string, FilterCondition&gt;&gt;"> @L.T("列筛选发生变化时调用的事件回调。收到按列 ID 索引的生效筛选。", "Event callback invoked when column filters change. Receives the active filters keyed by column ID.") </ApiParameter>
                <ApiParameter Name="LoadingTemplate" Type="RenderFragment"> @L.T("IsLoading 为 true 时显示的自定义模板。它会取代默认的加载指示器。", "Custom template displayed when IsLoading is true. Replaces the default loading indicator.") </ApiParameter>
                <ApiParameter Name="EmptyTemplate" Type="RenderFragment"> @L.T("没有任何数据项时显示的自定义模板。它会取代默认的空状态。", "Custom template displayed when there are no data items. Replaces the default empty state.") </ApiParameter>
                <ApiParameter Name="Toolbar" Type="RenderFragment"> @L.T("渲染在网格上方的工具栏内容。适合放列可见性开关、搜索框或其他需要网格上下文的控件。", "Toolbar content rendered above the grid. Use for column visibility toggles, search inputs, or other controls that need grid context.") </ApiParameter>
                <ApiParameter Name="Resizable" Type="bool" Default="false"> @L.T("通过拖动表头单元格边框启用列缩放。", "Enable column resizing by dragging header cell borders.") </ApiParameter>
                <ApiParameter Name="MinColumnWidth" Type="int" Default="50"> @L.T("缩放时的最小列宽（像素）。", "Minimum column width in pixels when resizing.") </ApiParameter>
                <ApiParameter Name="OnColumnResize" Type="EventCallback&lt;(string ColumnId, string Width)&gt;"> @L.T("某列被缩放时调用的事件回调。", "Event callback invoked when a column is resized.") </ApiParameter>
                <ApiParameter Name="Reorderable" Type="bool" Default="false"> @L.T("通过拖动表头单元格启用列重排。", "Enable column reordering by dragging header cells.") </ApiParameter>
                <ApiParameter Name="OnColumnReorder" Type="EventCallback&lt;(string ColumnId, int NewIndex)&gt;"> @L.T("某列被重排时调用的事件回调。", "Event callback invoked when a column is reordered.") </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="State" Type="DataGridState&lt;TData&gt;">
                        用于受控模式的外部网格状态。配合 @@bind-State 使用，可双向绑定排序、分页与选择。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="State" Type="DataGridState&lt;TData&gt;">
                        External grid state for controlled mode. Use with @@bind-State for two-way binding of sorting, pagination, and selection.
                    </ApiParameter>
                                </text>
}
                <ApiParameter Name="AriaLabel" Type="string?"> @L.T("应用于网格元素、供屏幕阅读器使用的 ARIA 标签。", "ARIA label applied to the grid element for screen readers.") </ApiParameter>
                <ApiParameter Name="RowClass" Type="Func&lt;TData, string?&gt;?"> @L.T("用于给数据行应用自定义 CSS 类的可选回调。它收到该行的数据项，返回额外的 CSS 类。", "Optional callback for applying custom CSS classes to data rows. Receives the row's data item and returns additional CSS classes.") </ApiParameter>
                <ApiParameter Name="Class" Type="string?"> @L.T("应用于网格根容器元素的额外 CSS 类。", "Additional CSS classes applied to the grid's root container element.") </ApiParameter>
                <ApiParameter Name="Columns" Type="RenderFragment"> @L.T("网格的列定义。在这里放置 DataGridPropertyColumn、DataGridTemplateColumn 与 DataGridSelectColumn 组件。", "The column definitions for the grid. Place DataGridPropertyColumn, DataGridTemplateColumn, and DataGridSelectColumn components here.") </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="StateChanged" Type="EventCallback&lt;DataGridState&lt;TData&gt;&gt;">
                        网格状态发生变化时调用的事件回调。配合 @@bind-State 使用即可双向绑定。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="StateChanged" Type="EventCallback&lt;DataGridState&lt;TData&gt;&gt;">
                        Event callback invoked when the grid state changes. Use with @@bind-State for two-way binding.
                    </ApiParameter>
                                </text>
}
                <ApiParameter Name="DetailTemplate" Type="RenderFragment&lt;TData&gt;?"> @L.T("可展开行详情的模板。提供它之后，用 DataGridExpandColumn 为每行加上一个箭头开关。模板的上下文就是该行的数据项。", "Template for expandable row detail content. When provided, use DataGridExpandColumn to add a chevron toggle per row. The context provides the row's data item.") </ApiParameter>
                <ApiParameter Name="OnRowExpand" Type="EventCallback&lt;TData&gt;"> @L.T("某一行的详情区被展开时调用的事件回调。", "Event callback invoked when a row's detail section is expanded.") </ApiParameter>
                <ApiParameter Name="OnRowCollapse" Type="EventCallback&lt;TData&gt;"> @L.T("某一行的详情区被收起时调用的事件回调。", "Event callback invoked when a row's detail section is collapsed.") </ApiParameter>
                <ApiParameter Name="OnRowClick" Type="EventCallback&lt;TData&gt;"> @L.T("点击某个数据行时调用的事件回调。收到被点击行的数据项。", "Event callback invoked when a data row is clicked. Receives the clicked row's data item.") </ApiParameter>
                <ApiParameter Name="RowContextMenu" Type="RenderFragment&lt;DataGridRowMenuContext&lt;TData&gt;&gt;?"> @L.T("右键时渲染的自定义上下文菜单。上下文提供被点击的项、已选项、可见列，以及 CopyToClipboardAsync、FormatRow 与 FormatRows 辅助方法。", "Custom context menu rendered on right-click. The context provides the clicked item, selected items, visible columns, CopyToClipboardAsync, FormatRow, and FormatRows helpers.") </ApiParameter>
                <ApiParameter Name="ItemKey" Type="Func&lt;TData, object&gt;?"> @L.T("行标识的键选择器。供 Blazor 的差量比较算法高效渲染使用。未设置时回退到引用本身。", "Key selector for row identity. Used by Blazor's diffing algorithm for efficient rendering. When not set, falls back to the item reference.") </ApiParameter>
                <ApiParameter Name="GroupBy" Type="Expression&lt;Func&lt;TData, object&gt;&gt;?"> @L.T("用于给行分组的表达式。设置后，行按该表达式的值分组，并渲染可折叠的分组表头。", "Expression to group rows by. When set, rows are grouped by the value of this expression and collapsible group headers are rendered.") </ApiParameter>
                <ApiParameter Name="GroupHeaderTemplate" Type="RenderFragment&lt;DataGridGroupContext&lt;TData&gt;&gt;?"> @L.T("分组表头行的自定义模板。收到一个 DataGridGroupContext，其中带有分组数据、折叠状态与切换回调。", "Custom template for group header rows. Receives a DataGridGroupContext with group data, collapse state, and a toggle callback.") </ApiParameter>
                <ApiParameter Name="GroupsCollapsedByDefault" Type="bool" Default="false"> @L.T("首次应用分组时，分组是否应当默认折叠。", "Whether groups should be collapsed by default when grouping is first applied.") </ApiParameter>
                <ApiParameter Name="OnGroupExpand" Type="EventCallback&lt;DataGridGroupRow&lt;TData&gt;&gt;"> @L.T("某个分组被展开时调用的事件回调。收到该分组行的数据。", "Event callback invoked when a group is expanded. Receives the group row data.") </ApiParameter>
                <ApiParameter Name="OnGroupCollapse" Type="EventCallback&lt;DataGridGroupRow&lt;TData&gt;&gt;"> @L.T("某个分组被收起时调用的事件回调。收到该分组行的数据。", "Event callback invoked when a group is collapsed. Receives the group row data.") </ApiParameter>
                <ApiParameter Name="GroupedItemsProvider" Type="DataGridGroupedItemsProvider&lt;TData&gt;?"> @L.T("用于服务端分组取数的异步委托。设置它且分组生效时，网格会调用它而不是 ItemsProvider。", "Async delegate for server-side grouped data fetching. When set and grouping is active, called instead of ItemsProvider.") </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="ExpandAllGroups()" Type="Task">
                        公共方法。展开所有分组并显示它们的数据行。需通过组件引用（@@ref）调用。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="ExpandAllGroups()" Type="Task">
                        Public method. Expands all groups, showing their data rows. Call via a component reference (<code>@@ref</code>).
                    </ApiParameter>
                                </text>
}
                @if (L.IsChinese)
