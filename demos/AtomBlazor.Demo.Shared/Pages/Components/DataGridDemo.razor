    <!-- ── Row Grouping with Custom Header ──────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("自定义表头的行分组", "Row Grouping with Custom Header")</h2>
            @if (L.IsChinese)
            {
                        <text>
