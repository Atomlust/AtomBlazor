                            @if (L.IsChinese)
                            {
                                                        <text>
                                                            <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                                    直接下属（共 @member.DirectReports.Count 人）
                                </span>
                                                        </text>
}
                            else
                            {
                                                        <text>
                                                            <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                                    Direct Reports (@member.DirectReports.Count)
                                </span>
                                                        </text>
}
                        </DataGridDetailHeader>
                        @foreach (var report in member.DirectReports)
                        {
                            <DataGridDetailRow Item="@report" Class="text-muted-foreground" />
                        }
                    </DetailRows>
                </DataGridExpandColumn>
                <DataGridPropertyColumn TData="TeamMember" TProp="string" Property="@(m => m.Name)" Sortable />
                <DataGridPropertyColumn TData="TeamMember" TProp="string" Property="@(m => m.Title)" Title="@(L.T("职位名称", "Job Title"))" />
                <DataGridPropertyColumn TData="TeamMember" TProp="string" Property="@(m => m.Department)" Sortable />
                <DataGridPropertyColumn TData="TeamMember" TProp="int" Property="@(m => m.DirectReports.Count)" Title="@(L.T("直接下属数", "Reports"))" />
            </Columns>
        </DataGrid>
        <CodeBlock Source="Components/DataGrid/expandable-detail-rows.txt" />
    </div>

    <!-- ── Row Click & Context Menu ─────────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("行点击与右键菜单", "Row Click & Context Menu")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    用 <code class="bg-muted px-1 py-0.5 rounded">OnRowClick</code> 响应行点击，用
                    <code class="bg-muted px-1 py-0.5 rounded">RowContextMenu</code> 在右键时显示自定义上下文菜单。
                    上下文对象提供了 <code class="bg-muted px-1 py-0.5 rounded">CopyToClipboardAsync</code> 用于访问剪贴板，
                    <code class="bg-muted px-1 py-0.5 rounded">VisibleColumns</code> 用于按列拷贝，以及内置的
                    <code class="bg-muted px-1 py-0.5 rounded">FormatRow</code> / <code class="bg-muted px-1 py-0.5 rounded">FormatRows</code>
                    辅助方法——它们会自动遵循列的可见性与顺序。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use <code class="bg-muted px-1 py-0.5 rounded">OnRowClick</code> to respond to row clicks and
                    <code class="bg-muted px-1 py-0.5 rounded">RowContextMenu</code> to show a custom context menu on right-click.
                    The context provides <code class="bg-muted px-1 py-0.5 rounded">CopyToClipboardAsync</code> for clipboard access,
                    <code class="bg-muted px-1 py-0.5 rounded">VisibleColumns</code> for column-aware copying, and built-in
                    <code class="bg-muted px-1 py-0.5 rounded">FormatRow</code> / <code class="bg-muted px-1 py-0.5 rounded">FormatRows</code>
                    helpers that automatically respect column visibility and ordering.
                </p>
                        </text>
}
        </div>
        @if (!string.IsNullOrEmpty(clickedRowMessage))
        {
            <Alert Variant="AlertVariant.Default" Class="transition-all">
                @if (L.IsChinese)
                {
                                <text>
                                    <AlertDescription>@clickedRowMessageZh</AlertDescription>
                                </text>
}
                else
                {
                                <text>
                                    <AlertDescription>@clickedRowMessage</AlertDescription>
                                </text>
}
            </Alert>
        }
        <DataGrid TData="Person" Items="@people" InitialPageSize="5"
                    OnRowClick="HandleDemoRowClick">
            <RowContextMenu Context="menu">
                <AtomBlazor.ContextMenuItem OnClick="@(async () => await CopyWithFeedback(menu, menu.Item.Name))">
                    @L.T("复制姓名", "Copy Name")
                </AtomBlazor.ContextMenuItem>
                <AtomBlazor.ContextMenuItem OnClick="@(async () => await CopyWithFeedback(menu, menu.Item.Email))">
                    @L.T("复制邮箱", "Copy Email")
                </AtomBlazor.ContextMenuItem>
                <AtomBlazor.ContextMenuSeparator />
                <AtomBlazor.ContextMenuItem OnClick="@(async () => await CopyWithFeedback(menu, menu.FormatRow(menu.Item)))">
                    @L.T("复制整行", "Copy Row")
                </AtomBlazor.ContextMenuItem>
            </RowContextMenu>
            <Columns>
