@page "/components/datagrid"
@using AtomBlazor.Demo.Services
@using System.Text.Json
@inject MockDataService MockDataService
@inject IJSRuntime Js

<PageTitle>@L.T("Data Grid 组件 - Atom BlazorUI", "Data Grid Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-7xl">
    <div class="space-y-4">
        <h1 class="text-4xl font-bold tracking-tight">@L.T("Data Grid 组件", "Data Grid Component")</h1>
        <p class="text-xl text-muted-foreground">
            @L.T("面向表格数据的企业级数据网格，支持多列排序、分页、行选择、行虚拟化与完整的状态持久化。",
                 "An enterprise-grade data grid for tabular data with multi-column sorting, pagination, row selection, row virtualization, and full state persistence.")
        </p>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground leading-relaxed max-w-3xl">
                用声明式方式定义列：需要类型安全的数据绑定时使用 <code class="bg-muted px-1 py-0.5 rounded">DataGridPropertyColumn</code>，
                需要完全自定义单元格与表头内容时使用 <code class="bg-muted px-1 py-0.5 rounded">DataGridTemplateColumn</code>。
                网格同时支持内存集合与通过 <code class="bg-muted px-1 py-0.5 rounded">ItemsProvider</code> 提供的异步服务端数据，
                其中包含用于以 LINQ 组合排序与分页的 <code class="bg-muted px-1 py-0.5 rounded">IQueryable</code>。
                列可以拖拽缩放、拖放重排、固定到左侧或右侧边缘，并通过内置的可见性下拉菜单开启或关闭。
                使用 <code class="bg-muted px-1 py-0.5 rounded">@@bind-State</code> 配合
                <code class="bg-muted px-1 py-0.5 rounded">Save()</code> /
                <code class="bg-muted px-1 py-0.5 rounded">Restore()</code>，即可跨会话持久化完整的网格布局
                （排序顺序、列宽、列顺序、可见性与每页条数）。
                底层由无头 Primitives 构建以保障无障碍，样式使用 Tailwind CSS。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground leading-relaxed max-w-3xl">
                Define columns declaratively with <code class="bg-muted px-1 py-0.5 rounded">DataGridPropertyColumn</code> for
                type-safe data binding or <code class="bg-muted px-1 py-0.5 rounded">DataGridTemplateColumn</code> for fully
                custom cell and header content. The grid supports both in-memory collections and async server-side data via
                <code class="bg-muted px-1 py-0.5 rounded">ItemsProvider</code>, including
                <code class="bg-muted px-1 py-0.5 rounded">IQueryable</code> for LINQ-composed sorting and pagination.
                Columns can be resized by dragging, reordered via drag-and-drop, pinned to the left or right edge,
                and toggled on or off through a built-in visibility dropdown. Use
                <code class="bg-muted px-1 py-0.5 rounded">@@bind-State</code> with
                <code class="bg-muted px-1 py-0.5 rounded">Save()</code> /
                <code class="bg-muted px-1 py-0.5 rounded">Restore()</code> to persist the full grid layout
                (sort order, column widths, column order, visibility, and page size) across sessions.
                Built on headless Primitives for accessibility, with Tailwind CSS styling.
            </p>
                </text>
}
    </div>

    <!-- ── Basic DataGrid ──────────────────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("基础 DataGrid", "Basic DataGrid")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    使用 <code class="bg-muted px-1 py-0.5 rounded">DataGridPropertyColumn</code> 定义列，
                    并传入类型安全的 <code class="bg-muted px-1 py-0.5 rounded">Property</code> 表达式。
                    列标题默认由属性名自动推断。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Define columns using <code class="bg-muted px-1 py-0.5 rounded">DataGridPropertyColumn</code>
                    with a type-safe <code class="bg-muted px-1 py-0.5 rounded">Property</code> expression.
                    Column titles are auto-inferred from property names.
                </p>
                        </text>
}
        </div>
        <DataGrid TData="Person" Items="@people" InitialPageSize="5">
            <Columns>
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Name)" Sortable />
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Email)" Sortable />
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Department)" Sortable />
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Role)" />
                <DataGridPropertyColumn TData="Person" TProp="int" Property="@(p => p.Salary)" Format="C0" Sortable />
            </Columns>
        </DataGrid>
        <CodeBlock Source="Components/DataGrid/basic.txt" />
    </div>

    <!-- ── Multi-Column Sorting ────────────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("多列排序", "Multi-Column Sorting")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    点击表头即可排序。按住 <kbd class="bg-muted px-1 py-0.5 rounded text-xs">Ctrl</kbd>
                    并点击其他表头可执行多列排序。每个已排序列旁会显示优先级序号。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Click a column header to sort. Hold <kbd class="bg-muted px-1 py-0.5 rounded text-xs">Ctrl</kbd>
                    and click additional headers for multi-column sorting. Priority numbers appear next to each sorted column.
                </p>
                        </text>
}
        </div>
        <DataGrid TData="Person" Items="@people" InitialPageSize="5">
            <Columns>
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Department)" Sortable />
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Name)" Sortable />
                <DataGridPropertyColumn TData="Person" TProp="int" Property="@(p => p.Salary)" Format="C0" Sortable />
                <DataGridPropertyColumn TData="Person" TProp="int" Property="@(p => p.Age)" Sortable />
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Status)" Sortable />
            </Columns>
        </DataGrid>
        <CodeBlock Source="Components/DataGrid/multi-sort.txt" />
    </div>

    <!-- ── Column Filtering ──────────────────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("列筛选", "Column Filtering")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    给属性列加上 <code class="bg-muted px-1 py-0.5 rounded">Filterable="true"</code> 即可启用按列筛选。
                    表头中会出现一个筛选图标——悬停时显现，筛选生效时则保持可见。点击该图标会打开一个浮层，
                    其中包含运算符与取值输入框。筛选类型会依据属性类型自动推断（文本、数字、日期/日期时间、布尔、枚举）。
                    枚举列会根据类型自动生成下拉选项。可空类型（<code class="bg-muted px-1 py-0.5 rounded">DateTimeOffset?</code>、
                    <code class="bg-muted px-1 py-0.5 rounded">SeniorityLevel?</code>）额外提供“为空”运算符，用于查找 null 值。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Add <code class="bg-muted px-1 py-0.5 rounded">Filterable="true"</code> to property columns to enable
                    per-column filtering. A filter icon appears in the column header — hover to reveal it, or it stays
                    visible when a filter is active. Click the icon to open a popover with operator and value inputs.
                    Filter types are auto-inferred from the property type (text, number, date/datetime, boolean, enum).
                    Enum columns auto-generate dropdown options from the type. Nullable types (<code class="bg-muted px-1 py-0.5 rounded">DateTimeOffset?</code>,
                    <code class="bg-muted px-1 py-0.5 rounded">SeniorityLevel?</code>) include an "is empty" operator to find null values.
                </p>
                        </text>
}
        </div>
        @if (_gridState.Filtering.HasFilters)
        {
            <div class="flex items-center gap-2">
                <Badge Variant="BadgeVariant.Secondary">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            @_gridState.Filtering.ActiveFilterCount 个生效筛选
                                        </text>
}
                    else
                    {
                                        <text>
                                            @_gridState.Filtering.ActiveFilterCount active filter@(_gridState.Filtering.ActiveFilterCount != 1 ? "s" : "")
                                        </text>
}
                </Badge>
            </div>
        }
        <DataGrid TData="Person" Items="@people" InitialPageSize="5"
                   @bind-State="_gridState" Resizable="true">
            <Columns>
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Name)" Sortable Filterable Width="200px" />
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Email)" Sortable Filterable Width="250px" />
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Department)" Sortable Filterable
                    FilterType="FilterFieldType.Enum"
                    FilterOptions="@(new[] { "Engineering", "Sales", "Marketing", "Support", "HR", "Finance", "Operations", "Product" }.Select(d => new SelectOption<string>(d, d)))"
                    Width="150px" />
                <DataGridPropertyColumn TData="Person" TProp="int" Property="@(p => p.Age)" Sortable Filterable Width="100px" />
                <DataGridPropertyColumn TData="Person" TProp="int" Property="@(p => p.Salary)" Format="C0" Sortable Filterable Width="130px" />
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Status)" Sortable Filterable
                    FilterType="FilterFieldType.Enum"
                    FilterOptions="@(new[] { "Active", "Inactive", "Pending", "Suspended" }.Select(s => new SelectOption<string>(s, s)))"
                    Width="120px" />
                <DataGridPropertyColumn TData="Person" TProp="PersonStatus" Property="@(p => p.StatusEnum)" Title="@(L.T("状态（枚举）", "Status (Enum)"))" Sortable Filterable Width="140px" />
                <DataGridPropertyColumn TData="Person" TProp="SeniorityLevel?" Property="@(p => p.Seniority)" Title="@(L.T("职级", "Seniority"))" Sortable Filterable Width="130px" />
                <DataGridPropertyColumn TData="Person" TProp="DateTimeOffset?" Property="@(p => p.LastPromotionDate)" Title="@(L.T("最近晋升", "Last Promotion"))" Format="d" Sortable Filterable Width="160px" />
                <DataGridPropertyColumn TData="Person" TProp="DateTime" Property="@(p => p.JoinDate)" Title="@(L.T("入职日期", "Join Date"))" Sortable Filterable Format="d" Width="130px" />
                <DataGridPropertyColumn TData="Person" TProp="DateTime" Property="@(p => p.LastActivity)" Title="@(L.T("最近活动", "Last Activity"))" Sortable Filterable Format="g" Width="170px" />
                <DataGridPropertyColumn TData="Person" TProp="bool" Property="@(p => p.IsActive)" Title="@(L.T("激活", "Active"))" Sortable Filterable Width="100px" />
            </Columns>
        </DataGrid>
        <CodeBlock Source="Components/DataGrid/column-filtering.txt" />
    </div>

    <!-- ── Inline Row Editing ─────────────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("行内编辑", "Inline Row Editing")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    设置 <code class="bg-muted px-1 py-0.5 rounded">EditMode="DataGridEditMode.Row"</code>，给用户可修改的每一列
                    配上 <code class="bg-muted px-1 py-0.5 rounded">EditTemplate</code>，再加一个
                    <code class="bg-muted px-1 py-0.5 rounded">DataGridEditColumn</code> 提供编辑、保存与取消按钮。
                    模板直接绑定到该行，因此一个普通的 <code class="bg-muted px-1 py-0.5 rounded">@@bind-Value</code> 就够了。
                </p>
                <p class="text-sm text-muted-foreground">
                    按 <strong>Enter</strong> 保存，按 <strong>Escape</strong> 取消，无需去点按钮。
                    取消会把原值放回去，所以不必手工复制。没有编辑模板的列继续显示常规单元格——下面的 Department 是只读的。
                    <code class="bg-muted px-1 py-0.5 rounded">OnRowCommit</code> 可以拒绝保存并让该行保持打开、
                    同时保留用户已输入的内容；试试清空姓名再保存。校验经由该行自己的
                    <code class="bg-muted px-1 py-0.5 rounded">EditContext</code>，因此模型上的
                    <code class="bg-muted px-1 py-0.5 rounded">DataAnnotations</code> 原样生效。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Set <code class="bg-muted px-1 py-0.5 rounded">EditMode="DataGridEditMode.Row"</code>, give each
                    column the user may change an <code class="bg-muted px-1 py-0.5 rounded">EditTemplate</code>, and
                    add a <code class="bg-muted px-1 py-0.5 rounded">DataGridEditColumn</code> for the Edit, Save and
                    Cancel buttons. The template binds straight to the row, so an ordinary
                    <code class="bg-muted px-1 py-0.5 rounded">@@bind-Value</code> is all it takes.
                </p>
                <p class="text-sm text-muted-foreground">
                    Press <strong>Enter</strong> to save or <strong>Escape</strong> to cancel without reaching for the
                    buttons. Cancel puts the original values back, so nothing needs copying by hand. A column with no
                    edit template keeps showing its normal cell — Department below is read-only.
                    <code class="bg-muted px-1 py-0.5 rounded">OnRowCommit</code> can refuse the save and keep the row
                    open with the user's typing intact; try clearing a name and saving.
                    Validation runs through the row's own <code class="bg-muted px-1 py-0.5 rounded">EditContext</code>,
                    so <code class="bg-muted px-1 py-0.5 rounded">DataAnnotations</code> on your model apply unchanged.
                </p>
                        </text>
}
        </div>
        <DataGrid TData="Person" Items="@editablePeople" InitialPageSize="6"
                   EditMode="DataGridEditMode.Row"
                   OnRowCommit="HandleRowCommit"
                   OnRowCancel="HandleRowCancel">
            <Columns>
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Name)" Sortable Width="220px">
                    <EditTemplate>
                        <Input @bind-Value="context.Name" Class="h-8" />
                    </EditTemplate>
                </DataGridPropertyColumn>
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Department)" Sortable Width="150px" />
                <DataGridPropertyColumn TData="Person" TProp="int" Property="@(p => p.Age)" Sortable Width="120px">
                    <EditTemplate>
                        <NumericInput TValue="int" @bind-Value="context.Age" Class="h-8" />
                    </EditTemplate>
                </DataGridPropertyColumn>
                <DataGridPropertyColumn TData="Person" TProp="int" Property="@(p => p.Salary)" Format="C0" Sortable Width="150px">
                    <EditTemplate>
                        <NumericInput TValue="int" @bind-Value="context.Salary" Class="h-8" />
                    </EditTemplate>
                </DataGridPropertyColumn>
                <DataGridEditColumn TData="Person" />
            </Columns>
        </DataGrid>
        @if (_editMessage != null)
        {
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">@_editMessageZh</p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">@_editMessage</p>
                        </text>
}
        }
        <CodeBlock Source="Components/DataGrid/inline-row-editing.txt" />
    </div>

    @if (L.IsChinese)
    {
        <text>
            <p><a href="/components/datagrid-editing" class="text-primary underline">继续了解单元格与批量编辑</a>，其中包含独立草稿、校验与事务式保存回调。</p>
        </text>
}
    else
    {
        <text>
            <p><a href="/components/datagrid-editing" class="text-primary underline">Explore cell and batch editing</a> for isolated drafts, validation and transactional save callbacks.</p>
        </text>
}

    <!-- ── CSV Export ─────────────────────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("CSV 导出", "CSV Export")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    设置 <code class="bg-muted px-1 py-0.5 rounded">ShowExport="true"</code>，工具栏就会出现导出按钮。
                    导出的是用户此刻看到的内容：经过当前搜索、筛选与排序后保留下来的行，按可见列、按当前顺序——
                    覆盖所有页，而不只是屏幕上的这一页。
                </p>
                <p class="text-sm text-muted-foreground">
                    先搜索或重排列，再导出，文件就会随之变化。Status 列导出的是它的标签而不是背后的数字，
                    因为它设置了 <code class="bg-muted px-1 py-0.5 rounded">SortAndFilterBy</code>。
                    在网格引用上调用 <code class="bg-muted px-1 py-0.5 rounded">ExportToCsvAsync()</code>
                    就能用你自己的按钮导出；改用 <code class="bg-muted px-1 py-0.5 rounded">BuildCsv()</code>
                    可以只取文本而不触发下载。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Set <code class="bg-muted px-1 py-0.5 rounded">ShowExport="true"</code> to put an Export button
                    in the toolbar. It downloads what the user sees: the rows that survive the current search,
                    filters and sort, in the visible columns, in their current order — across every page, not just
                    the one on screen.
                </p>
                <p class="text-sm text-muted-foreground">
                    Search or reorder the columns first, then export, and the file follows. The Status column
                    exports its label rather than the number behind it, because it sets
                    <code class="bg-muted px-1 py-0.5 rounded">SortAndFilterBy</code>. Call
                    <code class="bg-muted px-1 py-0.5 rounded">ExportToCsvAsync()</code> on a grid reference to
                    export from a button of your own, or
                    <code class="bg-muted px-1 py-0.5 rounded">BuildCsv()</code> to get the text without
                    downloading it.
                </p>
                        </text>
}
        </div>
        <DataGrid @ref="exportGrid" TData="Person" Items="@people" InitialPageSize="5"
                   ShowSearch="true" ShowExport="true" ExportFileName="employees.csv"
                   Resizable="true" Reorderable="true">
            <Columns>
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Name)" Sortable Filterable />
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Email)" Filterable />
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Department)" Sortable Filterable />
                <DataGridPropertyColumn TData="Person" TProp="int" Property="@(p => p.Id)" Id="export-office"
                    Title="@(L.T("办公地点", "Office"))" Sortable Filterable
                    SortAndFilterBy="@(p => OfficeFor(p))">
                    <CellTemplate>@OfficeFor(context)</CellTemplate>
                </DataGridPropertyColumn>
                <DataGridPropertyColumn TData="Person" TProp="int" Property="@(p => p.Salary)" Format="C0" Sortable Filterable />
            </Columns>
        </DataGrid>
        <div class="space-y-2">
            <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" OnClick="ShowCsvPreview">
                @L.T("预览 CSV 而不是直接下载", "Preview the CSV instead of downloading")
            </Button>
            @if (_csvPreview != null)
            {
                <pre class="max-h-48 overflow-auto rounded-md border bg-muted p-3 text-xs">@_csvPreview</pre>
            }
        </div>
        <CodeBlock Source="Components/DataGrid/csv-export.txt" />
    </div>

    <!-- ── Sort and Filter by a Different Value ────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("按不同的值排序与筛选", "Sort and Filter by a Different Value")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    一列显示的内容若并非它的原始属性——最常见的情形就是用
                    <code class="bg-muted px-1 py-0.5 rounded">CellTemplate</code> 把键解析成标签——默认仍然按那个键排序与筛选。
                    用户看到的是办公地点名称，点击表头，行却按一个他们看不见的数字重排。
                    <code class="bg-muted px-1 py-0.5 rounded">SortAndFilterBy</code> 让排序、筛选、分组与搜索改为指向该列显示的值。
                    一个参数管住这四件事，它们因此不可能各说各话。
                </p>
                <p class="text-sm text-muted-foreground">
                    把下面两列各排一次序对比看看。两者解析的是同一个办公地点，但只有第二列会按地点名称的字母顺序排列。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    A column that displays something other than its raw property — the common case being a
                    <code class="bg-muted px-1 py-0.5 rounded">CellTemplate</code> that resolves a key to a label —
                    still sorts and filters on the key by default. The user sees office names, clicks the header,
                    and the rows reorder by a number they cannot see.
                    <code class="bg-muted px-1 py-0.5 rounded">SortAndFilterBy</code> points sorting, filtering,
                    grouping and search at the value the column displays instead. One parameter covers all four,
                    so they cannot disagree.
                </p>
                <p class="text-sm text-muted-foreground">
                    Sort the two columns below and compare them. Both resolve the same office, but only the second
                    orders alphabetically by office name.
                </p>
                        </text>
}
        </div>
        <DataGrid TData="Person" Items="@people" InitialPageSize="5">
            <Columns>
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Name)" Sortable Width="200px" />
                <DataGridPropertyColumn TData="Person" TProp="int" Property="@(p => p.Id)" Title="@(L.T("办公地点（按 id 排序）", "Office (sorts by id)"))"
                    Sortable Width="180px">
                    <CellTemplate>
                        <Badge Variant="BadgeVariant.Secondary">@OfficeFor(context)</Badge>
                    </CellTemplate>
                </DataGridPropertyColumn>
                <DataGridPropertyColumn TData="Person" TProp="int" Property="@(p => p.Id)" Id="office-by-name"
                    Title="@(L.T("办公地点（按名称排序）", "Office (sorts by name)"))" Sortable Filterable Groupable Width="200px"
                    SortAndFilterBy="@(p => OfficeFor(p))"
                    FilterType="FilterFieldType.Enum"
                    FilterOptions="@(officeNames.Select(o => new SelectOption<string>(o, o)))">
                    <CellTemplate>
                        <Badge Variant="BadgeVariant.Secondary">@OfficeFor(context)</Badge>
                    </CellTemplate>
                </DataGridPropertyColumn>
