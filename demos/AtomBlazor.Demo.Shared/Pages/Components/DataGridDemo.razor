    <!-- ── State Persistence ──────────────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("状态持久化", "State Persistence")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    用 <code class="bg-muted px-1 py-0.5 rounded">Save()</code> 抓取一份可序列化快照，
                    里面包含排序顺序、列宽、列可见性、每页条数以及当前分组。用
                    <code class="bg-muted px-1 py-0.5 rounded">Restore(snapshot)</code> 再把它应用回去。
                    快照就是普通的可 JSON 序列化对象——可以存进 localStorage、数据库或用户偏好设置。
                    试试从 Department 的表头菜单按它分组，保存，取消分组，然后再恢复。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use <code class="bg-muted px-1 py-0.5 rounded">Save()</code> to capture a serializable
                    snapshot of sort order, column widths, column visibility, page size, and the active grouping.
                    Use <code class="bg-muted px-1 py-0.5 rounded">Restore(snapshot)</code> to reapply it.
                    Snapshots are plain JSON-serializable objects — store them in localStorage, a database, or user preferences.
                    Try grouping by Department from its header menu, saving, ungrouping, then restoring.
                </p>
                        </text>
}
        </div>
        <DataGrid TData="Person" Items="@people" InitialPageSize="5"
                   @bind-State="persistenceState"
                   Resizable="true" Reorderable="true">
            <Toolbar>
                <div class="flex items-center gap-2">
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="SaveGridState">
                        @L.T("保存状态", "Save State")
                    </Button>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="RestoreGridState"
                              Disabled="@(!hasSavedState)">
                        @L.T("恢复状态", "Restore State")
                    </Button>
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="ResetGridState">
                        @L.T("重置", "Reset")
                    </Button>
                </div>
            </Toolbar>
            <Columns>
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Name)" Sortable Width="180px" />
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Department)" Sortable Groupable Width="150px" />
                <DataGridPropertyColumn TData="Person" TProp="int" Property="@(p => p.Salary)" Format="C0" Sortable Width="120px" />
                <DataGridPropertyColumn TData="Person" TProp="int" Property="@(p => p.Age)" Sortable Width="80px" />
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Status)" Width="120px" />
            </Columns>
        </DataGrid>
        @if (hasSavedState)
        {
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-xs text-muted-foreground">状态已保存到 localStorage。</p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-xs text-muted-foreground">State saved to localStorage.</p>
                        </text>
}
        }
        <CodeBlock Source="Components/DataGrid/state-persistence.txt" />
    </div>

    <!-- ── Row Grouping ─────────────────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("行分组", "Row Grouping")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    用 <code class="bg-muted px-1 py-0.5 rounded">GroupBy</code> 按某个列值给行分组。
                    分组可以折叠并显示条目数。点击箭头即可展开或收起某个分组。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Group rows by a column value using <code class="bg-muted px-1 py-0.5 rounded">GroupBy</code>.
                    Groups are collapsible and show item counts. Click the chevron to expand or collapse a group.
                </p>
                        </text>
}
        </div>
        <DataGrid @ref="groupingGrid" TData="Person" Items="@people" GroupBy="@(p => (object)p.Department)" InitialPageSize="50">
            <Toolbar>
                <div class="flex items-center gap-2">
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                              OnClick="@(() => groupingGrid!.ExpandAllGroups())">
                        <LucideIcon Name="chevrons-down" Class="w-4 h-4 mr-1" /> @L.T("全部展开", "Expand All")
