                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                              OnClick="@(() => groupingGrid!.CollapseAllGroups())">
                        <LucideIcon Name="chevrons-up" Class="w-4 h-4 mr-1" /> @L.T("全部收起", "Collapse All")
                    </Button>
                </div>
            </Toolbar>
            <Columns>
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Name)" Sortable />
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Department)" Sortable />
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Role)" />
                <DataGridPropertyColumn TData="Person" TProp="int" Property="@(p => p.Salary)" Format="C0" Sortable />
            </Columns>
        </DataGrid>
        <CodeBlock Source="Components/DataGrid/row-grouping.txt" />
    </div>

    <!-- ── Row Grouping with Aggregates ─────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("带聚合的行分组", "Row Grouping with Aggregates")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    给属性列加上 <code class="bg-muted px-1 py-0.5 rounded">Aggregate</code>，
                    就能在分组表头里显示计算值（求和、平均值、最小值、最大值、计数）。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Add <code class="bg-muted px-1 py-0.5 rounded">Aggregate</code> to property columns to show
                    computed values (Sum, Average, Min, Max, Count) in the group header.
                </p>
                        </text>
}
        </div>
        <DataGrid TData="Person" Items="@people" GroupBy="@(p => (object)p.Department)" ShowPagination InitialPageSize="10">
            <Columns>
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Name)" Sortable />
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Department)" Sortable />
