    <!-- ── Expandable Rows: Nested Table ─────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("可展开行：嵌套表格", "Expandable Rows: Nested Table")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    <code class="bg-muted px-1 py-0.5 rounded">DetailTemplate</code> 可以承载任意内容，
                    也包括嵌套表格。这个示例展示父任务展开后列出它的子任务，子任务有自己的一组列。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    The <code class="bg-muted px-1 py-0.5 rounded">DetailTemplate</code> can contain any content,
                    including a nested table. This example shows parent tasks that expand to reveal their subtasks
                    with their own set of columns.
                </p>
                        </text>
}
        </div>
        <DataGrid TData="ProjectTask" Items="@projectTasks" InitialPageSize="5" ShowPagination="false">
            <Columns>
                <DataGridExpandColumn />
                <DataGridPropertyColumn TData="ProjectTask" TProp="string" Property="@(t => t.Title)" Title="@(L.T("任务", "Task"))" />
                <DataGridPropertyColumn TData="ProjectTask" TProp="string" Property="@(t => t.Assignee)" />
                <DataGridPropertyColumn TData="ProjectTask" TProp="string" Property="@(t => t.Status)" />
                <DataGridPropertyColumn TData="ProjectTask" TProp="string" Property="@(t => t.Priority)" />
            </Columns>
            <DetailTemplate>
                <div class="pl-4">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            <p class="text-sm font-medium mb-2 text-muted-foreground">子任务（共 @context.Subtasks.Count 项）</p>
                                        </text>
}
                    else
                    {
                                        <text>
                                            <p class="text-sm font-medium mb-2 text-muted-foreground">Subtasks (@context.Subtasks.Count)</p>
                                        </text>
}
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b">
                                <th class="py-2 px-3 text-left font-medium text-muted-foreground">@L.T("子任务", "Subtask")</th>
                                <th class="py-2 px-3 text-left font-medium text-muted-foreground">@L.T("负责人", "Assignee")</th>
                                <th class="py-2 px-3 text-left font-medium text-muted-foreground">@L.T("状态", "Status")</th>
                                <th class="py-2 px-3 text-right font-medium text-muted-foreground">@L.T("工时", "Hours")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sub in context.Subtasks)
                            {
                                <tr class="border-b last:border-0">
                                    <td class="py-2 px-3">@sub.Title</td>
                                    <td class="py-2 px-3">@sub.Assignee</td>
                                    <td class="py-2 px-3">
                                        <Badge Variant="@GetSubtaskBadge(sub.Status)">@sub.Status</Badge>
                                    </td>
                                    <td class="py-2 px-3 text-right tabular-nums">@sub.EstimatedHours @L.T("小时", "h")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </DetailTemplate>
        </DataGrid>
        <CodeBlock Source="Components/DataGrid/expandable-nested-table.txt" />
    </div>

    <!-- ── Expandable Rows: Detail Rows ──────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("可展开行：详情行", "Expandable Rows: Detail Rows")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    在 <code class="bg-muted px-1 py-0.5 rounded">DataGridExpandColumn</code> 上使用
                    <code class="bg-muted px-1 py-0.5 rounded">DetailRows</code>，可以把子项渲染成真正的表格行，
                    并与父网格的列对齐。每个子项用一个
                    <code class="bg-muted px-1 py-0.5 rounded">DataGridDetailRow</code>，可选的分节标签则用
                    <code class="bg-muted px-1 py-0.5 rounded">DataGridDetailHeader</code>。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use <code class="bg-muted px-1 py-0.5 rounded">DetailRows</code> on the
                    <code class="bg-muted px-1 py-0.5 rounded">DataGridExpandColumn</code> to render child items
                    as proper table rows that align with the parent grid's columns. Use
                    <code class="bg-muted px-1 py-0.5 rounded">DataGridDetailRow</code> for each child item and
                    <code class="bg-muted px-1 py-0.5 rounded">DataGridDetailHeader</code> for an optional section label.
                </p>
                        </text>
}
        </div>
        <DataGrid TData="TeamMember" Items="@teamMembers" InitialPageSize="5" ShowPagination="false">
            <Columns>
                <DataGridExpandColumn>
                    <DetailRows Context="member">
