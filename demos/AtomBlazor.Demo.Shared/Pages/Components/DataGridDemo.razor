    <!-- ── Grouping + Filtering + Sorting ───────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("分组 + 筛选 + 排序", "Grouping + Filtering + Sorting")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("分组可与筛选、排序同时使用。筛选先于分组应用（被筛掉的条目不会进入任何分组），排序则在每个分组内部生效。", "Grouping works with filtering and sorting. Filters are applied before grouping (filtered-out items excluded from groups). Sort applies within each group.")
            </p>
        </div>
        <DataGrid TData="Person" Items="@people" GroupBy="@(p => (object)p.Department)" InitialPageSize="50">
            <Columns>
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Name)" Sortable Filterable />
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Department)" Sortable Filterable />
                <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Status)" Sortable Filterable />
                <DataGridPropertyColumn TData="Person" TProp="int" Property="@(p => p.Salary)" Format="C0" Sortable
                    Aggregate="AtomBlazor.Primitives.AggregateFunction.Sum" />
            </Columns>
        </DataGrid>
        <CodeBlock Source="Components/DataGrid/row-grouping-filtering.txt" />
