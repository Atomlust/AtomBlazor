                                <text>
                                    <ApiParameter Name="CollapseAllGroups()" Type="Task">
                        公共方法。收起所有分组并隐藏它们的数据行。需通过组件引用（@@ref）调用。
                    </ApiParameter>
                                </text>
}
                else
