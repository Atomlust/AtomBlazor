                        <DataGridPropertyColumn TData="Person" TProp="int" Property="@(p => p.Id)" Title="#" Width="80px" Sortable Reorderable="false" />
                        <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Name)" Sortable Width="200px" />
                        <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Email)" Width="250px" />
                        <DataGridPropertyColumn TData="Person" TProp="int" Property="@(p => p.Age)" Sortable Width="80px" />
                        <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Role)" Sortable Width="150px" />
                        <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Department)" Sortable Width="150px" />
                        <DataGridPropertyColumn TData="Person" TProp="int" Property="@(p => p.Salary)" Format="C0" Sortable Width="120px" />
                        <DataGridPropertyColumn TData="Person" TProp="string" Property="@(p => p.Status)" Sortable Width="100px" />
