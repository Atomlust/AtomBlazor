@page "/components/alert"
@using AtomBlazor.Icons.Lucide

<PageTitle>@L.T("Alert 提示 - Atom BlazorUI", "Alert Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("Alert 提示", "Alert Component")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("以醒目样式块呈现重要信息，便于用户快速留意。", "Displays a callout for important messages that attract user attention.")
            </p>
        </div>
    </div>

    <!-- All Variants -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("变体", "Variants")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("五种语义化变体，对应不同类型的消息。", "Five semantic variants for different message types.")
            </p>
        </div>
        <div class="space-y-4">
            <!-- Default -->
            <Alert>
                <Icon>
                    <LucideIcon Name="terminal" Class="h-4 w-4" />
                </Icon>
                <ChildContent>
                    <AlertTitle>@L.T("默认", "Default")</AlertTitle>
                    <AlertDescription>
                        @L.T("中性的通用信息提示。", "A neutral alert for general informational messages.")
                    </AlertDescription>
                </ChildContent>
            </Alert>

            <!-- Success -->
            <Alert Variant="AlertVariant.Success">
                <Icon>
                    <LucideIcon Name="circle-check" Class="h-4 w-4" />
                </Icon>
                <ChildContent>
                    <AlertTitle>@L.T("成功", "Success")</AlertTitle>
                    <AlertDescription>
                        @L.T("你的更改已成功保存。", "Your changes have been saved successfully.")
                    </AlertDescription>
                </ChildContent>
            </Alert>

            <!-- Info -->
            <Alert Variant="AlertVariant.Info">
                <Icon>
                    <LucideIcon Name="info" Class="h-4 w-4" />
                </Icon>
                <ChildContent>
                    <AlertTitle>@L.T("信息", "Information")</AlertTitle>
                    <AlertDescription>
                        @L.T("此功能目前处于测试阶段，部分能力可能调整。", "This feature is currently in beta. Some functionality may change.")
                    </AlertDescription>
                </ChildContent>
            </Alert>

            <!-- Warning -->
            <Alert Variant="AlertVariant.Warning">
                <Icon>
                    <LucideIcon Name="triangle-alert" Class="h-4 w-4" />
                </Icon>
                <ChildContent>
                    <AlertTitle>@L.T("警告", "Warning")</AlertTitle>
                    <AlertDescription>
                        @L.T("你的账户即将达到存储上限。", "Your account is approaching its storage limit.")
                    </AlertDescription>
                </ChildContent>
            </Alert>

            <!-- Danger -->
            <Alert Variant="AlertVariant.Danger">
                <Icon>
                    <LucideIcon Name="circle-alert" Class="h-4 w-4" />
                </Icon>
                <ChildContent>
                    <AlertTitle>@L.T("危险", "Danger")</AlertTitle>
                    <AlertDescription>
                        @L.T("会话已过期，请重新登录。", "Your session has expired. Please log in again.")
                    </AlertDescription>
                </ChildContent>
            </Alert>
        </div>

        <CodeBlock Source="Components/Alert/variants.txt" />
    </div>

    <!-- With Accent Border -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("带强调边框", "With Accent Border")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    设置 <code class="text-xs bg-muted px-1 py-0.5 rounded">AccentBorder="true"</code>，以粗左边框搭配轻微着色背景展示提示。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use <code class="text-xs bg-muted px-1 py-0.5 rounded">AccentBorder="true"</code> to display a thick left border with a subtle tinted background.
                </p>
                        </text>
}
        </div>
        <div class="space-y-4">
            <Alert Variant="AlertVariant.Warning" AccentBorder="true">
                <Icon>
                    <LucideIcon Name="triangle-alert" Class="h-4 w-4" />
                </Icon>
                <ChildContent>
                    <AlertTitle>@L.T("注意", "Note")</AlertTitle>
                    @if (L.IsChinese)
                    {
                                        <text>
                                            <AlertDescription>
                            每个组件都有自己的命名空间（例如 <code class="text-xs bg-muted px-1 py-0.5 rounded">AtomBlazor.Button</code>、<code class="text-xs bg-muted px-1 py-0.5 rounded">AtomBlazor.Dialog</code>）。只导入用到的组件，保持引用整洁。
                        </AlertDescription>
                                        </text>
}
                    else
                    {
                                        <text>
                                            <AlertDescription>
                            Each component has its own namespace (e.g., <code class="text-xs bg-muted px-1 py-0.5 rounded">AtomBlazor.Button</code>, <code class="text-xs bg-muted px-1 py-0.5 rounded">AtomBlazor.Dialog</code>). Import only the components you use to keep your imports clean.
                        </AlertDescription>
                                        </text>
}
                </ChildContent>
            </Alert>

            <Alert Variant="AlertVariant.Info" AccentBorder="true">
                <Icon>
                    <LucideIcon Name="info" Class="h-4 w-4" />
                </Icon>
                <ChildContent>
                    <AlertTitle>@L.T("小贴士", "Tip")</AlertTitle>
                    <AlertDescription>
                        @L.T("可在主题文件中修改 CSS 变量来自定义主题色。", "You can customize the theme colors by modifying the CSS variables in your theme file.")
                    </AlertDescription>
                </ChildContent>
            </Alert>

            <Alert Variant="AlertVariant.Danger" AccentBorder="true">
                <Icon>
                    <LucideIcon Name="circle-alert" Class="h-4 w-4" />
                </Icon>
                <ChildContent>
                    <AlertTitle>@L.T("破坏性变更", "Breaking Change")</AlertTitle>
                    @if (L.IsChinese)
                    {
                                        <text>
                                            <AlertDescription>
                            <code class="text-xs bg-muted px-1 py-0.5 rounded">Destructive</code> 变体已被 <code class="text-xs bg-muted px-1 py-0.5 rounded">Danger</code> 取代。
                        </AlertDescription>
                                        </text>
}
                    else
                    {
                                        <text>
                                            <AlertDescription>
                            The <code class="text-xs bg-muted px-1 py-0.5 rounded">Destructive</code> variant has been replaced with <code class="text-xs bg-muted px-1 py-0.5 rounded">Danger</code>.
                        </AlertDescription>
                                        </text>
}
                </ChildContent>
            </Alert>
        </div>

        <CodeBlock Source="Components/Alert/accent-border.txt" />
    </div>

    <!-- Without Icons -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("不带图标", "Without Icons")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("不带图标也能使用提示，适合更简短的信息。", "Alerts can be used without icons for simpler messages.")
            </p>
        </div>
        <div class="space-y-4">
            <Alert>
                <AlertTitle>@L.T("提醒！", "Heads up!")</AlertTitle>
                <AlertDescription>
                    @L.T("可通过 CLI 为应用添加组件。", "You can add components to your app using the CLI.")
                </AlertDescription>
            </Alert>

            <Alert Variant="AlertVariant.Warning" AccentBorder="true">
                <AlertTitle>@L.T("注意", "Note")</AlertTitle>
                <AlertDescription>
                    @L.T("离开页面前记得保存工作。", "Remember to save your work before leaving the page.")
                </AlertDescription>
            </Alert>
        </div>

        <CodeBlock Source="Components/Alert/without-icons.txt" />
    </div>

    <!-- Dismissible -->
    <div class="space-y-4">
        <div class="space-y-2">
            <div class="flex items-center gap-2">
                <h2 class="text-2xl font-semibold">@L.T("可关闭", "Dismissible")</h2>
                <span class="inline-flex items-center rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary ring-1 ring-inset ring-primary/20">v3</span>
            </div>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    设置 <code class="text-xs bg-muted px-1 py-0.5 rounded">Dismissible="true"</code> 以显示关闭按钮。处理 <code class="text-xs bg-muted px-1 py-0.5 rounded">OnDismiss</code> 回调来移除或隐藏提示。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use <code class="text-xs bg-muted px-1 py-0.5 rounded">Dismissible="true"</code> to show a close button. Handle the <code class="text-xs bg-muted px-1 py-0.5 rounded">OnDismiss</code> callback to remove or hide the alert.
                </p>
                        </text>
}
        </div>
        <div class="space-y-4">
            @if (_showDismissibleAlert)
            {
                <Alert Variant="AlertVariant.Info" Dismissible="true" OnDismiss="@(() => _showDismissibleAlert = false)">
                    <Icon>
                        <LucideIcon Name="info" Class="h-4 w-4" />
                    </Icon>
                    <ChildContent>
                        <AlertTitle>@L.T("可关闭提示", "Dismissible Alert")</AlertTitle>
                        <AlertDescription>
                            @L.T("点击 X 按钮即可关闭此提示。", "Click the X button to dismiss this alert.")
                        </AlertDescription>
                    </ChildContent>
                </Alert>
            }
            else
            {
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => _showDismissibleAlert = true)">
                    @L.T("再次显示提示", "Show Alert Again")
                </Button>
            }

            <Alert Variant="AlertVariant.Warning" Dismissible="true" AccentBorder="true">
                <Icon>
                    <LucideIcon Name="triangle-alert" Class="h-4 w-4" />
                </Icon>
                <ChildContent>
                    <AlertTitle>@L.T("警告", "Warning")</AlertTitle>
                    <AlertDescription>
                        @L.T("这条可关闭提示同样使用了强调边框样式。", "This dismissible alert also uses the accent border style.")
                    </AlertDescription>
                </ChildContent>
            </Alert>
        </div>
        <CodeBlock Source="Components/Alert/dismissible.txt" />
    </div>

    <!-- Auto-Dismiss -->
    <div class="space-y-4">
        <div class="space-y-2">
            <div class="flex items-center gap-2">
                <h2 class="text-2xl font-semibold">@L.T("自动关闭", "Auto-Dismiss")</h2>
                <span class="inline-flex items-center rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary ring-1 ring-inset ring-primary/20">v3</span>
            </div>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    设置 <code class="text-xs bg-muted px-1 py-0.5 rounded">AutoDismissAfter</code>（单位毫秒）让提示在延时后自动关闭。
                    开启 <code class="text-xs bg-muted px-1 py-0.5 rounded">ShowCountdown</code> 显示进度条，悬停可暂停倒计时。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use <code class="text-xs bg-muted px-1 py-0.5 rounded">AutoDismissAfter</code> (in milliseconds) to automatically dismiss the alert after a delay.
                    Enable <code class="text-xs bg-muted px-1 py-0.5 rounded">ShowCountdown</code> for a visual progress bar. Hover to pause the countdown.
                </p>
                        </text>
}
        </div>
        <div class="space-y-4">
            @if (_showAutoDismissAlert)
            {
                <Alert Variant="AlertVariant.Success"
                       AutoDismissAfter="5000"
                       ShowCountdown="true"
                       PauseOnHover="true"
                       OnDismiss="@(() => _showAutoDismissAlert = false)">
                    <Icon>
                        <LucideIcon Name="circle-check" Class="h-4 w-4" />
                    </Icon>
                    <ChildContent>
                        <AlertTitle>@L.T("更改已保存", "Changes Saved")</AlertTitle>
                        <AlertDescription>
                            @L.T("设置已成功保存。此提示将在 5 秒后关闭，悬停可暂停。", "Your settings have been saved successfully. This alert will dismiss in 5 seconds. Hover to pause.")
                        </AlertDescription>
                    </ChildContent>
                </Alert>
            }
            else
            {
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => _showAutoDismissAlert = true)">
                    @L.T("再次显示提示", "Show Alert Again")
                </Button>
            }
        </div>

        <CodeBlock Source="Components/Alert/auto-dismiss.txt" />
    </div>

    <!-- With Actions -->
    <div class="space-y-4">
        <div class="space-y-2">
            <div class="flex items-center gap-2">
                <h2 class="text-2xl font-semibold">@L.T("带操作按钮", "With Actions")</h2>
                <span class="inline-flex items-center rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary ring-1 ring-inset ring-primary/20">v3</span>
            </div>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    使用 <code class="text-xs bg-muted px-1 py-0.5 rounded">Actions</code> 插槽，在提示内容下方添加行内操作按钮。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use the <code class="text-xs bg-muted px-1 py-0.5 rounded">Actions</code> slot to add inline action buttons below the alert content.
                </p>
                        </text>
}
        </div>
        <div class="space-y-4">
            <Alert Variant="AlertVariant.Warning">
                <Icon>
                    <LucideIcon Name="triangle-alert" Class="h-4 w-4" />
                </Icon>
                <ChildContent>
                    <AlertTitle>@L.T("未保存的更改", "Unsaved Changes")</AlertTitle>
                    <AlertDescription>
                        @L.T("存在未保存的更改，离开此页面后将丢失。", "You have unsaved changes that will be lost if you leave this page.")
                    </AlertDescription>
                </ChildContent>
                <Actions>
                    <Button Variant="ButtonVariant.Default" Size="ButtonSize.Small">@L.T("保存", "Save")</Button>
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small">@L.T("丢弃", "Discard")</Button>
                </Actions>
            </Alert>

            <Alert Variant="AlertVariant.Danger" AccentBorder="true">
                <Icon>
                    <LucideIcon Name="circle-alert" Class="h-4 w-4" />
                </Icon>
                <ChildContent>
                    <AlertTitle>@L.T("部署失败", "Deployment Failed")</AlertTitle>
                    <AlertDescription>
                        @L.T("生产环境部署失败，请查看日志了解详情。", "The deployment to production failed. Check logs for details.")
                    </AlertDescription>
                </ChildContent>
                <Actions>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small">@L.T("查看日志", "View Logs")</Button>
                    <Button Variant="ButtonVariant.Default" Size="ButtonSize.Small">@L.T("重试", "Retry")</Button>
                </Actions>
            </Alert>
        </div>

        <CodeBlock Source="Components/Alert/actions.txt" />
    </div>

    <!-- Custom Styling -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("自定义样式", "Custom Styling")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    使用 <code class="text-xs bg-muted px-1 py-0.5 rounded">Class</code> 参数创建自定义样式的提示。TailwindMerge 会确保你的类覆盖内置变体样式。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use the <code class="text-xs bg-muted px-1 py-0.5 rounded">Class</code> parameter to create custom-styled alerts. TailwindMerge ensures your classes override the built-in variant styles.
                </p>
                        </text>
}
        </div>
        <div class="space-y-4">
            <Alert Class="border-purple-500/30 bg-purple-500/10 [&>svg]:text-purple-500">
                <Icon>
                    <LucideIcon Name="sparkles" Class="h-4 w-4" />
                </Icon>
                <ChildContent>
                    <AlertTitle>@L.T("新功能", "New Feature")</AlertTitle>
                    <AlertDescription>
                        @L.T("通过 Class 参数应用紫色主题的自定义样式提示。", "A custom-styled alert using the Class parameter to apply purple theming.")
                    </AlertDescription>
                </ChildContent>
            </Alert>

            <Alert Class="border-pink-500/30 bg-gradient-to-r from-pink-500/10 to-purple-500/10 [&>svg]:text-pink-500">
                <Icon>
                    <LucideIcon Name="heart" Class="h-4 w-4" />
                </Icon>
                <ChildContent>
                    <AlertTitle>@L.T("品牌提示", "Brand Alert")</AlertTitle>
                    <AlertDescription>
                        @L.T("提示可用渐变与自定义配色来契合你的品牌。", "Alerts can be styled with gradients and custom colors to match your brand.")
                    </AlertDescription>
                </ChildContent>
            </Alert>
        </div>

        <CodeBlock Source="Components/Alert/custom-styling.txt" />
    </div>

    <!-- API Reference -->

        <AccessibilityList>
        <AriaAttributes>
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>提示使用 role="alert" 来播报重要信息。文字要保持简短，不要用提示承载常规的装饰性文本。</AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>The alert uses role="alert" to announce important messages. Keep alerts concise and avoid using them for routine decorative text.</AccessibilityItem>
                        </text>
}
            <AccessibilityItem>@L.T("可关闭提示会提供一个带标签的关闭按钮。自定义操作请给出有意义的文字。", "Dismissible alerts provide a labelled close button. Supply meaningful text for any custom actions.")</AccessibilityItem>
        </AriaAttributes>
        <KeyboardNavigation>
            <KeyboardShortcutItem Description="@(L.T("移动到关闭按钮或自定义操作", "Move to a dismiss button or custom action"))"><Kbd>Tab</Kbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("激活当前获得焦点的按钮", "Activate a focused button"))"><Kbd>Enter</Kbd> / <Kbd>Space</Kbd></KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>

    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件属性与参数。", "Component properties and parameters.")</p>
        </div>

        <div class="space-y-4">
            <ApiReference ComponentName="Alert">
                <ApiParameter Name="Variant" Type="AlertVariant" Default="Default">
                    @L.T("视觉样式变体。可选值：Default、Success、Info、Warning、Danger。", "The visual style variant. Options: Default, Success, Info, Warning, Danger.")
                </ApiParameter>
                <ApiParameter Name="AccentBorder" Type="bool" Default="false">
                    @L.T("为 true 时显示粗左边框与轻微着色背景。", "When true, displays a thick left border with a subtle tinted background.")
                </ApiParameter>
                <ApiParameter Name="Dismissible" Type="bool" Default="false">
                    @L.T("为 true 时在右上角显示关闭按钮。", "When true, displays a close button in the top-right corner.")
                </ApiParameter>
                <ApiParameter Name="OnDismiss" Type="EventCallback">
                    @L.T("点击关闭按钮时调用的回调。", "Callback invoked when the dismiss button is clicked.")
                </ApiParameter>
                <ApiParameter Name="Icon" Type="RenderFragment?">
                    @L.T("要在提示中显示的可选图标。", "Optional icon to display in the alert.")
                </ApiParameter>
                <ApiParameter Name="Actions" Type="RenderFragment?">
                    @L.T("在提示内容下方显示的可选操作按钮。", "Optional action buttons to display below the alert content.")
                </ApiParameter>
                <ApiParameter Name="AutoDismissAfter" Type="int?">
                    @L.T("提示自动关闭前等待的毫秒数。为 Null（默认值）时禁用自动关闭。", "Duration in milliseconds after which the alert is automatically dismissed. Null (default) disables auto-dismiss.")
                </ApiParameter>
                <ApiParameter Name="PauseOnHover" Type="bool" Default="true">
                    @L.T("鼠标悬停在提示上时是否暂停自动关闭倒计时。", "Whether to pause the auto-dismiss countdown when hovering over the alert.")
                </ApiParameter>
                <ApiParameter Name="ShowCountdown" Type="bool" Default="false">
                    @L.T("是否在提示底部显示倒计时进度条。", "Whether to show a visual countdown progress bar at the bottom of the alert.")
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?">
                    @L.T("应用于提示的附加 CSS 类。", "Additional CSS classes to apply to the alert.")
                </ApiParameter>
                <ApiParameter Name="ChildContent" Type="RenderFragment?">
                    @L.T("提示的内容，应包含 AlertTitle 与 AlertDescription。", "Content of the alert. Should contain AlertTitle and AlertDescription.")
                </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        应用到根 <code>&lt;div&gt;</code> 元素的附加 HTML 特性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        Additional HTML attributes applied to the root <code>&lt;div&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                    </ApiParameter>
                                </text>
}
            </ApiReference>
        </div>
    </section>

<LocalizationSection
        Description="@(L.T("关闭按钮的 aria 标签可配置。", "The dismiss button aria label is configurable."))"
        Labels="@(new LocalizationSection.LabelInfo[]
        {
            new("Dismiss", "Dismiss", L.T("关闭按钮的 aria 标签。", "Aria label for the dismiss button")),
        })"
        CodeExample="@(@"builder.Services.AddAtomBlazorComponents(localizer =>
{
    localizer.Set(""Alert.Dismiss"", ""Schließen"");
});")" />
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    private bool _showDismissibleAlert = true;
    private bool _showAutoDismissAlert = true;
}
