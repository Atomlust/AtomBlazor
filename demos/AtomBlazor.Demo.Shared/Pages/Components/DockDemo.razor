</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    private int layoutChanges;

    private Dock? reopenDock;
    private readonly List<string> closedPanels = new();
    private readonly Dictionary<string, string> titles = new()
    {
        ["document"] = "Document",
        ["comments"] = "Comments",
        ["history"] = "History",
    };

    /// <summary>重新打开按钮标题的中文写法（与 titles 一一对应，仅供中文分支使用）。</summary>
    private readonly Dictionary<string, string> titlesZh = new()
    {
        ["document"] = "文档",
        ["comments"] = "评论",
        ["history"] = "历史",
    };

    private readonly (string Name, string Icon)[] explorerItems =
    {
        ("src", "folder"),
        ("Program.cs", "file-code"),
        ("README.md", "file-text"),
        ("appsettings.json", "braces"),
        (".gitignore", "file"),
    };

    /// <summary>工具箱工具名（NameZh 与 Name 对应，仅供中文分支使用）。</summary>
    private readonly (string Name, string Icon, string NameZh)[] toolboxItems =
    {
        ("Select", "mouse-pointer-2", "选择"),
        ("Pen", "pencil", "画笔"),
        ("Shapes", "shapes", "形状"),
        ("Text", "type", "文本"),
        ("Colors", "palette", "颜色"),
    };

    /// <summary>属性面板标签（LabelZh 与 Label 对应，仅供中文分支使用）。</summary>
    private readonly (string Label, string Value, string LabelZh)[] properties =
    {
        ("Name", "Program.cs", "名称"),
        ("Encoding", "UTF-8", "编码"),
        ("Line endings", "LF", "换行符"),
        ("Language", "C#", "语言"),
        ("Size", "1.4 KB", "大小"),
    };

    private const string programSource = @"using AtomBlazor;

var builder = WebApplication.CreateBuilder(args);
builder.Services.AddAtomBlazorComponents();

var app = builder.Build();
app.MapRazorComponents<App>();
app.Run();";

    private void OnPanelClosed(string id)
    {
        if (titles.ContainsKey(id) && !closedPanels.Contains(id))
        {
            closedPanels.Add(id);
        }
    }

    private async Task Reopen(string id)
    {
        closedPanels.Remove(id);
        if (reopenDock is not null)
        {
            await reopenDock.OpenPanelAsync(id);
        }
    }
}
