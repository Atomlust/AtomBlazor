@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    private readonly ThemeDesign scopeDesign = new() { Density = ThemeDensity.Compact, Font = ThemeFont.Mono, MenuColor = ThemeMenuColor.Inverse };
    private static readonly Dictionary<string, ThemePreset> profiles = new()
    {
        ["Standard"] = ThemePresets.Standard, ["Balanced"] = ThemePresets.Balanced,
        ["Compact"] = ThemePresets.Compact, ["Spacious"] = ThemePresets.Spacious,
        ["Sharp"] = ThemePresets.Sharp, ["Dense"] = ThemePresets.Dense, ["Glass"] = ThemePresets.Glass
    };
    private Task ApplyProfile(ThemePreset profile) => Themes.SetPresetAsync(profile with
    {
        DarkMode = Themes.IsDarkMode, BaseColor = Themes.BaseColor, PrimaryColor = Themes.PrimaryColor
    });
}
