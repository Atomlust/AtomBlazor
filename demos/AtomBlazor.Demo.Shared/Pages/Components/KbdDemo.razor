@page "/components/kbd"
<PageTitle>@L.T("Kbd 键盘键 - Atom BlazorUI", "Kbd Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("Kbd 键盘键组件", "Kbd Component")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("以专门的样式展示键盘快捷键与组合键。", "Displays keyboard shortcuts and key combinations in a styled format.")
            </p>
        </div>
    </div>

    <!-- Basic Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("基本示例", "Basic Example")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("简单的按键展示。", "Simple keyboard key display.")
            </p>
        </div>
        <div class="flex items-center gap-2">
            <Kbd Keys="K" />
        </div>

        <CodeBlock Source="Components/Kbd/basic.txt" />
    </div>

    <!-- Key Combinations -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("组合键", "Key Combinations")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("展示由多个按键组成的键盘快捷键。", "Display keyboard shortcuts with multiple keys.")
            </p>
        </div>
        <div class="flex items-center gap-4">
            <div class="flex items-center gap-1">
                <Kbd Keys="Ctrl" />
                <span class="text-muted-foreground">+</span>
                <Kbd Keys="C" />
                <span class="text-sm text-muted-foreground ml-2">@L.T("复制", "Copy")</span>
            </div>
            <div class="flex items-center gap-1">
                <Kbd Keys="Ctrl" />
                <span class="text-muted-foreground">+</span>
                <Kbd Keys="V" />
                <span class="text-sm text-muted-foreground ml-2">@L.T("粘贴", "Paste")</span>
            </div>
            <div class="flex items-center gap-1">
                <Kbd Keys="Ctrl" />
                <span class="text-muted-foreground">+</span>
                <Kbd Keys="Z" />
                <span class="text-sm text-muted-foreground ml-2">@L.T("撤销", "Undo")</span>
            </div>
        </div>

        <CodeBlock Source="Components/Kbd/combinations.txt" />
    </div>

    <!-- Mac Style -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("Mac 风格快捷键", "Mac Style Shortcuts")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("使用 Mac 风格的修饰键符号。", "Using Mac-style modifier symbols.")
            </p>
        </div>
        <div class="flex items-center gap-4">
            <div class="flex items-center gap-1">
                <Kbd>⌘</Kbd>
                <Kbd>I</Kbd>
                <span class="text-sm text-muted-foreground ml-2">@L.T("命令面板", "Command palette")</span>
            </div>
            <div class="flex items-center gap-1">
                <Kbd>⌘</Kbd>
                <Kbd>⇧</Kbd>
                <Kbd>P</Kbd>
                <span class="text-sm text-muted-foreground ml-2">@L.T("快捷操作", "Quick actions")</span>
            </div>
        </div>

        <CodeBlock Source="Components/Kbd/mac-style.txt" />
    </div>

    <!-- Sizes -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("尺寸", "Sizes")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("Kbd 提供 Small、Default 与 Large 三种尺寸。", "Kbd comes in small, default, and large sizes.")
            </p>
        </div>
        <div class="flex items-center gap-4">
            <div class="flex items-center gap-2">
                <Kbd Size="KbdSize.Small" Keys="Ctrl" />
                <span class="text-xs text-muted-foreground">Small</span>
            </div>
            <div class="flex items-center gap-2">
                <Kbd Size="KbdSize.Default" Keys="Ctrl" />
                <span class="text-sm text-muted-foreground">Default</span>
            </div>
            <div class="flex items-center gap-2">
                <Kbd Size="KbdSize.Large" Keys="Ctrl" />
                <span class="text-muted-foreground">Large</span>
            </div>
        </div>

        <CodeBlock Source="Components/Kbd/sizes.txt" />
    </div>

    <!-- In Context -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("在正文中使用", "In Context")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("在正文内容中使用 Kbd。", "Kbd used within text content.")
            </p>
        </div>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm">
                按下 <Kbd>Ctrl</Kbd> + <Kbd>I</Kbd> 可打开命令面板，
                或使用 <Kbd>Esc</Kbd> 关闭已打开的对话框。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm">
                Press <Kbd>Ctrl</Kbd> + <Kbd>I</Kbd> to open the command palette,
                or use <Kbd>Esc</Kbd> to close any open dialog.
            </p>
                </text>
}

        <CodeBlock Source="Components/Kbd/in-context.txt" />
    </div>

    <!-- Special Keys -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("特殊按键", "Special Keys")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("常见特殊按键及其显示形式。", "Common special keys and their representations.")
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <Kbd>Enter ↵</Kbd>
            <Kbd>Tab ⇥</Kbd>
            <Kbd>Shift ⇧</Kbd>
            <Kbd>Esc</Kbd>
            <Kbd>Space</Kbd>
            <Kbd>Backspace ⌫</Kbd>
            <Kbd>Delete</Kbd>
            <Kbd>↑</Kbd>
            <Kbd>↓</Kbd>
            <Kbd>←</Kbd>
            <Kbd>→</Kbd>
        </div>

        <CodeBlock Source="Components/Kbd/special-keys.txt" />
    </div>

    <!-- Accessibility -->
    <AccessibilityList>
        <AriaAttributes>
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    渲染为原生 <code>&lt;kbd&gt;</code> HTML 元素，辅助技术会把它识别为键盘输入。
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    Renders as a native <code>&lt;kbd&gt;</code> HTML element, which is semantically recognized by assistive technologies as keyboard input.
                </AccessibilityItem>
                        </text>
}
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    使用 <code>pointer-events-none</code> 与 <code>select-none</code> 表明该元素只是装饰性呈现，不可交互。
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    Uses <code>pointer-events-none</code> and <code>select-none</code> to indicate the element is presentational, not interactive.
                </AccessibilityItem>
                        </text>
}
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    使用等宽字体（<code>font-mono</code>），让按键在视觉上与周围正文区分开。
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    Uses monospace font (<code>font-mono</code>) for visual distinction of keyboard keys from surrounding text.
                </AccessibilityItem>
                        </text>
}
            <AccessibilityItem>
                @L.T("组合键说明应在按键标识旁配上可见的文字标签（例如 \"复制\"、\"粘贴\"），以便读者理解。", "Ensure key combination descriptions include visible text labels (e.g., \"Copy\", \"Paste\") alongside the key indicators for clarity.")
            </AccessibilityItem>
        </AriaAttributes>
    </AccessibilityList>

    <!-- API Reference -->
    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件属性与参数。", "Component properties and parameters.")</p>
        </div>
        <div class="space-y-4">
            <ApiReference ComponentName="Kbd">
                <ApiParameter Name="Keys" Type="string?">
                    @L.T("要显示的按键（例如 \"Ctrl\"、\"C\"、\"Shift\"）。未提供 ChildContent 时使用。", "The keyboard keys to display (e.g., \"Ctrl\", \"C\", \"Shift\"). Used when ChildContent is not provided.")
                </ApiParameter>
                <ApiParameter Name="Size" Type="KbdSize" Default="Default">
                    @L.T("kbd 元素的尺寸变体。可选值：Small、Default、Large。", "The size variant of the kbd element. Options: Small, Default, Large.")
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?">
                    @L.T("应用到 kbd 元素上的额外 CSS 类。", "Additional CSS classes to apply to the kbd element.")
                </ApiParameter>
                <ApiParameter Name="ChildContent" Type="RenderFragment?">
                    @L.T("键盘快捷键展示的自定义内容。提供时优先于 Keys 参数。", "Custom content for the keyboard shortcut display. When provided, takes precedence over the Keys parameter.")
                </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        应用到根 <code>&lt;kbd&gt;</code> 元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        Additional HTML attributes applied to the root <code>&lt;kbd&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                    </ApiParameter>
                                </text>
}
            </ApiReference>
        </div>
    </section>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;
}
