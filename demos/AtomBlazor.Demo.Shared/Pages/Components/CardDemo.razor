@page "/components/card"

<PageTitle>@L.T("卡片组件 - Atom BlazorUI", "Card Component - Atom BlazorUI")</PageTitle>

@* 源实现的登录卡片输入框本就是 plain HTML（并非 Input 组件），本页与源； Button 家族已随 交付，本页按钮已恢复组件形态。 *@

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("卡片组件", "Card Component")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("用彼此独立的容器展示结构化内容，容器分为页眉、内容区与页脚。", "Displays structured content in a visually distinct container with sections for headers, content, and footers.")
            </p>
        </div>
    </div>

    @* Basic Card *@
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("基础卡片", "Basic Card")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("一张带页眉、内容区与页脚的简单卡片。", "A simple card with header, content, and footer sections.")
            </p>
        </div>
        <div class="grid gap-4" style="max-width: 400px;">
            <Card>
                <CardHeader>
                    <CardTitle>@L.T("卡片标题", "Card Title")</CardTitle>
                    <CardDescription>@L.T("这里是卡片的说明文字。", "Card description goes here.")</CardDescription>
                </CardHeader>
                <CardContent>
                    <p class="text-sm">@L.T("这是卡片的主要内容区域。", "This is the main content area of the card.")</p>
                </CardContent>
                <CardFooter>
                    <Button Size="ButtonSize.Small">@L.T("操作", "Action")</Button>
                </CardFooter>
            </Card>
        </div>

        <CodeBlock Source="Components/Card/basic.txt" />
    </div>

    @* Login Form Card *@
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("登录表单示例", "Login Form Example")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("用卡片组件搭建的登录表单（与 shadcn/ui 示例一致）。", "Card component used for a login form (matching shadcn/ui example).")
            </p>
        </div>
        <div class="grid gap-4" style="max-width: 400px;">
            <Card>
                <CardHeader>
                    <CardTitle>@L.T("登录你的账号", "Login to your account")</CardTitle>
                    <CardDescription>@L.T("输入邮箱以登录你的账号", "Enter your email below to login to your account")</CardDescription>
                </CardHeader>
                <CardContent>
                    <div class="space-y-4">
                        <div class="space-y-2">
                            <label class="text-sm font-medium" for="email">@L.T("邮箱", "Email")</label>
                            <input
                                id="email"
                                type="email"
                                placeholder="m@example.com"
                                class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" />
                        </div>
                        <div class="space-y-2">
                            <label class="text-sm font-medium" for="password">@L.T("密码", "Password")</label>
                            <input
                                id="password"
                                type="password"
                                class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" />
                        </div>
                    </div>
                </CardContent>
                <CardFooter>
                    <div class="flex flex-col w-full gap-2">
                        <Button Class="w-full">@L.T("登录", "Login")</Button>
                        <Button Variant="ButtonVariant.Outline" Class="w-full">
                            @L.T("使用 Google 登录", "Login with Google")
                        </Button>
                    </div>
                </CardFooter>
            </Card>
        </div>

        <CodeBlock Source="Components/Card/login-form.txt" />
    </div>

    @* Multiple Cards *@
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("卡片网格布局", "Card Grid Layout")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("多张卡片排成响应式网格。", "Multiple cards in a responsive grid layout.")
            </p>
        </div>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            <Card>
                <CardHeader>
                    <CardTitle>@L.T("总营收", "Total Revenue")</CardTitle>
                    <CardDescription>@L.T("2024 年 1 月 - 12 月", "January - December 2024")</CardDescription>
                </CardHeader>
                <CardContent>
                    <div class="text-2xl font-bold">$45,231.89</div>
                    <p class="text-xs text-muted-foreground">
                        @L.T("较去年同期 +20.1%", "+20.1% from last year")
                    </p>
                </CardContent>
            </Card>

            <Card>
                <CardHeader>
                    <CardTitle>@L.T("活跃用户", "Active Users")</CardTitle>
                    <CardDescription>@L.T("当前生效的订阅数", "Current active subscriptions")</CardDescription>
                </CardHeader>
                <CardContent>
                    <div class="text-2xl font-bold">+2,350</div>
                    <p class="text-xs text-muted-foreground">
                        @L.T("较上月 +180.1%", "+180.1% from last month")
                    </p>
                </CardContent>
            </Card>

            <Card>
                <CardHeader>
                    <CardTitle>@L.T("新增客户", "New Customers")</CardTitle>
                    <CardDescription>@L.T("本月", "This month")</CardDescription>
                </CardHeader>
                <CardContent>
                    <div class="text-2xl font-bold">+573</div>
                    <p class="text-xs text-muted-foreground">
                        @L.T("较上月 +12.5%", "+12.5% from last month")
                    </p>
                </CardContent>
            </Card>
        </div>

        <CodeBlock Source="Components/Card/grid-layout.txt" />
    </div>

    @* Card with Actions *@
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("带操作按钮的卡片", "Card with Action Buttons")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("页脚操作按钮采用不同布局的卡片。", "Cards with footer action buttons in different layouts.")
            </p>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
            <Card>
                <CardHeader>
                    <CardTitle>@L.T("创建项目", "Create Project")</CardTitle>
                    <CardDescription>@L.T("一键部署你的新项目。", "Deploy your new project in one-click.")</CardDescription>
                </CardHeader>
                <CardContent>
                    <p class="text-sm text-muted-foreground">
                        @L.T("项目会按默认设置创建。", "Your project will be created with default settings.")
                    </p>
                </CardContent>
                <CardFooter Class="gap-2">
                    <Button Variant="ButtonVariant.Outline">@L.T("取消", "Cancel")</Button>
                    <Button>@L.T("部署", "Deploy")</Button>
                </CardFooter>
            </Card>

            <Card>
                <CardHeader>
                    <CardTitle>@L.T("团队成员", "Team Members")</CardTitle>
                    <CardDescription>@L.T("邀请你的团队一起协作。", "Invite your team to collaborate.")</CardDescription>
                </CardHeader>
                <CardContent>
                    <div class="space-y-2">
                        <div class="flex items-center gap-2">
                            <div class="h-8 w-8 rounded-full bg-primary/10 flex items-center justify-center text-sm font-medium">
                                JD
                            </div>
                            <span class="text-sm">John Doe</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="h-8 w-8 rounded-full bg-primary/10 flex items-center justify-center text-sm font-medium">
                                JS
                            </div>
                            <span class="text-sm">Jane Smith</span>
                        </div>
                    </div>
                </CardContent>
                <CardFooter>
                    <Button Size="ButtonSize.Small" Class="w-full">
                        @L.T("邀请团队成员", "Invite Team Member")
                    </Button>
                </CardFooter>
            </Card>
        </div>

        <CodeBlock Source="Components/Card/action-buttons.txt" />
    </div>

    @* Card without Footer *@
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("仅内容的卡片", "Content-Only Cards")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("没有页脚的卡片，适合展示信息。", "Cards without footers, suitable for displaying information.")
            </p>
        </div>
        <div class="grid gap-4 md:grid-cols-2" style="max-width: 800px;">
            <Card>
                <CardHeader>
                    <CardTitle>@L.T("通知", "Notifications")</CardTitle>
                    <CardDescription>@L.T("你有 3 条未读消息。", "You have 3 unread messages.")</CardDescription>
                </CardHeader>
                <CardContent>
                    <div class="space-y-4">
                        <div class="flex items-start gap-3">
                            <div class="h-2 w-2 rounded-full bg-blue-500 mt-2"></div>
                            <div class="flex-1 space-y-1">
                                <p class="text-sm font-medium">@L.T("你的预约已确认。", "Your call has been confirmed.")</p>
                                <p class="text-xs text-muted-foreground">@L.T("5 分钟前", "5 minutes ago")</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="h-2 w-2 rounded-full bg-blue-500 mt-2"></div>
                            <div class="flex-1 space-y-1">
                                <p class="text-sm font-medium">@L.T("你有一条新消息！", "You have a new message!")</p>
                                <p class="text-xs text-muted-foreground">@L.T("1 小时前", "1 hour ago")</p>
                            </div>
                        </div>
                    </div>
                </CardContent>
            </Card>

            <Card>
                <CardHeader>
                    <CardTitle>@L.T("系统状态", "System Status")</CardTitle>
                    <CardDescription>@L.T("所有系统运行正常。", "All systems operational.")</CardDescription>
                </CardHeader>
                <CardContent>
                    <div class="space-y-3">
                        <div class="flex justify-between items-center">
                            <span class="text-sm">@L.T("API 状态", "API Status")</span>
                            <span class="text-xs text-green-600 font-medium">@L.T("运行正常", "Operational")</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-sm">@L.T("数据库", "Database")</span>
                            <span class="text-xs text-green-600 font-medium">@L.T("运行正常", "Operational")</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-sm">@L.T("存储", "Storage")</span>
                            <span class="text-xs text-green-600 font-medium">@L.T("运行正常", "Operational")</span>
                        </div>
                    </div>
                </CardContent>
            </Card>
        </div>

        <CodeBlock Source="Components/Card/content-only.txt" />
    </div>

    @* Custom Styling *@
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("自定义样式", "Custom Styling")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("用自定义 CSS 类扩展卡片样式。", "Cards with custom CSS classes for extended styling.")
            </p>
        </div>
        <div class="grid gap-4 md:grid-cols-2" style="max-width: 800px;">
            <Card Class="border-2 border-primary">
                <CardHeader>
                    <CardTitle>@L.T("精选卡片", "Featured Card")</CardTitle>
                    <CardDescription>@L.T("带有自定义边框颜色", "With custom border color")</CardDescription>
                </CardHeader>
                <CardContent>
                    <p class="text-sm">@L.T("这张卡片通过 Class 参数设置了自定义边框。", "This card has a custom border using the Class parameter.")</p>
                </CardContent>
            </Card>

            <Card Class="shadow-lg">
                <CardHeader>
                    <CardTitle>@L.T("更强的阴影", "Enhanced Shadow")</CardTitle>
                    <CardDescription>@L.T("阴影更大，层次更深", "With larger shadow effect")</CardDescription>
                </CardHeader>
                <CardContent>
                    <p class="text-sm">@L.T("这张卡片使用了加强的阴影来增强层次感。", "This card uses an enhanced shadow for more depth.")</p>
                </CardContent>
            </Card>
        </div>

        <CodeBlock Source="Components/Card/custom-styling.txt" />
    </div>

    <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>
                @L.T("语义化 HTML 结构，标题层级正确", "Semantic HTML structure with proper heading hierarchy")
            </AccessibilityItem>
            <AccessibilityItem>
                @L.T("标题、说明与内容分区层次分明", "Clear visual hierarchy with title, description, and content sections")
            </AccessibilityItem>
            <AccessibilityItem>
                @L.T("颜色对比按可读性设计", "Color contrast designed for readability")
            </AccessibilityItem>
            <AccessibilityItem>
                @L.T("响应式布局适配不同屏幕尺寸", "Responsive layout adapts to different screen sizes")
            </AccessibilityItem>
            <AccessibilityItem>
                @L.T("通过 CSS 变量兼容深色模式", "Dark mode compatible via CSS variables")
            </AccessibilityItem>
            <AccessibilityItem>
                @L.T("键盘导航与交互元素自然配合", "Keyboard navigation works naturally with interactive elements")
            </AccessibilityItem>
        </AriaAttributes>
    </AccessibilityList>

    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件属性与参数。", "Component properties and parameters.")</p>
        </div>

        <ApiReference ComponentName="Card">
            <ApiParameter Name="ChildContent" Type="RenderFragment?">@L.T("获取或设置渲染在卡片内部的内容。", "Gets or sets the content to be rendered inside the card.")</ApiParameter>
            <ApiParameter Name="Class" Type="string?">@L.T("获取或设置追加到卡片上的额外 CSS 类。", "Gets or sets additional CSS classes to apply to the card.")</ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">@L.T("获取或设置追加到根元素上的额外 HTML 属性。", "Gets or sets additional HTML attributes to apply to the root element.")</ApiParameter>
        </ApiReference>

        <ApiReference ComponentName="CardHeader">
            <ApiParameter Name="ChildContent" Type="RenderFragment?">@L.T("获取或设置渲染在卡片页眉内部的内容。", "Gets or sets the content to be rendered inside the card header.")</ApiParameter>
            <ApiParameter Name="Class" Type="string?">@L.T("获取或设置追加到卡片页眉上的额外 CSS 类。", "Gets or sets additional CSS classes to apply to the card header.")</ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">@L.T("获取或设置追加到根元素上的额外 HTML 属性。", "Gets or sets additional HTML attributes to apply to the root element.")</ApiParameter>
        </ApiReference>

        <ApiReference ComponentName="CardTitle">
            <ApiParameter Name="ChildContent" Type="RenderFragment?">@L.T("获取或设置作为卡片标题渲染的内容。", "Gets or sets the content to be rendered as the card title.")</ApiParameter>
            <ApiParameter Name="Class" Type="string?">@L.T("获取或设置追加到卡片标题上的额外 CSS 类。", "Gets or sets additional CSS classes to apply to the card title.")</ApiParameter>
            @if (L.IsChinese)
            {
                        <text>
                            <ApiParameter Name="As" Type="string" Default="&quot;h3&quot;">标题所使用的 HTML 标签元素。默认为 &quot;h3&quot;。</ApiParameter>
                        </text>
}
            else
            {
                        <text>
                            <ApiParameter Name="As" Type="string" Default="&quot;h3&quot;">The HTML element tag to use for the title. Default is &quot;h3&quot;.</ApiParameter>
                        </text>
}
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">@L.T("获取或设置追加到根元素上的额外 HTML 属性。", "Gets or sets additional HTML attributes to apply to the root element.")</ApiParameter>
        </ApiReference>

        <ApiReference ComponentName="CardDescription">
            <ApiParameter Name="ChildContent" Type="RenderFragment?">@L.T("获取或设置作为卡片说明渲染的内容。", "Gets or sets the content to be rendered as the card description.")</ApiParameter>
            <ApiParameter Name="Class" Type="string?">@L.T("获取或设置追加到卡片说明上的额外 CSS 类。", "Gets or sets additional CSS classes to apply to the card description.")</ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">@L.T("获取或设置追加到根元素上的额外 HTML 属性。", "Gets or sets additional HTML attributes to apply to the root element.")</ApiParameter>
        </ApiReference>

        <ApiReference ComponentName="CardContent">
            <ApiParameter Name="ChildContent" Type="RenderFragment?">@L.T("获取或设置渲染在卡片内容区的内容。", "Gets or sets the content to be rendered inside the card content area.")</ApiParameter>
            <ApiParameter Name="Class" Type="string?">@L.T("获取或设置追加到卡片内容区上的额外 CSS 类。", "Gets or sets additional CSS classes to apply to the card content.")</ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">@L.T("获取或设置追加到根元素上的额外 HTML 属性。", "Gets or sets additional HTML attributes to apply to the root element.")</ApiParameter>
        </ApiReference>

        <ApiReference ComponentName="CardFooter">
            <ApiParameter Name="ChildContent" Type="RenderFragment?">@L.T("获取或设置渲染在卡片页脚内部的内容。", "Gets or sets the content to be rendered inside the card footer.")</ApiParameter>
            <ApiParameter Name="Class" Type="string?">@L.T("获取或设置追加到卡片页脚上的额外 CSS 类。", "Gets or sets additional CSS classes to apply to the card footer.")</ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">@L.T("获取或设置追加到根元素上的额外 HTML 属性。", "Gets or sets additional HTML attributes to apply to the root element.")</ApiParameter>
        </ApiReference>

        <ApiReference ComponentName="CardAction">
            <ApiParameter Name="ChildContent" Type="RenderFragment?">@L.T("获取或设置渲染在卡片操作区的内容。", "Gets or sets the content to be rendered in the card action area.")</ApiParameter>
            <ApiParameter Name="Class" Type="string?">@L.T("获取或设置追加到卡片操作区上的额外 CSS 类。", "Gets or sets additional CSS classes to apply to the card action area.")</ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">@L.T("获取或设置追加到根元素上的额外 HTML 属性。", "Gets or sets additional HTML attributes to apply to the root element.")</ApiParameter>
        </ApiReference>
    </section>

</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    // 本页无需组件状态：纯展示型文档页，与源实现一致。
}
