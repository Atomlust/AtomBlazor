@page "/components/form-field-time-picker"
@using System.ComponentModel.DataAnnotations

<PageTitle>@L.T("FormFieldTimePicker 时间选择字段 - Atom BlazorUI", "FormFieldTimePicker Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">FormFieldTimePicker</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("带内置标签、辅助文本与错误提示的 TimePicker 表单字段封装。", "A form field wrapper for TimePicker with built-in label, helper text, and error messages.")
            </p>
        </div>
    </div>

    <!-- Which form component? -->
    <div class="rounded-lg border border-dashed bg-muted/30 p-6 space-y-3">
        <h2 class="text-lg font-semibold">@L.T("该用哪个表单组件？", "Which form component?")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <div class="space-y-2 text-sm text-muted-foreground">
                <p><strong>文本输入</strong>（string、int、日期等）？ &rarr; <a href="/components/form-field-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldInput&lt;T&gt;</a></p>
                <p><strong>多行文本</strong>？ &rarr; <a href="/components/form-field-textarea" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldTextarea</a></p>
                <p><strong>数字输入</strong>？ &rarr; <a href="/components/form-field-numeric-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldNumericInput</a></p>
                <p><strong>日期选择器</strong>？ &rarr; <a href="/components/form-field-date-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldDatePicker</a></p>
                <p><strong>时间选择器</strong>？ &rarr; <strong>FormFieldTimePicker</strong>（当前页面）</p>
                <p><strong>日期与时间选择器</strong>？ &rarr; <a href="/components/form-field-date-time-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldDateTimePicker</a></p>
                <p><strong>复选框</strong>？ &rarr; <a href="/components/form-field-checkbox" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCheckbox</a></p>
                <p><strong>开关</strong>？ &rarr; <a href="/components/form-field-switch" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldSwitch</a></p>
                <p><strong>下拉选择</strong>？ &rarr; <a href="/components/form-field-select" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldSelect</a></p>
                <p><strong>原生 select</strong>？ &rarr; <a href="/components/form-field-native-select" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldNativeSelect</a></p>
                <p><strong>单选组</strong>？ &rarr; <a href="/components/form-field-radio-group" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldRadioGroup</a></p>
                <p><strong>可搜索选择</strong>？ &rarr; <a href="/components/form-field-combobox" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCombobox</a></p>
                <p><strong>多选</strong>？ &rarr; <a href="/components/form-field-multi-select" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldMultiSelect</a></p>
            </div>
                </text>
}
        else
        {
                <text>
                    <div class="space-y-2 text-sm text-muted-foreground">
                <p><strong>Text input</strong> (string, int, date, etc.)? &rarr; <a href="/components/form-field-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldInput&lt;T&gt;</a></p>
                <p><strong>Textarea</strong>? &rarr; <a href="/components/form-field-textarea" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldTextarea</a></p>
                <p><strong>Numeric input</strong>? &rarr; <a href="/components/form-field-numeric-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldNumericInput</a></p>
                <p><strong>Date picker</strong>? &rarr; <a href="/components/form-field-date-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldDatePicker</a></p>
                <p><strong>Time picker</strong>? &rarr; <strong>FormFieldTimePicker</strong> (this page)</p>
                <p><strong>Date &amp; time picker</strong>? &rarr; <a href="/components/form-field-date-time-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldDateTimePicker</a></p>
                <p><strong>Checkbox</strong>? &rarr; <a href="/components/form-field-checkbox" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCheckbox</a></p>
                <p><strong>Switch</strong>? &rarr; <a href="/components/form-field-switch" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldSwitch</a></p>
                <p><strong>Select dropdown</strong>? &rarr; <a href="/components/form-field-select" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldSelect</a></p>
                <p><strong>Native select</strong>? &rarr; <a href="/components/form-field-native-select" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldNativeSelect</a></p>
                <p><strong>Radio group</strong>? &rarr; <a href="/components/form-field-radio-group" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldRadioGroup</a></p>
                <p><strong>Searchable select</strong>? &rarr; <a href="/components/form-field-combobox" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCombobox</a></p>
                <p><strong>Multi-select</strong>? &rarr; <a href="/components/form-field-multi-select" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldMultiSelect</a></p>
            </div>
                </text>
}
    </div>

    <!-- Basic Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("基本用法", "Basic Usage")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("带自动关联标签与辅助文本的时间选择器。", "A time picker with an auto-associated label and helper text.")
            </p>
        </div>
        <div class="max-w-md">
            <FormFieldTimePicker AriaLabel="@(L.T("会议时间", "Meeting time"))" @bind-Value="_meetingTime"
                                  Label="@(L.T("会议时间", "Meeting time"))"
                                  HelperText="@(L.T("选择会议的时间。", "Select a time for the meeting."))" />
        </div>
        <div class="rounded-lg border p-4 bg-muted/50">
            <p class="text-sm font-medium mb-1">@L.T("已选择：", "Selected:")</p>
            <p class="text-sm font-mono">@(_meetingTime?.ToString(@"hh\:mm") ?? L.T("（无）", "(none)"))</p>
        </div>
        <CodeBlock Source="Components/FormFieldTimePicker/basic.txt" />
    </div>

    <!-- 24-Hour Format -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("24 小时制", "24-Hour Format")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    把 <code class="text-xs bg-muted px-1 py-0.5 rounded">Format</code> 设为
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">TimeFormat.Hour24</code> 即以 24 小时制显示。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Set <code class="text-xs bg-muted px-1 py-0.5 rounded">Format</code> to
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">TimeFormat.Hour24</code> for 24-hour display.
                </p>
                        </text>
}
        </div>
        <div class="max-w-md">
            <FormFieldTimePicker @bind-Value="_departureTime"
                                  Label="@(L.T("发车时间", "Departure time"))"
                                  HelperText="@(L.T("使用 24 小时制。", "Using 24-hour clock."))"
                                  Format="TimeFormat.Hour24" />
        </div>
        <div class="rounded-lg border p-4 bg-muted/50">
            <p class="text-sm font-medium mb-1">@L.T("已选择：", "Selected:")</p>
            <p class="text-sm font-mono">@(_departureTime?.ToString(@"hh\:mm") ?? L.T("（无）", "(none)"))</p>
        </div>
        <CodeBlock Source="Components/FormFieldTimePicker/hour24.txt" />
    </div>

    <!-- With Seconds -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("显示秒", "With Seconds")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    通过 <code class="text-xs bg-muted px-1 py-0.5 rounded">ShowSeconds</code> 启用秒选择器。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Enable the seconds selector with <code class="text-xs bg-muted px-1 py-0.5 rounded">ShowSeconds</code>.
                </p>
                        </text>
}
        </div>
        <div class="max-w-md">
            <FormFieldTimePicker @bind-Value="_preciseTime"
                                  Label="@(L.T("精确时间", "Precise time"))"
                                  HelperText="@(L.T("包含秒。", "Includes seconds."))"
                                  ShowSeconds="true"
                                  Format="TimeFormat.Hour24" />
        </div>
        <CodeBlock Source="Components/FormFieldTimePicker/seconds.txt" />
    </div>

    <!-- Disabled -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("禁用", "Disabled")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("一个处于禁用状态的时间选择器表单字段。", "A disabled time picker form field.")
            </p>
        </div>
        <div class="max-w-md">
            <FormFieldTimePicker Value="@(new TimeSpan(9, 0, 0))"
                                  Label="@(L.T("办公时间开始", "Office hours start"))"
                                  HelperText="@(L.T("由你所在的组织设定。", "Set by your organization."))"
                                  Disabled="true" />
        </div>
        <CodeBlock Source="Components/FormFieldTimePicker/disabled.txt" />
    </div>

    <!-- EditForm Integration -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("EditForm 集成", "EditForm Integration")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("在 EditForm 中校验错误会自动显示。", "Validation errors display automatically inside an EditForm.")
                @L.T("试试不选择时间直接提交。", "Try submitting without selecting a time.")
            </p>
        </div>
        <div class="max-w-md">
            <EditForm Model="_formModel" OnValidSubmit="HandleFormSubmit">
                <DataAnnotationsValidator />
                <div class="space-y-4">
                    <FormFieldTimePicker @bind-Value="_formModel.ReminderTime"
                                          Label="@(L.T("提醒时间", "Reminder time"))"
                                          Placeholder="@(L.T("选择时间…", "Pick a time..."))" />
                    <Button Type="ButtonType.Submit">@L.T("提交", "Submit")</Button>
                </div>
            </EditForm>
            @if (_formSubmitted)
            {
                <div class="mt-4 rounded-lg border border-green-200 bg-green-50 dark:bg-green-950 dark:border-green-800 p-4">
                    <p class="text-sm font-medium text-green-800 dark:text-green-200">
                        @L.F("已提交：{0}", "Submitted: {0}", _formModel.ReminderTime?.ToString(@"hh\:mm"))
                    </p>
                </div>
            }
        </div>
        <CodeBlock Source="Components/FormFieldTimePicker/editform.txt" />
    </div>

    <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>@L.T("标签与时间选择器触发按钮在视觉上关联", "Label visually associated with the time picker trigger")</AccessibilityItem>
            <AccessibilityItem>@L.T("描述通过 aria-describedby 关联", "Description linked via aria-describedby")</AccessibilityItem>
            <AccessibilityItem>@L.T("校验错误通过 aria-invalid 展示", "Validation errors displayed with aria-invalid")</AccessibilityItem>
        </AriaAttributes>
            <KeyboardNavigation>
            <KeyboardShortcutItem Description="@(L.T("在可用的表单控件之间移动", "Move between enabled form controls"))"><Kbd>Tab</Kbd> / <Kbd>Shift + Tab</Kbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("打开选择器，或激活当前聚焦的选择器按钮", "Open the picker or activate a focused picker button"))"><Kbd>Enter</Kbd> / <Kbd>Space</Kbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("关闭当前浮层", "Close the active popup"))"><Kbd>Escape</Kbd></KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>

    <!-- API Reference -->
    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件属性与参数。", "Component properties and parameters.")</p>
        </div>
        <div class="space-y-4">
            <ApiReference ComponentName="FormFieldTimePicker">
                <ApiParameter Name="Label" Type="string?" Default="null">
                    @L.T("显示在时间选择器上方的标签文本。", "The label text displayed above the time picker.")
                </ApiParameter>
                <ApiParameter Name="HelperText" Type="string?" Default="null">
                    @L.T("显示在时间选择器下方的辅助文本。错误状态下隐藏。", "Helper text displayed below the time picker. Hidden during error state.")
                </ApiParameter>
                <ApiParameter Name="ErrorText" Type="string?" Default="null">
                    @L.T("手动错误文本覆盖。当字段无效且设置了该项时，替换自动生成的提示。", "Manual error text override. When the field is invalid and this is set, replaces auto-generated messages.")
                </ApiParameter>
                <ApiParameter Name="Orientation" Type="FieldOrientation" Default="Vertical">
                    @L.T("字段的布局方向。", "Layout orientation of the field.")
                </ApiParameter>
                <ApiParameter Name="Value" Type="TimeSpan?" Default="null">
                    @L.T("所选的时间值。使用 @bind-Value 进行双向绑定。", "The selected time value. Use @bind-Value for two-way binding.")
                </ApiParameter>
                <ApiParameter Name="ValueChanged" Type="EventCallback&lt;TimeSpan?&gt;">
                    @L.T("所选时间发生变化时调用的回调。", "Callback invoked when the selected time changes.")
                </ApiParameter>
                <ApiParameter Name="Format" Type="TimeFormat" Default="Hour12">
                    @L.T("时间格式（Hour12 或 Hour24）。", "The time format (Hour12 or Hour24).")
                </ApiParameter>
                <ApiParameter Name="ShowSeconds" Type="bool" Default="false">
                    @L.T("是否显示秒选择器。", "Whether to show the seconds selector.")
                </ApiParameter>
                <ApiParameter Name="MinuteStep" Type="int" Default="1">
                    @L.T("分钟步进间隔。", "The minute step interval.")
                </ApiParameter>
                <ApiParameter Name="MinTime" Type="TimeSpan?" Default="null">
                    @L.T("允许的最小时间。", "The minimum allowed time.")
                </ApiParameter>
                <ApiParameter Name="MaxTime" Type="TimeSpan?" Default="null">
                    @L.T("允许的最大时间。", "The maximum allowed time.")
                </ApiParameter>
                <ApiParameter Name="Placeholder" Type="string" Default="&quot;Select time&quot;">
                    @L.T("未选择时间时显示的占位文本。", "Placeholder text when no time is selected.")
                </ApiParameter>
                <ApiParameter Name="Disabled" Type="bool" Default="false">
                    @L.T("时间选择器是否被禁用。", "Whether the time picker is disabled.")
                </ApiParameter>
                <ApiParameter Name="Required" Type="bool" Default="false">
                    @L.T("时间选择器是否为必填。", "Whether the time picker is required.")
                </ApiParameter>
                <ApiParameter Name="InputClass" Type="string?" Default="null">
                    @L.T("应用到内部 TimePicker 触发按钮上的额外 CSS 类。", "Additional CSS classes applied to the inner TimePicker trigger button.")
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?" Default="null">
                    @L.T("应用到外部 Field 容器上的额外 CSS 类。", "Additional CSS classes applied to the outer Field container.")
                </ApiParameter>
                <ApiParameter Name="AriaLabel" Type="string?" Default="null">
                    @L.T("控件的 ARIA 标签。", "ARIA label for the control.")
                </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        应用到组件根元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        Additional HTML attributes applied to the component's root element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                    </ApiParameter>
                                </text>
}
            </ApiReference>
        </div>
    </section>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    private TimeSpan? _meetingTime;
    private TimeSpan? _departureTime;
    private TimeSpan? _preciseTime;
    private bool _formSubmitted;
    private TimePickerFormModel _formModel = new();

    private void HandleFormSubmit()
    {
        _formSubmitted = true;
    }

    private class TimePickerFormModel
    {
        [Required(ErrorMessage = "Please select a reminder time.")]
        public TimeSpan? ReminderTime { get; set; }
    }
}
