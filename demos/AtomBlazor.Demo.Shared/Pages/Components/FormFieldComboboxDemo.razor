    private ComboboxFormModel _formModel = new();

    private readonly SelectOption<string>[] _frameworks =
    [
        new("next.js", "Next.js"),
        new("sveltekit", "SvelteKit"),
        new("nuxt.js", "Nuxt.js"),
        new("remix", "Remix"),
        new("astro", "Astro"),
        new("blazor", "Blazor")
