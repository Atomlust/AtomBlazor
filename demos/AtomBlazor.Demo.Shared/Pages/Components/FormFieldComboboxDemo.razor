    [
        new(1, "Critical"),
        new(2, "High"),
        new(3, "Medium"),
        new(4, "Low")
    ];

    private readonly SelectOption<Guid?>[] _projects =
    [
        new(Guid.Parse("a1b2c3d4-0001-0000-0000-000000000001"), "Alpha"),
        new(Guid.Parse("a1b2c3d4-0002-0000-0000-000000000002"), "Beta"),
        new(Guid.Parse("a1b2c3d4-0003-0000-0000-000000000003"), "Gamma"),
        new(Guid.Parse("a1b2c3d4-0004-0000-0000-000000000004"), "Delta")
    ];

    private readonly Dictionary<string, string> _compositionalLabels = new()
    {
        ["blazor"] = "Blazor",
        ["react"] = "React",
        ["vue"] = "Vue.js",
        ["angular"] = "Angular",
        ["svelte"] = "Svelte"
    };

    private string GetCompositionalLabel(string value) =>
        _compositionalLabels.GetValueOrDefault(value) ?? value;

    private void HandleFormSubmit()
    {
        _formSubmitted = true;
    }

    // Infinite scroll example
    private string? _infiniteSelectedEmployee;
    private SelectOption<string>[] _infiniteEmployees = Array.Empty<SelectOption<string>>();
    private bool _infiniteIsLoading;
    private string _infiniteCurrentQuery = string.Empty;
    private int _infiniteFilteredTotal;
    private CancellationTokenSource? _employeeSearchCts;
    private const int employeePageSize = 20;

    private static readonly SelectOption<string>[] _allEmployees = GenerateEmployees();

    private static SelectOption<string>[] GenerateEmployees()
    {
        var firstNames = new[] { "James", "Mary", "John", "Patricia", "Robert", "Jennifer", "Michael", "Linda", "David", "Elizabeth",
                                 "William", "Barbara", "Richard", "Susan", "Joseph", "Jessica", "Thomas", "Sarah", "Christopher", "Karen" };
        var lastNames = new[] { "Smith", "Johnson", "Williams", "Brown", "Jones", "Garcia", "Miller", "Davis", "Rodriguez", "Martinez" };
        var departments = new[] { "Engineering", "Sales", "Marketing", "Finance", "HR", "Operations", "Support", "Legal", "Design", "Product" };

        var employees = new List<SelectOption<string>>();
        for (int i = 1; i <= 200; i++)
        {
            var first = firstNames[(i - 1) % firstNames.Length];
            var last = lastNames[(i - 1) / firstNames.Length % lastNames.Length];
            var dept = departments[(i - 1) % departments.Length];
            var id = $"emp-{i:D4}";
            var name = $"{first} {last} ({dept})";
            employees.Add(new SelectOption<string>(id, name));
        }

        return employees.ToArray();
    }

    protected override void OnInitialized()
    {
        _infiniteFilteredTotal = _allEmployees.Length;
        _infiniteEmployees = _allEmployees.Take(employeePageSize).ToArray();

        InitCountryScroll();
    }

    private async Task HandleEmployeeSearch(string query)
    {
        _employeeSearchCts?.Cancel();
        var cts = _employeeSearchCts = new CancellationTokenSource();

        _infiniteIsLoading = true;
        _infiniteCurrentQuery = query;
        // BL0012（.NET 11）：事件处理器触发的重渲染由框架自动完成，此处的显式 StateHasChanged 无需保留。

        try
        {
            await Task.Delay(200, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        var filtered = GetFilteredEmployees(query);
        _infiniteFilteredTotal = filtered.Length;
        _infiniteEmployees = filtered.Take(employeePageSize).ToArray();
        _infiniteIsLoading = false;
    }

    private async Task HandleLoadMoreEmployees()
    {
        _infiniteIsLoading = true;
        // BL0012（.NET 11）：事件处理器触发的重渲染由框架自动完成，此处的显式 StateHasChanged 无需保留。

        await Task.Delay(300);

        var filtered = GetFilteredEmployees(_infiniteCurrentQuery);
        _infiniteFilteredTotal = filtered.Length;
        var nextCount = _infiniteEmployees.Length + employeePageSize;
        _infiniteEmployees = filtered.Take(nextCount).ToArray();
        _infiniteIsLoading = false;
    }

    private SelectOption<string>[] GetFilteredEmployees(string query)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return _allEmployees;
        }

        return _allEmployees
            .Where(e => e.Text.Contains(query, StringComparison.OrdinalIgnoreCase))
            .ToArray();
    }

