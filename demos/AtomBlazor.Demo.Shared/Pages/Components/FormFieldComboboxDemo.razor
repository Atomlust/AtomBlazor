@page "/components/form-field-combobox"
@using System.ComponentModel.DataAnnotations

<PageTitle>@L.T("FormFieldCombobox 表单组合框 - Atom BlazorUI", "FormFieldCombobox Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <div class="flex items-center gap-3">
                <h1 class="text-4xl font-bold tracking-tight">FormFieldCombobox</h1>
                <span class="inline-flex items-center rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary ring-1 ring-inset ring-primary/20">v3</span>
            </div>
            <p class="text-xl text-muted-foreground">
                @L.T("Combobox 的表单字段封装，内置标签、提示文本与错误信息。",
                     "A form field wrapper for Combobox with built-in label, helper text, and error messages.")
            </p>
        </div>
    </div>

    <!-- Which form component? -->
    <div class="rounded-lg border border-dashed bg-muted/30 p-6 space-y-3">
        <h2 class="text-lg font-semibold">@L.T("该用哪个表单组件？", "Which form component?")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <div class="space-y-2 text-sm text-muted-foreground">
                <p><strong>文本输入</strong>（string、int、日期等）？ &rarr; <a href="/components/form-field-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldInput&lt;T&gt;</a></p>
                <p><strong>多行文本</strong>？ &rarr; <a href="/components/form-field-textarea" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldTextarea</a></p>
                <p><strong>数字输入</strong>？ &rarr; <a href="/components/form-field-numeric-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldNumericInput</a></p>
                <p><strong>货币输入</strong>？ &rarr; <a href="/components/form-field-currency-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCurrencyInput</a></p>
                <p><strong>掩码输入</strong>（电话、社保号等）？ &rarr; <a href="/components/form-field-masked-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldMaskedInput</a></p>
                <p><strong>OTP / 验证码</strong>？ &rarr; <a href="/components/form-field-input-otp" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldInputOTP</a></p>
                <p><strong>日期选择器</strong>？ &rarr; <a href="/components/form-field-date-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldDatePicker</a></p>
                <p><strong>日期区间选择器</strong>？ &rarr; <a href="/components/form-field-date-range-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldDateRangePicker</a></p>
                <p><strong>时间选择器</strong>？ &rarr; <a href="/components/form-field-time-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldTimePicker</a></p>
                <p><strong>复选框</strong>？ &rarr; <a href="/components/form-field-checkbox" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCheckbox</a></p>
                <p><strong>复选框组</strong>？ &rarr; <a href="/components/form-field-checkbox-group" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCheckboxGroup</a></p>
                <p><strong>开关</strong>？ &rarr; <a href="/components/form-field-switch" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldSwitch</a></p>
                <p><strong>单选组</strong>？ &rarr; <a href="/components/form-field-radio-group" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldRadioGroup</a></p>
                <p><strong>下拉选择</strong>？ &rarr; <a href="/components/form-field-select" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldSelect</a></p>
                <p><strong>原生 select</strong>？ &rarr; <a href="/components/form-field-native-select" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldNativeSelect</a></p>
                <p><strong>可搜索选择</strong>？ &rarr; <strong>FormFieldCombobox</strong>（当前页面）</p>
                <p><strong>多选</strong>？ &rarr; <a href="/components/form-field-multi-select" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldMultiSelect</a></p>
                <p><strong>标签输入</strong>？ &rarr; <a href="/components/form-field-tag-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldTagInput</a></p>
                <p><strong>文件上传</strong>？ &rarr; <a href="/components/form-field-file-upload" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldFileUpload</a></p>
            </div>
                </text>
}
        else
        {
                <text>
                    <div class="space-y-2 text-sm text-muted-foreground">
                <p><strong>Text input</strong> (string, int, date, etc.)? &rarr; <a href="/components/form-field-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldInput&lt;T&gt;</a></p>
                <p><strong>Textarea</strong>? &rarr; <a href="/components/form-field-textarea" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldTextarea</a></p>
                <p><strong>Numeric input</strong>? &rarr; <a href="/components/form-field-numeric-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldNumericInput</a></p>
                <p><strong>Currency input</strong>? &rarr; <a href="/components/form-field-currency-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCurrencyInput</a></p>
                <p><strong>Masked input</strong> (phone, SSN, etc.)? &rarr; <a href="/components/form-field-masked-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldMaskedInput</a></p>
                <p><strong>OTP / verification code</strong>? &rarr; <a href="/components/form-field-input-otp" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldInputOTP</a></p>
                <p><strong>Date picker</strong>? &rarr; <a href="/components/form-field-date-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldDatePicker</a></p>
                <p><strong>Date range picker</strong>? &rarr; <a href="/components/form-field-date-range-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldDateRangePicker</a></p>
                <p><strong>Time picker</strong>? &rarr; <a href="/components/form-field-time-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldTimePicker</a></p>
                <p><strong>Checkbox</strong>? &rarr; <a href="/components/form-field-checkbox" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCheckbox</a></p>
                <p><strong>Checkbox group</strong>? &rarr; <a href="/components/form-field-checkbox-group" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCheckboxGroup</a></p>
                <p><strong>Switch</strong>? &rarr; <a href="/components/form-field-switch" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldSwitch</a></p>
                <p><strong>Radio group</strong>? &rarr; <a href="/components/form-field-radio-group" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldRadioGroup</a></p>
                <p><strong>Select dropdown</strong>? &rarr; <a href="/components/form-field-select" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldSelect</a></p>
                <p><strong>Native select</strong>? &rarr; <a href="/components/form-field-native-select" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldNativeSelect</a></p>
                <p><strong>Searchable select</strong>? &rarr; <strong>FormFieldCombobox</strong> (this page)</p>
                <p><strong>Multi-select</strong>? &rarr; <a href="/components/form-field-multi-select" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldMultiSelect</a></p>
                <p><strong>Tag input</strong>? &rarr; <a href="/components/form-field-tag-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldTagInput</a></p>
                <p><strong>File upload</strong>? &rarr; <a href="/components/form-field-file-upload" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldFileUpload</a></p>
            </div>
                </text>
}
    </div>

    <!-- Basic Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("基本用法", "Basic Usage")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    带标签与提示文本的可搜索组合框。通过 <code class="text-xs bg-muted px-1 py-0.5 rounded">Options</code> 提供下拉条目。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    A searchable combobox with a label and helper text.
                    Provide <code class="text-xs bg-muted px-1 py-0.5 rounded">Options</code> to populate the list.
                </p>
                        </text>
}
        </div>
        <div class="max-w-md">
            <FormFieldCombobox AriaLabel="@(L.T("框架", "Framework"))" TValue="string"
                               Options="_frameworks"
                               @bind-Value="_selectedFramework"
                               Label="@(L.T("框架", "Framework"))"
                               Placeholder="@(L.T("选择框架……", "Select framework..."))"
                               SearchPlaceholder="@(L.T("搜索框架……", "Search framework..."))"
                               EmptyMessage="@(L.T("未找到框架。", "No framework found."))"
                               HelperText="@(L.T("选择你偏好的框架。", "Choose your preferred framework."))"
                               MatchTriggerWidth="true"
                               InputClass="w-full" />
        </div>
        <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
            <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected value:")</span> <span class="font-mono">@(string.IsNullOrEmpty(_selectedFramework) ? L.T("（无）", "(none)") : _selectedFramework)</span></p>
            <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(string.IsNullOrEmpty(_selectedFramework) ? L.T("（无）", "(none)") : _frameworks.GetText(_selectedFramework))</p>
        </div>
        <CodeBlock Source="Components/FormFieldCombobox/basic.txt" />
    </div>

    <!-- Compositional Mode -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("组合式模式", "Compositional Mode")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    想要完全控制条目渲染时，省略 <code class="text-xs bg-muted px-1 py-0.5 rounded">Options</code>，
                    改为使用 <code class="text-xs bg-muted px-1 py-0.5 rounded">ComboboxItem</code> 子内容。
                    搜索、键盘导航与选择的行为完全一致。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    For full control over item rendering, omit <code class="text-xs bg-muted px-1 py-0.5 rounded">Options</code>
                    and use <code class="text-xs bg-muted px-1 py-0.5 rounded">ComboboxItem</code> children instead.
                    Search, keyboard navigation, and selection work identically.
                </p>
                        </text>
}
        </div>
        <div class="max-w-md">
            <FormFieldCombobox TValue="string"
                               @bind-Value="_compositionalValue"
                               Label="@(L.T("技术栈", "Tech stack"))"
                               Placeholder="@(L.T("选择技术栈……", "Select a stack..."))"
                               SearchPlaceholder="@(L.T("搜索……", "Search..."))"
                               EmptyMessage="@(L.T("未找到技术栈。", "No stack found."))"
                               HelperText="@(L.T("选择你的主要技术。", "Choose your primary technology."))"
                               MatchTriggerWidth="true"
                               InputClass="w-full">
                <ComboboxItem Value="@("blazor")" Text="Blazor">
                    <div class="flex items-center gap-2">
                        <span class="inline-block h-2 w-2 rounded-full bg-purple-500"></span>
                        Blazor
                    </div>
                </ComboboxItem>
                <ComboboxItem Value="@("react")" Text="React">
                    <div class="flex items-center gap-2">
                        <span class="inline-block h-2 w-2 rounded-full bg-blue-500"></span>
                        React
                    </div>
                </ComboboxItem>
                <ComboboxItem Value="@("vue")" Text="Vue.js">
                    <div class="flex items-center gap-2">
                        <span class="inline-block h-2 w-2 rounded-full bg-green-500"></span>
                        Vue.js
                    </div>
                </ComboboxItem>
                <ComboboxItem Value="@("angular")" Text="Angular">
                    <div class="flex items-center gap-2">
                        <span class="inline-block h-2 w-2 rounded-full bg-red-500"></span>
                        Angular
                    </div>
                </ComboboxItem>
                <ComboboxItem Value="@("svelte")" Text="Svelte">
                    <div class="flex items-center gap-2">
                        <span class="inline-block h-2 w-2 rounded-full bg-orange-500"></span>
                        Svelte
                    </div>
                </ComboboxItem>
            </FormFieldCombobox>
        </div>
        <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
            <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected value:")</span> <span class="font-mono">@(string.IsNullOrEmpty(_compositionalValue) ? L.T("（无）", "(none)") : _compositionalValue)</span></p>
            <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(string.IsNullOrEmpty(_compositionalValue) ? L.T("（无）", "(none)") : GetCompositionalLabel(_compositionalValue))</p>
        </div>
        <CodeBlock Source="Components/FormFieldCombobox/compositional.txt" />
    </div>

    <!-- Grouped Items -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("分组条目", "Grouped Items")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    用 <code class="text-xs bg-muted px-1 py-0.5 rounded">ComboboxGroup</code> 把条目归到带标签的分节里。
                    当某个分组的条目全部被筛掉时，该分组会自动隐藏。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use <code class="text-xs bg-muted px-1 py-0.5 rounded">ComboboxGroup</code> to organize items
                    under labeled sections. Groups automatically hide when their items are filtered out.
                </p>
                        </text>
}
        </div>
        <div class="max-w-md">
            <FormFieldCombobox TValue="string"
                               @bind-Value="_groupedValue"
                               Label="@(L.T("属性", "Attribute"))"
                               Placeholder="@(L.T("选择属性……", "Select attribute..."))"
                               SearchPlaceholder="@(L.T("搜索……", "Search..."))"
                               EmptyMessage="@(L.T("未找到属性。", "No attribute found."))"
                               HelperText="@(L.T("选择一个用于筛选的属性。", "Choose an attribute to filter by."))"
                               MatchTriggerWidth="true"
                               InputClass="w-full">
                <ComboboxGroup Label="@(L.T("员工", "Employee"))">
                    <ComboboxItem Value="@("gender")" Text="@(L.T("性别", "Gender"))">@L.T("性别", "Gender")</ComboboxItem>
                    <ComboboxItem Value="@("nationality")" Text="@(L.T("国籍", "Nationality"))">@L.T("国籍", "Nationality")</ComboboxItem>
                    <ComboboxItem Value="@("age")" Text="@(L.T("年龄", "Age"))">@L.T("年龄", "Age")</ComboboxItem>
                </ComboboxGroup>
                <ComboboxGroup Label="@(L.T("雇佣", "Employment"))">
                    <ComboboxItem Value="@("company")" Text="@(L.T("公司", "Company"))">@L.T("公司", "Company")</ComboboxItem>
                    <ComboboxItem Value="@("jobTitle")" Text="@(L.T("职位", "Job Title"))">@L.T("职位", "Job Title")</ComboboxItem>
                    <ComboboxItem Value="@("department")" Text="@(L.T("部门", "Department"))">@L.T("部门", "Department")</ComboboxItem>
                </ComboboxGroup>
            </FormFieldCombobox>
        </div>
        <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
            <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected value:")</span> <span class="font-mono">@(string.IsNullOrEmpty(_groupedValue) ? L.T("（无）", "(none)") : _groupedValue)</span></p>
        </div>
        <CodeBlock Source="Components/FormFieldCombobox/grouped.txt" />
    </div>

    <!-- Non-String Value Types -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("非字符串值类型", "Non-String Value Types")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    用 <code class="text-xs bg-muted px-1 py-0.5 rounded">TValue</code> 绑定到 <code class="text-xs bg-muted px-1 py-0.5 rounded">int?</code> 这类非字符串类型，
                    组件会自动处理转换。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use <code class="text-xs bg-muted px-1 py-0.5 rounded">TValue</code> to bind to non-string types such as
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">int?</code>. The component handles conversion automatically.
                </p>
                        </text>
}
        </div>
        <div class="max-w-md">
            <FormFieldCombobox TValue="int?"
                               Options="_priorities"
                               @bind-Value="_selectedPriority"
                               Label="@(L.T("优先级", "Priority"))"
                               Placeholder="@(L.T("选择优先级……", "Select priority..."))"
                               SearchPlaceholder="@(L.T("搜索优先级……", "Search priorities..."))"
                               EmptyMessage="@(L.T("未找到优先级。", "No priority found."))"
                               HelperText="@(L.T("选择任务的优先级。", "Choose the task priority level."))"
                               MatchTriggerWidth="true"
                               InputClass="w-full" />
        </div>
        <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
            <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected value:")</span> <span class="font-mono">@(_selectedPriority.HasValue ? _selectedPriority.Value.ToString() : L.T("（无）", "(none)"))</span></p>
            <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(_selectedPriority.HasValue ? _priorities.GetText(_selectedPriority) : L.T("（无）", "(none)"))</p>
        </div>
        <CodeBlock Source="Components/FormFieldCombobox/non-string.txt" />
    </div>

    <!-- Guid Values -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("Guid 值", "Guid Values")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    当条目使用唯一标识符时，可绑定到 <code class="text-xs bg-muted px-1 py-0.5 rounded">Guid?</code>。
                    设置 <code class="text-xs bg-muted px-1 py-0.5 rounded">TValue="Guid?"</code> 后，
                    组件会处理序列化与比较。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Bind to <code class="text-xs bg-muted px-1 py-0.5 rounded">Guid?</code> values when your items use
                    unique identifiers. Set <code class="text-xs bg-muted px-1 py-0.5 rounded">TValue="Guid?"</code> and
                    the component handles serialization and comparison.
                </p>
                        </text>
}
        </div>
        <div class="max-w-md">
            <FormFieldCombobox TValue="Guid?"
                               Options="_projects"
                               @bind-Value="_selectedProject"
                               Label="@(L.T("项目", "Project"))"
                               Placeholder="@(L.T("选择项目……", "Select project..."))"
                               SearchPlaceholder="@(L.T("搜索项目……", "Search projects..."))"
                               EmptyMessage="@(L.T("未找到项目。", "No project found."))"
                               HelperText="@(L.T("选择目标任务所属的项目。", "Choose the target project."))"
                               MatchTriggerWidth="true"
                               InputClass="w-full" />
        </div>
        <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
            <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected value:")</span> <span class="font-mono">@(_selectedProject.HasValue ? _selectedProject.Value.ToString() : L.T("（无）", "(none)"))</span></p>
            <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(_selectedProject.HasValue ? _projects.GetText(_selectedProject) : L.T("（无）", "(none)"))</p>
        </div>
        <CodeBlock Source="Components/FormFieldCombobox/guid.txt" />
    </div>

    <!-- Disabled -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("禁用", "Disabled")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("一个禁用的组合框表单字段，已预选一个值。",
                     "A disabled combobox form field with a pre-selected value.")
            </p>
        </div>
        <div class="max-w-md">
            <FormFieldCombobox TValue="string"
                               Options="_frameworks"
                               Value="@("blazor")"
                               Label="@(L.T("框架", "Framework"))"
                               Placeholder="@(L.T("选择……", "Select..."))"
                               HelperText="@(L.T("已锁定为当前项目使用的框架。", "Locked to your project's framework."))"
                               MatchTriggerWidth="true"
                               InputClass="w-full"
                               Disabled="true" />
        </div>
        <CodeBlock Source="Components/FormFieldCombobox/disabled.txt" />
    </div>

    <!-- EditForm Integration -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("EditForm 集成", "EditForm Integration")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("在 EditForm 中，校验错误会自动显示。试试不选择语言直接提交。",
                     "Validation errors display automatically inside an EditForm. Try submitting without selecting a language.")
            </p>
        </div>
        <div class="max-w-md">
            <EditForm Model="_formModel" OnValidSubmit="HandleFormSubmit">
                <DataAnnotationsValidator />
                <div class="space-y-4">
                    <FormFieldCombobox TValue="string"
                                       Options="_languages"
                                       @bind-Value="_formModel.Language"
                                       Label="@(L.T("主要语言", "Primary language"))"
                                       Placeholder="@(L.T("选择语言……", "Select a language..."))"
                                       SearchPlaceholder="@(L.T("搜索语言……", "Search languages..."))"
                                       MatchTriggerWidth="true"
                                       InputClass="w-full" />
