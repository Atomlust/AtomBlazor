@page "/components/avatar"

<PageTitle>@L.T("Avatar 头像 - Atom BlazorUI", "Avatar - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("Avatar 头像组件", "Avatar Component")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("用于表示用户或实体的图片元素，加载不到时自动回退。", "An image element with a fallback for representing a user or entity.")
            </p>
        </div>
    </div>

    @* Basic Usage *@
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("基本用法", "Basic Usage")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("显示用户头像，取不到图片时自动回退为姓名首字母。", "Display a user avatar with automatic fallback to initials.")
            </p>
        </div>
        <div class="flex gap-4">
            <Avatar>
                <AvatarImage Source="_content/AtomBlazor.Demo.Shared/images/mathew-icon.png" Alt="Mathew" />
                <AvatarFallback>SH</AvatarFallback>
            </Avatar>

            <Avatar>
                <AvatarImage Source="https://unavailable-image.jpg" Alt="@(L.T("用户", "User"))" />
                <AvatarFallback>JD</AvatarFallback>
            </Avatar>
        </div>

        <CodeBlock Source="Components/Avatar/basic.txt" />
    </div>

    @* Size Variants *@
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("尺寸变体", "Size Variants")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("头像有四种尺寸。", "Avatars come in four different sizes.")
            </p>
        </div>
        <div class="flex items-center gap-6">
            <div class="flex flex-col items-center gap-2">
                <Avatar Size="AvatarSize.Small">
                    <AvatarFallback>XS</AvatarFallback>
                </Avatar>
                <span class="text-xs text-muted-foreground">@L.T("小号", "Small")</span>
            </div>

            <div class="flex flex-col items-center gap-2">
                <Avatar Size="AvatarSize.Default">
                    <AvatarFallback>MD</AvatarFallback>
                </Avatar>
                <span class="text-xs text-muted-foreground">@L.T("默认", "Default")</span>
            </div>

            <div class="flex flex-col items-center gap-2">
                <Avatar Size="AvatarSize.Large">
                    <AvatarFallback>LG</AvatarFallback>
                </Avatar>
                <span class="text-xs text-muted-foreground">@L.T("大号", "Large")</span>
            </div>

            <div class="flex flex-col items-center gap-2">
                <Avatar Size="AvatarSize.ExtraLarge">
                    <AvatarFallback>XL</AvatarFallback>
                </Avatar>
                <span class="text-xs text-muted-foreground">@L.T("超大", "Extra Large")</span>
            </div>
        </div>

        <CodeBlock Source="Components/Avatar/sizes.txt" />
    </div>

    @* With Images *@
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("使用图片", "With Images")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("显示真实的用户头像图片，并保留回退支持。", "Display actual user profile images with fallback support.")
            </p>
        </div>
        <div class="flex gap-4">
            <Avatar Size="AvatarSize.Large">
                <AvatarImage Source="https://github.com/vercel.png" Alt="Vercel" />
                <AvatarFallback>VC</AvatarFallback>
            </Avatar>

            <Avatar Size="AvatarSize.Large">
                <AvatarImage Source="https://github.com/microsoft.png" Alt="Microsoft" />
                <AvatarFallback>MS</AvatarFallback>
            </Avatar>

            <Avatar Size="AvatarSize.Large">
                <AvatarImage Source="https://github.com/google.png" Alt="Google" />
                <AvatarFallback>GG</AvatarFallback>
            </Avatar>
        </div>

        <CodeBlock Source="Components/Avatar/with-images.txt" />
    </div>

    @* With Icons *@
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("使用图标", "With Icons")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("用图标作为回退内容，表示身份不明的通用用户。", "Use icons as fallback content for generic user representations.")
            </p>
        </div>
        <div class="flex gap-4">
            <Avatar>
                <AvatarFallback>
                    <LucideIcon Name="user" Size="20" />
                </AvatarFallback>
            </Avatar>

            <Avatar Size="AvatarSize.Large">
                <AvatarFallback>
                    <LucideIcon Name="circle-user" Size="24" />
                </AvatarFallback>
            </Avatar>

            <Avatar Size="AvatarSize.ExtraLarge">
                <AvatarFallback>
                    <LucideIcon Name="users" Size="32" />
                </AvatarFallback>
            </Avatar>
        </div>

        <CodeBlock Source="Components/Avatar/with-icons.txt" />
    </div>

    @* User List Example *@
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("用户列表", "User List")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("展示用户或团队成员列表的常见形态。", "Common pattern for displaying a list of users or team members.")
            </p>
        </div>
        <div class="border rounded-lg divide-y">
            <div class="flex items-center gap-4 p-4 hover:bg-accent transition-colors">
                <Avatar>
                    <AvatarFallback>JD</AvatarFallback>
                </Avatar>
                <div class="flex-1">
                    <p class="font-medium">John Doe</p>
                    <p class="text-sm text-muted-foreground">john.doe@example.com</p>
                </div>
            </div>

            <div class="flex items-center gap-4 p-4 hover:bg-accent transition-colors">
                <Avatar>
                    <AvatarFallback>AS</AvatarFallback>
                </Avatar>
                <div class="flex-1">
                    <p class="font-medium">Alice Smith</p>
                    <p class="text-sm text-muted-foreground">alice.smith@example.com</p>
                </div>
            </div>

            <div class="flex items-center gap-4 p-4 hover:bg-accent transition-colors">
                <Avatar>
                    <AvatarFallback>BJ</AvatarFallback>
                </Avatar>
                <div class="flex-1">
                    <p class="font-medium">Bob Johnson</p>
                    <p class="text-sm text-muted-foreground">bob.johnson@example.com</p>
                </div>
            </div>
        </div>

        <CodeBlock Source="Components/Avatar/user-list.txt" />
    </div>

    @* Avatar Group *@
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("头像组", "Avatar Group")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    用 <code class="text-xs bg-muted px-1 py-0.5 rounded">AvatarGroup</code> 让头像叠加排列，并自动带上描边圆环样式。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use <code class="text-xs bg-muted px-1 py-0.5 rounded">AvatarGroup</code> to stack avatars with overlapping layout and automatic ring styling.
                </p>
                        </text>
}
        </div>
        <AvatarGroup>
            <Avatar>
                <AvatarFallback>AB</AvatarFallback>
            </Avatar>
            <Avatar>
                <AvatarFallback>CD</AvatarFallback>
            </Avatar>
            <Avatar>
                <AvatarFallback>EF</AvatarFallback>
            </Avatar>
            <Avatar>
                <AvatarFallback>GH</AvatarFallback>
            </Avatar>
            <Avatar>
                <AvatarFallback Class="bg-primary text-primary-foreground">+5</AvatarFallback>
            </Avatar>
        </AvatarGroup>
        <AvatarGroup>
            <Avatar Size="AvatarSize.Large">
                <AvatarImage Source="https://github.com/vercel.png" Alt="Vercel" />
                <AvatarFallback>VC</AvatarFallback>
            </Avatar>
            <Avatar Size="AvatarSize.Large">
                <AvatarImage Source="https://github.com/microsoft.png" Alt="Microsoft" />
                <AvatarFallback>MS</AvatarFallback>
            </Avatar>
            <Avatar Size="AvatarSize.Large">
                <AvatarImage Source="https://github.com/google.png" Alt="Google" />
                <AvatarFallback>GG</AvatarFallback>
            </Avatar>
        </AvatarGroup>

        <CodeBlock Source="Components/Avatar/group.txt" />
    </div>

    @* Custom Styles *@
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("自定义样式", "Custom Styles")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("用额外的 CSS 类自定义头像外观。", "Customize avatar appearance with additional CSS classes.")
            </p>
        </div>
        <div class="flex gap-4">
            <Avatar Size="AvatarSize.Large">
                <AvatarFallback Class="bg-gradient-to-br from-purple-500 to-pink-500 text-white">
                    AB
                </AvatarFallback>
            </Avatar>

            <Avatar Size="AvatarSize.Large">
                <AvatarFallback Class="bg-gradient-to-br from-blue-500 to-cyan-500 text-white">
                    CD
                </AvatarFallback>
            </Avatar>

            <Avatar Size="AvatarSize.Large">
                <AvatarFallback Class="bg-gradient-to-br from-green-500 to-emerald-500 text-white">
                    EF
                </AvatarFallback>
            </Avatar>

            <Avatar Size="AvatarSize.Large">
                <AvatarFallback Class="bg-gradient-to-br from-orange-500 to-red-500 text-white">
                    GH
                </AvatarFallback>
            </Avatar>
        </div>

        <CodeBlock Source="Components/Avatar/custom-styles.txt" />
    </div>

    @* Dot Indicator *@
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("圆点指示", "Dot Indicator")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    用 <code class="text-xs bg-muted px-1 py-0.5 rounded">ShowDot</code> 和 <code class="text-xs bg-muted px-1 py-0.5 rounded">DotClass</code> 加上一个带颜色的状态圆点。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use <code class="text-xs bg-muted px-1 py-0.5 rounded">ShowDot</code> and <code class="text-xs bg-muted px-1 py-0.5 rounded">DotClass</code> to add a colored dot indicator.
                </p>
                        </text>
}
        </div>
        <div class="flex gap-6">
            <Avatar Size="AvatarSize.Large" ShowDot DotClass="bg-green-500">
                <AvatarFallback>JD</AvatarFallback>
            </Avatar>

            <Avatar Size="AvatarSize.Large" ShowDot DotClass="bg-yellow-500">
                <AvatarFallback>AS</AvatarFallback>
            </Avatar>

            <Avatar Size="AvatarSize.Large" ShowDot DotClass="bg-red-500">
                <AvatarFallback>BJ</AvatarFallback>
            </Avatar>

            <Avatar Size="AvatarSize.Large" ShowDot DotClass="bg-gray-400">
                <AvatarFallback>MK</AvatarFallback>
            </Avatar>
        </div>
        <div class="flex items-center gap-6">
            <Avatar Size="AvatarSize.Small" ShowDot DotClass="bg-green-500">
                <AvatarFallback>SM</AvatarFallback>
            </Avatar>
            <Avatar ShowDot DotClass="bg-green-500">
                <AvatarFallback>MD</AvatarFallback>
            </Avatar>
            <Avatar Size="AvatarSize.Large" ShowDot DotClass="bg-green-500">
                <AvatarFallback>LG</AvatarFallback>
            </Avatar>
            <Avatar Size="AvatarSize.ExtraLarge" ShowDot DotClass="bg-green-500">
                <AvatarFallback>XL</AvatarFallback>
            </Avatar>
        </div>

        <CodeBlock Source="Components/Avatar/dot-indicator.txt" />
    </div>

    @* Accessibility *@
    <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>
                @L.T("AvatarImage 要提供描述性的 alt 文本，点明这个人或实体是谁。", "Always provide descriptive alt text for AvatarImage that identifies the person or entity.")
            </AccessibilityItem>
            <AccessibilityItem>
                @L.T("图片加载失败时，用有意义的字母或图标来帮助用户身份识别。", "Use meaningful initials or icons that help identify the user when images fail.")
            </AccessibilityItem>
            <AccessibilityItem>
                @L.T("头像本身是纯展示元素。若要可点击，请包进按钮并配上正确的 ARIA 标签。", "Avatars are purely presentational. If clickable, wrap in a button with proper ARIA label.")
            </AccessibilityItem>
            <AccessibilityItem>
                @L.T("使用状态圆点时，建议再加 aria-label，把状态告诉读屏器。", "If using status dots, consider adding aria-label to convey state to screen readers.")
            </AccessibilityItem>
        </AriaAttributes>
    </AccessibilityList>

    @* API Reference *@
    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件的属性与参数。", "Component properties and parameters.")</p>
        </div>

        <div class="space-y-4">
            <ApiReference ComponentName="Avatar">
                <ApiParameter Name="Size" Type="AvatarSize" Default="AvatarSize.Default">
                    @L.T("控制头像的尺寸。可选值：Small（32px）、Default（40px）、Large（48px）、ExtraLarge（64px）。", "Controls the dimensions of the avatar. Options: Small (32px), Default (40px), Large (48px), ExtraLarge (64px).")
                </ApiParameter>
                <ApiParameter Name="ShowDot / DotClass" Type="bool / string?">
                    @L.T("加上一个带颜色的状态圆点；DotClass 可覆盖默认的 primary 填充色。", "Adds a colored status dot; DotClass overrides the default primary fill.")
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?">
                    @L.T("头像容器的额外 CSS 类。", "Additional CSS classes for the avatar container.")
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            应用到根 <code>&lt;span&gt;</code> 元素的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                                        </text>
}
                    else
                    {
                                        <text>
                                            Additional HTML attributes applied to the root <code>&lt;span&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                                        </text>
}
                </ApiParameter>
            </ApiReference>

            <ApiReference ComponentName="AvatarImage">
                <ApiParameter Name="Source" Type="string?">
                    @L.T("要显示的图片地址。加载失败时改用 AvatarFallback。", "URL of the image to display. If loading fails, AvatarFallback will be shown.")
                </ApiParameter>
                <ApiParameter Name="Alt" Type="string?">
                    @L.T("图片的替代文本（无障碍必需）。", "Alternative text for the image (required for accessibility).")
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?">
                    @L.T("图片元素的额外 CSS 类。", "Additional CSS classes for the image element.")
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            应用到根 <code>&lt;img&gt;</code> 元素的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                                        </text>
}
                    else
                    {
                                        <text>
                                            Additional HTML attributes applied to the root <code>&lt;img&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                                        </text>
}
                </ApiParameter>
            </ApiReference>

            <ApiReference ComponentName="AvatarFallback">
                <ApiParameter Name="Class" Type="string?">
                    @L.T("回退容器的额外 CSS 类，适合用来定制背景色。", "Additional CSS classes for the fallback container. Useful for custom background colors.")
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            应用到根 <code>&lt;span&gt;</code> 元素的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                                        </text>
}
                    else
                    {
                                        <text>
                                            Additional HTML attributes applied to the root <code>&lt;span&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                                        </text>
}
                </ApiParameter>
            </ApiReference>
        </div>
    </section>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;
}
