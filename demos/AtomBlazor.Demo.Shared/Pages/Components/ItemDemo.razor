@page "/components/item"

<PageTitle>@L.T("Item 列表项 - Atom BlazorUI", "Item Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("Item 列表项组件", "Item Component")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("灵活、可组合的列表项组件，用于构建包含媒体、内容与操作区的列表项。", "A flexible, composable component for building list items with media, content, and actions.")
            </p>
        </div>
    </div>

    <div class="space-y-6">
    </div>

    @* Basic Examples *@
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("基本列表项", "Basic Item")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("带标题与说明的简单列表项。", "A simple item with title and description.")
            </p>
        </div>
        <Item Variant="ItemVariant.Outline">
            <ItemContent>
                <ItemTitle>@L.T("基本列表项", "Basic Item")</ItemTitle>
                <ItemDescription>
                    @L.T("带标题与说明的简单列表项。", "A simple item with title and description.")
                </ItemDescription>
            </ItemContent>
            <ItemActions>
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small">@L.T("操作", "Action")</Button>
            </ItemActions>
        </Item>
        <CodeBlock Source="Components/Item/basic.txt" />
    </div>

    @* Notification List Example *@
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("通知列表", "Notification List")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("以图标、标题、说明与时间戳展示通知的列表项。", "Items displaying notifications with icons, titles, descriptions, and timestamps.")
            </p>
        </div>
        <ItemGroup>
            <Item Variant="ItemVariant.Default">
                <ItemMedia Variant="ItemMediaVariant.Icon">
                    <LucideIcon Name="circle-check" Size="18" Class="text-green-600" />
                </ItemMedia>
                <ItemContent>
                    <ItemTitle>@L.T("保存成功", "Successfully saved")</ItemTitle>
                    <ItemDescription>@L.T("你的更改已保存到数据库中。", "Your changes have been saved to the database.")</ItemDescription>
                </ItemContent>
                <ItemActions>
                    <span class="text-xs text-muted-foreground">@L.T("2 分钟前", "2m ago")</span>
                </ItemActions>
            </Item>
            <ItemSeparator />
            <Item Variant="ItemVariant.Default">
                <ItemMedia Variant="ItemMediaVariant.Icon">
                    <LucideIcon Name="info" Size="18" Class="text-blue-600" />
                </ItemMedia>
                <ItemContent>
                    <ItemTitle>@L.T("有新版本可用", "New update available")</ItemTitle>
                    <ItemDescription>@L.T("2.0 版本现已可下载。", "Version 2.0 is now available for download.")</ItemDescription>
                </ItemContent>
                <ItemActions>
                    <span class="text-xs text-muted-foreground">@L.T("1 小时前", "1h ago")</span>
                </ItemActions>
            </Item>
            <ItemSeparator />
            <Item Variant="ItemVariant.Default">
                <ItemMedia Variant="ItemMediaVariant.Icon">
                    <LucideIcon Name="circle-alert" Size="18" Class="text-yellow-600" />
                </ItemMedia>
                <ItemContent>
                    <ItemTitle>@L.T("警告：存储空间上限", "Warning: Storage limit")</ItemTitle>
                    <ItemDescription>@L.T("你的存储空间即将达到上限，建议升级套餐。", "You're approaching your storage limit. Consider upgrading your plan.")</ItemDescription>
                </ItemContent>
                <ItemActions>
                    <span class="text-xs text-muted-foreground">@L.T("3 小时前", "3h ago")</span>
                </ItemActions>
            </Item>
            <ItemSeparator />
            <Item Variant="ItemVariant.Default">
                <ItemMedia Variant="ItemMediaVariant.Icon">
                    <LucideIcon Name="circle-x" Size="18" Class="text-red-600" />
                </ItemMedia>
                <ItemContent>
                    <ItemTitle>@L.T("错误：同步失败", "Error: Failed to sync")</ItemTitle>
                    <ItemDescription>@L.T("无法同步你的数据。请检查网络连接。", "Could not sync your data. Please check your connection.")</ItemDescription>
                </ItemContent>
                <ItemActions>
                    <span class="text-xs text-muted-foreground">@L.T("1 天前", "1d ago")</span>
                </ItemActions>
            </Item>
        </ItemGroup>
        <CodeBlock Source="Components/Item/notification-list.txt" />
    </div>

    @* Settings Items Example *@
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("设置项", "Settings Items")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("可点击的设置行，带图标与说明，并使用 AsChild 渲染为链接。", "Clickable settings rows with icons and descriptions using AsChild to render as links.")
            </p>
        </div>
        <ItemGroup>
            <Item Variant="ItemVariant.Outline" Size="ItemSize.Sm" AsChild="a" Href="#profile">
                <ItemMedia>
                    <LucideIcon Name="user" Size="18" />
                </ItemMedia>
                <ItemContent>
                    <ItemTitle>@L.T("个人资料设置", "Profile Settings")</ItemTitle>
                </ItemContent>
                <ItemActions>
                    <LucideIcon Name="chevron-right" Size="16" />
                </ItemActions>
            </Item>
            <Item Variant="ItemVariant.Outline" Size="ItemSize.Sm" AsChild="a" Href="#notifications">
                <ItemMedia>
                    <LucideIcon Name="bell" Size="18" />
                </ItemMedia>
                <ItemContent>
                    <ItemTitle>@L.T("通知设置", "Notification Settings")</ItemTitle>
                </ItemContent>
                <ItemActions>
                    <LucideIcon Name="chevron-right" Size="16" />
                </ItemActions>
            </Item>
            <Item Variant="ItemVariant.Outline" Size="ItemSize.Sm" AsChild="a" Href="#security">
                <ItemMedia>
                    <LucideIcon Name="shield" Size="18" />
                </ItemMedia>
                <ItemContent>
                    <ItemTitle>@L.T("安全与隐私", "Security & Privacy")</ItemTitle>
                </ItemContent>
                <ItemActions>
                    <LucideIcon Name="chevron-right" Size="16" />
                </ItemActions>
            </Item>
            <Item Variant="ItemVariant.Outline" Size="ItemSize.Sm" AsChild="a" Href="#billing">
                <ItemMedia>
                    <LucideIcon Name="credit-card" Size="18" />
                </ItemMedia>
                <ItemContent>
                    <ItemTitle>@L.T("账单与套餐", "Billing & Plans")</ItemTitle>
                </ItemContent>
                <ItemActions>
                    <LucideIcon Name="chevron-right" Size="16" />
                </ItemActions>
            </Item>
        </ItemGroup>
        <CodeBlock Source="Components/Item/settings.txt" />
    </div>

