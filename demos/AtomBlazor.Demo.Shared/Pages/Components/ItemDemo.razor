    @* AsChild Example *@
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("多态渲染（AsChild）", "Polymorphic Rendering (AsChild)")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("通过 AsChild 参数，列表项可以渲染为不同的 HTML 元素。", "Items can render as different HTML elements using the AsChild parameter.")
            </p>
        </div>
        <div class="space-y-3">
            <div class="space-y-2">
                <h3 class="text-lg font-medium">@L.T("渲染为 a 标签", "As Anchor Tag")</h3>
                <Item Variant="ItemVariant.Outline" AsChild="a" Href="https://github.com" target="_blank">
                    <ItemMedia>
                        <LucideIcon Name="github" Size="18" />
                    </ItemMedia>
                    <ItemContent>
                        <ItemTitle>@L.T("在 GitHub 上查看", "View on GitHub")</ItemTitle>
                        <ItemDescription>@L.T("在新标签页中打开", "Opens in a new tab")</ItemDescription>
                    </ItemContent>
                    <ItemActions>
                        <LucideIcon Name="external-link" Size="16" />
                    </ItemActions>
                </Item>
            </div>
            <div class="space-y-2">
                <h3 class="text-lg font-medium">@L.T("渲染为按钮", "As Button")</h3>
                <Item Variant="ItemVariant.Outline" AsChild="button" @onclick="@(() => {})">
                    <ItemMedia>
                        <LucideIcon Name="star" Size="18" />
                    </ItemMedia>
                    <ItemContent>
                        <ItemTitle>@L.T("标记为收藏", "Mark as Favorite")</ItemTitle>
                        <ItemDescription>@L.T("点击可切换收藏状态", "Click to toggle favorite status")</ItemDescription>
                    </ItemContent>
                </Item>
            </div>
        </div>
        <CodeBlock Source="Components/Item/as-child.txt" />
    </div>

    @* Complex Example with Header and Footer *@
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("复杂布局", "Complex Layout")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("使用 ItemHeader 与 ItemFooter 构建进阶布局。", "Using ItemHeader and ItemFooter for advanced layouts.")
            </p>
        </div>
        <Item Variant="ItemVariant.Outline" Class="flex-wrap">
            <ItemMedia Variant="ItemMediaVariant.Image">
                <Avatar>
                    <AvatarFallback>TR</AvatarFallback>
                </Avatar>
            </ItemMedia>
            <ItemContent>
                <ItemTitle>@L.T("任务报告", "Task Report")</ItemTitle>
                <ItemDescription>@L.T("已完成任务与项目的月度汇总。", "Monthly summary of completed tasks and projects.")</ItemDescription>
            </ItemContent>
            <ItemActions>
                <Badge Variant="BadgeVariant.Default">@L.T("新", "New")</Badge>
            </ItemActions>
            <ItemFooter Class="mt-3">
                <div class="flex gap-2">
                    <Button Variant="ButtonVariant.Default" Size="ButtonSize.Small">@L.T("下载 PDF", "Download PDF")</Button>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small">@L.T("分享", "Share")</Button>
                </div>
                <span class="text-xs text-muted-foreground">@L.T("今日生成", "Generated today")</span>
            </ItemFooter>
        </Item>
        <CodeBlock Source="Components/Item/complex-layout.txt" />
    </div>

    @* Accessibility *@
    <AccessibilityList>
        <AriaAttributes>
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    <code>ItemGroup</code> 会以 <code>role="list"</code> 渲染，用于列表项的语义分组。
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    <code>ItemGroup</code> renders with <code>role="list"</code> for semantic grouping of items.
                </AccessibilityItem>
                        </text>
}
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    每个子组件都带有 <code>data-slot</code> 属性，便于一致地识别。
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    Uses <code>data-slot</code> attributes on each sub-component for consistent identification.
                </AccessibilityItem>
                        </text>
}
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    使用 <code>AsChild="a"</code> 时，列表项会渲染为原生 a 元素，并具备键盘支持。
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    When using <code>AsChild="a"</code>, the item renders as a native anchor element with keyboard support.
                </AccessibilityItem>
                        </text>
}
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    使用 <code>AsChild="button"</code> 时，列表项会渲染为带 <code>type="button"</code> 的原生 button 元素。
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    When using <code>AsChild="button"</code>, the item renders as a native button element with <code>type="button"</code>.
                </AccessibilityItem>
                        </text>
}
            <AccessibilityItem>
                @L.T("可交互的列表项（链接或按钮）带有悬停状态过渡，提供视觉反馈。", "Interactive items (links or buttons) include hover state transitions for visual feedback.")
            </AccessibilityItem>
        </AriaAttributes>
    </AccessibilityList>

    @* API Reference *@
    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件属性与参数。", "Component properties and parameters.")</p>
        </div>
        <div class="space-y-4">
            <ApiReference ComponentName="Item">
                <ApiParameter Name="Variant" Type="ItemVariant" Default="Default">
                    @L.T("视觉样式变体。可选值：Default、Outline、Muted。", "The visual style variant. Options: Default, Outline, Muted.")
                </ApiParameter>
                <ApiParameter Name="Size" Type="ItemSize" Default="Default">
                    @L.T("列表项的尺寸。可选值：Default、Sm。", "The size of the item. Options: Default, Sm.")
                </ApiParameter>
                <ApiParameter Name="AsChild" Type="string?">
                    @L.T("要渲染成的元素类型（例如 \"a\"、\"button\"）。设置后，组件会渲染为该元素而不是 div。", "The element type to render as (e.g., \"a\", \"button\"). When set, the component renders as that element instead of a div.")
                </ApiParameter>
                <ApiParameter Name="Href" Type="string?">
                    @L.T("渲染为 a 元素（AsChild=\"a\"）时的 href 属性。", "The href attribute when rendering as an anchor (AsChild=\"a\").")
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?">
                    @L.T("应用到列表项元素上的额外 CSS 类。", "Additional CSS classes to apply to the item element.")
                </ApiParameter>
                <ApiParameter Name="ChildContent" Type="RenderFragment?">
                    @L.T("在列表项内部渲染的内容。", "The content to be rendered inside the item.")
                </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        应用到根 <code>&lt;div&gt;</code> 元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        Additional HTML attributes applied to the root <code>&lt;div&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                    </ApiParameter>
                                </text>
}
            </ApiReference>
            <ApiReference ComponentName="ItemGroup">
                <ApiParameter Name="Class" Type="string?">
                    @L.T("应用到分组容器上的额外 CSS 类。", "Additional CSS classes to apply to the group container.")
                </ApiParameter>
                <ApiParameter Name="ChildContent" Type="RenderFragment?">
                    @L.T("在分组容器内部渲染的内容。", "The content to be rendered inside the group.")
                </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        应用到根 <code>&lt;div&gt;</code> 元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        Additional HTML attributes applied to the root <code>&lt;div&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                    </ApiParameter>
                                </text>
}
            </ApiReference>
            <ApiReference ComponentName="ItemContent">
                <ApiParameter Name="Class" Type="string?">
                    @L.T("应用到内容容器上的额外 CSS 类。", "Additional CSS classes to apply to the content container.")
                </ApiParameter>
                <ApiParameter Name="ChildContent" Type="RenderFragment?">
                    @L.T("在容器内部渲染的内容。", "The content to be rendered inside the container.")
                </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        应用到根 <code>&lt;div&gt;</code> 元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        Additional HTML attributes applied to the root <code>&lt;div&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                    </ApiParameter>
                                </text>
}
            </ApiReference>
            <ApiReference ComponentName="ItemMedia">
                <ApiParameter Name="Variant" Type="ItemMediaVariant" Default="Default">
                    @L.T("媒体区域的视觉样式变体。可选值：Default、Icon、Image。", "The visual style variant of the media. Options: Default, Icon, Image.")
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?">
                    @L.T("应用到媒体容器上的额外 CSS 类。", "Additional CSS classes to apply to the media container.")
                </ApiParameter>
                <ApiParameter Name="ChildContent" Type="RenderFragment?">
                    @L.T("在媒体容器内部渲染的内容。", "The content to be rendered inside the media container.")
                </ApiParameter>
                @if (L.IsChinese)
                {
