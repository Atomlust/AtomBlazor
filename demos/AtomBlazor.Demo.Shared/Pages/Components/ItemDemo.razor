            <div class="space-y-2">
                <h3 class="text-lg font-medium">@L.T("Outline 变体", "Outline Variant")</h3>
                <Item Variant="ItemVariant.Outline">
                    <ItemContent>
                        <ItemTitle>@L.T("Outline 列表项", "Outline Item")</ItemTitle>
