                </ApiParameter>
                <ApiParameter Name="ErrorText" Type="string?" Default="null">
                    @L.T("手动指定的错误文本。字段无效且设置了该值时，用于替换自动生成的提示。", "Manual error text override. When the field is invalid and this is set, replaces auto-generated messages.")
                </ApiParameter>
                <ApiParameter Name="Orientation" Type="FieldOrientation" Default="Vertical">
