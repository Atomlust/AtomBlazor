                </ApiParameter>
                <ApiParameter Name="Value" Type="TValue?" Default="null">
                    @L.T("当前的强类型值。使用 @bind-Value 进行双向绑定。", "The current typed value. Use @bind-Value for two-way binding.")
                </ApiParameter>
                <ApiParameter Name="ValueChanged" Type="EventCallback&lt;TValue?&gt;">
                    @L.T("强类型值发生变化时调用的回调。", "Callback invoked when the typed value changes.")
                </ApiParameter>
                <ApiParameter Name="Type" Type="InputType" Default="Text">
                    @L.T("输入框的类型（Text、Email、Password、Date 等）。", "The type of input (Text, Email, Password, Date, etc.).")
                </ApiParameter>
                <ApiParameter Name="Placeholder" Type="string?" Default="null">
                    @L.T("输入框为空时显示的占位文本。", "Placeholder text displayed when the input is empty.")
                </ApiParameter>
                <ApiParameter Name="Disabled" Type="bool" Default="false">
                    @L.T("输入框是否被禁用。", "Whether the input is disabled.")
                </ApiParameter>
                <ApiParameter Name="Required" Type="bool" Default="false">
                    @L.T("输入框是否为必填（会设置 HTML 的 required 属性）。", "Whether the input is required (sets the HTML required attribute).")
                </ApiParameter>
                <ApiParameter Name="Validation" Type="Func&lt;TValue, bool&gt;?" Default="null">
                    @L.T("解析之后的校验函数。值有效时返回 true。", "Post-parse validation function. Returns true if the value is valid.")
                </ApiParameter>
                <ApiParameter Name="ValidationPattern" Type="string?" Default="null">
