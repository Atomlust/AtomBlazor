@page "/components/accordion"

<PageTitle>@L.T("Accordion 手风琴 - Atom BlazorUI", "Accordion Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("Accordion 手风琴", "Accordion Component")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("垂直堆叠的一组可交互标题，每个标题展开后显示一块内容。", "A vertically stacked set of interactive headings that each reveal a section of content.")
            </p>
        </div>
    </div>

    <div class="space-y-6">
        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("默认样式", "Default")</h2>
                <p class="text-muted-foreground">
                    @L.T("一个带 shadcn 样式的基础手风琴。", "A basic accordion with shadcn styling.")
                </p>
            </div>

        <Accordion Type="AccordionType.Single" Collapsible="true" Class="w-full">
            <AtomBlazor.AccordionItem Value="item-1">
                <AtomBlazor.AccordionTrigger>@L.T("可以自定义吗？", "Is it customizable?")</AtomBlazor.AccordionTrigger>
                <AtomBlazor.AccordionContent>
                    @L.T("是的。它内置了 ARIA 属性与键盘支持。", "Yes. It includes ARIA attributes and keyboard support.")
                </AtomBlazor.AccordionContent>
            </AtomBlazor.AccordionItem>

            <AtomBlazor.AccordionItem Value="item-2">
                <AtomBlazor.AccordionTrigger>@L.T("自带样式吗？", "Is it styled?")</AtomBlazor.AccordionTrigger>
                <AtomBlazor.AccordionContent>
                    @L.T("是的。它自带默认样式，与其他组件的观感保持一致。", "Yes. It comes with default styles that matches the other components' aesthetic.")
                </AtomBlazor.AccordionContent>
            </AtomBlazor.AccordionItem>

            <AtomBlazor.AccordionItem Value="item-3">
                <AtomBlazor.AccordionTrigger>@L.T("带动画吗？", "Is it animated?")</AtomBlazor.AccordionTrigger>
                <AtomBlazor.AccordionContent>
                    @L.T("是的。它默认带动画，你也可以按需关闭。", "Yes. It's animated by default, but you can disable it if you prefer.")
                </AtomBlazor.AccordionContent>
            </AtomBlazor.AccordionItem>
        </Accordion>

        <CodeBlock Source="Components/Accordion/default.txt" />
        </section>

        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("常见问题示例", "FAQ Example")</h2>
                <p class="text-muted-foreground">
                    @L.T("手风琴最常见的用法。", "Common use case for accordions.")
                </p>
            </div>

        <Accordion Type="AccordionType.Single" Collapsible="true" Class="w-full">
            <AtomBlazor.AccordionItem Value="faq-1">
                <AtomBlazor.AccordionTrigger>@L.T("你们支持哪些付款方式？", "What payment methods do you accept?")</AtomBlazor.AccordionTrigger>
                <AtomBlazor.AccordionContent>
                    @L.T("我们支持所有主流信用卡（Visa、MasterCard、American Express）、PayPal，以及面向企业客户的银行转账。", "We accept all major credit cards (Visa, MasterCard, American Express), PayPal, and bank transfers for enterprise customers.")
                </AtomBlazor.AccordionContent>
            </AtomBlazor.AccordionItem>

            <AtomBlazor.AccordionItem Value="faq-2">
                <AtomBlazor.AccordionTrigger>@L.T("配送需要多长时间？", "How long does shipping take?")</AtomBlazor.AccordionTrigger>
                <AtomBlazor.AccordionContent>
                    @L.T("标准配送通常需要 5-7 个工作日，另外也提供 2-3 天送达的加急选项。", "Standard shipping typically takes 5-7 business days. Express shipping options are available for 2-3 day delivery.")
                </AtomBlazor.AccordionContent>
            </AtomBlazor.AccordionItem>

            <AtomBlazor.AccordionItem Value="faq-3">
                <AtomBlazor.AccordionTrigger>@L.T("你们的退货政策是什么？", "What is your return policy?")</AtomBlazor.AccordionTrigger>
                <AtomBlazor.AccordionContent>
                    @L.T("我们提供 30 天退款保证。退货时商品须保持原状，并附上全部包装与配件。", "We offer a 30-day money-back guarantee. Items must be returned in original condition with all packaging and accessories.")
                </AtomBlazor.AccordionContent>
            </AtomBlazor.AccordionItem>

            <AtomBlazor.AccordionItem Value="faq-4">
                <AtomBlazor.AccordionTrigger>@L.T("你们提供技术支持吗？", "Do you offer technical support?")</AtomBlazor.AccordionTrigger>
                <AtomBlazor.AccordionContent>
                    @L.T("是的！我们提供 7×24 小时的邮件与在线技术支持；电话支持时间为周一至周五 9:00-17:00（美东时间）。", "Yes! We provide 24/7 technical support via email and live chat. Phone support is available Monday-Friday, 9AM-5PM EST.")
                </AtomBlazor.AccordionContent>
            </AtomBlazor.AccordionItem>
        </Accordion>

        <CodeBlock Source="Components/Accordion/faq.txt" />
        </section>

        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("同时展开多项", "Multiple Open Items")</h2>
                <p class="text-muted-foreground">
                    @L.T("允许多个条目同时处于展开状态。", "Allow multiple items to be open simultaneously.")
                </p>
            </div>

        <Accordion Type="AccordionType.Multiple" Class="w-full">
            <AtomBlazor.AccordionItem Value="features-1">
                <AtomBlazor.AccordionTrigger>@L.T("性能", "Performance")</AtomBlazor.AccordionTrigger>
                <AtomBlazor.AccordionContent>
                    <p class="mb-2">@L.T("算法经过优化，渲染速度极快。", "Blazing fast rendering with optimized algorithms.")</p>
                    <ul class="list-disc list-inside space-y-1">
                        <li>@L.T("重复渲染极少", "Minimal re-renders")</li>
                        <li>@L.T("支持虚拟滚动", "Virtual scrolling support")</li>
                        <li>@L.T("支持懒加载", "Lazy loading capabilities")</li>
                    </ul>
                </AtomBlazor.AccordionContent>
            </AtomBlazor.AccordionItem>

            <AtomBlazor.AccordionItem Value="features-2">
                <AtomBlazor.AccordionTrigger>@L.T("可定制性", "Customization")</AtomBlazor.AccordionTrigger>
                <AtomBlazor.AccordionContent>
                    <p class="mb-2">@L.T("完全可定制，贴合你的品牌。", "Fully customizable to match your brand.")</p>
                    <ul class="list-disc list-inside space-y-1">
                        <li>@L.T("主题系统", "Theme system")</li>
                        <li>@L.T("自定义样式", "Custom styling")</li>
                        <li>@L.T("组件组合", "Component composition")</li>
                    </ul>
                </AtomBlazor.AccordionContent>
            </AtomBlazor.AccordionItem>

            <AtomBlazor.AccordionItem Value="features-3">
                <AtomBlazor.AccordionTrigger>@L.T("无障碍", "Accessibility")</AtomBlazor.AccordionTrigger>
                <AtomBlazor.AccordionContent>
                    <p class="mb-2">@L.T("以无障碍为设计前提。", "Built with accessibility in mind.")</p>
                    <ul class="list-disc list-inside space-y-1">
                        <li>@L.T("内置 ARIA 属性（aria-expanded、aria-controls）", "Includes ARIA attributes (aria-expanded, aria-controls)")</li>
                        <li>@L.T("语义化的 HTML 结构", "Semantic HTML structure")</li>
                        <li>@L.T("支持键盘交互", "Keyboard interaction support")</li>
                    </ul>
                </AtomBlazor.AccordionContent>
            </AtomBlazor.AccordionItem>
        </Accordion>

        <CodeBlock Source="Components/Accordion/multiple.txt" />
        </section>

        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("包含富内容", "With Rich Content")</h2>
                <p class="text-muted-foreground">
                    @L.T("手风琴条目可以容纳任意内容。", "Accordion items can contain any content.")
                </p>
            </div>

        <Accordion Type="AccordionType.Single" Collapsible="true" Class="w-full">
            <AtomBlazor.AccordionItem Value="rich-1">
                <AtomBlazor.AccordionTrigger>@L.T("第一步：安装", "Step 1: Installation")</AtomBlazor.AccordionTrigger>
                <AtomBlazor.AccordionContent>
                    <div class="space-y-2">
                        <p>@L.T("用你惯用的包管理器安装这个包：", "Install the package using your preferred package manager:")</p>
                        <div class="rounded-md bg-muted p-4">
                            <code class="text-sm">dotnet add package AtomBlazor</code>
                        </div>
                    </div>
                </AtomBlazor.AccordionContent>
            </AtomBlazor.AccordionItem>

            <AtomBlazor.AccordionItem Value="rich-2">
                <AtomBlazor.AccordionTrigger>@L.T("第二步：配置", "Step 2: Configuration")</AtomBlazor.AccordionTrigger>
                <AtomBlazor.AccordionContent>
                    <div class="space-y-2">
                        <p>@L.T("在 Program.cs 里注册服务：", "Add the services to your Program.cs:")</p>
                        <div class="rounded-md bg-muted p-4">
                            <code class="text-sm">
                                builder.Services.AddAtomBlazorComponents();
                            </code>
                        </div>
                    </div>
                </AtomBlazor.AccordionContent>
            </AtomBlazor.AccordionItem>

            <AtomBlazor.AccordionItem Value="rich-3">
                <AtomBlazor.AccordionTrigger>@L.T("第三步：使用", "Step 3: Usage")</AtomBlazor.AccordionTrigger>
                <AtomBlazor.AccordionContent>
                    <div class="space-y-2">
                        <p>@L.T("开始在页面里使用组件：", "Start using components in your pages:")</p>
                        <div class="rounded-md bg-muted p-4">
                            <code class="text-sm">
                                &lt;Button&gt;Click me&lt;/Button&gt;
                            </code>
                        </div>
                    </div>
                </AtomBlazor.AccordionContent>
            </AtomBlazor.AccordionItem>
        </Accordion>

        <CodeBlock Source="Components/Accordion/rich-content.txt" />
        </section>

        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("自定义图标", "Custom Icon")</h2>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-muted-foreground">
                        用任意图标组件（<code>&lt;LucideIcon&gt;</code>、<code>&lt;FontAwesomeIcon&gt;</code>、
                        <code>&lt;FeatherIcon&gt;</code>、<code>&lt;HeroIcon&gt;</code>）或临时写好的 SVG 替换默认的箭头图标。
                        图标会收到一个 <code>bool</code> 上下文，即展开状态，可用于做动画。
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-muted-foreground">
                        Replace the default chevron with any icon component
                        (<code>&lt;LucideIcon&gt;</code>, <code>&lt;FontAwesomeIcon&gt;</code>,
                        <code>&lt;FeatherIcon&gt;</code>, <code>&lt;HeroIcon&gt;</code>) or ad-hoc SVG.
                        The icon receives a <code>bool</code> context with the open state for animation.
                    </p>
                                </text>
}
            </div>

        <Accordion Type="AccordionType.Single" Collapsible="true" Class="w-full">
            <AtomBlazor.AccordionItem Value="icon-1">
                <AtomBlazor.AccordionTrigger>
                    <ChildContent>@L.T("怎样使用 Lucide 图标？", "How do I use a Lucide icon?")</ChildContent>
                    <Icon Context="isOpen">
                        <LucideIcon Name="plus"
                                    Size="16"
                                    Class="@($"shrink-0 transition-transform duration-200 {(isOpen ? "rotate-45" : "")}")" />
                    </Icon>
                </AtomBlazor.AccordionTrigger>
                @if (L.IsChinese)
                {
                                <text>
                                    <AtomBlazor.AccordionContent>
                        把任意图标组件传给 <code>Icon</code> 参数即可。上下文参数会把展开状态暴露给你，
                        方便据此做动画。
                    </AtomBlazor.AccordionContent>
                                </text>
}
                else
                {
                                <text>
                                    <AtomBlazor.AccordionContent>
                        Pass any icon component to the <code>Icon</code> parameter. The context
                        parameter exposes the open state so you can animate it.
                    </AtomBlazor.AccordionContent>
                                </text>
}
            </AtomBlazor.AccordionItem>

            <AtomBlazor.AccordionItem Value="icon-2">
                <AtomBlazor.AccordionTrigger>
                    <ChildContent>@L.T("可以用临时写的 SVG 吗？", "Can I use ad-hoc SVG?")</ChildContent>
                    <Icon Context="isOpen">
                        <svg class="@($"h-4 w-4 shrink-0 transition-transform duration-200 {(isOpen ? "rotate-45" : "")}")"
                             xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 5v14M5 12h14" />
                        </svg>
                    </Icon>
                </AtomBlazor.AccordionTrigger>
                @if (L.IsChinese)
                {
                                <text>
                                    <AtomBlazor.AccordionContent>
                        可以。<code>Icon</code> 参数接受任意标记，包括原生 SVG。
                    </AtomBlazor.AccordionContent>
                                </text>
}
                else
                {
                                <text>
                                    <AtomBlazor.AccordionContent>
                        Yes. The <code>Icon</code> parameter accepts any markup, including raw SVG.
                    </AtomBlazor.AccordionContent>
                                </text>
}
            </AtomBlazor.AccordionItem>
        </Accordion>

        <CodeBlock Source="Components/Accordion/custom-icon.txt" />
        </section>

    <!-- Accessibility Notes -->
    <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>
                @if (L.IsChinese)
                {
                                <text>
                                    <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-expanded</code> 设在触发按钮上，用来标明它是展开还是收起
                                </text>
}
                else
                {
                                <text>
                                    <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-expanded</code> on trigger buttons indicates open/closed state
                                </text>
}
            </AccessibilityItem>
            <AccessibilityItem>
                @if (L.IsChinese)
                {
                                <text>
                                    <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-controls</code> 设在触发器上，指向与之关联的内容面板
                                </text>
}
                else
                {
                                <text>
                                    <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-controls</code> on trigger references the associated content panel
                                </text>
}
            </AccessibilityItem>
            <AccessibilityItem>
                @if (L.IsChinese)
                {
                                <text>
                                    内容面板使用 <code class="text-xs bg-muted px-1 py-0.5 rounded">role="region"</code>，并以 <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-labelledby</code> 指向对应的触发器
                                </text>
}
                else
                {
                                <text>
                                    Content panels use <code class="text-xs bg-muted px-1 py-0.5 rounded">role="region"</code> with <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-labelledby</code> referencing the trigger
                                </text>
}
            </AccessibilityItem>
            <AccessibilityItem>
                @if (L.IsChinese)
                {
                                <text>
                                    触发按钮被包裹在标题元素中（默认是 <code class="text-xs bg-muted px-1 py-0.5 rounded">h3</code>），以此保持文档结构
                                </text>
}
                else
                {
                                <text>
                                    Trigger buttons are wrapped in heading elements (default <code class="text-xs bg-muted px-1 py-0.5 rounded">h3</code>) for document structure
                                </text>
}
            </AccessibilityItem>
            <AccessibilityItem>
                @if (L.IsChinese)
                {
                                <text>
                                    被禁用的条目会在触发按钮上带上 <code class="text-xs bg-muted px-1 py-0.5 rounded">disabled</code> 属性
                                </text>
}
                else
                {
                                <text>
                                    Disabled items have the <code class="text-xs bg-muted px-1 py-0.5 rounded">disabled</code> attribute on the trigger button
                                </text>
}
            </AccessibilityItem>
        </AriaAttributes>
        <KeyboardNavigation>
            <KeyboardShortcutItem Description="@(L.T("展开或收起当前聚焦的手风琴条目", "Toggle the focused accordion item"))">
                <Kbd>Enter</Kbd> / <Kbd>Space</Kbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("把焦点移到下一个触发器", "Move focus to the next trigger"))">
                <Kbd>ArrowDown</Kbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("把焦点移到上一个触发器", "Move focus to the previous trigger"))">
                <Kbd>ArrowUp</Kbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("把焦点移到第一个触发器", "Move focus to the first trigger"))">
                <Kbd>Home</Kbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("把焦点移到最后一个触发器", "Move focus to the last trigger"))">
                <Kbd>End</Kbd>
            </KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>

    <!-- API Reference -->
    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件属性与参数。", "Component properties and parameters.")</p>
        </div>
        <div class="space-y-4">
            <ApiReference ComponentName="Accordion">
                <ApiParameter Name="Type" Type="AccordionType" Default="AccordionType.Single">
                    @L.T("设置同一时刻只能展开一个条目（Single），还是可以展开多个条目（Multiple）。", "Whether only one item can be open at a time (Single) or multiple items (Multiple).")
                </ApiParameter>
                <ApiParameter Name="Value" Type="HashSet&lt;string&gt;?" Default="null">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            受控模式下由它决定哪些条目处于展开状态。支持与 <code>@@bind-Value</code> 双向绑定。
                                        </text>
}
                    else
                    {
                                        <text>
                                            Controls which items are open (controlled mode). Supports two-way binding with <code>@@bind-Value</code>.
                                        </text>
}
                </ApiParameter>
                <ApiParameter Name="DefaultValue" Type="HashSet&lt;string&gt;?" Default="null">
                    @L.T("非受控模式下默认展开的条目。", "Default open items in uncontrolled mode.")
                </ApiParameter>
                <ApiParameter Name="Collapsible" Type="bool" Default="false">
                    @L.T("Single 模式下能否把所有条目都收起。为 false 时，始终有一个条目保持展开。", "Whether all items can be collapsed in Single mode. When false, one item always remains open.")
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            应用到组件根元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                                        </text>
}
                    else
                    {
                                        <text>
                                            Additional HTML attributes applied to the component's root element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                                        </text>
}
                </ApiParameter>
            </ApiReference>

            <ApiReference ComponentName="AccordionItem">
                <ApiParameter Name="Value" Type="string" Default="string.Empty">
                    @L.T("该手风琴条目的唯一标识，必填。", "Unique identifier for this accordion item. Required.")
                </ApiParameter>
                <ApiParameter Name="Disabled" Type="bool" Default="false">
                    @L.T("该条目是否被禁用。", "Whether this item is disabled.")
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            应用到组件根元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                                        </text>
}
                    else
                    {
                                        <text>
                                            Additional HTML attributes applied to the component's root element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                                        </text>
}
                </ApiParameter>
            </ApiReference>

            <ApiReference ComponentName="AccordionTrigger">
                <ApiParameter Name="As" Type="string" Default="&quot;h3&quot;">
                    @L.T("用来包裹触发按钮的 HTML 标题元素标签。", "HTML heading element tag to wrap the trigger button.")
                </ApiParameter>
                <ApiParameter Name="Icon" Type="RenderFragment&lt;bool&gt;?" Default="null">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            用来替代默认箭头的自定义图标。接受任意图标组件或临时写好的 SVG。<code>bool</code> 上下文即展开状态。
                    未设置时使用默认那个会旋转的箭头。
                                        </text>
}
                    else
                    {
                                        <text>
                                            Custom icon rendered in place of the default chevron. Accepts any icon
                    component or ad-hoc SVG. The <code>bool</code> context is the open state.
                    When not set, the default rotating chevron is used.
                                        </text>
}
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            应用到组件根元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                                        </text>
}
                    else
                    {
                                        <text>
                                            Additional HTML attributes applied to the component's root element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                                        </text>
}
                </ApiParameter>
            </ApiReference>

            <ApiReference ComponentName="AccordionContent">
                <ApiParameter Name="ForceMount" Type="bool" Default="true">
                    @L.T("收起时是否把内容保留在 DOM 里。保留才能做 CSS 动画。", "Whether to keep content in the DOM when collapsed. Enables CSS animations.")
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            应用到组件根元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                                        </text>
}
                    else
                    {
                                        <text>
                                            Additional HTML attributes applied to the component's root element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                                        </text>
}
