@page "/components/dataview"
@using AtomBlazor.Demo.Services
@using AtomBlazor.Primitives.DataView
@inject MockDataService MockDataService

<PageTitle>@L.T("数据视图组件 - Atom BlazorUI", "Data View Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-7xl">
    <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">@L.T("数据视图组件", "Data View Component")</h1>
        <p class="text-xl text-muted-foreground">
            @L.T("灵活的数据视图组件，支持列表与网格布局、排序、筛选与分页，并可选用无限滚动。", "A flexible data view component with list and grid layouts, sorting, filtering, pagination, and optional infinite scroll.")
        </p>
    </div>

    <!-- ── Employee Directory – List only ─────────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("员工目录（列表）", "Employee Directory (List)")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    只提供 <code class="bg-muted px-1 py-0.5 rounded">ListTemplate</code> 即可把视图锁定为列表模式。
                    只设置一个模板时，布局切换按钮会被隐藏。请在
                    <code class="bg-muted px-1 py-0.5 rounded">Fields</code> 内注册
                    <code class="bg-muted px-1 py-0.5 rounded">DataViewColumn</code> 组件以支持排序与筛选。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Provide only <code class="bg-muted px-1 py-0.5 rounded">ListTemplate</code> to lock the view
                    into list mode. The layout-toggle buttons are hidden when only one template is set.
                    Register <code class="bg-muted px-1 py-0.5 rounded">DataViewColumn</code> components
                    inside <code class="bg-muted px-1 py-0.5 rounded">Fields</code> for sort and filter support.
                </p>
                        </text>
}
        </div>
        <DataView TItem="Person" Data="@people" InitialPageSize="5">
            <ListTemplate Context="person">
                <Card Class="flex items-center gap-4 p-4 shadow-none hover:bg-accent/50 transition-colors">
                    <Avatar>
                        <AvatarFallback>@GetInitials(person.Name)</AvatarFallback>
                    </Avatar>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-semibold truncate">@person.Name</p>
                        <TypographyMuted Class="truncate">@person.Email</TypographyMuted>
                        <TypographyMuted Class="text-xs">@person.Department · @person.Role</TypographyMuted>
                    </div>
                    <div class="flex flex-col items-end gap-1 shrink-0">
                        <Badge Variant="@(person.Status == "Active" ? BadgeVariant.Default : BadgeVariant.Outline)">
                            @person.Status
                        </Badge>
                        <TypographyMuted Class="text-xs">@person.Salary.ToString("C0")</TypographyMuted>
                    </div>
                </Card>
            </ListTemplate>
            <Fields>
                <DataViewColumn TItem="Person" TValue="string" Property="@(p => p.Name)"       Header="@(L.T("姓名", "Name"))"       Sortable Filterable />
                <DataViewColumn TItem="Person" TValue="string" Property="@(p => p.Email)"      Header="@(L.T("邮箱", "Email"))"      Filterable />
                <DataViewColumn TItem="Person" TValue="string" Property="@(p => p.Department)" Header="@(L.T("部门", "Department"))" Sortable Filterable />
                <DataViewColumn TItem="Person" TValue="string" Property="@(p => p.Role)"       Header="@(L.T("职位", "Role"))"       Sortable Filterable />
                <DataViewColumn TItem="Person" TValue="string" Property="@(p => p.Status)"     Header="@(L.T("状态", "Status"))"     Sortable />
                <DataViewColumn TItem="Person" TValue="int"    Property="@(p => p.Salary)"     Header="@(L.T("薪资", "Salary"))"     Sortable />
            </Fields>
        </DataView>
        <CodeBlock Source="Components/DataView/basic.txt" />
    </div>

    <!-- ── Product Catalog – both templates, layout toggle enabled ────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("商品目录（列表 + 网格切换）", "Product Catalog (List + Grid Toggle)")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    同时提供 <code class="bg-muted px-1 py-0.5 rounded">ListTemplate</code> 与
                    <code class="bg-muted px-1 py-0.5 rounded">GridTemplate</code> 即可启用工具栏上的布局切换按钮。
                    两个模板可以各自设计——列表模板是一行紧凑的横向条目，网格模板则是带图片的更丰富的卡片。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Provide both <code class="bg-muted px-1 py-0.5 rounded">ListTemplate</code> and
                    <code class="bg-muted px-1 py-0.5 rounded">GridTemplate</code> to enable the toolbar
                    layout-toggle buttons. Each template can be designed independently — the list template
                    is a compact horizontal row and the grid template is a richer card with an image.
                </p>
                        </text>
}
        </div>
        <DataView TItem="Product" Data="@products" InitialPageSize="12"
                    PageSizes="@(new[] { 6, 12, 24, 48 })">
            <ListTemplate Context="product">
                <Card Class="flex items-center gap-4 p-3 shadow-none hover:bg-accent/50 transition-colors">
                    <div class="size-16 shrink-0 rounded-md overflow-hidden bg-muted">
                        <img src="@product.ImageUrl" alt="@product.Name"
                             class="object-cover w-full h-full" loading="lazy" />
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2">
                            <p class="text-sm font-semibold truncate">@product.Name</p>
                            <Badge Variant="BadgeVariant.Outline" Class="shrink-0 text-xs">@product.Category</Badge>
                        </div>
                        <Rating Value="@product.Rating" ReadOnly="true" Size="RatingSize.Small" />
                    </div>
                    <div class="flex flex-col items-end gap-2 shrink-0">
                        <span class="text-base font-bold">$@product.Price.ToString("F2")</span>
                        @if (product.Stock == 0)
                        {
                            <Badge Variant="BadgeVariant.Destructive">@L.T("缺货", "Out of Stock")</Badge>
                        }
                        else if (product.Stock <= 5)
                        {
                            <Badge Variant="BadgeVariant.Secondary">@L.T("库存紧张", "Low stock")</Badge>
                        }
                        else
                        {
                            <Button Size="ButtonSize.Small">@L.T("加入购物车", "Add to Cart")</Button>
                        }
                    </div>
                </Card>
            </ListTemplate>
            <GridTemplate Context="product">
                <Card Class="overflow-hidden flex flex-col hover:shadow-md transition-shadow">
                    <div class="relative aspect-square overflow-hidden bg-muted">
                        <img src="@product.ImageUrl" alt="@product.Name"
                             class="object-cover w-full h-full transition-transform hover:scale-105 duration-300"
                             loading="lazy" />
                        @if (product.Stock == 0)
                        {
                            <div class="absolute inset-0 bg-background/70 flex items-center justify-center">
                                <TypographyMuted>@L.T("缺货", "Out of Stock")</TypographyMuted>
                            </div>
                        }
                        else if (product.Stock <= 5)
                        {
                            <div class="absolute top-2 right-2">
                                <Badge Variant="BadgeVariant.Destructive">@L.T("库存紧张", "Low stock")</Badge>
                            </div>
                        }
                    </div>
                    <CardHeader>
                        <div class="flex items-start justify-between gap-2">
                            <CardTitle Class="text-base line-clamp-2 leading-snug">@product.Name</CardTitle>
                            <Badge Variant="BadgeVariant.Outline" Class="shrink-0 text-xs mt-0.5">@product.Category</Badge>
                        </div>
                        <CardDescription Class="line-clamp-2">@product.Description</CardDescription>
                    </CardHeader>
                    <CardContent>
                        <Rating Value="@product.Rating" ReadOnly="true" Size="RatingSize.Small" />
                    </CardContent>
                    <CardFooter Class="justify-between">
                        <span class="text-base font-bold">$@product.Price.ToString("F2")</span>
                        <Button Size="ButtonSize.Small"
                                  Variant="@(product.Stock > 0 ? ButtonVariant.Default : ButtonVariant.Outline)"
                                  Disabled="@(product.Stock == 0)">
                            @(product.Stock > 0 ? L.T("加入购物车", "Add to Cart") : L.T("到货通知我", "Notify Me"))
                        </Button>
                    </CardFooter>
                </Card>
            </GridTemplate>
            <Fields>
                <DataViewColumn TItem="Product" TValue="string"  Property="@(p => p.Name)"     Header="@(L.T("名称", "Name"))"     Sortable Filterable />
                <DataViewColumn TItem="Product" TValue="string"  Property="@(p => p.Category)" Header="@(L.T("分类", "Category"))" Sortable Filterable />
                <DataViewColumn TItem="Product" TValue="decimal" Property="@(p => p.Price)"    Header="@(L.T("价格", "Price"))"    Sortable />
                <DataViewColumn TItem="Product" TValue="double"  Property="@(p => p.Rating)"   Header="@(L.T("评分", "Rating"))"   Sortable />
            </Fields>
        </DataView>
        <CodeBlock Source="Components/DataView/product-catalog.txt" />
    </div>

    <!-- ── Custom Toolbar Actions ────────────────────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("自定义工具栏操作", "Custom Toolbar Actions")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    使用 <code class="bg-muted px-1 py-0.5 rounded">ToolbarActions</code> 渲染片段
                    在工具栏右侧加入自定义按钮或控件。可与内置的搜索、排序和布局切换控件并存。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use the <code class="bg-muted px-1 py-0.5 rounded">ToolbarActions</code> render fragment
                    to add custom buttons or controls on the right side of the toolbar. Works alongside the
                    built-in search, sort, and layout-toggle controls.
                </p>
                        </text>
}
        </div>
        <DataView TItem="Person" Data="@people" InitialPageSize="5">
            <ToolbarActions>
                <Button Variant="ButtonVariant.Default" Size="ButtonSize.Small">
                    @L.T("新增人员", "Add Person")
                </Button>
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small">
                    @L.T("导出", "Export")
                </Button>
            </ToolbarActions>
            <ListTemplate Context="person">
                <Card Class="flex items-center gap-4 p-4 shadow-none hover:bg-accent/50 transition-colors">
                    <Avatar>
                        <AvatarFallback>@GetInitials(person.Name)</AvatarFallback>
                    </Avatar>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-semibold truncate">@person.Name</p>
                        <TypographyMuted Class="truncate">@person.Email</TypographyMuted>
                        <TypographyMuted Class="text-xs">@person.Department · @person.Role</TypographyMuted>
                    </div>
                    <Badge Variant="@(person.Status == "Active" ? BadgeVariant.Default : BadgeVariant.Outline)">
                        @person.Status
                    </Badge>
                </Card>
            </ListTemplate>
            <Fields>
                <DataViewColumn TItem="Person" TValue="string" Property="@(p => p.Name)"       Header="@(L.T("姓名", "Name"))"       Sortable Filterable />
                <DataViewColumn TItem="Person" TValue="string" Property="@(p => p.Email)"      Header="@(L.T("邮箱", "Email"))"      Filterable />
                <DataViewColumn TItem="Person" TValue="string" Property="@(p => p.Department)" Header="@(L.T("部门", "Department"))" Sortable Filterable />
                <DataViewColumn TItem="Person" TValue="string" Property="@(p => p.Role)"       Header="@(L.T("职位", "Role"))"       Sortable Filterable />
            </Fields>
        </DataView>
        <CodeBlock Source="Components/DataView/toolbar-actions.txt" />
    </div>

    <!-- ── Layout Customization ───────────────────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("布局自定义（列数、Gap 与间距）", "Layout Customization (Columns, Gap &amp; Spacing)")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    <code class="bg-muted px-1 py-0.5 rounded">GridClass</code> 与
                    <code class="bg-muted px-1 py-0.5 rounded">ListClass</code> 都会借助 TailwindMerge
                    叠加在各自默认值之上——因此只需给出你想覆盖的类，其余默认值都会保留。
                    默认网格是
                    <code class="bg-muted px-1 py-0.5 rounded">grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4</code>，
                    默认列表是
                    <code class="bg-muted px-1 py-0.5 rounded">flex flex-col gap-2</code>。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Both <code class="bg-muted px-1 py-0.5 rounded">GridClass</code> and
                    <code class="bg-muted px-1 py-0.5 rounded">ListClass</code> are merged on top of their
                    respective defaults using TailwindMerge — so you only need to supply the classes you want
                    to override; the rest of the defaults are preserved. The default grid is
                    <code class="bg-muted px-1 py-0.5 rounded">grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4</code>
                    and the default list is
                    <code class="bg-muted px-1 py-0.5 rounded">flex flex-col gap-2</code>.
                </p>
                        </text>
}
        </div>

        <!-- 4-column grid -->
        <div class="space-y-2">
            @if (L.IsChinese)
            {
                        <text>
                            <p class="font-medium text-sm">4 列网格（<code class="bg-muted px-1 py-0.5 rounded">GridClass="grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3"</code>）</p>
                        </text>
}
            else
            {
                        <text>
                            <p class="font-medium text-sm">4-column grid (<code class="bg-muted px-1 py-0.5 rounded">GridClass="grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3"</code>)</p>
                        </text>
}
            <DataView TItem="Product" Data="@products" InitialPageSize="12"
                        GridClass="grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
                <GridTemplate Context="product">
                    <Card Class="overflow-hidden flex flex-col">
                        <div class="aspect-square overflow-hidden bg-muted">
                            <img src="@product.ImageUrl" alt="@product.Name"
                                 class="object-cover w-full h-full" loading="lazy" />
                        </div>
                        <CardHeader Class="p-3">
                            <CardTitle Class="text-xs line-clamp-2">@product.Name</CardTitle>
                            <CardDescription Class="text-xs line-clamp-2">@product.Description</CardDescription>
                        </CardHeader>
                        <CardFooter Class="p-3 pt-0 justify-start">
                            <span class="text-sm font-bold">$@product.Price.ToString("F2")</span>
                        </CardFooter>
                    </Card>
                </GridTemplate>
                <Fields>
                    <DataViewColumn TItem="Product" TValue="string"  Property="@(p => p.Name)"     Header="@(L.T("名称", "Name"))"     Sortable Filterable />
                    <DataViewColumn TItem="Product" TValue="string"  Property="@(p => p.Category)" Header="@(L.T("分类", "Category"))" Sortable Filterable />
                    <DataViewColumn TItem="Product" TValue="decimal" Property="@(p => p.Price)"    Header="@(L.T("价格", "Price"))"    Sortable />
                </Fields>
            </DataView>
        </div>

        <!-- 2-column grid with large gap -->
        <div class="space-y-2">
            @if (L.IsChinese)
            {
                        <text>
                            <p class="font-medium text-sm">2 列网格并加大间距（<code class="bg-muted px-1 py-0.5 rounded">GridClass="grid-cols-1 sm:grid-cols-2 gap-6"</code>）</p>
                        </text>
}
            else
            {
                        <text>
                            <p class="font-medium text-sm">2-column grid with large gap (<code class="bg-muted px-1 py-0.5 rounded">GridClass="grid-cols-1 sm:grid-cols-2 gap-6"</code>)</p>
                        </text>
}
            <DataView TItem="Product" Data="@products" InitialPageSize="6"
                        PageSizes="@(new[] { 6, 12 })"
                        GridClass="grid-cols-1 sm:grid-cols-2 gap-6">
                <GridTemplate Context="product">
                    <Card Class="overflow-hidden flex flex-col hover:shadow-md transition-shadow">
                        <div class="relative aspect-video overflow-hidden bg-muted">
                            <img src="@product.ImageUrl" alt="@product.Name"
                                 class="object-cover w-full h-full" loading="lazy" />
                        </div>
                        <CardHeader>
                            <div class="flex items-start justify-between gap-2">
                                <CardTitle Class="text-base leading-snug">@product.Name</CardTitle>
                                <Badge Variant="BadgeVariant.Outline" Class="shrink-0 text-xs mt-0.5">@product.Category</Badge>
                            </div>
                            <CardDescription Class="line-clamp-2">@product.Description</CardDescription>
                        </CardHeader>
                        <CardContent>
                            <Rating Value="@product.Rating" ReadOnly="true" Size="RatingSize.Small" />
                        </CardContent>
                        <CardFooter Class="justify-between">
                            <span class="text-base font-bold">$@product.Price.ToString("F2")</span>
                            <Button Size="ButtonSize.Small"
                                      Variant="@(product.Stock > 0 ? ButtonVariant.Default : ButtonVariant.Outline)"
                                      Disabled="@(product.Stock == 0)">
                                @(product.Stock > 0 ? L.T("加入购物车", "Add to Cart") : L.T("到货通知我", "Notify Me"))
                            </Button>
                        </CardFooter>
                    </Card>
                </GridTemplate>
                <Fields>
                    <DataViewColumn TItem="Product" TValue="string"  Property="@(p => p.Name)"     Header="@(L.T("名称", "Name"))"     Sortable Filterable />
                    <DataViewColumn TItem="Product" TValue="string"  Property="@(p => p.Category)" Header="@(L.T("分类", "Category"))" Sortable Filterable />
                    <DataViewColumn TItem="Product" TValue="decimal" Property="@(p => p.Price)"    Header="@(L.T("价格", "Price"))"    Sortable />
                </Fields>
            </DataView>
        </div>

        <!-- Compact divider list -->
        <div class="space-y-2">
            @if (L.IsChinese)
            {
                        <text>
                            <p class="font-medium text-sm">紧凑分隔线列表（<code class="bg-muted px-1 py-0.5 rounded">ListClass="gap-0 divide-y"</code>）</p>
                        </text>
}
            else
            {
                        <text>
                            <p class="font-medium text-sm">Compact divider list (<code class="bg-muted px-1 py-0.5 rounded">ListClass="gap-0 divide-y"</code>)</p>
                        </text>
}
            <DataView TItem="Person" Data="@people" InitialPageSize="6" ListClass="gap-0 divide-y">
                <ListTemplate Context="person">
                    <div class="flex items-center gap-4 px-4 py-3 hover:bg-accent/50 transition-colors">
                        <Avatar>
                            <AvatarFallback>@GetInitials(person.Name)</AvatarFallback>
                        </Avatar>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-semibold truncate">@person.Name</p>
                            <TypographyMuted Class="truncate">@person.Email</TypographyMuted>
                        </div>
                        <Badge Variant="BadgeVariant.Secondary">@person.Department</Badge>
                    </div>
                </ListTemplate>
                <Fields>
                    <DataViewColumn TItem="Person" TValue="string" Property="@(p => p.Name)"       Header="@(L.T("姓名", "Name"))"       Sortable Filterable />
                    <DataViewColumn TItem="Person" TValue="string" Property="@(p => p.Department)" Header="@(L.T("部门", "Department"))" Sortable Filterable />
                    <DataViewColumn TItem="Person" TValue="string" Property="@(p => p.Email)"      Header="@(L.T("邮箱", "Email"))"      Filterable />
                </Fields>
            </DataView>
        </div>

        <CodeBlock Source="Components/DataView/layout-customization.txt" />
    </div>

    <!-- ── Adaptive Auto-Fill Grid ───────────────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("自适应自动填充网格", "Adaptive Auto-Fill Grid")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    用 <code class="bg-muted px-1 py-0.5 rounded">GridColumnMinWidth</code> 创建随容器宽度变化的
                    流式网格。它使用 CSS
                    <code class="bg-muted px-1 py-0.5 rounded">repeat(auto-fill, minmax(value, 1fr))</code>
                    而不是固定的断点列数。缩放浏览器窗口即可看到列数的增减。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use <code class="bg-muted px-1 py-0.5 rounded">GridColumnMinWidth</code> to create a
                    fluid grid that adapts to the container width. Uses CSS
                    <code class="bg-muted px-1 py-0.5 rounded">repeat(auto-fill, minmax(value, 1fr))</code>
                    instead of fixed breakpoint columns. Resize the browser to see columns added or removed.
                </p>
                        </text>
}
        </div>

        <DataView TItem="Product" Data="@products" InitialPageSize="12"
                    PageSizes="@(new[] { 6, 12, 24 })"
                    GridColumnMinWidth="200px">
            <GridTemplate Context="product">
                <Card Class="overflow-hidden flex flex-col">
                    <div class="aspect-square overflow-hidden bg-muted">
                        <img src="@product.ImageUrl" alt="@product.Name"
                             class="object-cover w-full h-full" loading="lazy" />
                    </div>
                    <CardHeader Class="p-3">
                        <CardTitle Class="text-xs line-clamp-2">@product.Name</CardTitle>
                    </CardHeader>
                    <CardFooter Class="p-3 pt-0 justify-start">
                        <span class="text-sm font-bold">$@product.Price.ToString("F2")</span>
                    </CardFooter>
                </Card>
            </GridTemplate>
            <Fields>
                <DataViewColumn TItem="Product" TValue="string" Property="@(p => p.Name)" Header="@(L.T("名称", "Name"))" Sortable Filterable />
                <DataViewColumn TItem="Product" TValue="decimal" Property="@(p => p.Price)" Header="@(L.T("价格", "Price"))" Sortable />
            </Fields>
        </DataView>

        <CodeBlock Source="Components/DataView/adaptive-grid.txt" />
    </div>

    <!-- ── Infinite Scroll – Product Grid (Auto, GridTemplate only) ───────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("无限滚动 – 商品网格（自动）", "Infinite Scroll – Product Grid (Auto)")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    同时设置 <code class="bg-muted px-1 py-0.5 rounded">EnableInfiniteScroll</code> 与
                    <code class="bg-muted px-1 py-0.5 rounded">ScrollHeight</code>，就能在用户滚动时逐步加载更多条目。
                    这里只提供了 <code class="bg-muted px-1 py-0.5 rounded">GridTemplate</code>，
                    因此视图锁定为网格模式且没有切换按钮。排序或筛选后会回到第一批数据。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Set <code class="bg-muted px-1 py-0.5 rounded">EnableInfiniteScroll</code> with
                    <code class="bg-muted px-1 py-0.5 rounded">ScrollHeight</code> to progressively load
                    more items as the user scrolls. Only <code class="bg-muted px-1 py-0.5 rounded">GridTemplate</code>
                    is set here, so the view locks into grid mode with no toggle. Sorting or filtering resets
                    to the first batch.
                </p>
                        </text>
}
        </div>
        <DataView TItem="Product" Data="@products"
                    EnableInfiniteScroll="true" ScrollHeight="600px" InitialPageSize="6">
            <GridTemplate Context="product">
                <Card Class="overflow-hidden flex flex-col hover:shadow-md transition-shadow">
                    <div class="relative aspect-square overflow-hidden bg-muted">
                        <img src="@product.ImageUrl" alt="@product.Name"
                             class="object-cover w-full h-full transition-transform hover:scale-105 duration-300"
                             loading="lazy" />
                        @if (product.Stock == 0)
                        {
                            <div class="absolute inset-0 bg-background/70 flex items-center justify-center">
                                <TypographyMuted>@L.T("缺货", "Out of Stock")</TypographyMuted>
                            </div>
                        }
                    </div>
                    <CardHeader>
                        <div class="flex items-start justify-between gap-2">
                            <CardTitle Class="text-base line-clamp-2 leading-snug">@product.Name</CardTitle>
                            <Badge Variant="BadgeVariant.Outline" Class="shrink-0 text-xs mt-0.5">@product.Category</Badge>
                        </div>
                        <CardDescription Class="line-clamp-2">@product.Description</CardDescription>
                    </CardHeader>
                    <CardContent>
                        <Rating Value="@product.Rating" ReadOnly="true" Size="RatingSize.Small" />
                    </CardContent>
                    <CardFooter Class="justify-between">
                        <span class="text-base font-bold">$@product.Price.ToString("F2")</span>
                        <Button Size="ButtonSize.Small"
                                  Variant="@(product.Stock > 0 ? ButtonVariant.Default : ButtonVariant.Outline)"
                                  Disabled="@(product.Stock == 0)">
                            @(product.Stock > 0 ? L.T("加入购物车", "Add to Cart") : L.T("到货通知我", "Notify Me"))
                        </Button>
                    </CardFooter>
                </Card>
            </GridTemplate>
            <Fields>
                <DataViewColumn TItem="Product" TValue="string"  Property="@(p => p.Name)"     Header="@(L.T("名称", "Name"))"     Sortable Filterable />
                <DataViewColumn TItem="Product" TValue="string"  Property="@(p => p.Category)" Header="@(L.T("分类", "Category"))" Sortable Filterable />
                <DataViewColumn TItem="Product" TValue="decimal" Property="@(p => p.Price)"    Header="@(L.T("价格", "Price"))"    Sortable />
                <DataViewColumn TItem="Product" TValue="double"  Property="@(p => p.Rating)"   Header="@(L.T("评分", "Rating"))"   Sortable />
            </Fields>
        </DataView>
        <CodeBlock Source="Components/DataView/product-infinite-scroll.txt" />
    </div>

    <!-- ── Infinite Scroll – Auto (scroll-based, ListTemplate only) ───────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("无限滚动 – 员工列表（自动）", "Infinite Scroll – Employee List (Auto)")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    这里只提供了 <code class="bg-muted px-1 py-0.5 rounded">ListTemplate</code>，因此视图锁定为列表模式。
                    为滚动容器把
                    <code class="bg-muted px-1 py-0.5 rounded">ScrollHeight</code> 设成任意合法的 CSS 高度即可——
                    由于整个容器才参与测量，flex 列表与多列网格都能正常触发检测。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Only <code class="bg-muted px-1 py-0.5 rounded">ListTemplate</code> is set, so the view
                    locks into list mode. Set
                    <code class="bg-muted px-1 py-0.5 rounded">ScrollHeight</code> to any valid CSS height for
                    the scroll container — detection works for both flex lists and multi-column grids because
                    the container is measured as a whole.
                </p>
                        </text>
}
        </div>
        <DataView TItem="Person" Data="@people" EnableInfiniteScroll="true" ScrollHeight="480px" InitialPageSize="6">
            <ListTemplate Context="person">
                <Card Class="flex items-center gap-4 p-4 shadow-none hover:bg-accent/50 transition-colors">
                    <Avatar>
                        <AvatarFallback>@GetInitials(person.Name)</AvatarFallback>
                    </Avatar>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-semibold truncate">@person.Name</p>
                        <TypographyMuted Class="truncate">@person.Email</TypographyMuted>
                        <TypographyMuted Class="text-xs">@person.Department · @person.Role</TypographyMuted>
                    </div>
                    @if (L.IsChinese)
                    {
                                        <text>
                                            <Badge Variant="BadgeVariant.Outline">@person.Age 岁</Badge>
                                        </text>
}
                    else
                    {
                                        <text>
                                            <Badge Variant="BadgeVariant.Outline">@person.Age yrs</Badge>
                                        </text>
}
                </Card>
            </ListTemplate>
            <Fields>
                <DataViewColumn TItem="Person" TValue="string" Property="@(p => p.Name)" Header="@(L.T("姓名", "Name"))" Sortable Filterable />
                <DataViewColumn TItem="Person" TValue="string" Property="@(p => p.Role)" Header="@(L.T("职位", "Role"))" Sortable Filterable />
                <DataViewColumn TItem="Person" TValue="int"    Property="@(p => p.Age)"  Header="@(L.T("年龄", "Age"))"  Sortable />
            </Fields>
        </DataView>
        <CodeBlock Source="Components/DataView/infinite-scroll.txt" />
    </div>

    <!-- ── Async Data Loading (ItemsProvider) ─────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("异步数据加载", "Async Data Loading")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    用 <code class="bg-muted px-1 py-0.5 rounded">ItemsProvider</code> 做服务端数据拉取。
                    视图会把当前的分页、排序与搜索状态传给委托，由委托返回匹配的那一页以及总条数。
                    请求进行期间会自动显示内置的加载遮罩，连续输入搜索关键字时上一次请求会被取消。
                    <code class="bg-muted px-1 py-0.5 rounded">Data</code> 与
                    <code class="bg-muted px-1 py-0.5 rounded">ItemsProvider</code> 只能二选一。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use <code class="bg-muted px-1 py-0.5 rounded">ItemsProvider</code> for server-side data fetching.
                    The view passes the current pagination, sort, and search state and the provider returns the
                    matching page plus a total count. The built-in loading overlay is shown automatically while
                    the request is in flight, and rapid search keystrokes cancel the previous request. Provide
                    either <code class="bg-muted px-1 py-0.5 rounded">Data</code> or
                    <code class="bg-muted px-1 py-0.5 rounded">ItemsProvider</code>, not both.
                </p>
                        </text>
}
        </div>
        <DataView TItem="Person" ItemsProvider="@LoadPeopleAsync" InitialPageSize="5">
            <ListTemplate Context="person">
                <Card Class="flex items-center gap-4 p-4 shadow-none hover:bg-accent/50 transition-colors">
                    <Avatar>
                        <AvatarFallback>@GetInitials(person.Name)</AvatarFallback>
                    </Avatar>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-semibold truncate">@person.Name</p>
                        <TypographyMuted Class="truncate">@person.Email</TypographyMuted>
                        <TypographyMuted Class="text-xs">@person.Department · @person.Role</TypographyMuted>
                    </div>
                    <Badge Variant="@(person.Status == "Active" ? BadgeVariant.Default : BadgeVariant.Outline)">
                        @person.Status
                    </Badge>
                </Card>
            </ListTemplate>
            <Fields>
                <DataViewColumn TItem="Person" TValue="string" Property="@(p => p.Name)"       Header="@(L.T("姓名", "Name"))"       Sortable Filterable />
                <DataViewColumn TItem="Person" TValue="string" Property="@(p => p.Email)"      Header="@(L.T("邮箱", "Email"))"      Filterable />
                <DataViewColumn TItem="Person" TValue="string" Property="@(p => p.Department)" Header="@(L.T("部门", "Department"))" Sortable Filterable />
                <DataViewColumn TItem="Person" TValue="string" Property="@(p => p.Role)"       Header="@(L.T("职位", "Role"))"       Sortable Filterable />
            </Fields>
        </DataView>
        <CodeBlock Source="Components/DataView/items-provider.txt" />
    </div>

    <!-- ── Loading State ──────────────────────────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("加载状态", "Loading State")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    设置 <code class="bg-muted px-1 py-0.5 rounded">IsLoading</code> 可在拉取数据期间显示加载指示器。
                    提供
                    <code class="bg-muted px-1 py-0.5 rounded">LoadingTemplate</code> 就能用骨架卡片或任意自定义内容替换默认指示器。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Set <code class="bg-muted px-1 py-0.5 rounded">IsLoading</code> to show a loading indicator
                    while data is being fetched. Provide
                    <code class="bg-muted px-1 py-0.5 rounded">LoadingTemplate</code> to replace the default
                    indicator with skeleton cards or any custom content.
                </p>
                        </text>
}
        </div>
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => isLoading = !isLoading)">
            @L.T("切换加载状态", "Toggle Loading")
        </Button>
        <DataView TItem="Person" Data="@people" IsLoading="@isLoading" InitialPageSize="4">
            <ListTemplate Context="person">
                <Card Class="flex items-center gap-4 p-4 shadow-none">
                    <Avatar>
                        <AvatarFallback>@GetInitials(person.Name)</AvatarFallback>
                    </Avatar>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-semibold">@person.Name</p>
                        <TypographyMuted>@person.Email</TypographyMuted>
                    </div>
                </Card>
            </ListTemplate>
            <Fields>
                <DataViewColumn TItem="Person" TValue="string" Property="@(p => p.Name)" Header="@(L.T("姓名", "Name"))" Sortable Filterable />
            </Fields>
        </DataView>
        <CodeBlock Source="Components/DataView/loading.txt" />
    </div>

    <!-- ── Empty State ────────────────────────────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("空状态", "Empty State")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    没有匹配结果时会显示默认空状态。提供
