    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件参数与渲染片段。", "Component parameters and render fragments.")</p>
        </div>
        <div class="space-y-4">
            <ApiReference ComponentName="DataView">
                <ApiParameter Name="Data" Type="IEnumerable&lt;TItem&gt;?">
                    @L.T("视图的内存数据源。与 ItemsProvider 互斥。", "In-memory data source for the view. Mutually exclusive with ItemsProvider.")
                </ApiParameter>
                <ApiParameter Name="ItemsProvider" Type="DataViewItemsProvider&lt;TItem&gt;?">
                    @L.T("用于服务端取数的异步委托。接收当前分页、排序、搜索与取消令牌，返回匹配的那一页及总条数。与 Data 互斥。", "Async delegate for server-side data fetching. Receives the current pagination, sort, search, and a cancellation token and returns the matching page plus a total count. Mutually exclusive with Data.")
                </ApiParameter>
                <ApiParameter Name="ListTemplate" Type="RenderFragment&lt;TItem&gt;?" Default="null">
                    @L.T("列表布局下渲染每个条目的模板。只设置它而不设置 GridTemplate 时，视图锁定为列表模式并隐藏布局切换按钮。", "Template used to render each item in list layout. When set without GridTemplate the view locks into list mode and the layout-toggle is hidden.")
