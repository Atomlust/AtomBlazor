                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Displays the default empty state when there are no results. Provide
                    <code class="bg-muted px-1 py-0.5 rounded">EmptyTemplate</code> to render a custom state.
                </p>
                        </text>
}
        </div>
        <DataView TItem="Person" Data="@emptyPeople" InitialPageSize="5">
            <ListTemplate Context="person">
                <Card Class="p-4 shadow-none">@person.Name</Card>
            </ListTemplate>
            <Fields>
                <DataViewColumn TItem="Person" TValue="string" Property="@(p => p.Name)" Header="@(L.T("姓名", "Name"))" Filterable />
            </Fields>
        </DataView>
        <CodeBlock Source="Components/DataView/empty.txt" />
