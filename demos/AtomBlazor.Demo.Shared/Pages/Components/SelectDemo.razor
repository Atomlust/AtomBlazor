@page "/components/select"
@using System.ComponentModel.DataAnnotations
<PageTitle>@L.T("Select 下拉选择组件 - Atom BlazorUI", "Select Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">@L.T("Select 下拉选择组件", "Select Component")</h1>
        <p class="text-xl text-muted-foreground">
            @L.T("展示一组可选项供用户挑选，由一个按钮触发。", "Displays a list of options for the user to pick from—triggered by a button.")
        </p>
        </div>
    </div>

    <div class="space-y-6">
    </div>

    <!-- Data-Binding Mode -->
    <section class="space-y-4">
        <div class="flex items-center gap-2">
            <h2 class="text-2xl font-semibold">@L.T("数据绑定模式", "Data-Binding Mode")</h2>
            <span class="inline-flex items-center rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary ring-1 ring-inset ring-primary/20">v3</span>
        </div>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                传入一组由 <code class="text-xs bg-muted px-1 py-0.5 rounded">Options</code> 承载的
                <code class="text-xs bg-muted px-1 py-0.5 rounded">SelectOption&lt;TValue&gt;</code> 键值对，
                组件会自动生成触发器、值显示与下拉内容。
                当值与标签相同时，请使用 <code class="text-xs bg-muted px-1 py-0.5 rounded">SelectOption.FromValue</code>。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                Pass an <code class="text-xs bg-muted px-1 py-0.5 rounded">Options</code> collection of
                <code class="text-xs bg-muted px-1 py-0.5 rounded">SelectOption&lt;TValue&gt;</code> pairs and
                the component auto-generates the trigger, value display, and dropdown content.
                Use <code class="text-xs bg-muted px-1 py-0.5 rounded">SelectOption.FromValue</code> when value and label are the same.
            </p>
                </text>
}

        <div class="flex items-center gap-4">
            <Select AriaLabel="@(L.T("选择一个选项", "Choose an option"))" TValue="string"
                    @bind-Value="selectedFruit"
                    Options="@fruitOptions"
                    Placeholder="@(L.T("选择一个水果", "Select a fruit"))"
                    Class="w-[280px]" />

            @if (!string.IsNullOrEmpty(selectedFruit))
            {
                <p class="text-sm">@L.T("已选择：", "Selected:") <strong>@selectedFruit</strong></p>
            }
        </div>

        <div class="flex items-center gap-4">
            <Select TValue="int?"
                    @bind-Value="selectedNumber"
                    Options="@numberOptions"
                    Placeholder="@(L.T("选择一个数字", "Select a number"))"
                    Class="w-[280px]" />

            @if (selectedNumber is not null)
            {
                <p class="text-sm">@L.T("已选择：", "Selected:") <strong>@selectedNumber</strong></p>
            }
        </div>

        <CodeBlock Source="Components/Select/data-binding.txt" />
    </section>

    <!-- Value/Label Pairs -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("值与标签配对", "Value/Label Pairs")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                当绑定值与显示文本不同（例如绑定到 ID 而显示名称）时，
                每个 <code class="text-xs bg-muted px-1 py-0.5 rounded">SelectOption</code> 将值映射到其标签。
                触发器会自动为选中的值显示对应的标签。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                When the bound value differs from the display text (e.g. binding to an ID while showing a name),
                each <code class="text-xs bg-muted px-1 py-0.5 rounded">SelectOption</code> maps a value to its label.
                The trigger automatically shows the label for the selected value.
            </p>
                </text>
}

        <div class="flex items-center gap-4">
            <Select TValue="string"
                    @bind-Value="selectedUserId"
                    Options="@userOptions"
                    Placeholder="@(L.T("选择一名团队成员", "Select a team member"))"
                    Class="w-[280px]" />

            @if (!string.IsNullOrEmpty(selectedUserId))
            {
                <p class="text-sm">@L.T("绑定值：", "Bound value:") <strong>@selectedUserId</strong></p>
            }
        </div>

        <div class="flex items-center gap-4">
            <Select TValue="Guid?"
                    @bind-Value="selectedProjectId"
                    Options="@projectOptions"
                    Placeholder="@(L.T("选择一个项目", "Select a project"))"
                    Class="w-[280px]" />

            @if (selectedProjectId is not null)
            {
                <p class="text-sm">@L.T("绑定值：", "Bound value:") <strong>@selectedProjectId</strong></p>
            }
        </div>

        <div class="flex items-center gap-4">
            <Select TValue="string"
                    @bind-Value="selectedPreselectedUserId"
                    Options="@userOptions"
                    Placeholder="@(L.T("选择一名团队成员", "Select a team member"))"
                    Class="w-[280px]" />

            @if (!string.IsNullOrEmpty(selectedPreselectedUserId))
            {
                <p class="text-sm">@L.T("绑定值：", "Bound value:") <strong>@selectedPreselectedUserId</strong></p>
            }
        </div>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-xs text-muted-foreground italic">
                上面的第三个选择框已通过 <code class="text-xs bg-muted px-1 py-0.5 rounded">selectedUserId = "u002"</code> 预选中了 “Bob Chen”。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-xs text-muted-foreground italic">
                The third select above is pre-selected to "Bob Chen" via <code class="text-xs bg-muted px-1 py-0.5 rounded">selectedUserId = "u002"</code>.
            </p>
                </text>
}

        <CodeBlock Source="Components/Select/value-label-pairs.txt" />
    </section>

    <!-- Compositional Mode (Basic) -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("组合式模式", "Compositional Mode")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("要完全控制触发器、内容与条目渲染，请直接使用 SelectTrigger、SelectContent 与 SelectItem 子组件。", "For full control over the trigger, content, and item rendering, use SelectTrigger, SelectContent, and SelectItem child components directly.")
        </p>

        <div class="flex items-center gap-4">
            <Select @bind-Value="selectedFruitComposed" TValue="string" Class="w-[280px]">
                <AtomBlazor.SelectTrigger>
                    <AtomBlazor.SelectValue Placeholder="@(L.T("选择一个水果", "Select a fruit"))" />
                </AtomBlazor.SelectTrigger>
                <AtomBlazor.SelectContent>
                    <AtomBlazor.SelectItem Value="@("apple")" Text="🍎 Apple" />
                    <AtomBlazor.SelectItem Value="@("banana")" Text="🍌 Banana" />
                    <AtomBlazor.SelectItem Value="@("blueberry")" Text="🫐 Blueberry" />
                    <AtomBlazor.SelectItem Value="@("grapes")" Text="🍇 Grapes" />
                    <AtomBlazor.SelectItem Value="@("pineapple")" Text="🍍 Pineapple" />
                </AtomBlazor.SelectContent>
            </Select>

            @if (!string.IsNullOrEmpty(selectedFruitComposed))
            {
                <p class="text-sm">@L.T("已选择：", "Selected:") <strong>@selectedFruitComposed</strong></p>
            }
        </div>

        <CodeBlock Source="Components/Select/compositional.txt" />
    </section>

    <!-- Grouped Select -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("分组选项", "Grouped Options")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("将相关条目归入带标签的分组。", "Organize related items into labeled groups.")
        </p>

        <div class="flex items-center gap-4">
            <Select @bind-Value="selectedAnimal" TValue="string" Class="w-[280px]">
                <AtomBlazor.SelectTrigger>
                    <AtomBlazor.SelectValue Placeholder="@(L.T("选择一种动物", "Select an animal"))" />
                </AtomBlazor.SelectTrigger>
                <AtomBlazor.SelectContent>
                    <SelectGroup>
                        <SelectLabel>Mammals</SelectLabel>
                        <AtomBlazor.SelectItem Value="@("cat")" Text="Cat" />
                        <AtomBlazor.SelectItem Value="@("dog")" Text="Dog" />
                        <AtomBlazor.SelectItem Value="@("elephant")" Text="Elephant" />
                    </SelectGroup>
                    <SelectGroup>
                        <SelectLabel>Birds</SelectLabel>
                        <AtomBlazor.SelectItem Value="@("eagle")" Text="Eagle" />
                        <AtomBlazor.SelectItem Value="@("parrot")" Text="Parrot" />
                        <AtomBlazor.SelectItem Value="@("penguin")" Text="Penguin" />
                    </SelectGroup>
                    <SelectGroup>
                        <SelectLabel>Reptiles</SelectLabel>
                        <AtomBlazor.SelectItem Value="@("crocodile")" Text="Crocodile" />
                        <AtomBlazor.SelectItem Value="@("snake")" Text="Snake" />
                        <AtomBlazor.SelectItem Value="@("turtle")" Text="Turtle" />
                    </SelectGroup>
                </AtomBlazor.SelectContent>
            </Select>

            @if (!string.IsNullOrEmpty(selectedAnimal))
            {
                <p class="text-sm">@L.T("已选择：", "Selected:") <strong>@selectedAnimal</strong></p>
            }
        </div>

        <CodeBlock Source="Components/Select/grouped.txt" />
    </section>

    <!-- Scrollable Long List -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("可滚动的长列表", "Scrollable Long List")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("通过自动滚动（max-h-60）处理大量选项。", "Handle many options with automatic scrolling (max-h-60).")
        </p>

        <div class="flex items-center gap-4">
            <Select @bind-Value="selectedCountry" TValue="string" Class="w-[280px]">
                <AtomBlazor.SelectTrigger>
                    <AtomBlazor.SelectValue Placeholder="@(L.T("选择一个国家", "Select a country"))" />
                </AtomBlazor.SelectTrigger>
                <AtomBlazor.SelectContent>
                    @foreach (var country in countries)
                    {
                        <AtomBlazor.SelectItem Value="@country" Text="@country" />
                    }
                </AtomBlazor.SelectContent>
            </Select>

            @if (!string.IsNullOrEmpty(selectedCountry))
            {
                <p class="text-sm">@L.T("已选择：", "Selected:") <strong>@selectedCountry</strong></p>
            }
        </div>

        <CodeBlock Source="Components/Select/scrollable.txt" />
    </section>

    <!-- Scrollable Data-Binding -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("可滚动的数据绑定", "Scrollable Data-Binding")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("数据绑定模式与组合式模式一样，可通过自动滚动处理大型集合。", "Data-binding mode handles large collections with automatic scrolling, just like the compositional mode.")
        </p>

        <div class="flex items-center gap-4">
            <Select TValue="string"
                    @bind-Value="selectedCountryDataBound"
                    Options="@countryOptions"
                    Placeholder="@(L.T("选择一个国家", "Select a country"))"
                    Class="w-[280px]" />

            @if (!string.IsNullOrEmpty(selectedCountryDataBound))
            {
                <p class="text-sm">@L.T("已选择：", "Selected:") <strong>@selectedCountryDataBound</strong></p>
            }
        </div>

        <CodeBlock Source="Components/Select/scrollable-data-binding.txt" />
    </section>

    <!-- Form Validation with EditForm -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("表单校验", "Form Validation")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                Select 与 Blazor 的 EditForm 和 EditContext 集成以进行模型校验。
                在 EditForm 内使用 <code class="text-xs bg-muted px-1 py-0.5 rounded">@@bind-Value</code>，
                校验错误会通过 <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-invalid</code> 自动应用错误样式。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                Select integrates with Blazor's EditForm and EditContext for model validation.
                Use <code class="text-xs bg-muted px-1 py-0.5 rounded">@@bind-Value</code> within an EditForm and
                validation errors will automatically apply error styling via <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-invalid</code>.
            </p>
                </text>
}

        <EditForm Model="selectFormModel" OnValidSubmit="HandleSelectFormSubmit" class="max-w-md space-y-4">
            <DataAnnotationsValidator />

            <div class="space-y-2">
                <label class="text-sm font-medium">@L.T("喜欢的水果", "Favorite Fruit")</label>
                <Select @bind-Value="selectFormModel.Fruit"
                        TValue="string"
                        Options="fruitOptions"
                        Placeholder="@(L.T("选择一个水果", "Select a fruit"))"
                        Class="w-[280px]" />
                <ValidationMessage For="@(() => selectFormModel.Fruit)" class="text-sm text-destructive" />
            </div>

            <div class="flex gap-4">
                <Button Type="ButtonType.Submit" Variant="ButtonVariant.Default">@L.T("提交", "Submit")</Button>
                <Button Type="ButtonType.Button" Variant="ButtonVariant.Outline" OnClick="ResetSelectForm">@L.T("重置", "Reset")</Button>
            </div>

            @if (!string.IsNullOrEmpty(selectFormMessage))
            {
                <div class="p-4 bg-card rounded-lg border">
                    <p class="text-sm">@selectFormMessage</p>
                </div>
            }
        </EditForm>

        <CodeBlock Source="Components/Select/form-validation.txt" />
    </section>

    <!-- Controlled Open State -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("受控的展开状态", "Controlled Open State")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                <code class="bg-muted px-1 py-0.5 rounded text-sm">@@bind-Open</code> 可从你自己的代码打开和关闭列表，
                并把用户自身的打开与关闭回传给你。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                <code class="bg-muted px-1 py-0.5 rounded text-sm">@@bind-Open</code> opens and closes the list from
                your own code, and reports the user's own opens and closes back to you.
            </p>
                </text>
}

        <div class="flex flex-col gap-2">
            <div class="flex items-center gap-3">
                <Button Variant="ButtonVariant.Outline" OnClick="@(() => _selectListOpen = !_selectListOpen)">
                    @(_selectListOpen ? L.T("关闭列表", "Close the list") : L.T("打开列表", "Open the list"))
                </Button>
                <Select TValue="string"
                        Options="@_controlledOpenFruits"
                        @bind-Value="_controlledOpenFruit"
                        @bind-Open="_selectListOpen"
                        Placeholder="@(L.T("选择一个水果…", "Select a fruit..."))"
                        Class="w-[240px]" />
            </div>
            <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
                <p class="text-sm"><span class="font-medium">@L.T("是否打开：", "Open:")</span> <span class="font-mono">@_selectListOpen</span></p>
                <p class="text-sm"><span class="font-medium">@L.T("已选择：", "Selected:")</span> <span class="font-mono">@(_controlledOpenFruit ?? L.T("（无）", "(none)"))</span></p>
            </div>
        </div>

        <CodeBlock Source="Components/Select/controlled-open.txt" />
    </section>

    <!-- Infinite Scroll -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("无限滚动", "Infinite Scroll")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                使用 <code class="bg-muted px-1 py-0.5 rounded text-sm">OnLoadMore</code> 与
                <code class="bg-muted px-1 py-0.5 rounded text-sm">IsLoading</code> 在用户滚动时分批加载条目。
                本示例包含 100 个带旗帜的国家，每次加载 20 个。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                Use <code class="bg-muted px-1 py-0.5 rounded text-sm">OnLoadMore</code> and
                <code class="bg-muted px-1 py-0.5 rounded text-sm">IsLoading</code> to load items in batches
                as the user scrolls. This example has 100 countries with flags, loading 20 at a time.
            </p>
                </text>
}

        <div class="flex flex-col gap-2">
            <Select TValue="string"
                    Options="@_selectScrollCountries"
                    @bind-Value="_selectScrollSelected"
                    OnLoadMore="@HandleSelectLoadMore"
                    IsLoading="@_selectScrollIsLoading"
                    Placeholder="@(L.T("选择一个国家…", "Select a country..."))"
                    Class="w-[320px]" />
            <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
                <p class="text-sm"><span class="font-medium">@L.T("已选择：", "Selected:")</span> <span class="font-mono">@(string.IsNullOrEmpty(_selectScrollSelected) ? L.T("（无）", "(none)") : _selectScrollSelected)</span></p>
                <p class="text-sm"><span class="font-medium">@L.T("已加载：", "Loaded:")</span> @_selectScrollCountries.Length @L.T("共", "of") @_allSelectCountries.Length</p>
            </div>
        </div>

        <CodeBlock Source="Components/Select/infinite-scroll.txt" />
    </section>

    <!-- Infinite Scroll (Compositional) -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("无限滚动（组合式）", "Infinite Scroll (Compositional)")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                使用 <code class="bg-muted px-1 py-0.5 rounded text-sm">SelectItem</code> 子元素与自定义渲染，
                在组合式模式下实现无限滚动。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                Infinite scroll with compositional mode using
                <code class="bg-muted px-1 py-0.5 rounded text-sm">SelectItem</code> children and custom rendering.
            </p>
                </text>
}

        <div class="flex flex-col gap-2">
            <Select TValue="string" @bind-Value="_selectCompScrollSelected" Class="w-[320px]">
                <AtomBlazor.SelectTrigger TValue="string">
                    <AtomBlazor.SelectValue Placeholder="@(L.T("选择一个国家…", "Select a country..."))" />
                </AtomBlazor.SelectTrigger>
                <AtomBlazor.SelectContent TValue="string" OnLoadMore="@HandleSelectCompLoadMore" IsLoading="@_selectCompScrollIsLoading">
                    @foreach (var c in _selectCompScrollVisible)
                    {
                        <AtomBlazor.SelectItem TValue="string" Value="@c.Code" Text="@($"{c.Flag} {c.Name}")" />
                    }
                </AtomBlazor.SelectContent>
            </Select>
            <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
                <p class="text-sm"><span class="font-medium">@L.T("已选择：", "Selected:")</span> <span class="font-mono">@(string.IsNullOrEmpty(_selectCompScrollSelected) ? L.T("（无）", "(none)") : _selectCompScrollSelected)</span></p>
                <p class="text-sm"><span class="font-medium">@L.T("已加载：", "Loaded:")</span> @_selectCompScrollVisible.Length @L.T("共", "of") @_allSelectCompCountries.Length</p>
            </div>
        </div>

        <CodeBlock Source="Components/Select/infinite-scroll-compositional.txt" />
    </section>

    <!-- API Reference -->

    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("底部抽屉呈现", "Bottom-sheet presentation")</h2>
        <p class="text-sm text-muted-foreground">@L.T("为面向触摸的选择使用模态底部抽屉。它保留相同的值绑定、选项语义、方向键导航与加载回调。Tab 焦点保持在模态内，选择或 Escape 会把焦点返回给触发器。", "Use a modal bottom sheet for touch-oriented selection. It preserves the same value binding, option semantics, arrow navigation and loading callbacks. Tab stays within the modal, and selection or Escape returns focus to the trigger.")</p>
<Select TValue="string" @bind-Value="sheetChoice" Presentation="SelectPresentation.BottomSheet"
          SheetTitle="@(L.T("配送方式", "Delivery method"))" Placeholder="@(L.T("选择配送方式", "Choose delivery"))" Options="deliveryOptions" Class="w-64" />
        <CodeBlock Source="Components/Select/bottom-sheet.txt" />

    </section>

    <AccessibilityList>
            <AriaAttributes>
                @if (L.IsChinese)
                {
                                <text>
                                    <AccessibilityItem>
                        下拉内容上的 <code class="text-xs bg-muted px-1 py-0.5 rounded">role="listbox"</code>
                    </AccessibilityItem>
                                </text>
}
                else
                {
                                <text>
                                    <AccessibilityItem>
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">role="listbox"</code> on the dropdown content
                    </AccessibilityItem>
                                </text>
}
                @if (L.IsChinese)
                {
                                <text>
                                    <AccessibilityItem>
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-expanded</code> 指示下拉状态
                    </AccessibilityItem>
                                </text>
}
                else
                {
                                <text>
                                    <AccessibilityItem>
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-expanded</code> indicates dropdown state
                    </AccessibilityItem>
                                </text>
}
                @if (L.IsChinese)
                {
                                <text>
                                    <AccessibilityItem>
                        选中项上的 <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-selected</code>
                    </AccessibilityItem>
                                </text>
}
                else
                {
                                <text>
                                    <AccessibilityItem>
                        <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-selected</code> on selected item
                    </AccessibilityItem>
                                </text>
}
                <AccessibilityItem>
                    @L.T("配合键盘导航支持的焦点管理", "Focus management with keyboard navigation support")
                </AccessibilityItem>
            </AriaAttributes>
            <KeyboardNavigation>
                <KeyboardShortcutItem Description="@(L.T("打开下拉", "Open dropdown"))">
                    <Kbd>Enter</Kbd> / <Kbd>Space</Kbd>
                </KeyboardShortcutItem>
                <KeyboardShortcutItem Description="@(L.T("浏览选项", "Navigate options"))">
                    <Kbd>Arrow Keys</Kbd>
                </KeyboardShortcutItem>
                <KeyboardShortcutItem Description="@(L.T("选择选项", "Select option"))">
                    <Kbd>Enter</Kbd>
                </KeyboardShortcutItem>
                <KeyboardShortcutItem Description="@(L.T("关闭下拉", "Close dropdown"))">
                    <Kbd>Escape</Kbd>
                </KeyboardShortcutItem>
            </KeyboardNavigation>
        </AccessibilityList>

    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
