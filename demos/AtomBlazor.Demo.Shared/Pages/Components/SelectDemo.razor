    private async Task HandleSelectCompLoadMore()
    {
        // BL0012：加载态在首个 await 边界即随事件处理器同步段自动渲染，显式调用冗余。
        _selectCompScrollIsLoading = true;

        await Task.Delay(300);

        var nextCount = _selectCompScrollVisible.Length + selectPageSize;
        _selectCompScrollVisible = _allSelectCompCountries.Take(nextCount).ToArray();
        _selectCompScrollIsLoading = false;
    }
