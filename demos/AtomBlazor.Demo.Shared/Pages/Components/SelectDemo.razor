                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        Additional HTML attributes applied to the root <code>&lt;span&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                    </ApiParameter>
                                </text>
}
            </ApiReference>
        </div>

<ApiReference ComponentName="Select / SelectContent">
            <ApiParameter Since="v4" Name="Presentation" Type="SelectPresentation" Default="Popover">@L.T("Popover 或 BottomSheet。在 Select 上设置即可同时作用于选项模式与组合式模式；SelectContent 接受可空的覆盖值。由应用自行决定何时切换呈现方式。", "Popover or BottomSheet. Set it on Select for both options and compositional modes; SelectContent accepts a nullable override. Applications choose when to switch presentation.")</ApiParameter>
