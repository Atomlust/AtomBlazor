            <ApiReference ComponentName="Select&lt;TValue&gt;">
                <ApiParameter Name="AriaLabel" Type="string?" Default="null">@L.T("转发给交互控件或分组的无障碍名称。", "Accessible name forwarded to the interactive control or group.")</ApiParameter>
                <ApiParameter Name="Options" Type="IEnumerable&lt;SelectOption&lt;TValue&gt;&gt;?">
                    @L.T("数据驱动模式下的选项集合。提供时，会自动生成触发器、值显示与下拉内容。", "Collection of options for data-driven mode. When provided, auto-generates trigger, value display, and dropdown content.")
                </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="Value" Type="TValue?">
                        当前选中的值。支持使用 <code>@@bind-Value</code> 进行双向绑定。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="Value" Type="TValue?">
                        Currently selected value. Supports two-way binding with <code>@@bind-Value</code>.
                    </ApiParameter>
                                </text>
}
                <ApiParameter Name="ValueChanged" Type="EventCallback&lt;TValue?&gt;">
                    @L.T("选中值变化时调用的回调。", "Callback invoked when the selected value changes.")
                </ApiParameter>
                <ApiParameter Name="Placeholder" Type="string?">
                    @L.T("未选择任何值时显示的占位文本（数据驱动模式）。", "Placeholder text when no value is selected (data-driven mode).")
                </ApiParameter>
                <ApiParameter Name="Disabled" Type="bool" Default="false">
                    @L.T("下拉选择是否被禁用。", "Whether the select is disabled.")
                </ApiParameter>
                <ApiParameter Name="Required" Type="bool" Default="false">
                    @L.T("下拉选择是否为必填。", "Whether the select is required.")
                </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="Open" Type="bool?">
                        下拉是否处于打开状态。支持使用 <code>@@bind-Open</code> 进行双向绑定。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="Open" Type="bool?">
                        Whether the dropdown is open. Supports two-way binding with <code>@@bind-Open</code>.
                    </ApiParameter>
                                </text>
}
                <ApiParameter Name="DisplayTextSelector" Type="Func&lt;TValue, string&gt;?">
                    @L.T("在组合式模式下从值显示文本的函数。缺省时回退到 ToString()。", "Function to derive display text from a value in compositional mode. Falls back to ToString().")
                </ApiParameter>
                <ApiParameter Name="ChildContent" Type="RenderFragment?">
                    @L.T("组合式模式下的内容。应包含 SelectTrigger 与 SelectContent。", "Content for compositional mode. Should contain SelectTrigger and SelectContent.")
                </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        应用到组件根元素的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        Additional HTML attributes applied to the component's root element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                    </ApiParameter>
                                </text>
}
            </ApiReference>

            <ApiReference ComponentName="SelectTrigger&lt;TValue&gt;">
                <ApiParameter Name="Class" Type="string?">
