    private async Task HandleSelectLoadMore()
    {
        // BL0012：加载态在首个 await 边界即随事件处理器同步段自动渲染，显式调用冗余。
        _selectScrollIsLoading = true;

        await Task.Delay(300);

        var nextCount = _selectScrollCountries.Length + selectPageSize;
        _selectScrollCountries = _allSelectCountries.Take(nextCount).ToArray();
        _selectScrollIsLoading = false;
    }

