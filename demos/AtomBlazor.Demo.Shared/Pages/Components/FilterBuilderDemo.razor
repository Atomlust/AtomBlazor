}
                    else
                    {
                                        <text>
                                            Additional HTML attributes applied to the root <code>&lt;div&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                                        </text>
}
                </ApiParameter>

            <ApiParameter Since="v4" Name="Presets / PresetDisplay" Type="IReadOnlyList&lt;FilterPreset&gt; / FilterPresetDisplay" Default="[] / Buttons">@L.T("以按钮或下拉形式展示的可复用定义。每个预设包含 Id、Label 与 Filter；被选中的定义会被克隆一份。", "Reusable definitions shown as buttons or a Dropdown. Each preset has Id, Label and Filter; selected definitions are cloned.")</ApiParameter>
            <ApiParameter Name="ApplyPresetAsync(id)" Type="Task">@L.T("在渲染器的调度线程上载入某个预设，并遵守显式 Apply 模式与已配置的深度/条件数上限。未知的 ID 会抛出 ArgumentException。", "Loads a preset on the renderer dispatcher, respecting explicit Apply mode and configured depth/condition limits. Unknown IDs throw ArgumentException.")</ApiParameter>
            <ApiParameter Since="v4" Name="SearchableFields" Type="bool" Default="false">@L.T("为每个字段选择器使用可搜索的组合框。", "Uses a searchable combobox for each field selector.")</ApiParameter>
            <ApiParameter Since="v4" Name="ValueEditors" Type="IReadOnlyDictionary&lt;string, RenderFragment&lt;FilterValueEditorContext&gt;&gt;?">@L.T("按字段名提供的可选值编辑器。未列出的字段使用内置编辑器。上下文暴露 Field、Operator、Value、ValueEnd 以及 SetValueAsync(value, valueEnd)。", "Optional value editors by field name. Unlisted fields use built-in editors. Context exposes Field, Operator, Value, ValueEnd and SetValueAsync(value, valueEnd).")</ApiParameter>

        </ApiReference>
        </div>


