    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件属性与参数。", "Component properties and parameters.")</p>
        </div>
        <div class="space-y-4">
            <ApiReference ComponentName="FilterBuilder">
                <ApiParameter Name="Filter" Type="FilterDefinition">
                    @L.T("当前的筛选状态。与 @@bind-Filter 搭配可实现双向绑定。", "The current filter state. Use with @bind-Filter for two-way binding.")
                </ApiParameter>
                <ApiParameter Name="Fields" Type="IEnumerable&lt;FilterField&gt;">
                    @L.T("可供筛选的字段。每个字段定义名称、标签、类型，枚举字段还可以提供选项。", "The available fields to filter on. Each field defines a name, label, type, and optional options for enum fields.")
                </ApiParameter>
                <ApiParameter Name="OnFilterChanged" Type="EventCallback&lt;FilterDefinition&gt;">
                    @L.T("筛选发生变化时调用的回调。可用于把筛选应用到数据这类副作用。", "Callback invoked when the filter changes. Use for side effects like applying filters to data.")
                </ApiParameter>
                <ApiParameter Name="MaxDepth" Type="int" Default="3">
                    @L.T("分组的最大嵌套深度。设为 0 可完全禁用分组。", "Maximum nesting depth for filter groups. Set to 0 to disable grouping entirely.")
                </ApiParameter>
                <ApiParameter Name="MaxConditions" Type="int?" Default="null">
                    @L.T("所有分组内允许的条件总数上限。为 null 表示不限制。", "Maximum total conditions allowed across all groups. Null for unlimited.")
                </ApiParameter>
                <ApiParameter Name="DefaultOperator" Type="LogicalOperator" Default="And">
                    @L.T("新建分组默认使用的逻辑运算符（AND/OR）。", "Default logical operator (AND/OR) for new groups.")
                </ApiParameter>
                <ApiParameter Name="ShowApplyButton" Type="bool" Default="false">
                    @L.T("显示显式的 Apply 按钮，而不是每次编辑后自动应用变更。", "Show an explicit Apply button instead of auto-applying changes on each edit.")
                </ApiParameter>
                <ApiParameter Name="Compact" Type="bool" Default="false">
                    @L.T("紧凑布局模式，输入框更小，适合内联或工具栏摆放。", "Compact layout mode for inline/toolbar placement with smaller inputs.")
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?">
                    @L.T("追加到容器元素上的额外 CSS 类。", "Additional CSS classes for the container element.")
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    @if (L.IsChinese)
                    {
                                        <text>
