@page "/components/selection-indicator"
@using AtomBlazor.Icons.Lucide

<PageTitle>@L.T("Selection Indicator 选中标识 - Atom BlazorUI", "Selection Indicator - Atom BlazorUI")</PageTitle>
<div class="max-w-4xl space-y-8">
    <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">@L.T("Selection Indicator 选中标识", "Selection Indicator")</h1>
        <p class="text-xl text-muted-foreground">@L.T("跟随当前激活项的装饰性高亮，可选跟随指针悬停或键盘焦点。", "A decorative highlight that follows the active item and optionally pointer hover or keyboard focus.")</p>
    </div>
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("激活、悬停与焦点反馈", "Active, hover and focus feedback")</h2>
        <div class="rounded-lg border p-6 space-y-4">
<div class="relative flex w-fit flex-wrap gap-1 rounded-lg border p-1" role="group" aria-label="@(L.T("项目视图", "Project view"))">
    <SelectionIndicator Selector="[aria-pressed=true]" HoverSelector="button" />
    @foreach (var name in new[] { "Overview", "Activity", "Settings" })
    {
        <Button Variant="ButtonVariant.Ghost" Class="relative" aria-pressed="@((selected == name).ToString().ToLowerInvariant())" OnClick="@(() => selected = name)">@name</Button>
    }
</div>
@if (L.IsChinese)
{
<text>
    <p role="status" class="text-sm text-muted-foreground">已选择：@selected</p>
</text>
}
else
{
<text>
    <p role="status" class="text-sm text-muted-foreground">Selected: @selected</p>
</text>
}
        </div>
        <CodeBlock Source="Components/SelectionIndicator/basic.txt" />
    </section>
    <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>@L.T("该标识为装饰性且带 aria-hidden；底层控件必须暴露已选中或当前状态。", "The indicator is decorative and aria-hidden; the underlying controls must expose selected or current state.")</AccessibilityItem>
            <AccessibilityItem>@L.T("示例按钮使用 aria-pressed。动效遵循 prefers-reduced-motion，且不增加键盘停留点。", "The example buttons use aria-pressed. Motion respects prefers-reduced-motion and adds no keyboard stops.")</AccessibilityItem>
        </AriaAttributes>
        <KeyboardNavigation>
            <KeyboardShortcutItem Description="@(L.T("在可交互控件间移动", "Move between interactive controls"))"><Kbd>Tab / Shift + Tab</Kbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("激活获得焦点的按钮", "Activate a focused button"))"><Kbd>Enter / Space</Kbd></KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
<ApiReference Since="v4" ComponentName="SelectionIndicator">
        <ApiParameter Name="Selector / HoverSelector" Type="string / string?" Default="active/selected/current selector / null">@L.T("匹配定位父元素下的活动子元素。可选的悬停选择器也会跟随键盘焦点。前景项应设置为相对定位。", "Match an active descendant of the positioned parent. Optional hover selector also follows keyboard focus. Foreground items should be positioned relative.")</ApiParameter>
        <ApiParameter Name="Duration / Class" Type="int / string?" Default="200 / null">@L.T("以毫秒计的动效时长，以及标识的外观。", "Motion duration in milliseconds and indicator appearance.")</ApiParameter>
    </ApiReference>
    </section>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    private string selected = "Overview";
}
