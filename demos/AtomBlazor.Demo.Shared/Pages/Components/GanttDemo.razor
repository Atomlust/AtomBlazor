                    <ApiParameter Name="ShowTaskLabels" Type="bool" Default="false">
                        @L.T("任务名称是否写在它的条形旁边。默认关闭，因为任务清单已经固定在侧面了。", "Whether a task's name is written beside its bar. Off by default, because the task list is already pinned to the side.")
                    </ApiParameter>
                    <ApiParameter Name="Resizable" Type="bool" Default="true">
                        @L.T("列的边缘是否可以拖动来改变宽度。", "Whether a column's edge can be dragged to change its width.")
