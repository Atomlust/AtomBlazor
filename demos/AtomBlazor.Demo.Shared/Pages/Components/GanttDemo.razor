                    <ApiParameter Name="Height" Type="string?">
                        @L.T("滚动区域的高度，写作 CSS 长度。滚动时表头与任务清单保持不动。", "The height of the scrolling area, as a CSS length. The header and the task list stay put while the rest scrolls.")
                    </ApiParameter>
                    <ApiParameter Name="Loading" Type="bool" Default="false">
                        @L.T("是否用加载指示取代图表。", "Whether a loading indicator replaces the chart.")
                    </ApiParameter>
                    <ApiParameter Name="EmptyMessage" Type="string?">
