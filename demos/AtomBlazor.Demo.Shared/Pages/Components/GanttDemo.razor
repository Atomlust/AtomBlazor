                    </ApiParameter>
                    <ApiParameter Name="AriaLabel" Type="string?">
                        @L.T("读屏软件为这张图表播报的标签。", "The label a screen reader announces for the chart.")
                    </ApiParameter>
                </ApiReference>

                <ApiReference ComponentName="GanttColumn&lt;TItem&gt;">
                    <ApiParameter Name="Title" Type="string">
                        @L.T("列标题。", "The heading.")
                    </ApiParameter>
                    <ApiParameter Name="Width" Type="int" Default="140">
                        @L.T("这一列绘制出的宽度，单位为像素。", "How wide the column is drawn, in pixels.")
                    </ApiParameter>
                    <ApiParameter Name="Value" Type="Func&lt;TItem, object?&gt;?">
                        @L.T("从你的任务读取单元格的值，它也是排序比较所用的依据。树列上不设置时显示任务的名称。", "Reads the cell's value from your task, and is what a sort compares. Unset on the tree column shows the task's name.")
                    </ApiParameter>
                    <ApiParameter Name="Format" Type="string?">
                        @L.T("写入这个值所使用的格式，为标准 .NET 格式字符串。", "The format the value is written with, as a standard .NET format string.")
                    </ApiParameter>
                    @if (L.IsChinese)
                    {
                                        <text>
                                            <ApiParameter Name="ChildContent" Type="RenderFragment&lt;GanttRow&lt;TItem&gt;&gt;?">
                            单元格的内容，用来替换 <code class="text-xs bg-muted px-1 py-0.5 rounded">Value</code>。这里的上下文是汇总之后的那一行，所以写在这里的日期与它旁边的条形一致。
                        </ApiParameter>
                                        </text>
}
                    else
                    {
                                        <text>
                                            <ApiParameter Name="ChildContent" Type="RenderFragment&lt;GanttRow&lt;TItem&gt;&gt;?">
                            The cell's content, which replaces <code class="text-xs bg-muted px-1 py-0.5 rounded">Value</code>. The context is the row after roll-up, so a date here agrees with the bar beside it.
                        </ApiParameter>
                                        </text>
}
                    @if (L.IsChinese)
                    {
                                        <text>
                                            <ApiParameter Name="Align" Type="GanttColumnAlign" Default="Start">
                            <code class="text-xs bg-muted px-1 py-0.5 rounded">Start</code>、<code class="text-xs bg-muted px-1 py-0.5 rounded">Center</code> 或 <code class="text-xs bg-muted px-1 py-0.5 rounded">End</code>。
                        </ApiParameter>
                                        </text>
}
                    else
                    {
                                        <text>
                                            <ApiParameter Name="Align" Type="GanttColumnAlign" Default="Start">
                            <code class="text-xs bg-muted px-1 py-0.5 rounded">Start</code>, <code class="text-xs bg-muted px-1 py-0.5 rounded">Center</code> or <code class="text-xs bg-muted px-1 py-0.5 rounded">End</code>.
                        </ApiParameter>
                                        </text>
}
                    <ApiParameter Name="IsTree" Type="bool" Default="false">
                        @L.T("这一列是否承载展开按钮与缩进。都不设置时，由第一个声明的列来承担。", "Whether this column carries the expander and the indent. Unset, the first column declared takes it.")
                    </ApiParameter>
                    <ApiParameter Name="Sortable" Type="bool" Default="false">
                        @L.T("列标题是否在自己的分支内对任务排序。", "Whether the heading sorts the tasks, within their branch.")
                    </ApiParameter>
                    <ApiParameter Name="Comparer" Type="IComparer&lt;object?&gt;?">
                        @L.T("这一列的取值如何排序。默认按取值自身的顺序。", "How this column's values are ordered. Defaults to the value's own order.")
                    </ApiParameter>
                    <ApiParameter Name="Key" Type="string?">
