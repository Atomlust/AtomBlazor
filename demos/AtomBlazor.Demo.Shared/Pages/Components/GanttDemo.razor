                </ApiReference>
            </div>
        </section>
    </div>
</div>

@code {
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    private string? basicSummary;

    /// <summary>
    /// Reads the finished chart. This is the arrangement that used to hang: the handler lives on
    /// the page that declares the chart, so every call re-renders the page and sets the chart's
    /// parameters again.
    /// </summary>
    private void DescribeBuild(GanttChart<PlanTask>? chart)
    {
        if (chart is null)
        {
            basicSummary = null;
            return;
        }

        var milestones = chart.Rows.Count(r => r.IsMilestone);
        var summaries = chart.Rows.Count(r => r.IsSummary);

        basicSummary =
            $"{chart.TaskCount} tasks over {chart.Axis.SlotCount} days, " +
            $"{summaries} of them summaries and {milestones} milestones, " +
            $"from {chart.Axis.Start:d MMM yyyy} to {chart.Axis.End:d MMM yyyy}.";
    }

    /// <summary>One task of the plan. A class, not a record, so the drag demo can write to it.</summary>
    public sealed class PlanTask
    {
        public required string Id { get; init; }

        public string? Parent { get; set; }

        public required string Name { get; set; }

        public required string Owner { get; init; }

        public DateTimeOffset Start { get; set; }

        public DateTimeOffset End { get; set; }

        public double Progress { get; set; }
    }

    /// <summary>The Monday of last week, so that today lands in the middle of the plan.</summary>
    private static readonly DateTimeOffset origin = Monday();

    private static DateTimeOffset Monday()
    {
        var today = DateTimeOffset.Now.Date;
        var back = ((int)today.DayOfWeek + 6) % 7;
        return new DateTimeOffset(today.AddDays(-back - 7), DateTimeOffset.Now.Offset);
    }

    private static DateTimeOffset Day(int offset) => origin.AddDays(offset);

    private static PlanTask Task(string id, string? parent, string name, string owner, int start, int length, double progress = 0) =>
        new()
        {
            Id = id,
            Parent = parent,
            Name = name,
            Owner = owner,
            Start = Day(start),
            End = Day(start + length),
            Progress = progress,
        };

    private static List<PlanTask> BuildPlan() =>
    [
        Task("discovery", null, "Discovery", "Ana", 0, 0),
        Task("interviews", "discovery", "Customer interviews", "Ana", 0, 5, 1.0),
        Task("survey", "discovery", "Pricing survey", "Ben", 3, 4, 1.0),
        Task("findings", "discovery", "Findings agreed", "Ana", 8, 0),

        Task("design", null, "Design", "Cal", 0, 0),
        Task("wireframes", "design", "Wireframes", "Cal", 8, 5, 1.0),
        Task("visual", "design", "Visual design", "Cal", 0, 0),
        Task("palette", "visual", "Colour and type", "Cal", 13, 4, 0.75),
        Task("components", "visual", "Component sheet", "Dee", 13, 7, 0.4),
        Task("signoff", "design", "Design signed off", "Ana", 21, 0),

        Task("build", null, "Build", "Ben", 0, 0),
        Task("api", "build", "Scheduling API", "Ben", 21, 10, 0.35),
        Task("web", "build", "Web client", "Dee", 24, 12, 0.2),
        Task("integrate", "build", "Integration pass", "Ben", 36, 4),

        Task("launch", null, "Launch", "Ana", 0, 0),
        Task("beta", "launch", "Private beta", "Ana", 40, 7),
        Task("docs", "launch", "Docs and release notes", "Dee", 38, 6),
        Task("ship", "launch", "Ship", "Ana", 47, 0),
    ];

    private readonly List<PlanTask> plan = BuildPlan();

    private List<PlanTask> editable = BuildPlan();

    private static readonly GanttDependency[] links =
    [
        new("interviews", "survey"),
        new("survey", "findings"),
        new("findings", "wireframes"),
        new("wireframes", "palette"),
        new("palette", "components", GanttDependencyType.StartToStart),
        new("components", "signoff"),
        new("signoff", "api"),
        new("api", "integrate"),
        new("web", "integrate", GanttDependencyType.FinishToFinish),
        new("integrate", "beta"),
        new("docs", "beta", GanttDependencyType.StartToFinish),
        new("beta", "ship"),
    ];


    private readonly List<PlanTask> linkable = BuildPlan();

    private List<PlanTask> orderable = BuildPlan();

    private string? lastMove;

    private int added;

    private List<GanttDependency> drawn = [];

    private string? lastLink;

    private GanttZoom zoom = GanttZoom.Day;
    private bool rollUp = true;
    private HashSet<string> closed = [];
    private string? lastChange;

    /// <summary>Which data panels are open. One per demo, so opening one leaves the others alone.</summary>
    private readonly HashSet<string> openData = [];

    private void ToggleData(string id)
    {
        if (!openData.Remove(id))
        {
            openData.Add(id);
        }
    }

    private void Fold(string id)
    {
        var next = new HashSet<string>(closed);
        if (!next.Remove(id))
        {
            next.Add(id);
        }

        closed = next;
    }

    private void ResetEditable()
    {
        editable = BuildPlan();
        lastChange = null;
    }

    private void Reschedule(GanttChangeContext<PlanTask> change)
    {
        if (change.Row.IsSummary)
        {
            // A summary is worked out from its children; moving it would be a number with nothing
            // behind it. Refusing here is what the Cancel flag is for.
            change.Cancel = true;
            lastChange = $"{change.Item.Name} is a summary. Drag the tasks under it instead.";
            return;
        }

        if (change.Kind == GanttChangeKind.Progress)
        {
            change.Item.Progress = change.Progress;
            lastChange = $"{change.Item.Name} is {change.Progress:P0} done.";
            return;
        }

        change.Item.Start = change.Start;
        change.Item.End = change.End;
        lastChange = $"{change.Item.Name}: {change.Start:d MMM} to {change.End:d MMM}.";
    }

    private void MoveTask(GanttMoveContext<PlanTask> move)
    {
        var item = move.Item;
        orderable.Remove(item);
        item.Parent = move.NewParentId;

        // Dropping inside puts the task first under its new parent, which is where a reader who
        // just aimed at that row expects to find it.
        var target = orderable.IndexOf(move.Target.Item);
        var at = move.Position == GanttDropPosition.Before ? target : target + 1;
        orderable.Insert(Math.Clamp(at, 0, orderable.Count), item);

        lastMove = move.Position == GanttDropPosition.Inside
            ? $"{item.Name} now sits under {move.Target.Text}."
            : $"{item.Name} moved {move.Position.ToString().ToLowerInvariant()} {move.Target.Text}.";
    }

    private void DeleteTask(PlanTask task)
    {
        // Everything under it goes too, or its children would reappear at the top level.
        var doomed = new HashSet<string>(StringComparer.Ordinal) { task.Id };
        for (var pass = 0; pass < orderable.Count; pass++)
        {
            foreach (var candidate in orderable.Where(t => t.Parent is not null && doomed.Contains(t.Parent)))
            {
                doomed.Add(candidate.Id);
            }
        }

        orderable = [.. orderable.Where(t => !doomed.Contains(t.Id))];
        lastMove = $"{task.Name} deleted, with {doomed.Count - 1} task(s) under it.";
    }

    private void AddTask()
    {
        added++;
        var start = orderable.Count > 0 ? orderable.Max(t => t.End) : Day(0);
        orderable = [.. orderable, new PlanTask
        {
            Id = $"new-{added}",
            Name = $"New task {added}",
            Owner = "Ana",
            Start = start,
            End = start.AddDays(3),
        }];
        lastMove = $"New task {added} added at the end. Drag it wherever it belongs.";
    }

    private void ResetOrderable()
    {
        orderable = BuildPlan();
        added = 0;
        lastMove = null;
    }

    private void AddLink(GanttDependencyContext<PlanTask> link)
    {
        // The one rule this page enforces. A real plan would check for a loop here, which is the
        // same shape of check and the reason the callback can refuse at all.
        if (link.To.Start < link.From.Start)
        {
            link.Cancel = true;
            lastLink = $"{link.To.Text} starts before {link.From.Text}, so that arrow would point backwards.";
            return;
        }

        if (drawn.Any(d => d.FromId == link.Dependency.FromId && d.ToId == link.Dependency.ToId))
        {
            lastLink = $"{link.From.Text} already points at {link.To.Text}.";
            return;
        }

        drawn = [.. drawn, link.Dependency];
        lastLink = $"{link.From.Text} \u2192 {link.To.Text} ({link.Dependency.Type}). Click the arrow to remove it.";
    }

    private void RemoveLink(GanttDependency dependency)
    {
        drawn = [.. drawn.Where(d => !ReferenceEquals(d, dependency))];
        lastLink = "Arrow removed.";
    }

    private void ResetLinks()
    {
        drawn = [];
        lastLink = null;
    }

    private string Named(string id) =>
        plan.FirstOrDefault(t => t.Id == id)?.Name ?? id;

    private string Reads(GanttDependency link) => link.Type switch
    {
        GanttDependencyType.StartToStart => $"{Named(link.FromId)} starts when {Named(link.ToId)} starts",
        GanttDependencyType.FinishToFinish => $"{Named(link.FromId)} finishes when {Named(link.ToId)} finishes",
        GanttDependencyType.StartToFinish => $"{Named(link.FromId)} starts before {Named(link.ToId)} finishes",
        _ => $"{Named(link.FromId)} finishes before {Named(link.ToId)} starts",
    };

    private static string OwnerColor(string owner) => owner switch
    {
        "Ana" => "var(--color-sky-500, #0ea5e9)",
        "Ben" => "var(--color-violet-500, #8b5cf6)",
        "Cal" => "var(--color-emerald-500, #10b981)",
        _ => "var(--color-amber-500, #f59e0b)",
    };

    /// <summary>
    /// A collapsible view of the rows a chart was built from. A summary's bar disagrees with its
    /// own declared dates on purpose, and that is only readable next to the rows themselves.
    /// </summary>
    private RenderFragment DataPanel(string id) => @<div class="space-y-2">
        <button type="button"
                class="inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground"
                aria-expanded="@(openData.Contains(id) ? "true" : "false")"
                @onclick="@(() => ToggleData(id))">
            <span class="font-mono text-xs">@(openData.Contains(id) ? "▾" : "▸")</span>
            @(openData.Contains(id)
                ? "Hide the data"
                : $"Show the data — {plan.Count} tasks")
        </button>

        @if (openData.Contains(id))
        {
            <div class="rounded-md border overflow-auto" style="max-height: 22rem">
                <table class="w-full text-xs">
                    <thead class="sticky top-0 bg-muted">
                        <tr class="border-b">
                            <th class="px-2 py-1.5 text-left font-medium">Id</th>
                            <th class="px-2 py-1.5 text-left font-medium">Parent</th>
                            <th class="px-2 py-1.5 text-left font-medium">Name</th>
                            <th class="px-2 py-1.5 text-left font-medium">Owner</th>
                            <th class="px-2 py-1.5 text-left font-medium">Start</th>
                            <th class="px-2 py-1.5 text-left font-medium">End</th>
                            <th class="px-2 py-1.5 text-right font-medium">Progress</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in plan)
                        {
                            <tr class="border-b last:border-0">
                                <td class="px-2 py-1 font-mono">@task.Id</td>
                                <td class="px-2 py-1 font-mono text-muted-foreground">@(task.Parent ?? "—")</td>
                                <td class="px-2 py-1">@task.Name</td>
                                <td class="px-2 py-1">@task.Owner</td>
                                <td class="px-2 py-1 tabular-nums">@task.Start.ToString("ddd d MMM")</td>
                                <td class="px-2 py-1 tabular-nums">@task.End.ToString("ddd d MMM")</td>
                                <td class="px-2 py-1 text-right tabular-nums">@task.Progress.ToString("P0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="text-xs text-muted-foreground">
                Every phase is declared with no length at all. What you see on its bar is its
                children's span, worked out by the engine.
            </p>
        }
    </div>;

    private string HeadlessDump
    {
        get
        {
            var chart = GanttBuilder.Build(new GanttSource<PlanTask>
            {
                Items = plan,
                Id = t => t.Id,
                ParentId = t => t.Parent,
                Text = t => t.Name,
                Start = t => t.Start,
                End = t => t.End,
                Progress = t => t.Progress,
                Zoom = GanttZoom.Week,
            });

            var builder = new System.Text.StringBuilder();
            var culture = System.Globalization.CultureInfo.InvariantCulture;
            const int trackWidth = 48;
            var scale = (double)trackWidth / chart.Axis.SlotCount;

            foreach (var row in chart.Rows)
            {
                var name = new string(' ', row.Depth * 2) + row.Text;
                var from = (int)Math.Round(row.OffsetSlots * scale);
                var length = Math.Max(row.IsMilestone ? 0 : 1, (int)Math.Round(row.LengthSlots * scale));
                var fill = row.IsMilestone ? "◆" : new string(row.IsSummary ? '=' : '#', length);

                builder.Append(culture, $"{name,-26}");
                builder.Append(new string('·', Math.Min(from, trackWidth)));
                builder.Append(fill);
                builder.Append(new string('·', Math.Max(0, trackWidth - from - fill.Length)));
                builder.Append(culture, $" {row.Progress * 100,3:0}%");
                builder.Append('\n');
            }

            return builder.ToString();
        }
    }
}
