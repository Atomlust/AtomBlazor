@page "/components/progress"

<PageTitle>@L.T("进度条组件 - Atom BlazorUI", "Progress Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("进度条组件", "Progress Component")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("显示任务完成进度的指示器。", "Displays an indicator showing the completion progress of a task.")
            </p>
        </div>
    </div>

    <!-- Basic Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("基本示例", "Basic Example")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("显示静态值的简单进度条。", "A simple progress bar showing a static value.")
            </p>
        </div>
        <Progress Value="33" />
        <CodeBlock Source="Components/Progress/basic.txt" />
    </div>

    <!-- Different Values -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("进度状态", "Progress States")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("处于不同完成度的进度条。", "Progress bars at different completion levels.")
            </p>
        </div>
        <div class="space-y-6">
            <div class="space-y-2">
                <div class="flex justify-between text-sm">
                    <span>@L.T("空", "Empty")</span>
                    <span>0%</span>
                </div>
                <Progress Value="0" />
            </div>
            <div class="space-y-2">
                <div class="flex justify-between text-sm">
                    <span>@L.T("四分之一", "Quarter")</span>
                    <span>25%</span>
                </div>
                <Progress Value="25" />
            </div>
            <div class="space-y-2">
                <div class="flex justify-between text-sm">
                    <span>@L.T("一半", "Half")</span>
                    <span>50%</span>
                </div>
                <Progress Value="50" />
            </div>
            <div class="space-y-2">
                <div class="flex justify-between text-sm">
                    <span>@L.T("四分之三", "Three Quarters")</span>
                    <span>75%</span>
                </div>
                <Progress Value="75" />
            </div>
            <div class="space-y-2">
                <div class="flex justify-between text-sm">
                    <span>@L.T("已完成", "Complete")</span>
                    <span>100%</span>
                </div>
                <Progress Value="100" />
            </div>
        </div>
        <CodeBlock Source="Components/Progress/states.txt" />
    </div>

    <!-- Interactive Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("交互示例", "Interactive Example")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("动态控制进度值。", "Control the progress value dynamically.")
            </p>
        </div>
        <div class="space-y-4">
            <Progress Value="@_progressValue" />
            <div class="flex items-center gap-4">
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => _progressValue = Math.Max(0, _progressValue - 10))">
                    -10
                </Button>
                <span class="text-sm font-medium w-12 text-center">@_progressValue%</span>
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => _progressValue = Math.Min(100, _progressValue + 10))">
                    +10
                </Button>
                <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" OnClick="@(() => _progressValue = 0)">
                    @L.T("重置", "Reset")
                </Button>
            </div>
        </div>
        <CodeBlock Source="Components/Progress/interactive.txt" />
    </div>

    <!-- Custom Max Value -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("自定义最大值", "Custom Max Value")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("进度条可以设置自定义的最大值。", "Progress bars can have custom maximum values.")
            </p>
        </div>
        <div class="space-y-4">
            <div class="space-y-2">
                <div class="flex justify-between text-sm">
                    <span>@L.T("已下载 10 个文件中的 3 个", "Downloaded 3 of 10 files")</span>
                    <span>30%</span>
                </div>
                <Progress Value="3" Max="10" />
            </div>
            <div class="space-y-2">
                <div class="flex justify-between text-sm">
                    <span>@L.T("已上传 1000MB 中的 750MB", "Uploaded 750MB of 1000MB")</span>
                    <span>75%</span>
                </div>
                <Progress Value="750" Max="1000" />
            </div>
        </div>
        <CodeBlock Source="Components/Progress/custom-max.txt" />
    </div>

    <!-- With Label -->
    <div class="space-y-4">
        <div class="space-y-2">
            <div class="flex items-center gap-2">
                <h2 class="text-2xl font-semibold">@L.T("带标签", "With Label")</h2>
                <span class="inline-flex items-center rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary ring-1 ring-inset ring-primary/20">v3</span>
            </div>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    使用 <code class="text-xs bg-muted px-1 py-0.5 rounded">ShowLabel="true"</code> 在进度条旁显示百分比标签，并用 <code class="text-xs bg-muted px-1 py-0.5 rounded">LabelFormat</code> 自定义格式。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use <code class="text-xs bg-muted px-1 py-0.5 rounded">ShowLabel="true"</code> to display a percentage label alongside the progress bar. Customize the format with <code class="text-xs bg-muted px-1 py-0.5 rounded">LabelFormat</code>.
                </p>
                        </text>
}
        </div>
        <div class="space-y-4">
            <Progress Value="60" ShowLabel="true" />
            <Progress Value="3" Max="5" ShowLabel="true" LabelFormat="{0}% done" />
            <Progress Value="@_progressValue" ShowLabel="true" />
        </div>
        <CodeBlock Source="Components/Progress/label.txt" />
    </div>

    <!-- Custom Styling -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("自定义样式", "Custom Styling")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("使用自定义类覆盖样式。", "Override styles with custom classes.")
            </p>
        </div>
        <div class="space-y-4">
            <div class="space-y-2">
                <span class="text-sm">@L.T("更高的进度条", "Taller progress bar")</span>
                <Progress Value="60" Class="h-6" />
            </div>
            <div class="space-y-2">
                <span class="text-sm">@L.T("自定义颜色", "Custom colors")</span>
                <Progress Value="80" Class="bg-blue-100 dark:bg-blue-900" IndicatorClass="bg-blue-500" />
            </div>
            <div class="space-y-2">
                <span class="text-sm">@L.T("全圆角", "Rounded full")</span>
                <Progress Value="45" Class="h-3 rounded-full" />
            </div>
        </div>
        <CodeBlock Source="Components/Progress/custom-styling.txt" />
    </div>

    <!-- Accessibility -->
    <AccessibilityList>
        <AriaAttributes>
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    使用 <code>role="progressbar"</code> 将该元素标识为进度指示器，供辅助技术识别。
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    Uses <code>role="progressbar"</code> to identify the element as a progress indicator to assistive technologies.
                </AccessibilityItem>
                        </text>
}
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    将 <code>aria-valuenow</code> 设为当前进度值，<code>aria-valuemin="0"</code>，并将 <code>aria-valuemax</code> 设为所配置的最大值。
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    Sets <code>aria-valuenow</code> to the current progress value, <code>aria-valuemin="0"</code>, and <code>aria-valuemax</code> to the configured maximum.
                </AccessibilityItem>
                        </text>
}
            <AccessibilityItem>
                @L.T("进度百分比通过指示器上的 CSS transform 视觉呈现，确保在各浏览器间渲染一致。", "Progress percentage is visually conveyed via a CSS transform on the indicator, ensuring consistent rendering across browsers.")
            </AccessibilityItem>
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    启用 <code>ShowLabel</code> 时，会在进度条旁显示可见的百分比文本，提供更清晰的提示。
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    When <code>ShowLabel</code> is enabled, a visible text percentage is displayed alongside the bar for additional clarity.
                </AccessibilityItem>
                        </text>
}
        </AriaAttributes>
    </AccessibilityList>

    <!-- API Reference -->
    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件属性与参数。", "Component properties and parameters.")</p>
        </div>
        <div class="space-y-4">
            <ApiReference ComponentName="Progress">
                <ApiParameter Name="Value" Type="double" Default="0">
                    @L.T("当前的进度值。", "The current progress value.")
                </ApiParameter>
                <ApiParameter Name="Max" Type="double" Default="100">
                    @L.T("进度条的最大值。", "The maximum value for the progress bar.")
                </ApiParameter>
                <ApiParameter Name="ShowLabel" Type="bool" Default="false">
                    @L.T("为 true 时，在进度条旁显示百分比标签。", "When true, displays a percentage label next to the progress bar.")
                </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="LabelFormat" Type="string" Default="&quot;{0}%&quot;">
                        标签使用的自定义格式字符串。<code>{0}</code> 会被替换为整数百分比值。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="LabelFormat" Type="string" Default="&quot;{0}%&quot;">
                        Custom format string for the label. <code>{0}</code> is replaced with the integer percentage value.
                    </ApiParameter>
                                </text>
}
                <ApiParameter Name="Class" Type="string?">
                    @L.T("应用到进度容器的额外 CSS 类。", "Additional CSS classes to apply to the progress container.")
                </ApiParameter>
                <ApiParameter Name="IndicatorClass" Type="string?">
                    @L.T("应用到进度指示器的额外 CSS 类。", "Additional CSS classes to apply to the progress indicator.")
                </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        应用到组件根元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        Additional HTML attributes applied to the component's root element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                    </ApiParameter>
                                </text>
}
            </ApiReference>
        </div>
    </section>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    private double _progressValue = 33;
}
