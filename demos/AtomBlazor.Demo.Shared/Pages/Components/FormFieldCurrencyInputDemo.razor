@page "/components/form-field-currency-input"
@using System.ComponentModel.DataAnnotations

<PageTitle>@L.T("FormFieldCurrencyInput 表单货币输入 - Atom BlazorUI", "FormFieldCurrencyInput Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">FormFieldCurrencyInput</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("CurrencyInput 的表单字段封装，内置标签、提示文本与错误信息。",
                     "A form field wrapper for CurrencyInput with built-in label, helper text, and error messages.")
            </p>
        </div>
    </div>

    <!-- Basic Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("基本用法", "Basic Usage")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("带标签与提示文本的货币输入框，默认使用 USD。",
                     "A currency input with a label and helper text, defaulting to USD.")
            </p>
        </div>
        <div class="max-w-md">
            <FormFieldCurrencyInput @bind-Value="_amount"
                                     Label="@(L.T("金额", "Amount"))"
                                     Placeholder="0.00"
                                     HelperText="@(L.T("请输入支付金额。", "Enter the payment amount."))" />
        </div>
        <div class="rounded-lg border p-4 bg-muted/50">
            <p class="text-sm font-medium mb-1">@L.T("当前值：", "Value:")</p>
            <p class="text-sm font-mono">@_amount.ToString("F2")</p>
        </div>
        <CodeBlock Source="Components/FormFieldCurrencyInput/basic.txt" />
    </div>

    <!-- Different Currencies -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("多种货币", "Different Currencies")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    把 <code class="text-xs bg-muted px-1 py-0.5 rounded">CurrencyCode</code> 设为任意 ISO 4217 代码即可。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Set <code class="text-xs bg-muted px-1 py-0.5 rounded">CurrencyCode</code> to any ISO 4217 code.
                </p>
                        </text>
}
        </div>
        <div class="max-w-md space-y-4">
            <FormFieldCurrencyInput @bind-Value="_eurAmount"
                                     Label="@(L.T("价格（EUR）", "Price (EUR)"))"
                                     CurrencyCode="EUR"
                                     HelperText="@(L.T("欧元金额。", "Euro amount."))" />
            <FormFieldCurrencyInput @bind-Value="_gbpAmount"
                                     Label="@(L.T("价格（GBP）", "Price (GBP)"))"
                                     CurrencyCode="GBP"
                                     HelperText="@(L.T("英镑金额。", "British pounds."))" />
        </div>
        <CodeBlock Source="Components/FormFieldCurrencyInput/currencies.txt" />
    </div>

    <!-- With Range -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("取值范围约束", "With Range Constraints")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    用 <code class="text-xs bg-muted px-1 py-0.5 rounded">Min</code> 与
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">Max</code> 限制取值范围。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use <code class="text-xs bg-muted px-1 py-0.5 rounded">Min</code> and
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">Max</code> to clamp the value.
                </p>
                        </text>
}
        </div>
        <div class="max-w-md">
            <FormFieldCurrencyInput @bind-Value="_donationAmount"
                                     Label="@(L.T("捐赠金额", "Donation"))"
                                     HelperText="@(L.T("介于 $5.00 与 $10,000.00 之间。", "Between $5.00 and $10,000.00."))"
                                     Min="5"
                                     Max="10000"
                                     AllowNegative="false" />
        </div>
        <CodeBlock Source="Components/FormFieldCurrencyInput/range.txt" />
    </div>

    <!-- Disabled -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("禁用", "Disabled")</h2>
            <p class="text-sm text-muted-foreground">@L.T("一个禁用的货币输入表单字段。", "A disabled currency input form field.")</p>
        </div>
        <div class="max-w-md">
            <FormFieldCurrencyInput Value="99.99m"
                                     Label="@(L.T("固定价格", "Fixed price"))"
                                     HelperText="@(L.T("无法修改。", "Cannot be changed."))"
                                     Disabled="true" />
        </div>
        <CodeBlock Source="Components/FormFieldCurrencyInput/disabled.txt" />
    </div>

    <!-- EditForm Integration -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("EditForm 集成", "EditForm Integration")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("在 EditForm 中，校验错误会自动显示。", "Validation errors display automatically inside an EditForm.")
            </p>
        </div>
        <div class="max-w-md">
            <EditForm Model="_formModel" OnValidSubmit="HandleFormSubmit">
                <DataAnnotationsValidator />
                <div class="space-y-4">
                    <FormFieldCurrencyInput @bind-Value="_formModel.Budget"
                                             Label="@(L.T("预算", "Budget"))"
                                             HelperText="@(L.T("至少需要 $100。", "Must be at least $100."))" />
                    <Button Type="ButtonType.Submit">@L.T("提交", "Submit")</Button>
                </div>
            </EditForm>
            @if (_formSubmitted)
            {
                <div class="mt-4 rounded-lg border border-green-200 bg-green-50 dark:bg-green-950 dark:border-green-800 p-4">
                    <p class="text-sm font-medium text-green-800 dark:text-green-200">
                        @L.T("已提交：$", "Submitted: $")@_formModel.Budget.ToString("F2")
                    </p>
                </div>
            }
        </div>
        <CodeBlock Source="Components/FormFieldCurrencyInput/editform.txt" />
    </div>

    <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>@L.T("通过生成的 ID 自动把标签与输入框关联", "Automatically associates label with input via generated ID")</AccessibilityItem>
            <AccessibilityItem>@L.T("通过 aria-describedby 关联描述文本", "Description linked via aria-describedby")</AccessibilityItem>
            <AccessibilityItem>@L.T("校验错误以 aria-invalid 标示", "Validation errors displayed with aria-invalid")</AccessibilityItem>
        </AriaAttributes>
            <KeyboardNavigation>
            <KeyboardShortcutItem Description="@(L.T("在可用的表单控件之间移动", "Move between enabled form controls"))"><Kbd>Tab</Kbd> / <Kbd>Shift + Tab</Kbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("按 Step 增减数值", "Increase or decrease the value by Step"))"><Kbd>ArrowUp</Kbd> / <Kbd>ArrowDown</Kbd></KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>

    <!-- API Reference -->
    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件属性与参数。", "Component properties and parameters.")</p>
        </div>
        <div class="space-y-4">
            <ApiReference ComponentName="FormFieldCurrencyInput">
                <ApiParameter Name="Label" Type="string?" Default="null">@L.T("标签文本。", "The label text.")</ApiParameter>
                <ApiParameter Name="HelperText" Type="string?" Default="null">@L.T("输入框下方的提示文本。", "Helper text below the input.")</ApiParameter>
                <ApiParameter Name="ErrorText" Type="string?" Default="null">@L.T("手动指定的错误文本。", "Manual error text override.")</ApiParameter>
                <ApiParameter Name="Value" Type="decimal" Default="0">@L.T("当前值。使用 @bind-Value。", "The current value. Use @bind-Value.")</ApiParameter>
                <ApiParameter Name="ValueChanged" Type="EventCallback&lt;decimal&gt;">@L.T("值发生变化时的回调。", "Callback when value changes.")</ApiParameter>
                <ApiParameter Name="CurrencyCode" Type="string" Default="&quot;USD&quot;">@L.T("ISO 4217 货币代码。", "ISO 4217 currency code.")</ApiParameter>
                <ApiParameter Name="ShowSymbol" Type="bool" Default="true">@L.T("是否显示货币符号。", "Show the currency symbol.")</ApiParameter>
                <ApiParameter Name="Min" Type="decimal?" Default="null">@L.T("允许的最小值。", "Minimum allowed value.")</ApiParameter>
                <ApiParameter Name="Max" Type="decimal?" Default="null">@L.T("允许的最大值。", "Maximum allowed value.")</ApiParameter>
                <ApiParameter Name="AllowNegative" Type="bool" Default="true">@L.T("是否允许负值。", "Allow negative values.")</ApiParameter>
                <ApiParameter Name="UseThousandSeparator" Type="bool" Default="true">@L.T("是否使用千位分隔符。", "Use thousand separators.")</ApiParameter>
                <ApiParameter Name="Disabled" Type="bool" Default="false">@L.T("输入框是否被禁用。", "Whether the input is disabled.")</ApiParameter>
                <ApiParameter Name="Required" Type="bool" Default="false">@L.T("输入框是否为必填。", "Whether the input is required.")</ApiParameter>
                <ApiParameter Name="EnableWheelStep" Type="bool" Default="false">@L.T("滚轮滑过获得焦点的输入框时是否增减数值。默认为关闭，因为增减会调用 wheel 事件的 preventDefault，从而把滚动从页面上抢走。", "Whether scrolling the mouse wheel over the focused input steps the value. Opt-in, because stepping calls preventDefault on the wheel event and so takes the scroll away from the page.")</ApiParameter>
                <ApiParameter Name="InputClass" Type="string?" Default="null">@L.T("内部输入框的 CSS 类。", "CSS classes for the inner input.")</ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        应用到组件根元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        Additional HTML attributes applied to the component's root element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                    </ApiParameter>
                                </text>
}
            </ApiReference>
        </div>
    </section>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    private decimal _amount;
    private decimal _eurAmount;
    private decimal _gbpAmount;
    private decimal _donationAmount = 25m;
    private bool _formSubmitted;
    private CurrencyFormModel _formModel = new();

    private void HandleFormSubmit()
    {
        _formSubmitted = true;
    }

    private class CurrencyFormModel
    {
        [Range(100, double.MaxValue, ErrorMessage = "Budget must be at least $100.")]
        public decimal Budget { get; set; }
    }
}
