@page "/components/bubble"

<PageTitle>@L.T("Bubble 气泡 - Atom BlazorUI", "Bubble Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("Bubble 气泡组件", "Bubble Component")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("承载对话内容的气泡界面，支持多种样式、左右对齐与表情回应。", "Displays conversational content surfaces with variants, alignment, and reactions.")
            </p>
        </div>
    </div>

    <div class="space-y-4">
        <div class="space-y-3 rounded-lg border p-4 flex justify-center items-center">
            <div class="flex w-full max-w-sm flex-col gap-8 py-12 flex">
                <Bubble Variant="BubbleVariant.Default" Align="BubbleAlign.End">
                    <BubbleContent>@L.T("在吗？最近怎么样？", "Hey there! what's up?")</BubbleContent>
                </Bubble>
                <BubbleGroup>
                    <Bubble Variant="BubbleVariant.Muted">
                        <BubbleContent>@L.T("你好！想看看聊天气泡吗？", "Hey! Want to see chat bubbles?")</BubbleContent>
                    </Bubble>
                    <Bubble Variant="BubbleVariant.Muted">
                        <BubbleContent>
                            @L.T("我可以把消息归组、切换左右两侧，让整段对话好扫读。", "I can group messages, switch sides, and keep the whole thread easy to scan.")
                        </BubbleContent>
                        <BubbleReactions role="img" aria-label="@(L.T("表情回应：竖大拇指", "Reaction: thumbs up"))">
                            <span>👍</span>
                        </BubbleReactions>
                    </Bubble>
                </BubbleGroup>
            </div>
        </div>
        <CodeBlock Source="Components/Bubble/composition.txt"/>
    </div>

    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("样式变体", "Variants")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("七种变体，从最醒目的主色样式到无边框的 ghost 内容。", "Seven variants ranging from strong primary to unframed ghost content.")
            </p>
        </div>
        <div class="space-y-3 rounded-lg border p-4 flex justify-center items-center">
            <div class="flex w-full max-w-sm flex-col gap-8 py-12 flex">
                <Bubble Variant="BubbleVariant.Default">
                    <BubbleContent>Default</BubbleContent>
                </Bubble>
                <Bubble Variant="BubbleVariant.Secondary">
                    <BubbleContent>Secondary</BubbleContent>
                </Bubble>
                <Bubble Variant="BubbleVariant.Muted">
                    <BubbleContent>Muted</BubbleContent>
                </Bubble>
                <div>
                    <Bubble Variant="BubbleVariant.Tinted">
                        <BubbleContent>Tinted</BubbleContent>
                    </Bubble>
                </div>
                <Bubble Variant="BubbleVariant.Outline">
                    <BubbleContent>Outline</BubbleContent>
                </Bubble>
                <Bubble Variant="BubbleVariant.Destructive">
                    <BubbleContent>Destructive</BubbleContent>
                </Bubble>
                <Bubble Variant="BubbleVariant.Ghost">
                    <BubbleContent>@L.T("ghost 气泡可以占满整行宽度，用于展示助手的 Markdown 或富文本输出。", "Ghost bubble can use full width for assistant markdown or rich output.")
                    </BubbleContent>
                </Bubble>
            </div>
        </div>
        <CodeBlock Source="Components/Bubble/variants.txt"/>
    </div>

    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("对齐方式", "Alignment")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("把气泡对齐到对话的起始侧或结束侧。", "Align bubbles to the start or end of the conversation.")
            </p>
        </div>
        <div class="space-y-3 rounded-lg border p-4 flex justify-center items-center">
            <div class="flex w-full max-w-sm flex-col gap-8 py-12 flex">
                <Bubble Align="BubbleAlign.Start" Variant="BubbleVariant.Secondary">
                    <BubbleContent>@L.T("起始侧对齐的气泡。", "Start aligned bubble.")</BubbleContent>
                </Bubble>
                <Bubble Align="BubbleAlign.End" Variant="BubbleVariant.Default">
                    <BubbleContent>@L.T("结束侧对齐的气泡。", "End aligned bubble.")</BubbleContent>
                </Bubble>
            </div>
        </div>
        <CodeBlock Source="Components/Bubble/alignment.txt"/>
    </div>

    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("表情回应", "Reactions")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("把回应行锚定在气泡上沿或下沿。", "Anchor reaction rows above or below the bubble edge.")
            </p>
        </div>
        <div class="space-y-3 rounded-lg border p-4 flex justify-center items-center">
            <div class="flex w-full max-w-sm flex-col gap-8 py-12 flex">
                <Bubble Variant="BubbleVariant.Muted">
                    <BubbleContent>@L.T("这个我周五之前能上线。", "I can ship this by Friday.")</BubbleContent>
                    <BubbleReactions Side="BubbleReactionsSide.Bottom" Align="BubbleReactionsAlign.End" role="img"
                                     aria-label="@(L.T("表情回应：竖大拇指和火箭", "Reactions: thumbs up and rocket"))">
                        <span>👍</span><span>🚀</span>
                    </BubbleReactions>
                </Bubble>
                <Bubble Align="BubbleAlign.End" Variant="BubbleVariant.Default">
                    <BubbleContent>@L.T("很好，就这么办。", "Perfect, let's do it.")</BubbleContent>
                    <BubbleReactions Side="BubbleReactionsSide.Top" Align="BubbleReactionsAlign.Start" role="img"
                                     aria-label="@(L.T("表情回应：火焰", "Reactions: fire"))">
                        <span>🔥</span>
                    </BubbleReactions>
                </Bubble>
            </div>
        </div>
        <CodeBlock Source="Components/Bubble/reactions.txt"/>
    </div>

    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("可交互的气泡内容", "Interactive Bubble Content")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    用 <code
                        class="text-xs bg-muted px-1 py-0.5 rounded">AsChild</code> 把内容渲染成链接或按钮。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Render content as anchors or buttons with <code
                        class="text-xs bg-muted px-1 py-0.5 rounded">AsChild</code>.
                </p>
                        </text>
}
        </div>
        <div class="space-y-3 rounded-lg border p-4">
            <Bubble Variant="BubbleVariant.Muted">
                <BubbleContent AsChild="BubbleContentElement.Button" @onclick="() => { }">@L.T("我忘记了密码", "I forgot my password")</BubbleContent>
            </Bubble>
            <Bubble Variant="BubbleVariant.Outline">
                <BubbleContent AsChild="BubbleContentElement.Anchor" Href="#">@L.T("打开排障指南", "Open troubleshooting guide")</BubbleContent>
            </Bubble>
        </div>
        <CodeBlock Source="Components/Bubble/interactive.txt"/>
    </div>

    <AccessibilityList>
        <AriaAttributes>
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    装饰性的表情回应行请用 <code>role="img"</code> 加一段描述性的 <code>aria-label</code>。
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    For decorative emoji reaction rows, use <code>role="img"</code> and a descriptive
                    <code>aria-label</code>.
                </AccessibilityItem>
                        </text>
}
            <AccessibilityItem>
                @L.T("可交互的气泡应当渲染成原生链接或按钮。", "Interactive bubbles should render as native links or buttons.")
            </AccessibilityItem>
            <AccessibilityItem>
                @L.T("不要只靠气泡颜色来传达含义。", "Do not rely on bubble color alone to communicate meaning.")
            </AccessibilityItem>
        </AriaAttributes>
    </AccessibilityList>

    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件的属性与参数。", "Component properties and parameters.")</p>
        </div>

        <ApiReference ComponentName="Bubble">
            <ApiParameter Name="Variant" Type="BubbleVariant" Default="Default">
                @L.T("视觉样式。可选值：Default、Secondary、Muted、Tinted、Outline、Ghost、Destructive。", "Visual style. Options: Default, Secondary, Muted, Tinted, Outline, Ghost, Destructive.")
            </ApiParameter>
            <ApiParameter Name="Align" Type="BubbleAlign" Default="Start">
                @L.T("气泡对齐方式。可选值：Start、End。", "Bubble alignment. Options: Start, End.")
            </ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                @if (L.IsChinese)
                {
                                <text>
                                    应用到根 <code>&lt;div&gt;</code> 元素的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                                </text>
}
                else
                {
                                <text>
                                    Additional HTML attributes applied to the root <code>&lt;div&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                                </text>
}
            </ApiParameter>
        </ApiReference>

        <ApiReference ComponentName="BubbleContent">
            <ApiParameter Name="AsChild" Type="BubbleContentElement" Default="Div">
                @L.T("要渲染的元素类型。可选值：Div、Anchor、Button。设置了 Href 时会自动切换为 Anchor。", "Element type to render. Options: Div, Anchor, Button. Automatically switches to Anchor when Href is set.")
            </ApiParameter>
            <ApiParameter Name="Href" Type="string?">
                @L.T("以链接形式渲染时的目标地址。", "Link target when rendering as an anchor.")
            </ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                @if (L.IsChinese)
                {
                                <text>
                                    应用到根 <code>&lt;a&gt;</code> 元素的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                                </text>
}
                else
                {
                                <text>
                                    Additional HTML attributes applied to the root <code>&lt;a&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                                </text>
}
            </ApiParameter>
        </ApiReference>

        <ApiReference ComponentName="BubbleReactions">
            <ApiParameter Name="Side" Type="BubbleReactionsSide" Default="Bottom">
                @L.T("回应行锚定的气泡边。可选值：Top、Bottom。", "Bubble edge to anchor the reactions to. Options: Top, Bottom.")
            </ApiParameter>
            <ApiParameter Name="Align" Type="BubbleReactionsAlign" Default="End">
                @L.T("沿气泡边的水平对齐。可选值：Start、End。", "Horizontal alignment along the bubble edge. Options: Start, End.")
            </ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                @if (L.IsChinese)
                {
                                <text>
                                    应用到根 <code>&lt;div&gt;</code> 元素的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                                </text>
}
                else
                {
                                <text>
                                    Additional HTML attributes applied to the root <code>&lt;div&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                                </text>
}
            </ApiParameter>
        </ApiReference>
    </section>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;
}
