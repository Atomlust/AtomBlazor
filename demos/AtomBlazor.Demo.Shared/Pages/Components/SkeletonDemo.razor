@page "/components/skeleton"
<PageTitle>@L.T("骨架屏组件 - Atom BlazorUI", "Skeleton Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">@L.T("骨架屏组件", "Skeleton Component")</h1>
        <p class="text-xl text-muted-foreground">
            @L.T("用于在内容加载时显示占位符。", "Use to show a placeholder while content is loading.")
        </p>
        </div>
    </div>

    <div class="space-y-6">
    </div>

    <!-- Basic Usage -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("基本用法", "Basic Usage")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("使用不同尺寸的简单骨架占位符。", "Simple skeleton placeholders with different dimensions.")
            </p>
        </div>
        <div class="flex flex-col space-y-3">
            <Skeleton Class="h-4 w-[250px]" />
            <Skeleton Class="h-4 w-[200px]" />
            <Skeleton Class="h-4 w-[150px]" />
        </div>
        <CodeBlock Source="Components/Skeleton/basic.txt" />
    </div>

    <!-- Shape Variants -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("形状变体", "Shape Variants")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("适用于不同内容类型的矩形（默认）与圆形。", "Rectangular (default) and circular shapes for different content types.")
            </p>
        </div>
        <div class="flex items-center gap-8">
            <div class="space-y-2">
                <p class="text-sm font-medium">@L.T("矩形", "Rectangular")</p>
                <Skeleton Shape="SkeletonShape.Rectangular" Class="h-12 w-12" />
            </div>
            <div class="space-y-2">
                <p class="text-sm font-medium">@L.T("圆形", "Circular")</p>
                <Skeleton Shape="SkeletonShape.Circular" Class="h-12 w-12" />
            </div>
        </div>
        <CodeBlock Source="Components/Skeleton/shapes.txt" />
    </div>

    <!-- Card Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("卡片加载状态", "Card Loading State")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("卡片组件的骨架占位符。", "Skeleton placeholder for a card component.")
            </p>
        </div>
        <div class="max-w-sm border rounded-lg p-6 space-y-4">
            <div class="flex items-center space-x-4">
                <Skeleton Shape="SkeletonShape.Circular" Class="h-12 w-12" />
                <div class="space-y-2 flex-1">
                    <Skeleton Class="h-4 w-[150px]" />
                    <Skeleton Class="h-4 w-[100px]" />
                </div>
            </div>
            <div class="space-y-2">
                <Skeleton Class="h-4 w-full" />
                <Skeleton Class="h-4 w-full" />
                <Skeleton Class="h-4 w-3/4" />
            </div>
        </div>
        <CodeBlock Source="Components/Skeleton/card-loading.txt" />
    </div>

    <!-- List Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("列表加载状态", "List Loading State")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("列表项的骨架占位符。", "Skeleton placeholders for list items.")
            </p>
        </div>
        <div class="max-w-md border rounded-lg divide-y">
            @for (int i = 0; i < 4; i++)
            {
                <div class="p-4 flex items-center space-x-4">
                    <Skeleton Shape="SkeletonShape.Circular" Class="h-10 w-10" />
                    <div class="space-y-2 flex-1">
                        <Skeleton Class="h-4 w-[200px]" />
                        <Skeleton Class="h-3 w-[150px]" />
                    </div>
                </div>
            }
        </div>
        <CodeBlock Source="Components/Skeleton/list-loading.txt" />
    </div>

    <!-- Avatar Variations -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("头像占位符", "Avatar Placeholders")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("用于头像加载状态的不同尺寸圆形骨架。", "Different sizes of circular skeletons for avatar loading states.")
            </p>
        </div>
        <div class="flex items-center gap-6">
            <div class="space-y-2">
                <p class="text-xs text-muted-foreground text-center">@L.T("小", "Small")</p>
                <Skeleton Shape="SkeletonShape.Circular" Class="h-8 w-8" />
            </div>
            <div class="space-y-2">
                <p class="text-xs text-muted-foreground text-center">@L.T("中", "Medium")</p>
                <Skeleton Shape="SkeletonShape.Circular" Class="h-12 w-12" />
            </div>
            <div class="space-y-2">
                <p class="text-xs text-muted-foreground text-center">@L.T("大", "Large")</p>
                <Skeleton Shape="SkeletonShape.Circular" Class="h-16 w-16" />
            </div>
            <div class="space-y-2">
                <p class="text-xs text-muted-foreground text-center">@L.T("特大", "XL")</p>
                <Skeleton Shape="SkeletonShape.Circular" Class="h-24 w-24" />
            </div>
        </div>
        <CodeBlock Source="Components/Skeleton/avatar-placeholders.txt" />
    </div>

    <!-- Profile Card Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("资料卡加载", "Profile Card Loading")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("混合多种骨架形状的复杂加载状态。", "Complex loading state with mixed skeleton shapes.")
            </p>
        </div>
        <div class="max-w-md border rounded-lg p-6 space-y-6">
            <!-- Header -->
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-4">
                    <Skeleton Shape="SkeletonShape.Circular" Class="h-16 w-16" />
                    <div class="space-y-2">
                        <Skeleton Class="h-5 w-[120px]" />
                        <Skeleton Class="h-4 w-[100px]" />
                    </div>
                </div>
                <Skeleton Class="h-8 w-20 rounded-full" />
            </div>

            <Separator />

            <!-- Stats -->
            <div class="grid grid-cols-3 gap-4">
                @for (int i = 0; i < 3; i++)
                {
                    <div class="space-y-2 text-center">
                        <Skeleton Class="h-6 w-full" />
                        <Skeleton Class="h-3 w-3/4 mx-auto" />
                    </div>
                }
            </div>

            <Separator />

            <!-- Bio -->
            <div class="space-y-2">
                <Skeleton Class="h-4 w-full" />
                <Skeleton Class="h-4 w-full" />
                <Skeleton Class="h-4 w-2/3" />
            </div>
        </div>
        <CodeBlock Source="Components/Skeleton/profile-card-loading.txt" />
    </div>

    <!-- Table Loading -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("表格加载状态", "Table Loading State")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("表格行列的骨架占位符。", "Skeleton placeholders for table rows and columns.")
            </p>
        </div>
        <div class="border rounded-lg overflow-hidden">
            <div class="border-b bg-muted/50 px-6 py-3 flex gap-4">
                <Skeleton Class="h-4 w-[150px]" />
                <Skeleton Class="h-4 w-[100px]" />
                <Skeleton Class="h-4 w-[120px]" />
                <Skeleton Class="h-4 w-[80px]" />
            </div>
            @for (int i = 0; i < 5; i++)
            {
                <div class="px-6 py-4 flex gap-4 border-b last:border-b-0">
                    <Skeleton Class="h-4 w-[150px]" />
                    <Skeleton Class="h-4 w-[100px]" />
                    <Skeleton Class="h-4 w-[120px]" />
                    <Skeleton Class="h-4 w-[80px]" />
                </div>
            }
        </div>
        <CodeBlock Source="Components/Skeleton/table-loading.txt" />
    </div>

    <!-- Form Loading -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("表单加载状态", "Form Loading State")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("表单字段的骨架占位符。", "Skeleton placeholders for form fields.")
            </p>
        </div>
        <div class="max-w-md border rounded-lg p-6 space-y-6">
            @for (int i = 0; i < 3; i++)
            {
                <div class="space-y-2">
                    <Skeleton Class="h-4 w-[100px]" />
                    <Skeleton Class="h-10 w-full" />
                </div>
            }
            <div class="flex gap-3">
                <Skeleton Class="h-10 w-24" />
                <Skeleton Class="h-10 w-24" />
            </div>
        </div>
        <CodeBlock Source="Components/Skeleton/form-loading.txt" />
    </div>

    <!-- Image Gallery Loading -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("图片库加载", "Image Gallery Loading")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("图片网格布局的骨架占位符。", "Skeleton placeholders for image grid layouts.")
            </p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            @for (int i = 0; i < 8; i++)
            {
                <Skeleton Class="h-[200px] w-full" />
            }
        </div>
        <CodeBlock Source="Components/Skeleton/image-gallery-loading.txt" />
    </div>

    <!-- Explicit Sizing -->
    <div class="space-y-4">
        <div class="space-y-2">
            <div class="flex items-center gap-2">
                <h2 class="text-2xl font-semibold">@L.T("显式尺寸", "Explicit Sizing")</h2>
                <span class="inline-flex items-center rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary ring-1 ring-inset ring-primary/20">v3</span>
            </div>
            @if (L.IsChinese)
            {
                <text>
                    <p class="text-sm text-muted-foreground">
                        通过内联样式使用 <code class="text-xs bg-muted px-1 py-0.5 rounded">Width</code> 与 <code class="text-xs bg-muted px-1 py-0.5 rounded">Height</code> 参数进行显式尺寸设置，而非 Tailwind 任意值。
                    </p>
                </text>
            }
            else
            {
                <text>
                    <p class="text-sm text-muted-foreground">
                        Use <code class="text-xs bg-muted px-1 py-0.5 rounded">Width</code> and <code class="text-xs bg-muted px-1 py-0.5 rounded">Height</code> parameters for explicit sizing via inline styles instead of Tailwind arbitrary values.
                    </p>
                </text>
            }
        </div>
        <div class="flex flex-col space-y-3">
            <Skeleton Width="250px" Height="20px" />
            <Skeleton Width="200px" Height="20px" />
            <Skeleton Width="50%" Height="100px" />
            <Skeleton Shape="SkeletonShape.Circular" Width="64px" Height="64px" />
        </div>
        <CodeBlock Source="Components/Skeleton/explicit-sizing.txt" />
    </div>

    <!-- Custom Styling -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("自定义样式", "Custom Styling")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("使用 Class 参数覆盖样式以实现不同效果。", "Override styles with the Class parameter for different effects.")
            </p>
        </div>
        <div class="flex flex-col space-y-4">
            <Skeleton Class="h-32 w-full rounded-xl" />
            <Skeleton Class="h-4 w-full rounded-none" />
            <Skeleton Shape="SkeletonShape.Circular" Class="h-20 w-20" />
        </div>
        <CodeBlock Source="Components/Skeleton/custom-styling.txt" />
    </div>

    <!-- Best Practices -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("最佳实践", "Best Practices")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("有效使用骨架加载状态的准则。", "Guidelines for using skeleton loading states effectively.")
            </p>
        </div>
        <div class="border rounded-lg p-6 space-y-3 bg-muted/50">
            @if (L.IsChinese)
            {
                <text>
                    <p class="text-sm">
                        ✓ <strong>匹配内容尺寸：</strong> 骨架应近似实际内容的大小。
                    </p>
                </text>
            }
            else
            {
                <text>
                    <p class="text-sm">
                        ✓ <strong>Match content dimensions:</strong> Skeleton should approximate the size of the actual content.
                    </p>
                </text>
            }
            @if (L.IsChinese)
            {
                <text>
                    <p class="text-sm">
                        ✓ <strong>使用合适的形状：</strong> 头像用圆形，文本与图片用矩形。
                    </p>
                </text>
            }
            else
            {
                <text>
                    <p class="text-sm">
                        ✓ <strong>Use appropriate shapes:</strong> Circular for avatars, rectangular for text and images.
                    </p>
                </text>
            }
            @if (L.IsChinese)
            {
                <text>
                    <p class="text-sm">
                        ✓ <strong>保持布局稳定：</strong> 使用与内容结构相匹配的骨架占位符，防止布局抖动。
                    </p>
                </text>
            }
            else
            {
                <text>
                    <p class="text-sm">
                        ✓ <strong>Maintain layout:</strong> Prevent layout shifts by using skeleton placeholders that match content structure.
                    </p>
                </text>
            }
            @if (L.IsChinese)
            {
                <text>
                    <p class="text-sm">
                        ✓ <strong>渐进式展示：</strong> 仅对加载缓慢的内容（&gt;300ms）显示骨架。
                    </p>
                </text>
            }
            else
            {
                <text>
                    <p class="text-sm">
                        ✓ <strong>Progressive disclosure:</strong> Show skeletons only for slow-loading content (>300ms).
                    </p>
                </text>
            }
            @if (L.IsChinese)
            {
                <text>
                    <p class="text-sm">
                        ✓ <strong>保持简洁：</strong> 避免过于复杂、会分散用户注意力的骨架模式。
                    </p>
                </text>
            }
            else
            {
                <text>
                    <p class="text-sm">
                        ✓ <strong>Keep it simple:</strong> Avoid overly complex skeleton patterns that distract users.
                    </p>
                </text>
            }
        </div>
    </div>

    <!-- API Reference -->


    <!-- Accessibility Notes -->

    <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>
                @L.T("纯装饰性的加载占位符——无需任何 ARIA 角色或属性", "Purely decorative loading placeholder — no ARIA roles or attributes are needed")
            </AccessibilityItem>
            @if (L.IsChinese)
            {
                <text>
                    <AccessibilityItem>
                        考虑在加载期间用一个带有 <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-busy="true"</code> 的容器包裹成组的骨架，内容加载后再移除
                    </AccessibilityItem>
                </text>
            }
            else
            {
                <text>
                    <AccessibilityItem>
                        Consider wrapping skeleton groups in a container with <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-busy="true"</code> while loading, then removing it when content loads
                    </AccessibilityItem>
                </text>
            }
        </AriaAttributes>
    </AccessibilityList>

    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件属性与参数。", "Component properties and parameters.")</p>
        </div>

        <div class="space-y-4">
            <ApiReference ComponentName="Skeleton">
                <ApiParameter Name="Shape" Type="SkeletonShape" Default="Rectangular">
                    @L.T("骨架屏的形状变体。可选项：Rectangular (rounded-md)、Circular (rounded-full)。", "The shape variant of the skeleton. Options: Rectangular (rounded-md), Circular (rounded-full).")
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?">
                    @L.T("要应用到骨架元素的额外 CSS 类。使用 Tailwind 工具类设置宽度、高度与间距。", "Additional CSS classes to apply to the skeleton element. Use Tailwind utilities for width, height, and spacing.")
                </ApiParameter>
                <ApiParameter Name="Width" Type="string?">
                    @L.T("以内联样式应用的显式宽度（例如 \"200px\"、\"50%\"）。", "Explicit width applied as an inline style (e.g., \"200px\", \"50%\").")
                </ApiParameter>
                <ApiParameter Name="Height" Type="string?">
                    @L.T("以内联样式应用的显式高度（例如 \"20px\"、\"2rem\"）。", "Explicit height applied as an inline style (e.g., \"20px\", \"2rem\").")
                </ApiParameter>
                @if (L.IsChinese)
                {
                    <text>
                        <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                            应用到根 <code>&lt;div&gt;</code> 元素的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                        </ApiParameter>
                    </text>
                }
                else
                {
                    <text>
                        <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                            Additional HTML attributes applied to the root <code>&lt;div&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                        </ApiParameter>
                    </text>
                }
            </ApiReference>
        </div>
    </section>

</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;
}
