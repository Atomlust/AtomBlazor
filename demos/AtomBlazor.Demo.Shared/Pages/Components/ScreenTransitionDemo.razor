@page "/components/screen-transition"
@using AtomBlazor.Icons.Lucide

<PageTitle>@L.T("Screen Transition 转场 - Atom BlazorUI", "Screen Transition - Atom BlazorUI")</PageTitle>
<div class="max-w-4xl space-y-8">
    <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">@L.T("Screen Transition 转场", "Screen Transition")</h1>
        <p class="text-xl text-muted-foreground">@L.T("当应用自有的屏幕键变化时，为进入的内容播放动画。", "Animate incoming content when an application-owned screen key changes.")</p>
    </div>
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("切换屏幕", "Switch screens")</h2>
        <div class="rounded-lg border p-6 space-y-4">
<div class="flex flex-wrap gap-2" role="group" aria-label="@(L.T("预览屏幕", "Preview screen"))">
    @foreach (var name in new[] { "Overview", "Activity", "Settings" })
    {
        <Button Variant="@(screen == name ? ButtonVariant.Default : ButtonVariant.Outline)" aria-pressed="@((screen == name).ToString().ToLowerInvariant())" OnClick="@(() => screen = name)">@name</Button>
    }
</div>
<ScreenTransition TransitionKey="screen" Preset="MotionPreset.SlideUp">
    <div class="rounded-lg bg-muted p-6 space-y-2">
        <h3 class="font-semibold">@screen</h3>
        @if (screen == "Overview") { <p>@L.T("12 个项目进行中 · 4 个里程碑本周到期。", "12 projects active · 4 milestones due this week.")</p> }
        else if (screen == "Activity") { <p>@L.T("Alex 上传了设计评审。Sam 完成了发布检查清单。", "Alex uploaded the design review. Sam completed the release checklist.")</p> }
        else { <p>@L.T("通知已启用。你的工作区对团队成员可见。", "Notifications are enabled. Your workspace is visible to team members.")</p> }
    </div>
</ScreenTransition>
        </div>
        <CodeBlock Source="Components/ScreenTransition/basic.txt" />
    </section>
    <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>@L.T("外层容器尊重减弱动效设置。它不管理焦点，也不播报屏幕切换。", "The wrapper respects reduced motion. It does not manage focus or announce a screen change.")</AccessibilityItem>
            <AccessibilityItem>@L.T("为每个屏幕提供有意义的标题，并在应用需要时自行管理焦点或状态播报。", "Give each screen meaningful headings and manage focus or status announcements where the application requires them.")</AccessibilityItem>
        </AriaAttributes>
        <KeyboardNavigation>
            <KeyboardShortcutItem Description="@(L.T("在可交互控件之间移动", "Move between interactive controls"))"><Kbd>Tab / Shift + Tab</Kbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("激活获得焦点的按钮", "Activate a focused button"))"><Kbd>Enter / Space</Kbd></KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
<ApiReference Since="v4" ComponentName="ScreenTransition"><ApiParameter Name="TransitionKey / Preset / Distance" Type="object? / MotionPreset / double" Default="null / Fade / 24">@L.T("键发生变化即触发进入动画。Distance 以像素计。当子内容状态也需要重置时请使用 Blazor @key；离开的内容不会被保留。", "A changed key triggers the incoming animation. Distance is in pixels. Use Blazor @key when child state should also reset; outgoing content is not retained.")</ApiParameter><ApiParameter Name="Duration / Enabled / Class / ChildContent" Type="int / bool / string? / RenderFragment?" Default="250 / true / null / null">@L.T("动画时长（毫秒）、启用开关、外层样式与进入的内容。首次可交互渲染不播放动画。", "Animation duration in milliseconds, enablement, wrapper styles and incoming content. The first interactive render does not animate.")</ApiParameter></ApiReference>
    </section>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    private string screen = "Overview";
}
