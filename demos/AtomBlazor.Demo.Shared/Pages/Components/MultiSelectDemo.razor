@page "/components/multiselect"
<PageTitle>@L.T("Multi Select 多选组件 - Atom BlazorUI", "Multi Select Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <div class="flex items-center gap-3">
                <h1 class="text-4xl font-bold tracking-tight">@L.T("Multi Select 多选组件", "Multi Select Component")</h1>
                <span class="inline-flex items-center rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary ring-1 ring-inset ring-primary/20">v3</span>
            </div>
            <p class="text-xl text-muted-foreground">
                @L.T("带复选标记与标签展示的可搜索多选组件，支持选择多个选项。",
                     "A searchable multi-select component that allows selecting multiple options with checkbox indicators and tag display.")
            </p>
        </div>
    </div>

    <!-- Basic MultiSelect -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("基础多选", "Basic Multi Select")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("选择多门编程语言。已选项会以标签形式显示。",
                 "Select multiple programming languages. Selected items appear as tags.")
        </p>

        <div class="flex flex-col gap-2">
            <MultiSelect Required="true" AriaLabel="@(L.T("选择选项", "Choose options"))" TValue="string"
                        Options="languages"
                        @bind-Values="selectedLanguages"
                        Placeholder="@(L.T("选择语言……", "Select languages..."))"
                        SearchPlaceholder="@(L.T("搜索语言……", "Search languages..."))"
                        EmptyMessage="@(L.T("未找到语言。", "No language found."))"
                        PopoverWidth="w-[300px]" />
            <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
                <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected values:")</span> <span class="font-mono">@(selectedLanguages?.Any() == true ? string.Join(", ", selectedLanguages) : L.T("（无）", "(none)"))</span></p>
                <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(selectedLanguages?.Any() == true ? string.Join(", ", languages.GetTexts(selectedLanguages)) : L.T("（无）", "(none)"))</p>
            </div>
        </div>

        <CodeBlock Source="Components/MultiSelect/basic.txt" />
    </section>

    <!-- Tech Stack Example -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("技术栈选择器", "Tech Stack Selector")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("选择你的技术栈。使用 \"Select All\" 全选功能。",
                 "Select your tech stack. Uses \"Select All\" functionality.")
        </p>

        <div class="flex flex-col gap-2">
            <MultiSelect TValue="string"
                        Options="technologies"
                        @bind-Values="selectedTechnologies"
                        Placeholder="@(L.T("选择技术栈……", "Select technologies..."))"
                        SearchPlaceholder="@(L.T("搜索……", "Search..."))"
                        ShowSelectAll="true"
                        SelectAllLabel="@(L.T("全选", "Select All"))"
                        MaxDisplayTags="3"
                        PopoverWidth="w-[320px]" />
            <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
                <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected values:")</span> <span class="font-mono">@(selectedTechnologies?.Any() == true ? string.Join(", ", selectedTechnologies) : L.T("（无）", "(none)"))</span></p>
                <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(selectedTechnologies?.Any() == true ? string.Join(", ", technologies.GetTexts(selectedTechnologies)) : L.T("（无）", "(none)"))</p>
            </div>
        </div>

        <CodeBlock Source="Components/MultiSelect/tech-stack.txt" />
    </section>

    <!-- Country Selector -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("国家选择器", "Country Selector")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("选择国家，带溢出指示（+N more）。",
                 "Select countries with overflow indicator (+N more).")
        </p>

        <div class="flex flex-col gap-2">
            <MultiSelect TValue="string"
                        Options="countries"
                        @bind-Values="selectedCountries"
                        Placeholder="@(L.T("选择国家……", "Select countries..."))"
                        SearchPlaceholder="@(L.T("搜索国家……", "Search country..."))"
                        MaxDisplayTags="2"
                        ShowSelectAll="true"
                        PopoverWidth="w-[280px]" />
            <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
                <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected values:")</span> <span class="font-mono">@(selectedCountries?.Any() == true ? string.Join(", ", selectedCountries) : L.T("（无）", "(none)"))</span></p>
                <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(selectedCountries?.Any() == true ? string.Join(", ", countries.GetTexts(selectedCountries)) : L.T("（无）", "(none)"))</p>
            </div>
        </div>

        <CodeBlock Source="Components/MultiSelect/country.txt" />
    </section>

    <!-- Single Line -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("单行模式", "Single Line")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                默认情况下，触发器会把标签换行到更多行并自动增高。设置
                <code>SingleLine="true"</code> 可保持单行固定高度——溢出的标签会被裁切，
                而“+N more”指示器与箭头图标保持固定可见。下方两个控件共享同一份选择。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                By default the trigger wraps tags onto additional rows and grows to fit. Set
                <code>SingleLine="true"</code> to keep it one row at a fixed height — overflowing tags are
                clipped while the "+N more" indicator and chevron stay pinned and visible. Both controls
                below share the same selection.
            </p>
                </text>
}

        <div class="grid gap-4 sm:grid-cols-2">
            <div class="flex flex-col gap-2">
                @if (L.IsChinese)
                {
                                <text>
                                    <span class="text-xs font-medium text-muted-foreground">默认（换行并增高）</span>
                                </text>
}
                else
                {
                                <text>
                                    <span class="text-xs font-medium text-muted-foreground">Default (wraps &amp; grows)</span>
                                </text>
}
                <MultiSelect TValue="string"
                            Options="technologies"
                            @bind-Values="singleLineValues"
                            Placeholder="@(L.T("选择技术栈……", "Select technologies..."))"
                            MaxDisplayTags="3"
                            PopoverWidth="w-[240px]" />
            </div>
            <div class="flex flex-col gap-2">
                <span class="text-xs font-medium text-muted-foreground">SingleLine="true"</span>
                <MultiSelect TValue="string"
                            Options="technologies"
                            @bind-Values="singleLineValues"
                            Placeholder="@(L.T("选择技术栈……", "Select technologies..."))"
                            MaxDisplayTags="3"
                            SingleLine="true"
                            PopoverWidth="w-[240px]" />
            </div>
        </div>

        <CodeBlock Source="Components/MultiSelect/single-line.txt" />
    </section>

    <!-- Non-String Value Types -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("非字符串值类型", "Non-String Value Types")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                MultiSelect 支持非字符串值类型。这里使用 <code class="bg-muted px-1 py-0.5 rounded text-sm">SelectOption&lt;int&gt;</code> 承载权限 ID。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                MultiSelect supports non-string value types. Here, <code class="bg-muted px-1 py-0.5 rounded text-sm">SelectOption&lt;int&gt;</code> is used with permission IDs.
            </p>
                </text>
}

        <div class="flex flex-col gap-2">
            <MultiSelect TValue="int"
                        Options="permissions"
                        @bind-Values="selectedPermissions"
                        Placeholder="@(L.T("选择权限……", "Select permissions..."))"
                        SearchPlaceholder="@(L.T("搜索权限……", "Search permissions..."))"
                        ShowSelectAll="true"
                        PopoverWidth="w-[300px]" />
            <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
                <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected values:")</span> <span class="font-mono">@(selectedPermissions?.Any() == true ? string.Join(", ", selectedPermissions) : L.T("（无）", "(none)"))</span></p>
                <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(selectedPermissions?.Any() == true ? string.Join(", ", permissions.GetTexts(selectedPermissions)) : L.T("（无）", "(none)"))</p>
            </div>
        </div>

        <CodeBlock Source="Components/MultiSelect/non-string-values.txt" />
    </section>

    <!-- Guid Values -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("Guid 值", "Guid Values")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                使用 <code class="bg-muted px-1 py-0.5 rounded text-sm">SelectOption&lt;Guid&gt;</code> 的 MultiSelect，面向以唯一标识符建模的实体选择场景。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                MultiSelect with <code class="bg-muted px-1 py-0.5 rounded text-sm">SelectOption&lt;Guid&gt;</code> for entity-based selections using unique identifiers.
            </p>
                </text>
}

        <div class="flex flex-col gap-2">
            <MultiSelect TValue="Guid"
                        Options="projects"
                        @bind-Values="selectedProjects"
                        Placeholder="@(L.T("选择项目……", "Select projects..."))"
                        SearchPlaceholder="@(L.T("搜索项目……", "Search projects..."))"
                        PopoverWidth="w-[300px]" />
            <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
                <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected values:")</span> <span class="font-mono">@(selectedProjects?.Any() == true ? string.Join(", ", selectedProjects) : L.T("（无）", "(none)"))</span></p>
                <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(selectedProjects?.Any() == true ? string.Join(", ", projects.GetTexts(selectedProjects)) : L.T("（无）", "(none)"))</p>
            </div>
        </div>

        <CodeBlock Source="Components/MultiSelect/guid-values.txt" />
    </section>

    <!-- Without Select All -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("不带全选", "Without Select All")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("不含 \"Select All\" 全选选项的多选框。",
                 "Multi Select without the \"Select All\" option.")
        </p>

        <div class="flex flex-col gap-2">
            <MultiSelect TValue="string"
                        Options="frameworks"
                        @bind-Values="selectedFrameworks"
                        Placeholder="@(L.T("选择框架……", "Select frameworks..."))"
                        SearchPlaceholder="@(L.T("搜索……", "Search..."))"
                        ShowSelectAll="false"
                        PopoverWidth="w-[250px]" />
            <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
                <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected values:")</span> <span class="font-mono">@(selectedFrameworks?.Any() == true ? string.Join(", ", selectedFrameworks) : L.T("（无）", "(none)"))</span></p>
                <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(selectedFrameworks?.Any() == true ? string.Join(", ", frameworks.GetTexts(selectedFrameworks)) : L.T("（无）", "(none)"))</p>
            </div>
        </div>

        <CodeBlock Source="Components/MultiSelect/without-select-all.txt" />
    </section>

    <!-- Prevent Auto Close -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("阻止自动关闭", "Prevent Auto Close")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                设置 <code class="bg-muted px-1 py-0.5 rounded text-sm">AutoClose="false"</code> 后，点击外部时下拉面板保持打开。
                使用关闭按钮或按 Escape 键将其关闭。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                With <code class="bg-muted px-1 py-0.5 rounded text-sm">AutoClose="false"</code>, the dropdown stays open when you click outside.
                Use the Close button or press Escape to close it.
            </p>
                </text>
}

        <div class="flex flex-col gap-2">
            <MultiSelect TValue="string"
                        Options="frameworks"
                        @bind-Values="autoCloseFrameworks"
                        Placeholder="@(L.T("选择框架……", "Select frameworks..."))"
                        SearchPlaceholder="@(L.T("搜索……", "Search..."))"
                        AutoClose="false"
                        PopoverWidth="w-[280px]" />
            <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
                <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected values:")</span> <span class="font-mono">@(autoCloseFrameworks?.Any() == true ? string.Join(", ", autoCloseFrameworks) : L.T("（无）", "(none)"))</span></p>
                <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(autoCloseFrameworks?.Any() == true ? string.Join(", ", frameworks.GetTexts(autoCloseFrameworks)) : L.T("（无）", "(none)"))</p>
            </div>
        </div>

        <CodeBlock Source="Components/MultiSelect/prevent-auto-close.txt" />
    </section>

    <!-- Match Trigger Width -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("匹配触发器宽度", "Match Trigger Width")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                设置 <code class="bg-muted px-1 py-0.5 rounded text-sm">MatchTriggerWidth="true"</code> 后，
                下拉面板会自动匹配触发器元素的宽度。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                With <code class="bg-muted px-1 py-0.5 rounded text-sm">MatchTriggerWidth="true"</code>,
                the dropdown automatically matches the width of the trigger element.
            </p>
                </text>
}

        <div class="flex flex-col gap-4">
            <div class="w-72">
                <label class="text-sm font-medium mb-2 block">@L.T("固定宽度容器（w-72）", "Fixed width container (w-72)")</label>
                <MultiSelect TValue="string"
                            Options="languages"
                            @bind-Values="matchWidthLanguages"
                            Placeholder="@(L.T("选择语言……", "Select languages..."))"
                            SearchPlaceholder="@(L.T("搜索……", "Search..."))"
                            MatchTriggerWidth="true"
                            Class="w-full" />
            </div>

            <div class="w-[500px]">
                <label class="text-sm font-medium mb-2 block">@L.T("更宽的容器（500px）", "Wider container (500px)")</label>
                <MultiSelect TValue="string"
                            Options="technologies"
                            @bind-Values="matchWidthTechnologies"
                            Placeholder="@(L.T("选择技术栈……", "Select technologies..."))"
                            SearchPlaceholder="@(L.T("搜索……", "Search..."))"
                            ShowSelectAll="true"
                            MatchTriggerWidth="true"
                            Class="w-full" />
            </div>
        </div>

        <CodeBlock Source="Components/MultiSelect/match-trigger-width.txt" />
    </section>

    <!-- Disabled State -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("禁用状态", "Disabled State")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("处于禁用状态的多选框，已带有预选值。",
                 "Multi Select in disabled state with pre-selected values.")
        </p>

        <MultiSelect TValue="string"
                    Options="languages"
                    Values="@disabledValues"
                    Placeholder="@(L.T("已禁用的多选框", "Disabled multiselect"))"
                    Disabled="true"
                    PopoverWidth="w-[300px]" />

        <CodeBlock Source="Components/MultiSelect/disabled.txt" />
    </section>

    <!-- Form Example -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("表单集成", "Form Integration")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("在多选框用于表单布局的示例。",
                 "Example of Multi Select in a form layout.")
        </p>

        <div class="space-y-4 max-w-md border rounded-lg p-6">
            <div class="space-y-2">
                <label class="text-sm font-medium">@L.T("技能", "Skills")</label>
                <MultiSelect TValue="string"
                            Options="languages"
                            @bind-Values="formSkills"
                            Placeholder="@(L.T("选择你的技能……", "Select your skills..."))"
                            SearchPlaceholder="@(L.T("搜索技能……", "Search skills..."))"
                            ShowSelectAll="true"
                            MatchTriggerWidth="true" />
                <p class="text-xs text-muted-foreground">@L.T("选择你会的所有编程语言。", "Select all programming languages you know.")</p>
            </div>

            <div class="space-y-2">
                <label class="text-sm font-medium">@L.T("首选框架", "Preferred Frameworks")</label>
                <MultiSelect TValue="string"
                            Options="frameworks"
                            @bind-Values="formFrameworks"
                            Placeholder="@(L.T("选择框架……", "Select frameworks..."))"
                            SearchPlaceholder="@(L.T("搜索框架……", "Search frameworks..."))"
                            MaxDisplayTags="2"
                            MatchTriggerWidth="true" />
                <p class="text-xs text-muted-foreground">@L.T("选择你偏好的框架。", "Choose your preferred frameworks.")</p>
            </div>

            <div class="pt-4 border-t">
                <Button Variant="ButtonVariant.Default" OnClick="HandleFormSubmit">
                    @L.T("提交", "Submit")
                </Button>
                @if (formSubmitted)
                {
                    <div class="text-sm text-green-600 mt-2 space-y-1">
                        <p>@L.T("表单已提交！", "Form submitted!")</p>
                        <p><span class="font-medium">@L.T("技能值：", "Skills values:")</span> <span class="font-mono">@(formSkills?.Any() == true ? string.Join(", ", formSkills) : L.T("无", "None"))</span></p>
                        <p><span class="font-medium">@L.T("技能文本：", "Skills text:")</span> @(formSkills?.Any() == true ? string.Join(", ", languages.GetTexts(formSkills)) : L.T("无", "None"))</p>
                        <p><span class="font-medium">@L.T("框架值：", "Frameworks values:")</span> <span class="font-mono">@(formFrameworks?.Any() == true ? string.Join(", ", formFrameworks) : L.T("无", "None"))</span></p>
                        <p><span class="font-medium">@L.T("框架文本：", "Frameworks text:")</span> @(formFrameworks?.Any() == true ? string.Join(", ", frameworks.GetTexts(formFrameworks)) : L.T("无", "None"))</p>
                    </div>
                }
            </div>
        </div>

        <CodeBlock Source="Components/MultiSelect/form-integration.txt" />
    </section>

    <!-- Compositional Mode -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("组合模式", "Compositional Mode")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                需要完全控制条目渲染时，使用 <code class="bg-muted px-1 py-0.5 rounded text-sm">MultiSelectItem</code> 子内容
                替代 <code class="bg-muted px-1 py-0.5 rounded text-sm">Options</code> 参数。
                搜索、键盘导航、全选与复选标记的行为完全一致。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                For full control over item rendering, use <code class="bg-muted px-1 py-0.5 rounded text-sm">MultiSelectItem</code> children
                instead of the <code class="bg-muted px-1 py-0.5 rounded text-sm">Options</code> parameter.
                Search, keyboard navigation, Select All, and checkbox indicators work identically.
            </p>
                </text>
}

        <div class="flex flex-col gap-2">
            <MultiSelect TValue="string"
                        @bind-Values="compositionalValues"
                        Placeholder="@(L.T("选择权限……", "Select permissions..."))"
                        SearchPlaceholder="@(L.T("搜索……", "Search..."))"
                        ShowSelectAll="true"
                        SelectAllLabel="@(L.T("全选", "Select All"))"
                        PopoverWidth="w-[300px]">
                <MultiSelectItem Value="@("read")" Text="Read">
                    <div class="flex items-center gap-2">
                        <span class="inline-block h-2 w-2 rounded-full bg-green-500"></span>
                        Read
                    </div>
                </MultiSelectItem>
                <MultiSelectItem Value="@("write")" Text="Write">
                    <div class="flex items-center gap-2">
                        <span class="inline-block h-2 w-2 rounded-full bg-yellow-500"></span>
                        Write
                    </div>
                </MultiSelectItem>
                <MultiSelectItem Value="@("delete")" Text="Delete">
                    <div class="flex items-center gap-2">
                        <span class="inline-block h-2 w-2 rounded-full bg-red-500"></span>
                        Delete
                    </div>
                </MultiSelectItem>
                <MultiSelectItem Value="@("admin")" Text="Admin">
                    <div class="flex items-center gap-2">
                        <span class="inline-block h-2 w-2 rounded-full bg-purple-500"></span>
                        Admin
                    </div>
                </MultiSelectItem>
            </MultiSelect>
            <div class="rounded-lg border p-4 bg-muted/50 space-y-1">
                <p class="text-sm"><span class="font-medium">@L.T("选中值：", "Selected values:")</span> <span class="font-mono">@(compositionalValues?.Any() == true ? string.Join(", ", compositionalValues) : L.T("（无）", "(none)"))</span></p>
                <p class="text-sm"><span class="font-medium">@L.T("选中文本：", "Selected text:")</span> @(compositionalValues?.Any() == true ? string.Join(", ", compositionalValues.Select(GetCompositionalLabel)) : L.T("（无）", "(none)"))</p>
            </div>
        </div>

        <CodeBlock Source="Components/MultiSelect/compositional.txt" />
    </section>

    <!-- Infinite Scroll -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("无限滚动", "Infinite Scroll")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                使用 <code class="bg-muted px-1 py-0.5 rounded text-sm">OnLoadMore</code> 与
                <code class="bg-muted px-1 py-0.5 rounded text-sm">IsLoading</code> 分批加载条目。
                本示例包含 100 个带国旗的国家，每次加载 20 个。
