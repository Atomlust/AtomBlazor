@page "/components/timeline"

<PageTitle>@L.T("Timeline 时间线 - Atom BlazorUI", "Timeline Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("Timeline 时间线", "Timeline Component")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("以垂直时间线的形式展示事件，包含图标、连接线与内容。", "Displays a vertical timeline of events with icons, connectors, and content.")
            </p>
        </div>
    </div>

    <!-- Default -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("默认样式", "Default")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("基础时间线，每个条目都包含标题、说明与日期。", "A basic timeline with title, description, and date for each item.")
            </p>
        </div>
        <div class="border rounded-lg p-6">
            <Timeline>
                <TimelineItem>
                    <TimeContent>
                        <TimelineTime Class="text-right pr-4">@L.T("2024 年 1 月", "Jan 2024")</TimelineTime>
                    </TimeContent>
                    <ChildContent>
                        <TimelineContent>
                            <TimelineHeader>
                                <TimelineTitle>@L.T("项目启动", "Project Kickoff")</TimelineTitle>
                            </TimelineHeader>
                            <TimelineDescription>@L.T("为新产品的发布做初步规划并组建团队。", "Initial planning and team formation for the new product launch.")</TimelineDescription>
                        </TimelineContent>
                    </ChildContent>
                </TimelineItem>

                <TimelineItem>
                    <TimeContent>
                        <TimelineTime Class="text-right pr-4">@L.T("2024 年 3 月", "Mar 2024")</TimelineTime>
                    </TimeContent>
                    <ChildContent>
                        <TimelineContent>
                            <TimelineHeader>
                                <TimelineTitle>@L.T("设计阶段", "Design Phase")</TimelineTitle>
                            </TimelineHeader>
                            <TimelineDescription>@L.T("完成了所有核心功能的线框图与设计系统。", "Completed wireframes and design system for all core features.")</TimelineDescription>
                        </TimelineContent>
                    </ChildContent>
                </TimelineItem>

                <TimelineItem ShowConnector="false">
                    <TimeContent>
                        <TimelineTime Class="text-right pr-4">@L.T("2024 年 6 月", "Jun 2024")</TimelineTime>
                    </TimeContent>
                    <ChildContent>
                        <TimelineContent>
                            <TimelineHeader>
                                <TimelineTitle>@L.T("Beta 发布", "Beta Release")</TimelineTitle>
                            </TimelineHeader>
                            <TimelineDescription>@L.T("向早期采用者发布 Beta 版本以收集反馈。", "Launched beta version to early adopters for feedback.")</TimelineDescription>
                        </TimelineContent>
                    </ChildContent>
                </TimelineItem>
            </Timeline>
        </div>
        <CodeBlock Source="Components/Timeline/default.txt" />
    </div>

    <!-- Shorthand -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("简写形式", "Shorthand")</h2>
            @if (L.IsChinese)
            {
                <text>
                    <p class="text-sm text-muted-foreground">
                        简单条目可直接使用 <code class="bg-muted px-1 py-0.5 rounded">Title</code>、<code class="bg-muted px-1 py-0.5 rounded">Time</code> 与 <code class="bg-muted px-1 py-0.5 rounded">Description</code> 参数，无需组合子组件。
                    </p>
                </text>
            }
            else
            {
                <text>
                    <p class="text-sm text-muted-foreground">
                        Use <code class="bg-muted px-1 py-0.5 rounded">Title</code>, <code class="bg-muted px-1 py-0.5 rounded">Time</code>, and <code class="bg-muted px-1 py-0.5 rounded">Description</code> parameters for simple entries without composing sub-components.
                    </p>
                </text>
            }
        </div>
        <div class="border rounded-lg p-6">
            <Timeline>
                <TimelineItem Title="@(L.T("项目启动", "Project Kickoff"))" Time="@(L.T("2024 年 1 月", "Jan 2024"))" Description="@(L.T("为新产品的发布做初步规划并组建团队。", "Initial planning and team formation for the new product launch."))" />
                <TimelineItem Title="@(L.T("设计阶段", "Design Phase"))" Time="@(L.T("2024 年 3 月", "Mar 2024"))" Description="@(L.T("完成了所有核心功能的线框图与设计系统。", "Completed wireframes and design system for all core features."))" />
                <TimelineItem Title="@(L.T("Beta 发布", "Beta Release"))" Time="@(L.T("2024 年 6 月", "Jun 2024"))" Description="@(L.T("向早期采用者发布 Beta 版本以收集反馈。", "Launched beta version to early adopters for feedback."))" ShowConnector="false" />
            </Timeline>
        </div>
        <CodeBlock Source="Components/Timeline/shorthand.txt" />
    </div>

    <!-- Heading Levels & Composition -->
    <div class="space-y-4">
        <div class="space-y-2">
            @if (L.IsChinese)
            {
                <text>
                    <h2 class="text-2xl font-semibold">标题级别与组合</h2>
                </text>
            }
            else
            {
                <text>
                    <h2 class="text-2xl font-semibold">Heading Levels &amp; Composition</h2>
                </text>
            }
            @if (L.IsChinese)
            {
                <text>
                    <p class="text-sm text-muted-foreground">
                        在 <code class="bg-muted px-1 py-0.5 rounded">TimelineTitle</code> 上使用 <code class="bg-muted px-1 py-0.5 rounded">As</code> 参数可控制标题元素，组合子组件则能搭建带副标题的丰富标题区域。
                    </p>
                </text>
            }
            else
            {
                <text>
                    <p class="text-sm text-muted-foreground">
                        Use the <code class="bg-muted px-1 py-0.5 rounded">As</code> parameter on <code class="bg-muted px-1 py-0.5 rounded">TimelineTitle</code> to control the heading element, and compose sub-components for rich title areas with subtitles.
                    </p>
                </text>
            }
        </div>
        <div class="border rounded-lg p-6">
            <Timeline Align="TimelineAlign.Left">
                @* Simple heading level override *@
                <TimelineItem Status="TimelineStatus.Completed">
                    <IconContent>
                        <TimelineIcon Color="TimelineColor.Primary">
                            <LucideIcon Name="rocket" Size="16" />
                        </TimelineIcon>
                    </IconContent>
                    <ChildContent>
                        <TimelineContent>
                            <TimelineHeader>
                                <TimelineTitle As="h4">@L.T("项目启动", "Project Kickoff")</TimelineTitle>
                            </TimelineHeader>
                            <TimelineDescription>@L.T("为新产品的发布做初步规划并组建团队。", "Initial planning and team formation for the new product launch.")</TimelineDescription>
                        </TimelineContent>
                    </ChildContent>
                </TimelineItem>

                @* Title + subtitle composition *@
                <TimelineItem Status="TimelineStatus.Completed">
                    <IconContent>
                        <TimelineIcon Color="TimelineColor.Primary">
                            <LucideIcon Name="git-merge" Size="16" />
                        </TimelineIcon>
                    </IconContent>
                    <ChildContent>
                        <TimelineContent>
                            <div class="flex flex-col">
                                <TimelineTitle As="h4">@L.T("设计阶段完成", "Design Phase Complete")</TimelineTitle>
                                <TypographyMuted>@L.T("由 Matthew Taylor 评审", "Reviewed by Matthew Taylor")</TypographyMuted>
                            </div>
                            <TimelineDescription>@L.T("完成了所有核心功能的线框图与设计系统。", "Completed wireframes and design system for all core features.")</TimelineDescription>
                        </TimelineContent>
                    </ChildContent>
                </TimelineItem>

                @* Multi-line subtitle with additional context *@
                <TimelineItem Status="TimelineStatus.InProgress" ShowConnector="false">
                    <IconContent>
                        <TimelineIcon Color="TimelineColor.Accent">
                            <LucideIcon Name="code" Size="16" />
                        </TimelineIcon>
                    </IconContent>
                    <ChildContent>
                        <TimelineContent>
                            <div class="flex flex-col">
                                <TimelineTitle As="h4">@L.T("开发冲刺第 3 轮", "Development Sprint 3")</TimelineTitle>
                                <div class="flex items-center gap-2">
                                    <TypographyMuted>@L.T("已分配给前端团队", "Assigned to frontend team")</TypographyMuted>
                                    <Badge Variant="BadgeVariant.Outline" Class="text-xs">@L.T("进行中", "In Progress")</Badge>
                                </div>
                            </div>
                            <TimelineDescription>@L.T("为仪表盘模块构建并测试核心功能。", "Building and testing core features for the dashboard module.")</TimelineDescription>
                        </TimelineContent>
                    </ChildContent>
                </TimelineItem>
            </Timeline>
        </div>
        <CodeBlock Source="Components/Timeline/heading-composition.txt" />
    </div>

    <!-- Rich Content -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("富内容", "Rich Content")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("当内容较高（例如卡片、图片或详细说明）时，连接线会自动拉伸以适配高度。", "Connector lines dynamically stretch to match the height of large content such as cards, images, or detailed descriptions.")
            </p>
        </div>
        <div class="border rounded-lg p-6">
            <Timeline Align="TimelineAlign.Left">
                <TimelineItem Status="TimelineStatus.Completed">
                    <IconContent>
                        <TimelineIcon Color="TimelineColor.Primary">
                            <LucideIcon Name="check" Size="16" />
                        </TimelineIcon>
                    </IconContent>
                    <ChildContent>
                        <div class="border rounded-lg shadow-sm overflow-hidden">
                            <div class="p-4 space-y-3">
                                <div>
                                    <h3 class="text-lg font-bold">@L.T("功能实现", "Feature Implementation")</h3>
                                    <p class="text-sm text-muted-foreground">@L.T("新增仪表盘分析模块。", "Added new dashboard analytics module.")</p>
                                </div>
                                <p class="text-sm">
                                    @L.T("本次更新引入了一个完整的分析仪表盘，支持实时数据可视化、交互式图表与可自定义的小部件。用户现在可以跟踪关键绩效指标、观察长期趋势，并以多种格式导出报告。", "This update introduces a comprehensive analytics dashboard with real-time data visualization, interactive charts, and customizable widgets. Users can now track key performance indicators, monitor trends over time, and export reports in multiple formats.")
                                </p>
                                <div class="flex gap-2">
                                    <Button Size="ButtonSize.Small">@L.T("查看详情", "View Details")</Button>
                                    <Button Size="ButtonSize.Small" Variant="ButtonVariant.Outline">@L.T("忽略", "Dismiss")</Button>
                                </div>
                            </div>
                        </div>
                    </ChildContent>
                </TimelineItem>

                <TimelineItem Status="TimelineStatus.Completed" ConnectorStyle="TimelineConnectorStyle.Dashed">
                    <IconContent>
                        <TimelineIcon Color="TimelineColor.Primary">
                            <LucideIcon Name="check" Size="16" />
                        </TimelineIcon>
                    </IconContent>
                    <ChildContent>
                        <TimelineContent>
                            <TimelineHeader>
                                <TimelineTitle>@L.T("首次提交", "Initial commit")</TimelineTitle>
                                <TimelineTime Class="text-xs">@L.T("2 小时前", "2 hours ago")</TimelineTime>
                            </TimelineHeader>
                            <TimelineDescription>@L.T("搭建项目结构。", "Set up project structure.")</TimelineDescription>
                        </TimelineContent>
                    </ChildContent>
                </TimelineItem>

                <TimelineItem Status="TimelineStatus.Completed">
                    <IconContent>
                        <TimelineIcon Color="TimelineColor.Accent">
                            <LucideIcon Name="image" Size="16" />
                        </TimelineIcon>
                    </IconContent>
                    <ChildContent>
                        <div class="border rounded-lg shadow-sm overflow-hidden">
                            <div class="bg-muted h-32 flex items-center justify-center">
                                <LucideIcon Name="image" Size="48" Class="text-muted-foreground/50" />
                            </div>
                            <div class="p-4 space-y-2">
                                <h3 class="text-lg font-bold">@L.T("设计稿已上传", "Design Mockups Uploaded")</h3>
                                <p class="text-sm text-muted-foreground">
                                    @L.T("设计团队上传了 12 张新的结账流程改版设计稿，覆盖移动端、平板与桌面三种断点。", "The design team uploaded 12 new mockups for the checkout flow redesign, covering mobile, tablet, and desktop breakpoints.")
                                </p>
                            </div>
                        </div>
                    </ChildContent>
                </TimelineItem>

                <TimelineItem Status="TimelineStatus.Pending" ShowConnector="false">
                    <IconContent>
                        <TimelineIcon Color="TimelineColor.Muted" Status="TimelineStatus.Pending">
                            <LucideIcon Name="circle-dashed" Size="16" />
                        </TimelineIcon>
                    </IconContent>
                    <ChildContent>
                        <TimelineContent>
                            <TimelineHeader>
                                <TimelineTitle>@L.T("代码评审", "Code Review")</TimelineTitle>
                            </TimelineHeader>
                            <TimelineDescription>@L.T("等待团队负责人评审。", "Awaiting review from the team lead.")</TimelineDescription>
                        </TimelineContent>
                    </ChildContent>
                </TimelineItem>
            </Timeline>
        </div>
        <CodeBlock Source="Components/Timeline/rich-content.txt" />
    </div>

    <!-- Status Variants -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("状态变体", "Status Variants")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("时间线条目的状态可显示为已完成、进行中或待处理，并配以相应的连接线样式。", "Timeline items can show completed, in-progress, or pending status with appropriate connector styling.")
            </p>
        </div>
        <div class="border rounded-lg p-6">
            <Timeline>
                <TimelineItem Status="TimelineStatus.Completed">
                    <TimeContent>
                        <TimelineTime Class="text-right pr-4">@L.T("第 1 步", "Step 1")</TimelineTime>
                    </TimeContent>
                    <ChildContent>
                        <TimelineContent>
                            <TimelineHeader>
                                <TimelineTitle>@L.T("订单已提交", "Order Placed")</TimelineTitle>
                            </TimelineHeader>
                            <TimelineDescription>@L.T("订单已确认，正在处理中。", "Your order has been confirmed and is being processed.")</TimelineDescription>
                        </TimelineContent>
                    </ChildContent>
                </TimelineItem>

                <TimelineItem Status="TimelineStatus.Completed">
                    <TimeContent>
                        <TimelineTime Class="text-right pr-4">@L.T("第 2 步", "Step 2")</TimelineTime>
                    </TimeContent>
                    <ChildContent>
                        <TimelineContent>
                            <TimelineHeader>
                                <TimelineTitle>@L.T("支付已确认", "Payment Confirmed")</TimelineTitle>
                            </TimelineHeader>
                            <TimelineDescription>@L.T("支付已成功处理。", "Payment has been successfully processed.")</TimelineDescription>
                        </TimelineContent>
                    </ChildContent>
                </TimelineItem>

                <TimelineItem Status="TimelineStatus.InProgress">
                    <TimeContent>
                        <TimelineTime Class="text-right pr-4">@L.T("第 3 步", "Step 3")</TimelineTime>
                    </TimeContent>
                    <ChildContent>
                        <TimelineContent>
                            <TimelineHeader>
                                <TimelineTitle>@L.T("配送中", "Shipping")</TimelineTitle>
                            </TimelineHeader>
                            <TimelineDescription>@L.T("包裹正在送往收货地址的途中。", "Your package is on its way to the delivery address.")</TimelineDescription>
                        </TimelineContent>
                    </ChildContent>
                </TimelineItem>

                <TimelineItem Status="TimelineStatus.Pending" ShowConnector="false">
                    <TimeContent>
                        <TimelineTime Class="text-right pr-4">@L.T("第 4 步", "Step 4")</TimelineTime>
                    </TimeContent>
                    <ChildContent>
                        <TimelineContent>
                            <TimelineHeader>
                                <TimelineTitle>@L.T("已送达", "Delivered")</TimelineTitle>
                            </TimelineHeader>
                            <TimelineDescription>@L.T("包裹将送达您的门口。", "Package will be delivered to your doorstep.")</TimelineDescription>
                        </TimelineContent>
                    </ChildContent>
                </TimelineItem>
            </Timeline>
        </div>
        <CodeBlock Source="Components/Timeline/status-variants.txt" />
    </div>

    <!-- Color Variants -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("颜色变体", "Color Variants")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("图标提供五种颜色主题：Primary、Secondary、Muted、Accent 与 Destructive。", "Five color themes for icons: Primary, Secondary, Muted, Accent, and Destructive.")
            </p>
        </div>
        <div class="border rounded-lg p-6">
            <Timeline>
                <TimelineItem IconColor="TimelineColor.Primary">
                    <ChildContent>
                        <TimelineContent>
                            <TimelineHeader>
                                <TimelineTitle>@L.T("主色", "Primary")</TimelineTitle>
                            </TimelineHeader>
                            <TimelineDescription>@L.T("默认的主色主题。", "Default primary color theme.")</TimelineDescription>
                        </TimelineContent>
                    </ChildContent>
                </TimelineItem>

                <TimelineItem IconColor="TimelineColor.Secondary">
                    <ChildContent>
                        <TimelineContent>
                            <TimelineHeader>
                                <TimelineTitle>@L.T("次要色", "Secondary")</TimelineTitle>
                            </TimelineHeader>
                            <TimelineDescription>@L.T("用于备选样式的次要色。", "Secondary color for alternative styling.")</TimelineDescription>
                        </TimelineContent>
                    </ChildContent>
                </TimelineItem>

                <TimelineItem IconColor="TimelineColor.Accent">
                    <ChildContent>
                        <TimelineContent>
                            <TimelineHeader>
                                <TimelineTitle>@L.T("强调色", "Accent")</TimelineTitle>
                            </TimelineHeader>
                            <TimelineDescription>@L.T("用于高亮条目的强调色。", "Accent color for highlighted items.")</TimelineDescription>
                        </TimelineContent>
                    </ChildContent>
                </TimelineItem>

                <TimelineItem IconColor="TimelineColor.Destructive" ShowConnector="false">
                    <ChildContent>
                        <TimelineContent>
                            <TimelineHeader>
                                <TimelineTitle>@L.T("危险色", "Destructive")</TimelineTitle>
                            </TimelineHeader>
                            <TimelineDescription>@L.T("用于警告或错误的危险色。", "Destructive color for warnings or errors.")</TimelineDescription>
                        </TimelineContent>
                    </ChildContent>
                </TimelineItem>
            </Timeline>
        </div>
        <CodeBlock Source="Components/Timeline/color-variants.txt" />
    </div>

    <!-- Size Variants -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("尺寸变体", "Size Variants")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("三种尺寸，用于控制条目间距与图标大小。", "Three sizes controlling the gap spacing between items and icon dimensions.")
            </p>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
            <!-- Small -->
            <div class="border rounded-lg p-4">
                <p class="text-sm font-medium mb-4">@L.T("小号", "Small")</p>
                <Timeline Size="TimelineSize.Small">
                    <TimelineItem IconSize="TimelineSize.Small">
                        <ChildContent>
                            <TimelineContent>
                                <TimelineTitle>@L.T("事件 A", "Event A")</TimelineTitle>
                            </TimelineContent>
                        </ChildContent>
                    </TimelineItem>
                    <TimelineItem IconSize="TimelineSize.Small">
                        <ChildContent>
                            <TimelineContent>
                                <TimelineTitle>@L.T("事件 B", "Event B")</TimelineTitle>
                            </TimelineContent>
                        </ChildContent>
                    </TimelineItem>
                    <TimelineItem IconSize="TimelineSize.Small" ShowConnector="false">
                        <ChildContent>
                            <TimelineContent>
                                <TimelineTitle>@L.T("事件 C", "Event C")</TimelineTitle>
                            </TimelineContent>
                        </ChildContent>
                    </TimelineItem>
                </Timeline>
            </div>

            <!-- Medium -->
            <div class="border rounded-lg p-4">
                <p class="text-sm font-medium mb-4">@L.T("中号（默认）", "Medium (Default)")</p>
                <Timeline Size="TimelineSize.Medium">
                    <TimelineItem IconSize="TimelineSize.Medium">
                        <ChildContent>
                            <TimelineContent>
                                <TimelineTitle>@L.T("事件 A", "Event A")</TimelineTitle>
                            </TimelineContent>
                        </ChildContent>
                    </TimelineItem>
                    <TimelineItem IconSize="TimelineSize.Medium">
                        <ChildContent>
                            <TimelineContent>
                                <TimelineTitle>@L.T("事件 B", "Event B")</TimelineTitle>
                            </TimelineContent>
                        </ChildContent>
                    </TimelineItem>
                    <TimelineItem IconSize="TimelineSize.Medium" ShowConnector="false">
                        <ChildContent>
                            <TimelineContent>
                                <TimelineTitle>@L.T("事件 C", "Event C")</TimelineTitle>
                            </TimelineContent>
                        </ChildContent>
                    </TimelineItem>
                </Timeline>
            </div>

            <!-- Large -->
            <div class="border rounded-lg p-4">
                <p class="text-sm font-medium mb-4">@L.T("大号", "Large")</p>
                <Timeline Size="TimelineSize.Large">
                    <TimelineItem IconSize="TimelineSize.Large">
                        <ChildContent>
                            <TimelineContent>
                                <TimelineTitle>@L.T("事件 A", "Event A")</TimelineTitle>
                            </TimelineContent>
                        </ChildContent>
                    </TimelineItem>
                    <TimelineItem IconSize="TimelineSize.Large">
                        <ChildContent>
                            <TimelineContent>
                                <TimelineTitle>@L.T("事件 B", "Event B")</TimelineTitle>
                            </TimelineContent>
                        </ChildContent>
                    </TimelineItem>
                    <TimelineItem IconSize="TimelineSize.Large" ShowConnector="false">
                        <ChildContent>
                            <TimelineContent>
                                <TimelineTitle>@L.T("事件 C", "Event C")</TimelineTitle>
                            </TimelineContent>
                        </ChildContent>
                    </TimelineItem>
                </Timeline>
            </div>
        </div>
        <CodeBlock Source="Components/Timeline/sizes.txt" />
    </div>

    <!-- With Custom Icons -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("使用自定义图标", "With Custom Icons")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("通过 IconContent 渲染片段，用自定义图标替换默认的圆点指示器。", "Replace the default dot indicator with custom icons using the IconContent render fragment.")
            </p>
        </div>
        <div class="border rounded-lg p-6">
            <Timeline>
                <TimelineItem Status="TimelineStatus.Completed">
                    <IconContent>
                        <TimelineIcon Color="TimelineColor.Primary">
                            <LucideIcon Name="check" Size="16" />
                        </TimelineIcon>
                    </IconContent>
                    <TimeContent>
                        <TimelineTime Class="text-right pr-4">@L.T("上午 9:00", "9:00 AM")</TimelineTime>
                    </TimeContent>
                    <ChildContent>
                        <TimelineContent>
                            <TimelineHeader>
                                <TimelineTitle>@L.T("代码评审已通过", "Code Review Approved")</TimelineTitle>
                            </TimelineHeader>
                            <TimelineDescription>@L.T("所有评审意见都已处理并通过。", "All review comments have been addressed and approved.")</TimelineDescription>
                        </TimelineContent>
                    </ChildContent>
                </TimelineItem>

