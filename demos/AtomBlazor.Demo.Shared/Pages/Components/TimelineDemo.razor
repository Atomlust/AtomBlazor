        </div>

        <div class="space-y-4">
            <ApiReference ComponentName="Timeline">
                <ApiParameter Name="Size" Type="TimelineSize" Default="Medium">
                    @L.T("控制条目之间的间距（Small、Medium、Large）。", "Controls gap spacing between items (Small, Medium, Large).")
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?">
                    @L.T("时间线容器的附加 CSS 类。", "Additional CSS classes for the timeline container.")
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    @if (L.IsChinese)
                    {
                        <text>
                            应用到根 <code>&lt;ol&gt;</code> 元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                        </text>
                    }
                    else
                    {
                        <text>
                            Additional HTML attributes applied to the root <code>&lt;ol&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                        </text>
                    }
                </ApiParameter>
            </ApiReference>

            <ApiReference ComponentName="TimelineItem">
                <ApiParameter Name="Status" Type="TimelineStatus" Default="Completed">
                    @L.T("当前状态（Completed、InProgress、Pending）。", "Current status (Completed, InProgress, Pending).")
                </ApiParameter>
                <ApiParameter Name="IconColor" Type="TimelineColor" Default="Primary">
                    @L.T("图标的颜色主题（Primary、Secondary、Muted、Accent、Destructive）。", "Color theme for the icon (Primary, Secondary, Muted, Accent, Destructive).")
                </ApiParameter>
                <ApiParameter Name="ConnectorColor" Type="TimelineColor?" Default="null">
                    @L.T("连接线的显式颜色。为 null 时，颜色由 Status 推导。", "Explicit color for the connector line. When null, color is derived from Status.")
                </ApiParameter>
                <ApiParameter Name="ShowConnector" Type="bool" Default="true">
                    @L.T("是否显示该条目下方的竖直连接线。", "Whether to show the vertical connector line below this item.")
                </ApiParameter>
                <ApiParameter Name="ConnectorClass" Type="string?">
                    @L.T("连接线的附加 CSS 类，可用于自定义高度（例如 \"min-h-16\"）。", "Additional CSS classes for the connector line. Use to customize height (e.g., \"min-h-16\").")
                </ApiParameter>
                <ApiParameter Name="IconSize" Type="TimelineSize" Default="Medium">
                    @L.T("图标指示器的大小。", "Size of the icon indicator.")
                </ApiParameter>
                <ApiParameter Name="IconContent" Type="RenderFragment?">
                    @L.T("用于替换默认图标的自定义图标内容。", "Custom icon content to replace the default icon.")
                </ApiParameter>
                <ApiParameter Name="TimeContent" Type="RenderFragment?">
                    @L.T("显示在左侧列的日期/时间内容。", "Time/date content displayed in the left column.")
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    @if (L.IsChinese)
                    {
                        <text>
                            应用到根 <code>&lt;li&gt;</code> 元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                        </text>
                    }
                    else
                    {
                        <text>
                            Additional HTML attributes applied to the root <code>&lt;li&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                        </text>
                    }
                </ApiParameter>
            </ApiReference>

            <ApiReference ComponentName="Sub-Components">
                <ApiParameter Name="TimelineIcon" Type="Component">
                    @L.T("圆形的图标指示器。属性：Color、Size、Status、ChildContent。", "Circular icon indicator. Props: Color, Size, Status, ChildContent.")
                </ApiParameter>
                <ApiParameter Name="TimelineConnector" Type="Component">
                    @L.T("条目之间的竖直线条。属性：Status、Color、Class。", "Vertical line between items. Props: Status, Color, Class.")
                </ApiParameter>
                <ApiParameter Name="TimelineContent" Type="Component">
                    @L.T("内容区域的 Flex 容器。属性：Class、ChildContent。", "Flex container for the content area. Props: Class, ChildContent.")
                </ApiParameter>
                <ApiParameter Name="TimelineHeader" Type="Component">
                    @L.T("包含标题与时间的头部区域。属性：Class、ChildContent。", "Header section containing title and time. Props: Class, ChildContent.")
                </ApiParameter>
                <ApiParameter Name="TimelineTitle" Type="Component">
                    @if (L.IsChinese)
                    {
                        <text>
                            用于条目标题的语义化标题元素（&lt;h3&gt;）。属性：Class、ChildContent。
                        </text>
                    }
                    else
                    {
                        <text>
                            Semantic heading (&lt;h3&gt;) for the item title. Props: Class, ChildContent.
                        </text>
                    }
                </ApiParameter>
                <ApiParameter Name="TimelineDescription" Type="Component">
                    @L.T("用于条目说明文字的段落。属性：Class、ChildContent。", "Paragraph for item description text. Props: Class, ChildContent.")
                </ApiParameter>
                <ApiParameter Name="TimelineTime" Type="Component">
                    @if (L.IsChinese)
                    {
                        <text>
                            用于日期的语义化 &lt;time&gt; 元素。属性：Class、ChildContent。
                        </text>
                    }
                    else
                    {
                        <text>
                            Semantic &lt;time&gt; element for dates. Props: Class, ChildContent.
                        </text>
                    }
                </ApiParameter>
                <ApiParameter Name="TimelineEmpty" Type="Component">
                    @L.T("没有任何条目时显示的回退内容。属性：Class、ChildContent。", "Fallback displayed when no items exist. Props: Class, ChildContent.")
                </ApiParameter>
            </ApiReference>
        </div>
    </section>

    <LocalizationSection
        Description="@(L.T("时间线的 aria 标签可以配置。", "The timeline aria label is configurable."))"
        Labels="@(new LocalizationSection.LabelInfo[]
        {
            new("Timeline", "Timeline", L.T("时间线容器的无障碍标签。", "Aria label for the timeline container")),
        })"
        CodeExample="@(@"builder.Services.AddAtomBlazorComponents(localizer =>
{
    localizer.Set(""Timeline.Timeline"", ""Zeitleiste"");
});")" />
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;
}
