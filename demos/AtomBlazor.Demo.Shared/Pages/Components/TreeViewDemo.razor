@page "/components/tree-view"

<PageTitle>@L.T("Tree View 树形视图 - Atom BlazorUI", "Tree View Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("Tree View 树形视图", "Tree View Component")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("面向文件浏览器、分类浏览、导航树等场景的层级数据展示组件。", "A hierarchical data display for file explorers, category browsers, navigation trees, and more.")
            </p>
        </div>
    </div>

    <div class="space-y-6">

        @* --- 1. Basic Tree --- *@
        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("基础树", "Basic Tree")</h2>
                <p class="text-muted-foreground">
                    @L.T("简单的声明式树，支持展开/折叠。点击箭头切换按钮即可展开或折叠分支。", "A simple declarative tree with expand/collapse. Click the chevron toggles to expand or collapse branches.")
                </p>
            </div>

            <div class="rounded-lg border p-4">
                <TreeView TItem="object" SelectionMode="TreeSelectionMode.None">
                    <AtomBlazor.TreeItem Value="docs" Label="Documents" Icon="folder">
                        <AtomBlazor.TreeItem Value="reports" Label="Reports" Icon="folder">
                            <AtomBlazor.TreeItem Value="q1" Label="Q1 Report.pdf" Icon="file-text" />
                            <AtomBlazor.TreeItem Value="q2" Label="Q2 Report.pdf" Icon="file-text" />
                        </AtomBlazor.TreeItem>
                        <AtomBlazor.TreeItem Value="invoices" Label="Invoices" Icon="folder">
                            <AtomBlazor.TreeItem Value="inv1" Label="Invoice #1001.pdf" Icon="file-text" />
                            <AtomBlazor.TreeItem Value="inv2" Label="Invoice #1002.pdf" Icon="file-text" />
                        </AtomBlazor.TreeItem>
                    </AtomBlazor.TreeItem>
                    <AtomBlazor.TreeItem Value="images" Label="Images" Icon="folder">
                        <AtomBlazor.TreeItem Value="logo" Label="logo.png" Icon="image" />
                        <AtomBlazor.TreeItem Value="banner" Label="banner.jpg" Icon="image" />
                    </AtomBlazor.TreeItem>
                    <AtomBlazor.TreeItem Value="readme" Label="README.md" Icon="file" />
                </TreeView>
            </div>
            <CodeBlock Source="Components/TreeView/basic.txt" />
        </section>

        @* --- 2. Data-Driven Tree (Nested Data) --- *@
        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("数据驱动（嵌套数据）", "Data-Driven (Nested Data)")</h2>
                @if (L.IsChinese)
                {
                    <text>
                        <p class="text-muted-foreground">
                            通过 <code>ChildrenProperty</code> 从嵌套对象数据生成树。
                        </p>
                    </text>
                }
                else
                {
                    <text>
                        <p class="text-muted-foreground">
                            Tree generated from nested object data using <code>ChildrenProperty</code>.
                        </p>
                    </text>
                }
            </div>

            <div class="rounded-lg border p-4">
                <TreeView TItem="CategoryNode"
                            Items="@nestedCategories"
                            ChildrenProperty="@(c => c.Children)"
                            TextField="@(c => c.Name)"
                            ValueField="@(c => c.Id)"
                            IconField="@(c => c.Icon)"
                            SelectionMode="TreeSelectionMode.Single"
                            @bind-SelectedValue="selectedCategory"
                            DefaultExpandDepth="1" />
            </div>
            <p class="text-sm text-muted-foreground">
                @L.T("已选择：", "Selected:") <strong>@(selectedCategory ?? L.T("无", "None"))</strong>
            </p>
            <CodeBlock Source="Components/TreeView/data-driven.txt" />
        </section>

        @* --- 3. Flat Data with Parent References --- *@
        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("扁平数据（父级引用）", "Flat Data (Parent References)")</h2>
                @if (L.IsChinese)
                {
                    <text>
                        <p class="text-muted-foreground">
                            使用 <code>ParentField</code> 引用父级 ID，从扁平数据构建树。
                        </p>
                    </text>
                }
                else
                {
                    <text>
                        <p class="text-muted-foreground">
                            Tree built from flat data using <code>ParentField</code> to reference parent IDs.
                        </p>
                    </text>
                }
            </div>

            <div class="rounded-lg border p-4">
                <TreeView TItem="FlatNode"
                            Items="@flatNodes"
                            ParentField="@(n => n.ParentId)"
                            TextField="@(n => n.Name)"
                            ValueField="@(n => n.Id)"
                            SelectionMode="TreeSelectionMode.Multiple"
                            @bind-SelectedValues="selectedFlatIds"
                            DefaultExpandAll="true" />
            </div>
            <p class="text-sm text-muted-foreground">
                @L.T("已选择：", "Selected:") <strong>@(selectedFlatIds.Count > 0 ? string.Join(", ", selectedFlatIds) : L.T("无", "None"))</strong>
            </p>
            <CodeBlock Source="Components/TreeView/flat-data.txt" />
        </section>

        @* --- 4. Single and Multi-Selection --- *@
        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("选择模式", "Selection Modes")</h2>
                <p class="text-muted-foreground">
                    @L.T("单选模式：只能选中一个节点。多选模式：可同时勾选多个节点。", "Single selection: only one node can be selected. Multiple selection: toggle multiple nodes.")
                </p>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div class="rounded-lg border p-4">
                    <p class="text-sm font-medium mb-2">@L.T("单选", "Single Selection")</p>
                    <TreeView TItem="object" SelectionMode="TreeSelectionMode.Single" @bind-SelectedValue="singleSelectedValue">
                        <AtomBlazor.TreeItem Value="fruits" Label="Fruits" Icon="apple">
                            <AtomBlazor.TreeItem Value="apple" Label="Apple" />
                            <AtomBlazor.TreeItem Value="banana" Label="Banana" />
                            <AtomBlazor.TreeItem Value="cherry" Label="Cherry" />
                        </AtomBlazor.TreeItem>
                        <AtomBlazor.TreeItem Value="vegetables" Label="Vegetables" Icon="salad">
                            <AtomBlazor.TreeItem Value="carrot" Label="Carrot" />
                            <AtomBlazor.TreeItem Value="broccoli" Label="Broccoli" />
                        </AtomBlazor.TreeItem>
                    </TreeView>
                    <p class="text-xs text-muted-foreground mt-2">@L.T("已选择：", "Selected:") @(singleSelectedValue ?? L.T("无", "None"))</p>
                </div>

                <div class="rounded-lg border p-4">
                    <p class="text-sm font-medium mb-2">@L.T("多选", "Multiple Selection")</p>
                    <TreeView TItem="object" SelectionMode="TreeSelectionMode.Multiple" @bind-SelectedValues="multiSelectedValues">
                        <AtomBlazor.TreeItem Value="red" Label="Red" />
                        <AtomBlazor.TreeItem Value="green" Label="Green" />
                        <AtomBlazor.TreeItem Value="blue" Label="Blue" />
                        <AtomBlazor.TreeItem Value="yellow" Label="Yellow" />
                        <AtomBlazor.TreeItem Value="purple" Label="Purple" />
                    </TreeView>
                    <p class="text-xs text-muted-foreground mt-2">@L.T("已选择：", "Selected:") @(multiSelectedValues.Count > 0 ? string.Join(", ", multiSelectedValues) : L.T("无", "None"))</p>
                </div>
            </div>
            <CodeBlock Source="Components/TreeView/selection.txt" />
        </section>

        @* --- 5. Checkable Tree with Cascade --- *@
        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("可勾选树", "Checkable Tree")</h2>
                <p class="text-muted-foreground">
                    @L.T("三态复选框并带父子级联。勾选父节点会选中其全部后代；只勾选部分子节点时，父节点呈半选状态。", "Tri-state checkboxes with parent/child cascade. Checking a parent checks all descendants. Checking some children puts the parent in indeterminate state.")
                </p>
            </div>

            <div class="rounded-lg border p-4">
                <TreeView TItem="object" Checkable="true" @bind-CheckedValues="checkedPermissions" DefaultExpandAll="true">
                    <AtomBlazor.TreeItem Value="admin" Label="Administration" Icon="shield">
                        <AtomBlazor.TreeItem Value="users" Label="User Management" Icon="users">
                            <AtomBlazor.TreeItem Value="user-create" Label="Create Users" />
                            <AtomBlazor.TreeItem Value="user-edit" Label="Edit Users" />
                            <AtomBlazor.TreeItem Value="user-delete" Label="Delete Users" />
                        </AtomBlazor.TreeItem>
                        <AtomBlazor.TreeItem Value="settings" Label="Settings" Icon="settings">
                            <AtomBlazor.TreeItem Value="settings-general" Label="General Settings" />
                            <AtomBlazor.TreeItem Value="settings-security" Label="Security Settings" />
                        </AtomBlazor.TreeItem>
                    </AtomBlazor.TreeItem>
                    <AtomBlazor.TreeItem Value="content" Label="Content" Icon="file-text">
                        <AtomBlazor.TreeItem Value="content-create" Label="Create Content" />
                        <AtomBlazor.TreeItem Value="content-edit" Label="Edit Content" />
                        <AtomBlazor.TreeItem Value="content-publish" Label="Publish Content" />
                    </AtomBlazor.TreeItem>
                </TreeView>
            </div>
            <p class="text-sm text-muted-foreground">
                @L.T("已勾选：", "Checked:") <strong>@(checkedPermissions.Count > 0 ? string.Join(", ", checkedPermissions) : L.T("无", "None"))</strong>
            </p>
            <CodeBlock Source="Components/TreeView/checkable.txt" />
        </section>

        @* --- 6. Lazy Loading --- *@
        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("懒加载", "Lazy Loading")</h2>
                <p class="text-muted-foreground">
                    @L.T("节点首次展开时才按需加载子级。加载期间显示 spinner，结果会被缓存。", "Children are loaded on demand when a node is expanded for the first time. A loading spinner appears during fetch, and results are cached.")
                </p>
            </div>

            <div class="rounded-lg border p-4">
                <TreeView TItem="LazyNode"
                            Items="@lazyRootNodes"
                            TextField="@(n => n.Name)"
                            ValueField="@(n => n.Id)"
                            IconField="@(n => n.Icon)"
                            HasChildrenField="@(n => n.HasChildren)"
                            OnLoadChildren="LoadLazyChildren"
                            SelectionMode="TreeSelectionMode.Single"
                            @bind-SelectedValue="selectedLazyNode" />
            </div>
            <CodeBlock Source="Components/TreeView/lazy-loading.txt" />
        </section>

        @* --- 7. Drag and Drop --- *@
        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("拖放", "Drag and Drop")</h2>
                <p class="text-muted-foreground">
                    @L.T("拖动节点可在树内重新排序或变更父级。放置指示线会标出节点将落位的位置（目标节点之前、之后或内部）。", "Drag nodes to reorder or reparent within the tree. Drop indicators show where the node will be placed (before, after, or inside a target node).")
                </p>
            </div>

            <div class="rounded-lg border p-4">
                <TreeView TItem="DragNode"
                            Items="@dragItems"
                            ChildrenProperty="@(n => n.Children)"
                            TextField="@(n => n.Name)"
                            ValueField="@(n => n.Id)"
                            IconField="@(n => n.Icon)"
                            Draggable="true"
                            OnNodeDrop="HandleDrop"
                            DefaultExpandAll="true"
                            SelectionMode="TreeSelectionMode.Single" />
            </div>
            <p class="text-sm text-muted-foreground">@dragMessage</p>
            <CodeBlock Source="Components/TreeView/drag-drop.txt" />
        </section>

        @* --- 8. Search and Filter --- *@
        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("搜索与过滤", "Search and Filter")</h2>
                <p class="text-muted-foreground">
                    @L.T("内置搜索框会过滤可见节点并自动展开匹配分支，命中文本会高亮显示。", "Built-in search input filters visible nodes and auto-expands matching branches. Matching text is highlighted.")
                </p>
            </div>

            <div class="rounded-lg border p-4">
                <TreeView TItem="CategoryNode"
                            Items="@nestedCategories"
                            ChildrenProperty="@(c => c.Children)"
                            TextField="@(c => c.Name)"
                            ValueField="@(c => c.Id)"
                            IconField="@(c => c.Icon)"
                            ShowSearch="true"
                            SearchPlaceholder="@(L.T("搜索分类…", "Search categories..."))"
                            SelectionMode="TreeSelectionMode.Single"
                            DefaultExpandDepth="1" />
            </div>
            <CodeBlock Source="Components/TreeView/search.txt" />
        </section>

        @* --- 9. Custom Node Templates --- *@
        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("自定义节点模板", "Custom Node Templates")</h2>
                <p class="text-muted-foreground">
                    @L.T("使用自定义标签模板的节点，以及悬停时显示的操作按钮。", "Nodes with custom label templates and action buttons that appear on hover.")
                </p>
            </div>

            <div class="rounded-lg border p-4">
                <TreeView TItem="object" SelectionMode="TreeSelectionMode.Single">
                    <AtomBlazor.TreeItem Value="project" Label="My Project" Icon="folder">
                        <AtomBlazor.TreeItem Value="src" Icon="folder">
                            <LabelTemplate>
                                <span class="font-medium">src</span>
                                <span class="text-xs text-muted-foreground ml-1">(source code)</span>
                            </LabelTemplate>
                            <ActionsTemplate>
                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="h-6 w-6">
                                    <LucideIcon Name="plus" Size="14" />
                                </Button>
                            </ActionsTemplate>
                            <ChildContent>
                                <AtomBlazor.TreeItem Value="app.cs" Label="App.cs" Icon="file-code" />
                                <AtomBlazor.TreeItem Value="program.cs" Label="Program.cs" Icon="file-code" />
                            </ChildContent>
                        </AtomBlazor.TreeItem>
                        <AtomBlazor.TreeItem Value="tests" Icon="folder">
                            <LabelTemplate>
                                <span class="font-medium">tests</span>
                                <Badge Variant="BadgeVariant.Outline" Class="ml-1 text-xs px-1 py-0 h-4">2 files</Badge>
                            </LabelTemplate>
                            <ChildContent>
                                <AtomBlazor.TreeItem Value="test1.cs" Label="AppTests.cs" Icon="file-code" />
                                <AtomBlazor.TreeItem Value="test2.cs" Label="UtilTests.cs" Icon="file-code" />
                            </ChildContent>
                        </AtomBlazor.TreeItem>
                    </AtomBlazor.TreeItem>
                </TreeView>
            </div>
            <CodeBlock Source="Components/TreeView/custom-templates.txt" />
        </section>

        @* --- 10. Icons and Badges --- *@
        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("图标与徽标", "Icons and Badges")</h2>
                <p class="text-muted-foreground">
                    @L.T("带 Lucide 图标与计数徽标的节点。", "Nodes with Lucide icons and count badges.")
                </p>
            </div>

            <div class="rounded-lg border p-4">
                <TreeView TItem="object" SelectionMode="TreeSelectionMode.Single">
                    <AtomBlazor.TreeItem Value="inbox" Label="Inbox" Icon="inbox" Badge="12">
                        <AtomBlazor.TreeItem Value="primary" Label="Primary" Icon="mail" Badge="8" />
                        <AtomBlazor.TreeItem Value="social" Label="Social" Icon="users" Badge="3" />
                        <AtomBlazor.TreeItem Value="promotions" Label="Promotions" Icon="tag" Badge="1" />
                    </AtomBlazor.TreeItem>
                    <AtomBlazor.TreeItem Value="sent" Label="Sent" Icon="send" />
                    <AtomBlazor.TreeItem Value="drafts" Label="Drafts" Icon="file-pen" Badge="2" />
                    <AtomBlazor.TreeItem Value="trash" Label="Trash" Icon="trash-2" />
                </TreeView>
            </div>
            <CodeBlock Source="Components/TreeView/icons-badges.txt" />
        </section>

        @* --- 11. Controlled Tree --- *@
        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("受控树", "Controlled Tree")</h2>
                <p class="text-muted-foreground">
                    @L.T("由外部状态管理展开/折叠。用按钮以编程方式控制树。", "External state management for expand/collapse. Use buttons to control the tree programmatically.")
                </p>
            </div>

            <div class="flex gap-2 mb-2">
                <Button Size="ButtonSize.Small" OnClick="ExpandAllControlled">@L.T("全部展开", "Expand All")</Button>
                <Button Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="CollapseAllControlled">@L.T("全部折叠", "Collapse All")</Button>
            </div>

            <div class="rounded-lg border p-4">
                <TreeView TItem="object" @bind-ExpandedValues="controlledExpandedValues" SelectionMode="TreeSelectionMode.Single">
                    <AtomBlazor.TreeItem Value="c-root" Label="Root" Icon="folder">
                        <AtomBlazor.TreeItem Value="c-branch1" Label="Branch 1" Icon="folder">
                            <AtomBlazor.TreeItem Value="c-leaf1" Label="Leaf 1" Icon="file" />
                            <AtomBlazor.TreeItem Value="c-leaf2" Label="Leaf 2" Icon="file" />
                        </AtomBlazor.TreeItem>
                        <AtomBlazor.TreeItem Value="c-branch2" Label="Branch 2" Icon="folder">
                            <AtomBlazor.TreeItem Value="c-leaf3" Label="Leaf 3" Icon="file" />
                        </AtomBlazor.TreeItem>
                    </AtomBlazor.TreeItem>
                </TreeView>
            </div>
            <CodeBlock Source="Components/TreeView/controlled.txt" />
        </section>

        @* --- 12. Expand on Click --- *@
        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("点击展开", "Expand on Click")</h2>
                @if (L.IsChinese)
                {
                    <text>
                        <p class="text-muted-foreground">
                            启用 <code>ExpandOnClick</code> 后，点击父节点任意位置即可切换其展开状态——无需再点击箭头。对比下面的两棵树。
                        </p>
                    </text>
                }
                else
                {
                    <text>
                        <p class="text-muted-foreground">
                            With <code>ExpandOnClick</code>, clicking anywhere on a parent node toggles its
                            expanded state — no need to click the chevron. Compare the two trees below.
                        </p>
                    </text>
                }
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div class="rounded-lg border p-4">
                    <p class="text-sm font-medium mb-2">@L.T("默认（仅箭头可切换）", "Default (chevron only)")</p>
                    <TreeView TItem="object" SelectionMode="TreeSelectionMode.Single">
                        <AtomBlazor.TreeItem Value="eoc-music" Label="Music" Icon="music">
                            <AtomBlazor.TreeItem Value="eoc-rock" Label="Rock" Icon="disc">
                                <AtomBlazor.TreeItem Value="eoc-classic-rock" Label="Classic Rock" />
                                <AtomBlazor.TreeItem Value="eoc-alt-rock" Label="Alternative" />
                            </AtomBlazor.TreeItem>
                            <AtomBlazor.TreeItem Value="eoc-jazz" Label="Jazz" Icon="disc" />
                            <AtomBlazor.TreeItem Value="eoc-electronic" Label="Electronic" Icon="disc" />
                        </AtomBlazor.TreeItem>
                        <AtomBlazor.TreeItem Value="eoc-podcasts" Label="Podcasts" Icon="podcast">
                            <AtomBlazor.TreeItem Value="eoc-tech" Label="Technology" />
                            <AtomBlazor.TreeItem Value="eoc-science" Label="Science" />
                        </AtomBlazor.TreeItem>
                    </TreeView>
                </div>

                <div class="rounded-lg border p-4">
                    <p class="text-sm font-medium mb-2">@L.T("已启用 ExpandOnClick", "ExpandOnClick enabled")</p>
                    <TreeView TItem="object" SelectionMode="TreeSelectionMode.Single" ExpandOnClick="true">
                        <AtomBlazor.TreeItem Value="eoc2-music" Label="Music" Icon="music">
                            <AtomBlazor.TreeItem Value="eoc2-rock" Label="Rock" Icon="disc">
                                <AtomBlazor.TreeItem Value="eoc2-classic-rock" Label="Classic Rock" />
                                <AtomBlazor.TreeItem Value="eoc2-alt-rock" Label="Alternative" />
                            </AtomBlazor.TreeItem>
                            <AtomBlazor.TreeItem Value="eoc2-jazz" Label="Jazz" Icon="disc" />
                            <AtomBlazor.TreeItem Value="eoc2-electronic" Label="Electronic" Icon="disc" />
                        </AtomBlazor.TreeItem>
                        <AtomBlazor.TreeItem Value="eoc2-podcasts" Label="Podcasts" Icon="podcast">
                            <AtomBlazor.TreeItem Value="eoc2-tech" Label="Technology" />
                            <AtomBlazor.TreeItem Value="eoc2-science" Label="Science" />
                        </AtomBlazor.TreeItem>
                    </TreeView>
                </div>
            </div>
            <CodeBlock Source="Components/TreeView/expand-on-click.txt" />
        </section>

        @* --- 13. Custom Styling --- *@
        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("自定义样式", "Custom Styling")</h2>
                @if (L.IsChinese)
                {
                    <text>
                        <p class="text-muted-foreground">
                            在 <code>TreeItem</code> 上使用 <code>Class</code> 参数为单个节点应用自定义样式，
                            树级别的 <code>Class</code> 参数则用于容器样式。
                        </p>
                    </text>
                }
                else
                {
                    <text>
                        <p class="text-muted-foreground">
                            Use the <code>Class</code> parameter on <code>TreeItem</code> to apply custom styles per node,
                            and the tree-level <code>Class</code> parameter for container styling.
                        </p>
                    </text>
                }
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div class="rounded-lg border p-4">
                    <p class="text-sm font-medium mb-2">@L.T("按状态着色节点", "Status-colored nodes")</p>
                    <TreeView TItem="object" SelectionMode="TreeSelectionMode.Single" DefaultExpandAll="true">
                        <AtomBlazor.TreeItem Value="cs-pipeline" Label="Deploy Pipeline" Icon="git-branch">
                            <AtomBlazor.TreeItem Value="cs-build" Label="Build" Icon="hammer" Class="text-green-600 dark:text-green-400" />
                            <AtomBlazor.TreeItem Value="cs-test" Label="Test" Icon="test-tubes" Class="text-green-600 dark:text-green-400" />
                            <AtomBlazor.TreeItem Value="cs-lint" Label="Lint" Icon="search-check" Class="text-yellow-600 dark:text-yellow-400" />
                            <AtomBlazor.TreeItem Value="cs-deploy" Label="Deploy" Icon="rocket" Class="text-red-600 dark:text-red-400" />
                        </AtomBlazor.TreeItem>
                    </TreeView>
                </div>

                <div class="rounded-lg border p-4">
                    <p class="text-sm font-medium mb-2">@L.T("紧凑样式与自定义容器", "Compact with custom container")</p>
                    <TreeView TItem="object"
                                SelectionMode="TreeSelectionMode.Single"
                                DefaultExpandAll="true"
                                Class="text-xs bg-muted/30 rounded-md p-2"
                                ShowIcons="false">
                        <AtomBlazor.TreeItem Value="cs2-app" Label="app/">
