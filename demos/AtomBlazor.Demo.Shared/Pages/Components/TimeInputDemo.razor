@page "/components/time-input"
@using System.Globalization
@using System.ComponentModel.DataAnnotations

<PageTitle>@L.T("Time Input 时间输入 - Atom BlazorUI", "Time Input - Atom BlazorUI")</PageTitle>
<div class="space-y-8 max-w-4xl">
    <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">@L.T("Time Input 时间输入", "Time Input")</h1>
        <p class="text-xl text-muted-foreground">@L.T("编辑时、分以及可选的秒，并按区域设置以 12/24 小时制显示。", "Edit hours, minutes and optional seconds with culture-aware 12/24-hour display.")</p>
    </div>
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("分段编辑", "Segmented editing")</h2>
        <div class="rounded-lg border p-6 space-y-4">
            @* 偏差：本仓 _Imports 同时引入 Microsoft.AspNetCore.Components.Forms（其 Label<TValue> 带 For 参数），
               裸 <AtomBlazor.Label For=...> 触发 RZ10012 泛型/非泛型歧义，照 FileUploadDemo 先例改全限定标签，渲染行为零变化（下同）。 *@
            <AtomBlazor.Label For="basic-time">@L.T("预约时间", "Appointment time")</AtomBlazor.Label>
            <TimeInput Id="basic-time" @bind-Value="value" Format="TimeFormat.Hour12" AriaLabel="@(L.T("预约时间", "Appointment time"))" />
            @if (L.IsChinese)
            {
                <text>
                    <p role="status" class="text-sm text-muted-foreground">已选择：@(value?.ToString() ?? "无")</p>
                </text>
            }
            else
            {
                <text>
                    <p role="status" class="text-sm text-muted-foreground">Selected: @(value?.ToString() ?? "None")</p>
                </text>
            }
        </div>
        <CodeBlock Source="Components/TimeInput/basic.txt" />
    </section>
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("显示选项", "Display options")</h2>
        <div class="rounded-lg border p-6 space-y-4">
            <TimeInput @bind-Value="alternate" Format="TimeFormat.Hour24" ShowSeconds="true" MinuteStep="15" AriaLabel="@(L.T("另一种时间格式", "Alternate time format"))" />
            <TimeInput Value="value" Disabled="true" AriaLabel="@(L.T("禁用的时间", "Disabled time"))" />
            <TimeInput Value="value" ReadOnly="true" AriaLabel="@(L.T("只读时间", "Read-only time"))" />
        </div>
        <CodeBlock Source="Components/TimeInput/options.txt" />
    </section>
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("校验与取值范围", "Validation and bounds")</h2>
        <EditForm Model="model" FormName="segmented-time" OnValidSubmit="@(() => saved = true)" class="rounded-lg border p-6 space-y-4">
            <DataAnnotationsValidator />
            <AtomBlazor.Label For="required-time">@L.T("必填时间", "Required time")</AtomBlazor.Label>
            <TimeInput @ref="requiredInput" Id="required-time" @bind-Value="model.Value" MinTime="@TimeSpan.FromHours(9)" MaxTime="@TimeSpan.FromHours(17)" Required="true" AriaDescribedBy="time-help" />
            <p id="time-help" class="text-sm text-muted-foreground">@L.T("请选择 09:00 到 17:00 之间的时间。残缺或非法的输入会保持可见，并阻止表单提交。", "Choose a time between 09:00 and 17:00. Partial or invalid entries remain visible and prevent form submission.")</p>
            <ValidationMessage For="@(() => model.Value)" />
            <div class="flex gap-2">
                <Button Type="ButtonType.Submit">@L.T("保存", "Save")</Button>
                <Button Variant="ButtonVariant.Outline" OnClick="Clear">@L.T("清空", "Clear")</Button>
            </div>
            @if (saved) { <p role="status">@L.T("保存成功。", "Saved successfully.")</p> }
        </EditForm>
        <CodeBlock Source="Components/TimeInput/validation.txt" />
    </section>


        <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>@L.T("该控件是一个带标签的分组。数字分段暴露 spinbutton 角色、各自的名称、当前值与取值范围。", "The control is a labelled group. Numeric segments expose spinbutton roles, individual names, current values and ranges.")</AccessibilityItem>
            <AccessibilityItem>@L.T("第一段用 Id 配合 Label 命名，整组用 AriaLabel，说明或校验文本用 AriaDescribedBy 关联。", "Use Id with Label for the first segment, AriaLabel for the group, and AriaDescribedBy to associate help or validation text.")</AccessibilityItem>
            <AccessibilityItem>@L.T("残缺或非法的输入会保留其文本，把整组与分段标记为非法，并向 EditContext 添加一条校验消息。禁用的分段不可编辑；只读的数字分段仍然可以被聚焦。", "Partial or invalid entries retain their text, mark the group and segments invalid, and add an EditContext validation message. Disabled segments cannot be edited; read-only numeric segments remain focusable.")</AccessibilityItem>
            <AccessibilityItem>@L.T("在 12 小时制下，AM/PM 是一个 Select，带有带标签的 combobox 触发器与 listbox 选项。钟表弹层同样使用带标签的 Select 来选择时、分以及可选的秒。", "In 12-hour mode, AM/PM is a Select with a labelled combobox trigger and listbox options. The clock popup also uses labelled Select controls for hours, minutes and optional seconds.")</AccessibilityItem>
            <AccessibilityItem>@L.T("MinuteStep 改变键盘操作的数字增量以及选择器里的候选项。手动输入的分钟可以使用范围内的任意值。", "MinuteStep changes numeric keyboard increments and the picker choices. Typed minutes can use any value within the time bounds.")</AccessibilityItem>
        </AriaAttributes>
        <KeyboardNavigation>
            <KeyboardShortcutItem Description="@(L.T("在数字分段与选择器控件之间移动", "Move between numeric segments and picker controls"))"><Kbd>Tab</Kbd> / <Kbd>Shift + Tab</Kbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("在数字分段之间移动（方向跟随 RTL）", "Move between numeric segments (direction follows RTL)"))"><Kbd>ArrowLeft</Kbd> / <Kbd>ArrowRight</Kbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("增加或减少当前聚焦的数字分段", "Increase or decrease the focused numeric segment"))"><Kbd>ArrowUp</Kbd> / <Kbd>ArrowDown</Kbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("把聚焦的数字分段设为最小值或最大值", "Set the focused numeric segment to its minimum or maximum"))"><Kbd>Home</Kbd> / <Kbd>End</Kbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("清除选中的分段文本", "Clear selected segment text"))"><Kbd>Backspace</Kbd> / <Kbd>Delete</Kbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("打开聚焦的下拉框或钟表按钮", "Open a focused select or clock button"))"><Kbd>Enter</Kbd> / <Kbd>Space</Kbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("在已打开的下拉框中浏览 AM/PM 或时间选项", "Move through AM/PM or time options in an open select"))"><Kbd>ArrowUp</Kbd> / <Kbd>ArrowDown</Kbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("选择当前聚焦的选项", "Choose the focused select option"))"><Kbd>Enter</Kbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("关闭当前的下拉框或钟表弹层", "Close the active select or clock popup"))"><Kbd>Escape</Kbd></KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>

    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
        <ApiReference Since="v4" ComponentName="TimeInput">
            <ApiParameter Name="Value / ValueChanged / ValueExpression" Type="TimeSpan? / callback / expression">@L.T("双向值绑定与表单校验。输入残缺或非法时，绑定值置为 null，草稿文本仍然保留。", "Two-way value binding and form validation. Partial or invalid text sets the bound value to null while retaining the draft.")</ApiParameter>
            <ApiParameter Name="Culture" Type="CultureInfo?" Default="null">@L.T("默认取 CultureInfo.CurrentCulture。", "Defaults to CultureInfo.CurrentCulture.")</ApiParameter>
            <ApiParameter Name="MinTime / MaxTime" Type="TimeSpan?">@L.T("同一天内的闭区间时刻上下界；不支持跨天的区间。", "Inclusive time-of-day bounds within one day; overnight bounds are not supported.")</ApiParameter>
            <ApiParameter Name="Format" Type="TimeFormat?" Default="null">@L.T("用 Hour12 或 Hour24 覆盖当前区域设置。", "Override the current culture with Hour12 or Hour24.")</ApiParameter>
            <ApiParameter Name="ShowSeconds / MinuteStep / ShowPicker" Type="bool / int / bool" Default="false / 1 / true">@L.T("是否显示秒、键盘与选择器的分钟步进（1–59），以及钟表按钮。手动输入的分钟不受步进限制。在未显示秒的情况下编辑，秒会被置为 0。", "Seconds visibility, keyboard/picker minute increment (1–59), and clock button. Typed minutes can use any value. Editing without seconds sets seconds to zero.")</ApiParameter>
            <ApiParameter Name="Disabled / ReadOnly / Required" Type="bool" Default="false">@L.T("禁用编辑、保持只读显示，或把分段标记为必填。必填取值的校验请交给模型校验。", "Disable editing, keep a read-only display, or mark segments required. Use model validation for required-value enforcement.")</ApiParameter>
            <ApiParameter Name="Id / Name / AriaLabel / AriaDescribedBy" Type="string?">@L.T("第一段的 ID、隐藏表单字段的 name、分组标签以及说明文本的 ID。", "First-segment ID, hidden form-field name, group label and descriptive text ID.")</ApiParameter>
            <ApiParameter Name="Class / AdditionalAttributes" Type="presentation parameters">@L.T("容器的样式与属性。", "Container styling and attributes.")</ApiParameter>
            <ApiParameter Name="ClearAsync()" Type="Task">@L.T("清空取值与所有分段；禁用或只读时忽略该调用。", "Clear the value and every segment; ignored when disabled or read-only.")</ApiParameter>
        </ApiReference>
    </section>

</div>
@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    private TimeSpan? value = new TimeSpan(14, 30, 0);
    private TimeSpan? alternate = new TimeSpan(14, 30, 0);
    private readonly FormModel model = new();
    private TimeInput? requiredInput;
    private bool saved;
    private async Task Clear()
    {
        saved = false;
        if (requiredInput != null) { await requiredInput.ClearAsync(); }
    }
    private sealed class FormModel
    {
        [Required] public TimeSpan? Value { get; set; }
    }
}
