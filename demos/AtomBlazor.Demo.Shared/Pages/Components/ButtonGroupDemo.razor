@page "/components/button-group"
@using AtomBlazor.Primitives.Services

<PageTitle>@L.T("按钮组 - Atom BlazorUI", "Button Group - Atom BlazorUI")</PageTitle>

<div class="space-y-10 max-w-4xl">
    <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">@L.T("按钮组", "Button Group")</h1>
        <p class="text-xl text-muted-foreground">
            @L.T("以相连的样式将相关按钮在视觉上分组。", "Visually group related buttons together with connected styling.")
        </p>
    </div>

    <!-- Basic Horizontal Groups -->
    <section class="space-y-6">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("基本水平分组", "Basic Horizontal Groups")</h2>
            <p class="text-muted-foreground">
                @L.T("将相关按钮水平归为一组，边框彼此相连。", "Group related buttons together horizontally with connected borders.")
            </p>
        </div>

        <div class="space-y-6">
            <!-- Simple Group -->
            <div class="space-y-2">
                <h3 class="text-sm font-medium">@L.T("简单按钮组", "Simple Button Group")</h3>
                <ButtonGroup>
                    <Button Variant="ButtonVariant.Outline">@L.T("归档", "Archive")</Button>
                    <Button Variant="ButtonVariant.Outline">@L.T("举报", "Report")</Button>
                    <Button Variant="ButtonVariant.Outline">@L.T("删除", "Delete")</Button>
                </ButtonGroup>

                <CodeBlock Source="Components/ButtonGroup/basic.txt" />
            </div>

            <!-- With Icons -->
            <div class="space-y-2">
                <h3 class="text-sm font-medium">@L.T("带图标", "With Icons")</h3>
                <ButtonGroup>
                    <Button Variant="ButtonVariant.Outline">
                        <LucideIcon Name="align-left" Size="16" />
                        @L.T("左对齐", "Left")
                    </Button>
                    <Button Variant="ButtonVariant.Outline">
                        <LucideIcon Name="align-center" Size="16" />
                        @L.T("居中", "Center")
                    </Button>
                    <Button Variant="ButtonVariant.Outline">
                        <LucideIcon Name="align-right" Size="16" />
                        @L.T("右对齐", "Right")
                    </Button>
                </ButtonGroup>

                <CodeBlock Source="Components/ButtonGroup/with-icons.txt" />
            </div>

            <!-- Icon Only -->
            <div class="space-y-2">
                <h3 class="text-sm font-medium">@L.T("仅图标", "Icon Only")</h3>
                <ButtonGroup>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" AriaLabel="@(L.T("加粗", "Bold"))">
                        <LucideIcon Name="bold" Size="16" />
                    </Button>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" AriaLabel="@(L.T("斜体", "Italic"))">
                        <LucideIcon Name="italic" Size="16" />
                    </Button>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" AriaLabel="@(L.T("下划线", "Underline"))">
                        <LucideIcon Name="underline" Size="16" />
                    </Button>
                </ButtonGroup>

                <CodeBlock Source="Components/ButtonGroup/icon-only.txt" />
            </div>

            <!-- Different Variants -->
            <div class="space-y-2">
                <h3 class="text-sm font-medium">@L.T("Secondary 变体", "Secondary Variant")</h3>
                <ButtonGroup>
                    <Button Variant="ButtonVariant.Secondary">@L.T("年", "Year")</Button>
                    <Button Variant="ButtonVariant.Secondary">@L.T("月", "Month")</Button>
                    <Button Variant="ButtonVariant.Secondary">@L.T("周", "Week")</Button>
                    <Button Variant="ButtonVariant.Secondary">@L.T("日", "Day")</Button>
                </ButtonGroup>

                <CodeBlock Source="Components/ButtonGroup/secondary.txt" />
            </div>
        </div>
    </section>

    <!-- Vertical Groups -->
    <section class="space-y-6">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("垂直分组", "Vertical Groups")</h2>
            <p class="text-muted-foreground">
                @L.T("按钮纵向堆叠，适合侧边栏式导航。", "Stack buttons vertically for sidebar-style navigation.")
            </p>
        </div>

        <div class="space-y-6">
            <!-- Vertical Navigation -->
            <div class="space-y-2">
                <h3 class="text-sm font-medium">@L.T("垂直导航", "Vertical Navigation")</h3>
                <ButtonGroup Orientation="ButtonGroupOrientation.Vertical">
                    <Button Variant="ButtonVariant.Outline" Class="justify-start">
                        <LucideIcon Name="house" Size="16" />
                        @L.T("首页", "Home")
                    </Button>
                    <Button Variant="ButtonVariant.Outline" Class="justify-start">
                        <LucideIcon Name="user" Size="16" />
                        @L.T("个人资料", "Profile")
                    </Button>
                    <Button Variant="ButtonVariant.Outline" Class="justify-start">
                        <LucideIcon Name="settings" Size="16" />
                        @L.T("设置", "Settings")
                    </Button>
                    <Button Variant="ButtonVariant.Outline" Class="justify-start">
                        <LucideIcon Name="log-out" Size="16" />
                        @L.T("退出登录", "Logout")
                    </Button>
                </ButtonGroup>

                <CodeBlock Source="Components/ButtonGroup/vertical.txt" />
            </div>
        </div>
    </section>

    <!-- With Separator -->
    <section class="space-y-6">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("带分隔线", "With Separators")</h2>
            <p class="text-muted-foreground">
                @L.T("使用 ButtonGroupSeparator 在按钮分区之间添加视觉分隔线。", "Add visual dividers between button sections using ButtonGroupSeparator.")
            </p>
        </div>

        <div class="space-y-6">
            <!-- Horizontal with Separator -->
            <div class="space-y-2">
                <h3 class="text-sm font-medium">@L.T("水平方向带分隔线", "Horizontal with Separator")</h3>
                <ButtonGroup>
                    <Button Variant="ButtonVariant.Outline">
                        <LucideIcon Name="copy" Size="16" />
                        @L.T("复制", "Copy")
                    </Button>
                    <Button Variant="ButtonVariant.Outline">
                        <LucideIcon Name="clipboard-paste" Size="16" />
                        @L.T("粘贴", "Paste")
                    </Button>
                    <ButtonGroupSeparator />
                    <Button Variant="ButtonVariant.Outline">
                        <LucideIcon Name="undo" Size="16" />
                        @L.T("撤销", "Undo")
                    </Button>
                    <Button Variant="ButtonVariant.Outline">
                        <LucideIcon Name="redo" Size="16" />
                        @L.T("重做", "Redo")
                    </Button>
                </ButtonGroup>

                <CodeBlock Source="Components/ButtonGroup/horizontal-separator.txt" />
            </div>

            <!-- Vertical with Separator -->
            <div class="space-y-2">
                <h3 class="text-sm font-medium">@L.T("垂直方向带分隔线", "Vertical with Separator")</h3>
                <ButtonGroup Orientation="ButtonGroupOrientation.Vertical">
                    <Button Variant="ButtonVariant.Outline" Class="justify-start">
                        <LucideIcon Name="file" Size="16" />
                        @L.T("新建文件", "New File")
                    </Button>
                    <Button Variant="ButtonVariant.Outline" Class="justify-start">
                        <LucideIcon Name="folder" Size="16" />
                        @L.T("新建文件夹", "New Folder")
                    </Button>
                    <ButtonGroupSeparator Orientation="AtomBlazor.SeparatorOrientation.Horizontal" />
                    <Button Variant="ButtonVariant.Outline" Class="justify-start">
                        <LucideIcon Name="download" Size="16" />
                        @L.T("下载", "Download")
                    </Button>
                    <Button Variant="ButtonVariant.Outline" Class="justify-start">
                        <LucideIcon Name="upload" Size="16" />
                        @L.T("上传", "Upload")
                    </Button>
                </ButtonGroup>

                <CodeBlock Source="Components/ButtonGroup/vertical-separator.txt" />
            </div>
        </div>
    </section>

    <!-- With Text Labels -->
    <section class="space-y-6">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("带文字标签", "With Text Labels")</h2>
            <p class="text-muted-foreground">
                @L.T("使用 ButtonGroupText 添加文字标签，提供更清晰的上下文。", "Add text labels using ButtonGroupText for better context.")
            </p>
        </div>

        <div class="space-y-6">
            <!-- Text Label Example -->
            <div class="space-y-2">
                <h3 class="text-sm font-medium">@L.T("带标签的操作", "Labeled Actions")</h3>
                <ButtonGroup>
                    <ButtonGroupText>
                        <LucideIcon Name="file-text" Size="16" />
                        @L.T("文档操作：", "Document Actions:")
                    </ButtonGroupText>
                    <Button Variant="ButtonVariant.Outline">
                        <LucideIcon Name="eye" Size="16" />
                        @L.T("查看", "View")
                    </Button>
                    <Button Variant="ButtonVariant.Outline">
                        <LucideIcon Name="pencil" Size="16" />
                        @L.T("编辑", "Edit")
                    </Button>
                    <Button Variant="ButtonVariant.Outline">
                        <LucideIcon Name="trash-2" Size="16" />
                        @L.T("删除", "Delete")
                    </Button>
                </ButtonGroup>

                <CodeBlock Source="Components/ButtonGroup/text-labels.txt" />
            </div>
        </div>
    </section>

    <!-- Nested Button Groups -->
    <section class="space-y-6">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("嵌套按钮组", "Nested Button Groups")</h2>
            <p class="text-muted-foreground">
                @L.T("把多个按钮组再归为一组，间距自动处理。", "Group button groups together with automatic spacing.")
            </p>
        </div>

        <div class="space-y-6">
            <!-- Email Actions Example (similar to Shadcn) -->
            <div class="space-y-2">
                <h3 class="text-sm font-medium">@L.T("邮件操作工具栏", "Email Actions Toolbar")</h3>
                <ButtonGroup>
                    <ButtonGroup Class="hidden sm:flex">
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" AriaLabel="@(L.T("返回", "Go Back"))">
                            <LucideIcon Name="arrow-left" Size="16" />
                        </Button>
                    </ButtonGroup>
                    <ButtonGroup>
                        <Button Variant="ButtonVariant.Outline">@L.T("归档", "Archive")</Button>
                        <Button Variant="ButtonVariant.Outline">@L.T("举报", "Report")</Button>
                    </ButtonGroup>
                    <ButtonGroup>
                        <Button Variant="ButtonVariant.Outline">@L.T("稍后提醒", "Snooze")</Button>
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" AriaLabel="@(L.T("更多选项", "More Options"))">
                            <LucideIcon Name="ellipsis" Size="16" />
                        </Button>
                    </ButtonGroup>
                </ButtonGroup>

                <CodeBlock Source="Components/ButtonGroup/nested.txt" />
            </div>
        </div>
    </section>

    <!-- Complex Example with Dropdown -->
    <section class="space-y-6">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("复合集成", "Complex Integration")</h2>
            <p class="text-muted-foreground">
                @L.T("将 ButtonGroup 与下拉菜单等其他组件组合使用。", "Combine ButtonGroup with other components like Dropdown Menus.")
            </p>
        </div>

        <div class="space-y-6">
            <!-- Email Toolbar with Dropdown -->
            <div class="space-y-2">
                <h3 class="text-sm font-medium">@L.T("带下拉菜单的邮件操作工具栏", "Email Actions Toolbar with Dropdown")</h3>
                <ButtonGroup>
                    <ButtonGroup Class="hidden sm:flex">
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" AriaLabel="@(L.T("返回", "Go Back"))">
                            <LucideIcon Name="arrow-left" Size="16" />
                        </Button>
                    </ButtonGroup>
                    <ButtonGroup>
                        <Button Variant="ButtonVariant.Outline">@L.T("归档", "Archive")</Button>
                        <Button Variant="ButtonVariant.Outline">@L.T("举报", "Report")</Button>
                    </ButtonGroup>
                    <ButtonGroup>
                        <Button Variant="ButtonVariant.Outline">@L.T("稍后提醒", "Snooze")</Button>
                        <DropdownMenu>
                            <AtomBlazor.DropdownMenuTrigger AsChild="false" Class="inline-flex items-center justify-center gap-2 !rounded-l-none !rounded-r-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none border border-input border-l-0 bg-background hover:bg-accent hover:text-accent-foreground h-10 w-10 cursor-pointer" aria-label="@(L.T("更多选项", "More Options"))">
                                <LucideIcon Name="ellipsis" Size="16" />
                            </AtomBlazor.DropdownMenuTrigger>
                            <AtomBlazor.DropdownMenuContent Align="@PopoverAlign.End" Class="w-52">
                                <DropdownMenuGroup>
                                    <AtomBlazor.DropdownMenuItem>
                                        <LucideIcon Name="mail-check" Size="16" Class="mr-1" />
                                        @L.T("标记为已读", "Mark as Read")
                                    </AtomBlazor.DropdownMenuItem>
                                    <AtomBlazor.DropdownMenuItem>
                                        <LucideIcon Name="archive" Size="16" Class="mr-1" />
                                        @L.T("归档", "Archive")
                                    </AtomBlazor.DropdownMenuItem>
                                </DropdownMenuGroup>
                                <DropdownMenuSeparator />
                                <DropdownMenuGroup>
                                    <AtomBlazor.DropdownMenuItem>
                                        <LucideIcon Name="clock" Size="16" Class="mr-1" />
                                        @L.T("稍后提醒", "Snooze")
                                    </AtomBlazor.DropdownMenuItem>
                                    <AtomBlazor.DropdownMenuItem>
                                        <LucideIcon Name="calendar-plus" Size="16" Class="mr-1" />
                                        @L.T("添加到日历", "Add to Calendar")
                                    </AtomBlazor.DropdownMenuItem>
                                    <AtomBlazor.DropdownMenuItem>
                                        <LucideIcon Name="list-plus" Size="16" Class="mr-1" />
                                        @L.T("添加到列表", "Add to List")
                                    </AtomBlazor.DropdownMenuItem>
                                </DropdownMenuGroup>
                                <DropdownMenuSeparator />
                                <DropdownMenuGroup>
                                    <AtomBlazor.DropdownMenuItem Class="text-destructive focus:text-destructive">
                                        <LucideIcon Name="trash-2" Size="16" Class="mr-1" />
                                        @L.T("删除", "Trash")
                                    </AtomBlazor.DropdownMenuItem>
                                </DropdownMenuGroup>
                            </AtomBlazor.DropdownMenuContent>
                        </DropdownMenu>
                    </ButtonGroup>
                </ButtonGroup>

                <CodeBlock Source="Components/ButtonGroup/dropdown-integration.txt" />
            </div>
        </div>
    </section>

    <!-- Button Group with Popover -->
    <section class="space-y-6">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("按钮组搭配 Popover", "Button Group with Popover")</h2>
            <p class="text-muted-foreground">
                @L.T("将 Popover 组件与 ButtonGroup 集成，做出更丰富的交互界面。", "Integrate Popover components with ButtonGroup for rich interactive UIs.")
            </p>
        </div>

        <div class="space-y-6">
            <!-- Copilot Agent Tasks Example -->
            <div class="space-y-2">
                <h3 class="text-sm font-medium">@L.T("智能体任务 Popover", "Agent Tasks Popover")</h3>
                <ButtonGroup>
                    <Button Variant="ButtonVariant.Outline">
                        <LucideIcon Name="bot" Size="16" />
                        Copilot
                    </Button>
                    <Popover>
                        <AtomBlazor.PopoverTrigger>
                            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="!rounded-l-none" AriaLabel="@(L.T("打开弹出面板", "Open Popover"))">
                                <LucideIcon Name="chevron-down" Size="16" />
                            </Button>
                        </AtomBlazor.PopoverTrigger>
                        <AtomBlazor.PopoverContent Align="@PopoverAlign.End" Class="rounded-xl p-0 text-sm w-80">
                            <div class="px-3 py-2">
                                <div class="text-sm font-medium">@L.T("智能体任务", "Agent Tasks")</div>
                            </div>
                            <Separator />
                            <div class="p-3 text-sm space-y-2">
                                <textarea
                                    placeholder="@(L.T("用自然语言描述你的任务。", "Describe your task in natural language."))"
                                    rows="2"
                                    class="flex min-h-[60px] w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 resize-none"></textarea>
                                <p class="font-medium text-sm">@L.T("用 Copilot 开始一个新任务", "Start a new task with Copilot")</p>
                                <p class="text-muted-foreground text-xs leading-relaxed">
                                    @L.T("用自然语言描述你的任务。Copilot 会在后台完成工作，并为你的审阅打开一个拉取请求。", "Describe your task in natural language. Copilot will work in the background and open a pull request for your review.")
                                </p>
                            </div>
                        </AtomBlazor.PopoverContent>
                    </Popover>
                </ButtonGroup>

                <CodeBlock Source="Components/ButtonGroup/popover-integration.txt" />
            </div>
        </div>
    </section>

    <!-- Button Group with Select -->
    <section class="space-y-6">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("按钮组搭配 Select", "Button Group with Select")</h2>
            <p class="text-muted-foreground">
                @L.T("将 Select 下拉框与 Input、Button 组件组合，构建丰富的表单控件。", "Combine Select dropdowns with Input and Button components for rich form controls.")
            </p>
        </div>

        <div class="space-y-6">
            <!-- Currency Converter Example -->
            <div class="space-y-2">
                <h3 class="text-sm font-medium">@L.T("货币换算", "Currency Converter")</h3>
                <ButtonGroup>
                    <ButtonGroup>
                        <Select @bind-Value="selectedCurrency" TValue="string">
                            <AtomBlazor.SelectTrigger Class="font-mono w-[70px] !gap-1 px-2 !rounded-r-none">
                                <AtomBlazor.SelectValue Placeholder="$" />
                            </AtomBlazor.SelectTrigger>
                            <AtomBlazor.SelectContent Class="min-w-36">
                                <AtomBlazor.SelectItem Value="@("$")" Text="@(L.T("$ 美元", "$ US Dollar"))" TValue="string">
                                    <span class="font-mono">$</span> <span class="text-muted-foreground">@L.T("美元", "US Dollar")</span>
                                </AtomBlazor.SelectItem>
                                <AtomBlazor.SelectItem Value="@("€")" Text="@(L.T("€ 欧元", "€ Euro"))" TValue="string">
                                    <span class="font-mono">€</span> <span class="text-muted-foreground">@L.T("欧元", "Euro")</span>
                                </AtomBlazor.SelectItem>
                                <AtomBlazor.SelectItem Value="@("£")" Text="@(L.T("£ 英镑", "£ British Pound"))" TValue="string">
                                    <span class="font-mono">£</span> <span class="text-muted-foreground">@L.T("英镑", "British Pound")</span>
                                </AtomBlazor.SelectItem>
                            </AtomBlazor.SelectContent>
                        </Select>
                        <Input Type="InputType.Text" Placeholder="10.00" Class="!rounded-l-none !border-l-0 !focus-visible:ring-1 !focus-visible:ring-offset-0" />
                    </ButtonGroup>
                    <ButtonGroup>
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" AriaLabel="@(L.T("发送", "Send"))">
                            <LucideIcon Name="arrow-right" Size="16" />
                        </Button>
                    </ButtonGroup>
                </ButtonGroup>

                <CodeBlock Source="Components/ButtonGroup/select-integration.txt" />
            </div>
        </div>
    </section>

    <AccessibilityList>
        <AriaAttributes>
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    为读屏软件正确使用 role="group"
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    Uses proper role="group" for screen readers
                </AccessibilityItem>
                        </text>
}
            <AccessibilityItem>
                @L.T("仅图标的按钮应带有 aria-label 属性", "Icon-only buttons should have aria-label attributes")
            </AccessibilityItem>
            <AccessibilityItem>
                @L.T("焦点状态通过 ring 指示器清晰可见", "Focus states are clearly visible with ring indicators")
            </AccessibilityItem>
        </AriaAttributes>
        <KeyboardNavigation>
            <KeyboardShortcutItem Description="@(L.T("在按钮之间移动", "Navigate between buttons"))">
                <Kbd>Tab</Kbd> / <Kbd>Shift+Tab</Kbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("激活获得焦点的按钮", "Activate focused button"))">
                <Kbd>Enter</Kbd> / <Kbd>Space</Kbd>
            </KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>

    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件属性与参数。", "Component properties and parameters.")</p>
        </div>

        <ApiReference ComponentName="ButtonGroup">
            <ApiParameter Name="Orientation" Type="ButtonGroupOrientation" Default="ButtonGroupOrientation.Horizontal">@L.T("获取或设置按钮组的排列方向。", "Gets or sets the orientation of the button group.")</ApiParameter>
            <ApiParameter Name="Class" Type="string?">@L.T("获取或设置追加到按钮组上的额外 CSS 类。", "Gets or sets additional CSS classes to apply to the button group.")</ApiParameter>
            <ApiParameter Name="AriaLabel" Type="string?">@L.T("获取或设置按钮组的 ARIA 标签。", "Gets or sets the ARIA label for the button group.")</ApiParameter>
            <ApiParameter Name="ChildContent" Type="RenderFragment?">@L.T("获取或设置渲染在按钮组内部的内容。", "Gets or sets the content to be rendered inside the button group.")</ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">@L.T("获取或设置追加到按钮组元素上的额外 HTML 属性。", "Gets or sets additional HTML attributes to apply to the button group element.")</ApiParameter>
        </ApiReference>

        <ApiReference ComponentName="ButtonGroupSeparator">
            <ApiParameter Name="Orientation" Type="SeparatorOrientation" Default="AtomBlazor.SeparatorOrientation.Vertical">@L.T("获取或设置分隔线的排列方向。", "Gets or sets the orientation of the separator.")</ApiParameter>
            <ApiParameter Name="Decorative" Type="bool" Default="true">@L.T("获取或设置该分隔线是否仅作装饰用途。", "Gets or sets whether the separator is purely decorative.")</ApiParameter>
            <ApiParameter Name="Class" Type="string?">@L.T("获取或设置追加到分隔线上的额外 CSS 类。", "Gets or sets additional CSS classes to apply to the separator.")</ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">@L.T("获取或设置追加到根元素上的额外 HTML 属性。", "Gets or sets additional HTML attributes to apply to the root element.")</ApiParameter>
        </ApiReference>

        <ApiReference ComponentName="ButtonGroupText">
            <ApiParameter Name="Class" Type="string?">@L.T("获取或设置追加到文本容器上的额外 CSS 类。", "Gets or sets additional CSS classes to apply to the text container.")</ApiParameter>
            <ApiParameter Name="ChildContent" Type="RenderFragment?">@L.T("获取或设置渲染在文本容器内部的内容。", "Gets or sets the content to be rendered inside the text container.")</ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">@L.T("获取或设置追加到文本容器元素上的额外 HTML 属性。", "Gets or sets additional HTML attributes to apply to the text container element.")</ApiParameter>
        </ApiReference>
    </section>

</div>

