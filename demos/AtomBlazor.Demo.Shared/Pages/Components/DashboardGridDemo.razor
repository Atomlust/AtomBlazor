@page "/components/dashboard-grid"
@using System.Text.Json

<PageTitle>@L.T("仪表盘网格 - Atom BlazorUI", "Dashboard Grid - Atom BlazorUI")</PageTitle>

<style>
    .styled-widget-dark {
        background-color: #18181b !important;
        border-color: rgba(63, 63, 70, 0.5) !important;
        color: #fff !important;
    }
    .styled-header-gradient {
        background: linear-gradient(to right, #2563eb, #06b6d4) !important;
        border-color: rgba(63, 63, 70, 0.5) !important;
        color: #fff !important;
    }
    .styled-widget-warm {
        --styled-accent: #ea580c;
        background-color: rgba(255, 247, 237, 0.5) !important;
        border-color: rgba(253, 186, 116, 0.4) !important;
    }
    .styled-header-warm {
        border-color: rgba(253, 186, 116, 0.4) !important;
    }
    .styled-widget-cool {
        --styled-accent: #0d9488;
        background-color: rgba(240, 253, 250, 0.5) !important;
        border-color: rgba(153, 246, 228, 0.4) !important;
    }
    .styled-header-cool {
        border-color: rgba(153, 246, 228, 0.4) !important;
    }
    .dark .styled-widget-warm {
        --styled-accent: #fb923c;
        background-color: rgba(124, 45, 18, 0.15) !important;
        border-color: rgba(154, 52, 18, 0.25) !important;
    }
    .dark .styled-header-warm {
        border-color: rgba(154, 52, 18, 0.25) !important;
    }
    .dark .styled-widget-cool {
        --styled-accent: #2dd4bf;
        background-color: rgba(4, 47, 46, 0.25) !important;
        border-color: rgba(17, 94, 89, 0.25) !important;
    }
    .dark .styled-header-cool {
        border-color: rgba(17, 94, 89, 0.25) !important;
    }
</style>

<div class="space-y-8 max-w-7xl">
    <div class="space-y-4">
        <h1 class="text-4xl font-bold tracking-tight">@L.T("仪表盘网格", "Dashboard Grid")</h1>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-xl text-muted-foreground">
                用于搭建仪表盘的拖放式、可调整尺寸的小组件布局。基于 CSS Grid 构建，
                支持响应式断点、状态持久化与完整的键盘无障碍。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-xl text-muted-foreground">
                A drag-and-drop, resizable widget layout for composing dashboards. Built on CSS Grid
                with responsive breakpoints, state persistence, and full keyboard accessibility.
            </p>
                </text>
}
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground leading-relaxed max-w-3xl">
                在 <code class="bg-muted px-1 py-0.5 rounded">DashboardGrid</code> 里用
                <code class="bg-muted px-1 py-0.5 rounded">DashboardWidget</code> 摆放小组件。
                拖动即可重新排序，抓住句柄即可调整尺寸。用 <code class="bg-muted px-1 py-0.5 rounded">@@bind-State</code>
                配合 <code class="bg-muted px-1 py-0.5 rounded">Save()</code> /
                <code class="bg-muted px-1 py-0.5 rounded">Restore()</code> 可跨会话保存布局。
                网格会自动适配响应式断点。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground leading-relaxed max-w-3xl">
                Place widgets with <code class="bg-muted px-1 py-0.5 rounded">DashboardWidget</code> inside a
                <code class="bg-muted px-1 py-0.5 rounded">DashboardGrid</code>. Widgets can be dragged to reorder
                and resized by their handles. Use <code class="bg-muted px-1 py-0.5 rounded">@@bind-State</code> with
                <code class="bg-muted px-1 py-0.5 rounded">Save()</code> /
                <code class="bg-muted px-1 py-0.5 rounded">Restore()</code> to persist layouts across sessions.
                The grid automatically adapts to responsive breakpoints.
            </p>
                </text>
}
    </div>

    <!-- ── Basic Static Dashboard ──────────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("基础静态看板", "Basic Static Dashboard")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    一个以静态方式摆放小组件的简单网格。设置
                    <code class="bg-muted px-1 py-0.5 rounded">Editable="false"</code> 可禁用拖拽与缩放。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    A simple grid with statically placed widgets. Set
                    <code class="bg-muted px-1 py-0.5 rounded">Editable="false"</code> to disable drag and resize.
                </p>
                        </text>
}
        </div>
        <DashboardGrid Editable="false">
            <AtomBlazor.DashboardWidget Id="static-1" Column="1" Row="1" ColumnSpan="8" RowSpan="6" Title="@(L.T("营收", "Revenue"))">
                <div class="flex flex-col items-center justify-center h-full">
                    <span class="text-3xl font-bold">$48,250</span>
                    <span class="text-sm text-muted-foreground">@L.T("较上月 +12.5%", "+12.5% from last month")</span>
                </div>
            </AtomBlazor.DashboardWidget>
            <AtomBlazor.DashboardWidget Id="static-2" Column="9" Row="1" ColumnSpan="8" RowSpan="6" Title="@(L.T("用户", "Users"))">
                <div class="flex flex-col items-center justify-center h-full">
                    <span class="text-3xl font-bold">2,420</span>
                    <span class="text-sm text-muted-foreground">@L.T("较上月 +8.1%", "+8.1% from last month")</span>
                </div>
            </AtomBlazor.DashboardWidget>
            <AtomBlazor.DashboardWidget Id="static-3" Column="17" Row="1" ColumnSpan="8" RowSpan="6" Title="@(L.T("订单", "Orders"))">
                <div class="flex flex-col items-center justify-center h-full">
                    <span class="text-3xl font-bold">1,210</span>
                    <span class="text-sm text-muted-foreground">@L.T("较上月 +3.2%", "+3.2% from last month")</span>
                </div>
            </AtomBlazor.DashboardWidget>
            <AtomBlazor.DashboardWidget Id="static-4" Column="1" Row="7" ColumnSpan="16" RowSpan="8" Title="@(L.T("销售概览", "Sales Overview"))">
                <div class="flex items-center justify-center h-full text-muted-foreground">
                    @L.T("图表占位区——此处可放 AreaChart 或 BarChart", "Chart placeholder — use AreaChart or BarChart here")
                </div>
            </AtomBlazor.DashboardWidget>
            <AtomBlazor.DashboardWidget Id="static-5" Column="17" Row="7" ColumnSpan="8" RowSpan="8" Title="@(L.T("最近动态", "Recent Activity"))">
                <div class="space-y-3 text-sm">
                    <div class="flex justify-between"><span>@L.T("新用户注册", "New signup")</span><span class="text-muted-foreground">@L.T("2 分钟前", "2m ago")</span></div>
                    <div class="flex justify-between"><span>@L.T("订单已下单", "Order placed")</span><span class="text-muted-foreground">@L.T("5 分钟前", "5m ago")</span></div>
                    <div class="flex justify-between"><span>@L.T("款项已到账", "Payment received")</span><span class="text-muted-foreground">@L.T("12 分钟前", "12m ago")</span></div>
                    <div class="flex justify-between"><span>@L.T("用户已升级", "User upgraded")</span><span class="text-muted-foreground">@L.T("1 小时前", "1h ago")</span></div>
                </div>
            </AtomBlazor.DashboardWidget>
        </DashboardGrid>
        <CodeBlock Source="Components/DashboardGrid/basic-static.txt" />
    </div>

    <!-- ── Editable (Drag + Resize) ───────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("可编辑（拖拽 + 缩放）", "Editable (Drag + Resize)")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    把指针移到小组件上，即可显示拖拽句柄（表头里的抓手图标）与缩放句柄（四角与四边）。
                    拖动可重新排序，拉拽句柄可调整尺寸。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Hover over a widget to reveal the drag handle (grip icon in the header) and resize handles (corners and edges).
                    Drag to reorder, resize by pulling the handles.
                </p>
                        </text>
}
        </div>
        <DashboardGrid @bind-State="editableState">
            @foreach (var widget in editableWidgets)
            {
                @if (L.IsChinese)
                {
                                <text>
                                    <AtomBlazor.DashboardWidget @key="widget.Id" Id="@widget.Id" Column="@widget.Column" Row="@widget.Row"
                                      ColumnSpan="@widget.ColSpan" RowSpan="@widget.RowSpan" Title="@widget.TitleZh"
                                      OnRemove="RemoveEditableWidget">
                        <div class="flex items-center justify-center h-full text-muted-foreground">
                            @widget.DescriptionZh
                        </div>
                    </AtomBlazor.DashboardWidget>
                                </text>
}
                else
                {
                                <text>
                                    <AtomBlazor.DashboardWidget @key="widget.Id" Id="@widget.Id" Column="@widget.Column" Row="@widget.Row"
                                      ColumnSpan="@widget.ColSpan" RowSpan="@widget.RowSpan" Title="@widget.Title"
                                      OnRemove="RemoveEditableWidget">
                        <div class="flex items-center justify-center h-full text-muted-foreground">
                            @widget.Description
                        </div>
                    </AtomBlazor.DashboardWidget>
                                </text>
}
            }
        </DashboardGrid>
        <CodeBlock Source="Components/DashboardGrid/editable.txt" />
    </div>

    <!-- ── Responsive Breakpoints ──────────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("响应式断点", "Responsive Breakpoints")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    网格会在不同视口宽度下自动调整列数。
                    <code class="bg-muted px-1 py-0.5 rounded">MediumColumns="12"</code> 对应 1024px，
                    <code class="bg-muted px-1 py-0.5 rounded">SmallColumns="2"</code> 对应 768px。
                    缩放浏览器窗口即可看到布局随之适配。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    The grid automatically adjusts columns at different viewport widths.
                    <code class="bg-muted px-1 py-0.5 rounded">MediumColumns="12"</code> at 1024px,
                    <code class="bg-muted px-1 py-0.5 rounded">SmallColumns="2"</code> at 768px.
                    Resize your browser to see the layout adapt.
                </p>
                        </text>
}
        </div>
        <DashboardGrid Columns="24" RowHeight="30" Gap="6"
                         MediumColumns="12" SmallColumns="4"
                         MediumBreakpoint="1024" SmallBreakpoint="768"
                         Editable="false"
                         OnBreakpointChanged="HandleBreakpointChanged">
            <AtomBlazor.DashboardWidget Id="resp-1" Column="1" Row="1" ColumnSpan="6" RowSpan="4" Title="@(L.T("指标 1", "Metric 1"))">
                <div class="flex items-center justify-center h-full font-bold text-2xl">42</div>
            </AtomBlazor.DashboardWidget>
            <AtomBlazor.DashboardWidget Id="resp-2" Column="7" Row="1" ColumnSpan="6" RowSpan="4" Title="@(L.T("指标 2", "Metric 2"))">
                <div class="flex items-center justify-center h-full font-bold text-2xl">87</div>
            </AtomBlazor.DashboardWidget>
            <AtomBlazor.DashboardWidget Id="resp-3" Column="13" Row="1" ColumnSpan="6" RowSpan="4" Title="@(L.T("指标 3", "Metric 3"))">
                <div class="flex items-center justify-center h-full font-bold text-2xl">156</div>
            </AtomBlazor.DashboardWidget>
            <AtomBlazor.DashboardWidget Id="resp-4" Column="19" Row="1" ColumnSpan="6" RowSpan="4" Title="@(L.T("指标 4", "Metric 4"))">
                <div class="flex items-center justify-center h-full font-bold text-2xl">73</div>
            </AtomBlazor.DashboardWidget>
        </DashboardGrid>
        @if (currentBreakpoint != null)
        {
            <p class="text-sm text-muted-foreground">
                @L.T("当前断点：", "Current breakpoint:") <Badge>@currentBreakpoint</Badge>
            </p>
        }
        <CodeBlock Source="Components/DashboardGrid/responsive.txt" />
    </div>

    <!-- ── Toggle Edit Mode ────────────────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("切换编辑模式", "Toggle Edit Mode")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    用 <code class="bg-muted px-1 py-0.5 rounded">Editable</code> 参数在运行时切换拖拽与缩放。
                    点击按钮即可在两种模式之间切换。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use the <code class="bg-muted px-1 py-0.5 rounded">Editable</code> parameter to toggle
                    drag and resize at runtime. Click the button to switch modes.
                </p>
                        </text>
}
        </div>
        <Button OnClick="() => isEditable = !isEditable" Variant="ButtonVariant.Outline" Size="ButtonSize.Small">
            @(isEditable ? L.T("锁定仪表盘", "Lock Dashboard") : L.T("编辑仪表盘", "Edit Dashboard"))
        </Button>
        <DashboardGrid Editable="@isEditable">
            <AtomBlazor.DashboardWidget Id="toggle-1" Column="1" Row="1" ColumnSpan="12" RowSpan="6" Title="@(L.T("可编辑小组件", "Editable Widget"))">
                <div class="flex items-center justify-center h-full text-muted-foreground">
                    @(isEditable ? L.T("悬停时显示拖拽句柄", "Drag handles visible on hover") : L.T("编辑已禁用", "Editing disabled"))
                </div>
            </AtomBlazor.DashboardWidget>
            <AtomBlazor.DashboardWidget Id="toggle-2" Column="13" Row="1" ColumnSpan="12" RowSpan="6" Title="@(L.T("另一个小组件", "Another Widget"))">
                <div class="flex items-center justify-center h-full text-muted-foreground">
                    @(isEditable ? L.T("悬停时显示缩放句柄", "Resize handles visible on hover") : L.T("编辑已禁用", "Editing disabled"))
                </div>
            </AtomBlazor.DashboardWidget>
        </DashboardGrid>
        <CodeBlock Source="Components/DashboardGrid/toggle-edit.txt" />
    </div>

    <!-- ── Freeform Layout ─────────────────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("自由布局", "Freeform Layout")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    设置 <code class="bg-muted px-1 py-0.5 rounded">Compact="false"</code> 可关闭自动压实。
                    小组件会恰好留在你放置的位置——不会吸附去填补空隙。运行时切换它，
                    即可在自由布局与压实模式之间切换。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Set <code class="bg-muted px-1 py-0.5 rounded">Compact="false"</code> to disable automatic compaction.
                    Widgets stay exactly where you place them — no snapping to fill gaps. Toggle it at runtime to switch
                    between freeform and compact modes.
                </p>
                        </text>
}
        </div>
        <Button OnClick="() => isFreeformCompact = !isFreeformCompact" Variant="ButtonVariant.Outline" Size="ButtonSize.Small">
            @(isFreeformCompact ? L.T("切换为自由布局", "Switch to Freeform") : L.T("切换为压实布局", "Switch to Compact"))
        </Button>
        <DashboardGrid Compact="@isFreeformCompact" Border="true">
            <AtomBlazor.DashboardWidget Id="freeform-1" Column="1" Row="1" ColumnSpan="8" RowSpan="6" Title="@(L.T("小组件 A", "Widget A"))">
                <div class="flex items-center justify-center h-full text-muted-foreground">
                    @(isFreeformCompact ? L.T("压实模式——小组件彼此吸附", "Compact — widgets snap together") : L.T("自由布局——可放在任意位置", "Freeform — place anywhere"))
                </div>
            </AtomBlazor.DashboardWidget>
            <AtomBlazor.DashboardWidget Id="freeform-2" Column="1" Row="9" ColumnSpan="8" RowSpan="6" Title="@(L.T("小组件 B", "Widget B"))">
                <div class="flex items-center justify-center h-full text-muted-foreground">
                    @L.T("试着用方向键移动我", "Try moving me with arrow keys")
                </div>
            </AtomBlazor.DashboardWidget>
            <AtomBlazor.DashboardWidget Id="freeform-3" Column="17" Row="1" ColumnSpan="8" RowSpan="6" Title="@(L.T("小组件 C", "Widget C"))">
                <div class="flex items-center justify-center h-full text-muted-foreground">
                    @L.T("自由布局模式下空隙会被保留", "Gaps are preserved in freeform mode")
                </div>
            </AtomBlazor.DashboardWidget>
        </DashboardGrid>
        <CodeBlock Source="Components/DashboardGrid/freeform.txt" />
    </div>

    <!-- ── Fixed Cell Size ────────────────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("固定单元格尺寸", "Fixed Cell Size")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    设置 <code class="bg-muted px-1 py-0.5 rounded">CellWidth</code> 可创建带有固定大小方形单元格的严格网格。
                    用 <code class="bg-muted px-1 py-0.5 rounded">MaxWidth</code> 约束容器宽度，
                    网格超出时会自动启用横向滚动。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Set <code class="bg-muted px-1 py-0.5 rounded">CellWidth</code> to create a strict grid with fixed-size
                    square cells. Use <code class="bg-muted px-1 py-0.5 rounded">MaxWidth</code> to constrain the container
                    and enable horizontal scrolling when the grid exceeds it.
                </p>
                        </text>
}
        </div>
        <DashboardGrid @bind-State="fixedCellState" Columns="24" RowHeight="40" CellWidth="40" Gap="8" MaxWidth="800" Border="true">
            <AtomBlazor.DashboardWidget Id="fixed-1" Column="1" Row="1" ColumnSpan="8" RowSpan="6" Title="@(L.T("小组件 A", "Widget A"))">
                <div class="flex items-center justify-center h-full text-muted-foreground text-sm">
                    @L.T("8 × 6 个单元格", "8 × 6 cells")
                </div>
            </AtomBlazor.DashboardWidget>
            <AtomBlazor.DashboardWidget Id="fixed-2" Column="9" Row="1" ColumnSpan="8" RowSpan="6" Title="@(L.T("小组件 B", "Widget B"))">
                <div class="flex items-center justify-center h-full text-muted-foreground text-sm">
                    @L.T("8 × 6 个单元格", "8 × 6 cells")
                </div>
            </AtomBlazor.DashboardWidget>
            <AtomBlazor.DashboardWidget Id="fixed-3" Column="17" Row="1" ColumnSpan="8" RowSpan="6" Title="@(L.T("小组件 C", "Widget C"))">
                <div class="flex items-center justify-center h-full text-muted-foreground text-sm">
                    @L.T("8 × 6 个单元格", "8 × 6 cells")
                </div>
            </AtomBlazor.DashboardWidget>
        </DashboardGrid>
    </div>

    <!-- ── State Persistence ───────────────────────────────────────── -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("状态持久化", "State Persistence")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    用 <code class="bg-muted px-1 py-0.5 rounded">Save()</code> 与
                    <code class="bg-muted px-1 py-0.5 rounded">Restore()</code> 序列化并还原
                    网格布局。状态可以存进 localStorage、数据库或任意其他存储。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use <code class="bg-muted px-1 py-0.5 rounded">Save()</code> and
                    <code class="bg-muted px-1 py-0.5 rounded">Restore()</code> to serialize and restore
                    the grid layout. The state can be persisted to localStorage, a database, or any other storage.
                </p>
                        </text>
}
        </div>
        <div class="flex gap-2">
            <Button OnClick="SaveState" Variant="ButtonVariant.Outline" Size="ButtonSize.Small">@L.T("保存布局", "Save Layout")</Button>
            <Button OnClick="RestoreState" Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="@(savedSnapshot == null)">@L.T("还原布局", "Restore Layout")</Button>
            <Button OnClick="ResetState" Variant="ButtonVariant.Destructive" Size="ButtonSize.Small">@L.T("重置", "Reset")</Button>
        </div>
        <DashboardGrid @bind-State="persistState">
            <AtomBlazor.DashboardWidget Id="persist-1" Column="1" Row="1" ColumnSpan="8" RowSpan="6" Title="@(L.T("小组件 1", "Widget 1"))">
                <div class="flex items-center justify-center h-full text-muted-foreground">@L.T("拖拽并缩放，然后保存", "Drag and resize, then save")</div>
            </AtomBlazor.DashboardWidget>
            <AtomBlazor.DashboardWidget Id="persist-2" Column="9" Row="1" ColumnSpan="8" RowSpan="6" Title="@(L.T("小组件 2", "Widget 2"))">
                <div class="flex items-center justify-center h-full text-muted-foreground">@L.T("随意移动我", "Move me around")</div>
            </AtomBlazor.DashboardWidget>
            <AtomBlazor.DashboardWidget Id="persist-3" Column="17" Row="1" ColumnSpan="8" RowSpan="6" Title="@(L.T("小组件 3", "Widget 3"))">
                <div class="flex items-center justify-center h-full text-muted-foreground">@L.T("然后再还原", "Then restore")</div>
            </AtomBlazor.DashboardWidget>
        </DashboardGrid>
        @if (savedSnapshot != null)
        {
            <pre class="text-xs bg-muted p-3 rounded-lg overflow-auto max-h-40">@JsonSerializer.Serialize(savedSnapshot, jsonOptions)</pre>
