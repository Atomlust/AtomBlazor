@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    // Editable state
    private AtomBlazor.Primitives.DashboardGridState editableState = new();
    private AtomBlazor.Primitives.DashboardGridState customStyleState = new();
    private bool customStyleEditable = true;
    private List<DynamicWidget> editableWidgets = new()
    {
        new() { Id = "edit-1", Title = "Widget A", TitleZh = "小组件 A", Description = "Drag me or resize from the bottom-right corner", DescriptionZh = "拖动我，或从右下角缩放", Column = 1, Row = 1, ColSpan = 12, RowSpan = 6 },
        new() { Id = "edit-2", Title = "Widget B", TitleZh = "小组件 B", Description = "I can also be dragged and resized", DescriptionZh = "我同样可以拖动和缩放", Column = 13, Row = 1, ColSpan = 12, RowSpan = 6 },
        new() { Id = "edit-3", Title = "Widget C", TitleZh = "小组件 C", Description = "Small widget", DescriptionZh = "窄小的小组件", Column = 1, Row = 7, ColSpan = 8, RowSpan = 6 },
        new() { Id = "edit-4", Title = "Widget D", TitleZh = "小组件 D", Description = "Wide widget", DescriptionZh = "宽一些的小组件", Column = 9, Row = 7, ColSpan = 16, RowSpan = 6 },
    };

    // Toggle edit mode
    private bool isEditable = true;

    // Freeform layout
    private bool isFreeformCompact = true;

    // Fixed cell size
    private AtomBlazor.Primitives.DashboardGridState fixedCellState = new();

    // Responsive breakpoint
    private AtomBlazor.Primitives.DashboardBreakpoint? currentBreakpoint;

    // State persistence
    private AtomBlazor.Primitives.DashboardGridState persistState = new();
    private AtomBlazor.Primitives.DashboardGridStateSnapshot? savedSnapshot;
    private static readonly JsonSerializerOptions jsonOptions = new() { WriteIndented = true };

    // Dynamic widgets
    private List<DynamicWidget> dynamicWidgets = new();
    private int nextWidgetId = 1;

    private void HandleBreakpointChanged(AtomBlazor.Primitives.DashboardBreakpoint bp) =>
        currentBreakpoint = bp;

    private void SaveState()
    {
        savedSnapshot = persistState.Save();
        // BL0012（.NET 11）：事件处理器触发的重渲染由框架自动完成，此处的显式 StateHasChanged 无需保留。
    }

    private void RestoreState()
    {
        if (savedSnapshot != null)
        {
            persistState.Restore(savedSnapshot);
            // BL0012（.NET 11）：事件处理器触发的重渲染由框架自动完成，此处的显式 StateHasChanged 无需保留。
        }
    }

    private void ResetState()
    {
        persistState.Reset();
        savedSnapshot = null;
        // BL0012（.NET 11）：事件处理器触发的重渲染由框架自动完成，此处的显式 StateHasChanged 无需保留。
    }

    private void AddWidget()
    {
        var id = nextWidgetId++;
        var index = dynamicWidgets.Count;
        var col = (index % 3) * 8 + 1;
        var row = (index / 3) * 6 + 1;

        dynamicWidgets.Add(new DynamicWidget
        {
            Id = $"dynamic-{id}",
            Title = $"Widget {id}",
            TitleZh = $"小组件 {id}",
            Column = col,
            Row = row,
            ColSpan = 8,
            RowSpan = 6
        });
    }

    private void RemoveEditableWidget(string widgetId) =>
        editableWidgets.RemoveAll(w => w.Id == widgetId);

    private void RemoveDynamicWidget(string widgetId) =>
        dynamicWidgets.RemoveAll(w => w.Id == widgetId);

    private void RemoveWidget(string widgetId) =>
        dynamicWidgets.RemoveAll(w => w.Id == widgetId);

    private void RemoveLastWidget()
    {
        if (dynamicWidgets.Count > 0)
        {
            dynamicWidgets.RemoveAt(dynamicWidgets.Count - 1);
        }
    }

    private class DynamicWidget
    {
        public string Id { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string TitleZh { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string DescriptionZh { get; set; } = string.Empty;
        public int Column { get; set; } = 1;
        public int Row { get; set; } = 1;
        public int ColSpan { get; set; } = 8;
        public int RowSpan { get; set; } = 6;
    }

    // ── Data-Driven Dashboard ──

    private DashboardGrid? dataDrivenGridRef;
    private AtomBlazor.Primitives.DashboardGridState dataDrivenGridState = new();
    private List<DataDrivenWidgetConfig> dataDrivenWidgets = new();
    private bool dataDrivenLoaded;
    private bool dataDrivenLoading;
    private string? dataDrivenSavedJson;

    private async Task LoadDataDrivenDashboard()
    {
        dataDrivenLoading = true;
        // BL0012（.NET 11）：事件处理器触发的重渲染由框架自动完成，此处的显式 StateHasChanged 无需保留。

        await Task.Delay(800);

        var payload = JsonSerializer.Deserialize<DataDrivenPayload>(sampleDataDrivenJson, dataDrivenJsonOptions)!;
        dataDrivenWidgets = payload.Widgets;

        dataDrivenGridState = new AtomBlazor.Primitives.DashboardGridState();
        foreach (var w in dataDrivenWidgets)
        {
            dataDrivenGridState.RegisterWidget(w.Id, w.Column, w.Row, w.ColSpan, w.RowSpan);
        }

        dataDrivenLoaded = true;
        dataDrivenLoading = false;
        dataDrivenSavedJson = null;
    }

    private void UnloadDataDrivenDashboard()
    {
        dataDrivenWidgets.Clear();
        dataDrivenGridState = new AtomBlazor.Primitives.DashboardGridState();
        dataDrivenLoaded = false;
        dataDrivenSavedJson = null;
    }

    private void SaveDataDrivenDashboard()
    {
        var config = dataDrivenGridRef?.GetConfig();
        dataDrivenSavedJson = config != null ? JsonSerializer.Serialize(config, dataDrivenJsonOptions) : null;
    }

    private void RemoveDataDrivenWidget(string widgetId)
    {
        dataDrivenWidgets.RemoveAll(w => w.Id == widgetId);
    }

    private RenderFragment RenderDataDrivenWidgetContent(DataDrivenWidgetConfig widget) => @<text>
                            @switch (widget.Type)
    {
        case "bar-chart":
        {
            <BarChart Data="@GetDataDrivenTimeSeries(widget)" Height="100%">
                <XAxis DataKey="month" />
                <YAxis Show="false" />
                <ChartTooltip />
                <Bar DataKey="value" Name="@widget.Title" Color="var(--chart-1)" />
            </BarChart>
            break;
        }
        case "area-chart":
        {
            <AreaChart Data="@GetDataDrivenTimeSeries(widget)" Height="100%">
                <XAxis DataKey="month" />
                <YAxis Show="false" />
                <ChartTooltip />
                <AtomBlazor.Area DataKey="value" Name="@widget.Title" Color="var(--chart-2)" Curve="CurveType.Smooth">
                    <Fill>
                        <LinearGradient>
                            <GradientStop Offset="0" Color="var(--chart-2)" Opacity="0.5" />
                            <GradientStop Offset="1" Color="var(--chart-2)" Opacity="0.05" />
                        </LinearGradient>
                    </Fill>
                </AtomBlazor.Area>
            </AreaChart>
            break;
        }
        case "line-chart":
        {
            <LineChart Data="@GetDataDrivenTimeSeries(widget)" Height="100%">
                <XAxis DataKey="month" />
                <YAxis Show="false" />
                <ChartTooltip />
                <Line DataKey="value" Name="@widget.Title" Color="var(--chart-3)" Curve="CurveType.Smooth" />
            </LineChart>
            break;
        }
        case "pie-chart":
        {
            <PieChart Data="@GetDataDrivenCategories(widget)" Height="100%">
                <ChartTooltip />
                <ChartLegend />
                <Pie DataKey="value" NameKey="name" />
            </PieChart>
            break;
        }
        case "kpi":
        {
            var kpi = GetDataDrivenKpi(widget);
            <div class="flex flex-col items-center justify-center h-full gap-1">
                <span class="text-4xl font-bold tracking-tight">@kpi.Value</span>
                <span class="text-sm text-muted-foreground">@kpi.Label</span>
                @if (kpi.Change != null)
                {
                    var isPositive = kpi.Change.StartsWith("+");
                    <span class="text-xs @(isPositive ? "text-green-500" : "text-red-500")">
                        @kpi.Change @L.T("较上月", "from last month")
                    </span>
                }
            </div>
            break;
        }
        case "table":
        {
            var rows = GetDataDrivenTableRows(widget);
            <div class="overflow-auto h-full">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b text-left text-muted-foreground">
                            <th class="py-2 px-3 font-medium">@L.T("名称", "Name")</th>
                            <th class="py-2 px-3 font-medium text-right">@L.T("数值", "Value")</th>
                            <th class="py-2 px-3 font-medium text-right">@L.T("变化", "Change")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            <tr class="border-b last:border-0">
                                <td class="py-2 px-3">@row.Name</td>
                                <td class="py-2 px-3 text-right font-medium">@row.Value</td>
                                <td class="py-2 px-3 text-right @(row.IsPositive ? "text-green-500" : "text-red-500")">
                                    @row.Change
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            break;
        }
        default:
            @if (L.IsChinese)
            {
            <text>
                <div class="flex items-center justify-center h-full text-muted-foreground text-sm">未知的小组件类型：@widget.Type</div>
                        </text>
}
            else
            {
                        <text>
                            <div class="flex items-center justify-center h-full text-muted-foreground text-sm">Unknown widget type: @widget.Type</div>
                        </text>
}
            break;
    }
    </text>;

