            {
                        <text>
                            <p class="text-sm text-muted-foreground leading-relaxed max-w-3xl">
                    这种模式把<strong>布局</strong>（在网格中的位置）与
                    <strong>小组件配置</strong>（每个小组件展示什么）分开。两者一起存放在同一份
                    JSON 载荷里，按需加载。网格负责空间定位，你的代码负责把小组件类型映射到 Blazor 内容。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground leading-relaxed max-w-3xl">
                    This pattern separates <strong>layout</strong> (positions on the grid) from
                    <strong>widget configuration</strong> (what each widget displays). Both are stored
                    together in a single JSON payload and loaded on demand. The grid manages spatial
                    positioning while your code maps widget types to Blazor content.
                </p>
                        </text>
}
        </div>

        <div class="flex flex-wrap gap-2">
            @if (!dataDrivenLoaded)
            {
                <Button OnClick="LoadDataDrivenDashboard" Variant="ButtonVariant.Default" Size="ButtonSize.Small">
                    <LucideIcon Name="download" Class="h-4 w-4 mr-2" /> @L.T("加载仪表盘", "Load Dashboard")
                </Button>
            }
            else
            {
                <Button OnClick="SaveDataDrivenDashboard" Variant="ButtonVariant.Outline" Size="ButtonSize.Small">
                    <LucideIcon Name="save" Class="h-4 w-4 mr-2" /> @L.T("保存布局", "Save Layout")
                </Button>
                <Button OnClick="UnloadDataDrivenDashboard" Variant="ButtonVariant.Destructive" Size="ButtonSize.Small">
                    <LucideIcon Name="x" Class="h-4 w-4 mr-2" /> @L.T("卸载", "Unload")
                </Button>
            }
        </div>

        <DashboardGrid @ref="dataDrivenGridRef" @bind-State="dataDrivenGridState"
                         Loading="@dataDrivenLoading" Background="DashboardBackground.Grid" Border="true">
            @foreach (var widget in dataDrivenWidgets)
            {
                <AtomBlazor.DashboardWidget @key="widget.Id" Id="@widget.Id"
                                  Column="@widget.Column" Row="@widget.Row"
                                  ColumnSpan="@widget.ColSpan" RowSpan="@widget.RowSpan"
                                  Title="@widget.Title" OnRemove="RemoveDataDrivenWidget">
                    @RenderDataDrivenWidgetContent(widget)
                </AtomBlazor.DashboardWidget>
            }
        </DashboardGrid>

        @if (dataDrivenSavedJson != null)
        {
            <div class="space-y-2">
                <h3 class="text-sm font-semibold">@L.T("已保存的 JSON", "Saved JSON")</h3>
                <pre class="text-xs bg-muted p-4 rounded-lg overflow-auto max-h-60">@dataDrivenSavedJson</pre>
            </div>
        }
        <CodeBlock Source="Components/DashboardGrid/data-driven.txt" />
    </div>

