@page "/components/dropdown-menu"

<PageTitle>@L.T("下拉菜单组件 - Atom BlazorUI", "Dropdown Menu Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">@L.T("下拉菜单组件", "Dropdown Menu Component")</h1>
        <p class="text-xl text-muted-foreground">
            @L.T("由按钮触发的操作或选项菜单。", "Displays a menu of actions or options triggered by a button.")
        </p>
        </div>
    </div>

    <div class="space-y-6">
    </div>

    <!-- Basic Dropdown -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("基础下拉菜单", "Basic Dropdown Menu")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("一个带条目列表的简单下拉菜单。", "A simple dropdown menu with items.")
        </p>

        <div class="flex items-start gap-2">
            <DropdownMenu>
                <AtomBlazor.DropdownMenuTrigger AsChild="false" Class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2">
                    @L.T("打开菜单", "Open Menu")
                </AtomBlazor.DropdownMenuTrigger>
                <AtomBlazor.DropdownMenuContent>
                    <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleBasicAction("Profile"))">@L.T("个人资料", "Profile")</AtomBlazor.DropdownMenuItem>
                    <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleBasicAction("Settings"))">@L.T("设置", "Settings")</AtomBlazor.DropdownMenuItem>
                    <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleBasicAction("Billing"))">@L.T("账单", "Billing")</AtomBlazor.DropdownMenuItem>
                </AtomBlazor.DropdownMenuContent>
            </DropdownMenu>
            @if (!string.IsNullOrEmpty(basicAction))
            {
                <p class="text-sm">@L.T("最近一次操作：", "Last action:") <strong>@basicAction</strong></p>
            }
        </div>
        <CodeBlock Source="Components/DropdownMenu/basic.txt" />
    </section>

    <!-- With Labels and Separators -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("带标签与分隔线", "With Labels and Separators")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("用标签与视觉分隔线来组织菜单条目。", "Organize menu items with labels and visual separators.")
        </p>

        <div class="flex items-start gap-2">
            <DropdownMenu>
                <AtomBlazor.DropdownMenuTrigger AsChild="false" Class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2">
                    @L.T("我的账户", "My Account")
                </AtomBlazor.DropdownMenuTrigger>
                <AtomBlazor.DropdownMenuContent>
                    <DropdownMenuLabel>@L.T("我的账户", "My Account")</DropdownMenuLabel>
                    <DropdownMenuSeparator />
                    <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleLabelsAction("Profile"))">@L.T("个人资料", "Profile")</AtomBlazor.DropdownMenuItem>
                    <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleLabelsAction("Billing"))">@L.T("账单", "Billing")</AtomBlazor.DropdownMenuItem>
                    <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleLabelsAction("Settings"))">@L.T("设置", "Settings")</AtomBlazor.DropdownMenuItem>
                    <DropdownMenuSeparator />
                    <AtomBlazor.DropdownMenuItem Class="text-destructive" OnClick="@(() => HandleLabelsAction("Logout"))">@L.T("退出登录", "Logout")</AtomBlazor.DropdownMenuItem>
                </AtomBlazor.DropdownMenuContent>
            </DropdownMenu>
            @if (!string.IsNullOrEmpty(labelsAction))
            {
                <p class="text-sm">@L.T("最近一次操作：", "Last action:") <strong>@labelsAction</strong></p>
            }
        </div>
        <CodeBlock Source="Components/DropdownMenu/labels-separators.txt" />
    </section>

    <!-- With Groups -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("分组条目", "Grouped Items")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("把相关的菜单条目归到一组。", "Group related menu items together.")
        </p>

        <div class="flex items-start gap-2">
            <DropdownMenu>
                <AtomBlazor.DropdownMenuTrigger AsChild="false" Class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2">
                    @L.T("操作", "Actions")
                </AtomBlazor.DropdownMenuTrigger>
                <AtomBlazor.DropdownMenuContent>
                    <DropdownMenuLabel>@L.T("文件操作", "File Operations")</DropdownMenuLabel>
                    <DropdownMenuGroup>
                        <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleGroupsAction("New File"))">@L.T("新建文件", "New File")</AtomBlazor.DropdownMenuItem>
                        <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleGroupsAction("Open"))">@L.T("打开", "Open")</AtomBlazor.DropdownMenuItem>
                        <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleGroupsAction("Save"))">@L.T("保存", "Save")</AtomBlazor.DropdownMenuItem>
                    </DropdownMenuGroup>
                    <DropdownMenuSeparator />
                    <DropdownMenuLabel>@L.T("编辑操作", "Edit Operations")</DropdownMenuLabel>
                    <DropdownMenuGroup>
                        <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleGroupsAction("Cut"))">@L.T("剪切", "Cut")</AtomBlazor.DropdownMenuItem>
                        <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleGroupsAction("Copy"))">@L.T("复制", "Copy")</AtomBlazor.DropdownMenuItem>
                        <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleGroupsAction("Paste"))">@L.T("粘贴", "Paste")</AtomBlazor.DropdownMenuItem>
                    </DropdownMenuGroup>
                </AtomBlazor.DropdownMenuContent>
            </DropdownMenu>
            @if (!string.IsNullOrEmpty(groupsAction))
            {
                <p class="text-sm">@L.T("最近一次操作：", "Last action:") <strong>@groupsAction</strong></p>
            }
        </div>
        <CodeBlock Source="Components/DropdownMenu/grouped.txt" />
    </section>

    <!-- Alignment Options -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("对齐选项", "Alignment Options")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("控制下拉菜单相对触发器的对齐方式（Start、Center、End）。用小图标按钮测试，可以更清楚地看到对齐效果。", "Control how the dropdown aligns relative to its trigger (Start, Center, End). Test with small icon buttons to see alignment clearly.")
        </p>

        <div class="flex flex-wrap gap-4 items-start">
            <div class="flex flex-col gap-2 items-start">
                <DropdownMenu>
                    <AtomBlazor.DropdownMenuTrigger AsChild="false" Class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 w-10" aria-label="@(L.T("起始对齐菜单", "Start aligned menu"))">
                        <LucideIcon Name="menu" Size="16" />
                    </AtomBlazor.DropdownMenuTrigger>
                    <AtomBlazor.DropdownMenuContent Align="@PopoverAlign.Start">
                        <DropdownMenuLabel>@L.T("起始对齐", "Start Alignment")</DropdownMenuLabel>
                        <DropdownMenuSeparator />
                        <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleMenuAction("start", "Item 1"))">@L.T("条目 1", "Item 1")</AtomBlazor.DropdownMenuItem>
                        <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleMenuAction("start", "Item 2"))">@L.T("条目 2", "Item 2")</AtomBlazor.DropdownMenuItem>
                        <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleMenuAction("start", "Item 3"))">@L.T("条目 3", "Item 3")</AtomBlazor.DropdownMenuItem>
                    </AtomBlazor.DropdownMenuContent>
                </DropdownMenu>
                @if (GetMenuAction("start") != null)
                {
                    <p class="text-sm">@L.T("起始：", "Start:") <strong>@GetMenuAction("start")</strong></p>
                }
            </div>

            <div class="flex flex-col gap-2 items-start">
                <DropdownMenu>
                    <AtomBlazor.DropdownMenuTrigger AsChild="false" Class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 w-10" aria-label="@(L.T("居中对齐菜单", "Center aligned menu"))">
                        <LucideIcon Name="menu" Size="16" />
                    </AtomBlazor.DropdownMenuTrigger>
                    <AtomBlazor.DropdownMenuContent Align="@PopoverAlign.Center">
                        <DropdownMenuLabel>@L.T("居中对齐", "Center Alignment")</DropdownMenuLabel>
                        <DropdownMenuSeparator />
                        <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleMenuAction("center", "Item 1"))">@L.T("条目 1", "Item 1")</AtomBlazor.DropdownMenuItem>
                        <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleMenuAction("center", "Item 2"))">@L.T("条目 2", "Item 2")</AtomBlazor.DropdownMenuItem>
                        <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleMenuAction("center", "Item 3"))">@L.T("条目 3", "Item 3")</AtomBlazor.DropdownMenuItem>
                    </AtomBlazor.DropdownMenuContent>
                </DropdownMenu>
                @if (GetMenuAction("center") != null)
                {
                    <p class="text-sm">@L.T("居中：", "Center:") <strong>@GetMenuAction("center")</strong></p>
                }
            </div>

            <div class="flex flex-col gap-2 items-start">
                <DropdownMenu>
                    <AtomBlazor.DropdownMenuTrigger AsChild="false" Class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 w-10" aria-label="@(L.T("末尾对齐菜单", "End aligned menu"))">
                        <LucideIcon Name="menu" Size="16" />
                    </AtomBlazor.DropdownMenuTrigger>
                    <AtomBlazor.DropdownMenuContent Align="@PopoverAlign.End">
                        <DropdownMenuLabel>@L.T("末尾对齐", "End Alignment")</DropdownMenuLabel>
                        <DropdownMenuSeparator />
                        <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleMenuAction("end", "Item 1"))">@L.T("条目 1", "Item 1")</AtomBlazor.DropdownMenuItem>
                        <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleMenuAction("end", "Item 2"))">@L.T("条目 2", "Item 2")</AtomBlazor.DropdownMenuItem>
                        <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleMenuAction("end", "Item 3"))">@L.T("条目 3", "Item 3")</AtomBlazor.DropdownMenuItem>
                    </AtomBlazor.DropdownMenuContent>
                </DropdownMenu>
                @if (GetMenuAction("end") != null)
                {
                    <p class="text-sm">@L.T("末尾：", "End:") <strong>@GetMenuAction("end")</strong></p>
                }
            </div>
        </div>
        <CodeBlock Source="Components/DropdownMenu/alignment.txt" />
    </section>

    <!-- Disabled Items -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("禁用条目", "Disabled Items")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("菜单条目可以被禁用以防止交互。", "Menu items can be disabled to prevent interaction.")
        </p>

        <div class="flex items-start gap-2">
            <DropdownMenu>
                <AtomBlazor.DropdownMenuTrigger AsChild="false" Class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2">
                    @L.T("编辑菜单", "Edit Menu")
                </AtomBlazor.DropdownMenuTrigger>
                <AtomBlazor.DropdownMenuContent>
                    <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleDisabledAction("Cut"))">@L.T("剪切", "Cut")</AtomBlazor.DropdownMenuItem>
                    <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleDisabledAction("Copy"))">@L.T("复制", "Copy")</AtomBlazor.DropdownMenuItem>
                    <AtomBlazor.DropdownMenuItem Disabled="true" OnClick="@(() => HandleDisabledAction("Paste"))">@L.T("粘贴（已禁用）", "Paste (Disabled)")</AtomBlazor.DropdownMenuItem>
                    <DropdownMenuSeparator />
                    <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleDisabledAction("Select All"))">@L.T("全选", "Select All")</AtomBlazor.DropdownMenuItem>
                    <AtomBlazor.DropdownMenuItem Disabled="true" OnClick="@(() => HandleDisabledAction("Delete"))">@L.T("删除（已禁用）", "Delete (Disabled)")</AtomBlazor.DropdownMenuItem>
                </AtomBlazor.DropdownMenuContent>
            </DropdownMenu>
            @if (!string.IsNullOrEmpty(disabledAction))
            {
                <p class="text-sm">@L.T("最近一次操作：", "Last action:") <strong>@disabledAction</strong></p>
            }
        </div>
        <CodeBlock Source="Components/DropdownMenu/disabled.txt" />
    </section>

    <!-- Checkbox Items -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("复选条目", "Checkbox Items")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("切换保持勾选状态的菜单条目。切换复选框时菜单保持打开。", "Toggle menu items that maintain checked state. The menu stays open when toggling checkboxes.")
        </p>

        <div class="flex items-start gap-4">
            <DropdownMenu>
                <AtomBlazor.DropdownMenuTrigger AsChild="false" Class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2">
                    @L.T("视图选项", "View Options")
                </AtomBlazor.DropdownMenuTrigger>
                <AtomBlazor.DropdownMenuContent>
                    <DropdownMenuLabel>@L.T("外观", "Appearance")</DropdownMenuLabel>
                    <DropdownMenuSeparator />
                    <AtomBlazor.DropdownMenuCheckboxItem @bind-Checked="showStatusBar">
                        @L.T("状态栏", "Status Bar")
                    </AtomBlazor.DropdownMenuCheckboxItem>
                    <AtomBlazor.DropdownMenuCheckboxItem @bind-Checked="showActivityBar">
                        @L.T("活动栏", "Activity Bar")
                    </AtomBlazor.DropdownMenuCheckboxItem>
                    <AtomBlazor.DropdownMenuCheckboxItem @bind-Checked="showPanel">
                        @L.T("面板", "Panel")
                    </AtomBlazor.DropdownMenuCheckboxItem>
                    <DropdownMenuSeparator />
                    <AtomBlazor.DropdownMenuCheckboxItem @bind-Checked="fullScreen">
                        @L.T("全屏", "Full Screen")
                    </AtomBlazor.DropdownMenuCheckboxItem>
                    <AtomBlazor.DropdownMenuCheckboxItem Disabled="true" Checked="false">
                        @L.T("自动换行（已禁用）", "Word Wrap (Disabled)")
                    </AtomBlazor.DropdownMenuCheckboxItem>
                </AtomBlazor.DropdownMenuContent>
            </DropdownMenu>

            <div class="text-sm space-y-1">
                <p>@L.T("状态栏：", "Status Bar:") <strong>@(showStatusBar ? L.T("已显示", "Visible") : L.T("已隐藏", "Hidden"))</strong></p>
                <p>@L.T("活动栏：", "Activity Bar:") <strong>@(showActivityBar ? L.T("已显示", "Visible") : L.T("已隐藏", "Hidden"))</strong></p>
                <p>@L.T("面板：", "Panel:") <strong>@(showPanel ? L.T("已显示", "Visible") : L.T("已隐藏", "Hidden"))</strong></p>
                <p>@L.T("全屏：", "Full Screen:") <strong>@(fullScreen ? L.T("已开启", "On") : L.T("已关闭", "Off"))</strong></p>
            </div>
        </div>
        <CodeBlock Source="Components/DropdownMenu/checkbox.txt" />
    </section>

    <!-- Icon Shorthand -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("图标简写", "Icon Shorthand")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">使用 <code class="bg-muted px-1 py-0.5 rounded">Icon</code> 参数即可在菜单条目内容前添加图标，无需手写标记。</p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                Use the <code class="bg-muted px-1 py-0.5 rounded">Icon</code> parameter to add an icon before the menu item content without manual markup.
            </p>
                </text>
}

        <div class="flex items-start gap-2">
            <DropdownMenu>
                <AtomBlazor.DropdownMenuTrigger AsChild="false" Class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2">
                    @L.T("文件操作", "File Actions")
                </AtomBlazor.DropdownMenuTrigger>
                <AtomBlazor.DropdownMenuContent>
                    <AtomBlazor.DropdownMenuItem>
                        <Icon><LucideIcon Name="pencil" Size="16" /></Icon>
                        <ChildContent>@L.T("编辑", "Edit")</ChildContent>
                    </AtomBlazor.DropdownMenuItem>
                    <AtomBlazor.DropdownMenuItem>
                        <Icon><LucideIcon Name="copy" Size="16" /></Icon>
                        <ChildContent>@L.T("创建副本", "Duplicate")</ChildContent>
                    </AtomBlazor.DropdownMenuItem>
                    <DropdownMenuSeparator />
                    <AtomBlazor.DropdownMenuItem Class="text-destructive">
                        <Icon><LucideIcon Name="trash-2" Size="16" /></Icon>
                        <ChildContent>@L.T("删除", "Delete")</ChildContent>
                    </AtomBlazor.DropdownMenuItem>
                </AtomBlazor.DropdownMenuContent>
            </DropdownMenu>
        </div>
        <CodeBlock Source="Components/DropdownMenu/icon-shorthand.txt" />
    </section>

    <!-- Link Items -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("链接条目", "Link Items")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">使用 <code class="bg-muted px-1 py-0.5 rounded">Href</code> 参数可将菜单条目渲染为用于导航的锚元素。</p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                Use the <code class="bg-muted px-1 py-0.5 rounded">Href</code> parameter to render menu items as anchor elements for navigation.
            </p>
                </text>
}

        <div class="flex items-start gap-2">
            <DropdownMenu>
                <AtomBlazor.DropdownMenuTrigger AsChild="false" Class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2">
                    @L.T("资源", "Resources")
                </AtomBlazor.DropdownMenuTrigger>
                <AtomBlazor.DropdownMenuContent>
                    <DropdownMenuLabel>@L.T("页面", "Pages")</DropdownMenuLabel>
                    <DropdownMenuSeparator />
                    <AtomBlazor.DropdownMenuItem Href="/components/select">@L.T("Select 组件", "Select Component")</AtomBlazor.DropdownMenuItem>
                    <AtomBlazor.DropdownMenuItem Href="/components/switch">@L.T("Switch 组件", "Switch Component")</AtomBlazor.DropdownMenuItem>
                    <DropdownMenuSeparator />
                    <DropdownMenuLabel>@L.T("外部链接", "External")</DropdownMenuLabel>
                    <DropdownMenuSeparator />
                    <AtomBlazor.DropdownMenuItem Href="https://github.com" Target="_blank">
                        @L.T("GitHub（新标签页打开）", "GitHub (new tab)")
                    </AtomBlazor.DropdownMenuItem>
                </AtomBlazor.DropdownMenuContent>
            </DropdownMenu>
        </div>

        <CodeBlock Source="Components/DropdownMenu/link.txt" />
    </section>

    <!-- AsChild Pattern -->
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("AsChild 组合模式", "AsChild Pattern")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("使用 AsChild 可将触发行为组合进你自己带样式的 Button 组件。", "Use AsChild to compose triggers with your own styled Button components.")
        </p>

        <div class="grid md:grid-cols-2 gap-6">
            <!-- Without AsChild -->
            <div class="space-y-3 p-4 border rounded-lg">
                <h3 class="text-lg font-medium">@L.T("不使用 AsChild", "Without AsChild")</h3>
                <p class="text-sm text-muted-foreground">
                    @L.T("DropdownMenuTrigger 会自行渲染一个带内联类的按钮。", "DropdownMenuTrigger renders its own button with inline classes.")
                </p>
                <DropdownMenu>
                    <AtomBlazor.DropdownMenuTrigger AsChild="false" Class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2">
                        @L.T("打开菜单", "Open Menu")
                    </AtomBlazor.DropdownMenuTrigger>
                    <AtomBlazor.DropdownMenuContent>
                        <AtomBlazor.DropdownMenuItem>@L.T("个人资料", "Profile")</AtomBlazor.DropdownMenuItem>
                        <AtomBlazor.DropdownMenuItem>@L.T("设置", "Settings")</AtomBlazor.DropdownMenuItem>
                    </AtomBlazor.DropdownMenuContent>
                </DropdownMenu>
            </div>

            <!-- With AsChild -->
            <div class="space-y-3 p-4 border rounded-lg">
                <h3 class="text-lg font-medium">@L.T("使用 AsChild", "With AsChild")</h3>
                <p class="text-sm text-muted-foreground">
                    @L.T("Button 组件通过 TriggerContext 接收触发行为。", "Button component receives trigger behavior via TriggerContext.")
                </p>
                <DropdownMenu>
                    <AtomBlazor.DropdownMenuTrigger>
                        <Button Variant="ButtonVariant.Outline">
                            @L.T("操作", "Actions")
