@page "/components/separator"

<PageTitle>@L.T("Separator 分隔线组件 - Atom BlazorUI", "Separator Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">@L.T("Separator 分隔线组件", "Separator Component")</h1>
        <p class="text-xl text-muted-foreground">
            @L.T("以视觉或语义方式分隔内容。", "Visually or semantically separates content.")
        </p>
        </div>
    </div>

    <div class="space-y-6">
    </div>

    <!-- Horizontal Separator -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("水平", "Horizontal")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("横跨整个宽度的默认分隔线。", "Default separator spanning the full width.")
            </p>
        </div>
        <div class="space-y-4 max-w-md">
            <div>
                <h3 class="text-sm font-medium">Atom BlazorUI</h3>
                <p class="text-sm text-muted-foreground">@L.T("一个 Atom BlazorUI 组件库", "An Atom BlazorUI component library")</p>
            </div>
            <Separator Orientation="AtomBlazor.SeparatorOrientation.Horizontal" />
            <div class="space-y-1">
                <h4 class="text-sm font-medium leading-none">@L.T("组件", "Components")</h4>
                <p class="text-sm text-muted-foreground">
                    @L.T("预构建、可用于生产环境的组件", "Pre-built, production-ready components")
                </p>
            </div>
        </div>
        <CodeBlock Source="Components/Separator/horizontal.txt" />
    </div>

    <!-- Vertical Separator -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("垂直", "Vertical")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("用于横向排列内容的分隔线。", "Separator for horizontally arranged content.")
            </p>
        </div>
        <div class="flex h-20 items-center space-x-4 text-sm">
            <div>Button</div>
            <Separator Orientation="AtomBlazor.SeparatorOrientation.Vertical" />
            <div>Input</div>
            <Separator Orientation="AtomBlazor.SeparatorOrientation.Vertical" />
            <div>Badge</div>
            <Separator Orientation="AtomBlazor.SeparatorOrientation.Vertical" />
            <div>Separator</div>
        </div>
        <CodeBlock Source="Components/Separator/vertical.txt" />
    </div>

    <!-- Decorative vs Semantic -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("装饰性与语义化", "Decorative vs Semantic")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("为无障碍控制 ARIA 属性。", "Control ARIA attributes for accessibility.")
            </p>
        </div>
        <div class="space-y-6 max-w-md">
            <div>
                <h3 class="text-sm font-semibold mb-2">@L.T("装饰性（默认）", "Decorative (Default)")</h3>
                <p class="text-xs text-muted-foreground mb-4">
                    @L.T("role=\"none\"——对屏幕阅读器隐藏（纯视觉）", "role=\"none\" - Hidden from screen readers (purely visual)")
                </p>
                <div class="space-y-1">
                    <p class="text-sm">@L.T("区块 1", "Section 1")</p>
                </div>
                <Separator Decorative="true" Class="my-4" />
                <div class="space-y-1">
                    <p class="text-sm">@L.T("区块 2", "Section 2")</p>
                </div>
            </div>

            <div>
                <h3 class="text-sm font-semibold mb-2">@L.T("语义化", "Semantic")</h3>
                <p class="text-xs text-muted-foreground mb-4">
                    @L.T("role=\"separator\"，含 aria-orientation——会被屏幕阅读器播报", "role=\"separator\" with aria-orientation - Announced to screen readers")
                </p>
                <div class="space-y-1">
                    <h4 class="text-sm font-medium">@L.T("设置", "Settings")</h4>
                    <p class="text-xs text-muted-foreground">@L.T("配置你的账户", "Configure your account")</p>
                </div>
                <Separator Decorative="false" Class="my-4" />
                <div class="space-y-1">
                    <h4 class="text-sm font-medium">@L.T("隐私", "Privacy")</h4>
                    <p class="text-xs text-muted-foreground">@L.T("管理隐私设置", "Manage privacy settings")</p>
                </div>
            </div>
        </div>
        <CodeBlock Source="Components/Separator/decorative-vs-semantic.txt" />
    </div>

    <!-- Custom Styling -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("自定义样式", "Custom Styling")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("通过 Class 参数覆盖样式。", "Override styles with the Class parameter.")
            </p>
        </div>
        <div class="space-y-4 max-w-md">
            <div>
                <p class="text-sm">@L.T("默认分隔线", "Default separator")</p>
                <Separator Class="my-4" />
            </div>
            <div>
                <p class="text-sm">@L.T("更粗的分隔线", "Thicker separator")</p>
                <Separator Class="my-4 h-[2px]" />
            </div>
            <div>
                <p class="text-sm">@L.T("带颜色的分隔线", "Colored separator")</p>
                <Separator Class="my-4 bg-primary" />
            </div>
            <div>
                <p class="text-sm">@L.T("虚线分隔线", "Dashed separator")</p>
                <Separator Class="my-4 border-t border-dashed border-border h-0" />
            </div>
        </div>
        <CodeBlock Source="Components/Separator/custom-styling.txt" />
    </div>

    <!-- Usage in Lists -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("在列表中使用", "In Lists")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("分隔列表项或菜单选项。", "Separating list items or menu options.")
            </p>
        </div>
        <div class="max-w-md border rounded-lg">
            <div class="p-4">
                <h3 class="font-medium">@L.T("个人资料设置", "Profile Settings")</h3>
                <p class="text-sm text-muted-foreground">@L.T("管理你的账户", "Manage your account")</p>
            </div>
            <Separator />
            <div class="p-4">
                <h3 class="font-medium">@L.T("偏好设置", "Preferences")</h3>
                <p class="text-sm text-muted-foreground">@L.T("自定义你的体验", "Customize your experience")</p>
            </div>
            <Separator />
            <div class="p-4">
                <h3 class="font-medium">@L.T("通知", "Notifications")</h3>
                <p class="text-sm text-muted-foreground">@L.T("配置提醒", "Configure alerts")</p>
            </div>
            <Separator />
            <div class="p-4">
                <h3 class="font-medium">@L.T("安全", "Security")</h3>
                <p class="text-sm text-muted-foreground">@L.T("密码与身份验证", "Password and authentication")</p>
            </div>
        </div>
        <CodeBlock Source="Components/Separator/in-lists.txt" />
    </div>

    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("线条样式", "Line patterns")</h2>
<div class="space-y-5">
    <Separator LineStyle="SeparatorLineStyle.Solid" />
    <Separator LineStyle="SeparatorLineStyle.Dashed" />
    <Separator LineStyle="SeparatorLineStyle.Dotted" />
</div>
        <CodeBlock Source="Components/Separator/extended.txt" />

    </section>

    <!-- API Reference -->


        <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>@L.T("Decorative=true 会移除分隔线的语义含义。当分隔线表达有意义的内容结构时，请使用 Decorative=false。", "Decorative=true removes semantic separator meaning. Use Decorative=false when the divider expresses meaningful structure.")</AccessibilityItem>
            <AccessibilityItem>@L.T("语义化分隔线会暴露 role=\"separator\" 与 aria-orientation。实线、虚线与点线不会改变其语义。", "Semantic separators expose role=\"separator\" and aria-orientation. Solid, dashed and dotted lines do not change the semantics.")</AccessibilityItem>
        </AriaAttributes>
        <KeyboardNavigation>
            <KeyboardShortcutItem Description="@(L.T("分隔线不可聚焦；Tab 在周围的各个控件间移动", "The separator is not focusable; Tab moves between surrounding interactive controls"))"><Kbd>Tab</Kbd></KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>

    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件的属性与参数。", "Component properties and parameters.")</p>
        </div>

        <div class="space-y-4">
            <ApiReference ComponentName="Separator">
                <ApiParameter Name="Orientation" Type="SeparatorOrientation" Default="Horizontal">
                    @L.T("分隔线的方向。可选值：Horizontal 或 Vertical。", "The orientation of the separator. Options: Horizontal or Vertical.")
                </ApiParameter>
                <ApiParameter Name="Decorative" Type="bool" Default="true">
                    @L.T("为 true（默认）时，分隔线为纯装饰性并对屏幕阅读器隐藏。设为 false 可得到表达内容结构的语义化分隔线。", "When true (default), the separator is purely decorative and hidden from screen readers. Set to false for semantic separators that convey content structure.")
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?">
                    @L.T("追加到分隔线元素的额外 CSS 类。", "Additional CSS classes to apply to the separator element.")
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            应用到组件根元素的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                                        </text>
}
                    else
                    {
                                        <text>
                                            Additional HTML attributes applied to the component's root element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                                        </text>
}
                </ApiParameter>
            <ApiParameter Since="v4" Name="LineStyle" Type="SeparatorLineStyle" Default="Solid">@L.T("在任意方向上均可取 Solid、Dashed 或 Dotted。装饰性与语义行为保持不变。", "Solid, Dashed or Dotted in either orientation. Decorative and semantic behavior are unchanged.")</ApiParameter>
        </ApiReference>
        </div>


    </section>

</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;
}
