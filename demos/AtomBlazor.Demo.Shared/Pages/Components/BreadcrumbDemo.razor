@page "/components/breadcrumb"
<PageTitle>@L.T("Breadcrumb 面包屑 - Atom BlazorUI", "Breadcrumb Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("Breadcrumb 面包屑组件", "Breadcrumb Component")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("用逐级链接的层级结构显示当前资源的路径。", "Displays the path to the current resource using a hierarchy of links.")
            </p>
        </div>
    </div>

    <!-- Basic Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("基本示例", "Basic Example")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("一段简单的面包屑导航，显示当前页面的路径。", "A simple breadcrumb navigation showing the current page path.")
            </p>
        </div>
        <Breadcrumb>
            <BreadcrumbItem>
                <BreadcrumbLink Href="/">@L.T("首页", "Home")</BreadcrumbLink>
            </BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem>
                <BreadcrumbLink Href="/components">@L.T("组件", "Components")</BreadcrumbLink>
            </BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem>
                <BreadcrumbPage>@L.T("面包屑", "Breadcrumb")</BreadcrumbPage>
            </BreadcrumbItem>
        </Breadcrumb>

        <CodeBlock Source="Components/Breadcrumb/basic.txt" />
    </div>

    <!-- With Ellipsis -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("带省略号", "With Ellipsis")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("用省略号表示被折叠的面包屑条目。", "Use ellipsis to indicate collapsed breadcrumb items.")
            </p>
        </div>
        <Breadcrumb>
            <BreadcrumbItem>
                <BreadcrumbLink Href="/">@L.T("首页", "Home")</BreadcrumbLink>
            </BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem>
                <BreadcrumbEllipsis />
            </BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem>
                <BreadcrumbLink Href="/components">@L.T("组件", "Components")</BreadcrumbLink>
            </BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem>
                <BreadcrumbPage>@L.T("面包屑", "Breadcrumb")</BreadcrumbPage>
            </BreadcrumbItem>
        </Breadcrumb>

        <CodeBlock Source="Components/Breadcrumb/ellipsis.txt" />
    </div>

    <!-- Custom Separator -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("自定义分隔符", "Custom Separator")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("自定义面包屑条目之间的分隔符。", "Customize the separator between breadcrumb items.")
            </p>
        </div>
        <Breadcrumb>
            <BreadcrumbItem>
                <BreadcrumbLink Href="/">@L.T("首页", "Home")</BreadcrumbLink>
            </BreadcrumbItem>
            <BreadcrumbSeparator>/</BreadcrumbSeparator>
            <BreadcrumbItem>
                <BreadcrumbLink Href="/components">@L.T("组件", "Components")</BreadcrumbLink>
            </BreadcrumbItem>
            <BreadcrumbSeparator>/</BreadcrumbSeparator>
            <BreadcrumbItem>
                <BreadcrumbPage>@L.T("面包屑", "Breadcrumb")</BreadcrumbPage>
            </BreadcrumbItem>
        </Breadcrumb>

        <CodeBlock Source="Components/Breadcrumb/custom-separator.txt" />
    </div>

    <!-- Auto Separators -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("自动分隔符", "Auto Separators")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    在 <code class="bg-muted px-1 py-0.5 rounded">BreadcrumbList</code> 上开启 <code class="bg-muted px-1 py-0.5 rounded">AutoSeparator</code>，分隔符会自动插入到条目之间，无需再手写 <code class="bg-muted px-1 py-0.5 rounded">BreadcrumbSeparator</code>。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use <code class="bg-muted px-1 py-0.5 rounded">AutoSeparator</code> on <code class="bg-muted px-1 py-0.5 rounded">BreadcrumbList</code> to automatically insert separators between items — no manual <code class="bg-muted px-1 py-0.5 rounded">BreadcrumbSeparator</code> needed.
                </p>
                        </text>
}
        </div>
        <Breadcrumb>
            <BreadcrumbList AutoSeparator="true">
                <BreadcrumbItem>
                    <BreadcrumbLink Href="/">@L.T("首页", "Home")</BreadcrumbLink>
                </BreadcrumbItem>
                <BreadcrumbItem>
                    <BreadcrumbLink Href="/components">@L.T("组件", "Components")</BreadcrumbLink>
                </BreadcrumbItem>
                <BreadcrumbItem>
                    <BreadcrumbPage>@L.T("面包屑", "Breadcrumb")</BreadcrumbPage>
                </BreadcrumbItem>
            </BreadcrumbList>
        </Breadcrumb>

        <p class="text-sm text-muted-foreground mt-4">
            @L.T("使用自定义分隔符：", "With a custom separator:")
        </p>
        <Breadcrumb>
            <BreadcrumbList AutoSeparator="true">
                <SeparatorContent>/</SeparatorContent>
                <ChildContent>
                    <BreadcrumbItem>
                        <BreadcrumbLink Href="/">@L.T("首页", "Home")</BreadcrumbLink>
                    </BreadcrumbItem>
                    <BreadcrumbItem>
                        <BreadcrumbLink Href="/components">@L.T("组件", "Components")</BreadcrumbLink>
                    </BreadcrumbItem>
                    <BreadcrumbItem>
                        <BreadcrumbPage>@L.T("面包屑", "Breadcrumb")</BreadcrumbPage>
                    </BreadcrumbItem>
                </ChildContent>
            </BreadcrumbList>
        </Breadcrumb>

        <CodeBlock Source="Components/Breadcrumb/auto-separators.txt" />
    </div>

    <!-- Accessibility Notes -->
    <AccessibilityList>
        <AriaAttributes>
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-label="breadcrumb"</code> 标在 <code class="text-xs bg-muted px-1 py-0.5 rounded">&lt;nav&gt;</code> 元素上，用来标识导航地标
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-label="breadcrumb"</code> on the <code class="text-xs bg-muted px-1 py-0.5 rounded">&lt;nav&gt;</code> element identifies the navigation landmark
                </AccessibilityItem>
                        </text>
}
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    当前页条目上的 <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-current="page"</code> 表示所在位置
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-current="page"</code> on the current page item indicates the active location
                </AccessibilityItem>
                        </text>
}
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    禁用的面包屑条目带有 <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-disabled="true"</code>
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-disabled="true"</code> on disabled breadcrumb items
                </AccessibilityItem>
                        </text>
}
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    分隔符与省略号使用 <code class="text-xs bg-muted px-1 py-0.5 rounded">role="presentation"</code> 和 <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-hidden="true"</code>，对辅助技术隐藏
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    Separators and ellipsis use <code class="text-xs bg-muted px-1 py-0.5 rounded">role="presentation"</code> and <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-hidden="true"</code> to hide from assistive technology
                </AccessibilityItem>
                        </text>
}
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    省略号内含供读屏器使用的 <code class="text-xs bg-muted px-1 py-0.5 rounded">sr-only</code> 文本
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    Ellipsis includes <code class="text-xs bg-muted px-1 py-0.5 rounded">sr-only</code> text for screen readers
                </AccessibilityItem>
                        </text>
}
        </AriaAttributes>
        <KeyboardNavigation>
            <KeyboardShortcutItem Description="@(L.T("在面包屑链接之间移动", "Navigate between breadcrumb links"))">
                <Kbd>Tab</Kbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("打开已聚焦的面包屑链接", "Follow the focused breadcrumb link"))">
                <Kbd>Enter</Kbd>
            </KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>

    <!-- API Reference -->
    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件的属性与参数。", "Component properties and parameters.")</p>
        </div>

        <div class="space-y-4">
            <div class="space-y-2 text-sm">
                <p><code class="bg-muted px-1 py-0.5 rounded">Breadcrumb</code> - @L.T("包含 nav 元素的容器", "Container with nav element")</p>
                <p><code class="bg-muted px-1 py-0.5 rounded">BreadcrumbItem</code> - @L.T("单个面包屑条目", "Individual breadcrumb item")</p>
                <p><code class="bg-muted px-1 py-0.5 rounded">BreadcrumbLink</code> - @L.T("可点击的链接", "Clickable link")</p>
                <p><code class="bg-muted px-1 py-0.5 rounded">BreadcrumbPage</code> - @L.T("当前页（不可点击）", "Current page (non-clickable)")</p>
                <p><code class="bg-muted px-1 py-0.5 rounded">BreadcrumbSeparator</code> - @L.T("条目之间的分隔符", "Separator between items")</p>
                <p><code class="bg-muted px-1 py-0.5 rounded">BreadcrumbEllipsis</code> - @L.T("折叠条目的标识", "Collapsed items indicator")</p>
            </div>
        </div>
    </section>

    <LocalizationSection
        Description="@(L.T("面包屑的无障碍标签文案可以配置。", "Breadcrumb aria labels are configurable."))"
        Labels="@(new LocalizationSection.LabelInfo[]
        {
            new("Breadcrumb", "breadcrumb", L.T("nav 元素的无障碍标签。", "Aria label for the nav element")),
            new("More", "More", L.T("省略号下拉触发器的无障碍标签。", "Aria label for the ellipsis dropdown trigger")),
        })"
        CodeExample="@(@"builder.Services.AddAtomBlazorComponents(localizer =>
{
    localizer.Set(""Breadcrumb.Breadcrumb"", ""Brotkrümel"");
    localizer.Set(""Breadcrumb.More"", ""Mehr"");
});")" />
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;
}
