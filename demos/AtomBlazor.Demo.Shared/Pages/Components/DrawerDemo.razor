@page "/components/drawer"
<PageTitle>@L.T("抽屉组件 - Atom BlazorUI", "Drawer Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("抽屉组件", "Drawer Component")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("移动端友好的面板，从屏幕边缘滑入。", "A mobile-friendly panel that slides in from the edge of the screen.")
            </p>
        </div>
    </div>

    <!-- Basic Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("基本示例", "Basic Example")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("一个简单的抽屉，从屏幕底部向上滑出。", "A simple drawer that slides up from the bottom.")
            </p>
        </div>
        <Drawer>
            <DrawerTrigger AsChild="true">
                <Button Variant="ButtonVariant.Outline">@L.T("打开抽屉", "Open Drawer")</Button>
            </DrawerTrigger>
            <DrawerContent>
                <DrawerHeader>
                    <DrawerTitle>@L.T("编辑资料", "Edit Profile")</DrawerTitle>
                    <DrawerDescription>
                        @L.T("在这里修改你的资料，完成后点击保存。", "Make changes to your profile here. Click save when you're done.")
                    </DrawerDescription>
                </DrawerHeader>
                <div class="p-4">
                    <p class="text-sm text-muted-foreground">@L.T("抽屉内容放这里……", "Drawer content goes here...")</p>
                </div>
                <DrawerFooter>
                    <Button>@L.T("保存修改", "Save changes")</Button>
                    <DrawerClose AsChild="true">
                        <Button Variant="ButtonVariant.Outline">@L.T("取消", "Cancel")</Button>
                    </DrawerClose>
                </DrawerFooter>
            </DrawerContent>
        </Drawer>

        <CodeBlock Source="Components/Drawer/basic.txt" />
    </div>

    <!-- Different Directions -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("方向", "Directions")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("抽屉可以从屏幕的任意一边滑出。", "Drawer can slide from any edge of the screen.")
            </p>
        </div>
        <div class="flex flex-wrap gap-4">
            <Drawer Direction="DrawerDirection.Top">
                <DrawerTrigger AsChild="true">
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon">
                        <LucideIcon Name="arrow-up" Size="16" />
                    </Button>
                </DrawerTrigger>
                <DrawerContent ShowHandle="false">
                    <DrawerHeader>
                        <DrawerTitle>@L.T("顶部抽屉", "Top Drawer")</DrawerTitle>
                        <DrawerDescription>@L.T("它从顶部滑出。", "This slides from the top.")</DrawerDescription>
                    </DrawerHeader>
                    <DrawerFooter>
                        <DrawerClose AsChild="true">
                            <Button Variant="ButtonVariant.Outline">@L.T("关闭", "Close")</Button>
                        </DrawerClose>
                    </DrawerFooter>
                </DrawerContent>
            </Drawer>

            <Drawer Direction="DrawerDirection.Right">
                <DrawerTrigger AsChild="true">
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon">
                        <LucideIcon Name="arrow-right" Size="16" />
                    </Button>
                </DrawerTrigger>
                <DrawerContent ShowHandle="false">
                    <DrawerHeader>
                        <DrawerTitle>@L.T("右侧抽屉", "Right Drawer")</DrawerTitle>
                        <DrawerDescription>@L.T("它从右侧滑出。", "This slides from the right.")</DrawerDescription>
                    </DrawerHeader>
                    <DrawerFooter>
                        <DrawerClose AsChild="true">
                            <Button Variant="ButtonVariant.Outline">@L.T("关闭", "Close")</Button>
                        </DrawerClose>
                    </DrawerFooter>
                </DrawerContent>
            </Drawer>

            <Drawer Direction="DrawerDirection.Bottom">
                <DrawerTrigger AsChild="true">
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon">
                        <LucideIcon Name="arrow-down" Size="16" />
                    </Button>
                </DrawerTrigger>
                <DrawerContent>
                    <DrawerHeader>
                        <DrawerTitle>@L.T("底部抽屉", "Bottom Drawer")</DrawerTitle>
                        <DrawerDescription>@L.T("它从底部滑出（默认）。", "This slides from the bottom (default).")</DrawerDescription>
                    </DrawerHeader>
                    <DrawerFooter>
                        <DrawerClose AsChild="true">
                            <Button Variant="ButtonVariant.Outline">@L.T("关闭", "Close")</Button>
                        </DrawerClose>
                    </DrawerFooter>
                </DrawerContent>
            </Drawer>

            <Drawer Direction="DrawerDirection.Left">
                <DrawerTrigger AsChild="true">
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon">
                        <LucideIcon Name="arrow-left" Size="16" />
                    </Button>
                </DrawerTrigger>
                <DrawerContent ShowHandle="false">
                    <DrawerHeader>
                        <DrawerTitle>@L.T("左侧抽屉", "Left Drawer")</DrawerTitle>
                        <DrawerDescription>@L.T("它从左侧滑出。", "This slides from the left.")</DrawerDescription>
                    </DrawerHeader>
                    <DrawerFooter>
                        <DrawerClose AsChild="true">
                            <Button Variant="ButtonVariant.Outline">@L.T("关闭", "Close")</Button>
                        </DrawerClose>
                    </DrawerFooter>
                </DrawerContent>
            </Drawer>
        </div>

        <CodeBlock Source="Components/Drawer/directions.txt" />
    </div>

    <!-- Action Sheet -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("操作表", "Action Sheet")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    用 <code class="text-xs bg-muted px-1 py-0.5 rounded">DrawerItem</code> 可以做出移动端友好的操作表，带上带样式的操作按钮。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use <code class="text-xs bg-muted px-1 py-0.5 rounded">DrawerItem</code> to create mobile-friendly action sheets with styled action buttons.
                </p>
                        </text>
}
        </div>
        <Drawer>
            <DrawerTrigger AsChild="true">
                <Button Variant="ButtonVariant.Outline">@L.T("打开操作表", "Open Action Sheet")</Button>
            </DrawerTrigger>
            <DrawerContent>
                <DrawerHeader>
                    <DrawerTitle>@L.T("操作", "Actions")</DrawerTitle>
                    <DrawerDescription>@L.T("选择一个要执行的操作。", "Choose an action to perform.")</DrawerDescription>
                </DrawerHeader>
                <div class="px-2 pb-4 space-y-1">
                    <DrawerItem OnClick="@HandleShare">
                        <Icon>
                            <LucideIcon Name="share" Size="20" />
                        </Icon>
                        <ChildContent>@L.T("分享", "Share")</ChildContent>
                    </DrawerItem>
                    <DrawerItem OnClick="@HandleEdit">
                        <Icon>
                            <LucideIcon Name="pencil" Size="20" />
                        </Icon>
                        <ChildContent>@L.T("编辑", "Edit")</ChildContent>
                    </DrawerItem>
                    <DrawerItem OnClick="@HandleDuplicate">
                        <Icon>
                            <LucideIcon Name="copy" Size="20" />
                        </Icon>
                        <ChildContent>@L.T("创建副本", "Duplicate")</ChildContent>
                    </DrawerItem>
                    <DrawerItem Class="text-destructive" OnClick="@HandleDelete">
                        <Icon>
                            <LucideIcon Name="trash-2" Size="20" />
                        </Icon>
                        <ChildContent>@L.T("删除", "Delete")</ChildContent>
                    </DrawerItem>
                </div>
            </DrawerContent>
        </Drawer>

        <CodeBlock Source="Components/Drawer/action-sheet.txt" />
    </div>

    <!-- Accessibility Notes -->
    <!-- AsChild -->
    <div class="space-y-4">
        @if (L.IsChinese)
        {
                <text>
                    <h2 class="text-2xl font-semibold">触发器内容与 <code class="text-lg">AsChild</code> <span class="text-xs font-normal text-primary bg-primary/10 px-1.5 py-0.5 rounded">已变更</span></h2>
                </text>
}
        else
        {
                <text>
                    <h2 class="text-2xl font-semibold">Trigger content and <code class="text-lg">AsChild</code> <span class="text-xs font-normal text-primary bg-primary/10 px-1.5 py-0.5 rounded">Changed</span></h2>
                </text>
}
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                <code class="bg-muted px-1 py-0.5 rounded">DrawerTrigger</code> 与
                <code class="bg-muted px-1 py-0.5 rounded">DrawerClose</code> 现在会渲染真正的
                <code class="bg-muted px-1 py-0.5 rounded">&lt;button&gt;</code>，所以纯文本内容也能用键盘触达，
                并会被播报为一个控件。当子内容是 <code class="bg-muted px-1 py-0.5 rounded">Button</code> 时，
                请设置 <code class="bg-muted px-1 py-0.5 rounded">AsChild="true"</code>，否则就会把按钮嵌套进按钮里。
                普通的 <code class="bg-muted px-1 py-0.5 rounded">&lt;button&gt;</code> 读不到触发器上下文，因此
                <code class="bg-muted px-1 py-0.5 rounded">AsChild="true"</code> 时它什么也打不开；在 Development 环境下，
                发生这种情况时触发器会记录一条警告。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                <code class="bg-muted px-1 py-0.5 rounded">DrawerTrigger</code> and
                <code class="bg-muted px-1 py-0.5 rounded">DrawerClose</code> now render a real
                <code class="bg-muted px-1 py-0.5 rounded">&lt;button&gt;</code>, so plain content is reachable by
                keyboard and announced as a control. Set
                <code class="bg-muted px-1 py-0.5 rounded">AsChild="true"</code> when the child is a
                <code class="bg-muted px-1 py-0.5 rounded">Button</code>, otherwise you nest a button inside a button.
                A plain <code class="bg-muted px-1 py-0.5 rounded">&lt;button&gt;</code> cannot read the trigger context, so
                with <code class="bg-muted px-1 py-0.5 rounded">AsChild="true"</code> it opens nothing; in Development
                the trigger logs a warning when that happens.
            </p>
                </text>
}

        <div class="flex flex-wrap gap-4 items-center">
            <Drawer>
                <DrawerTrigger Class="underline underline-offset-4 text-primary">@L.T("纯文本触发器", "Plain text trigger")</DrawerTrigger>
                <DrawerContent>
                    <DrawerHeader>
                        <DrawerTitle>@L.T("由纯文本打开", "Opened from plain text")</DrawerTitle>
                        <DrawerDescription>@L.T("用 Tab 键聚焦触发器再按 Enter——它现在是一个真正的按钮。", "Tab to the trigger and press Enter — it is a real button now.")</DrawerDescription>
                    </DrawerHeader>
                    <DrawerFooter>
                        <DrawerClose AsChild="true">
                            <Button Variant="ButtonVariant.Outline">@L.T("关闭", "Close")</Button>
                        </DrawerClose>
                    </DrawerFooter>
                </DrawerContent>
            </Drawer>

            <Drawer>
                <DrawerTrigger AsChild="true">
                    <Button Variant="ButtonVariant.Outline">@L.T("AsChild 触发器", "AsChild trigger")</Button>
                </DrawerTrigger>
                <DrawerContent>
                    <DrawerHeader>
                        <DrawerTitle>@L.T("由 Button 打开", "Opened from a Button")</DrawerTitle>
                        <DrawerDescription>@L.T("DOM 里只有一个按钮，不是两个。", "One button in the DOM, not two.")</DrawerDescription>
                    </DrawerHeader>
                    <DrawerFooter>
                        <DrawerClose AsChild="true">
                            <Button Variant="ButtonVariant.Outline">@L.T("关闭", "Close")</Button>
                        </DrawerClose>
                    </DrawerFooter>
                </DrawerContent>
            </Drawer>
        </div>

        <CodeBlock Source="Components/Drawer/as-child.txt" />
    </div>

    <!-- API Reference -->

    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("吸附点", "Snap points")</h2>
        <p class="text-sm text-muted-foreground">@L.T("吸附点是视口高度的升序比例（侧边抽屉则为宽度）。手柄支持指针拖动、方向键、Home 与 End。拖动过程中按 Escape 会取消拖动；平时按 Escape 会关闭抽屉。", "Snap points are ascending fractions of viewport height, or width for side drawers. The handle supports pointer dragging, arrows, Home and End. Escape during a drag cancels it; normal Escape closes the drawer.")</p>
<Drawer SnapPoints="@(new double[] { 0.3, 0.55, 0.9 })" @bind-SnapIndex="snapIndex" DismissOnDrag="true">
    <DrawerTrigger AsChild="true"><Button Variant="ButtonVariant.Outline">@L.T("打开吸附抽屉", "Open snapping drawer")</Button></DrawerTrigger>
    <DrawerContent aria-label="@(L.T("配送详情", "Delivery details"))">
        <DrawerHeader><DrawerTitle>@L.T("配送详情", "Delivery details")</DrawerTitle><DrawerDescription>@L.T("拖动手柄或用它的方向键调整大小。", "Drag the handle or use its arrow keys to resize.")</DrawerDescription></DrawerHeader>
        <div class="space-y-4 p-4">
            @if (L.IsChinese)
            {
                        <text>
                            <p>当前大小：第 @(snapIndex + 1) 档，共 3 档</p>
                        </text>
}
            else
            {
                        <text>
                            <p>Current size: @(snapIndex + 1) of 3</p>
                        </text>
}
            @foreach (var step in Enumerable.Range(1, 12))
            {
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="rounded-md border p-3">配送信息 @step</p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="rounded-md border p-3">Delivery information @step</p>
                                </text>
}
            }
        </div>
        <DrawerFooter><DrawerClose AsChild="true"><Button Variant="ButtonVariant.Outline">@L.T("关闭", "Close")</Button></DrawerClose></DrawerFooter>
    </DrawerContent>
</Drawer>
        <CodeBlock Source="Components/Drawer/snap-points.txt" />

    </section>

    <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>
                @if (L.IsChinese)
                {
                                <text>
                                    抽屉内容上带有 <code class="text-xs bg-muted px-1 py-0.5 rounded">role="dialog"</code> 与 <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-modal="true"</code>
                                </text>
}
                else
                {
                                <text>
                                    <code class="text-xs bg-muted px-1 py-0.5 rounded">role="dialog"</code> and <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-modal="true"</code> on the drawer content
                                </text>
}
            </AccessibilityItem>
            <AccessibilityItem>
                @L.T("抽屉打开时焦点会自动限制在其中；关闭后焦点回到打开它的触发器。", "Focus is automatically trapped within the drawer when open. Closing returns focus to the trigger that opened it.")
            </AccessibilityItem>
            <AccessibilityItem>
                @L.T("抽屉打开时会锁定 body 的滚动。", "Scroll lock on body when drawer is open")
            </AccessibilityItem>
        </AriaAttributes>
        <KeyboardNavigation>
            <KeyboardShortcutItem Description="@(L.T("关闭抽屉", "Close the drawer"))">
                <Kbd>Escape</Kbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("把焦点移到下一个元素", "Move focus to next element"))">
                <Kbd>Tab</Kbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("把焦点移到上一个元素", "Move focus to previous element"))">
                <Kbd>Shift+Tab</Kbd>
            </KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>

    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件属性与参数。", "Component properties and parameters.")</p>
        </div>

        <div class="space-y-4">
            <ApiReference ComponentName="Drawer">
                <ApiParameter Name="Direction" Type="DrawerDirection" Default="Bottom">
                    @L.T("抽屉滑出的方向（Top、Right、Bottom、Left）。", "Direction the drawer slides from (Top, Right, Bottom, Left).")
                </ApiParameter>
                <ApiParameter Name="Open" Type="bool?">
                    @L.T("受控的打开状态。", "Controlled open state.")
                </ApiParameter>
                <ApiParameter Name="DefaultOpen" Type="bool" Default="false">
                    @L.T("初始打开状态。", "Initial open state.")
                </ApiParameter>

            <ApiParameter Since="v4" Name="SnapPoints" Type="IReadOnlyList&lt;double&gt;" Default="[]">@L.T("大于 0 且不超过 1 的升序比例。为空时保持自然内容尺寸。", "Ascending fractions greater than 0 and at most 1. Empty preserves natural content size.")</ApiParameter>
            <ApiParameter Since="v4" Name="SnapIndex / SnapIndexChanged" Type="int / EventCallback&lt;int&gt;" Default="0">@L.T("当前激活的吸附点序号（从零开始）；支持 @bind-SnapIndex。", "Active zero-based point; supports @bind-SnapIndex.")</ApiParameter>
            <ApiParameter Since="v4" Name="DismissOnDrag" Type="bool" Default="true">@L.T("拖动到最小吸附点一半以下即关闭。为 false 时总是吸附到已配置的尺寸。", "Dragging below half the smallest point dismisses. False always snaps to a configured size.")</ApiParameter>

        </ApiReference>

            <ApiReference ComponentName="DrawerContent">
                <ApiParameter Name="ShowHandle" Type="bool" Default="true">
                    @L.T("是否显示拖动把手。", "Show drag handle.")
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            应用到根 <code>&lt;div&gt;</code> 元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                                        </text>
}
                    else
                    {
                                        <text>
                                            Additional HTML attributes applied to the root <code>&lt;div&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                                        </text>
}
                </ApiParameter>
                <ApiParameter Name="InitialFocus" Type="FocusTrapInitialFocus" Default="FocusTrapInitialFocus.FirstFocusable">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            打开时焦点陷阱聚焦的目标。<code>FirstFocusable</code> 聚焦第一个可 Tab 的后代元素，
                        <code>Container</code> 聚焦抽屉自身，<code>None</code> 不动焦点。带
                        <code>data-autofocus</code> 的元素优先级高于此项。
                                        </text>
}
                    else
                    {
                                        <text>
                                            What the focus trap focuses on open. <code>FirstFocusable</code> focuses the first tabbable descendant, <code>Container</code> focuses the drawer itself, <code>None</code> moves nothing. An element carrying <code>data-autofocus</code> wins over this.
                                        </text>
}
                </ApiParameter>
                <ApiParameter Name="InitialFocusElement" Type="ElementReference?">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            打开时要聚焦的指定元素，优先级高于 <code>InitialFocus</code> 与 <code>data-autofocus</code>。
                        当它不在抽屉内部时会被忽略。
                                        </text>
}
                    else
                    {
                                        <text>
                                            An explicit element to focus on open, beating both <code>InitialFocus</code> and <code>data-autofocus</code>. Ignored when it is not inside the drawer.
                                        </text>
}
                </ApiParameter>
            </ApiReference>

            <ApiReference ComponentName="DrawerTrigger">
                <ApiParameter Since="v4" Name="AsChild" Type="bool" Default="false">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            为 true 时自身不渲染按钮，而是把 <code>TriggerContext</code> 级联给子内容。
                        当子内容是 <code>Button</code> 时请使用它——保持 false 会把按钮嵌套进按钮里。
                        子内容必须读取该上下文：普通的 <code>&lt;button&gt;</code>、文本或图标做不到；
                        在 Development 环境下，如果没有任何东西响应，触发器会记录一条警告。
                                        </text>
}
                    else
                    {
                                        <text>
                                            When true, renders no button of its own and cascades a <code>TriggerContext</code> to the child instead. Use it when the child is a <code>Button</code> — leaving it false around one nests a button inside a button. The child has to read the context: a plain <code>&lt;button&gt;</code>, text or an icon cannot, and in Development the trigger logs a warning when nothing did.
                                        </text>
}
                </ApiParameter>
                <ApiParameter Name="ChildContent" Type="RenderFragment?">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            触发器内容。除非设置了 <code>AsChild</code>，否则渲染在一个 <code>&lt;button type="button"&gt;</code> 里。
                                        </text>
}
                    else
                    {
                                        <text>
                                            The trigger content. Rendered inside a <code>&lt;button type="button"&gt;</code> unless <code>AsChild</code> is set.
                                        </text>
}
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?">
                    @L.T("附加到触发按钮上的 CSS 类。", "Additional CSS classes for the trigger button.")
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            应用到根 <code>&lt;button&gt;</code> 元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                                        </text>
}
                    else
                    {
                                        <text>
                                            Additional HTML attributes applied to the root <code>&lt;button&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                                        </text>
}
                </ApiParameter>
            </ApiReference>

            <ApiReference ComponentName="DrawerClose">
                <ApiParameter Since="v4" Name="AsChild" Type="bool" Default="false">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            为 true 时自身不渲染按钮，而是把 <code>TriggerContext</code> 级联给子内容。
                                        </text>
}
                    else
                    {
                                        <text>
                                            When true, renders no button of its own and cascades a <code>TriggerContext</code> to the child instead.
                                        </text>
}
                </ApiParameter>
                <ApiParameter Name="ChildContent" Type="RenderFragment?">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            关闭内容。除非设置了 <code>AsChild</code>，否则渲染在一个 <code>&lt;button type="button"&gt;</code> 里。
                                        </text>
}
                    else
                    {
                                        <text>
                                            The close content. Rendered inside a <code>&lt;button type="button"&gt;</code> unless <code>AsChild</code> is set.
                                        </text>
}
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?">
                    @L.T("附加到关闭按钮上的 CSS 类。", "Additional CSS classes for the close button.")
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            应用到根 <code>&lt;button&gt;</code> 元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                                        </text>
}
                    else
                    {
                                        <text>
                                            Additional HTML attributes applied to the root <code>&lt;button&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                                        </text>
}
                </ApiParameter>
            </ApiReference>
        </div>


    </section>

