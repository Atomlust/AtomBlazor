@page "/components/aspect-ratio"

<PageTitle>@L.T("Aspect Ratio 宽高比 - Atom BlazorUI", "Aspect Ratio Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("Aspect Ratio 宽高比组件", "Aspect Ratio Component")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("在指定的宽高比内展示内容，始终保持等比缩放。", "Displays content within a desired ratio, maintaining consistent proportions.")
            </p>
        </div>
    </div>

    <!-- 16:9 Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("16:9 比例", "16:9 Ratio")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("视频与宽屏显示的常用比例。", "Common for video content and widescreen displays.")
            </p>
        </div>
        <div class="w-[450px]">
            <AspectRatio Ratio="16.0 / 9.0">
                <img src="https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=800&dpr=2&q=80"
                     alt="@(L.T("Drew Beamer 拍摄的照片", "Photo by Drew Beamer"))"
                     class="rounded-md object-cover" />
            </AspectRatio>
        </div>

        <CodeBlock Source="Components/AspectRatio/16-9.txt" />
    </div>

    <!-- 4:3 Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("4:3 比例", "4:3 Ratio")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("传统显示比例，适合照片。", "Traditional display ratio, good for photos.")
            </p>
        </div>
        <div class="w-[300px]">
            <AspectRatio Ratio="4.0 / 3.0">
                <img src="https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=800&dpr=2&q=80"
                     alt="@(L.T("Drew Beamer 拍摄的照片", "Photo by Drew Beamer"))"
                     class="rounded-md object-cover" />
            </AspectRatio>
        </div>

        <CodeBlock Source="Components/AspectRatio/4-3.txt" />
    </div>

    <!-- Square -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("1:1 正方形", "1:1 Square")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("标准正方形，常用于头像与缩略图。", "Perfect square, great for avatars and thumbnails.")
            </p>
        </div>
        <div class="w-[200px]">
            <AspectRatio Ratio="1">
                <img src="https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=800&dpr=2&q=80"
                     alt="@(L.T("Drew Beamer 拍摄的照片", "Photo by Drew Beamer"))"
                     class="rounded-md object-cover" />
            </AspectRatio>
        </div>

        <CodeBlock Source="Components/AspectRatio/square.txt" />
    </div>

    <!-- 21:9 Ultrawide -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("21:9 超宽屏", "21:9 Ultrawide")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("电影感的超宽比例。", "Cinematic ultrawide ratio.")
            </p>
        </div>
        <div class="w-full max-w-[600px]">
            <AspectRatio Ratio="21.0 / 9.0">
                <img src="https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=800&dpr=2&q=80"
                     alt="@(L.T("Drew Beamer 拍摄的照片", "Photo by Drew Beamer"))"
                     class="rounded-md object-cover" />
            </AspectRatio>
        </div>

        <CodeBlock Source="Components/AspectRatio/ultrawide.txt" />
    </div>

    <!-- With Placeholder Content -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("占位内容", "With Placeholder")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("把宽高比用在占位内容上。", "Using aspect ratio with placeholder content.")
            </p>
        </div>
        <div class="w-[300px]">
            <AspectRatio Ratio="16.0 / 9.0">
                <div class="flex items-center justify-center bg-muted rounded-md">
                    <span class="text-muted-foreground">16:9</span>
                </div>
            </AspectRatio>
        </div>

        <CodeBlock Source="Components/AspectRatio/placeholder.txt" />
    </div>

    <!-- Video Embed -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("视频嵌入", "Video Embed")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("为嵌入视频保持宽高比。", "Maintaining aspect ratio for embedded videos.")
            </p>
        </div>
        <div class="w-full max-w-[500px]">
            <AspectRatio Ratio="16.0 / 9.0">
                <div class="flex items-center justify-center bg-black rounded-md text-white">
                    <span>@L.T("视频播放器占位", "Video Player Placeholder")</span>
                </div>
            </AspectRatio>
        </div>

        <CodeBlock Source="Components/AspectRatio/video-embed.txt" />
    </div>

    <!-- Accessibility Notes -->
    <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>
                @L.T("纯展示用的布局组件，不含交互语义，也没有需要声明的 ARIA 属性", "Purely presentational layout component with no interactive or semantic ARIA attributes")
            </AccessibilityItem>
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    子内容（图片、视频）应自带无障碍属性，例如 <code class="text-xs bg-muted px-1 py-0.5 rounded">alt</code> 文本
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    Child content (images, videos) should include their own accessibility attributes such as <code class="text-xs bg-muted px-1 py-0.5 rounded">alt</code> text
                </AccessibilityItem>
                        </text>
}
        </AriaAttributes>
    </AccessibilityList>

    <!-- API Reference -->
    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件的属性与参数。", "Component properties and parameters.")</p>
        </div>
        <div class="space-y-4">
            <ApiReference ComponentName="AspectRatio">
                <ApiParameter Name="Ratio" Type="double" Default="1">
                    @L.T("需要保持的宽高比（宽 / 高）。常用值：16/9、4/3、1/1、21/9。", "The aspect ratio to maintain (width / height). Common values: 16/9, 4/3, 1/1, 21/9.")
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?" Default="null">
                    @L.T("追加到容器的额外 CSS 类。", "Additional CSS classes to apply to the container.")
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            应用到根 <code>&lt;div&gt;</code> 元素的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                                        </text>
}
                    else
                    {
                                        <text>
                                            Additional HTML attributes applied to the root <code>&lt;div&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                                        </text>
}
                </ApiParameter>
            </ApiReference>
        </div>
    </section>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;
}
