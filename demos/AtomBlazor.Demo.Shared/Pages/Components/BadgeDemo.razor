@page "/components/badge"

<PageTitle>@L.T("Badge 徽标 - Atom BlazorUI", "Badge Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">@L.T("Badge 徽标组件", "Badge Component")</h1>
        <p class="text-xl text-muted-foreground">
            @L.T("显示一个徽标，或一个看起来像徽标的元素。", "Displays a badge or a component that looks like a badge.")
        </p>
        </div>
    </div>

    <div class="space-y-6">
    </div>

    <!-- All Variants -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("样式变体", "Variants")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("四种徽标变体，对应不同用途。", "Four badge variants for different use cases.")
            </p>
        </div>
        <div class="flex flex-wrap gap-4">
            <Badge Variant="BadgeVariant.Default">Default</Badge>
            <Badge Variant="BadgeVariant.Secondary">Secondary</Badge>
            <Badge Variant="BadgeVariant.Destructive">Destructive</Badge>
            <Badge Variant="BadgeVariant.Outline">Outline</Badge>
        </div>

        <CodeBlock Source="Components/Badge/variants.txt" />
    </div>

    <!-- Usage Examples -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("常见用法", "Usage Examples")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("徽标的常见使用场景。", "Common use cases for badges.")
            </p>
        </div>
        <div class="space-y-6">
            <!-- Status Indicators -->
            <div class="space-y-3">
                <h3 class="text-lg font-medium">@L.T("状态指示", "Status Indicators")</h3>
                <div class="flex flex-wrap gap-3">
                    <div class="flex items-center gap-2">
                        <span class="text-sm">@L.T("活跃：", "Active:")</span>
                        <Badge Variant="BadgeVariant.Default">@L.T("活跃", "Active")</Badge>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-sm">@L.T("待处理：", "Pending:")</span>
                        <Badge Variant="BadgeVariant.Secondary">@L.T("待处理", "Pending")</Badge>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-sm">@L.T("出错：", "Error:")</span>
                        <Badge Variant="BadgeVariant.Destructive">@L.T("出错", "Error")</Badge>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-sm">@L.T("草稿：", "Draft:")</span>
                        <Badge Variant="BadgeVariant.Outline">@L.T("草稿", "Draft")</Badge>
                    </div>
                </div>
            </div>

            <!-- Notification Counts -->
            <div class="space-y-3">
                <h3 class="text-lg font-medium">@L.T("消息计数", "Notification Counts")</h3>
                <div class="flex flex-wrap gap-4 items-center">
                    <div class="flex items-center gap-2">
                        <span class="text-sm">@L.T("消息", "Messages")</span>
                        <Badge Variant="BadgeVariant.Default">3</Badge>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-sm">@L.T("未读", "Unread")</span>
                        <Badge Variant="BadgeVariant.Destructive">12</Badge>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-sm">@L.T("已完成", "Completed")</span>
                        <Badge Variant="BadgeVariant.Secondary">24</Badge>
                    </div>
                </div>
            </div>

            <!-- Tags/Labels -->
            <div class="space-y-3">
                <h3 class="text-lg font-medium">@L.T("标签", "Tags/Labels")</h3>
                <div class="flex flex-wrap gap-2">
                    <Badge Variant="BadgeVariant.Outline">React</Badge>
                    <Badge Variant="BadgeVariant.Outline">TypeScript</Badge>
                    <Badge Variant="BadgeVariant.Outline">Tailwind CSS</Badge>
                    <Badge Variant="BadgeVariant.Outline">Blazor</Badge>
                    <Badge Variant="BadgeVariant.Outline">C#</Badge>
                </div>
            </div>

            <!-- Feature Flags -->
            <div class="space-y-3">
                <h3 class="text-lg font-medium">@L.T("功能开关", "Feature Flags")</h3>
                <div class="flex flex-wrap gap-4 items-center">
                    <div class="flex items-center gap-2">
                        <span class="text-sm">@L.T("新功能", "New Feature")</span>
                        <Badge Variant="BadgeVariant.Default">@L.T("全新", "NEW")</Badge>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-sm">@L.T("测试版", "Beta")</span>
                        <Badge Variant="BadgeVariant.Secondary">@L.T("测试版", "BETA")</Badge>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-sm">@L.T("已废弃", "Deprecated")</span>
                        <Badge Variant="BadgeVariant.Destructive">@L.T("已废弃", "DEPRECATED")</Badge>
                    </div>
                </div>
            </div>
        </div>

        <CodeBlock Source="Components/Badge/usage.txt" />
    </div>

    <!-- In Lists/Cards -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("在列表中使用", "In Lists")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("徽标与其他组件搭配使用。", "Badges combined with other components.")
            </p>
        </div>
        <div class="max-w-md border rounded-lg divide-y">
            <div class="p-4 flex items-center justify-between">
                <div class="space-y-1">
                    <h4 class="text-sm font-medium">@L.T("Alpha 项目", "Project Alpha")</h4>
                    <p class="text-sm text-muted-foreground">@L.T("正在开发中", "Active development")</p>
                </div>
                <Badge Variant="BadgeVariant.Default">@L.T("进行中", "In Progress")</Badge>
            </div>
            <div class="p-4 flex items-center justify-between">
                <div class="space-y-1">
                    <h4 class="text-sm font-medium">@L.T("Beta 项目", "Project Beta")</h4>
                    <p class="text-sm text-muted-foreground">@L.T("正在评审", "Under review")</p>
                </div>
                <Badge Variant="BadgeVariant.Secondary">@L.T("评审", "Review")</Badge>
            </div>
            <div class="p-4 flex items-center justify-between">
                <div class="space-y-1">
                    <h4 class="text-sm font-medium">@L.T("Gamma 项目", "Project Gamma")</h4>
                    <p class="text-sm text-muted-foreground">@L.T("部署失败", "Deployment failed")</p>
                </div>
                <Badge Variant="BadgeVariant.Destructive">@L.T("失败", "Failed")</Badge>
            </div>
            <div class="p-4 flex items-center justify-between">
                <div class="space-y-1">
                    <h4 class="text-sm font-medium">@L.T("Delta 项目", "Project Delta")</h4>
                    <p class="text-sm text-muted-foreground">@L.T("规划阶段", "Planning phase")</p>
                </div>
                <Badge Variant="BadgeVariant.Outline">@L.T("草稿", "Draft")</Badge>
            </div>
        </div>

        <CodeBlock Source="Components/Badge/in-lists.txt" />
    </div>

    <!-- Custom Styling -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("自定义样式", "Custom Styling")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("通过 Class 参数覆盖样式。", "Override styles with the Class parameter.")
            </p>
        </div>
        <div class="flex flex-wrap gap-4">
            <Badge Variant="BadgeVariant.Default" Class="text-lg px-4 py-1">@L.T("大号徽标", "Large Badge")</Badge>
            <Badge Variant="BadgeVariant.Secondary" Class="rounded-sm">@L.T("直角外观", "Square Corners")</Badge>
            <Badge Variant="BadgeVariant.Outline" Class="border-2 border-blue-500 text-blue-500">@L.T("自定义颜色", "Custom Color")</Badge>
            <Badge Variant="BadgeVariant.Default" Class="bg-gradient-to-r from-purple-500 to-pink-500 border-0">@L.T("渐变", "Gradient")</Badge>
        </div>

        <CodeBlock Source="Components/Badge/custom-styling.txt" />
    </div>

    <!-- Custom Variants -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("自定义变体", "Custom Variants")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    用 <code class="text-xs bg-muted px-1 py-0.5 rounded">Class</code> 参数做出你自己的变体。TailwindMerge 会保证你的类覆盖内置变体样式。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Create your own variants using the <code class="text-xs bg-muted px-1 py-0.5 rounded">Class</code> parameter. TailwindMerge ensures your classes override the built-in variant styles.
                </p>
                        </text>
}
        </div>
        <div class="flex flex-wrap gap-4">
            <Badge Class="border-transparent bg-green-600 text-white hover:bg-green-700">@L.T("成功", "Success")</Badge>
            <Badge Class="border-transparent bg-blue-600 text-white hover:bg-blue-700">@L.T("信息", "Info")</Badge>
            <Badge Class="border-transparent bg-amber-500 text-white hover:bg-amber-600">@L.T("警告", "Warning")</Badge>
            <Badge Class="border-transparent bg-gradient-to-r from-purple-500 to-pink-500 text-white hover:from-purple-600 hover:to-pink-600">@L.T("品牌", "Brand")</Badge>
        </div>

        <CodeBlock Source="Components/Badge/custom-variants.txt" />
    </div>

    <!-- With Icons -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("带图标", "With Icons")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("徽标里可以放图标或其他内容。", "Badges can include icons or other content.")
            </p>
        </div>
        <div class="flex flex-wrap gap-4">
            <Badge Variant="BadgeVariant.Default">
                <LucideIcon Name="check" Size="12" Class="mr-1" />
                @L.T("已验证", "Verified")
            </Badge>
            <Badge Variant="BadgeVariant.Destructive">
                <LucideIcon Name="x" Size="12" Class="mr-1" />
                @L.T("已关闭", "Closed")
            </Badge>
            <Badge Variant="BadgeVariant.Secondary">
                <LucideIcon Name="star" Size="12" Class="mr-1" />
                @L.T("精选", "Featured")
            </Badge>
            <Badge Variant="BadgeVariant.Outline">
                <LucideIcon Name="heart" Size="12" Class="mr-1" />
                @L.T("收藏", "Favorite")
            </Badge>
        </div>

        <CodeBlock Source="Components/Badge/with-icons.txt" />
    </div>

    <!-- Notification Dot -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("通知圆点", "Notification Dot")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    用 <code class="text-xs bg-muted px-1 py-0.5 rounded">ShowDot</code> 给徽标加上一个小圆点指示。
                    用 <code class="text-xs bg-muted px-1 py-0.5 rounded">DotPosition</code> 控制位置，用 <code class="text-xs bg-muted px-1 py-0.5 rounded">DotClass</code> 控制颜色。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Add a small dot indicator to badges using <code class="text-xs bg-muted px-1 py-0.5 rounded">ShowDot</code>.
                    Control the position with <code class="text-xs bg-muted px-1 py-0.5 rounded">DotPosition</code> and the color with <code class="text-xs bg-muted px-1 py-0.5 rounded">DotClass</code>.
                </p>
                        </text>
}
        </div>
        <div class="space-y-4">
            <div class="flex flex-wrap gap-6">
                <Badge Variant="BadgeVariant.Default" ShowDot>Default</Badge>
                <Badge Variant="BadgeVariant.Secondary" ShowDot>Secondary</Badge>
                <Badge Variant="BadgeVariant.Destructive" ShowDot DotClass="bg-destructive">Destructive</Badge>
                <Badge Variant="BadgeVariant.Outline" ShowDot>Outline</Badge>
            </div>
            <div class="flex flex-wrap gap-6">
                <Badge ShowDot DotPosition="BadgeDotPosition.TopRight">@L.T("右上", "Top Right")</Badge>
                <Badge ShowDot DotPosition="BadgeDotPosition.TopLeft">@L.T("左上", "Top Left")</Badge>
                <Badge ShowDot DotPosition="BadgeDotPosition.BottomRight">@L.T("右下", "Bottom Right")</Badge>
                <Badge ShowDot DotPosition="BadgeDotPosition.BottomLeft">@L.T("左下", "Bottom Left")</Badge>
            </div>
            <div class="flex flex-wrap gap-6">
                <Badge Variant="BadgeVariant.Outline" ShowDot DotClass="bg-green-500">@L.T("在线", "Online")</Badge>
                <Badge Variant="BadgeVariant.Outline" ShowDot DotClass="bg-yellow-500">@L.T("离开", "Away")</Badge>
                <Badge Variant="BadgeVariant.Outline" ShowDot DotClass="bg-red-500">@L.T("忙碌", "Busy")</Badge>
                <Badge Variant="BadgeVariant.Outline" ShowDot DotClass="bg-gray-400">@L.T("离线", "Offline")</Badge>
            </div>
        </div>

        <CodeBlock Source="Components/Badge/notification-dot.txt" />
    </div>

    <!-- Accessibility -->

    <section class="space-y-4">
        <span id="badge-icon" class="block scroll-mt-20" aria-hidden="true"></span>
        <h2 class="text-2xl font-semibold">@L.T("语义色与柔和徽标", "Semantic and soft badges")</h2>
<div class="flex flex-wrap gap-2">
    <Badge Variant="BadgeVariant.Success"><BadgeIcon Name="check" />@L.T("已通过", "Approved")</Badge>
    <Badge Variant="BadgeVariant.SoftSuccess">@L.T("健康", "Healthy")</Badge>
    <Badge Variant="BadgeVariant.SoftWarning"><BadgeIcon Name="triangle-alert" />@L.T("需要复核", "Needs review")</Badge>
    <Badge Variant="BadgeVariant.SoftInfo">@L.T("信息", "Information")</Badge>
    <Badge Variant="BadgeVariant.SoftDestructive">@L.T("失败", "Failed")</Badge>
    <Badge Variant="BadgeVariant.Soft">@L.T("新增", "New")</Badge>
</div>
        <CodeBlock Source="Components/Badge/extended.txt" />

    </section>

    <!-- API Reference -->


    <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>
                @L.T("文字要简短：徽标最适合 1-2 个词或小数字。", "Keep text concise: Badges work best with 1-2 words or small numbers.")
            </AccessibilityItem>
            <AccessibilityItem>
                @L.T("徽标文字应当自解释、有实际含义。", "Badge text should be self-explanatory and meaningful.")
            </AccessibilityItem>
            <AccessibilityItem>
                @L.T("不要只靠颜色传达含义，要配上文字。", "Don't rely solely on color to convey meaning. Include text.")
            </AccessibilityItem>
            <AccessibilityItem>
                @L.T("确保结合上下文就能看懂徽标表达的含义。", "Ensure the badge's meaning is clear from surrounding content.")
            </AccessibilityItem>
        </AriaAttributes>
    </AccessibilityList>

    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件的属性与参数。", "Component properties and parameters.")</p>
        </div>

        <div class="space-y-4">
            <ApiReference ComponentName="Badge">
                <ApiParameter Name="Variant" Type="BadgeVariant" Default="Default">
                    @L.T("视觉样式变体。可选值：Default、Secondary、Destructive、Outline。", "The visual style variant. Options: Default, Secondary, Destructive, Outline.")
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?">
                    @L.T("追加到徽标元素的额外 CSS 类。", "Additional CSS classes to apply to the badge element.")
                </ApiParameter>
                <ApiParameter Name="ChildContent" Type="RenderFragment?">
                    @L.T("徽标内部显示的内容（文字、图标、数字等）。", "The content to display inside the badge (text, icons, numbers, etc.).")
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            应用到根 <code>&lt;div&gt;</code> 元素的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                                        </text>
}
                    else
                    {
                                        <text>
                                            Additional HTML attributes applied to the root <code>&lt;div&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                                        </text>
}
                </ApiParameter>
            </ApiReference>
        </div>

<ApiReference ComponentName="BadgeVariant"><ApiParameter Since="v4" Name="Success / Warning / Info / Soft / SoftDestructive / SoftSuccess / SoftWarning / SoftInfo" Type="BadgeVariant">@L.T("另外支持 Success、Warning、Info、Soft、SoftSuccess、SoftWarning、SoftInfo 与 SoftDestructive。颜色之外仍要保留有意义的状态文字。", "Also supports Success, Warning, Info, Soft, SoftSuccess, SoftWarning, SoftInfo and SoftDestructive. Keep meaningful status text alongside color.")</ApiParameter></ApiReference>
        <ApiReference ComponentName="BadgeIcon" Since="v4">
            <ApiParameter Name="Name" Type="string?" Default="null">@L.T("Lucide 图标名。提供 ChildContent 时可以省略。", "Lucide icon name. Omit when providing ChildContent.")</ApiParameter>
            <ApiParameter Name="ChildContent" Type="RenderFragment?">@L.T("自定义的装饰性图标内容。", "Custom decorative icon content.")</ApiParameter>
            <ApiParameter Name="Class" Type="string?">@L.T("图标包裹层的额外 CSS 类。图标对辅助技术隐藏，请给徽标配上含义明确的文字。", "Additional icon wrapper classes. The icon is hidden from assistive technology; give the badge meaningful text.")</ApiParameter>
        </ApiReference>
    </section>

</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;
}
