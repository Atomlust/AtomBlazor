            else
            {
                        <text>
                            <ApiParameter Name="View" Type="EventCalendarView" Default="EventCalendarView.Month">The active view. Use @@bind-View for two-way binding.</ApiParameter>
                        </text>
}
            <ApiParameter Name="ViewChanged" Type="EventCallback&lt;EventCalendarView&gt;">@L.T("当前视图变化时的回调。", "Callback when the active view changes.")</ApiParameter>
            @if (L.IsChinese)
            {
                        <text>
                            <ApiParameter Name="CurrentDate" Type="DateTime" Default="DateTime.Today">控制可见区间的日期（所在月份或周）。使用 @@bind-CurrentDate 进行双向绑定。默认为今天。</ApiParameter>
                        </text>
}
            else
            {
                        <text>
                            <ApiParameter Name="CurrentDate" Type="DateTime" Default="DateTime.Today">The date that controls the visible period (the month or week containing it). Use @@bind-CurrentDate for two-way binding. Defaults to today.</ApiParameter>
                        </text>
}
            <ApiParameter Name="CurrentDateChanged" Type="EventCallback&lt;DateTime&gt;">@L.T("通过导航改变当前日期时的回调。", "Callback when the current date changes through navigation.")</ApiParameter>
            @if (L.IsChinese)
            {
                        <text>
                            <ApiParameter Name="FirstDayOfWeek" Type="DayOfWeek?">一周的第一天。默认取当前文化的一周首日。</ApiParameter>
                        </text>
}
            else
            {
                        <text>
                            <ApiParameter Name="FirstDayOfWeek" Type="DayOfWeek?">The first day of the week. Defaults to the current culture&#x27;s first day of the week.</ApiParameter>
                        </text>
}
            @if (L.IsChinese)
            {
                        <text>
                            <ApiParameter Name="MaxEventsPerDay" Type="int" Default="3">月视图中每天最多显示的事件条数量，超出后出现溢出按钮 “+x more”。默认为 3。</ApiParameter>
                        </text>
}
            else
            {
                        <text>
                            <ApiParameter Name="MaxEventsPerDay" Type="int" Default="3">The maximum number of event chips shown per day in the month view before the overflow &quot;+x more&quot; button appears. Defaults to 3.</ApiParameter>
                        </text>
}
            <ApiParameter Name="OnEventClick" Type="EventCallback&lt;TEvent&gt;">@L.T("点击事件条时的回调。", "Callback when an event chip is clicked.")</ApiParameter>
            <ApiParameter Name="OnDateClick" Type="EventCallback&lt;DateTime&gt;">@L.T("点击日期数字（月视图）或日期表头（周视图）时的回调。", "Callback when a day number (month view) or day header (week view) is clicked.")</ApiParameter>
            <ApiParameter Name="OnViewRangeChanged" Type="EventCallback&lt;EventCalendarRange&gt;">@L.T("可见日期区间变化（含初始区间）时的回调。便于按需加载事件。", "Callback when the visible date range changes (including the initial range). Useful for loading events on demand.")</ApiParameter>
            <ApiParameter Name="Class" Type="string?">@L.T("应用到根元素上的额外 CSS 类。", "Additional CSS classes to apply to the root element.")</ApiParameter>
            <ApiParameter Name="ContainerClass" Type="string?">@L.T("应用到视图容器（月网格、周网格或日程列表）而非根元素上的额外 CSS 类。根元素还包裹了工具条，因此给它定尺寸并不等于给视图定尺寸。", "Additional CSS classes to apply to the view container (month grid, week grid or agenda list) rather than the root element. The root wraps the toolbar too, so sizing it does not size the view.")</ApiParameter>
            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">@L.T("应用到根元素上的额外属性。", "Additional attributes to apply to the root element.")</ApiParameter>
        </ApiReference>
    </section>

