                        </text>
}
            else
            {
                        <text>
                            <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    Additional HTML attributes applied to the root <code>&lt;div&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                </ApiParameter>
                        </text>
}
        </ApiReference>

        <ApiReference ComponentName="EventCalendar">
            <ApiParameter Name="EventStart" Type="Func&lt;TEvent, DateTime&gt;">@L.T("必填函数，返回每个事件的开始日期与时间。", "Required function returning each event's start date and time.")</ApiParameter>
            <ApiParameter Name="EventTitle" Type="Func&lt;TEvent, string&gt;">@L.T("必填函数，返回每个事件的显示标题。", "Required function returning each event's display title.")</ApiParameter>
            <ApiParameter Name="Items" Type="IEnumerable&lt;TEvent&gt;?">@L.T("要显示的事件。", "The events to display.")</ApiParameter>
            <ApiParameter Name="EventEnd" Type="Func&lt;TEvent, DateTime?&gt;?">@L.T("返回事件的结束日期/时间；时间点事件返回 null。当委托本身为 null 时，所有事件都视为时间点事件。结束日期落在比开始更晚一天的事件，会绘制成横跨其所覆盖日期的一根长条，跨越周边界时则每周行绘制一根长条。", "Returns the end date/time of an event, or null for a point-in-time event. When the delegate itself is null, all events are treated as point-in-time. An event whose end date falls on a later day than its start is drawn as one bar across the days it covers, and as one bar per week row when it crosses a week boundary.")</ApiParameter>
            @if (L.IsChinese)
            {
                        <text>
                            <ApiParameter Name="EventClass" Type="Func&lt;TEvent, string?&gt;?">返回特定事件事件条的额外 CSS 类，与内置事件条类合并。用于按事件着色（例如按类别）。</ApiParameter>
                        </text>
}
            else
            {
                        <text>
                            <ApiParameter Name="EventClass" Type="Func&lt;TEvent, string?&gt;?">Returns additional CSS classes for a specific event&#x27;s chip, merged with the built-in chip classes. Use this for per-event coloring (e.g. by category).</ApiParameter>
                        </text>
}
            <ApiParameter Name="EventTemplate" Type="RenderFragment&lt;TEvent&gt;?">@L.T("可选模板，完全替换内置事件条的内容。设置后事件条按钮只应用最少的布局/焦点类；可与 EventClass 组合做事件条级样式。", "Optional template that fully replaces the built-in event chip content. When set, only minimal layout/focus classes are applied to the chip button; combine with EventClass for chip-level styling.")</ApiParameter>
            @if (L.IsChinese)
            {
                        <text>
