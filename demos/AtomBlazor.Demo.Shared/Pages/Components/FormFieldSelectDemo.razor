    private void InitFfsCompScroll()
    {
        _ffsCompScrollVisible = _allFfsCompCountries.Take(ffsPageSize).ToArray();
    }

    private async Task HandleFfsCompLoadMore()
    {
        _ffsCompScrollIsLoading = true;
        // BL0012（.NET 11）：事件处理器触发的重渲染由框架自动完成，此处的显式 StateHasChanged 无需保留。

        await Task.Delay(300);

        var nextCount = _ffsCompScrollVisible.Length + ffsPageSize;
        _ffsCompScrollVisible = _allFfsCompCountries.Take(nextCount).ToArray();
        _ffsCompScrollIsLoading = false;
    }
