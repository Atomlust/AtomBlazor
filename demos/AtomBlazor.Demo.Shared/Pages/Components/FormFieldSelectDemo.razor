@page "/components/form-field-select"
@using System.ComponentModel.DataAnnotations

<PageTitle>@L.T("FormFieldSelect 下拉选择表单域 - Atom BlazorUI", "FormFieldSelect Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">FormFieldSelect</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("为 Select 提供表单域包装，自带标签、辅助文本、错误提示，并提供简化版 API。", "A form field wrapper for Select with built-in label, helper text, error messages, and a simplified API.")
            </p>
        </div>
    </div>

    <!-- Which form component? -->
    <div class="rounded-lg border border-dashed bg-muted/30 p-6 space-y-3">
        <h2 class="text-lg font-semibold">@L.T("该用哪个表单组件？", "Which form component?")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <div class="space-y-2 text-sm text-muted-foreground">
                <p><strong>文本输入</strong>（string、int、日期等）？ &rarr; <a href="/components/form-field-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldInput&lt;T&gt;</a></p>
                <p><strong>多行文本</strong>？ &rarr; <a href="/components/form-field-textarea" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldTextarea</a></p>
                <p><strong>数字输入</strong>？ &rarr; <a href="/components/form-field-numeric-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldNumericInput</a></p>
                <p><strong>货币输入</strong>？ &rarr; <a href="/components/form-field-currency-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCurrencyInput</a></p>
                <p><strong>掩码输入</strong>（电话、社保号等）？ &rarr; <a href="/components/form-field-masked-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldMaskedInput</a></p>
                <p><strong>OTP / 验证码</strong>？ &rarr; <a href="/components/form-field-input-otp" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldInputOTP</a></p>
                <p><strong>日期选择器</strong>？ &rarr; <a href="/components/form-field-date-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldDatePicker</a></p>
                <p><strong>日期范围选择器</strong>？ &rarr; <a href="/components/form-field-date-range-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldDateRangePicker</a></p>
                <p><strong>时间选择器</strong>？ &rarr; <a href="/components/form-field-time-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldTimePicker</a></p>
                <p><strong>复选框</strong>？ &rarr; <a href="/components/form-field-checkbox" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCheckbox</a></p>
                <p><strong>复选框组</strong>？ &rarr; <a href="/components/form-field-checkbox-group" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCheckboxGroup</a></p>
                <p><strong>开关</strong>？ &rarr; <a href="/components/form-field-switch" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldSwitch</a></p>
                <p><strong>单选组</strong>？ &rarr; <a href="/components/form-field-radio-group" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldRadioGroup</a></p>
                <p><strong>下拉选择</strong>？ &rarr; <strong>FormFieldSelect</strong>（当前页面）</p>
                <p><strong>原生选择框</strong>？ &rarr; <a href="/components/form-field-native-select" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldNativeSelect</a></p>
                <p><strong>可搜索选择</strong>？ &rarr; <a href="/components/form-field-combobox" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCombobox</a></p>
                <p><strong>多选</strong>？ &rarr; <a href="/components/form-field-multi-select" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldMultiSelect</a></p>
                <p><strong>标签输入</strong>？ &rarr; <a href="/components/form-field-tag-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldTagInput</a></p>
                <p><strong>文件上传</strong>？ &rarr; <a href="/components/form-field-file-upload" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldFileUpload</a></p>
            </div>
                </text>
}
        else
        {
                <text>
                    <div class="space-y-2 text-sm text-muted-foreground">
                <p><strong>Text input</strong> (string, int, date, etc.)? &rarr; <a href="/components/form-field-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldInput&lt;T&gt;</a></p>
                <p><strong>Textarea</strong>? &rarr; <a href="/components/form-field-textarea" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldTextarea</a></p>
                <p><strong>Numeric input</strong>? &rarr; <a href="/components/form-field-numeric-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldNumericInput</a></p>
                <p><strong>Currency input</strong>? &rarr; <a href="/components/form-field-currency-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCurrencyInput</a></p>
                <p><strong>Masked input</strong> (phone, SSN, etc.)? &rarr; <a href="/components/form-field-masked-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldMaskedInput</a></p>
                <p><strong>OTP / verification code</strong>? &rarr; <a href="/components/form-field-input-otp" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldInputOTP</a></p>
                <p><strong>Date picker</strong>? &rarr; <a href="/components/form-field-date-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldDatePicker</a></p>
                <p><strong>Date range picker</strong>? &rarr; <a href="/components/form-field-date-range-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldDateRangePicker</a></p>
                <p><strong>Time picker</strong>? &rarr; <a href="/components/form-field-time-picker" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldTimePicker</a></p>
                <p><strong>Checkbox</strong>? &rarr; <a href="/components/form-field-checkbox" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCheckbox</a></p>
                <p><strong>Checkbox group</strong>? &rarr; <a href="/components/form-field-checkbox-group" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCheckboxGroup</a></p>
                <p><strong>Switch</strong>? &rarr; <a href="/components/form-field-switch" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldSwitch</a></p>
                <p><strong>Radio group</strong>? &rarr; <a href="/components/form-field-radio-group" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldRadioGroup</a></p>
                <p><strong>Select dropdown</strong>? &rarr; <strong>FormFieldSelect</strong> (this page)</p>
                <p><strong>Native select</strong>? &rarr; <a href="/components/form-field-native-select" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldNativeSelect</a></p>
                <p><strong>Searchable select</strong>? &rarr; <a href="/components/form-field-combobox" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldCombobox</a></p>
                <p><strong>Multi-select</strong>? &rarr; <a href="/components/form-field-multi-select" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldMultiSelect</a></p>
                <p><strong>Tag input</strong>? &rarr; <a href="/components/form-field-tag-input" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldTagInput</a></p>
                <p><strong>File upload</strong>? &rarr; <a href="/components/form-field-file-upload" class="text-primary underline underline-offset-4 hover:text-primary/80">FormFieldFileUpload</a></p>
            </div>
                </text>
}
    </div>

    <!-- Data-Binding Mode -->
    <div class="space-y-4">
        <div class="space-y-2">
            <div class="flex items-center gap-2">
                <h2 class="text-2xl font-semibold">@L.T("数据绑定模式", "Data-Binding Mode")</h2>
                <span class="inline-flex items-center rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary ring-1 ring-inset ring-primary/20">v3</span>
            </div>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    传入一个 <code class="text-xs bg-muted px-1 py-0.5 rounded">Options</code> 集合，元素是
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">SelectOption&lt;TValue&gt;</code> 值/标签对，即可自动生成
                    SelectItem 子内容。当值与标签相同时，请使用 <code class="text-xs bg-muted px-1 py-0.5 rounded">SelectOption.FromValue</code>。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Pass an <code class="text-xs bg-muted px-1 py-0.5 rounded">Options</code> collection of
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">SelectOption&lt;TValue&gt;</code> pairs to auto-generate
                    SelectItem children. Use <code class="text-xs bg-muted px-1 py-0.5 rounded">SelectOption.FromValue</code> when value and label are the same.
                </p>
                        </text>
}
        </div>
        <div class="max-w-md">
            <FormFieldSelect AriaLabel="@(L.T("喜爱的水果", "Favorite fruit"))" TValue="string"
                             @bind-Value="_fruitDataBound"
                             Label="@(L.T("喜爱的水果", "Favorite fruit"))"
                             Placeholder="@(L.T("请选择水果……", "Select a fruit..."))"
                             HelperText="@(L.T("从列表里挑一个。", "Pick one from the list."))"
                             Options="@_fruitOptions" />
        </div>
        <div class="rounded-lg border p-4 bg-muted/50">
            <p class="text-sm font-medium mb-1">@L.T("已选择：", "Selected:")</p>
            <p class="text-sm font-mono">@(string.IsNullOrEmpty(_fruitDataBound) ? L.T("(无)", "(none)") : _fruitDataBound)</p>
        </div>

        <CodeBlock Source="Components/FormFieldSelect/data-binding.txt" />
    </div>

    <!-- Value/Label Pairs -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("值/标签配对", "Value/Label Pairs")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    当绑定的值与显示的文本不一致时，每个
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">SelectOption</code> 会把一个值映射到它的标签。
                    适合绑定 ID（string、int、Guid）同时显示名称。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    When the bound value differs from the display text, each
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">SelectOption</code> maps a value to its label.
                    Useful for binding to IDs (string, int, Guid) while displaying names.
                </p>
                        </text>
}
        </div>
        <div class="max-w-md">
            <FormFieldSelect TValue="string"
                             @bind-Value="_selectedUserId"
                             Label="@(L.T("团队成员", "Team member"))"
                             Placeholder="@(L.T("请选择成员……", "Select a member..."))"
                             HelperText="@(L.T("绑定的值是用户 ID，而不是姓名。", "Value binds to the user ID, not the name."))"
                             Options="@_userOptions" />
        </div>
        <div class="rounded-lg border p-4 bg-muted/50">
            <p class="text-sm font-medium mb-1">@L.T("绑定值（用户 ID）：", "Bound value (user ID):")</p>
            <p class="text-sm font-mono">@(string.IsNullOrEmpty(_selectedUserId) ? L.T("(无)", "(none)") : _selectedUserId)</p>
        </div>

        <CodeBlock Source="Components/FormFieldSelect/value-label-pairs.txt" />
    </div>

    <!-- Basic Example (Compositional) -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("组合式模式", "Compositional Mode")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    把 SelectItem 作为子内容提供，就能完全控制条目的渲染 &mdash;
                    适合图标、头像或自定义布局一类的富内容。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Provide SelectItem children for full control over item rendering &mdash;
                    useful for rich content like icons, avatars, or custom layouts.
                </p>
                        </text>
}
        </div>
        <div class="max-w-md">
            <FormFieldSelect TValue="string"
                             @bind-Value="_fruit"
                             Label="@(L.T("喜爱的水果", "Favorite fruit"))"
                             Placeholder="@(L.T("请选择水果……", "Select a fruit..."))"
                             HelperText="@(L.T("从列表里挑一个。", "Pick one from the list."))">
                <AtomBlazor.SelectItem Value="@("apple")" Text="Apple">Apple</AtomBlazor.SelectItem>
                <AtomBlazor.SelectItem Value="@("banana")" Text="Banana">Banana</AtomBlazor.SelectItem>
                <AtomBlazor.SelectItem Value="@("cherry")" Text="Cherry">Cherry</AtomBlazor.SelectItem>
                <AtomBlazor.SelectItem Value="@("grape")" Text="Grape">Grape</AtomBlazor.SelectItem>
            </FormFieldSelect>
        </div>
        <div class="rounded-lg border p-4 bg-muted/50">
            <p class="text-sm font-medium mb-1">@L.T("已选择：", "Selected:")</p>
            <p class="text-sm font-mono">@(string.IsNullOrEmpty(_fruit) ? L.T("(无)", "(none)") : _fruit)</p>
        </div>

        <CodeBlock Source="Components/FormFieldSelect/compositional.txt" />
    </div>

    <!-- With Flag Icons -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("带国旗图标", "With Flag Icons")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    想要让触发器显示富内容（选中后显示国旗），请使用组合式
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">Select</code>，并给它
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">SelectValue</code> 提供 ChildContent。
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">@@context</code> 变量会给出显示的文本。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    For rich trigger display (showing the flag after selection), use the compositional
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">Select</code> with
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">SelectValue</code> ChildContent.
                    The <code class="text-xs bg-muted px-1 py-0.5 rounded">@@context</code> variable provides the display text.
                </p>
                        </text>
}
        </div>
        <div class="max-w-md">
            <Select TValue="string" @bind-Value="_country" Class="w-full">
                <AtomBlazor.SelectTrigger>
                    <AtomBlazor.SelectValue Placeholder="@(L.T("请选择国家……", "Select a country..."))">
                        <span class="flex items-center gap-2">@GetCountryFlag(_country) @context</span>
                    </AtomBlazor.SelectValue>
                </AtomBlazor.SelectTrigger>
                <AtomBlazor.SelectContent>
                    <AtomBlazor.SelectItem Value="@("us")" Text="United States">
                        <div class="flex items-center gap-2">
                            <span class="text-base">&#x1F1FA;&#x1F1F8;</span>
                            <span>United States</span>
                        </div>
                    </AtomBlazor.SelectItem>
                    <AtomBlazor.SelectItem Value="@("ca")" Text="Canada">
                        <div class="flex items-center gap-2">
                            <span class="text-base">&#x1F1E8;&#x1F1E6;</span>
                            <span>Canada</span>
                        </div>
                    </AtomBlazor.SelectItem>
                    <AtomBlazor.SelectItem Value="@("gb")" Text="United Kingdom">
                        <div class="flex items-center gap-2">
                            <span class="text-base">&#x1F1EC;&#x1F1E7;</span>
                            <span>United Kingdom</span>
                        </div>
                    </AtomBlazor.SelectItem>
                    <AtomBlazor.SelectItem Value="@("de")" Text="Germany">
                        <div class="flex items-center gap-2">
                            <span class="text-base">&#x1F1E9;&#x1F1EA;</span>
                            <span>Germany</span>
                        </div>
                    </AtomBlazor.SelectItem>
                    <AtomBlazor.SelectItem Value="@("fr")" Text="France">
                        <div class="flex items-center gap-2">
                            <span class="text-base">&#x1F1EB;&#x1F1F7;</span>
                            <span>France</span>
                        </div>
                    </AtomBlazor.SelectItem>
                </AtomBlazor.SelectContent>
            </Select>
        </div>
        <div class="rounded-lg border p-4 bg-muted/50">
            <p class="text-sm font-medium mb-1">@L.T("已选择：", "Selected:")</p>
            <p class="text-sm font-mono">@(string.IsNullOrEmpty(_country) ? L.T("(无)", "(none)") : _country)</p>
        </div>

        <CodeBlock Source="Components/FormFieldSelect/flag-icons.txt" />
    </div>

    <!-- With Avatars -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("带头像", "With Avatars")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("把 Avatar 组件与 SelectItem 组合起来，就能做出用户或团队成员选择器。", "Combine Avatar components with SelectItem to create a user or team member picker.")
            </p>
        </div>
        <div class="max-w-md">
            <FormFieldSelect TValue="string"
                             @bind-Value="_assignee"
                             Label="@(L.T("指派给", "Assign to"))"
                             Placeholder="@(L.T("请选择团队成员……", "Select a team member..."))">
                <AtomBlazor.SelectItem Value="@("alice")" Text="Alice Martin">
                    <div class="flex items-center gap-2">
                        <Avatar Size="AvatarSize.Small" Class="h-6 w-6 text-[10px]">
                            <AvatarFallback>AM</AvatarFallback>
                        </Avatar>
                        <div class="flex flex-col">
                            <span class="text-sm">Alice Martin</span>
                            <span class="text-xs text-muted-foreground">Engineering</span>
                        </div>
                    </div>
                </AtomBlazor.SelectItem>
                <AtomBlazor.SelectItem Value="@("bob")" Text="Bob Chen">
                    <div class="flex items-center gap-2">
                        <Avatar Size="AvatarSize.Small" Class="h-6 w-6 text-[10px]">
                            <AvatarFallback>BC</AvatarFallback>
                        </Avatar>
                        <div class="flex flex-col">
                            <span class="text-sm">Bob Chen</span>
                            <span class="text-xs text-muted-foreground">Design</span>
                        </div>
                    </div>
                </AtomBlazor.SelectItem>
                <AtomBlazor.SelectItem Value="@("carol")" Text="Carol Davis">
                    <div class="flex items-center gap-2">
                        <Avatar Size="AvatarSize.Small" Class="h-6 w-6 text-[10px]">
                            <AvatarFallback>CD</AvatarFallback>
                        </Avatar>
                        <div class="flex flex-col">
                            <span class="text-sm">Carol Davis</span>
                            <span class="text-xs text-muted-foreground">Product</span>
                        </div>
                    </div>
                </AtomBlazor.SelectItem>
                <AtomBlazor.SelectItem Value="@("dan")" Text="Dan Wilson">
                    <div class="flex items-center gap-2">
                        <Avatar Size="AvatarSize.Small" Class="h-6 w-6 text-[10px]">
                            <AvatarFallback>DW</AvatarFallback>
                        </Avatar>
                        <div class="flex flex-col">
                            <span class="text-sm">Dan Wilson</span>
                            <span class="text-xs text-muted-foreground">Engineering</span>
                        </div>
                    </div>
                </AtomBlazor.SelectItem>
            </FormFieldSelect>
        </div>
        <div class="rounded-lg border p-4 bg-muted/50">
            <p class="text-sm font-medium mb-1">@L.T("已指派给：", "Assigned to:")</p>
            <p class="text-sm font-mono">@(string.IsNullOrEmpty(_assignee) ? L.T("(无)", "(none)") : _assignee)</p>
        </div>

        <CodeBlock Source="Components/FormFieldSelect/avatars.txt" />
    </div>

    <!-- Non-String Value Types -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("非字符串值类型", "Non-String Value Types")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    把 <code class="text-xs bg-muted px-1 py-0.5 rounded">Options</code> 与
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">SelectOption&lt;TValue&gt;</code> 一起使用，即可绑定
                    类似 <code class="text-xs bg-muted px-1 py-0.5 rounded">int?</code> 的非字符串值。
                    显示文本会自动取自条目的 <code class="text-xs bg-muted px-1 py-0.5 rounded">Text</code> 属性。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use <code class="text-xs bg-muted px-1 py-0.5 rounded">Options</code> with
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">SelectOption&lt;TValue&gt;</code> to bind
                    non-string values like <code class="text-xs bg-muted px-1 py-0.5 rounded">int?</code>.
                    The display text is derived from the option's <code class="text-xs bg-muted px-1 py-0.5 rounded">Text</code> property automatically.
                </p>
                        </text>
}
        </div>
        <div class="max-w-md">
            <FormFieldSelect TValue="int?"
                             @bind-Value="_priorityLevel"
                             Label="@(L.T("优先级", "Priority"))"
                             Placeholder="@(L.T("请选择优先级……", "Select priority..."))"
                             Options="_priorityOptions" />
        </div>
        <div class="rounded-lg border p-4 bg-muted/50">
            <p class="text-sm font-medium mb-1">@L.T("选中值：", "Selected value:")</p>
            <p class="text-sm font-mono">@(_priorityLevel?.ToString() ?? L.T("(无)", "(none)"))</p>
        </div>

        <CodeBlock Source="Components/FormFieldSelect/non-string-types.txt" />
    </div>

    <!-- Disabled -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("禁用", "Disabled")</h2>
