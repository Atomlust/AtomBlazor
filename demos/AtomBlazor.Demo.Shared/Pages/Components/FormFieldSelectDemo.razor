    private void InitFfsScroll()
    {
        _ffsScrollCountries = _allFfsCountries.Take(ffsPageSize).ToArray();
    }

    private async Task HandleFfsLoadMore()
    {
        _ffsScrollIsLoading = true;
        // BL0012（.NET 11）：事件处理器触发的重渲染由框架自动完成，此处的显式 StateHasChanged 无需保留。

        await Task.Delay(300);

        var nextCount = _ffsScrollCountries.Length + ffsPageSize;
        _ffsScrollCountries = _allFfsCountries.Take(nextCount).ToArray();
        _ffsScrollIsLoading = false;
    }

