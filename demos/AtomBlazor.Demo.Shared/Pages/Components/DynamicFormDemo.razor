@page "/components/dynamic-form"

<PageTitle>@L.T("Dynamic Form 动态表单 - Atom BlazorUI", "Dynamic Form Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("Dynamic Form 动态表单", "Dynamic Form")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("由架构（schema）定义渲染表单。表单结构来自后端配置的 CMS、管理面板与设置页可借此免去手工编码表单。", "Render forms from schema definitions. Eliminates hand-coding forms for CMS, admin panels, and settings pages where form structure comes from backend configuration.")
            </p>
        </div>
    </div>

    <!-- Field Type Gallery -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("字段类型一览", "Field Type Gallery")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("在一个表单中渲染全部受支持的字段类型。每个分区归拢相关的输入类型，便于纵览可用的全部控件。", "Every supported field type rendered in a single form. Each section groups related input types so you can see the full range of controls available.")
            </p>
        </div>
        <DynamicForm Schema="@_gallerySchema"
                       @bind-Values="_galleryValues"
                       Columns="2"
                       ShowSubmitButton="false" />
        <div class="rounded-lg border p-4 bg-muted/50">
            <p class="text-sm font-medium mb-1">@L.T("当前值：", "Current values:")</p>
            <pre class="text-sm font-mono whitespace-pre-wrap">@FormatValues(_galleryValues, L)</pre>
        </div>
        <CodeBlock Source="Components/DynamicForm/field-type-gallery.txt" />
    </div>

    <!-- Basic Form -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("基础动态表单", "Basic Dynamic Form")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("定义包含字段定义的架构，表单会为每种字段类型渲染正确的输入组件。", "Define a schema with field definitions and the form renders the correct input component for each field type.")
            </p>
        </div>
        <div class="max-w-lg">
            <DynamicForm Schema="@_basicSchema"
                           @bind-Values="_basicValues"
                           OnValidSubmit="HandleBasicSubmit" />
        </div>
        @if (_basicSubmitMessage is not null)
        {
            <Alert Variant="AlertVariant.Success" Dismissible="true" OnDismiss="() => _basicSubmitMessage = null">
                <AlertTitle>@L.T("表单已提交", "Form Submitted")</AlertTitle>
                <AlertDescription>@_basicSubmitMessage</AlertDescription>
            </Alert>
        }
        <div class="rounded-lg border p-4 bg-muted/50">
            <p class="text-sm font-medium mb-1">@L.T("当前值：", "Current values:")</p>
            <pre class="text-sm font-mono whitespace-pre-wrap">@FormatValues(_basicValues, L)</pre>
        </div>
        <CodeBlock Source="Components/DynamicForm/basic.txt" />
    </div>

    <!-- Multi-Section Form -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("多分区表单", "Multi-Section Form")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("把相关字段归入带标题与说明的分区，并可选启用可折叠行为。", "Group related fields into sections with headings, descriptions, and optional collapsible behavior.")
            </p>
        </div>
        <div class="max-w-2xl">
            <DynamicForm Schema="@_sectionSchema"
                           @bind-Values="_sectionValues"
                           OnValidSubmit="HandleSectionSubmit" />
        </div>
        @if (_sectionSubmitMessage is not null)
        {
            <Alert Variant="AlertVariant.Success" Dismissible="true" OnDismiss="() => _sectionSubmitMessage = null">
                <AlertTitle>@L.T("表单已提交", "Form Submitted")</AlertTitle>
                <AlertDescription>@_sectionSubmitMessage</AlertDescription>
            </Alert>
        }
        <div class="rounded-lg border p-4 bg-muted/50">
            <p class="text-sm font-medium mb-1">@L.T("当前值：", "Current values:")</p>
            <pre class="text-sm font-mono whitespace-pre-wrap">@FormatValues(_sectionValues, L)</pre>
        </div>
        <CodeBlock Source="Components/DynamicForm/multi-section.txt" />
    </div>

    <!-- Conditional Visibility -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("条件显隐", "Conditional Visibility")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    使用 <code class="text-xs bg-muted px-1 py-0.5 rounded">VisibleWhen</code> 表达式依据其他字段的值显示或隐藏字段。
                    将国家选择为 "US" 即可显示 State 字段。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Show or hide fields based on other field values using <code class="text-xs bg-muted px-1 py-0.5 rounded">VisibleWhen</code> expressions.
                    Select "US" as the country to reveal the State field.
                </p>
                        </text>
}
        </div>
        <div class="max-w-lg">
            <DynamicForm Schema="@_conditionalSchema"
                           @bind-Values="_conditionalValues"
                           OnValidSubmit="HandleConditionalSubmit" />
        </div>
        @if (_conditionalSubmitMessage is not null)
        {
            <Alert Variant="AlertVariant.Success" Dismissible="true" OnDismiss="() => _conditionalSubmitMessage = null">
                <AlertTitle>@L.T("表单已提交", "Form Submitted")</AlertTitle>
                <AlertDescription>@_conditionalSubmitMessage</AlertDescription>
            </Alert>
        }
        <div class="rounded-lg border p-4 bg-muted/50">
            <p class="text-sm font-medium mb-1">@L.T("当前值：", "Current values:")</p>
            <pre class="text-sm font-mono whitespace-pre-wrap">@FormatValues(_conditionalValues, L)</pre>
        </div>
        <CodeBlock Source="Components/DynamicForm/conditional-visibility.txt" />
    </div>

    <!-- Multi-Column Layout -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("多列布局", "Multi-Column Layout")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    使用 <code class="text-xs bg-muted px-1 py-0.5 rounded">Columns</code> 参数实现响应式网格布局。
                    字段可以通过 <code class="text-xs bg-muted px-1 py-0.5 rounded">ColSpan</code> 跨多列。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use the <code class="text-xs bg-muted px-1 py-0.5 rounded">Columns</code> parameter for responsive grid layouts.
                    Fields can span multiple columns with <code class="text-xs bg-muted px-1 py-0.5 rounded">ColSpan</code>.
                </p>
                        </text>
}
        </div>
        <DynamicForm Schema="@_multiColSchema"
                       @bind-Values="_multiColValues"
                       Columns="2"
                       OnValidSubmit="HandleMultiColSubmit" />
        @if (_multiColSubmitMessage is not null)
        {
            <Alert Variant="AlertVariant.Success" Dismissible="true" OnDismiss="() => _multiColSubmitMessage = null">
                <AlertTitle>@L.T("表单已提交", "Form Submitted")</AlertTitle>
                <AlertDescription>@_multiColSubmitMessage</AlertDescription>
            </Alert>
        }
        <div class="rounded-lg border p-4 bg-muted/50">
            <p class="text-sm font-medium mb-1">@L.T("当前值：", "Current values:")</p>
            <pre class="text-sm font-mono whitespace-pre-wrap">@FormatValues(_multiColValues, L)</pre>
        </div>
        <CodeBlock Source="Components/DynamicForm/multi-column.txt" />
    </div>

    <!-- Form Layouts -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("表单布局", "Form Layouts")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">Layout</code> 参数控制标签与字段的排布方式。
                    用同一份架构对比 Vertical（默认）、Horizontal 与 Inline 三种布局。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    The <code class="text-xs bg-muted px-1 py-0.5 rounded">Layout</code> parameter controls how labels and fields are arranged.
                    Compare Vertical (default), Horizontal, and Inline layouts using the same schema.
                </p>
                        </text>
}
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="space-y-2">
                <h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wide">@L.T("纵向（默认）", "Vertical (default)")</h3>
                <div class="rounded-lg border p-4">
                    <DynamicForm Schema="@_layoutSchema"
                                   @bind-Values="_layoutVerticalValues"
                                   Layout="FormLayout.Vertical"
                                   ShowSubmitButton="false" />
                </div>
            </div>
            <div class="space-y-2">
                <h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wide">@L.T("水平", "Horizontal")</h3>
                <div class="rounded-lg border p-4">
                    <DynamicForm Schema="@_layoutSchema"
                                   @bind-Values="_layoutHorizontalValues"
                                   Layout="FormLayout.Horizontal"
                                   LabelWidth="4rem"
                                   ShowSubmitButton="false" />
                </div>
            </div>
        </div>
        <div class="space-y-2">
            <h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wide">@L.T("行内", "Inline")</h3>
            <div class="rounded-lg border p-4">
                <DynamicForm Schema="@_layoutSchema"
                               @bind-Values="_layoutInlineValues"
                               Layout="FormLayout.Inline"
                               ShowSubmitButton="false" />
            </div>
        </div>
        <CodeBlock Source="Components/DynamicForm/form-layouts.txt" />
    </div>

    <!-- JSON Schema -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("JSON Schema 驱动表单", "JSON Schema-Driven Form")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    使用 <code class="text-xs bg-muted px-1 py-0.5 rounded">FormSchemaParser.FromJson</code> 把 JSON Schema 字符串解析为表单定义。
                    适用于架构由服务端下发的 API 驱动表单。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Parse a JSON Schema string into a form definition using <code class="text-xs bg-muted px-1 py-0.5 rounded">FormSchemaParser.FromJson</code>.
                    Useful for API-driven forms where the schema comes from the server.
                </p>
                        </text>
}
        </div>
        <div class="max-w-lg">
            <DynamicForm Schema="@_jsonSchema"
                           @bind-Values="_jsonValues"
                           OnValidSubmit="HandleJsonSubmit" />
        </div>
        @if (_jsonSubmitMessage is not null)
        {
            <Alert Variant="AlertVariant.Success" Dismissible="true" OnDismiss="() => _jsonSubmitMessage = null">
                <AlertTitle>@L.T("表单已提交", "Form Submitted")</AlertTitle>
                <AlertDescription>@_jsonSubmitMessage</AlertDescription>
            </Alert>
        }
        <div class="rounded-lg border p-4 bg-muted/50">
            <p class="text-sm font-medium mb-1">@L.T("当前值：", "Current values:")</p>
            <pre class="text-sm font-mono whitespace-pre-wrap">@FormatValues(_jsonValues, L)</pre>
        </div>
        <CodeBlock Source="Components/DynamicForm/json-schema.txt" />
    </div>

    <!-- Read-Only / Disabled -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("只读 / 禁用", "Read-Only / Disabled")</h2>
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    使用 <code class="text-xs bg-muted px-1 py-0.5 rounded">Disabled</code> 可阻止所有交互。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    Use <code class="text-xs bg-muted px-1 py-0.5 rounded">Disabled</code> to prevent all interaction.
                </p>
                        </text>
}
        </div>
        <div class="max-w-lg">
            <DynamicForm Schema="@_basicSchema"
                           @bind-Values="_disabledValues"
                           Disabled="true"
                           ShowSubmitButton="false" />
        </div>
        <CodeBlock Source="Components/DynamicForm/read-only-disabled.txt" />
    </div>

    <!-- Validation -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("校验", "Validation")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("在字段定义上声明校验规则。必填字段、正则模式、最小/最大长度与数值范围校验全部支持。不妨试试提交空表单。", "Define validation rules on field definitions. Required fields, patterns, min/max length, and numeric range validations are all supported. Try submitting the empty form.")
            </p>
        </div>
        <div class="max-w-lg">
            <DynamicForm Schema="@_validationSchema"
                           @bind-Values="_validationValues"
                           OnValidSubmit="HandleValidationSubmit" />
        </div>
        @if (_validationSubmitMessage is not null)
        {
            <Alert Variant="AlertVariant.Success" Dismissible="true" OnDismiss="() => _validationSubmitMessage = null">
                <AlertTitle>@L.T("表单已提交", "Form Submitted")</AlertTitle>
                <AlertDescription>@_validationSubmitMessage</AlertDescription>
            </Alert>
        }
        <CodeBlock Source="Components/DynamicForm/validation.txt" />
    </div>

    <!-- Accessibility -->
    <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>
                @L.T("每个渲染出的输入项都继承其底层 AtomBlazor 组件的无障碍特性（标签、ARIA 属性、错误播报）", "Each rendered input inherits the accessibility features of its underlying AtomBlazor component (labels, ARIA attributes, error announcements)")
            </AccessibilityItem>
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    标签会通过 <code class="text-xs bg-muted px-1 py-0.5 rounded">FieldLabel</code> 自动关联到对应输入项
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    Labels are automatically associated with their inputs via <code class="text-xs bg-muted px-1 py-0.5 rounded">FieldLabel</code>
                </AccessibilityItem>
                        </text>
}
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    校验错误会通过 <code class="text-xs bg-muted px-1 py-0.5 rounded">FieldError</code> 以内联方式展示，便于读屏软件支持
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    Validation errors are displayed inline with <code class="text-xs bg-muted px-1 py-0.5 rounded">FieldError</code> for screen reader support
                </AccessibilityItem>
                        </text>
}
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    隐藏字段（经由 <code class="text-xs bg-muted px-1 py-0.5 rounded">VisibleWhen</code>）会被彻底移出 DOM，而不只是视觉隐藏
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    Hidden fields (via <code class="text-xs bg-muted px-1 py-0.5 rounded">VisibleWhen</code>) are fully removed from the DOM, not just visually hidden
                </AccessibilityItem>
                        </text>
}
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    可折叠分区使用 <code class="text-xs bg-muted px-1 py-0.5 rounded">Collapsible</code>，并带有正确的 <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-expanded</code> 状态
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    Collapsible sections use <code class="text-xs bg-muted px-1 py-0.5 rounded">Collapsible</code> with proper <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-expanded</code> state
                </AccessibilityItem>
                        </text>
}
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    表单使用原生 <code class="text-xs bg-muted px-1 py-0.5 rounded">&lt;form&gt;</code> 元素，保持标准提交行为
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    Form uses native <code class="text-xs bg-muted px-1 py-0.5 rounded">&lt;form&gt;</code> element for standard submit behavior
                </AccessibilityItem>
                        </text>
}
        </AriaAttributes>
        <KeyboardNavigation>
            <KeyboardShortcutItem Description="@(L.T("在表单字段之间移动", "Move between form fields"))">
                <Kbd>Tab</Kbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("提交表单", "Submit the form"))">
                <Kbd>Enter</Kbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("切换可折叠分区", "Toggle collapsible sections"))">
                <Kbd>Enter</Kbd> @L.T("或", "or") <Kbd>Space</Kbd>
            </KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>

    <!-- API Reference -->
    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件属性与参数。", "Component properties and parameters.")</p>
        </div>

        <div class="space-y-4">
            <ApiReference ComponentName="DynamicForm">
                <ApiParameter Name="Schema" Type="FormSchema?">
                    @L.T("表单的架构定义，包含字段与/或分区。", "The schema definition for the form, containing fields and/or sections.")
                </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="Values" Type="Dictionary&lt;string, object?&gt;">
                        当前表单值字典。使用 <code>@@bind-Values</code> 进行双向绑定。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="Values" Type="Dictionary&lt;string, object?&gt;">
                        The current form values dictionary. Use <code>@@bind-Values</code> for two-way binding.
                    </ApiParameter>
                                </text>
}
                <ApiParameter Name="OnSubmit" Type="EventCallback&lt;Dictionary&lt;string, object?&gt;&gt;">
                    @L.T("表单提交时调用的回调，不论校验是否通过。", "Callback invoked on form submission regardless of validation.")
                </ApiParameter>
                <ApiParameter Name="OnValidSubmit" Type="EventCallback&lt;Dictionary&lt;string, object?&gt;&gt;">
                    @L.T("仅在所有校验通过时于表单提交调用的回调。", "Callback invoked on form submission only when all validation passes.")
                </ApiParameter>
                <ApiParameter Name="OnFieldChanged" Type="EventCallback&lt;FormFieldChangedEventArgs&gt;">
                    @L.T("任一字段值变化时调用的回调。提供字段名、旧值与新值。", "Callback invoked when any field value changes. Provides field name, old value, and new value.")
                </ApiParameter>
                <ApiParameter Name="Layout" Type="FormLayout" Default="Vertical">
                    @L.T("表单布局模式。选项：Vertical、Horizontal、Inline。", "Form layout mode. Options: Vertical, Horizontal, Inline.")
                </ApiParameter>
                <ApiParameter Name="LabelWidth" Type="string?" Default="null">
                    @L.T("Horizontal 布局下的固定标签宽度（如 “100px”、“8rem”）。让所有标签等宽，输入项从而整齐对齐。", "Fixed label width for Horizontal layout (e.g., \"100px\", \"8rem\"). Ensures all labels have the same width so inputs align consistently.")
                </ApiParameter>
                <ApiParameter Name="Columns" Type="int" Default="1">
                    @L.T("响应式网格布局的列数。可在分区级别覆盖。", "Number of columns for the responsive grid layout. Can be overridden per section.")
                </ApiParameter>
                <ApiParameter Name="ReadOnly" Type="bool" Default="false">
                    @L.T("是否将所有字段渲染为只读。", "Whether all fields are rendered as read-only.")
                </ApiParameter>
                <ApiParameter Name="Disabled" Type="bool" Default="false">
                    @L.T("是否禁用所有字段。", "Whether all fields are disabled.")
                </ApiParameter>
                <ApiParameter Name="SubmitText" Type="string" Default="Submit">
                    @L.T("内置提交按钮的文案。", "Text for the built-in submit button.")
                </ApiParameter>
                <ApiParameter Name="ShowSubmitButton" Type="bool" Default="true">
                    @L.T("是否显示内置提交按钮。", "Whether to show the built-in submit button.")
                </ApiParameter>
                <ApiParameter Name="ShowValidationSummary" Type="bool" Default="false">
                    @L.T("是否在表单顶部显示校验错误汇总。为 false 时，错误仅在各个字段旁内联显示。", "Whether to show a validation error summary at the top of the form. When false, errors are only shown inline next to each field.")
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?" Default="null">
                    @L.T("应用到表单元素上的额外 CSS 类。", "Additional CSS classes applied to the form element.")
                </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="FieldRenderers" Type="Dictionary&lt;string, RenderFragment&lt;DynamicFieldRenderContext&gt;&gt;?">
                        按字段名索引的自定义字段渲染器。用于 <code>FieldType.Custom</code> 字段。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="FieldRenderers" Type="Dictionary&lt;string, RenderFragment&lt;DynamicFieldRenderContext&gt;&gt;?">
                        Custom field renderers keyed by field name. Used for <code>FieldType.Custom</code> fields.
                    </ApiParameter>
                                </text>
}
                <ApiParameter Name="ChildContent" Type="RenderFragment?">
                    @L.T("在表单内部渲染的额外内容（例如额外的按钮）。", "Additional content rendered inside the form (e.g., extra buttons).")
                </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        应用到根 <code>&lt;form&gt;</code> 元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        Additional HTML attributes applied to the root <code>&lt;form&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                    </ApiParameter>
                                </text>
}
            </ApiReference>

            <ApiReference ComponentName="FormSchema">
                <ApiParameter Name="Title" Type="string?">
                    @L.T("显示在表单上方的标题。", "Form title displayed above the form.")
                </ApiParameter>
                <ApiParameter Name="Description" Type="string?">
