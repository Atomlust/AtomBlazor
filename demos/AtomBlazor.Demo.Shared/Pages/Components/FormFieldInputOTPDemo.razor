@page "/components/form-field-input-otp"
@using System.ComponentModel.DataAnnotations

<PageTitle>@L.T("FormFieldInputOTP 验证码表单字段 - Atom BlazorUI", "FormFieldInputOTP Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">FormFieldInputOTP</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("InputOTP 的表单字段封装，内置标签、辅助文本与错误提示。",
                     "A form field wrapper for InputOTP with built-in label, helper text, and error messages.")
            </p>
        </div>
    </div>

    <!-- Basic Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("基本用法", "Basic Usage")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("一个 6 位验证码输入框，带标签与辅助文本。",
                     "A 6-digit OTP input with label and helper text.")
            </p>
        </div>
        <div class="max-w-md">
            <FormFieldInputOTP AriaLabel="@(L.T("验证码", "Verification code"))" @bind-Value="_otpCode"
                                Label="@(L.T("验证码", "Verification code"))"
                                HelperText="@(L.T("请输入发送到手机的 6 位验证码。", "Enter the 6-digit code sent to your phone."))" />
        </div>
        <div class="rounded-lg border p-4 bg-muted/50">
            <p class="text-sm font-medium mb-1">@L.T("当前值：", "Value:")</p>
            <p class="text-sm font-mono">@(string.IsNullOrEmpty(_otpCode) ? L.T("（空）", "(empty)") : _otpCode)</p>
        </div>
        <CodeBlock Source="Components/FormFieldInputOTP/basic.txt" />
    </div>

    <!-- 4-Digit with Mask -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("4 位 PIN（掩码）", "4-Digit PIN (Masked)")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("更短的验证码，并用掩码输入保护敏感值。",
                     "A shorter code with masked input for sensitive values.")
            </p>
        </div>
        <div class="max-w-md">
            <FormFieldInputOTP @bind-Value="_pin"
                                Label="@(L.T("PIN 码", "PIN"))"
                                HelperText="@(L.T("请输入 4 位 PIN 码。", "Enter your 4-digit PIN."))"
                                Length="4"
                                GroupSize="4"
                                ShowSeparator="false"
                                MaskInput="true" />
        </div>
        <CodeBlock Source="Components/FormFieldInputOTP/pin.txt" />
    </div>

    <!-- Disabled -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("禁用", "Disabled")</h2>
            <p class="text-sm text-muted-foreground">@L.T("一个处于禁用状态的 OTP 输入表单字段。", "A disabled OTP input form field.")</p>
        </div>
        <div class="max-w-md">
            <FormFieldInputOTP Value="123456"
                                Label="@(L.T("验证码（已锁定）", "Code (locked)"))"
                                HelperText="@(L.T("已经完成验证。", "Already verified."))"
                                Disabled="true" />
        </div>
        <CodeBlock Source="Components/FormFieldInputOTP/disabled.txt" />
    </div>

    <!-- EditForm Integration -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("EditForm 集成", "EditForm Integration")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("在 EditForm 中，校验错误会自动显示。", "Validation errors display automatically inside an EditForm.")
            </p>
        </div>
        <div class="max-w-md">
            <EditForm Model="_formModel" OnValidSubmit="HandleFormSubmit">
                <DataAnnotationsValidator />
                <div class="space-y-4">
                    <FormFieldInputOTP @bind-Value="_formModel.Code"
                                        Label="@(L.T("验证码", "Verification code"))"
                                        HelperText="@(L.T("继续操作前必填。", "Required to proceed."))" />
                    <Button Type="ButtonType.Submit">@L.T("验证", "Verify")</Button>
                </div>
            </EditForm>
            @if (_formSubmitted)
            {
                <div class="mt-4 rounded-lg border border-green-200 bg-green-50 dark:bg-green-950 dark:border-green-800 p-4">
                    <p class="text-sm font-medium text-green-800 dark:text-green-200">@L.T("验证通过！", "Verified!")</p>
                </div>
            }
        </div>
        <CodeBlock Source="Components/FormFieldInputOTP/editform.txt" />
    </div>

    <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>@L.T("标签与 OTP 输入组在视觉上关联", "Label visually associated with the OTP input group")</AccessibilityItem>
            <AccessibilityItem>@L.T("描述文本通过 aria-describedby 关联", "Description linked via aria-describedby")</AccessibilityItem>
            <AccessibilityItem>@L.T("校验错误通过 aria-invalid 展示", "Validation errors displayed with aria-invalid")</AccessibilityItem>
        </AriaAttributes>
            <KeyboardNavigation>
            <KeyboardShortcutItem Description="@(L.T("在可用的表单控件之间移动", "Move between enabled form controls"))"><Kbd>Tab</Kbd> / <Kbd>Shift + Tab</Kbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("移动文本光标", "Move the text cursor"))"><Kbd>ArrowLeft</Kbd> / <Kbd>ArrowRight</Kbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("删除文本", "Delete text"))"><Kbd>Backspace</Kbd> / <Kbd>Delete</Kbd></KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>

    <!-- API Reference -->
    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件属性与参数。", "Component properties and parameters.")</p>
        </div>
        <div class="space-y-4">
            <ApiReference ComponentName="FormFieldInputOTP">
                <ApiParameter Name="AriaLabel" Type="string?" Default="null">@L.T("转发给交互控件或分组的可访问名称。", "Accessible name forwarded to the interactive control or group.")</ApiParameter>
                <ApiParameter Name="Label" Type="string?" Default="null">@L.T("标签文本。", "The label text.")</ApiParameter>
                <ApiParameter Name="HelperText" Type="string?" Default="null">@L.T("输入框下方的辅助文本。", "Helper text below the input.")</ApiParameter>
                <ApiParameter Name="ErrorText" Type="string?" Default="null">@L.T("手动指定的错误文本。", "Manual error text override.")</ApiParameter>
                <ApiParameter Name="Value" Type="string?" Default="null">@L.T("当前的 OTP 值。使用 @bind-Value。", "The current OTP value. Use @bind-Value.")</ApiParameter>
                <ApiParameter Name="ValueChanged" Type="EventCallback&lt;string&gt;">@L.T("值发生变化时调用的回调。", "Callback when value changes.")</ApiParameter>
                <ApiParameter Name="Length" Type="int" Default="6">@L.T("OTP 位数。", "Number of OTP digits.")</ApiParameter>
                <ApiParameter Name="OnComplete" Type="EventCallback&lt;string&gt;">@L.T("所有位数都填写完成时调用的回调。", "Callback when all digits are filled.")</ApiParameter>
                <ApiParameter Name="ShowSeparator" Type="bool" Default="true">@L.T("是否显示分组之间的分隔符。", "Show separators between groups.")</ApiParameter>
                <ApiParameter Name="GroupSize" Type="int" Default="3">@L.T("每组的位数。", "Digits per group.")</ApiParameter>
                <ApiParameter Name="Size" Type="InputOTPSize" Default="Default">@L.T("尺寸变体（Small、Default、Large）。", "Size variant (Small, Default, Large).")</ApiParameter>
                <ApiParameter Name="MaskInput" Type="bool" Default="false">@L.T("用星号遮蔽输入值。", "Mask values with asterisks.")</ApiParameter>
                <ApiParameter Name="InputMode" Type="InputOTPInputMode" Default="Numbers">@L.T("允许的字符类型。", "Accepted character types.")</ApiParameter>
                <ApiParameter Name="Disabled" Type="bool" Default="false">@L.T("输入框是否被禁用。", "Whether the input is disabled.")</ApiParameter>
                <ApiParameter Name="Required" Type="bool" Default="false">@L.T("输入框是否为必填。", "Whether the input is required.")</ApiParameter>
                <ApiParameter Name="InputClass" Type="string?" Default="null">@L.T("应用到每个 OTP 输入框上的 CSS 类。", "CSS classes for each OTP input box.")</ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        应用到组件根元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        Additional HTML attributes applied to the component's root element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                    </ApiParameter>
                                </text>
}
            </ApiReference>
        </div>
    </section>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    private string? _otpCode;
    private string? _pin;
    private bool _formSubmitted;
    private OTPFormModel _formModel = new();

    private void HandleFormSubmit()
    {
        _formSubmitted = true;
    }

    private class OTPFormModel
    {
        [Required(ErrorMessage = "Verification code is required.")]
        [StringLength(6, MinimumLength = 6, ErrorMessage = "Please enter all 6 digits.")]
        public string? Code { get; set; }
    }
}
