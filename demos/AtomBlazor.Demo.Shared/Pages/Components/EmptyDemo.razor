@page "/components/empty"
@using AtomBlazor.Icons.Lucide

<PageTitle>@L.T("Empty 空状态组件 - Atom BlazorUI", "Empty Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("Empty 空状态组件", "Empty Component")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("当没有内容可展示时显示占位视图。", "Displays a placeholder when there is no content to show.")
            </p>
        </div>
    </div>

    <!-- Basic Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("基础示例", "Basic Example")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("带标题与说明的简单空状态。", "A simple empty state with title and description.")
            </p>
        </div>
        <div class="border rounded-lg">
            <Empty Title="@(L.T("未找到结果", "No results found"))"
                   Description="@(L.T("请尝试调整搜索或筛选条件，找到您想要的内容。", "Try adjusting your search or filter to find what you're looking for."))" />
        </div>
        <CodeBlock Source="Components/Empty/basic.txt" />
    </div>

    <!-- With Icon -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("带图标", "With Icon")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("带图标的空状态，视觉上更醒目。", "Empty state with an icon for visual emphasis.")
            </p>
        </div>
        <div class="border rounded-lg">
            <Empty Title="@(L.T("暂无消息", "No messages"))"
                   Description="@(L.T("你还没有任何消息。开始一段对话吧！", "You don't have any messages yet. Start a conversation!"))">
                <Icon>
                    <LucideIcon Name="inbox" />
                </Icon>
            </Empty>
        </div>
        <CodeBlock Source="Components/Empty/with-icon.txt" />
    </div>

    <!-- With Action -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("带操作", "With Action")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("带行动号召按钮的空状态。", "Empty state with a call-to-action button.")
            </p>
        </div>
        <div class="border rounded-lg">
            <Empty Title="@(L.T("暂无项目", "No projects"))"
                   Description="@(L.T("从创建你的第一个项目开始。", "Get started by creating your first project."))">
                <Icon>
                    <LucideIcon Name="folder-open" />
                </Icon>
                <ChildContent>
                    <Button>
                        <LucideIcon Name="plus" Class="h-4 w-4 mr-2" />
                        @L.T("创建项目", "Create Project")
                    </Button>
                </ChildContent>
            </Empty>
        </div>
        <CodeBlock Source="Components/Empty/with-action.txt" />
    </div>

    <!-- Sizes -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("尺寸", "Sizes")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("空状态提供多种尺寸，适配不同场景。", "Empty states come in different sizes for various contexts.")
            </p>
        </div>
        <div class="grid gap-4">
            <div class="border rounded-lg">
                <Empty Size="EmptySize.Small"
                       Title="@(L.T("小", "Small"))"
                       Description="@(L.T("适合紧凑空间的精简空状态。", "Compact empty state for tight spaces."))">
                    <Icon>
                        <LucideIcon Name="file-x" />
                    </Icon>
                </Empty>
            </div>
            <div class="border rounded-lg">
                <Empty Size="EmptySize.Default"
                       Title="@(L.T("默认", "Default"))"
                       Description="@(L.T("适用于大多数场景的标准空状态。", "Standard empty state for most use cases."))">
                    <Icon>
                        <LucideIcon Name="file-x" />
                    </Icon>
                </Empty>
            </div>
            <div class="border rounded-lg">
                <Empty Size="EmptySize.Large"
                       Title="@(L.T("大", "Large"))"
                       Description="@(L.T("用于主要内容区域的醒目空状态。", "Prominent empty state for primary content areas."))">
                    <Icon>
                        <LucideIcon Name="file-x" />
                    </Icon>
                </Empty>
            </div>
        </div>
        <CodeBlock Source="Components/Empty/sizes.txt" />
    </div>

    <!-- Search Results -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("搜索结果", "Search Results")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("用于搜索结果的空状态。", "Empty state for search results.")
            </p>
        </div>
        <div class="border rounded-lg">
            <Empty Title="@(L.T("没有与 “atom components” 匹配的结果", "No results for 'atom components'"))"
                   Description="@(L.T("没有找到与你的搜索匹配的内容。换几个关键词试试。", "We couldn't find anything matching your search. Try different keywords."))">
                <Icon>
                    <LucideIcon Name="search-x" />
                </Icon>
                <ChildContent>
                    <Button Variant="ButtonVariant.Outline">@L.T("清除搜索", "Clear Search")</Button>
                </ChildContent>
            </Empty>
        </div>
        <CodeBlock Source="Components/Empty/search-results.txt" />
    </div>

    <!-- Error State -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("错误状态", "Error State")</h2>
            <p class="text-sm text-muted-foreground">
                @L.T("用于错误场景的空状态。", "Empty state for error scenarios.")
            </p>
        </div>
        <div class="border rounded-lg">
            <Empty Title="@(L.T("出错了", "Something went wrong"))"
                   Description="@(L.T("加载你的数据时遇到错误。请重试。", "We encountered an error while loading your data. Please try again."))">
                <Icon>
                    <LucideIcon Name="circle-alert" />
                </Icon>
                <ChildContent>
                    <Button Variant="ButtonVariant.Destructive">
                        <LucideIcon Name="refresh-cw" Class="h-4 w-4 mr-2" />
                        @L.T("重试", "Retry")
                    </Button>
                </ChildContent>
            </Empty>
        </div>
        <CodeBlock Source="Components/Empty/error.txt" />
    </div>

    <!-- Accessibility Notes -->
    <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>
                @L.T("纯展示组件，本身不带固有风险 ARIA 角色或属性", "Presentational component with no inherent ARIA roles or attributes")
            </AccessibilityItem>
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    标题使用语义化标题（<code class="text-xs bg-muted px-1 py-0.5 rounded">h3</code>），描述使用段落
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    Uses semantic heading (<code class="text-xs bg-muted px-1 py-0.5 rounded">h3</code>) for the title and paragraph for description
                </AccessibilityItem>
                        </text>
}
            @if (L.IsChinese)
            {
                        <text>
                            <AccessibilityItem>
                    当用它传达状态变化时，考虑包一层带 <code class="text-xs bg-muted px-1 py-0.5 rounded">role="status"</code> 或 <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-live="polite"</code> 的容器
                </AccessibilityItem>
                        </text>
}
            else
            {
                        <text>
                            <AccessibilityItem>
                    When used to convey state changes, consider wrapping in a container with <code class="text-xs bg-muted px-1 py-0.5 rounded">role="status"</code> or <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-live="polite"</code>
                </AccessibilityItem>
                        </text>
}
        </AriaAttributes>
    </AccessibilityList>

    <!-- API Reference -->
    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件属性与参数。", "Component properties and parameters.")</p>
        </div>
        <div class="space-y-4">
            <ApiReference ComponentName="Empty">
                <ApiParameter Name="Title" Type="string?" Default="null">
                    @L.T("空状态中显示的标题文本。", "The title text to display in the empty state.")
                </ApiParameter>
                <ApiParameter Name="Description" Type="string?" Default="null">
                    @L.T("显示在标题下方的描述文本。", "Description text displayed below the title.")
                </ApiParameter>
                <ApiParameter Name="Icon" Type="RenderFragment?" Default="null">
                    @L.T("可选图标，显示在标题上方。", "Optional icon to display above the title.")
                </ApiParameter>
                <ApiParameter Name="Size" Type="EmptySize" Default="EmptySize.Default">
                    @L.T("尺寸变体。选项：Small、Default、Large。", "Size variant. Options: Small, Default, Large.")
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?" Default="null">
                    @L.T("应用到容器上的额外 CSS 类。", "Additional CSS classes to apply to the container.")
                </ApiParameter>
                @if (L.IsChinese)
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        应用到根 <code>&lt;div&gt;</code> 元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                    </ApiParameter>
                                </text>
}
                else
                {
                                <text>
                                    <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                        Additional HTML attributes applied to the root <code>&lt;div&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                    </ApiParameter>
                                </text>
}
            </ApiReference>
        </div>
    </section>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;
}
