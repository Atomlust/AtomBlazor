@page "/components/height-animation"
@using AtomBlazor.Icons.Lucide

<PageTitle>@L.T("Height Animation 高度动画 - Atom BlazorUI", "Height Animation - Atom BlazorUI")</PageTitle>
<div class="max-w-4xl space-y-8">
    <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">@L.T("Height Animation 高度动画", "Height Animation")</h1>
        <p class="text-xl text-muted-foreground">@L.T("为展开、折叠与内容尺寸变化播放动画，同时保留子内容状态。", "Animate expansion, collapse and content resizing while retaining child state.")</p>
    </div>
<section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("高度与可见性", "Height and visibility")</h2>
        <div class="flex gap-2">
            <Button OnClick="@(() => expanded = !expanded)" aria-expanded="@expanded.ToString().ToLowerInvariant()">@L.T("切换详情", "Toggle details")</Button>
            <Button Variant="ButtonVariant.Outline" OnClick="@(() => lines = lines == 3 ? 1 : 3)">@L.T("改变内容尺寸", "Change content size")</Button>
        </div>
        <HeightAnimation Expanded="expanded">
            <div class="space-y-3 rounded-lg border p-4">
                @for (var i = 0; i < lines; i++) { <p>@L.T("内容高度由浏览器实测，包括图片或文本加载完成之后的变化。", "Content height is measured in the browser, including changes after images or text load.")</p> }
                <Input Placeholder="@(L.T("这份草稿在折叠后依然存在", "This draft survives collapse"))" />
            </div>
        </HeightAnimation>
        <CodeBlock Source="Components/Motion/height.txt" />
    </section>
    <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>@L.T("折叠中的内容是惰性的，对辅助技术不可见；其子内容状态仍然保持挂载。", "Collapsed content is inert and hidden from assistive technology; its child state remains mounted.")</AccessibilityItem>
            <AccessibilityItem>@L.T("示例触发器会暴露 aria-expanded。动画遵循 prefers-reduced-motion。", "The example trigger exposes aria-expanded. Animation honors prefers-reduced-motion.")</AccessibilityItem>
        </AriaAttributes>
        <KeyboardNavigation>
            <KeyboardShortcutItem Description="@(L.T("在可交互控件之间移动", "Move between interactive controls"))"><Kbd>Tab / Shift + Tab</Kbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("激活获得焦点的按钮", "Activate a focused button"))"><Kbd>Enter / Space</Kbd></KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>
    <section class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
<ApiReference Since="v4" ComponentName="HeightAnimation">
        <ApiParameter Name="Expanded / Enabled / Duration / Easing" Type="bool / bool / int / string" Default="true / true / 250 / ease-out">@L.T("对展开/折叠与实测的内容尺寸变化播放动画。子内容保持挂载。展开完成后高度回到 auto。", "Animate expansion/collapse and measured content resizing. Child content remains mounted. Height returns to auto after expansion.")</ApiParameter>
        <ApiParameter Name="ChildContent / Class / AdditionalAttributes" Type="RenderFragment / string? / Dictionary">@L.T("内容与包裹元素的定制项。", "Content and wrapper customization.")</ApiParameter>
    </ApiReference>
    </section>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    private int lines = 1;
    private bool expanded = true;
}
