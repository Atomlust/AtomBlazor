    private async Task HandleConfirmDelete()
    {
        var result = await DialogService.ConfirmAsync(
            L.IsChinese ? "删除该条目？" : "Delete item?",
            L.IsChinese ? "此操作无法撤销。该条目将被永久移除。" : "This action cannot be undone. The item will be permanently removed.");

        confirmResult = result.Confirmed
            ? (L.IsChinese ? "已确认" : "Confirmed")
            : (L.IsChinese ? "已取消" : "Cancelled");
    }

    private async Task HandleDestructiveDelete()
    {
        var data = await DialogService.ConfirmAsync(
            L.IsChinese ? "删除该条目？" : "Delete item?",
            L.IsChinese ? "此操作无法撤销。" : "This action cannot be undone.",
            new ConfirmDialogOptions
            {
                ConfirmText = L.IsChinese ? "是的，删除" : "Yes, delete",
                CancelText = L.IsChinese ? "保留" : "Keep it",
                Destructive = true
            });

        confirmResult = data.Confirmed
            ? (L.IsChinese ? "已删除！" : "Deleted!")
            : (L.IsChinese ? "已保留" : "Kept");
    }

