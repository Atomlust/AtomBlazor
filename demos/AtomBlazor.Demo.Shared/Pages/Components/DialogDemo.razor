                        <AtomBlazor.DialogTitle>@L.T("容器", "Container")</AtomBlazor.DialogTitle>
                        <AtomBlazor.DialogDescription>@L.T("对话框内没有任何元素获得焦点。按 Tab 可移到输入框。", "Nothing inside has focus. Tab moves to the field.")</AtomBlazor.DialogDescription>
                    </DialogHeader>
                    <Input @bind-Value="initialFocusQuery" Placeholder="@(L.T("输入以搜索...", "Type to search..."))" />
                </AtomBlazor.DialogContent>
            </Dialog>

            <Dialog>
                <AtomBlazor.DialogTrigger>
                    <Button Variant="ButtonVariant.Outline">data-autofocus</Button>
                </AtomBlazor.DialogTrigger>
                <AtomBlazor.DialogContent>
