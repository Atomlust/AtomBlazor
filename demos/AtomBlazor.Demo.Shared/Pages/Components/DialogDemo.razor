    private async Task HandleOpenNativeService()
    {
        var result = await DialogService.OpenAsync<NativeDialogBodyComponent>(
            new Dictionary<string, object?>
            {
                ["Message"] = L.IsChinese
                    ? "这个对话框由 DialogService.OpenAsync<T>() 打开。它的关闭按钮会调用 IDialogReference.CloseAsync()——编程式路径里用不了 DialogClose。"
                    : "This dialog was opened with DialogService.OpenAsync<T>(). Its Close button calls IDialogReference.CloseAsync() — DialogClose is not usable in the programmatic path."
            },
            new DialogOpenOptions
            {
                Title = L.IsChinese ? "原生风格对话框" : "Native-Style Dialog",
                Size = DialogSize.Default
            });

        nativeServiceResult = result.Cancelled
            ? (L.IsChinese ? "已取消" : "Cancelled")
            : (L.IsChinese ? "已关闭" : "Closed");
    }

    public sealed class NativeDialogBodyComponent : ComponentBase
    {
        /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
        [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

        [Parameter] public string Message { get; set; } = "";

        [CascadingParameter]
        public IDialogReference DialogRef { get; set; } = default!;

        protected override void BuildRenderTree(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder __builder)
        {
            <div class="space-y-4">
                <p class="text-sm text-muted-foreground">@Message</p>
                <div class="flex justify-end gap-2">
                    <Button Variant="ButtonVariant.Outline" OnClick="Close">@L.T("关闭", "Close")</Button>
                </div>
            </div>
        }

        private Task Close() => DialogRef.CloseAsync(DialogResult.Ok());
    }

    public sealed class EditUserDemoComponent : ComponentBase
    {
        /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
        [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

        [Parameter] public int UserId { get; set; }

        [CascadingParameter]
        public IDialogReference DialogRef { get; set; } = default!;

        private string? userName;
        private string? userEmail;

        protected override void OnInitialized()
        {
            // 模拟加载用户数据
            userName = $"User {UserId}";
            userEmail = "example@company.com";
        }

        private Task Save()
        {
            var dto = new UserDto(
                UserId,
                userName ?? string.Empty,
                userEmail ?? string.Empty);

            return DialogRef.CloseAsync(DialogResult.Ok(dto));
        }

        private Task Cancel()
            => DialogRef.CancelAsync();

        protected override void BuildRenderTree(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder __builder)
        {
            <div class="space-y-4">
                <div>@L.T("正在编辑用户", "Editing User") @UserId</div>
                <Input @bind-Value="userName" Placeholder="@(L.T("姓名", "Name"))" />
                <Input @bind-Value="userEmail" Placeholder="@(L.T("电子邮箱", "Email"))" Type="InputType.Email" />
                <div class="flex justify-end gap-2">
                    <Button Variant="ButtonVariant.Outline" OnClick="Cancel">@L.T("取消", "Cancel")</Button>
                    <Button OnClick="Save">@L.T("保存", "Save")</Button>
                </div>
            </div>
        }
    }

    public sealed record UserDto(int Id, string Name, string Email);
}
