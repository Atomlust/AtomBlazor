@page "/components/dialog"
@using AtomBlazor.Primitives.Services
@inject DialogService DialogService

<PageTitle>@L.T("Dialog 对话框 - Atom BlazorUI", "Dialog Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">Dialog</h1>
        <p class="text-xl text-muted-foreground">
            @L.T("覆盖在页面之上的模态窗口，自带遮罩与焦点管理。", "Modal windows overlaid on the page, with backdrop and focus management.")
        </p>
    </div>

    <div class="space-y-6">
        <!-- Basic Usage -->
        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("基本用法", "Basic Usage")</h2>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-muted-foreground">
                        <code>Dialog</code> 由 <code>DialogTrigger</code>、<code>DialogContent</code>、
                        <code>DialogHeader</code>（含 <code>DialogTitle</code> 与 <code>DialogDescription</code>）以及
                        <code>DialogFooter</code> 组合而成。
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-muted-foreground">
                        Compose a <code>Dialog</code> from <code>DialogTrigger</code>, <code>DialogContent</code>,
                        <code>DialogHeader</code> (with <code>DialogTitle</code> and <code>DialogDescription</code>) and
                        <code>DialogFooter</code>.
                    </p>
                                </text>
}
            </div>

            <div class="rounded-lg border bg-card p-6">
                <Dialog>
                    <AtomBlazor.DialogTrigger>
                        <Button>@L.T("打开对话框", "Open Dialog")</Button>
                    </AtomBlazor.DialogTrigger>
                    <AtomBlazor.DialogContent>
                        <DialogHeader>
                            <AtomBlazor.DialogTitle>@L.T("你确定吗？", "Are you sure?")</AtomBlazor.DialogTitle>
                            <AtomBlazor.DialogDescription>@L.T("此操作无法撤销。", "This action cannot be undone.")</AtomBlazor.DialogDescription>
                        </DialogHeader>
                        <DialogFooter>
                            <AtomBlazor.DialogClose>
                                <Button Variant="ButtonVariant.Outline">@L.T("取消", "Cancel")</Button>
                            </AtomBlazor.DialogClose>
                            <Button>@L.T("继续", "Continue")</Button>
                        </DialogFooter>
                    </AtomBlazor.DialogContent>
                </Dialog>
            </div>

            <CodeBlock Source="Components/Dialog/basic.txt" />
        </section>

    <div class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("原生 Dialog", "Native Dialog")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                同一个对话框改用浏览器内置的 <code class="text-xs bg-muted px-1 py-0.5 rounded">&lt;dialog&gt;</code>
                元素渲染，方式是 <code class="text-xs bg-muted px-1 py-0.5 rounded">RenderingStrategy="Native"</code>。它位于顶层（top layer），
                复用浏览器原生的焦点捕获、Escape 处理与遮罩，因此不需要
                <code class="text-xs bg-muted px-1 py-0.5 rounded">PortalHost</code>，并且可以跨越 Blazor 渲染模式
                边界（例如 <code class="text-xs bg-muted px-1 py-0.5 rounded">InteractiveWebAssembly</code>）。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                The same dialog rendered through the browser's built-in <code class="text-xs bg-muted px-1 py-0.5 rounded">&lt;dialog&gt;</code>
                element via <code class="text-xs bg-muted px-1 py-0.5 rounded">RenderingStrategy="Native"</code>. It lives in the
                top layer and uses the browser's native focus trap, Escape handling and backdrop, so it needs no
                <code class="text-xs bg-muted px-1 py-0.5 rounded">PortalHost</code> and works across Blazor render-mode
                boundaries (e.g. <code class="text-xs bg-muted px-1 py-0.5 rounded">InteractiveWebAssembly</code>).
            </p>
                </text>
}

        <Dialog RenderingStrategy="OverlayRenderingStrategy.Native">
            <AtomBlazor.DialogTrigger AsChild="false" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2">
                @L.T("打开原生对话框", "Open Native Dialog")
            </AtomBlazor.DialogTrigger>

            <AtomBlazor.DialogContent>
                <DialogHeader>
                    <AtomBlazor.DialogTitle>@L.T("原生对话框", "Native dialog")</AtomBlazor.DialogTitle>
                    @if (L.IsChinese)
                    {
                                        <text>
                                            <AtomBlazor.DialogDescription>
                            这是一个原生 <code class="text-xs bg-muted px-1 py-0.5 rounded">&lt;dialog&gt;</code> 元素，
                            通过 <code class="text-xs bg-muted px-1 py-0.5 rounded">showModal()</code> 显示。按 Escape 或点击遮罩即可关闭。
                        </AtomBlazor.DialogDescription>
                                        </text>
}
                    else
                    {
                                        <text>
                                            <AtomBlazor.DialogDescription>
                            This dialog is a native <code class="text-xs bg-muted px-1 py-0.5 rounded">&lt;dialog&gt;</code> element
                            shown with <code class="text-xs bg-muted px-1 py-0.5 rounded">showModal()</code>. Press Escape or click the
                            backdrop to dismiss.
                        </AtomBlazor.DialogDescription>
                                        </text>
}
                </DialogHeader>
                <DialogFooter>
                    <AtomBlazor.DialogClose AsChild="false" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2">
                        @L.T("关闭", "Close")
                    </AtomBlazor.DialogClose>
                </DialogFooter>
            </AtomBlazor.DialogContent>
        </Dialog>

        <CodeBlock Source="Components/Dialog/native.txt" />
    </div>

    <div class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("通过 DialogService 打开原生对话框", "Native Dialog via DialogService")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                同一个对话框改用 <code class="text-xs bg-muted px-1 py-0.5 rounded">DialogService.OpenAsync&lt;T&gt;()</code>
                以编程方式打开。内容由对话框提供器渲染一个自包含组件。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                Open the same dialog programmatically with
                <code class="text-xs bg-muted px-1 py-0.5 rounded">DialogService.OpenAsync&lt;T&gt;()</code>. The content is a
                self-contained component rendered by the dialog provider.
            </p>
                </text>
}
        <div class="p-4 border-l-4 border-amber-500 bg-amber-500/5 rounded-r-lg">
            @if (L.IsChinese)
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    <strong>注意：</strong>编程式对话框不能用 <code class="text-xs bg-muted px-1 py-0.5 rounded">DialogClose</code> 关闭——
                    它驱动的是 <code class="text-xs bg-muted px-1 py-0.5 rounded">DialogContext</code>，而
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">OpenAsync</code> 这条路径并不提供它。要在内容里关闭编程式对话框，
                    得像下面这个自定义组件那样，调用级联下发的
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">IDialogReference.CloseAsync(...)</code>。
                </p>
                        </text>
}
            else
            {
                        <text>
                            <p class="text-sm text-muted-foreground">
                    <strong>Note:</strong> <code class="text-xs bg-muted px-1 py-0.5 rounded">DialogClose</code> does not close a
                    programmatic dialog — it drives a <code class="text-xs bg-muted px-1 py-0.5 rounded">DialogContext</code>, which the
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">OpenAsync</code> path does not provide. Close a programmatic dialog
                    from its content by calling the cascaded
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">IDialogReference.CloseAsync(...)</code> instead, exactly as the
                    custom component below does.
                </p>
                        </text>
}
        </div>

        <div class="flex items-center gap-4">
            <Button OnClick="HandleOpenNativeService">@L.T("通过 DialogService 打开", "Open via DialogService")</Button>
            <span class="text-sm text-muted-foreground">@nativeServiceResult</span>
        </div>

        <CodeBlock Source="Components/Dialog/native-service.txt" />
    </div>

    <!-- 受控对话框：按全式补齐（原生按钮 Cancel/Save 页脚） -->
    <div class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("受控对话框", "Controlled Dialog")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                改用 @@bind-Open 以编程方式控制对话框状态。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                Control the dialog state programmatically using @@bind-Open.
            </p>
                </text>
}

        <div class="flex gap-2">
            <button @onclick="() => isDialogOpen = true"
                    class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2">
                @L.T("打开对话框", "Open Dialog")
            </button>
        </div>

        <Dialog @bind-Open="isDialogOpen">
            <AtomBlazor.DialogContent>
                <DialogHeader>
                    <AtomBlazor.DialogTitle>@L.T("受控对话框", "Controlled Dialog")</AtomBlazor.DialogTitle>
                    <AtomBlazor.DialogDescription>
                        @L.T("该对话框的打开状态由父组件控制，可以编程式地打开与关闭它。", "This dialog's open state is controlled from the parent component. You can programmatically open and close it.")
                    </AtomBlazor.DialogDescription>
                </DialogHeader>

                <div class="py-4">
                    <p class="text-sm">
                        @L.T("对话框打开状态：", "Dialog is open:") <strong>@isDialogOpen</strong>
                    </p>
                </div>

                <DialogFooter>
                    <button @onclick="() => isDialogOpen = false"
                            class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2">
                        @L.T("取消", "Cancel")
                    </button>
                    <button @onclick="HandleSave"
                            class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2">
                        @L.T("保存", "Save")
                    </button>
                </DialogFooter>
            </AtomBlazor.DialogContent>
        </Dialog>

        <CodeBlock Source="Components/Dialog/controlled.txt" />
    </div>

        <!-- Header + Footer + Form -->
        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">@L.T("页眉、页脚与表单", "Header, Footer and Form")</h2>
                @if (L.IsChinese)
                {
                                <text>
                                    <p class="text-muted-foreground">
                        把表单放进对话框正文；<code>DialogClose</code> 会渲染一个用于关闭它的按钮。
                    </p>
                                </text>
}
                else
                {
                                <text>
                                    <p class="text-muted-foreground">
                        Slot a form into the dialog body; <code>DialogClose</code> renders a button that dismisses it.
                    </p>
                                </text>
}
            </div>

            <div class="rounded-lg border bg-card p-6">
                <Dialog>
                    <AtomBlazor.DialogTrigger>
                        <Button>@L.T("编辑资料", "Edit profile")</Button>
                    </AtomBlazor.DialogTrigger>
                    <AtomBlazor.DialogContent>
                        <DialogHeader>
                            <AtomBlazor.DialogTitle>@L.T("编辑资料", "Edit profile")</AtomBlazor.DialogTitle>
                            <AtomBlazor.DialogDescription>@L.T("在这里修改你的资料。", "Make changes to your profile here.")</AtomBlazor.DialogDescription>
                        </DialogHeader>
                        <div class="space-y-4 py-4">
                            <div class="space-y-2">
                                <label class="text-sm font-medium">@L.T("姓名", "Name")</label>
                                <Input @bind-Value="name" Placeholder="@(L.T("你的名字", "Your name"))" />
                            </div>
                        </div>
                        <DialogFooter>
                            <AtomBlazor.DialogClose>
                                <Button Variant="ButtonVariant.Outline">@L.T("取消", "Cancel")</Button>
                            </AtomBlazor.DialogClose>
                            <Button>@L.T("保存更改", "Save changes")</Button>
                        </DialogFooter>
                    </AtomBlazor.DialogContent>
                </Dialog>
            </div>

            <CodeBlock Source="Components/Dialog/with-header-footer.txt" />
        </section>

    <div class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("自定义宽度", "Custom Width")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("通过 Class 参数自定义对话框宽度。", "Customize the dialog width using the Class parameter.")
        </p>

        <Dialog>
            <AtomBlazor.DialogTrigger AsChild="false" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2">
                @L.T("打开宽对话框", "Open Wide Dialog")
            </AtomBlazor.DialogTrigger>

            <AtomBlazor.DialogContent Class="max-w-3xl">
                <DialogHeader>
                    <AtomBlazor.DialogTitle>@L.T("宽对话框", "Wide Dialog")</AtomBlazor.DialogTitle>
                    <AtomBlazor.DialogDescription>
                        @L.T("该对话框使用自定义的 max-width 类，比默认宽度更宽。", "This dialog uses a custom max-width class to be wider than the default.")
                    </AtomBlazor.DialogDescription>
                </DialogHeader>

                <div class="py-4">
                    @if (L.IsChinese)
                    {
                                        <text>
                                            <p class="text-sm">
                            你可以向 DialogContent 组件传入额外的类来自定义对话框宽度。
                            这个例子用的是 <code class="bg-muted px-1 py-0.5 rounded">max-w-3xl</code>，而不是默认的 <code class="bg-muted px-1 py-0.5 rounded">max-w-lg</code>。
                        </p>
                                        </text>
}
                    else
                    {
                                        <text>
                                            <p class="text-sm">
                            You can customize the dialog width by passing additional classes to the DialogContent component.
                            This example uses <code class="bg-muted px-1 py-0.5 rounded">max-w-3xl</code> instead of the default <code class="bg-muted px-1 py-0.5 rounded">max-w-lg</code>.
                        </p>
                                        </text>
}
                </div>
            </AtomBlazor.DialogContent>
        </Dialog>

        <CodeBlock Source="Components/Dialog/custom-width.txt" />
    </div>

    <div class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("不带关闭按钮", "Without Close Button")</h2>
        @if (L.IsChinese)
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                用 ShowClose="false" 隐藏默认的关闭按钮。
            </p>
                </text>
}
        else
        {
                <text>
                    <p class="text-sm text-muted-foreground">
                Hide the default close button using ShowClose="false".
            </p>
                </text>
}

        <Dialog>
            <AtomBlazor.DialogTrigger AsChild="false" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2">
                @L.T("打开对话框", "Open Dialog")
            </AtomBlazor.DialogTrigger>

            <AtomBlazor.DialogContent ShowClose="false">
                <DialogHeader>
                    <AtomBlazor.DialogTitle>@L.T("确认操作", "Confirm Action")</AtomBlazor.DialogTitle>
                    <AtomBlazor.DialogDescription>
                        @L.T("这个对话框右上角没有关闭按钮。你必须使用操作按钮之一或按 Escape 键关闭。", "This dialog doesn't have a close button in the top-right corner. You must use one of the action buttons or press Escape to close.")
                    </AtomBlazor.DialogDescription>
                </DialogHeader>

                <DialogFooter Class="mt-4">
                    <AtomBlazor.Primitives.DialogClose class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2">
                        @L.T("取消", "Cancel")
                    </AtomBlazor.Primitives.DialogClose>
                    <AtomBlazor.Primitives.DialogClose class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2">
                        @L.T("确认", "Confirm")
                    </AtomBlazor.Primitives.DialogClose>
                </DialogFooter>
            </AtomBlazor.DialogContent>
        </Dialog>

        <CodeBlock Source="Components/Dialog/without-close.txt" />
    </div>

    <div class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("AsChild 模式", "AsChild Pattern")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("用 AsChild 把触发器与你自己带样式的 Button 组件组合起来，而不必写内联样式。", "Use AsChild to compose triggers with your own styled Button components instead of inline styles.")
        </p>

        <div class="grid md:grid-cols-2 gap-6">
            <!-- Without AsChild -->
            <div class="space-y-3 p-4 border rounded-lg">
                <h3 class="text-lg font-medium">@L.T("不使用 AsChild", "Without AsChild")</h3>
                <p class="text-sm text-muted-foreground">
                    @L.T("DialogTrigger 会渲染自己的按钮元素并带上内联类。", "DialogTrigger renders its own button element with inline classes.")
                </p>
                <Dialog>
                    <AtomBlazor.DialogTrigger AsChild="false" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2">
                        @L.T("打开对话框", "Open Dialog")
                    </AtomBlazor.DialogTrigger>
                    <AtomBlazor.DialogContent>
                        <DialogHeader>
                            <AtomBlazor.DialogTitle>@L.T("不使用 AsChild", "Without AsChild")</AtomBlazor.DialogTitle>
                            <AtomBlazor.DialogDescription>
                                @L.T("该对话框在触发器上使用了内联 CSS 类。", "This dialog uses inline CSS classes on the trigger.")
                            </AtomBlazor.DialogDescription>
                        </DialogHeader>
                    </AtomBlazor.DialogContent>
                </Dialog>
            </div>

            <!-- With AsChild -->
            <div class="space-y-3 p-4 border rounded-lg">
                <h3 class="text-lg font-medium">@L.T("使用 AsChild", "With AsChild")</h3>
                <p class="text-sm text-muted-foreground">
                    @L.T("Button 组件通过 TriggerContext 获得触发器行为。", "Button component receives trigger behavior via TriggerContext.")
                </p>
                <Dialog>
                    <AtomBlazor.DialogTrigger>
                        <Button Variant="ButtonVariant.Destructive">
                            <LucideIcon Name="trash-2" Size="16" />
                            @L.T("删除账户", "Delete Account")
                        </Button>
                    </AtomBlazor.DialogTrigger>
                    <AtomBlazor.DialogContent>
                        <DialogHeader>
                            <AtomBlazor.DialogTitle>@L.T("删除账户", "Delete Account")</AtomBlazor.DialogTitle>
                            <AtomBlazor.DialogDescription>
                                @L.T("此操作无法撤销。这将永久删除你的账户。", "This action cannot be undone. This will permanently delete your account.")
                            </AtomBlazor.DialogDescription>
                        </DialogHeader>
                        <DialogFooter>
                            <AtomBlazor.DialogClose>
                                <Button Variant="ButtonVariant.Outline">@L.T("取消", "Cancel")</Button>
                            </AtomBlazor.DialogClose>
                            <Button Variant="ButtonVariant.Destructive">@L.T("删除", "Delete")</Button>
                        </DialogFooter>
                    </AtomBlazor.DialogContent>
                </Dialog>
            </div>
        </div>

        <CodeBlock Source="Components/Dialog/as-child.txt" />

    </div>

    <div class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("对话框中的下拉控件", "Dropdown Controls in Dialog")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("包含 Select、Combobox 与 MultiSelect 控件的对话框，用于测试嵌套 portal 行为：每个下拉控件都把浮动内容渲染在对话框覆盖层之上。", "Dialog containing Select, Combobox, and MultiSelect controls. Tests nested portal behavior where each dropdown renders its floating content above the dialog overlay.")
        </p>

        <Dialog>
            <AtomBlazor.DialogTrigger AsChild="false" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2">
                @L.T("打开带下拉控件的对话框", "Open Dialog with Dropdowns")
            </AtomBlazor.DialogTrigger>

            <AtomBlazor.DialogContent>
                <DialogHeader>
                    <AtomBlazor.DialogTitle>@L.T("嵌套下拉控件", "Nested Dropdown Controls")</AtomBlazor.DialogTitle>
                    <AtomBlazor.DialogDescription>
