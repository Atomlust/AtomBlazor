@page "/components/tabs"
<PageTitle>@L.T("Tabs 标签页 - Atom BlazorUI", "Tabs Component - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">@L.T("Tabs 标签页", "Tabs Component")</h1>
        <p class="text-xl text-muted-foreground">
            @L.T("一组分层的内容区块（即标签面板），每次只显示其中一个。", "A set of layered sections of content—known as tab panels—that are displayed one at a time.")
        </p>
        </div>
    </div>

    <div class="space-y-6">
    </div>

    <div class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("默认样式", "Default")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("带 shadcn 样式的基础标签页。", "Basic tabs with shadcn styling.")
        </p>

        <div class="w-[400px]">
            <Tabs DefaultValue="account">
                <AtomBlazor.TabsList Class="grid w-full grid-cols-2">
                    <AtomBlazor.TabsTrigger Value="account">@L.T("账户", "Account")</AtomBlazor.TabsTrigger>
                    <AtomBlazor.TabsTrigger Value="password">@L.T("密码", "Password")</AtomBlazor.TabsTrigger>
                </AtomBlazor.TabsList>

            <AtomBlazor.TabsContent Value="account">
                <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6">
                    <div class="space-y-2">
                        <h3 class="text-2xl font-semibold leading-none tracking-tight">@L.T("账户", "Account")</h3>
                        <p class="text-sm text-muted-foreground">
                            @L.T("在这里修改账户信息，改完后点击保存。", "Make changes to your account here. Click save when you're done.")
                        </p>
                    </div>
                    <div class="space-y-4 pt-4">
                        <div class="space-y-1">
                            <label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">
                                @L.T("姓名", "Name")
                            </label>
                            <input class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                   placeholder="Pedro Duarte" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">
                                @L.T("用户名", "Username")
                            </label>
                            <input class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                   placeholder="@@peduarte" />
                        </div>
                        <button class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2">
                            @L.T("保存更改", "Save changes")
                        </button>
                    </div>
                </div>
            </AtomBlazor.TabsContent>

            <AtomBlazor.TabsContent Value="password">
                <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6">
                    <div class="space-y-2">
                        <h3 class="text-2xl font-semibold leading-none tracking-tight">@L.T("密码", "Password")</h3>
                        <p class="text-sm text-muted-foreground">
                            @L.T("在这里修改密码；保存之后你会被退出登录。", "Change your password here. After saving, you'll be logged out.")
                        </p>
                    </div>
                    <div class="space-y-4 pt-4">
                        <div class="space-y-1">
                            <label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">
                                @L.T("当前密码", "Current password")
                            </label>
                            <input type="password"
                                   class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">
                                @L.T("新密码", "New password")
                            </label>
                            <input type="password"
                                   class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" />
                        </div>
                        <button class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2">
                            @L.T("保存密码", "Save password")
                        </button>
                    </div>
                </div>
            </AtomBlazor.TabsContent>
            </Tabs>
        </div>

        <CodeBlock Source="Components/Tabs/default.txt" />
    </div>

    <div class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("多个标签", "With Multiple Tabs")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("标签页可以有不止两个选项。", "Tabs can have more than two options.")
        </p>

        <Tabs DefaultValue="overview">
            <AtomBlazor.TabsList>
                <AtomBlazor.TabsTrigger Value="overview">@L.T("概览", "Overview")</AtomBlazor.TabsTrigger>
                <AtomBlazor.TabsTrigger Value="analytics">@L.T("分析", "Analytics")</AtomBlazor.TabsTrigger>
                <AtomBlazor.TabsTrigger Value="reports">@L.T("报表", "Reports")</AtomBlazor.TabsTrigger>
                <AtomBlazor.TabsTrigger Value="notifications">@L.T("通知", "Notifications")</AtomBlazor.TabsTrigger>
            </AtomBlazor.TabsList>

            <AtomBlazor.TabsContent Value="overview">
                <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6">
                    <h3 class="text-lg font-semibold mb-2">@L.T("概览", "Overview")</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("查看账户活动与统计数据的摘要。", "View a summary of your account activity and statistics.")
                    </p>
                </div>
            </AtomBlazor.TabsContent>

            <AtomBlazor.TabsContent Value="analytics">
                <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6">
                    <h3 class="text-lg font-semibold mb-2">@L.T("分析", "Analytics")</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("有关你使用情况的详细分析与指标。", "Detailed analytics and metrics about your usage.")
                    </p>
                </div>
            </AtomBlazor.TabsContent>

            <AtomBlazor.TabsContent Value="reports">
                <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6">
                    <h3 class="text-lg font-semibold mb-2">@L.T("报表", "Reports")</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("生成并下载详细报表。", "Generate and download detailed reports.")
                    </p>
                </div>
            </AtomBlazor.TabsContent>

            <AtomBlazor.TabsContent Value="notifications">
                <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6">
                    <h3 class="text-lg font-semibold mb-2">@L.T("通知", "Notifications")</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("管理你的通知偏好。", "Manage your notification preferences.")
                    </p>
                </div>
            </AtomBlazor.TabsContent>
        </Tabs>

        <CodeBlock Source="Components/Tabs/multiple.txt" />
    </div>

    <div class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("受控模式", "Controlled")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("以编程方式控制哪个标签处于激活状态。", "Control which tab is active programmatically.")
        </p>

        <div class="flex gap-2 mb-4">
            <button @onclick='() => activeTab = "morning"'
                    class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-3">
                @L.T("显示早晨", "Show Morning")
            </button>
            <button @onclick='() => activeTab = "afternoon"'
                    class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-3">
                @L.T("显示下午", "Show Afternoon")
            </button>
            <button @onclick='() => activeTab = "evening"'
                    class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-3">
                @L.T("显示夜晚", "Show Evening")
            </button>
        </div>

        @if (L.IsChinese)
        {
            <text>
                <p class="text-xs text-muted-foreground mb-2">当前：<strong>@activeTab</strong></p>
            </text>
        }
        else
        {
            <text>
                <p class="text-xs text-muted-foreground mb-2">Current: <strong>@activeTab</strong></p>
            </text>
        }

        <div class="w-[400px]">
            <Tabs @bind-Value="activeTab">
                <AtomBlazor.TabsList Class="grid w-full grid-cols-3">
                    <AtomBlazor.TabsTrigger Value="morning">@L.T("早晨", "Morning")</AtomBlazor.TabsTrigger>
                    <AtomBlazor.TabsTrigger Value="afternoon">@L.T("下午", "Afternoon")</AtomBlazor.TabsTrigger>
                    <AtomBlazor.TabsTrigger Value="evening">@L.T("夜晚", "Evening")</AtomBlazor.TabsTrigger>
                </AtomBlazor.TabsList>

            <AtomBlazor.TabsContent Value="morning">
                <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6">
                    <h3 class="text-lg font-semibold mb-2">@L.T("🌅 早晨", "🌅 Morning")</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("早上好！用崭新的视角开始新的一天。", "Good morning! Start your day with a fresh perspective.")
                    </p>
                </div>
            </AtomBlazor.TabsContent>

            <AtomBlazor.TabsContent Value="afternoon">
                <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6">
                    <h3 class="text-lg font-semibold mb-2">@L.T("☀️ 下午", "☀️ Afternoon")</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("下午是效率的高峰时刻！", "Afternoon productivity at its peak!")
                    </p>
                </div>
            </AtomBlazor.TabsContent>

            <AtomBlazor.TabsContent Value="evening">
                <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6">
                    <h3 class="text-lg font-semibold mb-2">@L.T("🌙 夜晚", "🌙 Evening")</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("放松下来，回顾这一天。", "Wind down and reflect on your day.")
                    </p>
                </div>
            </AtomBlazor.TabsContent>
            </Tabs>
        </div>

        <CodeBlock Source="Components/Tabs/controlled.txt" />
    </div>

    <div class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("响应式", "Responsive")</h2>
        @if (L.IsChinese)
        {
            <text>
                <p class="text-sm text-muted-foreground">
                    开启 <code>Responsive</code> 后，当标签超出所在容器时，标签列表会自动收拢成一个 Select 下拉框。
                    调整浏览器窗口大小即可看到效果。
                </p>
            </text>
        }
        else
        {
            <text>
                <p class="text-sm text-muted-foreground">
                    When <code>Responsive</code> is enabled, the tabs list automatically collapses into a Select dropdown
                    when the tabs overflow their container. Resize the browser to see it in action.
                </p>
            </text>
        }

        <Tabs DefaultValue="overview">
            <AtomBlazor.TabsList Responsive>
                <AtomBlazor.TabsTrigger Value="overview" Label="@(L.T("概览", "Overview"))">@L.T("概览", "Overview")</AtomBlazor.TabsTrigger>
                <AtomBlazor.TabsTrigger Value="analytics" Label="@(L.T("分析", "Analytics"))">@L.T("分析", "Analytics")</AtomBlazor.TabsTrigger>
                <AtomBlazor.TabsTrigger Value="reports" Label="@(L.T("报表", "Reports"))">@L.T("报表", "Reports")</AtomBlazor.TabsTrigger>
                <AtomBlazor.TabsTrigger Value="notifications" Label="@(L.T("通知", "Notifications"))">@L.T("通知", "Notifications")</AtomBlazor.TabsTrigger>
                <AtomBlazor.TabsTrigger Value="settings" Label="@(L.T("设置", "Settings"))">@L.T("设置", "Settings")</AtomBlazor.TabsTrigger>
                <AtomBlazor.TabsTrigger Value="billing" Label="@(L.T("账单", "Billing"))">@L.T("账单", "Billing")</AtomBlazor.TabsTrigger>
                <AtomBlazor.TabsTrigger Value="integrations" Label="@(L.T("集成", "Integrations"))">@L.T("集成", "Integrations")</AtomBlazor.TabsTrigger>
                <AtomBlazor.TabsTrigger Value="security" Label="@(L.T("安全", "Security"))">@L.T("安全", "Security")</AtomBlazor.TabsTrigger>
            </AtomBlazor.TabsList>

            <AtomBlazor.TabsContent Value="overview">
                <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6">
                    <h3 class="text-lg font-semibold mb-2">@L.T("概览", "Overview")</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("查看账户活动与统计数据的摘要。", "View a summary of your account activity and statistics.")
                    </p>
                </div>
            </AtomBlazor.TabsContent>

            <AtomBlazor.TabsContent Value="analytics">
                <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6">
                    <h3 class="text-lg font-semibold mb-2">@L.T("分析", "Analytics")</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("有关你使用模式的详细分析与指标。", "Detailed analytics and metrics about your usage patterns.")
                    </p>
                </div>
            </AtomBlazor.TabsContent>

            <AtomBlazor.TabsContent Value="reports">
                <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6">
                    <h3 class="text-lg font-semibold mb-2">@L.T("报表", "Reports")</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("为团队生成并下载详细报表。", "Generate and download detailed reports for your team.")
                    </p>
                </div>
            </AtomBlazor.TabsContent>

            <AtomBlazor.TabsContent Value="notifications">
                <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6">
                    <h3 class="text-lg font-semibold mb-2">@L.T("通知", "Notifications")</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("管理你的通知偏好与通知渠道。", "Manage your notification preferences and channels.")
                    </p>
                </div>
            </AtomBlazor.TabsContent>

            <AtomBlazor.TabsContent Value="settings">
                <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6">
                    <h3 class="text-lg font-semibold mb-2">@L.T("设置", "Settings")</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("配置你的账户设置与个人偏好。", "Configure your account settings and preferences.")
                    </p>
                </div>
            </AtomBlazor.TabsContent>

            <AtomBlazor.TabsContent Value="billing">
                <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6">
                    <h3 class="text-lg font-semibold mb-2">@L.T("账单", "Billing")</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("管理你的订阅、付款方式与发票。", "Manage your subscription, payment methods, and invoices.")
                    </p>
                </div>
            </AtomBlazor.TabsContent>

            <AtomBlazor.TabsContent Value="integrations">
                <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6">
                    <h3 class="text-lg font-semibold mb-2">@L.T("集成", "Integrations")</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("接入第三方服务并管理 API 密钥。", "Connect third-party services and manage API keys.")
                    </p>
                </div>
            </AtomBlazor.TabsContent>

            <AtomBlazor.TabsContent Value="security">
                <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6">
                    <h3 class="text-lg font-semibold mb-2">@L.T("安全", "Security")</h3>
                    <p class="text-sm text-muted-foreground">
                        @L.T("双因素认证、登录会话与审计日志。", "Two-factor authentication, sessions, and audit log.")
                    </p>
                </div>
            </AtomBlazor.TabsContent>
        </Tabs>

        <CodeBlock Source="Components/Tabs/responsive.txt" />
    </div>

    <div class="space-y-4">
        <h2 class="text-2xl font-semibold">@L.T("可编辑", "Editable")</h2>
        <p class="text-sm text-muted-foreground">
            @L.T("可以新增、关闭、重命名和重新排序的标签页。列表不会自己变化——每个手势都只会触发一个回调，由这个页面去修改自己持有的集合，因此顺序和名称始终留在你已有的地方。", "Tabs that can be added, closed, renamed and reordered. The list never changes itself — every gesture raises a callback and this page changes its own collection, so the order and the names stay wherever you already keep them.")
        </p>
        @if (L.IsChinese)
        {
            <text>
                <p class="text-sm text-muted-foreground">
                    拖动某个标签，或让标签获得焦点后按 <Kbd>Ctrl</Kbd> 加方向键，即可移动它。双击某个标签，
                    或按 <Kbd>F2</Kbd>，即可重命名它。点击 <Kbd>×</Kbd>，或按
                    <Kbd>Delete</Kbd>，即可关闭它。剩下的最后一个标签无法关闭。
                </p>
            </text>
        }
        else
        {
            <text>
                <p class="text-sm text-muted-foreground">
                    Drag a tab, or press <Kbd>Ctrl</Kbd> with an arrow key, to move it. Double-click a
                    tab, or press <Kbd>F2</Kbd>, to rename it. Click the <Kbd>×</Kbd>, or press
                    <Kbd>Delete</Kbd>, to close it. The last remaining tab cannot be closed.
                </p>
            </text>
        }

        <Tabs @bind-Value="activeSheet">
            <AtomBlazor.TabsList Responsive Closable Renamable Reorderable Addable
                        AddLabel="@(L.T("新建工作表", "New sheet"))"
                        OnAdd="AddSheet"
                        OnClose="CloseSheet"
                        OnRename="RenameSheet"
                        OnMove="MoveSheet">
                @foreach (var sheet in sheets)
                {
                    <AtomBlazor.TabsTrigger @key="sheet.Id"
                                   Value="@sheet.Id"
                                   Label="@sheet.Name"
                                   Closable="@(sheets.Count > 1)" />
                }
            </AtomBlazor.TabsList>

            @foreach (var sheet in sheets)
            {
                <AtomBlazor.TabsContent @key="sheet.Id" Value="@sheet.Id">
                    <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6">
                        <h3 class="text-lg font-semibold mb-2">@sheet.Name</h3>
                        @if (L.IsChinese)
                        {
                            <text>
                                <p class="text-sm text-muted-foreground">
                                    这是 @sheet.Name 的面板。标签被移到哪儿，它的内容就跟到哪儿。
                                </p>
                            </text>
                        }
                        else
                        {
                            <text>
                                <p class="text-sm text-muted-foreground">
                                    The panel for @sheet.Name. Its content follows the tab wherever the tab goes.
                                </p>
                            </text>
                        }
                    </div>
                </AtomBlazor.TabsContent>
            }
        </Tabs>

        <div class="rounded-md border bg-muted/40 p-4 space-y-2">
            <p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                @L.T("标签背后的集合", "The collection behind the tabs")
            </p>
            <ol class="text-sm font-mono space-y-0.5">
                @for (var i = 0; i < sheets.Count; i++)
                {
                    <li>@i — <span class="text-muted-foreground">@sheets[i].Id</span> "@sheets[i].Name"</li>
                }
            </ol>
            <p class="text-xs text-muted-foreground">
                @L.F("最近一次变更：{0}", "Last change: {0}", lastChange)
            </p>
        </div>

        <CodeBlock Source="Components/Tabs/editable.txt" />
    </div>

    <AccessibilityList>
        <AriaAttributes>
            @if (L.IsChinese)
            {
                <text>
                    <AccessibilityItem>用语义角色 <code>role="tablist"</code>、<code>role="tab"</code> 与 <code>role="tabpanel"</code> 表达正确结构</AccessibilityItem>
                </text>
            }
            else
            {
                <text>
                    <AccessibilityItem>Uses <code>role="tablist"</code>, <code>role="tab"</code>, and <code>role="tabpanel"</code> for proper semantics</AccessibilityItem>
                </text>
            }
            @if (L.IsChinese)
            {
                <text>
                    <AccessibilityItem><code>aria-selected</code> 用来标明当前激活的标签</AccessibilityItem>
                </text>
            }
            else
            {
                <text>
                    <AccessibilityItem><code>aria-selected</code> indicates the active tab</AccessibilityItem>
                </text>
            }
            @if (L.IsChinese)
            {
                <text>
                    <AccessibilityItem><code>aria-controls</code> 把每个标签触发器与它的内容面板关联起来</AccessibilityItem>
                </text>
            }
            else
            {
                <text>
                    <AccessibilityItem><code>aria-controls</code> links each tab trigger to its content panel</AccessibilityItem>
                </text>
            }
            @if (L.IsChinese)
            {
                <text>
                    <AccessibilityItem><code>aria-orientation</code> 反映横向或纵向的排布</AccessibilityItem>
                </text>
            }
            else
            {
                <text>
                    <AccessibilityItem><code>aria-orientation</code> reflects horizontal or vertical layout</AccessibilityItem>
                </text>
            }
            <AccessibilityItem>@L.T("被禁用的标签不参与 Tab 顺序", "Disabled tabs are excluded from the tab sequence")</AccessibilityItem>
            @if (L.IsChinese)
            {
                <text>
                    <AccessibilityItem>关闭入口是一枚带 <code>aria-hidden</code> 的 span，而不是嵌套的按钮——<code>role="tab"</code> 元素内部不能再放一个可交互元素，所以键盘上的关闭途径是 <Kbd>Delete</Kbd></AccessibilityItem>
                </text>
            }
            else
            {
                <text>
                    <AccessibilityItem>The close affordance is an <code>aria-hidden</code> span, not a nested button — a <code>role="tab"</code> element must not contain another interactive element, so <Kbd>Delete</Kbd> is the keyboard route</AccessibilityItem>
                </text>
            }
            <AccessibilityItem>@L.T("添加按钮放在 tablist 旁边而不是它内部，因此它自己是独立的 Tab 停靠点，也不会被播报成标签", "The add button sits beside the tablist rather than inside it, so it is its own tab stop and never reports itself as a tab")</AccessibilityItem>
        </AriaAttributes>
        <KeyboardNavigation>
            <KeyboardShortcutItem Description="@(L.T("在各标签之间移动焦点", "Move focus between tabs"))">
                <Kbd>Arrow Keys</Kbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("激活当前聚焦的标签（Manual 模式）", "Activate focused tab (manual mode)"))">
                <Kbd>Enter</Kbd> / <Kbd>Space</Kbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("把焦点移到第一个标签", "Move focus to first tab"))">
                <Kbd>Home</Kbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("把焦点移到最后一个标签", "Move focus to last tab"))">
                <Kbd>End</Kbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("关闭当前聚焦的标签（Closable 时）", "Close the focused tab (when Closable)"))">
                <Kbd>Delete</Kbd> / <Kbd>Backspace</Kbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("重命名当前聚焦的标签（Renamable 时）", "Rename the focused tab (when Renamable)"))">
                <Kbd>F2</Kbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("把当前聚焦的标签移动一位（Reorderable 时）", "Move the focused tab one place (when Reorderable)"))">
                <Kbd>Ctrl</Kbd> + <Kbd>Arrow Keys</Kbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="@(L.T("提交或取消重命名", "Commit or cancel a rename"))">
                <Kbd>Enter</Kbd> / <Kbd>Esc</Kbd>
            </KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>

    <!-- API Reference -->
    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">@L.T("API 参考", "API Reference")</h2>
            <p class="text-muted-foreground">@L.T("组件属性与参数。", "Component properties and parameters.")</p>
        </div>

        <div class="space-y-4">
            <ApiReference ComponentName="Tabs">
                <ApiParameter Name="Value" Type="string?" Default="null">
                    @if (L.IsChinese)
                    {
                        <text>
                            受控模式下由它决定哪个标签处于激活状态。支持与 <code>@@bind-Value</code> 双向绑定。
                        </text>
                    }
                    else
                    {
                        <text>
                            Controls which tab is active (controlled mode). Supports two-way binding with <code>@@bind-Value</code>.
                        </text>
                    }
                </ApiParameter>
                <ApiParameter Name="DefaultValue" Type="string?" Default="null">
                    @L.T("非受控模式下默认激活的标签值。", "Default active tab value when in uncontrolled mode.")
                </ApiParameter>
                <ApiParameter Name="Orientation" Type="TabsOrientation" Default="Horizontal">
                    @L.T("标签的排列方向。可选值：Horizontal、Vertical。", "Orientation of the tabs. Options: Horizontal, Vertical.")
                </ApiParameter>
                <ApiParameter Name="ActivationMode" Type="TabsActivationMode" Default="Automatic">
                    @L.T("激活方式。Automatic 在聚焦时激活，Manual 则需要按 Enter/Space。", "Activation mode. Automatic activates on focus, Manual requires Enter/Space.")
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?" Default="null">
                    @L.T("应用到标签容器的额外 CSS 类。", "Additional CSS classes for the tabs container.")
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    @if (L.IsChinese)
                    {
                        <text>
                            应用到组件根元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                        </text>
                    }
                    else
                    {
                        <text>
                            Additional HTML attributes applied to the component's root element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                        </text>
                    }
                </ApiParameter>
            </ApiReference>

            <ApiReference ComponentName="TabsList">
                <ApiParameter Name="Class" Type="string?" Default="null">
                    @L.T("应用到标签列表容器的额外 CSS 类。", "Additional CSS classes for the tabs list container.")
                </ApiParameter>
                <ApiParameter Name="Responsive" Type="bool" Default="false">
                    @L.T("为 true 时，标签超出所在容器就会收拢进一个 Select 下拉框。", "When true, collapses tabs into a Select dropdown when they overflow their container.")
                </ApiParameter>
                <ApiParameter Name="Closable" Type="bool" Default="false">
                    @if (L.IsChinese)
                    {
                        <text>
                            是否为每个标签都带上关闭入口。需要 <code>OnClose</code>。单个标签可以覆盖这个设置。
                        </text>
                    }
                    else
                    {
                        <text>
                            Whether every tab carries a close affordance. Needs <code>OnClose</code>. A tab can override this for itself.
                        </text>
                    }
                </ApiParameter>
                <ApiParameter Name="Renamable" Type="bool" Default="false">
                    @if (L.IsChinese)
                    {
                        <text>
                            是否每个标签都能就地重命名。需要 <code>OnRename</code>。双击或按 <code>F2</code>。
                        </text>
                    }
                    else
                    {
                        <text>
                            Whether every tab can be renamed in place. Needs <code>OnRename</code>. Double-click or <code>F2</code>.
                        </text>
                    }
                </ApiParameter>
                <ApiParameter Name="Reorderable" Type="bool" Default="false">
                    @if (L.IsChinese)
                    {
                        <text>
                            是否每个标签都可以拖到新位置。需要 <code>OnMove</code>。拖动，或按 <code>Ctrl</code> 加方向键。
                        </text>
                    }
                    else
                    {
                        <text>
                            Whether every tab can be dragged to a new position. Needs <code>OnMove</code>. Drag, or <code>Ctrl</code> with an arrow key.
                        </text>
                    }
                </ApiParameter>
                <ApiParameter Name="Addable" Type="bool" Default="false">
                    @if (L.IsChinese)
                    {
                        <text>
                            是否在最后一个标签之后画出用于添加标签的按钮。需要 <code>OnAdd</code>。
                        </text>
                    }
                    else
                    {
                        <text>
                            Whether a button for adding a tab is drawn after the last one. Needs <code>OnAdd</code>.
                        </text>
                    }
                </ApiParameter>
                <ApiParameter Name="AddLabel" Type="string?" Default="null">
                    @L.T("添加按钮的无障碍名称与提示文字。默认为 \"New tab\"。", "Accessible name and tooltip for the add button. Defaults to \"New tab\".")
                </ApiParameter>
                <ApiParameter Name="OnClose" Type="EventCallback&lt;string&gt;">
                    @L.T("某个标签请求关闭时调用，参数是该标签的值。", "Invoked when a tab asks to be closed, carrying the tab's value.")
                </ApiParameter>
                <ApiParameter Name="OnAdd" Type="EventCallback">
                    @L.T("按下添加按钮时调用。", "Invoked when the add button is pressed.")
                </ApiParameter>
                <ApiParameter Name="OnRename" Type="EventCallback&lt;TabRenameContext&gt;">
                    @if (L.IsChinese)
                    {
                        <text>
                            标签完成重命名后调用。携带 <code>Value</code>、<code>OldLabel</code> 与 <code>NewLabel</code>；把 <code>Cancel</code> 置位即可拒绝这次重命名并重新打开编辑器。
                        </text>
                    }
                    else
                    {
                        <text>
                            Invoked when a tab has been renamed. Carries <code>Value</code>, <code>OldLabel</code> and <code>NewLabel</code>; set <code>Cancel</code> to refuse it and reopen the editor.
                        </text>
                    }
                </ApiParameter>
                <ApiParameter Name="OnMove" Type="EventCallback&lt;TabMoveContext&gt;">
                    @if (L.IsChinese)
                    {
                        <text>
                            标签被移动时调用。携带 <code>Value</code>、<code>OldIndex</code> 与 <code>NewIndex</code>。请把它应用到你自己的集合上；什么都不做就等于拒绝。
                        </text>
                    }
                    else
                    {
                        <text>
                            Invoked when a tab is moved. Carries <code>Value</code>, <code>OldIndex</code> and <code>NewIndex</code>. Apply it to your own collection, or do nothing to refuse it.
                        </text>
                    }
                </ApiParameter>
                <ApiParameter Name="SelectClass" Type="string?" Default="null">
                    @L.T("应用到响应式 Select 回退形态的额外 CSS 类。", "Additional CSS classes for the responsive Select fallback.")
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    @if (L.IsChinese)
                    {
                        <text>
                            应用到根 <code>&lt;div&gt;</code> 元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                        </text>
                    }
                    else
                    {
                        <text>
                            Additional HTML attributes applied to the root <code>&lt;div&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                        </text>
                    }
                </ApiParameter>
            </ApiReference>

            <ApiReference ComponentName="TabsTrigger">
                <ApiParameter Name="Value" Type="string">
                    @L.T("用于标识这个标签的值，必须与某个 TabsContent Value 相同。", "The value that identifies this tab. Must match a TabsContent Value.")
                </ApiParameter>
                <ApiParameter Name="Label" Type="string?" Default="null">
                    @L.T("这个标签的显示文本。用于响应式 Select，作为重命名的起始文本，并在没有子内容时充当标签自身的内容。缺省时回落到 Value。", "Display text for this tab. Used for the responsive Select, as the starting text for a rename, and as the tab's own content where no child content is given. Falls back to Value.")
                </ApiParameter>
                <ApiParameter Name="Disabled" Type="bool" Default="false">
                    @L.T("这个标签触发器是否被禁用。", "Whether this tab trigger is disabled.")
                </ApiParameter>
                <ApiParameter Name="Closable" Type="bool?" Default="null">
                    @L.T("这个标签能否被关闭。为 null 时跟随列表的设置；显式设值就可以把某个标签钉住。", "Whether this tab can be closed. Null follows the list — set it to pin one tab open.")
                </ApiParameter>
                <ApiParameter Name="Renamable" Type="bool?" Default="null">
                    @L.T("这个标签能否就地重命名。为 null 时跟随列表的设置。", "Whether this tab can be renamed in place. Null follows the list.")
                </ApiParameter>
                <ApiParameter Name="Reorderable" Type="bool?" Default="null">
                    @L.T("这个标签能否被拖到新位置。为 null 时跟随列表的设置。", "Whether this tab can be dragged to a new position. Null follows the list.")
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?" Default="null">
                    @L.T("应用到标签触发器的额外 CSS 类。", "Additional CSS classes for the tab trigger.")
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    @if (L.IsChinese)
                    {
                        <text>
                            应用到组件根元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                        </text>
                    }
                    else
                    {
                        <text>
                            Additional HTML attributes applied to the component's root element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                        </text>
                    }
                </ApiParameter>
            </ApiReference>

            <ApiReference ComponentName="TabsContent">
                <ApiParameter Name="Value" Type="string">
                    @L.T("用于标识这个内容面板的值，必须与某个 TabsTrigger Value 相同。", "The value that identifies this content panel. Must match a TabsTrigger Value.")
                </ApiParameter>
                <ApiParameter Name="ForceMount" Type="bool" Default="false">
                    @L.T("为 true 时，面板在非激活状态下只隐藏而不卸载。", "When true, content remains mounted but hidden when inactive instead of being unmounted.")
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?" Default="null">
                    @L.T("应用到标签内容面板的额外 CSS 类。", "Additional CSS classes for the tab content panel.")
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    @if (L.IsChinese)
                    {
                        <text>
                            应用到组件根元素上的额外 HTML 属性（例如 <code>data-testid</code>、<code>aria-label</code>）。
                        </text>
                    }
                    else
                    {
                        <text>
                            Additional HTML attributes applied to the component's root element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                        </text>
                    }
                </ApiParameter>
            </ApiReference>
        </div>
    </section>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    private string? activeTab = "morning";

    private sealed record Sheet(string Id, string Name);

    private readonly List<Sheet> sheets =
    [
        new("summary", "Summary"),
        new("q1", "Q1"),
        new("q2", "Q2"),
    ];

    private string? activeSheet = "summary";
    private int nextSheet = 3;
    private string lastChange = "nothing yet";

    private void AddSheet()
    {
        nextSheet++;
        var id = $"sheet-{nextSheet}";
        sheets.Add(new Sheet(id, L.IsChinese ? $"工作表 {nextSheet}" : $"Sheet {nextSheet}"));
        activeSheet = id;
        lastChange = L.IsChinese ? $"已新增 {id}" : $"added {id}";
    }

    private void CloseSheet(string value)
    {
        var index = sheets.FindIndex(s => s.Id == value);
        if (index < 0 || sheets.Count == 1)
        {
            return;
        }

        sheets.RemoveAt(index);
        lastChange = L.IsChinese ? $"已关闭 {value}" : $"closed {value}";

        // 由相邻标签接管，列表末位标签则由自身接管。
        if (activeSheet == value)
        {
            activeSheet = sheets[Math.Min(index, sheets.Count - 1)].Id;
        }
    }

    private void RenameSheet(TabRenameContext context)
    {
        var index = sheets.FindIndex(s => s.Id == context.Value);
        if (index < 0)
        {
            return;
        }

        // 已被占用的名称会被拒绝，这正是 Cancel 的用途。
        if (sheets.Any(s => s.Id != context.Value && s.Name == context.NewLabel))
        {
            context.Cancel = true;
            lastChange = L.IsChinese
                ? $"已拒绝「{context.NewLabel}」，该名称已被占用"
                : $"refused \"{context.NewLabel}\" — that name is taken";
            return;
        }

        sheets[index] = sheets[index] with { Name = context.NewLabel };
        lastChange = L.IsChinese
            ? $"已将 {context.OldLabel} 重命名为 {context.NewLabel}"
            : $"renamed {context.OldLabel} to {context.NewLabel}";
    }

    private void MoveSheet(TabMoveContext context)
    {
        if (context.OldIndex < 0 || context.OldIndex >= sheets.Count)
        {
            return;
        }

        var moved = sheets[context.OldIndex];
        sheets.RemoveAt(context.OldIndex);
        sheets.Insert(Math.Clamp(context.NewIndex, 0, sheets.Count), moved);
        lastChange = L.IsChinese
            ? $"已将 {moved.Name} 从 {context.OldIndex} 移动到 {context.NewIndex}"
            : $"moved {moved.Name} from {context.OldIndex} to {context.NewIndex}";
    }
}
