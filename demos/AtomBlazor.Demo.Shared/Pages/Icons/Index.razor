@page "/icons"

<PageTitle>@L.T("图标库 - Atom BlazorUI", "Icon Libraries - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-6xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">@L.T("图标库", "Icon Libraries")</h1>
            <p class="text-xl text-muted-foreground">
                @L.T("AtomBlazor 提供四套精美的图标库，以满足不同的设计偏好。你可以在 Lucide、Heroicons、Feather 和 Font Awesome 之间浏览并搜索 5,000+ 个图标。", "AtomBlazor offers four beautiful icon libraries to suit different design preferences. Browse and search through 5,000+ icons across Lucide, Heroicons, Feather, and Font Awesome.")
            </p>
        </div>
    </div>

    <!-- Comparison Table -->
    <div class="overflow-x-auto">
        <table class="w-full border-collapse border border-border rounded-lg">
            <thead>
                <tr class="bg-muted">
                    <th class="border border-border p-4 text-left font-semibold">@L.T("图标库", "Library")</th>
                    <th class="border border-border p-4 text-left font-semibold">@L.T("图标数", "Icons")</th>
                    <th class="border border-border p-4 text-left font-semibold">@L.T("变体", "Variants")</th>
                    <th class="border border-border p-4 text-left font-semibold">@L.T("许可证", "License")</th>
                    <th class="border border-border p-4 text-left font-semibold">@L.T("适用场景", "Best For")</th>
                </tr>
            </thead>
            <tbody>
                <tr class="hover:bg-muted/50">
                    <td class="border border-border p-4">
                        <a href="/icons/lucide" class="font-semibold text-primary hover:underline">Lucide Icons</a>
                    </td>
                    <td class="border border-border p-4">1,640</td>
                    <td class="border border-border p-4">1 (stroke)</td>
                    <td class="border border-border p-4">ISC</td>
                    <td class="border border-border p-4">@L.T("现代、简洁的界面", "Modern, clean interfaces")</td>
                </tr>
                <tr class="hover:bg-muted/50">
                    <td class="border border-border p-4">
                        <a href="/icons/heroicons" class="font-semibold text-primary hover:underline">Heroicons</a>
                    </td>
                    <td class="border border-border p-4">1,288</td>
                    <td class="border border-border p-4">4 (outline, solid, mini, micro)</td>
                    <td class="border border-border p-4">MIT (Tailwind Labs)</td>
                    <td class="border border-border p-4">@L.T("基于 Tailwind 的设计，尺寸灵活", "Tailwind-based designs, flexible sizing")</td>
                </tr>
                <tr class="hover:bg-muted/50">
                    <td class="border border-border p-4">
                        <a href="/icons/feather" class="font-semibold text-primary hover:underline">Feather Icons</a>
                    </td>
                    <td class="border border-border p-4">286</td>
                    <td class="border border-border p-4">1 (stroke)</td>
                    <td class="border border-border p-4">MIT</td>
                    <td class="border border-border p-4">@L.T("简单、轻量的项目", "Simple, lightweight projects")</td>
                </tr>
                <tr class="hover:bg-muted/50">
                    <td class="border border-border p-4">
                        <a href="/icons/fontawesome" class="font-semibold text-primary hover:underline">Font Awesome</a>
                    </td>
                    <td class="border border-border p-4">2,066</td>
                    <td class="border border-border p-4">3 (solid, regular, brands)</td>
                    <td class="border border-border p-4">CC BY 4.0 / SIL OFL 1.1 / MIT (Free)</td>
                    <td class="border border-border p-4">@L.T("覆盖广泛，含第三方徽标", "Broad coverage incl. third-party logos")</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Icon Library Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Lucide Icons Card -->
        <a href="/icons/lucide" class="block p-6 border border-border rounded-lg hover:border-primary hover:shadow-lg transition-all">
            <div class="space-y-3">
                <div class="flex items-center gap-3">
                    <div class="flex items-center justify-center w-12 h-12 rounded-lg bg-primary/10 text-primary">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                            <path d="M2 17l10 5 10-5"/>
                            <path d="M2 12l10 5 10-5"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-xl font-semibold">Lucide Icons</h3>
                        <p class="text-sm text-muted-foreground">@L.T("1,640 个图标", "1,640 icons")</p>
                    </div>
                </div>
                <p class="text-muted-foreground">
                    @L.T("精美、风格统一的描边图标，非常适合现代、简洁的界面。规模最大、覆盖最全的图标集。", "Beautiful, consistent stroke-based icons perfect for modern, clean interfaces. The largest icon set with extensive coverage.")
                </p>
                <div class="flex items-center gap-2 text-sm text-primary font-medium">
                    @L.T("浏览 Lucide 图标", "Browse Lucide Icons")
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"/>
                    </svg>
                </div>
            </div>
        </a>

        <!-- Heroicons Card -->
        <a href="/icons/heroicons" class="block p-6 border border-border rounded-lg hover:border-primary hover:shadow-lg transition-all">
            <div class="space-y-3">
                <div class="flex items-center gap-3">
                    <div class="flex items-center justify-center w-12 h-12 rounded-lg bg-primary/10 text-primary">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="12 2 2 7 12 12 22 7 12 2"/>
                            <polyline points="2 17 12 22 22 17"/>
                            <polyline points="2 12 12 17 22 12"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-xl font-semibold">Heroicons</h3>
                        <p class="text-sm text-muted-foreground">@L.T("1,288 个图标（4 种变体）", "1,288 icons (4 variants)")</p>
                    </div>
                </div>
                <p class="text-muted-foreground">
                    @L.T("由 Tailwind Labs 设计，提供 4 种变体（outline、solid、mini、micro），在尺寸与风格上最为灵活。", "Designed by Tailwind Labs with 4 variants (outline, solid, mini, micro) for maximum flexibility in sizing and style.")
                </p>
                <div class="flex items-center gap-2 text-sm text-primary font-medium">
                    @L.T("浏览 Heroicons", "Browse Heroicons")
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"/>
                    </svg>
                </div>
            </div>
        </a>

        <!-- Feather Icons Card -->
        <a href="/icons/feather" class="block p-6 border border-border rounded-lg hover:border-primary hover:shadow-lg transition-all">
            <div class="space-y-3">
                <div class="flex items-center gap-3">
                    <div class="flex items-center justify-center w-12 h-12 rounded-lg bg-primary/10 text-primary">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/>
                            <line x1="16" y1="8" x2="2" y2="22"/>
                            <line x1="17.5" y1="15" x2="9" y2="15"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-xl font-semibold">Feather Icons</h3>
                        <p class="text-sm text-muted-foreground">@L.T("286 个图标", "286 icons")</p>
                    </div>
                </div>
                <p class="text-muted-foreground">
                    @L.T("极简的描边图标，非常适合简单、轻量的项目。精心筛选的基础图标集。", "Minimalist, stroke-based icons perfect for simple, lightweight projects. Carefully curated essential icon set.")
                </p>
                <div class="flex items-center gap-2 text-sm text-primary font-medium">
                    @L.T("浏览 Feather 图标", "Browse Feather Icons")
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"/>
                    </svg>
                </div>
            </div>
        </a>

        <!-- Font Awesome Card -->
        <a href="/icons/fontawesome" class="block p-6 border border-border rounded-lg hover:border-primary hover:shadow-lg transition-all">
            <div class="space-y-3">
                <div class="flex items-center gap-3">
                    <div class="flex items-center justify-center w-12 h-12 rounded-lg bg-primary/10 text-primary">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 21V4l8 3 8-3v14l-8 3z" />
                            <line x1="4" y1="8" x2="20" y2="8" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-xl font-semibold">Font Awesome</h3>
                        <p class="text-sm text-muted-foreground">@L.T("2,066 个图标（3 种变体）", "2,066 icons (3 variants)")</p>
                    </div>
                </div>
                <p class="text-muted-foreground">
                    @L.T("Font Awesome 免费版，提供 3 种变体（solid、regular、brand）。包含其他图标集没有的第三方徽标（GitHub、Microsoft 等）。", "Font Awesome Free with 3 variants (solid, regular, brand). Includes third-party logos (GitHub, Microsoft, etc.) not available in the other sets.")
                </p>
                <div class="flex items-center gap-2 text-sm text-primary font-medium">
                    @L.T("浏览 Font Awesome", "Browse Font Awesome")
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6" />
                    </svg>
                </div>
            </div>
        </a>
    </div>

    <!-- Quick Links -->
    <div class="pt-8 border-t border-border">
        <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-center justify-between">
            <div>
                <h2 class="text-lg font-semibold mb-2">@L.T("浏览其他章节", "Explore Other Sections")</h2>
                <p class="text-muted-foreground">
                    @L.T("探索预置样式的组件与无头基础构件。", "Discover pre-styled components and headless primitives.")
                </p>
            </div>
            <div class="flex gap-3">
                <a href="/components" class="inline-flex items-center gap-2 px-4 py-2 border border-border rounded-md hover:bg-accent transition-colors">
                    @L.T("组件", "Components")
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"/>
                    </svg>
                </a>
                <a href="/primitives" class="inline-flex items-center gap-2 px-4 py-2 border border-border rounded-md hover:bg-accent transition-colors">
                    @L.T("基础构件", "Primitives")
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"/>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;
}
