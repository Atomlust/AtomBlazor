@page "/icons/feather"
@using AtomBlazor.Icons.Feather
@using AtomBlazor.Icons.Feather.Data

<PageTitle>@L.T("Feather 图标 - Atom BlazorUI", "Feather Icons - Atom BlazorUI")</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <div class="flex items-center gap-3">
                <a href="/icons" class="text-muted-foreground hover:text-foreground transition-colors">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6"/>
                    </svg>
                </a>
                <h1 class="text-4xl font-bold tracking-tight">@L.T("Feather 图标", "Feather Icons")</h1>
            </div>
            <p class="text-xl text-muted-foreground">
                @L.F("浏览并搜索 Feather 图标库的 {0} 个极简描边图标。", "Browse and search through {0} minimalist, stroke-based icons from the Feather icon library.", TotalIconCount)
            </p>
        </div>
    </div>

    <!-- Search and Stats -->
    <div class="flex flex-col md:flex-row gap-4 items-start md:items-center justify-between">
        <div class="w-full md:w-96">
            <div class="relative">
                <FeatherIcon Name="search" Size="20" Class="absolute left-3 top-1/2 transform -translate-y-1/2 text-muted-foreground" />
                <input
                    type="text"
                    placeholder="@(L.T("搜索图标...", "Search icons..."))"
                    class="w-full pl-10 pr-4 py-2 border border-input bg-background rounded-md focus:outline-none focus:ring-2 focus:ring-ring"
                    @bind="searchQuery"
                    @bind:event="oninput" />
            </div>
        </div>

        <div class="text-sm text-muted-foreground">
            @if (L.IsChinese)
            {
                <text>
                    显示 <span class="font-semibold text-foreground">@FilteredIcons.Count()</span> / 共 @TotalIconCount 个图标
                </text>
            }
            else
            {
                <text>
                    Showing <span class="font-semibold text-foreground">@FilteredIcons.Count()</span> of @TotalIconCount icons
                </text>
            }
        </div>
    </div>

    <!-- Icon Grid -->
    @if (FilteredIcons.Any())
    {
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 xl:grid-cols-8 gap-4">
            @foreach (var iconName in FilteredIcons)
            {
                <div class="flex flex-col items-center justify-center p-4 border border-border rounded-lg hover:bg-accent hover:border-accent-foreground/20 transition-colors cursor-pointer group"
                     title="@iconName">
                    <div class="mb-2 text-foreground group-hover:scale-110 transition-transform">
                        <FeatherIcon Name="@iconName" Size="32" />
                    </div>
                    <span class="text-xs text-center text-muted-foreground group-hover:text-foreground font-mono break-all">
                        @iconName
                    </span>
                </div>
            }
        </div>
    }
    else
    {
        <div class="flex flex-col items-center justify-center py-16 text-center">
            <FeatherIcon Name="search" Size="48" Class="text-muted-foreground mb-4" />
            <h3 class="text-lg font-semibold mb-2">@L.T("未找到图标", "No icons found")</h3>
            <p class="text-muted-foreground">
                @L.T("试试调整搜索关键词", "Try adjusting your search query")
            </p>
        </div>
    }

    <!-- Usage Examples -->
    <div class="mt-12 space-y-6">
        <h2 class="text-2xl font-bold">@L.T("用法示例", "Usage Examples")</h2>

        <!-- Basic Usage -->
        <div class="space-y-4">
            <h3 class="text-xl font-semibold">@L.T("基本用法", "Basic Usage")</h3>
            <div class="p-6 border border-border rounded-lg bg-card space-y-4">
                <div class="flex items-center gap-4">
                    <FeatherIcon Name="home" />
                    <FeatherIcon Name="settings" />
                    <FeatherIcon Name="user" />
                    <FeatherIcon Name="heart" />
                    <FeatherIcon Name="star" />
                </div>
                <pre class="bg-muted p-4 rounded text-sm overflow-x-auto"><code>@@using AtomBlazor.Icons.Feather

&lt;FeatherIcon Name="home" /&gt;
&lt;FeatherIcon Name="settings" /&gt;
&lt;FeatherIcon Name="user" /&gt;</code></pre>
            </div>
        </div>

        <!-- Different Sizes -->
        <div class="space-y-4">
            <h3 class="text-xl font-semibold">@L.T("不同尺寸", "Different Sizes")</h3>
            <div class="p-6 border border-border rounded-lg bg-card space-y-4">
                <div class="flex items-center gap-6">
                    <FeatherIcon Name="camera" Size="16" />
                    <FeatherIcon Name="camera" Size="24" />
                    <FeatherIcon Name="camera" Size="32" />
                    <FeatherIcon Name="camera" Size="48" />
                    <FeatherIcon Name="camera" Size="64" />
                </div>
                <pre class="bg-muted p-4 rounded text-sm overflow-x-auto"><code>&lt;FeatherIcon Name="camera" Size="16" /&gt;
&lt;FeatherIcon Name="camera" Size="24" /&gt;
&lt;FeatherIcon Name="camera" Size="32" /&gt;</code></pre>
            </div>
        </div>

        <!-- Custom Colors -->
        <div class="space-y-4">
            <h3 class="text-xl font-semibold">@L.T("自定义配色", "Custom Colors")</h3>
            <div class="p-6 border border-border rounded-lg bg-card space-y-4">
                <div class="flex items-center gap-6">
                    <FeatherIcon Name="heart" Size="32" Color="red" />
                    <FeatherIcon Name="star" Size="32" Color="gold" />
                    <FeatherIcon Name="check-circle" Size="32" Color="green" />
                    <FeatherIcon Name="alert-circle" Size="32" Color="orange" />
                    <FeatherIcon Name="x-circle" Size="32" Color="#ef4444" />
                </div>
                <pre class="bg-muted p-4 rounded text-sm overflow-x-auto"><code>&lt;FeatherIcon Name="heart" Size="32" Color="red" /&gt;
&lt;FeatherIcon Name="star" Size="32" Color="gold" /&gt;
&lt;FeatherIcon Name="check-circle" Size="32" Color="green" /&gt;</code></pre>
            </div>
        </div>

        <!-- Custom Stroke Width -->
        <div class="space-y-4">
            <h3 class="text-xl font-semibold">@L.T("自定义描边宽度", "Custom Stroke Width")</h3>
            <div class="p-6 border border-border rounded-lg bg-card space-y-4">
                <div class="flex items-center gap-6">
                    <FeatherIcon Name="circle" Size="48" StrokeWidth="1" />
                    <FeatherIcon Name="circle" Size="48" StrokeWidth="2" />
                    <FeatherIcon Name="circle" Size="48" StrokeWidth="3" />
                    <FeatherIcon Name="circle" Size="48" StrokeWidth="4" />
                </div>
                <pre class="bg-muted p-4 rounded text-sm overflow-x-auto"><code>&lt;FeatherIcon Name="circle" Size="48" StrokeWidth="1" /&gt;
&lt;FeatherIcon Name="circle" Size="48" StrokeWidth="2" /&gt;
&lt;FeatherIcon Name="circle" Size="48" StrokeWidth="3" /&gt;</code></pre>
            </div>
        </div>

        <!-- With Buttons -->
        <div class="space-y-4">
            <h3 class="text-xl font-semibold">@L.T("与 Button 组件集成", "Integration with Button Component")</h3>
            <div class="p-6 border border-border rounded-lg bg-card space-y-4">
                <div class="flex flex-wrap items-center gap-3">
                    <Button>
                        <Icon>
                            <FeatherIcon Name="download" Size="20" />
                        </Icon>
                        <ChildContent>@L.T("下载", "Download")</ChildContent>
                    </Button>

                    <Button Variant="ButtonVariant.Outline">
                        <Icon>
                            <FeatherIcon Name="trash-2" Size="20" />
                        </Icon>
                        <ChildContent>@L.T("删除", "Delete")</ChildContent>
                    </Button>

                    <Button Variant="ButtonVariant.Secondary">
                        <Icon>
                            <FeatherIcon Name="settings" Size="20" />
                        </Icon>
                        <ChildContent>@L.T("设置", "Settings")</ChildContent>
                    </Button>

                    <Button Variant="ButtonVariant.Destructive">
                        <Icon>
                            <FeatherIcon Name="alert-triangle" Size="20" />
                        </Icon>
                        <ChildContent>@L.T("警告", "Warning")</ChildContent>
                    </Button>

                    <Button Variant="ButtonVariant.Ghost">
                        <Icon>
                            <FeatherIcon Name="send" Size="20" />
                        </Icon>
                        <ChildContent>@L.T("发送", "Send")</ChildContent>
                    </Button>
                </div>
                <pre class="bg-muted p-4 rounded text-sm overflow-x-auto"><code>&lt;Button&gt;
    &lt;Icon&gt;
        &lt;FeatherIcon Name="download" Size="20" /&gt;
    &lt;/Icon&gt;
    Download
&lt;/Button&gt;</code></pre>
            </div>
        </div>

        <!-- Icon Position -->
        <div class="space-y-4">
            <h3 class="text-xl font-semibold">@L.T("图标位置", "Icon Position")</h3>
            <div class="p-6 border border-border rounded-lg bg-card space-y-4">
                <div class="flex flex-wrap items-center gap-3">
                    <Button IconPosition="IconPosition.Start">
                        <Icon>
                            <FeatherIcon Name="arrow-left" Size="20" />
                        </Icon>
                        <ChildContent>@L.T("返回", "Back")</ChildContent>
                    </Button>

                    <Button IconPosition="IconPosition.End">
                        <Icon>
                            <FeatherIcon Name="arrow-right" Size="20" />
                        </Icon>
                        <ChildContent>@L.T("下一步", "Next")</ChildContent>
                    </Button>

                    <Button IconPosition="IconPosition.Start">
                        <Icon>
                            <FeatherIcon Name="save" Size="20" />
                        </Icon>
                        <ChildContent>@L.T("保存更改", "Save Changes")</ChildContent>
                    </Button>
                </div>
                <pre class="bg-muted p-4 rounded text-sm overflow-x-auto"><code>&lt;Button IconPosition="IconPosition.End"&gt;
    &lt;Icon&gt;
        &lt;FeatherIcon Name="arrow-right" Size="20" /&gt;
    &lt;/Icon&gt;
    Next
&lt;/Button&gt;</code></pre>
            </div>
        </div>

        <!-- Minimalist Design Note -->
        <div class="space-y-4">
            <h3 class="text-xl font-semibold">@L.T("关于 Feather 图标", "About Feather Icons")</h3>
            <div class="p-6 border border-border rounded-lg bg-card">
                <div class="flex items-start gap-3">
                    <FeatherIcon Name="info" Size="20" Class="flex-shrink-0 mt-0.5" />
                    <div class="space-y-2">
                        <p class="text-sm">
                            @L.T("Feather Icons 是一套精心策划的 286 个极简描边图标集合。每个图标都绘制在 24x24 网格上，统一使用 2px 描边宽度以保持一致。", "Feather Icons is a carefully curated collection of 286 minimalist stroke-based icons. Each icon is designed on a 24x24 grid with a 2px stroke width for consistency.")
                        </p>
                        <p class="text-sm text-muted-foreground">
                            @L.T("适合追求简洁与优雅、偏好更小而有针对性的图标集的项目。", "Perfect for projects that prioritize simplicity and elegance with a smaller, focused icon set.")
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string searchQuery = string.Empty;
    private IEnumerable<string> allIcons = Enumerable.Empty<string>();

    private int TotalIconCount => FeatherIconData.IconCount;

    private IEnumerable<string> FilteredIcons
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchQuery))
            {
                return allIcons;
            }

            return allIcons.Where(icon =>
                icon.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
        }
    }

    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    protected override void OnInitialized()
    {
        allIcons = FeatherIconData.GetAvailableIcons().OrderBy(x => x).ToList();
    }
}
