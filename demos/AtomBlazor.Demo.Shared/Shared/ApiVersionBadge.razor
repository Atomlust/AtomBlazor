@* 版本角标：悬停提示按级联语言二选一；英文分支与双语波前形态逐 token 等值，故整段 @if/else。 *@
@if (L.IsChinese)
{
<text>
    <span class="inline-flex shrink-0 items-center rounded border border-primary/20 bg-primary/10 px-1.5 py-0.5 text-[10px] font-semibold leading-none text-primary" title="@($"始于 {Version}")">@Version</span>
</text>
}
else
{
<text>
    <span class="inline-flex shrink-0 items-center rounded border border-primary/20 bg-primary/10 px-1.5 py-0.5 text-[10px] font-semibold leading-none text-primary" title="@($"Added in {Version}")">@Version</span>
</text>
}

@code {
    /// <summary>显示语言快照（MainLayout 级联下发；缺省回落中文）。</summary>
    [CascadingParameter] public DemoCultureState L { get; set; } = DemoCultureState.Default;

    [Parameter] public string Version { get; set; } = "v4";
}
