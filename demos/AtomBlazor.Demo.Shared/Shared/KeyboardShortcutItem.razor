@* 键盘快捷键说明行（自源 Demo.Shared/Shared/KeyboardShortcutItem.razor）。 供文档页 AccessibilityList 的 KeyboardNavigation 插槽展示"说明文本 + 按键"两列布局。 *@

<div class="flex items-center justify-between gap-4">
    <span class="text-sm text-muted-foreground">@Description</span>
    <span class="flex items-center gap-1 shrink-0">@ChildContent</span>
</div>

@code {
    /// <summary>快捷键的说明文本（如 "Move to a dismiss button"）。</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>按键标记内容（通常是一组 &lt;Kbd&gt; 组件）。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
