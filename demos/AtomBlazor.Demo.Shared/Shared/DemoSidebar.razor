        <!-- Components 分区（可折叠子菜单） -->
        <SidebarGroup>
            <SidebarMenu>
                <SidebarMenuItem>
                    <Collapsible Open="@_componentsMenuOpen" OpenChanged="@OnComponentsMenuOpenChanged">
                        <SidebarMenuButton Tooltip="@L.T("组件", "Components")">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                                <path d="M3 9h18"></path>
                                <path d="M9 21V9"></path>
                            </svg>
                            <span>@L.T("组件", "Components")</span>
                            <SidebarMenuChevron>
                                <LucideIcon Name="chevron-right" Size="16" />
                            </SidebarMenuChevron>
                        </SidebarMenuButton>
                        <AtomBlazor.CollapsibleContent>
                            <SidebarMenuSub Class="demo-component-menu">
                                @foreach (var group in ComponentCatalog.NavigationGroups)
                                {
                                    <SidebarMenuSubItem @key="group.Entry.Url">
                                        <SidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="@group.Entry.Url" Class="demo-component-link" title="@group.Entry.Name">
                                            <span class="demo-component-label">@group.Entry.Name</span>
                                        </SidebarMenuSubButton>
                                        @if (group.Children.Count > 0)
                                        {
                                            <SidebarMenuSub Class="demo-component-menu my-1" aria-label="@L.F("{0} 相关演示", "{0} related demos", group.Entry.Name)">
                                                @foreach (var child in group.Children)
                                                {
                                                    <SidebarMenuSubItem @key="child.Url">
                                                        <SidebarMenuSubButton AsChild="@SidebarMenuButtonElement.Anchor" Href="@child.Url" Class="demo-component-link" title="@child.Name">
                                                            <span class="demo-component-label">@ComponentCatalog.NavigationLabel(group.Entry, child)</span>
                                                        </SidebarMenuSubButton>
                                                    </SidebarMenuSubItem>
                                                }
                                            </SidebarMenuSub>
                                        }
                                    </SidebarMenuSubItem>
                                }
                            </SidebarMenuSub>
                        </AtomBlazor.CollapsibleContent>
                    </Collapsible>
                </SidebarMenuItem>
            </SidebarMenu>
        </SidebarGroup>

