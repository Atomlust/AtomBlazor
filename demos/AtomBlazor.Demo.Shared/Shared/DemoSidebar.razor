@using AtomBlazor.Icons.Lucide

<Sidebar Collapsible="true">
    <SidebarHeader>
        <SidebarMenu>
            <SidebarMenuItem>
                <SidebarMenuButton AsChild="@SidebarMenuButtonElement.Anchor" Href="" Size="@SidebarMenuButtonSize.Large" class="data-[state=collapsed]:justify-center">
                    <div class="flex aspect-square size-8 items-center justify-center rounded-lg">
                        <img src="_content/AtomBlazor.Demo.Shared/images/atom.png" alt="Atom BlazorUI" class="size-8 rounded-lg" />
                    </div>
                    <div class="grid flex-1 text-left text-sm leading-tight">
                        <span class="truncate font-semibold">Atom BlazorUI</span>
                    </div>
                </SidebarMenuButton>
            </SidebarMenuItem>
        </SidebarMenu>
    </SidebarHeader>

    <SidebarContent>
        <!-- 顶层导航 -->
        <SidebarGroup>
            <SidebarMenu>
                <SidebarMenuItem>
                    <SidebarMenuButton AsChild="@SidebarMenuButtonElement.Anchor" Href="" Match="NavLinkMatch.All" Tooltip="@L.T("首页", "Home")">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                        <span>@L.T("首页", "Home")</span>
                    </SidebarMenuButton>
                </SidebarMenuItem>

                <SidebarMenuItem>
                    <SidebarMenuButton AsChild="@SidebarMenuButtonElement.Anchor" Href="architecture" Tooltip="@L.T("架构", "Architecture")">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="16" height="20" x="4" y="2" rx="2"></rect>
                            <path d="M8 6h8"></path>
                            <path d="M8 10h8"></path>
                            <path d="M8 14h5"></path>
                        </svg>
                        <span>@L.T("架构", "Architecture")</span>
                    </SidebarMenuButton>
                </SidebarMenuItem>

                <SidebarMenuItem>
                    <SidebarMenuButton AsChild="@SidebarMenuButtonElement.Anchor" Href="primitives" Tooltip="@L.T("基础构件", "Primitives")">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                            <path d="M9 3v18"></path>
                        </svg>
                        <span>@L.T("基础构件", "Primitives")</span>
                    </SidebarMenuButton>
                </SidebarMenuItem>

                <SidebarMenuItem>
                    <SidebarMenuButton AsChild="@SidebarMenuButtonElement.Anchor" Href="components" Tooltip="@L.T("组件", "Components")">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                            <path d="M3 9h18"></path>
                            <path d="M9 21V9"></path>
                        </svg>
                        <span>@L.T("组件", "Components")</span>
                    </SidebarMenuButton>
                </SidebarMenuItem>
            </SidebarMenu>
        </SidebarGroup>

