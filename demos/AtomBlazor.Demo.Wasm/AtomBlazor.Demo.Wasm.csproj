<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AtomBlazor.Demo.Wasm</RootNamespace>
    <AssemblyName>AtomBlazor.Demo.Wasm</AssemblyName>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <!-- WASM 发布优化：裁剪未使用代码以缩减下载体积 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AtomBlazor.Demo.Shared\AtomBlazor.Demo.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
 <!-- 特别授权：Wasm/Auto 宿主仅新增以下框架包，版本与本机 ASP.NET Core RC2 运行时对齐 -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0-rc.3.26522.148" PrivateAssets="all" />
  </ItemGroup>

</Project>
