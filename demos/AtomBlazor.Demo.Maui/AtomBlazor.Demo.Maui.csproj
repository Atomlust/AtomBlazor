<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
 <!-- MAUI Blazor Hybrid 宿主——多目标声明与 maui-blazor 模板一致（android/ios/maccatalyst/windows）。
         本机仅装 maui-windows 工作负载、无 JDK/Mac，故实测路径为 -f net11.0-windows10.0.19041.0；
         其余目标声明保留以兑现跨平台承诺，构建验证归各自平台环境。 -->
    <!-- 可用 -p:MauiTargetFrameworks=<tfm> 显式收窄目标：多目标工程的隐式还原会评估全部
         目标并校验各自的工作负载，CI 只装 maui-windows 时需要借此跳过 android/ios。 -->
    <MauiTargetFrameworks Condition="'$(MauiTargetFrameworks)' == ''">net11.0-android</MauiTargetFrameworks>
    <MauiTargetFrameworks Condition="'$(MauiTargetFrameworks)' == '' and !$([MSBuild]::IsOSPlatform('linux'))">$(MauiTargetFrameworks);net11.0-ios;net11.0-maccatalyst</MauiTargetFrameworks>
    <MauiTargetFrameworks Condition="'$(MauiTargetFrameworks)' == '' and $([MSBuild]::IsOSPlatform('windows'))">$(MauiTargetFrameworks);net11.0-windows10.0.19041.0</MauiTargetFrameworks>
    <TargetFrameworks>$(MauiTargetFrameworks)</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>AtomBlazor.Demo.Maui</RootNamespace>
    <AssemblyName>AtomBlazor.Demo.Maui</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 关闭 MAUI 的 CSS 处理，交由 Blazor/RCL 静态资源管线承载 atomblazor.css 等样式 -->
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <NoWarn>CS1591</NoWarn>

    <ApplicationTitle>AtomBlazor Demo (Hybrid)</ApplicationTitle>
    <ApplicationId>com.atomblazor.demo.maui</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- 解包形态（unpackaged），本机 Windows 直接可运行 exe，无需 MSIX 打包 -->
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 复用共享文档站：Routes/页面/布局 + 组件库 + 基元 + 图标包，与 Server/Wasm/Auto 宿主同一套内容 -->
    <ProjectReference Include="..\AtomBlazor.Demo.Shared\AtomBlazor.Demo.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0-rc.3.26522.148" />
  </ItemGroup>

</Project>
