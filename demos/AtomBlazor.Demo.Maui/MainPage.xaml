<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:web="clr-namespace:Microsoft.AspNetCore.Components.Web;assembly=Microsoft.AspNetCore.Components.Web"
    xmlns:shared="clr-namespace:AtomBlazor.Demo;assembly=AtomBlazor.Demo.Shared"
    x:Class="AtomBlazor.Demo.Maui.MainPage">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <!-- 复用共享文档站的 Router（扫描 Demo.Shared 程序集内全部 @page 路由） -->
            <RootComponent Selector="#app" ComponentType="{x:Type shared:Routes}" />
            <!-- 承载各页 PageTitle：HeadOutlet 挂到 <head> -->
            <RootComponent Selector="head::after" ComponentType="{x:Type web:HeadOutlet}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
