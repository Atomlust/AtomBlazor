<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AtomBlazor.Demo.Auto</RootNamespace>
    <AssemblyName>AtomBlazor.Demo.Auto</AssemblyName>
    <NoWarn>CS1591</NoWarn>
    <!-- 从宿主编译范围排除嵌套的客户端工程（对照源 Demo.Auto） -->
    <DefaultItemExcludes>$(DefaultItemExcludes);AtomBlazor.Demo.Auto.Client\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0-rc.3.26522.148" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AtomBlazor.Demo.Shared\AtomBlazor.Demo.Shared.csproj" />
    <ProjectReference Include="AtomBlazor.Demo.Auto.Client\AtomBlazor.Demo.Auto.Client.csproj" />
  </ItemGroup>

</Project>
