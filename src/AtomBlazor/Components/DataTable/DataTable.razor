@namespace AtomBlazor
@typeparam TData where TData : class
@inject ILocalizer Localizer

<CascadingValue Value="this" IsFixed="true">
    <div class="@ContainerCssClass" @attributes="AdditionalAttributes">
        @if (ShowToolbar)
        {
            <DataTableToolbar TData="TData"
                              GlobalSearchValue="@_globalSearchValue"
                              OnGlobalSearchChanged="HandleGlobalSearchChanged"
                              Columns="@_columns"
                              OnColumnVisibilityChanged="HandleColumnVisibilityChanged">
                @ToolbarActions
            </DataTableToolbar>
        }

        <div class="@TableContainerCssClass">
            @if (IsLoading)
            {
                @if (LoadingTemplate != null)
                {
                    @LoadingTemplate
                }
                else
                {
                    <div class="atom:flex atom:items-center atom:justify-center atom:p-8 atom:text-muted-foreground">
                        <div class="atom:text-sm">@Localizer["DataTable.Loading"]</div>
                    </div>
                }
            }
            else if (!_processedData.Any())
            {
                @if (EmptyTemplate != null)
                {
                    @EmptyTemplate
                }
                else
                {
                    <Empty Title="@Localizer["DataTable.NoResultsFound"]" Size="EmptySize.Small" />
                }
            }
            else
            {
                <AtomBlazor.Primitives.TablePrimitive TData="TData"
                                                 Data="@_processedData"
                                                 @bind-State="@_tableState"
                                                 SelectionMode="@GetPrimitiveSelectionMode()"
                                                 ManualPagination="true"
                                                 EnableKeyboardNavigation="@EnableKeyboardNavigation"
                                                 OnSortChange="HandleSortChange"
                                                 OnSelectionChange="HandleSelectionChange"
                                                 Class="@TableCssClass"
                                                 AriaLabel="@AriaLabel">
                    <AtomBlazor.Primitives.TableHeader>
                        <AtomBlazor.Primitives.TableRow TData="TData" Class="atom:border-b atom:transition-colors atom:hover:bg-muted/50 atom:data-[state=selected]:bg-muted">
                            @if (SelectionMode == DataTableSelectionMode.Multiple)
                            {
                                <AtomBlazor.Primitives.TableHeaderCell TData="TData" Class="atom:h-12 atom:px-4 atom:text-start atom:align-middle atom:font-medium atom:text-muted-foreground atom:w-12" role="columnheader">
                                    <div @onclick:stopPropagation="true">
                                        @if (ShouldShowSelectAllPrompt())
                                        {
                                            <DropdownMenu @bind-Open="_selectAllDropdownOpen">
                                                <AtomBlazor.DropdownMenuTrigger AsChild="false" Class="atom:inline-flex atom:items-center atom:justify-center atom:p-0 atom:bg-transparent atom:border-0 atom:hover:bg-transparent atom:focus:outline-none">
                                                    <Checkbox Checked="@IsAllSelected()"
                                                              Indeterminate="@IsSomeSelected()"
                                                              AriaLabel="@Localizer["DataTable.SelectRowsAriaLabel"]"
                                                              Class="atom:pointer-events-none" />
                                                </AtomBlazor.DropdownMenuTrigger>
                                                <AtomBlazor.DropdownMenuContent Side="PopoverSide.Bottom" Align="PopoverAlign.Start">
                                                    <AtomBlazor.DropdownMenuItem OnClick="@HandleSelectAllOnCurrentPage">
                                                        @Localizer["DataTable.SelectAllOnPage", _processedData.Count()]
                                                    </AtomBlazor.DropdownMenuItem>
                                                    <AtomBlazor.DropdownMenuItem OnClick="@HandleSelectAllItems">
                                                        @Localizer["DataTable.SelectAllItems", GetTotalFilteredItemCount()]
                                                    </AtomBlazor.DropdownMenuItem>
                                                    @if (_tableState.Selection.HasSelection)
                                                    {
                                                        <DropdownMenuSeparator />
                                                        <AtomBlazor.DropdownMenuItem OnClick="@HandleClearSelection">
                                                            @Localizer["DataTable.ClearSelection"]
                                                        </AtomBlazor.DropdownMenuItem>
                                                    }
                                                </AtomBlazor.DropdownMenuContent>
                                            </DropdownMenu>
                                        }
                                        else
                                        {
                                            <Checkbox Checked="@IsAllSelected()"
                                                      CheckedChanged="@(async (bool isChecked) => await HandleSelectAllChanged(isChecked))"
                                                      Indeterminate="@IsSomeSelected()"
                                                      AriaLabel="@Localizer["DataTable.SelectAllRows"]" />
                                        }
                                    </div>
                                </AtomBlazor.Primitives.TableHeaderCell>
                            }
                            @foreach (var column in _columns.Where(c => c.Visible))
                            {
                                var ariaSortValue = column.Sortable && _tableState.Sorting.SortedColumn == column.Id
                                    ? (_tableState.Sorting.Direction == SortDirection.Ascending ? "ascending" : "descending")
                                    : (column.Sortable ? "none" : null);

                                <AtomBlazor.Primitives.TableHeaderCell TData="TData" ColumnId="@(column.Sortable ? column.Id : null)"
                                                 Class="@ClassNames.cn("atom:h-12 atom:px-4 atom:text-start atom:align-middle atom:font-medium atom:text-muted-foreground", column.Sortable ? "atom:cursor-pointer atom:select-none" : "", column.HeaderClass)"
                                                 style="@GetColumnWidthStyle(column)"
                                                 aria-sort="@ariaSortValue">
                                    <div class="atom:flex atom:items-center atom:gap-2">
                                        <span>@column.Header</span>
                                        @if (column.Sortable && _tableState.Sorting.SortedColumn == column.Id)
                                        {
                                            @if (_tableState.Sorting.Direction == SortDirection.Ascending)
                                            {
                                                <svg class="atom:w-4 atom:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                                                </svg>
                                            }
                                            else if (_tableState.Sorting.Direction == SortDirection.Descending)
                                            {
                                                <svg class="atom:w-4 atom:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                                </svg>
                                            }
                                        }
                                        else if (column.Sortable)
                                        {
                                            <svg class="atom:w-4 atom:h-4 atom:opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" />
                                            </svg>
                                        }
                                    </div>
                                </AtomBlazor.Primitives.TableHeaderCell>
                            }
                        </AtomBlazor.Primitives.TableRow>
                    </AtomBlazor.Primitives.TableHeader>
                    <AtomBlazor.Primitives.TableBody>
                        @foreach (var item in _processedData)
                        {
                            var isSelected = _tableState.Selection.IsSelected(item);
                            <AtomBlazor.Primitives.TableRow TData="TData" Item="@item" Class="@ClassNames.cn("atom:border-b atom:transition-colors atom:hover:bg-muted/50 atom:data-[state=selected]:bg-muted", isSelected ? "atom:bg-muted" : "")">
                                @if (SelectionMode == DataTableSelectionMode.Multiple)
                                {
                                    <AtomBlazor.Primitives.TableCell Class="atom:p-4 atom:align-middle atom:w-12" role="gridcell">
                                        <div @onclick:stopPropagation="true">
                                            <Checkbox Checked="@isSelected"
                                                      CheckedChanged="@(async (bool isChecked) => await HandleRowSelectionChanged(item, isChecked))"
                                                      AriaLabel="@Localizer["DataTable.SelectThisRow"]" />
                                        </div>
                                    </AtomBlazor.Primitives.TableCell>
                                }
                                @foreach (var column in _columns.Where(c => c.Visible))
                                {
                                    <AtomBlazor.Primitives.TableCell Class="@ClassNames.cn("atom:p-4 atom:align-middle atom:[&:has([role=checkbox])]:pe-0", column.CellClass)">
                                        @if (column.CellTemplate != null)
                                        {
                                            @column.CellTemplate(item)
                                        }
                                        else if (column.Property != null)
                                        {
                                            var value = column.Property(item);
                                            @(value is IFormattable formattable && column.Format is not null ? formattable.ToString(column.Format, null) : value?.ToString() ?? "")
                                        }
                                    </AtomBlazor.Primitives.TableCell>
                                }
                            </AtomBlazor.Primitives.TableRow>
                        }
                    </AtomBlazor.Primitives.TableBody>
                </AtomBlazor.Primitives.TablePrimitive>
            }
        </div>

        @if (ShowPagination && !IsLoading && _processedData.Any())
        {
            <Pagination State="@_tableState.Pagination"
                        PageSizes="@PageSizes"
                        OnPageChanged="@HandlePageChanged"
                        OnPageSizeChanged="@HandlePageSizeChanged"
                        Class="atom:flex atom:items-center atom:justify-between atom:px-2 atom:py-4">
                <PaginationInfo />
                <PaginationContent Class="atom:flex atom:items-center atom:gap-6 atom:lg:gap-8">
                    <PaginationPageSizeSelector />
                    <div class="atom:flex atom:items-center atom:gap-2">
                        <PaginationPageDisplay />
                        <div class="atom:flex atom:items-center atom:gap-1">
                            <PaginationItem><PaginationFirst /></PaginationItem>
                            <PaginationItem><PaginationPrevious ShowText="false" /></PaginationItem>
                            <PaginationItem><PaginationNext ShowText="false" /></PaginationItem>
                            <PaginationItem><PaginationLast /></PaginationItem>
                        </div>
                    </div>
                </PaginationContent>
            </Pagination>
        }
    </div>

    @* Capture column definitions *@
    @Columns
</CascadingValue>
