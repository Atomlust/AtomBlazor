@namespace AtomBlazor

<div class="@RingClass" @attributes="AdditionalAttributes">
    <div class="@CssClass">
        @if (ChildContent != null)
        {
            <div class="@IconSizeClass atom:flex atom:items-center atom:justify-center">
                @ChildContent
            </div>
        }
        else
        {
            <div class="@IconSizeClass atom:rounded-full"></div>
        }
    </div>
</div>
