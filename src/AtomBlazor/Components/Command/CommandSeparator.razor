@namespace AtomBlazor
@implements IDisposable

<div class="@CssClass"
     style="@MergedSeparatorStyle"
     role="separator"
     aria-orientation="horizontal"
     @attributes="@InlineStyleMerge.WithoutStyle(AdditionalAttributes)">
</div>

@code {
    [CascadingParameter]
    public CommandContext? Context { get; set; }

    /// <summary>
    /// 获取或设置应用到分隔符的额外 CSS 类。
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// 获取或设置应用到根元素的额外 HTML 属性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string? MergedSeparatorStyle => InlineStyleMerge.Merge(_isVisible ? null : "display: none", AdditionalAttributes);

    private bool _isVisible = true;

    /// <summary>
    /// 获取分隔符计算后的 CSS 类。
    /// </summary>
    private string CssClass => ClassNames.cn(
        "atom:-mx-1 atom:h-px atom:bg-border",
        Class
    );

    protected override void OnInitialized()
    {
        if (Context != null)
        {
            Context.OnStateChanged += HandleContextStateChanged;
        }
    }

    private void HandleContextStateChanged()
    {
        if (Context == null) return;

        // 过滤期间没有可见项时隐藏分隔符
        _isVisible = Context.HasVisibleItems();
        StateHasChanged();
    }

    public void Dispose()
    {
        if (Context != null)
        {
            Context.OnStateChanged -= HandleContextStateChanged;
        }
    }
}
