@namespace AtomBlazor
@typeparam TItem
@inherits FormFieldBase

<FormFieldShell Orientation="@Orientation" IsInvalid="@IsInvalid" Class="@Class"
                Label="@Label" LabelFor="@ControlId" AssociateLabel
                HelperText="@HelperText" HelperTextId="@DescriptionId"
                ErrorText="@ErrorText" ErrorId="@ErrorId"
                HasEditContextErrors="@HasEditContextErrors" EditContextErrors="@EditContextErrors">
    <Control>
        <TreeSelect TItem="TItem"
                      Id="@ControlId"
                      Items="@Items"
                      ValueField="@ValueField"
                      TextField="@TextField"
                      ChildrenProperty="@ChildrenProperty"
                      Value="@Value"
                      ValueChanged="HandleValueChanged"
                      ValueExpression="@ValueExpression"
                      Values="@Values"
                      ValuesChanged="HandleValuesChanged"
                      ValuesExpression="@ValuesExpression"
                      Multiple="@Multiple"
                      LeafOnly="@LeafOnly"
                      ShowSearch="@ShowSearch"
                      Clearable="@Clearable"
                      Placeholder="@Placeholder"
                      Disabled="@Disabled"
                      Required="@Required"
                      Name="@Name"
                      AriaLabel="@AriaLabel"
                      AriaDescribedBy="@DescribedById"
                      Class="@InputClass"
                      @attributes="AdditionalAttributes" />
    </Control>
</FormFieldShell>
