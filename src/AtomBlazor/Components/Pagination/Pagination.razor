@namespace AtomBlazor
@inject ILocalizer Localizer

<CascadingValue Value="@_context" IsFixed="false">
    <nav role="navigation" aria-label="@Localizer["Pagination.Pagination"]" class="@CssClass" @attributes="AdditionalAttributes">
        @if (ChildContent != null)
        {
            @ChildContent
        }
        else if (TotalPages != null)
        {
            <PaginationContent>
                <PaginationItem>
                    <PaginationPrevious ShowText="false" />
                </PaginationItem>
                @foreach (var page in GetPageNumbers())
                {
                    if (page == -1)
                    {
                        <PaginationItem>
                            <PaginationEllipsis />
                        </PaginationItem>
                    }
                    else
                    {
                        var pageNum = page;
                        <PaginationItem>
                            <PaginationLink IsActive="@(pageNum == EffectiveCurrentPage)" OnClick="@(() => GoToPage(pageNum))">
                                @pageNum
                            </PaginationLink>
                        </PaginationItem>
                    }
                }
                <PaginationItem>
                    <PaginationNext ShowText="false" />
                </PaginationItem>
            </PaginationContent>
        }
    </nav>
</CascadingValue>

@code {
    private PaginationContext _context = new();
    private PaginationState? _internalState;

    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// 获取或设置应用到根元素的附加 HTML 属性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 用于自动状态管理的可选分页状态。
    /// 提供时，子组件会自动接入该状态完成接线。
    /// </summary>
    [Parameter]
    public PaginationState? State { get; set; }

    /// <summary>
    /// 简写参数：总页数。设置后且 ChildContent 为 null 时，
    /// 自动渲染标准的 上一页/页码/下一页 分页布局。
    /// </summary>
    [Parameter]
    public int? TotalPages { get; set; }

    /// <summary>
    /// 简写参数：当前页码（从 1 开始）。与 <see cref="TotalPages"/> 搭配使用。
    /// </summary>
    [Parameter]
    public int CurrentPage { get; set; } = 1;

    /// <summary>
    /// 用于 <see cref="CurrentPage"/> 双向绑定的事件回调。
    /// </summary>
    [Parameter]
    public EventCallback<int> CurrentPageChanged { get; set; }

    /// <summary>
    /// 页大小选择器可用的页大小选项。
    /// </summary>
    [Parameter]
    public int[] PageSizes { get; set; } = [10, 20, 50, 100];

    /// <summary>
    /// 当前页变化时调用的回调。
    /// </summary>
    [Parameter]
    public EventCallback<int> OnPageChanged { get; set; }

    /// <summary>
    /// 页大小变化时调用的回调。
    /// </summary>
    [Parameter]
    public EventCallback<int> OnPageSizeChanged { get; set; }

    private int EffectiveCurrentPage => State?.CurrentPage ?? CurrentPage;

    protected override void OnParametersSet()
    {
        if (TotalPages != null && State == null)
        {
            _internalState ??= new PaginationState();
            _internalState.TotalItems = TotalPages.Value;
            _internalState.PageSize = 1;
            _internalState.CurrentPage = CurrentPage;
            _context.State = _internalState;
        }
        else
        {
            _context.State = State;
        }

        _context.PageSizes = PageSizes;
        _context.OnPageChanged = async (page) =>
        {
            if (CurrentPageChanged.HasDelegate)
            {
                await CurrentPageChanged.InvokeAsync(page);
            }
            if (OnPageChanged.HasDelegate)
            {
                await OnPageChanged.InvokeAsync(page);
            }
        };
        _context.OnPageSizeChanged = async (size) =>
        {
            if (OnPageSizeChanged.HasDelegate)
            {
                await OnPageSizeChanged.InvokeAsync(size);
            }
        };
    }

    private async Task GoToPage(int page)
    {
        if (_context.State != null)
        {
            _context.State.GoToPage(page);
            if (_context.OnPageChanged != null)
            {
                await _context.OnPageChanged(page);
            }
        }
    }

    private List<int> GetPageNumbers()
    {
        var total = TotalPages ?? _context.State?.TotalPages ?? 0;
        var current = EffectiveCurrentPage;
        var pages = new List<int>();

        if (total <= 7)
        {
            for (var i = 1; i <= total; i++)
            {
                pages.Add(i);
            }
            return pages;
        }

        // 始终显示首页
        pages.Add(1);

        if (current > 3)
        {
            pages.Add(-1); // 省略号
        }

        // 当前页附近的页码
        var start = Math.Max(2, current - 1);
        var end = Math.Min(total - 1, current + 1);

        for (var i = start; i <= end; i++)
        {
            pages.Add(i);
        }

        if (current < total - 2)
        {
            pages.Add(-1); // 省略号
        }

        // 始终显示末页
        pages.Add(total);

        return pages;
    }

    private string CssClass => ClassNames.cn(
        "atom:mx-auto atom:flex atom:w-full atom:justify-center",
        Class
    );
}
