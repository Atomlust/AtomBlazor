@namespace AtomBlazor

<AtomBlazor.DropdownMenuItem Class="@Class" Disabled="@Disabled" OnClick="@OnClick" CloseOnSelect="@CloseOnSelect" @attributes="AdditionalAttributes">
    @ChildContent
</AtomBlazor.DropdownMenuItem>

@code {
    /// <summary>
    /// 获取或设置菜单项的内容。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 获取或设置应用于菜单项的附加 CSS 类。
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// 获取或设置应用于根元素的附加 HTML 属性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// 获取或设置菜单项是否禁用。
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// 获取或设置菜单项的点击回调。
    /// </summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>
    /// 获取或设置选择后是否关闭下拉菜单。
    /// </summary>
    [Parameter]
    public bool CloseOnSelect { get; set; } = true;
}
