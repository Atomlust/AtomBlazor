@namespace AtomBlazor
@using AtomBlazor.Icons.Lucide

<div class="@CssClass" role="group" @attributes="AdditionalAttributes">
    <Button Variant="@Variant"
            Size="@Size"
            Disabled="@Disabled"
            OnClick="@OnClick"
            Icon="@Icon"
            IconPosition="@IconPosition"
            Class="@PrimaryButtonClass"
            AriaLabel="@AriaLabel">
        @ChildContent
    </Button>
    <DropdownMenu>
        <AtomBlazor.DropdownMenuTrigger AsChild="true">
            <Button Variant="@Variant"
                    Size="@DropdownButtonSize"
                    Disabled="@Disabled"
                    Class="@DropdownButtonClass"
                    AriaLabel="@(DropdownAriaLabel ?? "More options")">
                <LucideIcon Name="chevron-down" Size="16" />
            </Button>
        </AtomBlazor.DropdownMenuTrigger>
        <AtomBlazor.DropdownMenuContent Align="@PopoverAlign.End">
            @DropdownContent
        </AtomBlazor.DropdownMenuContent>
    </DropdownMenu>
</div>

