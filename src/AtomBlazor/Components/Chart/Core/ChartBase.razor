@namespace AtomBlazor
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<CascadingValue Value="(ChartBase)this" IsFixed="true">
    <div id="@chartId"
         class="@ContainerCssClass"
         style="@MergedContainerStyle"
         data-slot="@DataSlot"
         @attributes="@InlineStyleMerge.WithoutStyle(AdditionalAttributes)">
        <div style="display:none">@ChildContent</div>
    </div>
</CascadingValue>
