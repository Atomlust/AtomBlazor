@namespace AtomBlazor

<AtomBlazor.Primitives.MenuSub Disabled="@Disabled">
    @ChildContent
</AtomBlazor.Primitives.MenuSub>

@code {
    /// <summary>子菜单的触发元素与内容。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>禁止打开子菜单。</summary>
    [Parameter] public bool Disabled { get; set; }
}
