@namespace AtomBlazor

<AtomBlazor.Primitives.MenubarCheckboxItemPrimitive
    Checked="@Checked"
    CheckedChanged="@CheckedChanged"
    Disabled="@Disabled"
    class="@CssClass"
    @attributes="AdditionalAttributes">
    <span class="atom:absolute atom:start-2 atom:flex atom:h-3.5 atom:w-3.5 atom:items-center atom:justify-center">
        @if (Checked)
        {
            <svg xmlns="http://www.w3.org/2000/svg"
                 width="16"
                 height="16"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 class="atom:h-4 atom:w-4">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
        }
    </span>
    @ChildContent
</AtomBlazor.Primitives.MenubarCheckboxItemPrimitive>

@code {
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// 获取或设置应用于根元素的额外 HTML 特性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Checked { get; set; }

    [Parameter]
    public EventCallback<bool> CheckedChanged { get; set; }

    private string CssClass => ClassNames.cn(
        "atom:relative atom:flex atom:cursor-default atom:select-none atom:items-center atom:rounded-sm atom:py-1.5 atom:ps-8 atom:pe-2 atom:text-sm atom:outline-none",
        "atom:focus:bg-(--atom-menu-accent) atom:focus:text-(--atom-menu-accent-foreground)",
        "atom:hover:bg-(--atom-menu-accent) atom:hover:text-(--atom-menu-accent-foreground)",
        Disabled ? "atom:pointer-events-none atom:opacity-50" : null,
        Class
    );
}
