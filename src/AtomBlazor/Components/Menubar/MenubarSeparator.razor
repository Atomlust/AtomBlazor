@namespace AtomBlazor

<AtomBlazor.Primitives.MenubarSeparatorPrimitive class="@CssClass" @attributes="AdditionalAttributes" />

@code {
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// 获取或设置应用于根元素的额外 HTML 特性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => ClassNames.cn(
        "atom:-mx-1 atom:my-1 atom:h-px atom:bg-muted",
        Class
    );
}
