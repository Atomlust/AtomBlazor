@namespace AtomBlazor
@implements IAsyncDisposable

@*
    ResponsiveNavProvider 组件，管理响应式导航状态。
    经 JS interop 处理移动端检测，并向子级级联上下文。
*@

<CascadingValue Value="@Context" IsFixed="false">
    @ChildContent
</CascadingValue>

@code {
    /// <summary>
    /// 要在 provider 内渲染的内容。
    /// 应包含 ResponsiveNavTrigger、NavigationMenu 与 ResponsiveNavContent。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
