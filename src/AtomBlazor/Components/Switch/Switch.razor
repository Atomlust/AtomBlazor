@namespace AtomBlazor

<AtomBlazor.Primitives.SwitchPrimitive Checked="@Checked"
                                        CheckedChanged="@HandleCheckedChanged"
                                        Disabled="@Disabled"
                                        Id="@Id"
                                        aria-label="@AriaLabel"
                                        aria-required="@(CheckedExpression != null ? "true" : null)"
                                        aria-invalid="@(IsInvalid ? "true" : null)"
                                        aria-describedby="@AriaDescribedBy"
                                        class="@CssClass"
                                        @attributes="AdditionalAttributes">
    <AtomBlazor.Primitives.SwitchThumb class="@ThumbCssClass">
        @if (ThumbContent is not null)
        {
            @ThumbContent(Checked)
        }
    </AtomBlazor.Primitives.SwitchThumb>
</AtomBlazor.Primitives.SwitchPrimitive>
