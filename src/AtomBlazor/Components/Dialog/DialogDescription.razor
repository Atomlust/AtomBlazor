@namespace AtomBlazor

@*
    带 shadcn/ui 样式的 DialogDescription 组件。
*@

<AtomBlazor.Primitives.DialogDescriptionPrimitive class="@CssClass" @attributes="AdditionalAttributes">
    @ChildContent
</AtomBlazor.Primitives.DialogDescriptionPrimitive>

@code {
    /// <summary>
    /// 要显示的描述内容。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 应用到描述上的附加 CSS 类。
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// 应用到描述元素的附加特性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => ClassNames.cn(
        "atom:text-sm atom:text-muted-foreground",
        Class
    );
}
