@namespace AtomBlazor

@*
    用于组织对话框标题与描述的 DialogHeader 辅助组件。
*@

<div class="@CssClass" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    /// <summary>
    /// 显示在对话框头部（通常为 DialogTitle 与 DialogDescription）的内容。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 应用到头部容器的附加 CSS 类。
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// 获取或设置应用到根元素的附加 HTML 特性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => ClassNames.cn(
        "atom:flex atom:flex-col atom:space-y-1.5 atom:text-center atom:sm:text-start",
        Class
    );
}
