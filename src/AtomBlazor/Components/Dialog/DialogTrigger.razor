@namespace AtomBlazor

@*
    带样式的 DialogTrigger 组件包装器。
    渲染用于打开对话框的触发按钮。
*@

@* 在 AsChild 模式下，原语不渲染任何元素，因此触发器自身的样式无处附着。
   只有页面所设置的内容会被向下传递，因此开发警告仅会指出该项，而别无其他。 *@
<AtomBlazor.Primitives.DialogTrigger AsChild="@AsChild"
    class="@(AsChild ? null : "atom:focus-visible:outline-none atom:focus-visible:ring-2 atom:focus-visible:ring-ring atom:focus-visible:ring-offset-2")"
    @attributes="AdditionalAttributes">
    @ChildContent
</AtomBlazor.Primitives.DialogTrigger>

@code {
    /// <summary>
    /// 显示在触发按钮内部的内容。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 为 true 时，触发器不渲染自身的按钮元素。
    /// 而是通过 TriggerContext 将触发行为传递给子组件。
    /// 当你希望某个自定义组件（如 Button）充当触发器时，可使用此项。
    /// </summary>
    [Parameter]
    public bool AsChild { get; set; } = true;

    /// <summary>
    /// 应用到触发按钮上的附加特性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
