<div class="atom:flex atom:flex-col atom:space-y-2 atom:text-center atom:sm:text-start" @attributes="AdditionalAttributes">
    <h2 id="@TitleId" class="atom:text-lg atom:leading-none atom:font-semibold atom:tracking-tight">
        @Title
    </h2>

    @if (!string.IsNullOrEmpty(Description))
    {
        <p id="@DescriptionId" class="atom:text-muted-foreground atom:text-sm">
            @Description
        </p>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? TitleId { get; set; }
    [Parameter] public string? DescriptionId { get; set; }

    /// <summary>
    /// 获取或设置应用到根元素的附加 HTML 特性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
