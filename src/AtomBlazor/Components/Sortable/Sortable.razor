@namespace AtomBlazor
@typeparam TItem
@inject ILocalizer Localizer

<AtomBlazor.Primitives.SortablePrimitive TItem="TItem"
                                                 Items="@Items"
                                                 ItemTemplate="@ItemTemplate"
                                                 DragOverlayTemplate="@DragOverlayTemplate"
                                                 OnUpdate="@OnUpdate"
                                                 OnRemove="@OnRemove"
                                                 OnAdd="@OnAdd"
                                                 Id="@Id"
                                                 Group="@Group"
                                                 Pull="@Pull"
                                                 Put="@Put"
                                                 Sort="@Sort"
                                                 KeyboardSorting="@KeyboardSorting"
                                                 KeyboardAnnouncements="@LocalizedKeyboardAnnouncements"
                                                 KeyboardInstructions="@(KeyboardInstructions ?? Localizer["Sortable.KeyboardInstructions"])"
                                                 MoveRejectedAnnouncement="@Localizer["Sortable.MoveRejected"]"
                                                 DropRejectedAnnouncement="@Localizer["Sortable.DropRejected"]"
                                                 MovedAnnouncement="@Localizer["Sortable.Moved"]"
                                                 RemovedAnnouncement="@Localizer["Sortable.Removed"]"
                                                 ReceivedAnnouncement="@Localizer["Sortable.Received"]"
                                                 CanMove="@CanMove"
                                                 CanDrop="@CanDrop"
                                                 Handle="@Handle"
                                                 Filter="@Filter"
                                                 ForceFallback="@ForceFallback"
                                                 AriaLabel="@AriaLabel"
                                                 class="@CssClass"
                                                 @attributes="AdditionalAttributes" />
