@namespace AtomBlazor
@using AtomBlazor.Icons.Lucide

<span aria-hidden="true" class="@ClassNames.cn("atom:inline-flex atom:shrink-0 atom:[&>svg]:size-3", Class)">
    @if (ChildContent is not null) { @ChildContent }
    else if (!string.IsNullOrEmpty(Name)) { <LucideIcon Name="@Name" Size="12" /> }
</span>

@code {
    /// <summary>可选的 Lucide 图标名称。</summary>
    [Parameter] public string? Name { get; set; }
    /// <summary>自定义装饰性图标内容；优先于 Name。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>额外的图标类。</summary>
    [Parameter] public string? Class { get; set; }
}
