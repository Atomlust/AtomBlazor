@namespace AtomBlazor
@using AtomBlazor.Icons.Lucide
@using Microsoft.AspNetCore.Components.Forms
@using System.Linq.Expressions

@* TimePicker 组件——按钮触发器加滚轮式时间选择浮层。
*@

<Popover @bind-Open="_isOpen">
    <AtomBlazor.PopoverTrigger AsChild="true">
        <Button AriaLabel="@AriaLabel" Variant="ButtonVariant.Outline"
                Class="@ButtonCssClass"
                Disabled="@Disabled"
                aria-required="@(Required ? "true" : null)"
                @attributes="AdditionalAttributes">
            <LucideIcon Name="clock" Class="atom:me-2 atom:h-4 atom:w-4" />
            @if (Value.HasValue)
            {
                <span>@FormatTime(Value.Value)</span>
            }
            else
            {
                <span class="atom:text-muted-foreground">@Placeholder</span>
            }
        </Button>
    </AtomBlazor.PopoverTrigger>
    <AtomBlazor.PopoverContent Class="atom:w-auto atom:p-4" Align="@PopoverAlign.Start">
        <div class="atom:flex atom:flex-col atom:gap-4">
            <div class="atom:flex atom:items-center atom:gap-2">
                <!-- 小时列 -->
                <div class="atom:flex atom:flex-col atom:items-center">
                    <span class="atom:text-xs atom:text-muted-foreground atom:mb-1">Hour</span>
                    <div class="atom:flex atom:flex-col atom:items-center atom:border atom:rounded-md">
                        <button type="button"
                                class="@ScrollButtonClass"
                                @onclick="IncrementHour"
                                disabled="@Disabled">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="atom:h-4 atom:w-4">
                                <path d="m18 15-6-6-6 6"/>
                            </svg>
                        </button>
                        <span class="atom:w-12 atom:h-10 atom:flex atom:items-center atom:justify-center atom:text-lg atom:font-medium atom:tabular-nums">
                            @DisplayHour.ToString("D2")
                        </span>
                        <button type="button"
                                class="@ScrollButtonClass"
                                @onclick="DecrementHour"
                                disabled="@Disabled">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="atom:h-4 atom:w-4">
                                <path d="m6 9 6 6 6-6"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <span class="atom:text-2xl atom:font-medium atom:mt-5">:</span>

                <!-- 分钟列 -->
                <div class="atom:flex atom:flex-col atom:items-center">
                    <span class="atom:text-xs atom:text-muted-foreground atom:mb-1">Min</span>
                    <div class="atom:flex atom:flex-col atom:items-center atom:border atom:rounded-md">
                        <button type="button"
                                class="@ScrollButtonClass"
                                @onclick="IncrementMinute"
                                disabled="@Disabled">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="atom:h-4 atom:w-4">
                                <path d="m18 15-6-6-6 6"/>
                            </svg>
                        </button>
                        <span class="atom:w-12 atom:h-10 atom:flex atom:items-center atom:justify-center atom:text-lg atom:font-medium atom:tabular-nums">
                            @CurrentMinute.ToString("D2")
                        </span>
                        <button type="button"
                                class="@ScrollButtonClass"
                                @onclick="DecrementMinute"
                                disabled="@Disabled">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="atom:h-4 atom:w-4">
                                <path d="m6 9 6 6 6-6"/>
                            </svg>
                        </button>
                    </div>
                </div>

                @if (ShowSeconds)
                {
                    <span class="atom:text-2xl atom:font-medium atom:mt-5">:</span>

                    <!-- 秒列 -->
                    <div class="atom:flex atom:flex-col atom:items-center">
                        <span class="atom:text-xs atom:text-muted-foreground atom:mb-1">Sec</span>
                        <div class="atom:flex atom:flex-col atom:items-center atom:border atom:rounded-md">
                            <button type="button"
                                    class="@ScrollButtonClass"
                                    @onclick="IncrementSecond"
                                    disabled="@Disabled">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="atom:h-4 atom:w-4">
                                    <path d="m18 15-6-6-6 6"/>
                                </svg>
                            </button>
                            <span class="atom:w-12 atom:h-10 atom:flex atom:items-center atom:justify-center atom:text-lg atom:font-medium atom:tabular-nums">
                                @CurrentSecond.ToString("D2")
                            </span>
                            <button type="button"
                                    class="@ScrollButtonClass"
                                    @onclick="DecrementSecond"
                                    disabled="@Disabled">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="atom:h-4 atom:w-4">
                                    <path d="m6 9 6 6 6-6"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                }

                @if (Format == TimeFormat.Hour12)
                {
                    <!-- AM/PM 切换 -->
                    <div class="atom:flex atom:flex-col atom:items-center atom:ms-2">
                        <span class="atom:text-xs atom:text-muted-foreground atom:mb-1">&nbsp;</span>
                        <div class="atom:flex atom:flex-col atom:border atom:rounded-md atom:overflow-hidden">
                            <button type="button"
                                    class="@GetAmPmButtonClass(true)"
                                    @onclick="() => SetAmPm(true)"
                                    disabled="@Disabled">
                                AM
                            </button>
                            <button type="button"
                                    class="@GetAmPmButtonClass(false)"
                                    @onclick="() => SetAmPm(false)"
                                    disabled="@Disabled">
                                PM
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- 操作按钮 -->
            <div class="atom:flex atom:justify-between atom:gap-2">
                <button type="button"
                        class="atom:flex-1 atom:inline-flex atom:items-center atom:justify-center atom:whitespace-nowrap atom:rounded-md atom:text-sm atom:font-medium atom:ring-offset-background atom:transition-colors atom:focus-visible:outline-none atom:focus-visible:ring-2 atom:focus-visible:ring-ring atom:focus-visible:ring-offset-2 atom:disabled:pointer-events-none atom:disabled:opacity-50 atom:border atom:border-input atom:bg-background atom:hover:bg-accent atom:hover:text-accent-foreground atom:h-8 atom:px-3"
                        disabled="@Disabled"
                        @onclick="SetNow">
                    Now
                </button>
                <button type="button"
                        class="atom:flex-1 atom:inline-flex atom:items-center atom:justify-center atom:whitespace-nowrap atom:rounded-md atom:text-sm atom:font-medium atom:ring-offset-background atom:transition-colors atom:focus-visible:outline-none atom:focus-visible:ring-2 atom:focus-visible:ring-ring atom:focus-visible:ring-offset-2 atom:disabled:pointer-events-none atom:disabled:opacity-50 atom:border atom:border-input atom:bg-background atom:hover:bg-accent atom:hover:text-accent-foreground atom:h-8 atom:px-3"
                        disabled="@(Disabled || !Value.HasValue)"
                        @onclick="Clear">
                    Clear
                </button>
            </div>
        </div>
    </AtomBlazor.PopoverContent>
</Popover>

@code {
    /// <summary>控件的无障碍名称。</summary>
    [Parameter] public string? AriaLabel { get; set; }


    private bool _isOpen;
    private int _internalHour = 12;
    private int _internalMinute = 0;
    private int _internalSecond = 0;
    private bool _isAm = true;
    private FieldIdentifier _fieldIdentifier;
    private EditContext? _editContext;

    // ShouldRender 跟踪字段
    private bool _parametersChanged;
    private TimeSpan? _lastValue;
    private bool _lastIsOpen;
    private bool _lastDisabled;

    protected override bool ShouldRender()
    {
        if (_parametersChanged)
        {
            _parametersChanged = false;
            _lastIsOpen = _isOpen;
            _lastValue = Value;
            _lastDisabled = Disabled;
            return true;
        }

        if (_isOpen != _lastIsOpen
            || Value != _lastValue
            || Disabled != _lastDisabled)
        {
            _lastIsOpen = _isOpen;
            _lastValue = Value;
            _lastDisabled = Disabled;
            return true;
        }

        return false;
    }

    [CascadingParameter]
    private EditContext? CascadedEditContext { get; set; }

    /// <summary>
    /// 选中的时间值。
    /// </summary>
    [Parameter]
    public TimeSpan? Value { get; set; }

    /// <summary>
    /// 选中时间变化时的回调。
    /// </summary>
    [Parameter]
    public EventCallback<TimeSpan?> ValueChanged { get; set; }

    /// <summary>
    /// 获取或设置标识绑定值的表达式。
    /// </summary>
    [Parameter]
    public Expression<Func<TimeSpan?>>? ValueExpression { get; set; }

    /// <summary>
    /// 时间格式（12 小时制或 24 小时制）。
    /// </summary>
    [Parameter]
    public TimeFormat Format { get; set; } = TimeFormat.Hour12;

    /// <summary>
    /// 是否显示秒选择列。
    /// </summary>
    [Parameter]
    public bool ShowSeconds { get; set; }

    /// <summary>
    /// 分钟步进间隔。
    /// </summary>
    [Parameter]
    public int MinuteStep { get; set; } = 1;

    /// <summary>
    /// 允许的最小时间。
    /// </summary>
    [Parameter]
    public TimeSpan? MinTime { get; set; }

    /// <summary>
    /// 允许的最大时间。
    /// </summary>
    [Parameter]
    public TimeSpan? MaxTime { get; set; }

    /// <summary>
    /// 未选择时间时显示的占位文本。
    /// </summary>
    [Parameter]
    public string Placeholder { get; set; } = "Select time";

    /// <summary>
    /// 时间选择器是否禁用。
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// 获取或设置时间选择器是否为必填。
    /// </summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>
    /// 触发按钮的附加 CSS 类。
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// 获取或设置应用到根元素的附加 HTML 属性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private int CurrentHour => Value?.Hours ?? _internalHour;
    private int CurrentMinute => Value?.Minutes ?? _internalMinute;
    private int CurrentSecond => Value?.Seconds ?? _internalSecond;

    private int DisplayHour
    {
        get
        {
            if (Format == TimeFormat.Hour24)
                return CurrentHour;

            var hour = CurrentHour % 12;
            return hour == 0 ? 12 : hour;
        }
    }

    private bool IsAm => CurrentHour < 12;

    protected override void OnParametersSet()
    {
        _parametersChanged = true;

        if (Value.HasValue)
        {
            _internalHour = Value.Value.Hours;
            _internalMinute = Value.Value.Minutes;
            _internalSecond = Value.Value.Seconds;
            _isAm = Value.Value.Hours < 12;
        }
        else
        {
            // 按格式设定合适的缺省值
            _internalHour = Format == TimeFormat.Hour24 ? 0 : 12;
            _internalMinute = 0;
            _internalSecond = 0;
            _isAm = true;
        }

        if (CascadedEditContext != null && ValueExpression != null)
        {
            _editContext = CascadedEditContext;
            _fieldIdentifier = FieldIdentifier.Create(ValueExpression);
        }
    }

    private void NotifyFieldChanged()
    {
        if (_editContext != null && ValueExpression != null && _fieldIdentifier.FieldName != null)
        {
            _editContext.NotifyFieldChanged(_fieldIdentifier);
        }
    }

    private string FormatTime(TimeSpan time)
    {
        if (Format == TimeFormat.Hour24)
        {
            // TimeSpan 用小写 'hh' 表示小时，而非 'HH'（那是 DateTime 的）
            return ShowSeconds
                ? time.ToString(@"hh\:mm\:ss")
                : time.ToString(@"hh\:mm");
        }
        else
        {
            var hour = time.Hours % 12;
            if (hour == 0) hour = 12;
            var amPm = time.Hours < 12 ? "AM" : "PM";

            return ShowSeconds
                ? $"{hour:D2}:{time.Minutes:D2}:{time.Seconds:D2} {amPm}"
                : $"{hour:D2}:{time.Minutes:D2} {amPm}";
        }
    }

    private async Task UpdateValue()
    {
        var newTime = new TimeSpan(_internalHour, _internalMinute, _internalSecond);

        // 施加边界约束
        if (MinTime.HasValue && newTime < MinTime.Value)
        {
            newTime = MinTime.Value;
        }
        if (MaxTime.HasValue && newTime > MaxTime.Value)
        {
            newTime = MaxTime.Value;
        }

        Value = newTime;
        await ValueChanged.InvokeAsync(newTime);
        NotifyFieldChanged();
        StateHasChanged();
    }

    private async Task IncrementHour()
    {
        if (Format == TimeFormat.Hour24)
        {
            _internalHour = (_internalHour + 1) % 24;
        }
        else
        {
            var hour12 = _internalHour % 12;
            hour12 = (hour12 + 1) % 12;
            _internalHour = _isAm ? hour12 : hour12 + 12;
            if (_internalHour == 12 && _isAm) _internalHour = 0;
            if (_internalHour == 0 && !_isAm) _internalHour = 12;
        }
        await UpdateValue();
    }

    private async Task DecrementHour()
    {
        if (Format == TimeFormat.Hour24)
        {
            _internalHour = (_internalHour - 1 + 24) % 24;
        }
        else
        {
            var hour12 = _internalHour % 12;
            hour12 = (hour12 - 1 + 12) % 12;
            _internalHour = _isAm ? hour12 : hour12 + 12;
            if (_internalHour == 12 && _isAm) _internalHour = 0;
            if (_internalHour == 0 && !_isAm) _internalHour = 12;
        }
        await UpdateValue();
    }

    private async Task IncrementMinute()
    {
        _internalMinute = (_internalMinute + MinuteStep) % 60;
        await UpdateValue();
    }

    private async Task DecrementMinute()
    {
        _internalMinute = (_internalMinute - MinuteStep + 60) % 60;
        await UpdateValue();
    }

    private async Task IncrementSecond()
    {
        _internalSecond = (_internalSecond + 1) % 60;
        await UpdateValue();
    }

    private async Task DecrementSecond()
    {
        _internalSecond = (_internalSecond - 1 + 60) % 60;
        await UpdateValue();
    }

    private async Task SetAmPm(bool isAm)
    {
        _isAm = isAm;
        if (isAm && _internalHour >= 12)
            _internalHour -= 12;
        else if (!isAm && _internalHour < 12)
            _internalHour += 12;

        await UpdateValue();
    }

    private async Task SetNow()
    {
        var now = DateTime.Now.TimeOfDay;
        _internalHour = now.Hours;
        _internalMinute = (now.Minutes / MinuteStep) * MinuteStep;
        _internalSecond = ShowSeconds ? now.Seconds : 0;
        _isAm = _internalHour < 12;
        await UpdateValue();
        // BL0012（.NET 11）：事件处理器末尾的重渲染由框架自动完成
        // 此处的显式 StateHasChanged 无需保留。
    }

    private async Task Clear()
    {
        Value = null;
        // 按格式重置为合适的缺省值
        _internalHour = Format == TimeFormat.Hour24 ? 0 : 12;
        _internalMinute = 0;
        _internalSecond = 0;
        _isAm = true;
        await ValueChanged.InvokeAsync(null);
        NotifyFieldChanged();
        // BL0012（.NET 11）：事件处理器末尾的重渲染由框架自动完成
        // 此处的显式 StateHasChanged 无需保留。
    }

    private string ButtonCssClass => ClassNames.cn(
        "atom:w-[180px] atom:justify-start atom:text-start atom:font-normal",
        !Value.HasValue ? "atom:text-muted-foreground" : null,
        Disabled ? "atom:opacity-50 atom:pointer-events-none" : null,
        Class
    );

    private static string ScrollButtonClass => ClassNames.cn(
        "atom:w-12 atom:h-8 atom:flex atom:items-center atom:justify-center",
        "atom:hover:bg-accent atom:hover:text-accent-foreground",
        "atom:transition-colors",
        "atom:disabled:opacity-50 atom:disabled:cursor-not-allowed"
    );

    private string GetAmPmButtonClass(bool isAm) => ClassNames.cn(
        "atom:w-12 atom:h-10 atom:text-sm atom:font-medium atom:transition-colors",
        (isAm == IsAm) ? "atom:bg-primary atom:text-primary-foreground" : "atom:hover:bg-accent atom:hover:text-accent-foreground",
        "atom:disabled:opacity-50 atom:disabled:cursor-not-allowed"
    );
}
