@typeparam TValue
@namespace AtomBlazor

<AtomBlazor.Primitives.RadioGroupPrimitive TValue="TValue"
                                                Value="@Value"
                                                ValueChanged="@HandleValueChanged"
                                                Disabled="@Disabled"
                                                Required="@Required"
                                                AriaLabel="@AriaLabel"
                                                class="@CssClass"
                                                aria-invalid="@(IsInvalid ? "true" : null)"
                                                aria-describedby="@AriaDescribedBy"
                                                @attributes="AdditionalAttributes">
    @ChildContent
</AtomBlazor.Primitives.RadioGroupPrimitive>
