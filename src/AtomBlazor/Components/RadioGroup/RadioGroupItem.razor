@typeparam TValue
@namespace AtomBlazor

@if (HasLabel)
{
    <div class="atom:flex atom:items-center atom:gap-2">
        <AtomBlazor.Primitives.RadioGroupItem TValue="TValue"
                                                            @ref="primitiveRef"
                                                            Value="@Value"
                                                            Disabled="@Disabled"
                                                            Id="@Id"
                                                            AriaLabel="@AriaLabel"
                                                            class="@CssClass"
                                                            @attributes="AdditionalAttributes">
            <span class="@CircleIndicatorClass"></span>
        </AtomBlazor.Primitives.RadioGroupItem>
        <label for="@Id" class="@LabelCssClass">@Label</label>
    </div>
}
else
{
    <AtomBlazor.Primitives.RadioGroupItem TValue="TValue"
                                                        @ref="primitiveRef"
                                                        Value="@Value"
                                                        Disabled="@Disabled"
                                                        Id="@Id"
                                                        AriaLabel="@AriaLabel"
                                                        class="@CssClass"
                                                        @attributes="AdditionalAttributes">
        <span class="@CircleIndicatorClass"></span>
    </AtomBlazor.Primitives.RadioGroupItem>
}
