@namespace AtomBlazor
@typeparam TData where TData : class
@attribute [CascadingTypeParameter(nameof(TData))]
@using AtomBlazor.Icons.Lucide
@using Microsoft.AspNetCore.Components.Forms
@inject ILocalizer Localizer

<CascadingValue Value="this" IsFixed="true">
    <div class="@ClassNames.cn("atom:w-full", Class)" @attributes="AdditionalAttributes">
        @if (ShowSearch || ShowExport || Toolbar != null)
        {
            <div class="atom:flex atom:items-center atom:justify-between atom:gap-2 atom:py-4">
                @if (ShowSearch)
                {
                    @* Input defaults to UpdateTiming.OnChange, which fires on blur or Enter only.
                       Left at the default the grid's search never saw a keystroke, so the documented
                       SearchDebounceMs delay could not start and the provider was only called once
                       the field lost focus (#543). Debounced is the right mode rather than Immediate:
                       the browser holds the keystrokes, so Blazor Server sends one message per pause
                       instead of one per key. *@
                    <Input Value="@(_searchInputValue ?? SearchText)"
                             ValueChanged="@HandleSearchInput"
                             UpdateTiming="UpdateTiming.Debounced"
                             DebounceInterval="@SearchDebounceMs"
                             Placeholder="@(SearchPlaceholder ?? Localizer["DataGrid.SearchPlaceholder"])"
                             Class="atom:max-w-sm" />
                }
                @if (ShowExport)
                {
                    @if (!ShowSearch)
                    {
                        @* Keeps the export button on the right when there is no search input on
                           the left for justify-between to push against. *@
                        <div></div>
                    }
                    <div class="atom:flex atom:items-center atom:gap-2">
                        @Toolbar
                        <Button Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Small"
                                  OnClick="@(async () => await ExportToCsvAsync())"
                                  AriaLabel="@Localizer["DataGrid.ExportAriaLabel"]">
                            <LucideIcon Name="download" Class="atom:w-4 atom:h-4 atom:me-2" />
                            @Localizer["DataGrid.Export"]
                        </Button>
                    </div>
                }
                else
                {
                    @* Left exactly as it was, so a grid that only supplies a Toolbar keeps its
                       existing layout. *@
                    @Toolbar
                }
            </div>
        }
        @if (EditMode == DataGridEditMode.Batch)
        {
            <div class="atom:flex atom:items-center atom:gap-2 atom:py-2" role="group" aria-label="@Localizer["DataGrid.BatchEditing"]">
                <Button Size="ButtonSize.Small" Disabled="@(savingEdits || PendingChanges.Count == 0)"
                          OnClick="@(async () => await CommitBatchAsync())">@Localizer["DataGrid.SaveChanges"]</Button>
                <Button Size="ButtonSize.Small" Variant="ButtonVariant.Outline" Disabled="@(savingEdits || PendingChanges.Count == 0)"
                          OnClick="CancelBatchAsync">@Localizer["DataGrid.DiscardChanges"]</Button>
                <span role="status">@Localizer["DataGrid.PendingRows", PendingChanges.Count]</span>
            </div>
        }
        @if (editError != null)
        {
            <p role="alert" class="atom:text-destructive atom:text-sm atom:py-2">@editError</p>
        }
        @if (ShowGroupingBreadcrumb && _gridState.Grouping.HasGroups)
        {
            @* Past two levels a per-column menu stops being a usable way to see or change the
               grouping, so the active levels are shown in order with their own controls. *@
            <div class="atom:flex atom:flex-wrap atom:items-center atom:gap-1 atom:pb-3 atom:text-sm" role="group"
                 aria-label="@Localizer["DataGrid.GroupingBreadcrumbLabel"]">
                <span class="atom:text-muted-foreground atom:me-1">@Localizer["DataGrid.GroupingBreadcrumbLabel"]</span>
                @for (var levelIndex = 0; levelIndex < _gridState.Grouping.ActiveGroups.Count; levelIndex++)
                {
                    var level = _gridState.Grouping.ActiveGroups[levelIndex];
                    var levelTitle = GetGroupLevelTitle(level.ColumnId);
                    var index = levelIndex;

                    <span class="atom:inline-flex atom:items-center atom:gap-1 atom:rounded-md atom:border atom:bg-muted/50 atom:px-2 atom:py-1">
                        @if (index > 0)
                        {
                            <button type="button"
                                    class="atom:inline-flex atom:items-center atom:justify-center atom:rounded atom:w-5 atom:h-5 atom:hover:bg-muted atom:transition-colors"
                                    aria-label="@Localizer["DataGrid.MoveGroupLevelOut", levelTitle]"
                                    @onclick="@(() => MoveGroupByColumnAsync(level.ColumnId, index - 1))">
                                <LucideIcon Name="chevron-left" Class="atom:w-3.5 atom:h-3.5" />
                            </button>
                        }
                        <span>@levelTitle</span>
                        <button type="button"
                                class="atom:inline-flex atom:items-center atom:justify-center atom:rounded atom:w-5 atom:h-5 atom:hover:bg-muted atom:transition-colors"
                                aria-label="@Localizer["DataGrid.RemoveGroupLevel", levelTitle]"
                                @onclick="@(() => RemoveGroupByColumnAsync(level.ColumnId))">
                            <LucideIcon Name="x" Class="atom:w-3.5 atom:h-3.5" />
                        </button>
                    </span>
                    @if (index < _gridState.Grouping.ActiveGroups.Count - 1)
                    {
                        <span class="atom:text-muted-foreground" aria-hidden="true">&#8250;</span>
                    }
                }
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                          Class="atom:ms-1 atom:h-7"
                          OnClick="ClearGroupingAsync">
                    @Localizer["DataGrid.ClearGrouping"]
                </Button>
            </div>
        }
        <div @ref="containerRef"
             class="@ClassNames.cn("atom:relative atom:w-full", Virtualize ? "" : "atom:overflow-auto", TableContainerClass)"
             style="@(IsVirtualizedProvider ? $"height: {VirtualScrollHeight}; overflow-y: auto;" : null)">
            @if (IsLoading)
            {
                @if (LoadingTemplate != null)
                {
                    @LoadingTemplate
                }
                else
                {
                    <div class="atom:flex atom:items-center atom:justify-center atom:p-8 atom:text-muted-foreground">
                        <div class="atom:text-sm">@Localizer["DataGrid.Loading"]</div>
                    </div>
                }
            }
            else if (!IsVirtualizedProvider && (_groupedRenderItems == null || !_groupedRenderItems.Any()) && !_processedData.Any() && !_gridState.Filtering.HasFilters)
            {
                @if (EmptyTemplate != null)
                {
                    @EmptyTemplate
                }
                else
                {
                    <Empty Title="@Localizer["DataGrid.NoResultsFound"]" Size="EmptySize.Small" />
                }
            }
            else
            {
                RefreshVisibleColumnsCache();
                <AtomBlazor.Primitives.DataGridPrimitive TData="TData"
                    Items="@_processedData"
                    @bind-State="@_gridState"
                    SelectionMode="@GetPrimitiveSelectionMode()"
                    SelectionBehavior="@SelectionBehavior"
                    IsRowEditing="@(EditMode != DataGridEditMode.None ? _isRowEditing : null)"
                    OnCommitEdit="@(EditMode != DataGridEditMode.None ? _commitEditFromRow : null)"
                    OnCancelEdit="@(EditMode != DataGridEditMode.None ? _cancelEditFromRow : null)"
                    ManualPagination="true"
                    EnableKeyboardNavigation="@EnableKeyboardNavigation"
                    OnSortChange="HandleSortChange"
                    OnSelectionChange="HandleSelectionChange"
                    OnRowClick="HandleRowClick"
                    OnToggleExpand="@(DetailTemplate != null || HasDetailRows ? EventCallback.Factory.Create<TData>(this, HandleRowExpandToggle) : default)"
                    OnRowContextMenu="@(RowContextMenu != null ? (EventCallback<(TData, double, double)>)EventCallback.Factory.Create<(TData, double, double)>(this, HandleRowContextMenu) : default)"
                    Class="@ClassNames.cn("atom:w-full atom:caption-bottom atom:text-sm", HasTableFixed() ? "atom:table-fixed" : "")"
                    AriaLabel="@AriaLabel">
                    @if (HasTableFixed())
                    {
                        <colgroup>
                            @foreach (var col in _cachedVisibleColumns)
                            {
                                <col data-column-id="@col.ColumnId" style="@GetColumnWidthStyle(col)" />
                            }
                        </colgroup>
                    }
                    <AtomBlazor.Primitives.DataGridHeader Class="@ClassNames.cn("atom:bg-background", StickyHeader ? "atom:sticky atom:top-0 atom:z-20" : "")">
                        @* Through cn() so the bare `group/row` marker ships too: the primitive
                           concatenates Class verbatim, and a consumer's `group-hover/row:*` resolves
                           against the unprefixed marker their own Tailwind build emits. *@
                        <AtomBlazor.Primitives.DataGridRow TData="TData" Class="@ClassNames.cn("atom:group/row atom:bg-background")">
                            @foreach (var column in _cachedVisibleColumns)
                            {
                                var sortDirection = _gridState.Sorting.GetDirection(column.ColumnId);
                                var sortPriority = _gridState.Sorting.GetPriority(column.ColumnId);
                                var isSelectColumn = column.ColumnId == "__select";
                                var isExpandColumn = column.ColumnId == "__expand";
                                var isHierarchyColumn = _hierarchyColumn != null && column.ColumnId == _hierarchyColumn.ColumnId;
                                var isLastLeft = column.ColumnId == _cachedLastLeftId;
                                var isFirstRight = column.ColumnId == _cachedFirstRightId;

                                <AtomBlazor.Primitives.DataGridHeaderCell TData="TData"
                                    @key="@column.ColumnId"
                                    ColumnId="@column.ColumnId"
                                    Sortable="@column.Sortable"
                                    Reorderable="@(Reorderable && column.Reorderable)"
                                    AriaLabel="@GetHeaderAriaLabel(column)"
                                    Class="@GetHeaderCellClass(column, isSelectColumn, isExpandColumn, isLastLeft, isFirstRight)"
                                    style="@GetColumnStyle(column, _cachedVisibleColumns)"
                                    data-pinned="@(column.Pinned != ColumnPinning.None ? "true" : null)">
                                    @if (isExpandColumn)
                                    {
                                        @* Empty spacer — no header control for expand column *@
                                    }
                                    else if (isSelectColumn)
                                    {
                                        <div @onclick:stopPropagation="true">
                                            @if (ShouldShowSelectAllPrompt())
                                            {
                                                <DropdownMenu @bind-Open="_selectAllDropdownOpen">
                                                    <AtomBlazor.DropdownMenuTrigger AsChild="false" Class="atom:inline-flex atom:items-center atom:justify-center atom:p-0 atom:bg-transparent atom:border-0 atom:hover:bg-transparent atom:focus:outline-none">
                                                        <Checkbox Checked="@IsAllSelected()"
                                                                  Indeterminate="@IsSomeSelected()"
                                                                  AriaLabel="@Localizer["DataGrid.SelectRowsAriaLabel"]"
                                                                  Class="atom:pointer-events-none" />
                                                    </AtomBlazor.DropdownMenuTrigger>
                                                    <AtomBlazor.DropdownMenuContent Side="PopoverSide.Bottom" Align="PopoverAlign.Start">
                                                        <AtomBlazor.DropdownMenuItem OnClick="@HandleSelectOnlyCurrentPage">
                                                            @Localizer["DataGrid.SelectAllOnPage", _processedData.Count()]
                                                        </AtomBlazor.DropdownMenuItem>
                                                        <AtomBlazor.DropdownMenuItem OnClick="@HandleSelectAllItems">
                                                            @Localizer["DataGrid.SelectAllItems", _gridState.Pagination.TotalItems]
                                                        </AtomBlazor.DropdownMenuItem>
                                                        @if (_gridState.Selection.HasSelection)
                                                        {
                                                            <DropdownMenuSeparator />
                                                            <AtomBlazor.DropdownMenuItem OnClick="@HandleClearSelection">
                                                                @Localizer["DataGrid.ClearSelection"]
                                                            </AtomBlazor.DropdownMenuItem>
                                                        }
                                                    </AtomBlazor.DropdownMenuContent>
                                                </DropdownMenu>
                                            }
                                            else
                                            {
                                                <Checkbox Checked="@IsAllSelected()"
                                                          CheckedChanged="@HandleSelectAllChanged"
                                                          Indeterminate="@IsSomeSelected()"
                                                          AriaLabel="@Localizer["DataGrid.SelectAllRows"]" />
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        @if (Reorderable && column.Reorderable)
                                        {
                                            <LucideIcon Name="grip-vertical" Class="atom:absolute atom:start-1 atom:top-1/2 atom:-translate-y-1/2 atom:w-3 atom:h-3 atom:text-muted-foreground/40 atom:opacity-0 atom:group-hover/header:opacity-100 atom:transition-opacity atom:pointer-events-none" />
                                        }
                                        <div class="atom:flex atom:items-center atom:gap-2">
                                            @if (ShowExpandAll && isHierarchyColumn)
                                            {
                                                <button type="button"
                                                        class="atom:inline-flex atom:items-center atom:justify-center atom:rounded-md atom:w-6 atom:h-6 atom:hover:bg-muted atom:transition-colors atom:shrink-0"
                                                        aria-label="@(IsAllExpanded ? Localizer["DataGrid.CollapseAll"] : Localizer["DataGrid.ExpandAll"])"
                                                        @onclick="@ToggleExpandAllAsync"
                                                        @onclick:stopPropagation="true">
                                                    <LucideIcon Name="@(IsAllExpanded ? "chevrons-down-up" : "chevrons-up-down")"
                                                               Class="atom:w-4 atom:h-4 atom:text-muted-foreground" />
                                                </button>
                                            }
                                            @if (column.HeaderTemplate != null)
                                            {
                                                @column.HeaderTemplate(new AtomBlazor.Primitives.DataGridHeaderContext<TData>
                                                {
                                                    Column = column,
                                                    State = _gridState
                                                })
                                            }
                                            else
                                            {
                                                <span>@column.Title</span>
                                            }
                                            @if (column.Pinned != ColumnPinning.None)
                                            {
                                                <Tooltip>
                                                    <AtomBlazor.TooltipTrigger AsChild="false" Focusable="false" Class="atom:inline-flex atom:items-center">
                                                        <LucideIcon Name="pin" Class="atom:w-3.5 atom:h-3.5 atom:text-muted-foreground" />
                                                    </AtomBlazor.TooltipTrigger>
                                                    <AtomBlazor.TooltipContent Side="PopoverSide.Bottom">
                                                        @Localizer["DataGrid.PinnedColumnTooltip"]
                                                    </AtomBlazor.TooltipContent>
                                                </Tooltip>
                                            }
                                            @if (column.Sortable && sortDirection != SortDirection.None)
                                            {
                                                @if (sortDirection == SortDirection.Ascending)
                                                {
                                                    <LucideIcon Name="arrow-up" Class="atom:w-4 atom:h-4" />
                                                }
                                                else
                                                {
                                                    <LucideIcon Name="arrow-down" Class="atom:w-4 atom:h-4" />
                                                }
                                                @if (_gridState.Sorting.Definitions.Count > 1)
                                                {
                                                    <span class="atom:text-xs atom:text-muted-foreground atom:tabular-nums">@sortPriority</span>
                                                }
                                            }
                                            else if (column.Sortable)
                                            {
                                                <LucideIcon Name="arrow-up-down" Class="atom:w-4 atom:h-4 atom:opacity-0 atom:group-hover/header:opacity-50 atom:transition-opacity" />
                                            }
                                            @if (column.Filterable)
                                            {
                                                var hasActiveFilter = _gridState.Filtering.HasFilter(column.ColumnId);
                                                var filterColumn = column;
                                                <div @onclick:stopPropagation="true" class="atom:inline-flex">
                                                    <Popover Open="@(GetFilterPopoverOpen(filterColumn.ColumnId))"
                                                               OpenChanged="@(open => SetFilterPopoverOpen(filterColumn.ColumnId, open))">
                                                        <AtomBlazor.PopoverTrigger AsChild="true">
                                                            <Button Variant="ButtonVariant.Ghost"
                                                                      Size="ButtonSize.Icon"
                                                                      Class="@ClassNames.cn("atom:w-7 atom:h-7 atom:transition-colors",
                                                                          hasActiveFilter ? "atom:text-primary" : "atom:text-muted-foreground atom:opacity-0 atom:group-hover/header:opacity-100")"
                                                                      AriaLabel="@Localizer["DataGrid.FilterColumn", filterColumn.Title ?? filterColumn.ColumnId]">
                                                                <LucideIcon Name="filter" Class="atom:w-3.5 atom:h-3.5" />
                                                            </Button>
                                                        </AtomBlazor.PopoverTrigger>
                                                        <AtomBlazor.PopoverContent Side="PopoverSide.Bottom" Align="PopoverAlign.Start" Class="atom:w-72 atom:p-0">
                                                            @{
                                                                var filterField = GetFilterFieldForColumn(filterColumn);
                                                                if (filterField != null)
                                                                {
                                                                    var filterableCol = filterColumn as IFilterableColumn;
                                                                    <DataGridColumnFilter
                                                                        ColumnTitle="@filterColumn.Title"
                                                                        FieldType="@filterField.Type"
                                                                        FieldName="@filterField.Name"
                                                                        FilterOptions="@filterableCol?.GetFilterOptions()"
                                                                        CurrentFilter="@_gridState.Filtering.GetFilter(filterColumn.ColumnId)"
                                                                        OnApply="@(condition => HandleColumnFilterChanged(filterColumn.ColumnId, condition))"
                                                                        OnClear="@(() => HandleColumnFilterChanged(filterColumn.ColumnId, null))" />
                                                                }
                                                            }
                                                        </AtomBlazor.PopoverContent>
                                                    </Popover>
                                                </div>
                                            }
                                            @if (CanGroupColumn(column))
                                            {
                                                var menuColumn = column;
                                                var isGroupedByColumn = IsGroupedBy(menuColumn.ColumnId);
                                                <div @onclick:stopPropagation="true" class="atom:inline-flex">
                                                    <DropdownMenu Open="@(GetHeaderMenuOpen(menuColumn.ColumnId))"
                                                                    OpenChanged="@(open => SetHeaderMenuOpen(menuColumn.ColumnId, open))">
                                                        <AtomBlazor.DropdownMenuTrigger AsChild="true">
                                                            <Button Variant="ButtonVariant.Ghost"
                                                                      Size="ButtonSize.Icon"
                                                                      Class="@ClassNames.cn("atom:w-7 atom:h-7 atom:transition-colors",
                                                                          isGroupedByColumn ? "atom:text-primary" : "atom:text-muted-foreground atom:opacity-0 atom:group-hover/header:opacity-100")"
                                                                      AriaLabel="@Localizer["DataGrid.ColumnMenu", menuColumn.Title ?? string.Empty]">
                                                                <LucideIcon Name="ellipsis" Class="atom:w-3.5 atom:h-3.5" />
                                                            </Button>
                                                        </AtomBlazor.DropdownMenuTrigger>
                                                        <AtomBlazor.DropdownMenuContent Side="PopoverSide.Bottom" Align="PopoverAlign.End">
                                                            @if (isGroupedByColumn)
                                                            {
                                                                <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleUngroupColumnAsync(menuColumn.ColumnId))">
                                                                    <LucideIcon Name="ungroup" Class="atom:w-4 atom:h-4 atom:me-2" />
                                                                    @Localizer["DataGrid.UngroupColumn"]
                                                                </AtomBlazor.DropdownMenuItem>
                                                            }
                                                            else
                                                            {
                                                                <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleGroupByColumnAsync(menuColumn.ColumnId))">
                                                                    <LucideIcon Name="group" Class="atom:w-4 atom:h-4 atom:me-2" />
                                                                    @Localizer["DataGrid.GroupByColumn", menuColumn.Title ?? string.Empty]
                                                                </AtomBlazor.DropdownMenuItem>
                                                                @if (_gridState.Grouping.HasGroups)
                                                                {
                                                                    @* Only offered once something is already grouped, so a first-time
                                                                       user is not asked to choose between two actions that do the same
                                                                       thing. *@
                                                                    <AtomBlazor.DropdownMenuItem OnClick="@(() => HandleAddGroupColumnAsync(menuColumn.ColumnId))">
                                                                        <LucideIcon Name="list-tree" Class="atom:w-4 atom:h-4 atom:me-2" />
                                                                        @Localizer["DataGrid.AddGroupByColumn", menuColumn.Title ?? string.Empty]
                                                                    </AtomBlazor.DropdownMenuItem>
                                                                }
                                                            }
                                                        </AtomBlazor.DropdownMenuContent>
                                                    </DropdownMenu>
                                                </div>
                                            }
                                        </div>
                                        @if (Resizable && column.Resizable)
                                        {
                                            <div class="atom:absolute atom:end-0 atom:top-0 atom:bottom-0 atom:w-2 atom:cursor-col-resize atom:hover:bg-primary/20 atom:active:bg-primary/40"
                                                 data-resize-handle="@column.ColumnId"></div>
                                        }
                                    }
                                </AtomBlazor.Primitives.DataGridHeaderCell>
                            }
                        </AtomBlazor.Primitives.DataGridRow>
                    </AtomBlazor.Primitives.DataGridHeader>
                    <AtomBlazor.Primitives.DataGridBody Class="atom:bg-background">
                        @if (ShowFilterBar && _gridState.Filtering.HasFilters)
                        {
                            <tr class="@ClassNames.cn("atom:border-b atom:bg-muted/30", FilterBarClass)">
                                <td colspan="@_cachedVisibleColumns.Count" class="atom:px-4 atom:py-1.5">
                                    <div class="atom:flex atom:items-center atom:gap-2 atom:text-xs atom:text-muted-foreground">
                                        <LucideIcon Name="filter" Class="atom:w-3.5 atom:h-3.5" />
                                        <span>@Localizer["DataGrid.ActiveFilters", _gridState.Filtering.ActiveFilterCount]</span>
                                        <button type="button"
                                                class="atom:inline-flex atom:items-center atom:gap-1 atom:rounded atom:px-1.5 atom:py-0.5 atom:text-xs atom:font-medium atom:hover:bg-muted atom:transition-colors"
                                                @onclick="ClearAllFiltersAsync"
                                                @onclick:stopPropagation="true">
                                            <LucideIcon Name="x" Class="atom:w-3 atom:h-3" />
                                            @Localizer["DataGrid.ClearAll"]
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!_processedData.Any() && _gridState.Filtering.HasFilters)
                        {
                            <tr>
                                <td colspan="@_cachedVisibleColumns.Count" class="atom:py-8 atom:text-center">
                                    <Empty Title="@Localizer["DataGrid.NoResultsFound"]" Description="@Localizer["DataGrid.NoResultsFilterDescription"]" Size="EmptySize.Small" />
                                </td>
                            </tr>
                        }
                        else if (_groupedRenderItems != null)
                        {
                            if (Virtualize && _groupedRenderItemsList != null)
                            {
                                <Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize Items="@_groupedRenderItemsList" Context="renderItem" ItemSize="@ItemSize" OverscanCount="@OverscanCount" InitialItemIndex="@InitialItemIndex">
                                    @RenderGroupedOrHierarchyItem(renderItem)
                                </Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize>
                            }
                            else
                            {
                                @foreach (var renderItem in _groupedRenderItems)
                                {
                                    @RenderGroupedOrHierarchyItem(renderItem)
                                }
                            }
                        }
                        else if (IsVirtualizedProvider)
                        {
                            <Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize @ref="_virtualizeRef"
                                ItemsProvider="@VirtualItemsProviderAsync" Context="item"
                                ItemSize="@ItemSize" OverscanCount="@OverscanCount"
                                InitialItemIndex="@InitialItemIndex"
                                ItemComparer="@EffectiveItemComparer">
                                @RenderDataRow(item)
                            </Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize>
                        }
                        else if (Virtualize)
                        {
                            <Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize @ref="_virtualizeRef" Items="@_processedDataList" Context="item" ItemSize="@ItemSize" OverscanCount="@OverscanCount" InitialItemIndex="@InitialItemIndex">
                                @RenderDataRow(item)
                            </Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize>
                        }
                        else
                        {
                            @foreach (var item in _processedData)
                            {
                                @RenderDataRow(item)
                                @if (_gridState.Expanded.IsExpanded(item))
                                {
                                    @if (HasDetailRows)
                                    {
                                        @ExpandColumnDetailRows!(item)
                                    }
                                    @if (DetailTemplate != null)
                                    {
                                        <tr class="atom:border-b">
                                            <td colspan="@_cachedVisibleColumns.Count" class="atom:p-4">
                                                @DetailTemplate(item)
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        }
                    </AtomBlazor.Primitives.DataGridBody>
                </AtomBlazor.Primitives.DataGridPrimitive>
            }
        </div>

        @if (RowContextMenu != null)
        {
            <ContextMenu @ref="rowContextMenu">
                <AtomBlazor.ContextMenuContent>
                    @if (contextMenuItem != null)
                    {
                        @RowContextMenu(new DataGridRowMenuContext<TData>
                        {
                            Item = contextMenuItem,
                            SelectedItems = _gridState.Selection.SelectedItems,
                            VisibleColumns = GetVisibleDataColumns(),
                            CopyToClipboardAsync = CopyToClipboardAsync
                        })
                    }
                </AtomBlazor.ContextMenuContent>
            </ContextMenu>
        }

        @if (ShowPagination && !IsLoading && !IsVirtualizedProvider && _processedData.Any())
        {
            <Pagination State="@_gridState.Pagination"
                        PageSizes="@PageSizes"
                        OnPageChanged="@HandlePageChanged"
                        OnPageSizeChanged="@HandlePageSizeChanged"
                        Class="atom:flex atom:items-center atom:justify-between atom:px-2 atom:py-4">
                <PaginationInfo>
                    @if (_gridState.Selection.HasSelection)
                    {
                        <span>@Localizer["DataGrid.RowsSelected", _gridState.Selection.SelectedCount, _gridState.Pagination.TotalItems]</span>
                    }
                </PaginationInfo>
                <PaginationContent Class="atom:flex atom:items-center atom:gap-6 atom:lg:gap-8">
                    <div class="atom:hidden atom:sm:flex"><PaginationPageSizeSelector /></div>
                    <div class="atom:flex atom:items-center atom:gap-2">
                        <div class="atom:hidden atom:lg:flex"><PaginationPageDisplay /></div>
                        <div class="atom:flex atom:items-center atom:gap-1">
                            <div class="atom:hidden atom:sm:flex"><PaginationItem><PaginationFirst /></PaginationItem></div>
                            <PaginationItem><PaginationPrevious ShowText="false" /></PaginationItem>
                            <PaginationItem><PaginationNext ShowText="false" /></PaginationItem>
                            <div class="atom:hidden atom:sm:flex"><PaginationItem><PaginationLast /></PaginationItem></div>
                        </div>
                    </div>
                </PaginationContent>
            </Pagination>
        }
    </div>

    @* Capture column definitions from child components *@
    @Columns
</CascadingValue>

@code {
    private string FormatAggregateName(AggregateFunction function) => function switch
    {
        AggregateFunction.Count => Localizer["DataGrid.CountLabel"],
        AggregateFunction.Sum => Localizer["DataGrid.SumLabel"],
        AggregateFunction.Average => Localizer["DataGrid.AverageLabel"],
        AggregateFunction.Min => Localizer["DataGrid.MinLabel"],
        AggregateFunction.Max => Localizer["DataGrid.MaxLabel"],
        _ => ""
    };

    private static string FormatAggregateValue(object? value, string? format)
    {
        if (value == null)
        {
            return "-";
        }

        if (!string.IsNullOrEmpty(format) && value is IFormattable formattable)
        {
            return formattable.ToString(format, System.Globalization.CultureInfo.CurrentCulture);
        }

        if (value is double d)
        {
            // Use integer format when the value has no fractional part
            return d == Math.Truncate(d)
                ? d.ToString("N0", System.Globalization.CultureInfo.CurrentCulture)
                : d.ToString("N2", System.Globalization.CultureInfo.CurrentCulture);
        }

        return value.ToString() ?? "-";
    }

    private RenderFragment<TData> RenderDataRow => item =>
        @<AtomBlazor.Primitives.DataGridRow TData="TData" Item="@item"
            Class="@ClassNames.cn("atom:group/row atom:bg-background", Striped ? StripeClass : null, RowClass?.Invoke(item), IsEditing(item) ? "atom:bg-muted/40" : null)">
            @{
                var rowIsEditing = IsEditing(item);
            }
            @if (rowIsEditing && !UsesEditBuffer && _editContext != null)
            {
                @* Cascaded rather than wrapped in an EditForm: a form element is not valid inside
                   a table row, but the validator only needs the context. *@
                <CascadingValue Value="_editContext" IsFixed="false">
                    <DataAnnotationsValidator />
                </CascadingValue>
            }
            @foreach (var column in _cachedVisibleColumns)
            {
                var isSelectColumn = column.ColumnId == "__select";
                var isExpandColumn = column.ColumnId == "__expand";
                var isEditColumn = column.ColumnId == "__edit";
                var isLastLeft = column.ColumnId == _cachedLastLeftId;
                var isFirstRight = column.ColumnId == _cachedFirstRightId;
                var pinnedStyle = GetPinnedStyle(column, _cachedVisibleColumns);

                <AtomBlazor.Primitives.DataGridCell
                    @key="@column.ColumnId"
                    Class="@GetCellClass(column, isSelectColumn, isExpandColumn, isLastLeft, isFirstRight, item)"
                    style="@pinnedStyle"
                    data-pinned="@(column.Pinned != ColumnPinning.None ? "true" : null)">
                    @if (isEditColumn)
                    {
                        <div @onclick:stopPropagation="true" class="atom:flex atom:items-center atom:gap-1">
                            @if (rowIsEditing)
                            {
                                <Button Variant="ButtonVariant.Default" Size="ButtonSize.Small"
                                          OnClick="@(async () => await CommitEditAsync())"
                                          AriaLabel="@Localizer["DataGrid.SaveRow"]">
                                    @Localizer["DataGrid.SaveRow"]
                                </Button>
                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                                          OnClick="CancelEditAsync"
                                          AriaLabel="@Localizer["DataGrid.CancelRowEdit"]">
                                    @Localizer["DataGrid.CancelRowEdit"]
                                </Button>
                            }
                            else
                            {
                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                                          OnClick="@(async () => await StartEditAsync(item))"
                                          AriaLabel="@Localizer["DataGrid.EditRow"]">
                                    <LucideIcon Name="pencil" Class="atom:w-4 atom:h-4" />
                                </Button>
                            }
                        </div>
                    }
                    else if (ShouldRenderEditor(column, item))
                    {
                        @RenderEditableCell(column, item)
                    }
                    else if (isExpandColumn)
                    {
                        @if (DetailTemplate != null || HasDetailRows)
                        {
                            var isExpanded = _gridState.Expanded.IsExpanded(item);
                            <button type="button"
                                    class="atom:inline-flex atom:items-center atom:justify-center atom:rounded-md atom:w-8 atom:h-8 atom:hover:bg-muted atom:transition-colors"
                                    aria-expanded="@isExpanded.ToString().ToLowerInvariant()"
                                    aria-label="@(isExpanded ? Localizer["DataGrid.CollapseRow"] : Localizer["DataGrid.ExpandRow"])"
                                    @onclick="@(() => HandleRowExpandToggle(item))"
                                    @onclick:stopPropagation="true">
                                <LucideIcon Name="@(isExpanded ? "chevron-down" : "chevron-right")" Class="atom:w-4 atom:h-4" />
                            </button>
                        }
                    }
                    else if (isSelectColumn)
                    {
                        <div @onclick:stopPropagation="true">
                            <Checkbox Checked="@_gridState.Selection.IsSelected(item)"
                                      CheckedChanged="@((bool isChecked) => HandleRowSelectionChanged(item, isChecked))"
                                      AriaLabel="@Localizer["DataGrid.SelectThisRow"]" />
                        </div>
                    }
                    else
                    {
                        @RenderCellValue(column, item)
                    }
                </AtomBlazor.Primitives.DataGridCell>
            }
        </AtomBlazor.Primitives.DataGridRow>;

    private RenderFragment<DataGridRenderItem<TData>> RenderGroupedOrHierarchyItem => renderItem =>
    {
        if (renderItem.IsGroupHeader)
        {
            var group = renderItem.GroupRow!;
            var groupKey = group.Key ?? "(empty)";
            var isCollapsed = _gridState.Grouping.IsCollapsed(group.Path);
            var groupIndent = group.Depth * GetGroupIndentSize();
            var effectiveTemplate = _groupColumnHeaderTemplate ?? GroupHeaderTemplate;
            var groupContext = new DataGridGroupContext<TData>
            {
                Group = group,
                IsCollapsed = isCollapsed,
                VisibleColumnCount = _cachedVisibleColumns.Count,
                ToggleCollapse = EventCallback.Factory.Create(this, () => HandleGroupToggle(group))
            };

            if (effectiveTemplate != null)
            {
                return @<tr role="row" class="atom:bg-muted/50 atom:border-b atom:font-medium">
                    <td role="gridcell" colspan="@_cachedVisibleColumns.Count" class="atom:px-4 atom:py-2"
                        style="@(groupIndent > 0 ? $"padding-left: {groupIndent + 16}px;" : null)">
                        @effectiveTemplate(groupContext)
                    </td>
                </tr>;
            }
            else
            {
                var groupLabelColSpan = GetGroupLabelColSpan(group);
                return @<tr role="row" class="atom:bg-muted/50 atom:border-b atom:font-medium">
                    <td role="gridcell" colspan="@groupLabelColSpan" class="atom:px-4 atom:py-2">
                        <div class="atom:flex atom:items-center atom:gap-2" style="@(groupIndent > 0 ? $"padding-left: {groupIndent}px;" : null)">
                            <button type="button"
                                    class="atom:inline-flex atom:items-center atom:justify-center atom:rounded-md atom:w-6 atom:h-6 atom:hover:bg-muted atom:transition-colors"
                                    aria-expanded="@(isCollapsed ? "false" : "true")"
                                    aria-label="@(isCollapsed ? Localizer["DataGrid.ExpandGroup"] : Localizer["DataGrid.CollapseGroup"])"
                                    @onclick="groupContext.ToggleCollapse"
                                    @onclick:stopPropagation="true">
                                <LucideIcon Name="@(isCollapsed ? "chevron-right" : "chevron-down")" Class="atom:w-4 atom:h-4" />
                            </button>
                            <span>@group.ColumnTitle: @(groupKey.ToString())</span>
                            <span class="atom:text-muted-foreground atom:text-sm">@Localizer["DataGrid.GroupItemCount", group.ItemCount]</span>
                        </div>
                    </td>
                    @foreach (var col in GetGroupAggregateColumns(group))
                    {
                        <td role="gridcell" class="atom:px-4 atom:py-2 atom:text-muted-foreground atom:text-sm">
                            @if (group.Aggregates.TryGetValue(col.ColumnId, out var agg))
                            {
                                <span>@FormatAggregateName(agg.Function): @FormatAggregateValue(agg.Value, agg.Format)</span>
                            }
                        </td>
                    }
                </tr>;
            }
        }
        else if (renderItem.IsChildPagerRow)
        {
            var pagerDepth = renderItem.Depth;
            var pagerParentValue = renderItem.ParentValue!;
            var pagerPageIndex = renderItem.ChildPageIndex;
            var pagerTotalChildren = renderItem.TotalChildren;
            var pagerPageSize = ChildPageSize ?? 10;
            var pagerStart = pagerPageIndex * pagerPageSize + 1;
            var pagerEnd = Math.Min((pagerPageIndex + 1) * pagerPageSize, pagerTotalChildren);
            var pagerTotalPages = (int)Math.Ceiling((double)pagerTotalChildren / pagerPageSize);
            var pagerIndent = pagerDepth * GetHierarchyIndentSize();

            return @<tr role="row" class="atom:border-b atom:bg-muted/30">
                <td role="gridcell" colspan="@_cachedVisibleColumns.Count" class="atom:px-4 atom:py-1.5">
                    <div class="atom:flex atom:items-center atom:gap-2 atom:text-xs atom:text-muted-foreground" style="@($"padding-left: {pagerIndent}px")">
                        <span>@Localizer["DataGrid.ShowingRange", pagerStart, pagerEnd, pagerTotalChildren]</span>
                        <div class="atom:flex atom:items-center atom:gap-0.5">
                            <button type="button"
                                    class="atom:inline-flex atom:items-center atom:justify-center atom:rounded atom:w-6 atom:h-6 atom:hover:bg-muted atom:transition-colors atom:disabled:opacity-50"
                                    disabled="@(pagerPageIndex <= 0)"
                                    @onclick="@(() => HandleChildPageChange(pagerParentValue, pagerPageIndex - 1))"
                                    @onclick:stopPropagation="true"
                                    aria-label="@Localizer["DataGrid.PreviousPage"]">
                                <LucideIcon Name="chevron-left" Class="atom:w-3.5 atom:h-3.5" />
                            </button>
                            <span class="atom:tabular-nums atom:px-1">@(pagerPageIndex + 1) / @pagerTotalPages</span>
                            <button type="button"
                                    class="atom:inline-flex atom:items-center atom:justify-center atom:rounded atom:w-6 atom:h-6 atom:hover:bg-muted atom:transition-colors atom:disabled:opacity-50"
                                    disabled="@(pagerPageIndex >= pagerTotalPages - 1)"
                                    @onclick="@(() => HandleChildPageChange(pagerParentValue, pagerPageIndex + 1))"
                                    @onclick:stopPropagation="true"
                                    aria-label="@Localizer["DataGrid.NextPage"]">
                                <LucideIcon Name="chevron-right" Class="atom:w-3.5 atom:h-3.5" />
                            </button>
                        </div>
                    </div>
                </td>
            </tr>;
        }
        else if (renderItem.IsDataRow && IsInHierarchyMode)
        {
            return @<text>@RenderHierarchyRow(renderItem)</text>;
        }
        else
        {
            return @<text>
                @RenderDataRow(renderItem.Item!)
                @if (_gridState.Expanded.IsExpanded(renderItem.Item!))
                {
                    @if (HasDetailRows)
                    {
                        @ExpandColumnDetailRows!(renderItem.Item!)
                    }
                    @if (DetailTemplate != null)
                    {
                        <tr class="atom:border-b">
                            <td colspan="@_cachedVisibleColumns.Count" class="atom:p-4">
                                @DetailTemplate(renderItem.Item!)
                            </td>
                        </tr>
                    }
                }
            </text>;
        }
    };

    private RenderFragment<DataGridRenderItem<TData>> RenderHierarchyRow => renderItem =>
    {
        var item = renderItem.Item!;
        var rowClass = ClassNames.cn("atom:group/row atom:bg-background",
            Striped ? StripeClass : null,
            !renderItem.MatchesFilter ? "atom:opacity-50" : "",
            RowClass?.Invoke(item));

        return @<AtomBlazor.Primitives.DataGridRow @key="@ItemValueSelector!(item)" TData="TData" Item="@item"
            Class="@rowClass"
            aria-level="@(renderItem.Depth + 1)">
            @foreach (var column in _cachedVisibleColumns)
            {
                var isSelectColumn = column.ColumnId == "__select";
                var isExpandColumn = column.ColumnId == "__expand";
                var isHierarchyColumn = _hierarchyColumn != null && column.ColumnId == _hierarchyColumn.ColumnId;
                var isLastLeft = column.ColumnId == _cachedLastLeftId;
                var isFirstRight = column.ColumnId == _cachedFirstRightId;
                var pinnedStyle = GetPinnedStyle(column, _cachedVisibleColumns);

                <AtomBlazor.Primitives.DataGridCell
                    @key="@column.ColumnId"
                    Class="@GetCellClass(column, isSelectColumn, isExpandColumn, isLastLeft, isFirstRight, item)"
                    style="@pinnedStyle"
                    data-pinned="@(column.Pinned != ColumnPinning.None ? "true" : null)">
                    @if (isSelectColumn)
                    {
                        <div @onclick:stopPropagation="true">
                            <Checkbox Checked="@_gridState.Selection.IsSelected(item)"
                                      Indeterminate="@IsHierarchyItemIndeterminate(item)"
                                      CheckedChanged="@((bool isChecked) => HandleRowSelectionChanged(item, isChecked))"
                                      AriaLabel="@Localizer["DataGrid.SelectThisRow"]" />
                        </div>
                    }
                    else if (isHierarchyColumn)
                    {
                        var indent = renderItem.Depth * GetHierarchyIndentSize();
                        <div class="atom:flex atom:items-center" style="@($"padding-left: {indent}px")">
                            @if (renderItem.HasChildren)
                            {
                                <button type="button"
                                        class="atom:inline-flex atom:items-center atom:justify-center atom:rounded-md atom:w-6 atom:h-6 atom:me-1 atom:hover:bg-muted atom:transition-colors atom:shrink-0"
                                        aria-expanded="@renderItem.IsExpanded.ToString().ToLowerInvariant()"
                                        aria-label="@(renderItem.IsExpanded ? Localizer["DataGrid.Collapse"] : Localizer["DataGrid.Expand"])"
                                        @onclick="@(() => HandleHierarchyNodeToggle(item))"
                                        @onclick:stopPropagation="true">
                                    <LucideIcon Name="@(renderItem.IsExpanded ? "chevron-down" : "chevron-right")"
                                               Class="atom:w-4 atom:h-4 atom:transition-transform" />
                                </button>
                            }
                            else
                            {
                                <span class="atom:inline-block atom:w-6 atom:me-1 atom:shrink-0"></span>
                            }
                            @if (ShouldRenderEditor(column, item))
                            {
                                @RenderEditableCell(column, item)
                            }
                            else
                            {
                                @RenderCellValue(column, item)
                            }
                        </div>
                    }
                    else if (ShouldRenderEditor(column, item))
                    {
                        @RenderEditableCell(column, item)
                    }
                    else
                    {
                        @RenderCellValue(column, item)
                    }
                </AtomBlazor.Primitives.DataGridCell>
            }
        </AtomBlazor.Primitives.DataGridRow>;
    };

    private RenderFragment RenderEditableCell(IDataGridColumn<TData> column, TData item) => @<text>
        <CascadingValue Value="_editContext">
            @if (UsesEditBuffer)
            {
                <div class="atom:grid atom:min-w-0 atom:grid-cols-[minmax(0,1fr)]">
                    @* Retain the pre-edit content's intrinsic width. Only the editor's height
                       contributes to table layout, so opening it does not resize columns. *@
                    <div inert aria-hidden="true" data-atom-cell-sizing class="atom:invisible atom:pointer-events-none atom:col-start-1 atom:row-start-1">
                        @RenderCellValue(column, item, cellCheckpoint, true)
                    </div>
                    <fieldset disabled="@savingEdits" data-atom-cell-editor @onclick:stopPropagation="true"
                              class="atom:col-start-1 atom:row-start-1 atom:min-w-0 atom:space-y-1 atom:[contain:inline-size]">
                        <InputGroup Class="atom:h-auto atom:min-h-10 atom:focus-within:ring-2 atom:focus-within:ring-ring">
                            @* The reset targets popup triggers by aria-haspopup rather than by being
                               a direct child button. Two reasons. A combobox or multi select wraps its
                               trigger in a container, so a child selector never reached it and the
                               trigger kept its own fixed PopoverWidth — 300px inside a 110px cell —
                               and painted over Save and Cancel. And a checkbox, switch or toggle
                               editor renders a plain button that a child selector *did* reach, which
                               stretched it full width and stripped its border. Tag chips inside a
                               multi select are plain buttons too, so they must stay untouched.

                               overflow-hidden here, and shrink-0 with a stacking context on the addon,
                               are the backstop: whatever an editor does, it cannot cover the buttons
                               that commit or cancel the edit. *@
                            <div class="atom:min-w-0 atom:flex-1 atom:overflow-hidden atom:[&_input]:min-w-0 atom:[&_input]:border-0 atom:[&_input]:shadow-none atom:[&_input]:focus-visible:ring-0 atom:[&_button[aria-haspopup]]:w-full atom:[&_button[aria-haspopup]]:min-w-0 atom:[&_button[aria-haspopup]]:border-0 atom:[&_button[aria-haspopup]]:shadow-none atom:[&_button[aria-haspopup]]:focus-visible:ring-0 atom:[&_button[aria-haspopup]>span]:truncate">
                                @RenderCellEditor(column, item)
                            </div>
                            <InputGroupAddon Align="InputGroupAlign.InlineEnd" Class="atom:relative atom:z-10 atom:shrink-0 atom:gap-0.5 atom:pe-1">
                                <InputGroupButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="atom:w-7 atom:!p-1.5 atom:rounded-sm"
                                                    Disabled="@savingEdits" AriaLabel="@Localizer["DataGrid.SaveRow"]" OnClick="@(async () => await CommitEditAsync())">
                                    <LucideIcon Name="check" Size="14" aria-hidden="true" />
                                </InputGroupButton>
                                <InputGroupButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="atom:w-7 atom:!p-1.5 atom:rounded-sm"
                                                    Disabled="@savingEdits" AriaLabel="@Localizer["DataGrid.CancelRowEdit"]" OnClick="CancelEditAsync">
                                    <LucideIcon Name="x" Size="14" aria-hidden="true" />
                                </InputGroupButton>
                            </InputGroupAddon>
                        </InputGroup>
                        <ValidationSummary class="atom:whitespace-normal atom:break-words atom:text-destructive atom:text-xs" />
                    </fieldset>
                </div>
            }
            else
            {
                <fieldset disabled="@savingEdits" data-atom-cell-editor @onclick:stopPropagation="true" class="atom:min-w-0 atom:space-y-1">
                    @RenderCellEditor(column, item)
                    <ValidationSummary class="atom:text-destructive atom:text-xs" />
                </fieldset>
            }
        </CascadingValue>
    </text>;

    private RenderFragment RenderCellEditor(IDataGridColumn<TData> column, TData item) => column.EditTemplate!(new DataGridCellContext<TData>
    {
        Item = editModel ?? item,
        Column = column,
        Value = column.GetValue(editModel ?? item)
    });

    private RenderFragment RenderCellValue(IDataGridColumn<TData> column, TData item, TData? displayItem = null, bool sizingOnly = false) => @<text>
        @if (column.CellTemplate != null)
        {
            @column.CellTemplate(new DataGridCellContext<TData> { Item = displayItem ?? DisplayItem(item), Column = column, Value = column.GetValue(displayItem ?? DisplayItem(item)) })
        }
        else
        {
            @(column.GetValue(displayItem ?? DisplayItem(item))?.ToString() ?? "")
        }
        @if (IsCellEditable(column))
        {
            <button type="button" id="@(sizingOnly ? null : CellTriggerId(item, column.ColumnId))" disabled="@(savingEdits || sizingOnly)" class="atom:ms-2 atom:inline-flex atom:rounded atom:p-1 atom:hover:bg-muted"
                    aria-label="@Localizer["DataGrid.EditCell", column.Title ?? column.ColumnId]" @onclick:stopPropagation="true"
                    @onclick="@(() => StartCellEditAsync(item, column.ColumnId))">
                <LucideIcon Name="pencil" Class="atom:w-3 atom:h-3" />
            </button>
        }
    </text>;

    /// <summary>
    /// How far each level of the hierarchy is indented, in pixels.
    /// </summary>
    /// <remarks>
    /// Taken from the hierarchy column's <c>IndentSize</c>. This used to return a hard-coded 24
    /// regardless, so setting <c>IndentSize</c> on the column changed nothing.
    /// </remarks>
    private int GetHierarchyIndentSize() =>
        _hierarchyColumn is IHierarchyIndentColumn column && column.IndentSize >= 0
            ? column.IndentSize
            : 24;

    /// <summary>
    /// How far each nested grouping level is indented, in pixels. Matches the hierarchy indent so
    /// a grid that uses both reads as one structure.
    /// </summary>
    private int GetGroupIndentSize() => GetHierarchyIndentSize();
}
