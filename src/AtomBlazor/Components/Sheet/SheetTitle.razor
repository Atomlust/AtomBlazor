@namespace AtomBlazor

@*
    带样式的面板标题组件，使用 shadcn/ui 排版类。
*@

<AtomBlazor.Primitives.SheetTitle As="@As" class="@GetClassNames()" @attributes="AdditionalAttributes">
    @ChildContent
</AtomBlazor.Primitives.SheetTitle>

@code {
    /// <summary>
    /// 标题文本或内容。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 应用到标题的额外 CSS 类。
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// 应用到标题元素的额外属性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// 用于标题的 HTML 元素标签。
    /// 默认值为 "h2"。
    /// </summary>
    [Parameter]
    public string As { get; set; } = "h2";

    private string GetClassNames() => ClassNames.cn(
        "atom:text-lg atom:font-semibold atom:text-foreground",
        Class
    );
}
