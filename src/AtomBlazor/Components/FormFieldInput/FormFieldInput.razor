@namespace AtomBlazor
@typeparam TValue
@inherits FormFieldBase

<FormFieldShell Orientation="@Orientation" IsInvalid="@IsInvalid" Class="@Class"
                Label="@Label" LabelFor="@ControlId" AssociateLabel
                HelperText="@HelperText" HelperTextId="@DescriptionId"
                RuntimeErrorText="@(_hasError ? _errorMessage : null)"
                ErrorText="@ErrorText" ErrorId="@ErrorId"
                HasEditContextErrors="@HasEditContextErrors" EditContextErrors="@EditContextErrors">
    <Control>
        <InputField @ref="_inputRef"
                    TValue="TValue"
                    Value="@Value"
                    ValueChanged="HandleValueChanged"
                    ValueExpression="@ValueExpression"
                    Name="@Name"
                    Converter="@Converter"
                    Format="@Format"
                    Type="@Type"
                    Placeholder="@Placeholder"
                    Disabled="@Disabled"
                    Required="@Required"
                    MaxLength="@MaxLength"
                    Validation="@Validation"
                    ValidationPattern="@ValidationPattern"
                    UpdateTiming="@UpdateTiming"
                    DebounceInterval="@DebounceInterval"
                    Id="@ControlId"
                    AriaLabel="@AriaLabel"
                    AriaDescribedBy="@DescribedById"
                    OnParseError="HandleParseError"
                    OnErrorCleared="HandleErrorCleared"
                    Class="@InputClass"
                    @attributes="AdditionalAttributes" />
    </Control>
</FormFieldShell>
