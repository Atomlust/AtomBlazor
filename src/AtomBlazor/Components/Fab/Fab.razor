@namespace AtomBlazor

<Button Variant="@MappedVariant"
        Class="@CssClass"
        Disabled="@Disabled"
        OnClick="@OnClick"
        AriaLabel="@AriaLabel"
        data-slot="fab"
        @attributes="AdditionalAttributes">
    @if (Icon is not null)
    {
        <span class="atom:inline-flex atom:shrink-0 atom:items-center">@Icon</span>
    }
    @if (ChildContent is not null)
    {
        <span class="atom:truncate">@ChildContent</span>
    }
</Button>
