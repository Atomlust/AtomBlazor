@namespace AtomBlazor

<code class="@CssClass" @attributes="AdditionalAttributes">@ChildContent</code>

@code {
    /// <summary>
    /// 获取或设置要渲染的内容。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 获取或设置应用到代码片段上的额外 CSS 类。
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// 获取或设置应用到根元素的额外 HTML 属性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => ClassNames.cn(
        "atom:relative atom:rounded atom:bg-muted atom:px-[0.3rem] atom:py-[0.2rem] atom:font-mono atom:text-sm atom:font-semibold",
        Class
    );
}
