@namespace AtomBlazor
@typeparam TValue

<AtomBlazor.Primitives.ToggleGroupItem TValue="TValue"
    Value="@Value"
    Disabled="@Disabled"
    class="@CssClass"
    @attributes="AdditionalAttributes">
    @ChildContent
</AtomBlazor.Primitives.ToggleGroupItem>

@code {
    /// <summary>
    /// 从上级 ToggleGroup 包装组件获取的级联上下文，用于继承变体与尺寸样式。
    /// </summary>
    [CascadingParameter]
    public ToggleGroup<TValue>? Context { get; set; }

    /// <summary>
    /// 获取或设置与这个切换项关联的值。
    /// </summary>
    [Parameter]
    public TValue? Value { get; set; }

    /// <summary>
    /// 获取或设置该项是否禁用。
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// 获取或设置应用到该项的额外 CSS 类。
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// 获取或设置应用到根元素的额外 HTML 属性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// 获取或设置渲染在项内部的内容。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private ToggleVariant Variant => Context?.Variant ?? ToggleVariant.Default;
    private ToggleSize Size => Context?.Size ?? ToggleSize.Default;

    private string VariantClasses => Variant switch
    {
        ToggleVariant.Default => "atom:bg-transparent",
        ToggleVariant.Outline => "atom:border atom:border-input atom:bg-transparent atom:hover:bg-accent atom:hover:text-accent-foreground",
        _ => "atom:bg-transparent"
    };

    private string SizeClasses => Size switch
    {
        ToggleSize.Small => "atom:h-9 atom:px-2.5",
        ToggleSize.Default => "atom:h-10 atom:px-3",
        ToggleSize.Large => "atom:h-11 atom:px-5",
        _ => "atom:h-10 atom:px-3"
    };

    private string CssClass => ClassNames.cn(
        "atom:inline-flex atom:items-center atom:justify-center atom:rounded-md atom:text-sm atom:font-medium atom:ring-offset-background atom:transition-colors",
        "atom:hover:bg-muted atom:hover:text-muted-foreground",
        "atom:focus-visible:outline-none atom:focus-visible:ring-2 atom:focus-visible:ring-ring atom:focus-visible:ring-offset-2",
        "atom:disabled:pointer-events-none atom:disabled:opacity-50",
        "atom:data-[state=on]:bg-accent atom:data-[state=on]:text-accent-foreground",
        VariantClasses,
        SizeClasses,
        Class
    );
}
