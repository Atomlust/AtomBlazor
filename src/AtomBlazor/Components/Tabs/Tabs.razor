@namespace AtomBlazor

@*
    带样式的 Tabs 组件封装。
    以 shadcn/ui 样式包裹 Tabs 基元。
*@

<AtomBlazor.Primitives.TabsPrimitive Value="@Value"
                                ValueChanged="@ValueChanged"
                                DefaultValue="@DefaultValue"
                                OnValueChange="@OnValueChange"
                                Orientation="@Orientation"
                                ActivationMode="@ActivationMode"
                                class="@CssClass"
                                @attributes="AdditionalAttributes">
    @ChildContent
</AtomBlazor.Primitives.TabsPrimitive>

@code {
    /// <summary>
    /// 在标签页内渲染的子内容。
    /// 应当包含 TabsList 与 TabsContent 组件。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 控制哪个标签页处于激活状态（受控模式）。
    /// 为 null 时由标签页自行管理状态（非受控模式）。
    /// </summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>
    /// 激活标签页变化时调用的事件回调。
    /// 配合 @bind-Value 使用即可实现双向绑定。
    /// </summary>
    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>
    /// 非受控模式下的初始激活标签页值。
    /// </summary>
    [Parameter]
    public string? DefaultValue { get; set; }

    /// <summary>
    /// 激活标签页变化时调用的事件回调。
    /// </summary>
    [Parameter]
    public EventCallback<string?> OnValueChange { get; set; }

    /// <summary>
    /// 标签页的排列方向（水平或垂直）。
    /// 默认值为水平。
    /// </summary>
    [Parameter]
    public AtomBlazor.Primitives.TabsOrientation Orientation { get; set; } = AtomBlazor.Primitives.TabsOrientation.Horizontal;

    /// <summary>
    /// 标签页的激活模式（聚焦即激活或点击才激活）。
    /// 默认值为自动激活。
    /// </summary>
    [Parameter]
    public AtomBlazor.Primitives.TabsActivationMode ActivationMode { get; set; } = AtomBlazor.Primitives.TabsActivationMode.Automatic;

    /// <summary>
    /// 要应用到标签页容器的额外 CSS 类。
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// 要应用到标签页容器的额外属性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string? CssClass => ClassNames.cn(Class);
}
