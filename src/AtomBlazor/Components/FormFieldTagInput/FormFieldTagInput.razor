@namespace AtomBlazor
@inherits FormFieldBase

<FormFieldShell Orientation="@Orientation" IsInvalid="@IsInvalid" Class="@Class"
                Label="@Label"
                HelperText="@HelperText" HelperTextId="@DescriptionId"
                ErrorText="@ErrorText" ErrorId="@ErrorId"
                HasEditContextErrors="@HasEditContextErrors" EditContextErrors="@EditContextErrors">
    <Control>
        <TagInput Tags="@Tags"
                  TagsChanged="HandleTagsChanged"
                  TagsExpression="@TagsExpression"
                  Placeholder="@Placeholder"
                  MaxTags="@MaxTags"
                  MaxTagLength="@MaxTagLength"
                  AllowDuplicates="@AllowDuplicates"
                  AddTrigger="@AddTrigger"
                  Validate="@Validate"
                  OnTagRejected="@OnTagRejected"
                  Suggestions="@Suggestions"
                  OnSearchSuggestions="@OnSearchSuggestions"
                  SuggestionDebounceMs="@SuggestionDebounceMs"
                  Variant="@Variant"
                  Clearable="@Clearable"
                  Disabled="@Disabled"
                  TagTemplate="@TagTemplate"
                  AriaLabel="@AriaLabel"
                  Class="@InputClass"
                  @attributes="AdditionalAttributes" />
    </Control>
</FormFieldShell>
