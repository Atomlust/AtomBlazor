@namespace AtomBlazor

<Button
    Type="@Type"
    Variant="@Variant"
    Size="@Size"
    Disabled="@Disabled"
    AriaLabel="@AriaLabel"
    OnClick="@OnClick"
    Icon="@Icon"
    IconPosition="@IconPosition"
    Class="@CssClass"
    @attributes="AdditionalAttributes">
    @ChildContent
</Button>
