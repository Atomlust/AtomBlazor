@namespace AtomBlazor

@* 经过样式封装的 DropdownMenuItem - 使用 shadcn Tailwind 类的封装 *@
<AtomBlazor.Primitives.DropdownMenuItemPrimitive class="@CssClass"
                                                         Disabled="@Disabled"
                                                         OnClick="@OnClick"
                                                         CloseOnSelect="@CloseOnSelect"
                                                         Href="@Href"
                                                         Target="@Target"
                                                         @attributes="AdditionalAttributes">
    @if (Icon != null)
    {
        <span class="atom:me-2 atom:h-4 atom:w-4 atom:shrink-0 atom:[&>svg]:h-4 atom:[&>svg]:w-4">@Icon</span>
    }
    @ChildContent
</AtomBlazor.Primitives.DropdownMenuItemPrimitive>

@code {
    /// <summary>
    /// 要在菜单项内显示的内容。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 在菜单项内容前显示的可选图标。
    /// </summary>
    [Parameter]
    public RenderFragment? Icon { get; set; }

    /// <summary>
    /// 应用于该菜单项的额外 CSS 类。
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// 获取或设置应用于根元素的额外 HTML 特性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// 菜单项是否被禁用。
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; } = false;

    /// <summary>
    /// 自定义点击处理程序。
    /// </summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>
    /// 要导航到的 URL。设置后，该项将渲染为锚点元素而非 div。
    /// </summary>
    [Parameter]
    public string? Href { get; set; }

    /// <summary>
    /// 锚点的 target 特性（如 "_blank"）。仅在设置了 Href 时生效。
    /// </summary>
    [Parameter]
    public string? Target { get; set; }

    /// <summary>
    /// 选中该项时是否关闭下拉菜单。
    /// </summary>
    [Parameter]
    public bool CloseOnSelect { get; set; } = true;

    private string CssClass => ClassNames.cn(
        "atom:relative atom:flex atom:cursor-default atom:select-none atom:items-center atom:rounded-sm atom:px-2 atom:py-1.5",
        "atom:text-sm atom:outline-none atom:transition-colors",
        "atom:focus:bg-(--atom-menu-accent) atom:focus:text-(--atom-menu-accent-foreground)",
        "atom:data-[disabled=true]:pointer-events-none atom:data-[disabled=true]:opacity-50",
        !Disabled ? "atom:hover:bg-(--atom-menu-accent) atom:hover:text-(--atom-menu-accent-foreground)" : null,
        Class
    );
}
