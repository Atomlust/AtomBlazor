@namespace AtomBlazor

<div class="@CssClass" role="presentation" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    /// <summary>
    /// 获取或设置应用于该标签的额外 CSS 类。
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// 获取或设置应用于根元素的额外 HTML 特性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// 获取或设置要在该标签内渲染的内容。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 获取为该标签计算得到的 CSS 类。
    /// </summary>
    private string CssClass => ClassNames.cn(
        "atom:px-2 atom:py-1.5 atom:text-sm atom:font-semibold",
        Class
    );
}
