@namespace AtomBlazor

<AtomBlazor.Primitives.MenuSubTrigger OpenOnHover="@OpenOnHover" class="@CssClass" @attributes="AdditionalAttributes">
    @ChildContent
    <svg aria-hidden="true" class="atom:ms-auto atom:size-4 atom:rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="m9 18 6-6-6-6" />
    </svg>
</AtomBlazor.Primitives.MenuSubTrigger>

@code {
    /// <summary>触发元素的标签内容。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>悬停时打开子菜单。默认值为 true。</summary>
    [Parameter] public bool OpenOnHover { get; set; } = true;
    /// <summary>使标签与包含图标的项对齐。</summary>
    [Parameter] public bool Inset { get; set; }
    /// <summary>额外的 CSS 类。</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>额外的 HTML 特性。</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => ClassNames.cn(
        "atom:flex atom:cursor-default atom:select-none atom:items-center atom:gap-2 atom:rounded-sm atom:px-2 atom:py-1.5 atom:text-sm atom:outline-none",
        "atom:focus:bg-(--atom-menu-accent) atom:focus:text-(--atom-menu-accent-foreground) atom:hover:bg-(--atom-menu-accent) atom:hover:text-(--atom-menu-accent-foreground) atom:data-[state=open]:bg-(--atom-menu-accent)",
        "atom:data-[disabled=true]:pointer-events-none atom:data-[disabled=true]:opacity-50", Inset ? "atom:ps-8" : null, Class);
}
