@namespace AtomBlazor

<div class="@CssClass" role="separator" aria-orientation="horizontal" @attributes="AdditionalAttributes"></div>

@code {
    /// <summary>
    /// 获取或设置应用于分隔线的额外 CSS 类。
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// 获取或设置应用于根元素的额外 HTML 特性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// 获取为分隔线计算得到的 CSS 类。
    /// </summary>
    private string CssClass => ClassNames.cn(
        "atom:-mx-1 atom:my-1 atom:h-px atom:bg-muted",
        Class
    );
}
