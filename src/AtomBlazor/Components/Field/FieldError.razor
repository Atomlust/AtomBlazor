@namespace AtomBlazor

@if (Errors != null && Errors.Any())
{
    <div
        id="@Id"
        data-slot="field-error"
        class="@CssClass"
        @attributes="AdditionalAttributes">
        @foreach (var error in Errors)
        {
            <div class="atom:flex atom:items-start atom:gap-1.5">
                <span class="atom:mt-0.5">•</span>
                <span>@error</span>
            </div>
        }
    </div>
}
else if (ChildContent != null)
{
    <div
        id="@Id"
        data-slot="field-error"
        class="@CssClass"
        @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}
