@namespace AtomBlazor
@using AtomBlazor.Icons.Lucide

@if (visible)
{
    <Fab Variant="@Variant"
         Size="@Size"
         Shape="@Shape"
         Placement="@Placement"
         Fixed="@Fixed"
         AriaLabel="@(AriaLabel ?? Localizer["ScrollToTop.Label"])"
         OnClick="ScrollAsync"
         Class="@CssClass"
         data-slot="scroll-to-top"
         @attributes="AdditionalAttributes">
        <Icon>
            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else
            {
                <LucideIcon Name="arrow-up" Size="20" />
            }
        </Icon>
    </Fab>
}
