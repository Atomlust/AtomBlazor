@namespace AtomBlazor
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Navigation
@implements IDisposable

<ScreenTransition TransitionKey="location" Preset="Preset" Duration="Duration" Enabled="Enabled" Class="@Class">@ChildContent</ScreenTransition>

@code {
    /// <summary>包裹 RouteView 或布局正文，为导航进入的内容播放入场动画。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>进入页面的动画。</summary>
    [Parameter] public MotionPreset Preset { get; set; } = MotionPreset.Fade;
    /// <summary>时长，单位毫秒。</summary>
    [Parameter] public int Duration { get; set; } = 250;
    /// <summary>首次可交互渲染之后才启用转场。</summary>
    [Parameter] public bool Enabled { get; set; } = true;
    /// <summary>包裹层的额外 CSS 类。</summary>
    [Parameter] public string? Class { get; set; }
    private string location = "";
    private bool disposed;
    protected override void OnInitialized() { location = Navigation.Uri; Navigation.LocationChanged += OnLocationChanged; }
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(() => { if (!disposed) { location = args.Location; StateHasChanged(); } });
    }
    public void Dispose() { disposed = true; Navigation.LocationChanged -= OnLocationChanged; }
}
