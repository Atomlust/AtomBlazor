@namespace AtomBlazor

<Motion @ref="motion" Preset="Preset" Duration="@(Enabled ? Duration : 0)" Distance="Distance" Trigger="MotionTrigger.Manual" Class="@Class">
    @ChildContent
</Motion>

@code {
    /// <summary>屏幕标识符。变化时对新内容播放入场动画，且不重挂载其组件子树。</summary>
    [Parameter] public object? TransitionKey { get; set; }
    /// <summary>屏幕内容。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>入场动画。</summary>
    [Parameter] public MotionPreset Preset { get; set; } = MotionPreset.Fade;
    /// <summary>时长，单位毫秒。</summary>
    [Parameter] public int Duration { get; set; } = 250;
    /// <summary>滑动距离，单位像素。</summary>
    [Parameter] public double Distance { get; set; } = 24;
    /// <summary>首次可交互渲染之后才启用转场。</summary>
    [Parameter] public bool Enabled { get; set; } = true;
    /// <summary>包裹层的额外 CSS 类。</summary>
    [Parameter] public string? Class { get; set; }
    private object? lastKey;
    private bool pending;
    private bool interactive;
    private Motion? motion;
    protected override void OnParametersSet()
    {
        pending |= interactive && !Equals(lastKey, TransitionKey);
        lastKey = TransitionKey;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        interactive = true;
        if (pending && motion is not null) { pending = false; await motion.PlayAsync(); }
    }
}
