@namespace AtomBlazor
@inherits FormFieldBase

<FormFieldShell Orientation="@Orientation" IsInvalid="@IsInvalid" Class="@Class"
                Label="@Label"
                HelperText="@HelperText" HelperTextId="@DescriptionId"
                ErrorText="@ErrorText" ErrorId="@ErrorId"
                HasEditContextErrors="@HasEditContextErrors" EditContextErrors="@EditContextErrors">
    <Control>
        <DateRangePicker AriaLabel="@AriaLabel" Value="@Value"
                           ValueChanged="HandleValueChanged"
                           DateFormat="@DateFormat"
                           Placeholder="@Placeholder"
                           MinDate="@MinDate"
                           MaxDate="@MaxDate"
                           Clock="@Clock"
                           DisabledDates="@DisabledDates"
                           MinDays="@MinDays"
                           MaxDays="@MaxDays"
                           ShowTwoMonths="@ShowTwoMonths"
                           ShowPresets="@ShowPresets"
                           ShowButtons="@ShowButtons"
                           AutoApply="@AutoApply"
                           Presets="@Presets"
                           FirstDayOfWeek="@FirstDayOfWeek"
                           Disabled="@Disabled"
                           Class="@InputClass"
                           @attributes="AdditionalAttributes" />
    </Control>
</FormFieldShell>
