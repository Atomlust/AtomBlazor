@namespace AtomBlazor
@typeparam TValue where TValue : struct, System.Numerics.INumber<TValue>
@inherits FormFieldBase

<FormFieldShell Orientation="@Orientation" IsInvalid="@IsInvalid" Class="@Class"
                Label="@Label" LabelFor="@ControlId" AssociateLabel
                HelperText="@HelperText" HelperTextId="@DescriptionId"
                ErrorText="@ErrorText" ErrorId="@ErrorId"
                HasEditContextErrors="@HasEditContextErrors" EditContextErrors="@EditContextErrors">
    <Control>
        <NumericInput TValue="TValue"
                        Value="@Value"
                        ValueChanged="HandleValueChanged"
                        ValueExpression="@ValueExpression"
                        Name="@Name"
                        Min="@Min"
                        Max="@Max"
                        Step="@Step"
                        DecimalPlaces="@DecimalPlaces"
                        AllowNegative="@AllowNegative"
                        ShowButtons="@ShowButtons"
                        Placeholder="@Placeholder"
                        Disabled="@Disabled"
                        Required="@Required"
                        Format="@Format"
                        DisableDebounce="@DisableDebounce"
                        DebounceInterval="@DebounceInterval"
                        EnableWheelStep="@EnableWheelStep"
                        Id="@ControlId"
                        AriaLabel="@AriaLabel"
                        AriaDescribedBy="@DescribedById"
                        AriaInvalid="@(IsInvalid ? true : null)"
                        Class="@InputClass"
                        @attributes="AdditionalAttributes" />
    </Control>
</FormFieldShell>
