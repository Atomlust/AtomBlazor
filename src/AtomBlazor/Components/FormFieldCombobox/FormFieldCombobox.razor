@namespace AtomBlazor
@typeparam TValue
@inherits FormFieldBase
@attribute [CascadingTypeParameter(nameof(TValue))]

<FormFieldShell Orientation="@Orientation" IsInvalid="@IsInvalid" Class="@Class"
                Label="@Label"
                HelperText="@HelperText" HelperTextId="@DescriptionId"
                ErrorText="@ErrorText" ErrorId="@ErrorId"
                HasEditContextErrors="@HasEditContextErrors" EditContextErrors="@EditContextErrors">
    <Control>
        <Combobox AriaLabel="@AriaLabel" TValue="TValue"
                  Options="@Options"
                  Value="@Value"
                  ValueChanged="HandleValueChanged"
                  ValueExpression="@ValueExpression"
                  Placeholder="@Placeholder"
                  SearchPlaceholder="@SearchPlaceholder"
                  EmptyMessage="@EmptyMessage"
                  SearchQuery="@InnerSearchQuery"
                  SearchQueryChanged="@InnerSearchQueryChanged"
                  OnLoadMore="@OnLoadMore"
                  IsLoading="@IsLoading"
                  EndOfListMessage="@EndOfListMessage"
                  Disabled="@Disabled"
                  Required="@Required"
                  AriaDescribedBy="@DescribedById"
                  PopoverWidth="@PopoverWidth"
                  MatchTriggerWidth="@MatchTriggerWidth"
                  ActiveClass="@ActiveClass"
                  Class="@InputClass"
                  @attributes="AdditionalAttributes">
            @ChildContent
        </Combobox>
    </Control>
</FormFieldShell>
