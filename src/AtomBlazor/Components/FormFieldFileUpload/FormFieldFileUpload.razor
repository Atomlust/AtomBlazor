@namespace AtomBlazor
@inherits FormFieldBase

<FormFieldShell Orientation="@Orientation" IsInvalid="@IsInvalid" Class="@Class"
                Label="@Label"
                HelperText="@HelperText" HelperTextId="@DescriptionId"
                ErrorText="@ErrorText" ErrorId="@ErrorId"
                HasEditContextErrors="@HasEditContextErrors" EditContextErrors="@EditContextErrors">
    <Control>
        <FileUpload AriaLabel="@AriaLabel" @ref="fileUploadRef"
                    Files="@Files"
                    FilesChanged="HandleFilesChanged"
                    Multiple="@Multiple"
                    Accept="@Accept"
                    MaxFileSize="@MaxFileSize"
                    MaxFileCount="@MaxFileCount"
                    ShowPreview="@ShowPreview"
                    Disabled="@Disabled"
                    Required="@Required"
                    OnValidationError="@OnValidationError"
                    DropzoneContent="@DropzoneContent"
                    Class="@InputClass"
                    @attributes="AdditionalAttributes" />
    </Control>
</FormFieldShell>
