@namespace AtomBlazor
@typeparam TItem
@using AtomBlazor.Icons.Lucide

@*
    内部组件：递归渲染数据驱动的树节点。
*@

<AtomBlazor.Primitives.TreeItem Value="@NodeValue"
                                                  Disabled="@false"
                                                  IsLeaf="@(HasChildren ? null : true)"
                                                  hidden="@IsFilteredOut(Item)"
                                                  @attributes="AdditionalAttributes">
    <NodeContent>
        <div class="@NodeCssClass"
             style="@NodeStyle"
             data-tree-node
             data-draggable="@(IsDraggable ? "true" : null)">
            @* 展开/折叠切换 *@
            @if (HasChildren)
            {
                @if (IsLoading)
                {
                    <span class="atom:inline-flex atom:h-5 atom:w-5 atom:items-center atom:justify-center atom:shrink-0">
                        <svg class="atom:h-3.5 atom:w-3.5 atom:animate-spin atom:text-muted-foreground"
                             xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="atom:opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="atom:opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </span>
                }
                else
                {
                    <button type="button"
                            class="atom:inline-flex atom:h-5 atom:w-5 atom:items-center atom:justify-center atom:rounded-sm atom:hover:bg-accent/80 atom:shrink-0"
                            data-tree-toggle
                            tabindex="-1"
                            aria-hidden="true">
                        <svg class="@ChevronCssClass"
                             xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>
                }
            }
            else
            {
                <span class="atom:inline-flex atom:h-5 atom:w-5 atom:shrink-0"></span>
            }

            @* 复选框（仅展示；切换由 tree-keyboard.js 处理） *@
            @if (Checkable)
            {
                <span data-tree-checkbox class="atom:inline-flex atom:shrink-0 atom:cursor-pointer">
                    <Checkbox Checked="@IsChecked"
                                Indeterminate="@IsIndeterminate"
                                Disabled="@false"
                                Class="atom:h-4 atom:w-4 atom:pointer-events-none" />
                </span>
            }

            @* 图标 *@
            @if (ShowIcons && !string.IsNullOrEmpty(IconValue))
            {
                <LucideIcon Name="@IconValue" Size="16" Class="atom:shrink-0 atom:text-muted-foreground" />
            }

            @* 标签 *@
            @if (IsMatchHighlighted && !string.IsNullOrEmpty(SearchText))
            {
                @HighlightedLabel
            }
            else
            {
                <span class="atom:truncate">@LabelValue</span>
            }
        </div>
    </NodeContent>
    <ChildContent>
        @if (HasError)
        {
            <div class="atom:flex atom:items-center atom:gap-2 atom:py-1 atom:text-sm atom:text-destructive" style="@ChildNodeStyle">
                <span>Failed to load</span>
                <button type="button"
                        class="atom:text-xs atom:underline atom:hover:no-underline"
                        @onclick="HandleRetry">
                    Retry
                </button>
            </div>
        }
        else
        {
            @foreach (var child in Children)
            {
                if (!IsFilteredOut(child) || (Checkable && TreeContext?.CheckStrictly == false))
                {
                    <TreeItemNode TItem="TItem"
                                  Item="child"
                                  TextField="@TextField"
                                  ValueField="@ValueField"
                                  IconField="@IconField"
                                  ChildrenAccessor="@ChildrenAccessor"
                                  HasChildrenAccessor="@HasChildrenAccessor"
                                  IsFilteredOut="@IsFilteredOut"
                                  IsMatchHighlighted="@IsMatchHighlighted"
                                  SearchText="@SearchText"
                                  ShowIcons="@ShowIcons"
                                  Checkable="@Checkable"
                                  Draggable="@Draggable"
                                  AllowDrag="@AllowDrag"
                                  LoadingNodes="@LoadingNodes"
                                  ErrorNodes="@ErrorNodes"
                                  OnRetryLoad="OnRetryLoad" />
                }
            }
        }
    </ChildContent>
</AtomBlazor.Primitives.TreeItem>
