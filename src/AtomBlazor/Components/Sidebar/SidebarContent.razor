@namespace AtomBlazor

@*
    SidebarContent 组件：侧边栏可滚动的主内容区。
*@

<div class="@GetClasses()" data-sidebar="content" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    /// <summary>
    /// 要渲染的内容。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 附加 CSS 类。
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// 附加属性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string GetClasses()
    {
        return ClassNames.cn("atom:flex atom:min-h-0 atom:flex-1 atom:flex-col atom:overflow-auto atom:group-data-[collapsible=icon]:overflow-hidden atom:group-data-[collapsible=icon]:items-center", Class);
    }
}
