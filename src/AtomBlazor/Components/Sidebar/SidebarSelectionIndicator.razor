@namespace AtomBlazor

<SelectionIndicator Selector="[data-sidebar=menu-button][data-active=true]" HoverSelector="@(FollowHover ? "[data-sidebar=menu-button]:not([aria-disabled=true])" : null)" Duration="Duration"
                      Class="@ClassNames.cn("atom:bg-sidebar-accent", Class)" />
@code {
    /// <summary>同时跟随指针悬停与键盘焦点。</summary>
    [Parameter] public bool FollowHover { get; set; }
    /// <summary>动画时长（毫秒）。</summary>
    [Parameter] public int Duration { get; set; } = 200;
    /// <summary>附加指示器类。置于定位包装内、菜单之前。</summary>
    [Parameter] public string? Class { get; set; }
}
