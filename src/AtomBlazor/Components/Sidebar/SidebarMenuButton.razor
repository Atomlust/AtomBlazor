@namespace AtomBlazor
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable

@*
    SidebarMenuButton 组件：支持工具提示的可点击菜单项。
*@

@if (ShouldShowTooltip())
{
    <AtomBlazor.Primitives.TooltipPrimitive>
        <AtomBlazor.Primitives.TooltipTrigger>
            @RenderButton()
        </AtomBlazor.Primitives.TooltipTrigger>
        <AtomBlazor.TooltipContent Side="@(Context?.Side == SidebarSide.Right ? PopoverSide.Left : PopoverSide.Right)" Align="@PopoverAlign.Center">
            @Tooltip
        </AtomBlazor.TooltipContent>
    </AtomBlazor.Primitives.TooltipPrimitive>
}
else
{
    @RenderButton()
}

@code {
    [CascadingParameter]
    private SidebarContext? Context { get; set; }

    [CascadingParameter]
    private AtomBlazor.Primitives.CollapsibleContext? CollapsibleContext { get; set; }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    /// <summary>
    /// 按钮内容。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 侧边栏折叠（纯图标模式）时显示的工具提示文本。
    /// </summary>
    [Parameter]
    public string? Tooltip { get; set; }

    /// <summary>
    /// 按钮的尺寸变体。
    /// </summary>
    [Parameter]
    public SidebarMenuButtonSize Size { get; set; } = SidebarMenuButtonSize.Default;

    /// <summary>
    /// 按钮的样式变体。
    /// </summary>
    [Parameter]
    public SidebarMenuButtonVariant Variant { get; set; } = SidebarMenuButtonVariant.Default;

    /// <summary>
    /// 显式控制本菜单项是否处于激活/选中态。设置后该值优先于
    /// 自动的 <see cref="Href"/>/<see cref="Match"/> 位置匹配——因此
    /// 即便 href 与当前 URL 匹配，<c>false</c> 也会强制该项非激活。保持
    /// <c>null</c>（默认）则从当前位置推导激活态。
    /// </summary>
    [Parameter]
    public bool? IsActive { get; set; }

    /// <summary>
    /// 要渲染的元素类型。默认 Button，但提供 Href 时自动切换为 Anchor。
    /// </summary>
    [Parameter]
    public SidebarMenuButtonElement AsChild { get; set; } = SidebarMenuButtonElement.Button;

    /// <summary>
    /// 要导航到的 URL。提供后按钮自动渲染为 NavLink（除非 AsChild 显式设为 Button）。
    /// </summary>
    [Parameter]
    public string? Href { get; set; }

    /// <summary>
    /// 链接匹配当前 URL 的方式。默认为 NavLinkMatch.Prefix。
    /// </summary>
    [Parameter]
    public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;

    /// <summary>
    /// 用于自定义行为的点击处理器。
    /// </summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>
    /// 附加 CSS 类。
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// 附加属性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool ShouldShowTooltip()
    {
        return !string.IsNullOrEmpty(Tooltip) && Context != null && !Context.Open;
    }

    private bool isActiveByLocation;

    /// <summary>
    /// 按钮是否渲染为激活态。显式的 <see cref="IsActive"/> 值优先；
    /// 否则由 <see cref="Href"/> 是否匹配当前位置推导。
    /// </summary>
    private bool ResolvedActive => IsActive ?? isActiveByLocation;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override void OnParametersSet()
    {
        isActiveByLocation = NavLinkMatcher.IsMatch(NavigationManager, NavigationManager.Uri, Href, Match);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var nowActive = NavLinkMatcher.IsMatch(NavigationManager, e.Location, Href, Match);
        if (nowActive != isActiveByLocation)
        {
            isActiveByLocation = nowActive;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private RenderFragment RenderButton() => __builder =>
    {
        // 自动检测：提供 Href 且 AsChild 未显式设为 Button 时渲染为 Anchor
        var shouldRenderAsAnchor = AsChild == SidebarMenuButtonElement.Anchor ||
                                   (!string.IsNullOrEmpty(Href) && AsChild == SidebarMenuButtonElement.Button);

        if (shouldRenderAsAnchor)
        {
            <a href="@Href"
               class="@GetClasses()"
               data-sidebar="menu-button"
               data-size="@Size.ToValue()"
               data-active="@(ResolvedActive ? "true" : "false")"
               data-state="@(CollapsibleContext?.Open ?? false ? "open" : "closed")"
               aria-current="@(ResolvedActive ? "page" : null)"
               aria-expanded="@((CollapsibleContext?.Open ?? false) ? "true" : "false")"
               @onclick="HandleClick"
               @attributes="AdditionalAttributes">
                @ChildContent
            </a>
        }
        else
        {
            <button type="button"
                    class="@GetClasses()"
                    data-sidebar="menu-button"
                    data-size="@Size.ToValue()"
                    data-active="@(ResolvedActive ? "true" : "false")"
                    data-state="@(CollapsibleContext?.Open ?? false ? "open" : "closed")"
                    aria-current="@(ResolvedActive ? "page" : null)"
                    aria-expanded="@((CollapsibleContext?.Open ?? false) ? "true" : "false")"
                    @onclick="HandleClick"
                    @attributes="AdditionalAttributes">
                @ChildContent
            </button>
        }
    };

    private async Task HandleClick(Microsoft.AspNetCore.Components.Web.MouseEventArgs args)
    {
        if (CollapsibleContext?.Toggle != null && !CollapsibleContext.Disabled)
        {
            await CollapsibleContext.Toggle.Invoke();
        }

        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(args);
        }
    }

    private string GetClasses()
    {
        var baseClasses = "atom:group atom:peer/menu-button atom:flex atom:w-full atom:items-center atom:overflow-hidden atom:text-start atom:outline-none atom:ring-sidebar-ring atom:transition-[width,height,padding] atom:hover:bg-sidebar-accent atom:hover:text-sidebar-accent-foreground atom:focus-visible:ring-2 atom:active:bg-sidebar-accent atom:active:text-sidebar-accent-foreground atom:disabled:pointer-events-none atom:disabled:opacity-50 atom:group-has-[[data-sidebar=menu-action]]/menu-item:pe-8 atom:aria-disabled:pointer-events-none atom:aria-disabled:opacity-50 atom:data-[active=true]:bg-sidebar-accent atom:data-[active=true]:font-medium atom:data-[active=true]:text-sidebar-accent-foreground atom:data-[state=open]:hover:bg-sidebar-accent atom:data-[state=open]:hover:text-sidebar-accent-foreground atom:group-data-[collapsible=icon]:justify-center atom:group-data-[collapsible=icon]:[&>span]:hidden atom:[&>span:last-child]:truncate atom:[&>svg]:shrink-0";

        var variantClasses = Variant.ToValue() switch
        {
            "outline" => "atom:bg-background atom:shadow-[0_0_0_1px_hsl(var(--sidebar-border))] atom:hover:bg-sidebar-accent atom:hover:text-sidebar-accent-foreground atom:hover:shadow-[0_0_0_1px_hsl(var(--sidebar-accent))]",
            _ => ""
        };

        return ClassNames.cn(baseClasses, variantClasses, Class);
    }
}
