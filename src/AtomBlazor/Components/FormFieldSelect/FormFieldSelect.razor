@namespace AtomBlazor
@typeparam TValue
@inherits FormFieldBase
@attribute [CascadingTypeParameter(nameof(TValue))]

<FormFieldShell Orientation="@Orientation" IsInvalid="@IsInvalid" Class="@Class"
                Label="@Label"
                HelperText="@HelperText" HelperTextId="@DescriptionId"
                ErrorText="@ErrorText" ErrorId="@ErrorId"
                HasEditContextErrors="@HasEditContextErrors" EditContextErrors="@EditContextErrors">
    <Control>
        <Select AriaLabel="@AriaLabel" TValue="TValue"
                Value="@Value"
                ValueChanged="HandleValueChanged"
                ValueExpression="@ValueExpression"
                Disabled="@Disabled"
                Required="@Required"
                DisplayTextSelector="@GetEffectiveDisplayTextSelector()"
                Class="@InputClass"
                @attributes="AdditionalAttributes">
            <AtomBlazor.SelectTrigger TValue="TValue" id="@ControlId" aria-describedby="@DescribedById">
                <AtomBlazor.SelectValue Placeholder="@Placeholder" />
            </AtomBlazor.SelectTrigger>
            <AtomBlazor.SelectContent TValue="TValue" OnLoadMore="@OnLoadMore" IsLoading="@IsLoading" EndOfListMessage="@EndOfListMessage">
                @if (Options is not null)
                {
                    @foreach (var option in Options)
                    {
                        <AtomBlazor.SelectItem TValue="TValue" Value="@option.Value" Text="@option.Text" />
                    }
                }
                else
                {
                    @ChildContent
                }
            </AtomBlazor.SelectContent>
        </Select>
    </Control>
</FormFieldShell>
