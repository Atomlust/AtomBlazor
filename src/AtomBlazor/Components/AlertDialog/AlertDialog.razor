@namespace AtomBlazor

@*
    警告对话框组件 - 一种需要确认的模态框。
    使用特定的无障碍支持封装 Dialog 基元，用于确认场景。
    默认情况下禁止通过点击外部或 Esc 键关闭。
*@

<AtomBlazor.Primitives.AlertDialogPrimitive
    Open="@Open"
    OpenChanged="@OpenChanged"
    DefaultOpen="@DefaultOpen"
    OnOpenChange="@OnOpenChange"
    @attributes="AdditionalAttributes">
    @ChildContent
</AtomBlazor.Primitives.AlertDialogPrimitive>

@code {
    /// <summary>
    /// 要在警告对话框内呈现的子内容。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 控制警告对话框是否打开（受控模式）。
    /// 为 null 时，对话框自行管理自身状态（非受控模式）。
    /// </summary>
    [Parameter]
    public bool? Open { get; set; }

    /// <summary>
    /// 打开状态发生变化时触发的事件回调。
    /// 配合 @bind-Open 可实现双向绑定。
    /// </summary>
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>
    /// 非受控模式下的默认打开状态。
    /// </summary>
    [Parameter]
    public bool DefaultOpen { get; set; } = false;

    /// <summary>
    /// 对话框打开状态发生变化时触发的事件回调。
    /// </summary>
    [Parameter]
    public EventCallback<bool> OnOpenChange { get; set; }

    /// <summary>
    /// 获取或设置要应用到根元素的额外 HTML 属性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
