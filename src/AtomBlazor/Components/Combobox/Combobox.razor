@namespace AtomBlazor
@typeparam TValue
@attribute [CascadingTypeParameter(nameof(TValue))]
<CascadingValue Value="this" IsFixed="true">
    <div class="@ContainerClass" @attributes="AdditionalAttributes">
        <Popover Open="_isOpen" OpenChanged="HandleOpenChanged" RestoreFocusOnClose="_restoreFocusOnClose">
            <AtomBlazor.PopoverTrigger AsChild="false" role="combobox" aria-label="@AriaLabel"
                           aria-expanded="@GetIsOpen().ToString().ToLower()"
                           aria-controls="@($"{Id}-listbox")"
                           aria-haspopup="listbox"
                           aria-describedby="@AriaDescribedBy"
                           aria-required="@(Required ? "true" : null)"
                           disabled="@Disabled"
                           class="@ButtonCssClass">
                <span class="@(Value is null ? "atom:text-muted-foreground" : "")">
                    @SelectedDisplayText
                </span>
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="16"
                     height="16"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="atom:ms-2 atom:h-4 atom:w-4 atom:shrink-0 atom:opacity-50">
                    <path d="m6 9 6 6 6-6" />
                </svg>
            </AtomBlazor.PopoverTrigger>
            <AtomBlazor.PopoverContent Side="@PopoverSide.Bottom" Align="@PopoverAlign.Start" MatchTriggerWidth="@MatchTriggerWidth"
                              AutoFocusId="@_searchInputId"
                              ScrollToSelected="true" ScrollToSelectedSelector="[data-atom-current=&quot;true&quot;]" Class="@(MatchTriggerWidth ? "atom:!p-0" : $"{PopoverWidth} atom:!p-0")">
                @* 再级联一次，穿过门户送进弹层内容，让 ComboboxItem 能解析到它的 CascadingParameter *@
                <CascadingValue Value="this" IsFixed="true">
                <Command SearchQuery="@SearchQuery" SearchQueryChanged="@HandleSearchQueryChanged" FilterFunction="@_filterFunction">
                    <CommandInput Id="@_searchInputId" Placeholder="@EffectiveSearchPlaceholder" />
                    <CommandList OnLoadMore="@OnLoadMore" IsLoading="@IsLoading" EndOfListMessage="@EndOfListMessage">
                        <CommandEmpty>@EffectiveEmptyMessage</CommandEmpty>
                        @if (Options is not null)
                        {
                            <CommandGroup>
                                @foreach (var option in Options)
                                {
                                    var itemValue = option.Value;
                                    var displayText = option.Text;
                                    var selected = IsSelected(option);

                                    @* aria-selected 在命令项上表示"键盘聚焦"，所以被选中的值
                                       需要自己的标记，供重开时的滚动定位寻找。 *@
                                    <CommandItem Value="@itemValue?.ToString()" OnSelect="@(() => HandleSelect(option))" SearchText="@displayText"
                                                   data-atom-current="@(selected ? "true" : null)">
                                        @displayText
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             width="16"
                                             height="16"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2"
                                             stroke-linecap="round"
                                             stroke-linejoin="round"
                                             class="@($"atom:ms-auto atom:h-4 atom:w-4 atom:shrink-0 {(selected ? "atom:opacity-100" : "atom:opacity-0")}")"
                                             aria-label="@(selected ? "Selected" : "")">
                                            <path d="M20 6 9 17l-5-5" />
                                        </svg>
                                    </CommandItem>
                                }
                            </CommandGroup>
                        }
                        else if (ChildContent is not null)
                        {
                            @ChildContent
                        }
                    </CommandList>
                </Command>
                </CascadingValue>
            </AtomBlazor.PopoverContent>
        </Popover>
        @* 隐藏的注册通道（仅复合模式）。上面可交互的项活在弹层门户里，首次打开之前根本不会
           挂载——所以对于一个预先绑定的 Value，触发器会一直显示占位符，直到用户打开一次下拉。
           在这里把各项再渲染一遍——不可见、不可交互（见 RegistrationOnly）——让每一项在初始
           加载时就注册自己的显示文本，触发器于是能立刻解析出选中项的标题。 *@
        @if (Options is null && ChildContent is not null)
        {
            <div style="display:none" aria-hidden="true">
                <CascadingValue Name="@ComboboxConstants.RegistrationScopeName" Value="true" IsFixed="true">
                    @ChildContent
                </CascadingValue>
            </div>
        }
    </div>
</CascadingValue>
