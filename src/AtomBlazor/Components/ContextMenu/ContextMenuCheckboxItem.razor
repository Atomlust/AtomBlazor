@namespace AtomBlazor

@* 经过样式封装的 ContextMenuCheckboxItem - 使用 shadcn Tailwind 类的封装 *@
<AtomBlazor.Primitives.ContextMenuCheckboxItemPrimitive class="@CssClass"
                                                           Checked="@Checked"
                                                           CheckedChanged="@HandleCheckedChanged"
                                                           Disabled="@Disabled"
                                                           CloseOnSelect="@CloseOnSelect"
                                                           @attributes="AdditionalAttributes">
    <span class="@indicatorClass">
        @if (Checked)
        {
            <svg xmlns="http://www.w3.org/2000/svg"
                 width="16"
                 height="16"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 class="atom:h-4 atom:w-4">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
        }
    </span>
    @ChildContent
</AtomBlazor.Primitives.ContextMenuCheckboxItemPrimitive>

@code {
    /// <summary>
    /// 要在菜单项内显示的内容。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 应用于该菜单项的额外 CSS 类。
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// 获取或设置应用于根元素的额外 HTML 特性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// 复选框是否被选中。
    /// </summary>
    [Parameter]
    public bool Checked { get; set; }

    /// <summary>
    /// 选中状态发生变化时的事件回调。
    /// </summary>
    [Parameter]
    public EventCallback<bool> CheckedChanged { get; set; }

    /// <summary>
    /// 菜单项是否被禁用。
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; } = false;

    /// <summary>
    /// 切换此项时是否关闭上下文菜单。
    /// 默认值为 false。
    /// </summary>
    [Parameter]
    public bool CloseOnSelect { get; set; } = false;

    private async Task HandleCheckedChanged(bool value)
    {
        Checked = value;
        await CheckedChanged.InvokeAsync(value);
    }

    private string CssClass => ClassNames.cn(
        "atom:relative atom:flex atom:cursor-default atom:select-none atom:items-center atom:rounded-sm atom:py-1.5 atom:ps-8 atom:pe-2",
        "atom:text-sm atom:outline-none atom:transition-colors",
        "atom:focus:bg-(--atom-menu-accent) atom:focus:text-(--atom-menu-accent-foreground)",
        "atom:data-[disabled=true]:pointer-events-none atom:data-[disabled=true]:opacity-50",
        !Disabled ? "atom:hover:bg-(--atom-menu-accent) atom:hover:text-(--atom-menu-accent-foreground)" : null,
        Class
    );

    private const string indicatorClass = "atom:absolute atom:start-2 atom:flex atom:h-3.5 atom:w-3.5 atom:items-center atom:justify-center";
}
