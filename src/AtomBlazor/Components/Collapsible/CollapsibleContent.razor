@namespace AtomBlazor

<AtomBlazor.Primitives.CollapsibleContentPrimitive ForceMount="@ForceMount"
                                                          class="@GridCssClass"
                                                          @attributes="AdditionalAttributes">
    <div class="atom:overflow-hidden atom:min-h-0">
        <div class="@CssClass">
            @ChildContent
        </div>
    </div>
</AtomBlazor.Primitives.CollapsibleContentPrimitive>
