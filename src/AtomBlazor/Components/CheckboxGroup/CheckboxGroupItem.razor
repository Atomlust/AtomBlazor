@typeparam TValue
@namespace AtomBlazor

<div class="@CssClass" @attributes="AdditionalAttributes">
    <Checkbox Id="@itemId"
              Checked="@IsChecked"
              CheckedChanged="@HandleCheckedChanged"
              Disabled="@IsDisabled" />
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@itemId" class="@LabelCssClass">@Label</label>
    }
    @ChildContent
</div>
