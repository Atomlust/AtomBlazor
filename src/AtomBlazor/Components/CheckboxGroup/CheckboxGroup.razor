@typeparam TValue
@namespace AtomBlazor
@attribute [CascadingTypeParameter(nameof(TValue))]

<CascadingValue Value="context">
    <div class="@CssClass" role="group" aria-label="@AriaLabel" @attributes="AdditionalAttributes">
        @if (ShowSelectAll)
        {
            <div class="atom:flex atom:items-center atom:gap-2 atom:pb-2 atom:mb-1 atom:border-b">
                <Checkbox Checked="@IsAllSelected"
                          Indeterminate="@IsIndeterminate"
                          CheckedChanged="@HandleSelectAllChanged"
                          Disabled="@Disabled" />
                <span class="atom:text-sm atom:font-medium atom:leading-none">
                    @SelectAllLabel
                </span>
            </div>
        }
        @ChildContent
    </div>
</CascadingValue>
