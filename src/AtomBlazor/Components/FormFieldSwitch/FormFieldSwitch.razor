@namespace AtomBlazor
@inherits FormFieldBase

<FormFieldShell Orientation="@Orientation" IsInvalid="@IsInvalid" Class="@Class"
                Label="@Label" LabelFor="@ControlId" AssociateLabel
                HelperText="@HelperText" HelperTextId="@DescriptionId"
                ErrorText="@ErrorText" ErrorId="@ErrorId"
                HasEditContextErrors="@HasEditContextErrors" EditContextErrors="@EditContextErrors">
    <Control>
        <Switch Id="@ControlId"
                Checked="@Checked"
                CheckedChanged="HandleCheckedChanged"
                CheckedExpression="@CheckedExpression"
                Size="@Size"
                Disabled="@Disabled"
                AriaLabel="@AriaLabel"
                AriaDescribedBy="@DescribedById"
                Class="@InputClass"
                @attributes="AdditionalAttributes" />
    </Control>
</FormFieldShell>
