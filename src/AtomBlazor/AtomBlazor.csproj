<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <!-- 裁剪/AOT 兼容分析：trim 警告 + AOT 分析器 -->
    <IsAotCompatible>true</IsAotCompatible>
    <Version>0.7.1</Version>
    <!-- 作者与版权 -->
    <Authors>Atomlust Studio</Authors>
    <Company>Atomlust Studio</Company>
    <Copyright>Copyright © 2026 Atomlust Studio</Copyright>

    <!-- NuGet 包配置 -->
    <PackageId>AtomBlazor</PackageId>
    <RootNamespace>AtomBlazor</RootNamespace>
    <AssemblyName>AtomBlazor</AssemblyName>
    <Description>基于 AtomBlazor.Primitives 构建的预样式 Blazor 组件库，shadcn/ui 式设计 + Tailwind CSS，开箱即用、可定制。</Description>
    <PackageTags>blazor;ui;components;shadcn;tailwind;styled;design-system</PackageTags>

    <!-- 开发期使用 ProjectReference 打包时会出现 NU5104 预览版本警告，抑制之 -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- 第三方依赖版本与源项目对齐；net11 兼容性与裁剪警告由 tools/TrimProbe 冒烟验证 -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="TailwindMerge.NET" Version="1.5.0" />
    <PackageReference Include="Markdig" Version="1.4.1" />
    <PackageReference Include="Ical.Net" Version="5.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AtomBlazor.Primitives\AtomBlazor.Primitives.csproj" />
    <ProjectReference Include="..\AtomBlazor.Icons.Lucide\AtomBlazor.Icons.Lucide.csproj" />
  </ItemGroup>

  <!-- wwwroot 已走 RCL 静态资源（staticwebassets）机制提供，避免作为 NuGet contentFiles 重复打包 -->
  <ItemGroup>
    <Content Update="wwwroot\**" Pack="false" />
  </ItemGroup>

  <Import Project="..\..\tools\atom.tailwind.targets" />
</Project>
