@namespace AtomBlazor.Primitives

<div role="@(Decorative ? "none" : "separator")"
     aria-orientation="@(Decorative ? null : Orientation.ToString().ToLower())"
     data-orientation="@Orientation.ToString().ToLower()"
     @attributes="AdditionalAttributes">
</div>

@code {
    /// <summary>
    /// 获取或设置分隔符的方向。
    /// </summary>
    [Parameter]
    public SeparatorOrientation Orientation { get; set; } = SeparatorOrientation.Horizontal;

    /// <summary>
    /// 获取或设置分隔符是否为纯装饰性元素。
    /// 为 true（默认）时，分隔符携带 role="none"，对辅助技术不可见。
    /// 为 false 时，分隔符携带 role="separator" 并附带 aria-orientation。
    /// </summary>
    [Parameter]
    public bool Decorative { get; set; } = true;

    /// <summary>
    /// 获取或设置应用到分隔符元素上的额外属性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
