@typeparam TValue
@namespace AtomBlazor.Primitives
@using System.ComponentModel
@using AtomBlazor.Primitives.Services
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject IFocusManager FocusManager
@implements IAsyncDisposable

@*
    SelectContent 基元——headless 的下拉容器。
    借助 FloatingPortal 获得门户/定位基础设施。
    自身只保留 Select 专属行为：键盘导航、项焦点、ARIA 特性。
*@

@if (_context != null)
{
    <FloatingPortal IsOpen="@(_context.IsOpen)"
                    AnchorElement="@_context.State.TriggerElement"
                    PortalId="@_portalId"
                    Side="@Side"
                    Align="@Align"
                    Offset="@Offset"
                    MatchAnchorWidth="@MatchTriggerWidth"
                    Strategy="PositioningStrategy.Fixed"
                    ZIndex="9999"
                    ForceMount="false"
                    SideElementId="@_context.ContentId"
                    RestoreFocusToId="@_context.TriggerId"
                    RestoreFocusOnClose="@_context.State.RestoreFocusOnClose"
                    Dismiss="@BuildDismissOptions()"
                    Keyboard="@BuildKeyboardOptions()"
                    OnDismiss="@HandleDismiss">
        @RenderSelectListbox()
    </FloatingPortal>
}

@code {
    [CascadingParameter]
    private SelectContext<TValue>? _context { get; set; }

    private IJSObjectReference? _jsModule;
    private DotNetObjectReference<SelectContent<TValue>>? _dotNetRef;
    private bool _disposed = false;
    private string _portalId = "";

    /// <summary>
    /// 要在下拉容器内渲染的内容。
    /// 通常包含 SelectItem 组件。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 要应用到内容容器的附加特性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// 首选方位。默认为 Bottom。
    /// </summary>
    [Parameter]
    public PopoverSide Side { get; set; } = PopoverSide.Bottom;

    /// <summary>
    /// 相对触发器的对齐方式。默认为 Start。
    /// </summary>
    [Parameter]
    public PopoverAlign Align { get; set; } = PopoverAlign.Start;

    /// <summary>
    /// 与触发元素的偏移距离（像素）。默认为 4。
    /// </summary>
    [Parameter]
    public int Offset { get; set; } = 4;

    /// <summary>
    /// 内容宽度是否与触发器一致。
    /// 默认为 true（Select 的常见形态）。
    /// </summary>
    [Parameter]
    public bool MatchTriggerWidth { get; set; } = true;

    /// <summary>
    /// 获取或设置用户在下拉列表接近底部滚动时调用的回调。
    /// 用于无限滚动场景下加载后续条目。
    /// </summary>
    [Parameter]
    public Microsoft.AspNetCore.Components.EventCallback OnLoadMore { get; set; }

    /// <summary>
    /// 获取或设置是否正在加载后续条目。
    /// 为 true 时在列表底部显示加载指示，并在加载结束前抑制 <see cref="OnLoadMore"/>。
    /// </summary>
    [Parameter]
    public bool IsLoading { get; set; }

    /// <summary>
    /// 获取或设置在全部条目加载完毕后显示于列表底部的消息。
    /// 仅在 <see cref="IsLoading"/> 为 false 时显示。设为 <c>null</c> 或空串即隐藏。
    /// </summary>
    [Parameter]
    public string? EndOfListMessage { get; set; }

    protected override void OnInitialized()
    {
        if (_context == null)
        {
            throw new InvalidOperationException(
                "SelectContent 必须用在 Select 组件内部。" +
                "请确认 SelectContent 是某个 Select 组件的子级。");
        }

        _portalId = $"select-portal-{_context.ContentId}";
        _dotNetRef = DotNetObjectReference.Create(this);

        // 订阅上下文状态变化，用于清理
        _context.OnStateChanged += HandleContextStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (_jsModule == null)
            {
                _jsModule = await PrimitiveModules.GetAsync(JS);
            }
        }
    }

    private RenderFragment RenderSelectListbox() => builder =>
    {
        // 经门户重新级联 SelectContext，让 SelectItem 组件能取到它
        builder.OpenComponent<CascadingValue<SelectContext<TValue>>>(0);
        builder.AddAttribute(1, "Value", _context);
        builder.AddAttribute(2, "IsFixed", true);
        builder.AddAttribute(3, "ChildContent", (RenderFragment)(contentBuilder =>
        {
            contentBuilder.OpenElement(0, "div");
            contentBuilder.AddAttribute(1, "id", _context!.ContentId);
            contentBuilder.AddAttribute(2, "role", "listbox");
            contentBuilder.AddAttribute(3, "aria-labelledby", _context.TriggerId);
            contentBuilder.AddAttribute(5, "data-select-content", "true");
            contentBuilder.AddAttribute(6, "tabindex", "-1");
            contentBuilder.AddAttribute(7, "data-state", _context.IsOpen ? "open" : "closed");
            // 写的是它声明时的方位，不是它最终落到的方位。JS 一拿到测量结果就会覆盖它，
            // 并在滚动导致列表框翻转时保持更新。C# 渲染一个永不变化的值，
            // Blazor 因此不会为它发出 diff，也永远不会把 JS 写好的特性抹掉。
            contentBuilder.AddAttribute(8, "data-side", Side.ToValue());
            contentBuilder.AddMultipleAttributes(9, AdditionalAttributes);
            contentBuilder.AddContent(10, ChildContent);
            contentBuilder.CloseElement();
        }));
        builder.CloseComponent();
    };

    // 这里是"声明"而非"接线"，而且 C# 侧已完全不主动触发它。
    //
    // 过去，把列表框滚动到选中项、挂上键盘处理器，都从门户的 ready 回调发起；
    // 在 Blazor Server 上，该回调要等浏览器确认了承载内容的渲染批次才会运行。
    // 于是列表出现之前被压上了整整一个往返：先是不滚动、对方向键充耳不闻地出现，
    // 之后才慢慢追上。
    //
    // FloatingPortal 现在把这些都放进"定位并揭示列表框"的那
    // 一次调用里、在揭示之前完成——列表第一帧上屏时就已经滚动到位、键盘就绪。
    private FloatingKeyboardOptions? BuildKeyboardOptions()
    {
        if (_context == null)
        {
            return null;
        }

        // 不设"我是否已经接好线"的标记，这里也没有副作用。本方法每次渲染都会跑，
        // 而不是只在打开时跑——若用首帧置位的标记，等用户真的打开列表框时它早已是
        // "接过线"的状态，处理器反而永远接不上。select.setupKeyboardNavigation 在为
        // 这个 content id 接线之前会先释放它找到的旧处理器，所以每次打开都提这个请求
        // 是幂等的。
        return new FloatingKeyboardOptions
        {
            Kind = FloatingKeyboardKind.Listbox,
            ContentId = _context.ContentId,
            SelectedValue = _context.State.Value?.ToString(),
            CallbackRef = _dotNetRef
        };
    }

    // 同样是"声明"而非"接线"。FloatingPortal 把监听器注册在
    // 定位并揭示列表框的那一次 interop 调用里；事后再在这里接线要多付一个网络往返，
    // 而在它送达之前，列表框已在屏幕上、却对窗外点击毫无反应。
    //
    // Escape 不在这里列出：Select 通过 select.setupKeyboardNavigation 监听它——
    // 那个处理器同时负责 Tab 与方向键——再加一个 document 监听器只会让关闭发生两次。
    private FloatingDismissOptions? BuildDismissOptions()
    {
        if (_context == null)
        {
            return null;
        }

        return new FloatingDismissOptions
        {
            ContentId = _context.ContentId,
            TriggerId = _context.TriggerId,
            OnOutsideInteraction = true
        };
    }

    private void HandleDismiss(FloatingDismissReason reason)
    {
        if (_disposed || reason != FloatingDismissReason.OutsideInteraction) { return; }

        _context?.Close();
    }

    private void HandleContextStateChanged()
    {
        _ = InvokeAsync(HandleContextStateChangedAsync);
    }

    private Task HandleContextStateChangedAsync()
    {
        try
        {
            // 上下文关闭时做清理
            if (_context?.IsOpen == false)
            {
                // 在拆退之前同时捕获触发元素引用与焦点归还标记。
                // 此刻 State.TriggerElement 仍是有值的（Close() 不会清它），
                // 但我们抢先读出来，以防有别的东西改动状态。
                // 焦点是在 overlay.close 内部、经上面门户的 RestoreFocusToId 与
                // RestoreFocusOnClose 回到触发器的——且只在有意关闭时。
                // 从这里 await FocusAsync，过去每次 Escape、每次选中都要多付一个往返。
                StateHasChanged();
            }
        }
        catch (Exception ex) when (ex is ObjectDisposedException or TaskCanceledException)
        {
            // 组件可能在异步操作期间被释放
        }

        return Task.CompletedTask;
    }

    // Cleanup 有两个调用方——上下文状态变化处理器（列表框关闭时）与 DisposeAsync
    // （组件拆退时）——关闭与拆退相撞时两者会同时在途。因此每段代码都要先"接管"
    // 自己即将释放的东西：在第一个 await 之前就把字段清空，让第二个调用方无物可放，
    // 而不是去解引用一个被挂起的首个调用方置空的字段。过去在 await 之后读字段会抛
    // NullReferenceException，而这里没有筛选器接得住它，于是异常从 DisposeAsync 逃逸
    // 进渲染器的释放队列，把整条电路带崩（#441）。
    private async Task CleanupAsync()
    {
        // 现在只有释放路径会走到这里。关闭时的列表框处理器释放在 overlay.close 内部、
        // 与隐藏元素的同一次调用中完成——过去它是一次单独 await 的 interop 调用，
        // 等于花一个往返去移除两个事件监听器，而那个浮层用户早已关掉了。
        var module = _jsModule;
        var contentId = _context?.ContentId;
        if (module != null && contentId != null)
        {
            try
            {
                await module.InvokeVoidAsync("select.cleanupKeyboardNavigation", contentId);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
            {
                // JS 模块可能已释放，或电路已断开
            }
        }
    }

    /// <summary>
    /// 由 JavaScript 在按下 Escape 键时调用。
    /// </summary>
    [JSInvokable]
    [EditorBrowsable(EditorBrowsableState.Never)]
    public void JsOnEscapeKey()
    {
        if (_disposed) { return; }
        // Escape 属于有意的关闭——把焦点归还给触发器。
        _context?.Close(restoreFocus: true);
    }

    /// <summary>
    /// 由 JavaScript 在按下 Tab 键时调用。
    /// </summary>
    [JSInvokable]
    [EditorBrowsable(EditorBrowsableState.Never)]
    public void JsOnTabKey()
    {
        if (_disposed) { return; }
        _context?.Close();
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) { return; }
        _disposed = true;

        if (_context != null)
        {
            _context.OnStateChanged -= HandleContextStateChanged;
        }

        try
        {
            await CleanupAsync();
        }
        catch (Exception)
        {
            // 释放运行在渲染器的释放队列内部，任何逃逸的异常都是未处理的，
            // 会把整条电路带崩。拆退时的清理失败不值得付出这个代价，到此为止——
            // 它能撞上的竞态已在上面处理。
        }



        _dotNetRef?.Dispose();
    }
}
