@typeparam TValue
@namespace AtomBlazor.Primitives
@implements IDisposable

@* SelectItem 基元——headless 的可选项 *@
@if (_context != null)
{
    <div id="@ItemId"
         role="option"
         aria-selected="@IsSelected.ToString().ToLower()"
         data-state="@(IsSelected ? "checked" : "unchecked")"
         data-disabled="@(Disabled ? "true" : null)"
         @onclick="HandleClick"
         @onclick:stopPropagation="true"
         @attributes="MergedAttributes">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            @(Text ?? Value?.ToString())
        }
    </div>
}

@code {
    [CascadingParameter]
    private SelectContext<TValue>? _context { get; set; }

    private string _itemId = "";

    // ShouldRender 跟踪字段
    private bool lastIsSelected;
    private bool lastDisabled;

    // MergedAttributes 缓存字段
    private Dictionary<string, object>? cachedMergedAttributes;
    private string? cachedItemClass;
    private Dictionary<string, object>? cachedAdditionalAttributes;

    /// <summary>
    /// 本项所代表的值。
    /// </summary>
    [Parameter, EditorRequired]
    public TValue? Value { get; set; }

    /// <summary>
    /// 项的展示文本。用于触发器显示与搜索。
    /// 未提供时回退到 Value.ToString()。
    /// </summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>
    /// 本项是否禁用、不可选中。
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// 本项要渲染的内容。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 要应用到项元素的附加特性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private Dictionary<string, object>? MergedAttributes
    {
        get
        {
            var itemClass = _context?.ItemClass;

            // 输入未变时直接返回缓存结果
            if (itemClass == cachedItemClass && ReferenceEquals(AdditionalAttributes, cachedAdditionalAttributes))
            {
                return cachedMergedAttributes;
            }

            // 重建并缓存
            cachedItemClass = itemClass;
            cachedAdditionalAttributes = AdditionalAttributes;

            if (string.IsNullOrEmpty(itemClass))
            {
                cachedMergedAttributes = AdditionalAttributes;
            }
            else
            {
                var merged = AdditionalAttributes != null
                    ? new Dictionary<string, object>(AdditionalAttributes)
                    : new Dictionary<string, object>();

                if (merged.TryGetValue("class", out var existing))
                {
                    merged["class"] = $"{itemClass} {existing}";
                }
                else
                {
                    merged["class"] = itemClass;
                }

                cachedMergedAttributes = merged;
            }

            return cachedMergedAttributes;
        }
    }

    private int CurrentIndex => _context != null ? _context.GetItemIndex(_itemId) : -1;

    private string ItemId => _context != null ? $"{_context.ContentId}-item-{_itemId}" : "";

    private bool IsSelected
    {
        get
        {
            if (_context == null) return false;

            if (_context.Value == null && Value == null)
                return true;

            return EqualityComparer<TValue?>.Default.Equals(_context.Value, Value);
        }
    }

    // data-focused 被刻意从本组件中剔除，两个方向都是如此：上面不渲染它，
    // 这里也不跟踪它。
    //
    // 高亮由 select.js 全权负责——方向键与悬停时由它设置 data-focused，
    // 并同步写下列表框的 aria-activedescendant。让 C# 也渲染它不仅是多余，而且是错误：
    // Blazor 对特性的 diff 参照的是它上一次渲染出的内容而不是 DOM 的现状，
    // 于是 C# 在 JS 已高亮的项上渲染"没有 data-focused"不会产生 diff，高亮原样留在原地。
    // 先用键盘、再用鼠标移动高亮时，会同时点亮两个项。
    //
    // 它过去还要为每次按键、每次悬停各付一个电路往返，去挪一个浏览器早已挪好的高亮。
    protected override bool ShouldRender()
    {
        var currentIsSelected = IsSelected;

        if (currentIsSelected != lastIsSelected || Disabled != lastDisabled)
        {
            lastIsSelected = currentIsSelected;
            lastDisabled = Disabled;
            return true;
        }

        return false;
    }

    protected override void OnInitialized()
    {
        if (_context == null) return;

        // 取展示文本——优先 Text 参数，否则回退到 Value 的字符串形式
        var displayText = Text ?? Value?.ToString();

        // 把本项注册进上下文，供键盘导航使用
        _itemId = _context.RegisterItem(Value, Disabled, displayText);

        // 初始化 ShouldRender 跟踪，与初始状态对齐
        lastIsSelected = IsSelected;
        lastDisabled = Disabled;

        // 订阅状态变化以更新焦点
        _context.OnStateChanged += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        StateHasChanged();
    }

    private void HandleClick()
    {
        if (_context == null || Disabled || _context.Disabled) return;

        // 取展示文本——优先 Text 参数，否则回退到 Value 的字符串形式
        var displayText = Text ?? Value?.ToString();

        _context.SelectValue(Value, displayText);
    }

    public void Dispose()
    {
        if (_context != null)
        {
            _context.OnStateChanged -= HandleStateChanged;
            _context.UnregisterItem(_itemId);
        }
    }
}
