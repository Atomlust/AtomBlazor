@namespace AtomBlazor.Primitives
@using AtomBlazor.Primitives.Utilities
@inject IServiceProvider Services

@* Tooltip 触发器——悬停或聚焦时展开提示气泡 *@
@if (AsChild)
{
    @* AsChild 为真时，把触发器上下文级联给子组件，由子组件自行消费 *@
    <CascadingValue Value="TriggerContext" Name="TriggerContext">
        @ChildContent
    </CascadingValue>
}
else
{
    <span @ref="@_triggerRef"
          id="@Context.TriggerId"
          @onmouseenter="HandleMouseEnter"
          @onmouseleave="HandleMouseLeave"
          @onfocus="HandleFocus"
          @onblur="HandleBlur"
          @attributes="AdditionalAttributes"
          tabindex="@(Focusable ? "0" : null)"
          aria-describedby="@(Context.IsOpen ? Context.TooltipId : null)">
        @ChildContent
    </span>
}

@code {
    [CascadingParameter]
    private TooltipContext Context { get; set; } = null!;

    /// <summary>
    /// 接收来自父级的 TriggerContext（例如 DialogTriggerPrimitive、SheetTriggerPrimitive、DropdownMenuTriggerPrimitive），
    /// 使基于悬停的触发器能把父级的点击/ARIA 行为与自身的悬停/聚焦行为合并。
    /// </summary>
    [CascadingParameter(Name = "TriggerContext")]
    private TriggerContext? ParentTriggerContext { get; set; }

    private ElementReference _triggerRef;

    /// <summary>
    /// 触发器内渲染的内容。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 为 true 时触发器不渲染自己的元素，只级联
    /// <see cref="Utilities.TriggerContext"/>，由子组件负责消费该上下文并完成接线：
    /// 把触发器 id 与 aria 特性挂到自己的元素上，并调用 <c>OnMouseEnter</c>/<c>OnMouseLeave</c>、
    /// <c>OnFocus</c>/<c>OnBlur</c> 与 <c>SetTriggerElement</c>。
    /// </summary>
    /// <remarks>
    /// 此模式下既不渲染元素也不挂处理器，因此忽略该上下文的子组件将没有任何东西
    /// 监听悬停或聚焦，气泡永远不会展开。纯标记、纯文本或裸图标（例如 <c>LucideIcon</c>）
    /// 需要 <c>AsChild="false"</c>，让触发器渲染自带处理器的 <c>span</c>。
    /// 只有会消费 <see cref="Utilities.TriggerContext"/> 的子组件（即为触发器角色而建的组件）
    /// 才应使用 <c>AsChild="true"</c>。未消费的上下文会在 Development 环境下
    /// 经 <c>ILogger</c> 报告为警告。
    /// </remarks>
    [Parameter]
    public bool AsChild { get; set; } = false;

    /// <summary>
    /// 追加到触发器元素上的附加属性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// 触发器是否可被键盘聚焦，默认 true。
    /// 子内容本身已可聚焦时请设为 false。
    /// </summary>
    [Parameter]
    public bool Focusable { get; set; } = true;

    /// <summary>
    /// 自定义 mouseenter 处理器。提供时，除默认展开行为外还会调用它。
    /// </summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnMouseEnter { get; set; }

    /// <summary>
    /// 自定义 mouseleave 处理器。提供时，除默认收起行为外还会调用它。
    /// </summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnMouseLeave { get; set; }

    /// <summary>
    /// 使用 AsChild 模式时缓存的触发器元素引用。
    /// </summary>
    private ElementReference? _asChildTriggerRef;

    /// <summary>
    /// 缓存的触发器上下文，避免每次渲染都新建实例。
    /// </summary>
    private TriggerContext? _cachedTriggerContext;

    /// <summary>
    /// AsChild 为真时传给子组件的上下文。存在父级 TriggerContext（例如来自 DialogTriggerPrimitive）时，
    /// 会把父级的点击/ARIA 行为与 Tooltip 的悬停/聚焦行为合并，使嵌套触发器正常工作。
    /// </summary>
    private TriggerContext TriggerContext => _cachedTriggerContext ??= new()
    {
        TriggerId = ParentTriggerContext?.TriggerId ?? Context.TriggerId,
        IsOpen = ParentTriggerContext?.IsOpen ?? Context.IsOpen,
        Toggle = ParentTriggerContext?.Toggle,
        Open = () => Context.Open(_asChildTriggerRef),
        Close = () => Context.Close(),
        AriaHasPopup = ParentTriggerContext?.AriaHasPopup,
        AriaControls = ParentTriggerContext?.AriaControls,
        OnKeyDown = ParentTriggerContext?.OnKeyDown,
        OnMouseEnter = () => Context.Open(_asChildTriggerRef),
        OnMouseLeave = () => Context.Close(),
        OnFocus = () => Context.Open(_asChildTriggerRef),
        OnBlur = () => Context.Close(),
        SetTriggerElement = (el) =>
        {
            _asChildTriggerRef = el;
            ParentTriggerContext?.SetTriggerElement?.Invoke(el);
        }
    };

    private async Task HandleMouseEnter(MouseEventArgs args)
    {
        // 展开气泡并记下触发器元素供定位使用
        Context.Open(_triggerRef);

        // 有自定义处理器时一并调用
        if (OnMouseEnter.HasDelegate)
        {
            await OnMouseEnter.InvokeAsync(args);
        }
    }

    private async Task HandleMouseLeave(MouseEventArgs args)
    {
        // 收起气泡
        Context.Close();

        // 有自定义处理器时一并调用
        if (OnMouseLeave.HasDelegate)
        {
            await OnMouseLeave.InvokeAsync(args);
        }
    }

    private void HandleFocus(FocusEventArgs args)
    {
        // 为键盘用户在聚焦时展开
        Context.Open(_triggerRef);
    }

    private void HandleBlur(FocusEventArgs args)
    {
        // 失焦时收起
        Context.Close();
    }

    protected override void OnInitialized()
    {
        if (Context == null)
        {
            throw new InvalidOperationException(
                "TooltipTriggerPrimitive 必须在 Tooltip 组件内使用。" +
                "请确保 TooltipTriggerPrimitive 是 Tooltip 组件的子组件。");
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // 主动写入触发器元素引用，使气泡以编程方式（经 @bind-Open）展开时元素也已就位
        if (!AsChild)
        {
            Context.SetTriggerElement(_triggerRef);
        }
        else if (_asChildTriggerRef.HasValue)
        {
            // AsChild 模式下由子组件（例如 Button）经 TriggerContext.SetTriggerElement
            // 写入 _asChildTriggerRef，此处再向上传播，使内容侧可相对于它定位。
            Context.SetTriggerElement(_asChildTriggerRef.Value);
        }

        if (firstRender)
        {
            WarnIfTriggerContextUnconsumed();
        }
    }

    private static readonly AsChildTriggerDescription diagnostic = new("TooltipTriggerPrimitive", "展开此提示气泡", "<span> 包裹层");

    private void WarnIfTriggerContextUnconsumed() =>
        AsChildDiagnostics.WarnIfUnconsumed<TooltipTriggerPrimitive>(Services, diagnostic, AsChild, _cachedTriggerContext, AdditionalAttributes);
}
