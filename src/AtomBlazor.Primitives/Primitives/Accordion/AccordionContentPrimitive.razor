@namespace AtomBlazor.Primitives

@* AccordionContentPrimitive 基元——Accordion 条目的可折叠内容区域 *@
@if (_shouldRender)
{
    <div id="@Item.ContentId"
         role="region"
         aria-labelledby="@Item.TriggerId"
         data-state="@(Item.IsOpen ? "open" : "closed")"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    private bool _shouldRender => ForceMount || Item.IsOpen;

    /// <summary>
    /// 级联参数，接收父级 Accordion 条目。
    /// </summary>
    [CascadingParameter]
    public AccordionItemPrimitive Item { get; set; } = null!;

    /// <summary>
    /// 本条目展开时要渲染的子内容。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 条目关闭时是否仍强制挂载内容。
    /// 为 true 时内容保持挂载（配合样式可用于 CSS 动画）。
    /// 为 false（默认）时内容在关闭后卸载。
    /// </summary>
    [Parameter]
    public bool ForceMount { get; set; } = false;

    /// <summary>
    /// 要应用到内容区域元素的额外属性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnInitialized()
    {
        if (Item == null)
        {
            throw new InvalidOperationException("AccordionContentPrimitive 必须在 AccordionItemPrimitive 组件内使用。");
        }
    }
}
