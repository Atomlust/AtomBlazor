@namespace AtomBlazor.Primitives
@implements IDisposable

@* AccordionTrigger 基元——Accordion 条目的可点击触发按钮 *@
@HeadingFragment

@code {
    private string _ariaExpanded => Item.IsOpen ? "true" : "false";
    private bool _shouldPreventDefault;
    private ElementReference _elementRef;

    /// <summary>
    /// 级联参数，接收父级 Accordion 组件，用于键盘导航。
    /// </summary>
    [CascadingParameter]
    public AccordionPrimitive? Accordion { get; set; }

    /// <summary>
    /// 级联参数，接收父级 Accordion 条目。
    /// </summary>
    [CascadingParameter]
    public AccordionItem Item { get; set; } = null!;

    /// <summary>
    /// 在触发按钮内渲染的子内容。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 要应用到触发按钮元素的 CSS 类。
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// 要应用到触发按钮元素的额外属性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// 标题包裹层使用的 HTML 元素标签。
    /// 默认值为 "h3"。
    /// </summary>
    [Parameter]
    public string As { get; set; } = "h3";

    /// <summary>
    /// 获取本触发器所属条目是否被禁用。
    /// </summary>
    internal bool Disabled => Item.Disabled;

    /// <summary>
    /// 获取标识本触发器所属 Accordion 条目的值。
    /// </summary>
    internal string Value => Item.Value;

    private RenderFragment HeadingFragment => builder =>
    {
        builder.OpenElement(0, As);
        builder.AddAttribute(1, "id", Item.HeaderId);
        builder.AddContent(2, ButtonContent);
        builder.CloseElement();
    };

    private RenderFragment ButtonContent => __builder =>
    {
        <button id="@Item.TriggerId"
                type="button"
                class="@Class"
                aria-expanded="@_ariaExpanded"
                aria-controls="@Item.ContentId"
                data-state="@(Item.IsOpen ? "open" : "closed")"
                disabled="@Item.Disabled"
                @onclick="HandleClick"
                @onkeydown="HandleKeyDown"
                @onkeydown:preventDefault="_shouldPreventDefault"
                @ref="_elementRef"
                @attributes="AdditionalAttributes">
            @ChildContent
        </button>
    };

    protected override void OnInitialized()
    {
        if (Item == null)
        {
            throw new InvalidOperationException("AccordionTrigger 必须在 AccordionItem 组件内使用。");
        }

       Accordion?.RegisterTrigger(this);
    }

    private void HandleClick()
    {
        if (!Item.Disabled)
        {
            Item.Toggle();
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        bool isNavKey = e.Key is "ArrowDown" or "ArrowUp" or "Home" or "End";
        _shouldPreventDefault = isNavKey;

        if (Item.Disabled)
        {
            return;
        }

        // 方向键、Home、End 用于在触发器之间导航
        if (Accordion != null && isNavKey)
        {
            Accordion.HandleKeyNavigation(Item.Value, e.Key);
        }
    }

    /// <summary>
    /// 让本触发器元素获得焦点。
    /// </summary>
    internal async Task FocusAsync()
    {
        try
        {
            await _elementRef.FocusAsync();
        }
        catch
        {
            // 忽略焦点错误（元素可能尚未渲染）
        }
    }

    public void Dispose()
    {
       Accordion?.UnregisterTrigger(this);
    }
}
