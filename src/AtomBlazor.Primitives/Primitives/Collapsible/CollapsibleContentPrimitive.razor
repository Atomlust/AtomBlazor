@namespace AtomBlazor.Primitives

@* CollapsibleContentPrimitive 基元——可折叠内容区域 *@
@if (_shouldRender)
{
    <div role="region"
         data-state="@(Context?.Open ?? false ? "open" : "closed")"
         aria-hidden="@((Context?.Open ?? false) ? "false" : "true")"
         @attributes="AdditionalAttributes">
        <CascadingValue TValue="CollapsibleContext" Value="@null" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </div>
}
