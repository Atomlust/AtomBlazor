@namespace AtomBlazor.Primitives
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@* ScrollArea scrollbar——带 ARIA scrollbar 角色的自定义滚动条轨道。 *@

<div @ref="scrollbarRef"
     id="@ScrollbarId"
     role="scrollbar"
     aria-controls="@Context!.ViewportId"
     aria-orientation="@Orientation.ToString().ToLower()"
     aria-valuenow="@scrollValue"
     aria-valuemin="0"
     aria-valuemax="100"
     data-orientation="@Orientation.ToString().ToLower()"
     data-state="@dataState"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private ElementReference scrollbarRef;
    private IJSObjectReference? jsModule;
    private DotNetObjectReference<ScrollAreaScrollbar>? dotNetRef;
    private string instanceId = Guid.NewGuid().ToString("N");
    private bool jsInitialized;
    private bool disposed;
    private int scrollValue;
    private string dataState = "hidden";

    [CascadingParameter]
    private ScrollAreaContext? Context { get; set; }

    /// <summary>
    /// 获取或设置滚动条方向。默认为 Vertical。
    /// </summary>
    [Parameter]
    public ScrollAreaOrientation Orientation { get; set; } = ScrollAreaOrientation.Vertical;

    /// <summary>
    /// 获取或设置子内容（通常是 ScrollAreaThumb）。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 获取或设置应用到滚动条元素的附加属性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ScrollbarId => Orientation == ScrollAreaOrientation.Vertical
        ? Context!.ScrollbarVerticalId
        : Context!.ScrollbarHorizontalId;

    /// <summary>
    /// 获取滚动条轨道的元素引用，供 JS 互操作使用。
    /// </summary>
    internal ElementReference ScrollbarElement => scrollbarRef;

    protected override void OnInitialized()
    {
        if (Context == null)
        {
            throw new InvalidOperationException(
                "ScrollAreaScrollbar 必须在 ScrollArea 组件内使用。");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeJsAsync();
        }
    }

    private async Task InitializeJsAsync()
    {
        if (jsInitialized)
        {
            return;
        }

        try
        {
            jsModule = await PrimitiveModules.GetAsync(JSRuntime);
            dotNetRef = DotNetObjectReference.Create(this);

            var viewportEl = await jsModule.InvokeAsync<IJSObjectReference>(
"scrollArea.getViewportElement", Context!.ViewportId);

            await jsModule.InvokeVoidAsync("scrollArea.initialize", instanceId, viewportEl,
                scrollbarRef, dotNetRef,
                new { orientation = Orientation.ToString().ToLower() });
            jsInitialized = true;
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            // 电路断开期间属预期情况
        }
        catch (InvalidOperationException)
        {
            // 预渲染期间 JS 互操作不可用
        }
    }

    /// <summary>
    /// 由 JS 在滚动位置变化时调用。
    /// </summary>
    [JSInvokable]
    [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
    public void JsUpdateScrollState(int value, string state)
    {
        if (disposed)
        {
            return;
        }

        scrollValue = Math.Max(0, Math.Min(100, value));
        dataState = state;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        GC.SuppressFinalize(this);
        disposed = true;
        if (jsModule != null && jsInitialized)
        {
            try
            {
                await jsModule.InvokeVoidAsync("scrollArea.dispose", instanceId);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
            {
                // 电路断开期间属预期情况
            }
        }
        dotNetRef?.Dispose();
    }
}
