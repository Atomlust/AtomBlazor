@namespace AtomBlazor.Primitives

@*
    AlertDialog 内容——使用 role="alertdialog" 并禁用 Esc 键关闭。
    已启用焦点陷阱与滚动锁定。
*@

<AtomBlazor.Primitives.DialogContentPrimitive
    role="alertdialog"
    CloseOnEscape="false"
    TrapFocus="true"
    LockScroll="true"
    @attributes="AdditionalAttributes">
    @ChildContent
</AtomBlazor.Primitives.DialogContentPrimitive>

@code {
    /// <summary>
    /// 在警告对话框内渲染的内容。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 附加特性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
