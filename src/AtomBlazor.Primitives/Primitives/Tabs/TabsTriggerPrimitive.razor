@namespace AtomBlazor.Primitives
@implements IDisposable

@* TabsTriggerPrimitive 基元——可点击的标签按钮 *@
<button id="@_triggerId"
        type="button"
        role="tab"
        aria-selected="@(_isSelected ? "true" : "false")"
        aria-controls="@_contentId"
        data-state="@(_isSelected ? "active" : "inactive")"
        tabindex="@_tabIndex"
        disabled="@Disabled"
        @onclick="HandleClick"
        @onkeydown="HandleKeyDown"
        @ref="_elementRef"
        @attributes="AdditionalAttributes">
    @ChildContent
</button>

@code {
    private ElementReference _elementRef;
    private string _triggerId => Context.GetTriggerId(Value);
    private string _contentId => Context.GetContentId(Value);
    private bool _isSelected => Context.IsTabActive(Value);
    private int _tabIndex => _isSelected ? 0 : -1;

    /// <summary>
    /// 用于接收 Tabs 上下文的级联参数。
    /// </summary>
    [CascadingParameter]
    public TabsContext Context { get; set; } = null!;

    /// <summary>
    /// 用于接收父级标签列表的级联参数。
    /// </summary>
    [CascadingParameter]
    public TabsListPrimitive? List { get; set; }

    /// <summary>
    /// 标识本标签页的值。
    /// 用于与 TabsContentPrimitive 组件配对。
    /// </summary>
    [Parameter, EditorRequired]
    public string Value { get; set; } = string.Empty;

    /// <summary>
    /// 本标签触发器是否禁用。
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// 在标签触发器内渲染的子内容。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 要应用到标签触发器按钮元素的额外属性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// 标签请求关闭时调用的回调，即该标签获得焦点时按下 Delete 或 Backspace。
    /// </summary>
    /// <remarks>
    /// 之所以需要这条按键通路，是因为画在标签内部的关闭按钮不能是自成一体的 button——
    /// 一个 <c>role="tab"</c> 元素不得包含另一个可交互元素——所以指针得到图标、键盘得到本回调。
    /// 不设置它，这两个按键就什么都不做。
    /// </remarks>
    [Parameter]
    public EventCallback OnCloseRequested { get; set; }

    /// <summary>
    /// 标签请求重命名时调用的回调，即该标签获得焦点时按下 F2。
    /// </summary>
    [Parameter]
    public EventCallback OnRenameRequested { get; set; }

    /// <summary>
    /// 标签请求移动时调用的回调，-1 表示向列表起始方向移动一格、1 表示向列表末尾方向移动。
    /// 由 Ctrl 加方向键触发。
    /// </summary>
    /// <remarks>
    /// 该增量已经依照书写方向求解，所以在从左到右的页面里 Ctrl 加左方向键把标签移到列表
    /// 更靠前的位置，在从右到左的页面里则移到更靠后的位置。
    /// 两者都是阅读者眼中的"左边"。
    /// </remarks>
    [Parameter]
    public EventCallback<int> OnMoveRequested { get; set; }

    /// <summary>获取本标签是否有可发送移动请求的去向。</summary>
    internal bool CanMove => OnMoveRequested.HasDelegate;

    /// <summary>请求属主把本标签移动一格。</summary>
    /// <param name="delta">-1 向列表起始方向、1 向列表末尾方向。</param>
    internal Task RequestMoveAsync(int delta) => OnMoveRequested.InvokeAsync(delta);

    protected override void OnInitialized()
    {
        if (Context == null)
        {
            throw new InvalidOperationException("TabsTriggerPrimitive 必须在 Tabs 组件内使用。");
        }

        // 注册到列表以获得键盘导航
        List?.RegisterTrigger(this);

        // 订阅上下文变化以更新选中状态
        Context.OnStateChanged += StateHasChanged;
    }

    private void HandleClick()
    {
        if (!Disabled)
        {
            Activate();
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (Disabled) return;

        // 处理激活按键
        if (e.Key == "Enter" || e.Key == " ")
        {
            Activate();
            return;
        }

        // Delete 关闭，F2 重命名。二者在属主未接线时都是惰性的，所以普通标签列表的行为
        // 与从前分毫不差。
        if (e.Key is "Delete" or "Backspace" && OnCloseRequested.HasDelegate)
        {
            _ = OnCloseRequested.InvokeAsync();
            return;
        }

        if (e.Key == "F2" && OnRenameRequested.HasDelegate)
        {
            _ = OnRenameRequested.InvokeAsync();
            return;
        }

        // 处理导航按键——只传递与排列方向相符的方向键
        if (List != null)
        {
            var isHorizontal = Context.Orientation == TabsOrientation.Horizontal;
            var isRelevantArrow = (isHorizontal && e.Key is "ArrowLeft" or "ArrowRight") ||
                                 (!isHorizontal && e.Key is "ArrowUp" or "ArrowDown");

            // Ctrl 加方向键移动标签而非移动焦点。先于普通方向键分支判断，
            // 否则同一个键会既重排又导航。
            if (isRelevantArrow && (e.CtrlKey || e.MetaKey))
            {
                if (CanMove)
                {
                    List.HandleMoveRequest(Value, e.Key);
                }

                return;
            }

            if ((isRelevantArrow || e.Key is "Home" or "End") && !e.CtrlKey && !e.MetaKey)
            {
                List.HandleKeyNavigation(Value, e.Key);
            }
        }
    }

    /// <summary>
    /// 激活本标签（将其设为激活标签页）。
    /// </summary>
    internal void Activate()
    {
        if (!Disabled)
        {
            Context.SetActiveTab(Value);
        }
    }

    /// <summary>
    /// 让本标签触发器元素获得焦点。
    /// </summary>
    internal async Task FocusAsync()
    {
        try
        {
            await _elementRef.FocusAsync();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
        {
            // 元素可能尚未渲染，或电路已断开
        }
    }

    public void Dispose()
    {
        List?.UnregisterTrigger(this);
        Context.OnStateChanged -= StateHasChanged;
    }
}
