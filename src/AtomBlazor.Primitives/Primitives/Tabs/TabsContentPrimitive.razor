@namespace AtomBlazor.Primitives
@implements IDisposable

@* TabsContentPrimitive 基元——某个标签页的内容面板 *@
@if (_isActive || ForceMount)
{
    <div id="@_contentId"
         role="tabpanel"
         aria-labelledby="@_triggerId"
         tabindex="0"
         hidden="@(!_isActive)"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    private string _contentId => Context.GetContentId(Value);
    private string _triggerId => Context.GetTriggerId(Value);
    private bool _isActive => Context.IsTabActive(Value);

    /// <summary>
    /// 用于接收 Tabs 上下文的级联参数。
    /// </summary>
    [CascadingParameter]
    public TabsContext Context { get; set; } = null!;

    /// <summary>
    /// 标识本内容面板的值。
    /// 必须与对应 TabsTriggerPrimitive 的 Value 一致。
    /// </summary>
    [Parameter, EditorRequired]
    public string Value { get; set; } = string.Empty;

    /// <summary>
    /// 本标签页激活时要渲染的子内容。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 要应用到内容面板元素的额外属性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// 是否即使在非激活状态下也强制挂载内容。
    /// 为 false（默认）时，内容在标签页非激活时卸载。
    /// 为 true 时，内容保持挂载但被隐藏。
    /// </summary>
    [Parameter]
    public bool ForceMount { get; set; } = false;

    protected override void OnInitialized()
    {
        if (Context == null)
        {
            throw new InvalidOperationException("TabsContentPrimitive 必须在 Tabs 组件内使用。");
        }

        // 订阅上下文变化以更新激活状态
        Context.OnStateChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Context.OnStateChanged -= StateHasChanged;
    }
}
