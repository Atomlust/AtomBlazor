@namespace AtomBlazor.Primitives
@using System.ComponentModel
@using AtomBlazor.Primitives.Services
@inject IJSRuntime JSRuntime
@inject IFocusManager FocusManager
@implements IAsyncDisposable

@*
    PopoverContent 是浮层内容的主容器。
    使用 FloatingPortal 承接门户/定位基础设施。
    自身只保留 Popover 专属行为：点击外部、Escape 键、ARIA 特性。
*@

<FloatingPortal IsOpen="@(Context.IsOpen && Context.State.TriggerElement.HasValue)"
                AnchorElement="@Context.State.TriggerElement"
                PortalId="@_portalId"
                Side="@Side"
                Align="@Align"
                Offset="@Offset"
                MatchAnchorWidth="@MatchTriggerWidth"
                Strategy="@Strategy"
                ZIndex="@ZIndex"
                ForceMount="@ForceMount"
                SideElementId="@Context.ContentId"
                ScrollToCurrentIn="@(ScrollToSelected ? Context.ContentId : null)"
                ScrollToCurrentSelector="@ScrollToSelectedSelector"
                AutoFocusId="@AutoFocusId"
                RestoreFocusToId="@Context.TriggerId"
                RestoreFocusOnClose="@Context.State.RestoreFocusOnClose"
                Dismiss="@BuildDismissOptions()"
                OnDismiss="@HandleDismissAsync"
                OnReady="@_readyCallback">
    @RenderPopoverContent()
</FloatingPortal>

@code {
    [CascadingParameter]
    private PopoverContext Context { get; set; } = null!;

    /// <summary>
    /// 在浮层内渲染的内容。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 应用到内容容器的额外属性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// 返回移除了已显式处理参数的 AdditionalAttributes。
    /// </summary>
    private Dictionary<string, object>? FilteredAttributes
    {
        get
        {
            if (AdditionalAttributes == null) return null;
            
            var filtered = new Dictionary<string, object>();
            foreach (var kvp in AdditionalAttributes)
            {
                var key = kvp.Key.ToLowerInvariant();
                if (key != "scrolltoselected" &&
                    key != "scrolltoselectedselector" &&
                    key != "autofocusid" &&
                    key != "closeonescape" &&
                    key != "closeonclickoutside" &&
                    key != "side" &&
                    key != "align" &&
                    key != "offset" &&
                    key != "matchtriggerwidth" &&
                    key != "strategy" &&
                    key != "zindex" &&
                    key != "onescapekeydown" &&
                    key != "onclickoutside" &&
                    key != "role" &&
                    key != "forcemount" &&
                    key != "oncontentready")
                {
                    filtered[kvp.Key] = kvp.Value;
                }
            }
            
            return filtered.Count > 0 ? filtered : null;
        }
    }

    /// <summary>
    /// 每次浮层打开时，是否在它显现之前把当前选中项滚动进视野。
    /// </summary>
    /// <remarks>
    /// 供浮层里的列表内容——比如组合框——使用：没有它，无论选中值在列表多深处，
    /// 重新打开时列表都从头显示。滚动发生在定位浮层的同一次 interop 调用里，
    /// 不额外花往返，列表在首帧上屏时就已停在正确位置。
    /// </remarks>
    [Parameter]
    public bool ScrollToSelected { get; set; }

    /// <summary>
    /// <see cref="ScrollToSelected"/> 用来识别选中项的 CSS 选择器。
    /// </summary>
    [Parameter]
    public string ScrollToSelectedSelector { get; set; } = "[role=\"option\"][aria-selected=\"true\"]";

    /// <summary>
    /// 浮层显现后一帧之内要聚焦的元素 <c>id</c>。
    /// </summary>
    /// <remarks>
    /// 供搜索框之类使用。聚焦发生在定位浮层的 interop 调用之内，不额外花往返——
    /// 而若从 <see cref="OnContentReady"/> 里聚焦，回调运行前就要一次往返，
    /// <c>FocusAsync</c> 又是一次。
    /// </remarks>
    [Parameter]
    public string? AutoFocusId { get; set; }

    /// <summary>
    /// 按 Escape 是否应关闭浮层。默认为 true。
    /// </summary>
    [Parameter]
    public bool CloseOnEscape { get; set; } = true;

    /// <summary>
    /// 点击浮层外部是否应关闭浮层。默认为 true。
    /// </summary>
    [Parameter]
    public bool CloseOnClickOutside { get; set; } = true;

    /// <summary>
    /// 首选方位。默认为 Bottom。
    /// </summary>
    [Parameter]
    public PopoverSide Side { get; set; } = PopoverSide.Bottom;

    /// <summary>
    /// 相对触发元素的对齐方式。默认为 Center。
    /// </summary>
    [Parameter]
    public PopoverAlign Align { get; set; } = PopoverAlign.Center;

    /// <summary>
    /// 与触发元素的偏移距离（像素）。默认为 4。
    /// </summary>
    [Parameter]
    public int Offset { get; set; } = 4;

    /// <summary>
    /// 浮层宽度是否与触发元素一致。默认为 false。
    /// </summary>
    [Parameter]
    public bool MatchTriggerWidth { get; set; } = false;

    /// <summary>
    /// CSS 定位策略。
    /// 默认为 <see cref="PositioningStrategy.Fixed"/>，以正确逃出堆叠上下文
    /// （例如位于 Dialog、Sheet、Drawer 之内时）。
    /// 仅当浮层应随容器一起滚动时使用 <see cref="PositioningStrategy.Absolute"/>。
    /// </summary>
    [Parameter]
    public PositioningStrategy Strategy { get; set; } = PositioningStrategy.Fixed;

    /// <summary>
    /// 浮层内容的 CSS z-index。
    /// 默认为 9999，以便渲染在遮罩层（Dialog、Sheet、Drawer）之上。
    /// </summary>
    [Parameter]
    public int ZIndex { get; set; } = 9999;

    /// <summary>
    /// 按下 Escape 键时触发的回调。
    /// </summary>
    [Parameter]
    public EventCallback<KeyboardEventArgs> OnEscapeKeyDown { get; set; }

    /// <summary>
    /// 点击浮层外部时触发的回调。
    /// </summary>
    [Parameter]
    public EventCallback OnClickOutside { get; set; }

    /// <summary>
    /// 浮层内容的 ARIA role。
    /// 按 WAI-ARIA 1.2 对交互式浮层的建议，默认为 "dialog"。
    /// 无需 role 的简单补充内容可设为 null。
    /// </summary>
    [Parameter]
    public string? Role { get; set; } = "dialog";

    /// <summary>
    /// 关闭后是否把内容继续挂载在 DOM 里。
    /// 为 true 时可让 CSS 退场动画播完。默认为 false。
    /// </summary>
    [Parameter]
    public bool ForceMount { get; set; } = false;

    /// <summary>
    /// 浮层内容完全就绪（已定位且可见）时触发的回调。
    /// 用于焦点管理等场景。
    /// </summary>
    [Parameter]
    public EventCallback OnContentReady { get; set; }

    private bool _disposed = false;
    private string _portalId = "";

    // 只有在使用者要求了 OnContentReady 时才把它交给门户。门户从 OnAfterRenderAsync 里
    // 发出 OnReady——在 Blazor Server 上这已经落后渲染一个往返——而 EventCallback
    // 又会重渲染它的接收方，于是每次打开再花一个往返。库里没有任何东西监听
    // Context.OnContentReady，所以没有使用者回调时，整趟流程就是一次通知了
    // 所有人的空往返。只创建一次：每次渲染新建的 EventCallback 会被读作"参数变了"，
    // 反过来让门户每帧都重渲染。
    private EventCallback _readyCallback;

    protected override void OnInitialized()
    {
        if (OnContentReady.HasDelegate)
        {
            _readyCallback = EventCallback.Factory.Create(this, HandleFloatingReady);
        }

        if (Context == null)
        {
            throw new InvalidOperationException(
                "PopoverContent 必须配合 Popover 组件使用。" +
                "请确保 PopoverContent 是某个 Popover 组件的子组件。");
        }

        _portalId = $"popover-portal-{Context.ContentId}";

        // 订阅上下文变化
        Context.OnStateChanged += HandleContextStateChanged;
    }

    private RenderFragment RenderPopoverContent() => __builder =>
    {
        <div id="@Context.ContentId"
             role="@Role"
             tabindex="-1"
             @onkeydown="HandleKeyDown"
             @attributes="FilteredAttributes"
             data-state="@(Context.IsOpen ? "open" : "closed")"
             data-side="@Side.ToValue()">
            @ChildContent
        </div>
    };

    // data-side 如今由 JS 通过上面的 SideElementId 来写。
    // 过去把它绕道 C#，意味着为记录一个浏览器早就完成的测量要付出一次渲染批次——
    // 在 Blazor Server 上即一次往返——而且它落在算出位置与揭示元素之间，
    // 于是一个发生翻转的浮层，在任何东西出现之前先为重渲染买了单。

    private async Task HandleFloatingReady()
    {
        // 通知订阅方内容已就绪（供焦点管理等使用）
        Context.NotifyContentReady();

        // 若提供了参数回调，也一并调用
        if (OnContentReady.HasDelegate)
        {
            await OnContentReady.InvokeAsync();
        }
    }

    // 只做声明，不在此接线。FloatingPortal 把两个监听器
    // 放进了定位并揭示内容的同一次 interop 调用里；事后在这里再接，每个都要花
    // 一次网络往返，而在它们落地之前，浮层已经上屏却对外部点击充耳不闻。
    //
    // Escape 监听在 document 上，而不是内容元素上。元素级处理器只有当焦点
    // 已经在浮层内时才看得见这个键，而打开浮层并不会移动焦点——焦点留在触发器上，
    // 内容经门户渲染后两者根本不在同一棵子树里。于是 keydown 从来冒泡不到
    // 内容附近，Escape 形同虚设：浮层开着，触发器 pointer-events 被禁，
    // 键盘用户没有任何办法关掉它。
    private FloatingDismissOptions? BuildDismissOptions()
    {
        if (!Context.AllowDismiss || (!CloseOnClickOutside && !CloseOnEscape))
        {
            return null;
        }

        return new FloatingDismissOptions
        {
            ContentId = Context.ContentId,
            TriggerId = Context.TriggerId,
            OnOutsideInteraction = CloseOnClickOutside,
            OnEscapeKey = CloseOnEscape
        };
    }

    private Task HandleDismissAsync(FloatingDismissReason reason) => reason switch
    {
        FloatingDismissReason.EscapeKey => HandleEscapeDismissAsync(),
        _ => HandleOutsideDismissAsync()
    };

    private async Task HandleEscapeDismissAsync()
    {
        if (_disposed || !Context.IsOpen || !Context.AllowDismiss || !CloseOnEscape) return;

        if (OnEscapeKeyDown.HasDelegate)
        {
            await OnEscapeKeyDown.InvokeAsync(new KeyboardEventArgs { Key = "Escape" });
        }

        // Escape 是有意为之的消除——把焦点归还给触发器。
        Context.Close(restoreFocus: true);
    }

    private async Task HandleOutsideDismissAsync()
    {
        if (_disposed || !Context.IsOpen) return;

        if (OnClickOutside.HasDelegate)
        {
            await OnClickOutside.InvokeAsync();
        }

        if (CloseOnClickOutside && Context.AllowDismiss)
        {
            Context.Close();
        }
    }

    private void HandleContextStateChanged()
    {
        _ = InvokeAsync(HandleContextStateChangedAsync);
    }

    private Task HandleContextStateChangedAsync()
    {
        try
        {
            if (!Context.IsOpen)
            {
                // 在拆退场之前同时捕获触发元素引用与焦点归还标志。
                // 焦点经上面门户的 RestoreFocusToId 与 RestoreFocusOnClose，
                // 在 overlay.close 内部回到触发元素——且仅限有意关闭。
                // 过去在这里 await FocusAsync，每次 Escape 都要花一次往返。
                StateHasChanged();
            }
            // 打开沿刻意不调 StateHasChanged。Popover 在每次上下文
            // 变化时无条件重渲染（#437），而本内容就在它的子树里，同一个批次里已经被
            // 重渲染过了。这里再渲染一次，会让 FloatingPortal 在使用者的渲染周期
            // 仍未结束时就 RaiseRefreshPortal——宿主刚刚在同一批次里画过这份内容——
            // 宿主无法把它与真正的周期内更新区分开（#418），只好推迟一次刷新，
            // 而那场刷新落在遮罩早已上屏之后一个往返。每次打开都要为此买单。
        }
        catch (Exception ex) when (ex is ObjectDisposedException or TaskCanceledException)
        {
            // 组件可能在异步操作中被释放
        }

        return Task.CompletedTask;
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            // 若提供了自定义处理器，先调用它
            if (OnEscapeKeyDown.HasDelegate)
            {
                await OnEscapeKeyDown.InvokeAsync(args);
            }

            // 按配置关闭浮层
            if (CloseOnEscape && Context.AllowDismiss)
            {
                // Escape 是有意为之的消除——把焦点归还给触发器。
                Context.Close(restoreFocus: true);
            }
        }
    }

    public ValueTask DisposeAsync()
    {
        if (_disposed) { return ValueTask.CompletedTask; }
        _disposed = true;

        // 消除监听器以及它们回调进来的 .NET 引用如今都归 FloatingPortal 所有，
        // 遮罩关闭时由它一并释放。这里已没有任何东西可能抛进渲染器的拆退场队列。
        if (Context != null)
        {
            Context.OnStateChanged -= HandleContextStateChanged;
        }

        return ValueTask.CompletedTask;
    }
}
