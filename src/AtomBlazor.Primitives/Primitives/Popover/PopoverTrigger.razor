@namespace AtomBlazor.Primitives
@using AtomBlazor.Primitives.Utilities
@inject IServiceProvider Services

@* Popover 触发器——点击时打开浮层 *@
@if (AsChild)
{
    @* AsChild 为 true 时，把触发上下文传给子组件，由它自己处理 *@
    <CascadingValue Value="GetTriggerContext()" Name="TriggerContext">
        @ChildContent
    </CascadingValue>
}
else
{
    <button type="button"
            id="@Context.TriggerId"
            @ref="@_triggerRef"
            @onclick="HandleClick"
            @attributes="FilteredAttributes"
            aria-haspopup="true"
            aria-expanded="@Context.IsOpen.ToString().ToLower()"
            aria-controls="@Context.ContentId"
            style="@(Context.IsOpen ? "pointer-events: none;" : "")">
        @ChildContent
    </button>
}

@code {
    [CascadingParameter]
    private PopoverContext Context { get; set; } = null!;

    private ElementReference _triggerRef;

    /// <summary>
    /// 显示在触发按钮内的内容。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 为 true 时，触发器不渲染自己的 button 元素，
    /// 而是通过 TriggerContext 把触发行为传给子组件。
    /// 子组件必须消费 TriggerContext 并应用点击/ARIA 行为。
    /// </summary>
    [Parameter]
    public bool AsChild { get; set; } = false;

    /// <summary>
    /// 应用到触发 button 元素的额外属性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// 返回移除了已显式处理参数（aschild, onclick, customclickhandling）的 AdditionalAttributes。
    /// </summary>
    private Dictionary<string, object>? FilteredAttributes
    {
        get
        {
            if (AdditionalAttributes == null) return null;
            
            var filtered = new Dictionary<string, object>();
            foreach (var kvp in AdditionalAttributes)
            {
                var key = kvp.Key.ToLowerInvariant();
                if (key != "aschild" && 
                    key != "onclick" && 
                    key != "customclickhandling")
                {
                    filtered[kvp.Key] = kvp.Value;
                }
            }
            
            return filtered.Count > 0 ? filtered : null;
        }
    }

    /// <summary>
    /// 自定义点击处理器。提供时，会在默认切换行为之外一并调用。
    /// </summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>
    /// 是否只使用自定义点击处理。为 true 时只调用 OnClick。
    /// 默认为 false（点击即打开浮层）。
    /// </summary>
    [Parameter]
    public bool CustomClickHandling { get; set; } = false;

    /// <summary>
    /// AsChild 模式下存放触发元素引用。
    /// </summary>
    private ElementReference? _asChildTriggerRef;

    private static readonly AsChildTriggerDescription diagnostic = new("PopoverTrigger", "打开这个浮层", "<button>");

    /// <summary>
    /// 缓存的 TriggerContext，避免不必要的 CascadingValue 变化传播。
    /// 仅当依赖项（IsOpen、TriggerId、ContentId）真正变化时才重建。
    /// </summary>
    private TriggerContext? _cachedTriggerContext;
    private bool _cachedIsOpen;
    private string? _cachedTriggerId;
    private string? _cachedContentId;

    private TriggerContext GetTriggerContext()
    {
        if (_cachedTriggerContext == null ||
            _cachedIsOpen != Context.IsOpen ||
            _cachedTriggerId != Context.TriggerId ||
            _cachedContentId != Context.ContentId)
        {
            _cachedIsOpen = Context.IsOpen;
            _cachedTriggerId = Context.TriggerId;
            _cachedContentId = Context.ContentId;
            _cachedTriggerContext = new TriggerContext
            {
                TriggerId = Context.TriggerId,
                IsOpen = Context.IsOpen,
                // Toggle 现在只在关闭状态下执行打开（规避 Blazor 事件路由的边界情形）
                Toggle = () => { if (!Context.IsOpen) Context.Open(_asChildTriggerRef); },
                Open = () => Context.Open(_asChildTriggerRef),
                Close = () => Context.Close(),
                AriaHasPopup = "true",
                AriaControls = Context.ContentId,
                SetTriggerElement = (ElementReference el) => _asChildTriggerRef = el,
                // 与非 AsChild 触发按钮的 pointer-events 守卫保持一致
                SuppressPointerEventsWhenOpen = true
            };
        }
        return _cachedTriggerContext;
    }

    private async Task HandleClick(MouseEventArgs args)
    {
        // 重要：触发器只负责"打开"浮层，绝不负责关闭。
        // 关闭由点击外部检测或显式的关闭动作处理。
        // 这规避了 Blazor Server 的事件路由边界情形——组件重渲染期间，
        // 浮层内容内部的点击可能错误地触发触发器自己的点击处理器。
        if (Context.IsOpen)
        {
            return;
        }

        if (CustomClickHandling && OnClick.HasDelegate)
        {
            // 仅执行自定义处理
            await OnClick.InvokeAsync(args);
        }
        else
        {
            // 默认：打开浮层，并记下触发元素供定位使用
            Context.Open(_triggerRef);

            // 若提供了自定义处理器，也一并调用
            if (OnClick.HasDelegate)
            {
                await OnClick.InvokeAsync(args);
            }
        }
    }

    protected override void OnInitialized()
    {
        if (Context == null)
        {
            throw new InvalidOperationException(
                "PopoverTrigger 必须配合 Popover 组件使用。" +
                "请确保 PopoverTrigger 是某个 Popover 组件的子组件。");
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // 主动写入触发元素引用，确保即使浮层被程序化打开（经 @bind-Open）时它也可用。
        // 每次渲染后都会执行，保证引用不过期。
        if (!AsChild)
        {
            Context.SetTriggerElement(_triggerRef);
        }
        else if (_asChildTriggerRef.HasValue)
        {
            // AsChild 模式下，子组件（例如 Button）通过 TriggerContext.SetTriggerElement
            // 写入 _asChildTriggerRef。我们需要把它传播到上下文，
            // 让 Content 能相对它定位。
            Context.SetTriggerElement(_asChildTriggerRef.Value);
        }

        if (firstRender)
        {
            AsChildDiagnostics.WarnIfUnconsumed<PopoverTrigger>(Services, diagnostic, AsChild, _cachedTriggerContext, AdditionalAttributes);
        }
    }
}
