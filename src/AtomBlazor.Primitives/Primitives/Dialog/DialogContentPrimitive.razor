@namespace AtomBlazor.Primitives
@using System.ComponentModel
@using Microsoft.Extensions.Logging
@using AtomBlazor.Primitives.Services
@inject IFocusManager FocusManager
@inject IJSRuntime JSRuntime
@inject INativeOverlayService NativeOverlayService
@inject ILogger<DialogContentPrimitive> Logger
@implements IAsyncDisposable

@*
    DialogContentPrimitive 是 Dialog 的主内容容器。
    - JS 策略（默认）：渲染一个 div，使用 JS 焦点陷阱、Esc 键和滚动锁定。
    - Native 策略：渲染由 showModal()/close() 驱动的 <dialog> 元素。浏览器提供
      顶层、焦点陷阱、Esc 处理和 ::backdrop，因此 JS 的焦点陷阱 / 滚动锁定 / Esc 模块都被跳过。
      Native 渲染不需要门户宿主，且可跨越 Blazor 渲染模式边界（例如 InteractiveWebAssembly）。
*@

@if (_useNative)
{
    @if (Context.IsOpen)
    {
        <dialog @ref="_contentRef"
                id="@Context.ContentId"
                aria-labelledby="@Context.TitleId"
                aria-describedby="@Context.DescriptionId"
                @attributes="AdditionalAttributes"
                data-state="open">
            @ChildContent
        </dialog>
    }
}
else if (Context.IsOpen)
{
    <div @ref="_contentRef"
         id="@Context.ContentId"
         role="dialog"
         aria-modal="true"
         aria-labelledby="@Context.TitleId"
         aria-describedby="@Context.DescriptionId"
         tabindex="-1"
         @attributes="AdditionalAttributes"
         data-state="open">
        @ChildContent
    </div>
}

@code {
    [CascadingParameter]
    private DialogContext Context { get; set; } = null!;

    [CascadingParameter(Name = "DialogRenderingStrategy")]
    private OverlayRenderingStrategy? RenderingStrategy { get; set; }

    /// <summary>
    /// 要在 Dialog 内渲染的内容。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 应用到内容容器的额外属性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// 是否按下 Esc 键时关闭 Dialog。
    /// 默认值为 true。
    /// </summary>
    [Parameter]
    public bool CloseOnEscape { get; set; } = true;

    /// <summary>
    /// 点击遮罩（背景）是否应关闭 Dialog。
    /// 仅限 Native 策略：浏览器的 ::backdrop 默认不可用于关闭，
    /// 因此通过背景点击监听器来响应此设置。
    /// 默认值为 true。
    /// </summary>
    [Parameter]
    public bool CloseOnOverlayClick { get; set; } = true;

    /// <summary>
    /// 是否在 Dialog 内捕获焦点（焦点陷阱）。
    /// 模态 Dialog 默认为 true。
    /// <para>
    /// 在 <see cref="OverlayRenderingStrategy.Native"/> 下，浏览器的 <c>&lt;dialog&gt;</c>
    /// 对模态始终会捕获焦点，因此在该模式下将此设为 <c>false</c> 不会生效。
    /// </para>
    /// </summary>
    [Parameter]
    public bool TrapFocus { get; set; } = true;

    /// <summary>
    /// 建立焦点陷阱时要聚焦的目标。默认聚焦第一个可 Tab 进入的后代元素。
    /// </summary>
    /// <remarks>
    /// 当第一个可 Tab 进入的子元素在聚焦时有副作用时，将此设为 <see cref="FocusTrapInitialFocus.Container"/>，
    /// 或使用 <see cref="InitialFocusElement"/> 指定一个目标。
    /// 带有 <c>data-autofocus</c> 的元素优先级高于此设置。
    /// </remarks>
    [Parameter]
    public FocusTrapInitialFocus InitialFocus { get; set; } = FocusTrapInitialFocus.FirstFocusable;

    /// <summary>
    /// 建立焦点陷阱时要聚焦的显式元素，优先级高于 <see cref="InitialFocus"/>
    /// 以及任何 <c>data-autofocus</c> 元素。当它不在 Dialog 内部时将被忽略。
    /// </summary>
    [Parameter]
    public ElementReference? InitialFocusElement { get; set; }

    /// <summary>
    /// Dialog 打开时是否锁定 body 滚动。
    /// 模态 Dialog 默认为 true。
    /// <para>
    /// 在 <see cref="OverlayRenderingStrategy.Native"/> 下不会应用此设置：<c>showModal()</c>
    /// 会使背景对交互无效，但并不会阻止其滚动，且 Native 路径上没有滚动锁定。
    /// </para>
    /// </summary>
    [Parameter]
    public bool LockScroll { get; set; } = true;

    /// <summary>
    /// 按下 Esc 键时触发的事件回调。
    /// </summary>
    [Parameter]
    public EventCallback<KeyboardEventArgs> OnEscapeKeyDown { get; set; }

    private ElementReference _contentRef;
    private IAsyncDisposable? _focusTrap;
    private IJSObjectReference? _portalModule;
    private IJSObjectReference? _scrollLockCleanup;
    private IJSObjectReference? _escapeModule;
    private DotNetObjectReference<DialogContentPrimitive>? _dotNetRef;
    private string _instanceId = Guid.NewGuid().ToString("N");
    private bool _isInitialized = false;
    private bool _disposed;
    private bool _useNative;
    private bool _nativeInitialized = false;
    private IAsyncDisposable? _nativeDialogSetup;

    protected override void OnInitialized()
    {
        if (Context == null)
        {
            throw new InvalidOperationException(
                "DialogContentPrimitive must be used within a Dialog component. " +
                "Ensure DialogContentPrimitive is a child of a Dialog component.");
        }

        _useNative = NativeOverlayService.ResolveStrategy(RenderingStrategy) == OverlayRenderingStrategy.Native;

        // 订阅上下文变更
        Context.OnStateChanged += HandleContextStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_useNative)
        {
            await HandleNativeLifecycleAsync();
            return;
        }

        await HandleJsLifecycleAsync();
    }

    private async Task HandleNativeLifecycleAsync()
    {
        if (Context.IsOpen && !_nativeInitialized)
        {
            _nativeInitialized = true;

            try
            {
                // 请求了 Native 但浏览器不支持 showModal()。此时 <dialog> 元素会渲染却永远进不了顶层：
                // 没有背景、没有焦点陷阱、没有 Esc —— 只是名义上的 Dialog。与其只发出警告，不如把该组件
                // 以及之后解析的所有浮层都切换到 JavaScript 策略。
                // 这里返回 false 也可能只是互操作短暂不可用，因此应信任服务自身的解析结果而非原始返回值：
                // 服务只有在浏览器实际应答之后才会停止解析为 Native。
                if (!await NativeOverlayService.IsDialogSupportedAsync()
                    && NativeOverlayService.ResolveStrategy(RenderingStrategy) != OverlayRenderingStrategy.Native)
                {
                    Logger.LogWarning(
                        "Dialog '{DialogId}' uses OverlayRenderingStrategy.Native but the browser does not support " +
                        "<dialog>.showModal(); falling back to the JavaScript strategy.", Context.ContentId);

                    _useNative = false;
                    _nativeInitialized = false;
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                _dotNetRef ??= DotNetObjectReference.Create(this);
                _nativeDialogSetup = await NativeOverlayService.SetupDialogAsync(_contentRef, _dotNetRef);

                await NativeOverlayService.ShowDialogAsync(_contentRef);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException or InvalidOperationException)
            {
                // 在电路断开或预渲染期间属预期情况。
            }
        }
        else if (!Context.IsOpen && _nativeInitialized)
        {
            await CleanupNativeAsync();
        }
    }

    private async Task HandleJsLifecycleAsync()
    {
        if (Context.IsOpen && !_isInitialized)
        {
            _isInitialized = true;

            // 建立焦点陷阱
            if (TrapFocus)
            {
                try
                {
                    _focusTrap = await FocusManager.TrapFocus(_contentRef, InitialFocus, InitialFocusElement);
                }
                catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
                {
                    // 在 Blazor Server 电路断开期间属预期情况。
                }
                catch (InvalidOperationException)
                {
                    // 预渲染期间 JS 互操作不可用
                }
            }

            // 锁定 body 滚动
            if (LockScroll)
            {
                try
                {
                    _portalModule = await PrimitiveModules.GetAsync(JSRuntime);
                    _scrollLockCleanup = await _portalModule.InvokeAsync<IJSObjectReference>("portal.lockBodyScroll");
                }
                catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
                {
                    // 在电路断开或模块加载失败时属预期情况。
                }
                catch (InvalidOperationException)
                {
                    // 预渲染期间 JS 互操作不可用
                }
            }

            // 在 JS 中建立 Esc 键检测（避免每次按键都往返 C#）
            try
            {
                _escapeModule = await PrimitiveModules.GetAsync(JSRuntime);
                _dotNetRef = DotNetObjectReference.Create(this);
                await _escapeModule.InvokeVoidAsync("escapeKeydown.initialize", _dotNetRef, _instanceId);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
            {
                // Expected during circuit disconnect or module loading failure
            }
            catch (InvalidOperationException)
            {
                // JS interop not available during prerendering
            }
        }
        else if (!Context.IsOpen && _isInitialized)
        {
            await CleanupJsAsync();
        }
    }

    private void HandleContextStateChanged()
    {
        if (!Context.IsOpen && (_isInitialized || _nativeInitialized))
        {
            // Dialog 已关闭，在 Blazor 同步上下文上进行清理
            _ = InvokeAsync(async () =>
            {
                if (_useNative)
                {
                    await CleanupNativeAsync();
                }
                else
                {
                    await CleanupJsAsync();
                }
                StateHasChanged();
            });
            return;
        }

        StateHasChanged();
    }

    // ---- Native Dialog 事件（由 native-dialog.js 调用）----

    [JSInvokable]
    [EditorBrowsable(EditorBrowsableState.Never)]
    public async Task JsOnNativeCancel()
    {
        if (_disposed) { return; }

        if (OnEscapeKeyDown.HasDelegate)
        {
            await OnEscapeKeyDown.InvokeAsync(new KeyboardEventArgs { Key = "Escape" });
        }

        if (CloseOnEscape && Context.AllowDismiss)
        {
            await CloseNativeDialogAsync();
            Context.Close();
        }
    }

    [JSInvokable]
    [EditorBrowsable(EditorBrowsableState.Never)]
    public Task JsOnNativeClose()
    {
        if (_disposed) { return Task.CompletedTask; }

        // 安全网：若 Dialog 通过原生方式关闭，则同步状态。
        if (Context.IsOpen)
        {
            Context.Close();
        }

        return Task.CompletedTask;
    }

    [JSInvokable]
    [EditorBrowsable(EditorBrowsableState.Never)]
    public async Task JsOnNativeBackdropClick()
    {
        if (_disposed) { return; }

        if (CloseOnOverlayClick && Context.AllowDismiss)
        {
            await CloseNativeDialogAsync();
            Context.Close();
        }
    }

    /// <summary>
    /// 在打开状态翻转为 <c>false</c>、元素被卸载之前，关闭原生的 <c>&lt;dialog&gt;</c> 元素本身，
    /// 并将焦点恢复到触发器。
    /// 通过元素关闭（而非依赖 Blazor 将其从 DOM 中移除）才能让浏览器把焦点还给
    /// <c>showModal()</c> 之前拥有焦点的元素。
    /// </summary>
    private async Task CloseNativeDialogAsync()
    {
        try
        {
            await NativeOverlayService.CloseDialogAsync(_contentRef);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
        {
            // Expected during circuit disconnect.
        }
    }

    // ---- JS 策略（遗留）----

    [JSInvokable]
    [EditorBrowsable(EditorBrowsableState.Never)]
    public async Task JsOnEscapeKey()
    {
        if (_disposed) { return; }

        // 若提供了自定义处理程序则触发
        if (OnEscapeKeyDown.HasDelegate)
        {
            await OnEscapeKeyDown.InvokeAsync(new KeyboardEventArgs { Key = "Escape" });
        }

        // 若已配置则关闭 Dialog
        if (CloseOnEscape && Context.AllowDismiss)
        {
            Context.Close();
        }
    }

    private async Task CleanupNativeAsync()
    {
        if (_nativeDialogSetup != null)
        {
            try
            {
                await _nativeDialogSetup.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
            {
                // 清理对象可能已被释放或电路已断开。
            }
            _nativeDialogSetup = null;
        }

        // 若 Dialog 被遗留为打开状态（例如 ForceMount 使其保持挂载），则确保其已关闭。
        if (Context.IsOpen == false)
        {
            try
            {
                await NativeOverlayService.CloseDialogAsync(_contentRef);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
            {
                // 在电路断开期间属预期情况。
            }
        }

        _nativeInitialized = false;
    }

    private async Task CleanupJsAsync()
    {
        // 释放焦点陷阱
        if (_focusTrap != null)
        {
            await _focusTrap.DisposeAsync();
            _focusTrap = null;
        }

        // 解锁 body 滚动
        if (_scrollLockCleanup != null)
        {
            try
            {
                await _scrollLockCleanup.InvokeVoidAsync("apply");
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
            {
                // 清理对象可能已被释放或电路已断开
            }
            _scrollLockCleanup = null;
        }

        // 移除 Esc 键监听器
        if (_escapeModule != null)
        {
            try
            {
                await _escapeModule.InvokeVoidAsync("escapeKeydown.dispose", _instanceId);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
            {
                // 清理对象可能已被释放或电路已断开
            }
        }

        _dotNetRef?.Dispose();
        _dotNetRef = null;

        _isInitialized = false;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        if (_useNative)
        {
            await CleanupNativeAsync();
        }
        else
        {
            await CleanupJsAsync();
        }



        _dotNetRef?.Dispose();

        if (Context != null)
        {
            Context.OnStateChanged -= HandleContextStateChanged;
        }
    }
}
