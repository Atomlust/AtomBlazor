@namespace AtomBlazor.Primitives
@using AtomBlazor.Primitives.Utilities
@inject IServiceProvider Services

@*
    DialogClosePrimitive 提供一个用于关闭 Dialog 的按钮。
    可以在一个 Dialog 中多次使用（例如 X 关闭按钮、取消按钮等）。
*@

@if (AsChild)
{
    @* 当 AsChild 为 true 时，将触发器上下文传给子组件由其处理 *@
    <CascadingValue Value="TriggerContext" Name="TriggerContext">
        @ChildContent
    </CascadingValue>
}
else
{
    <button type="button"
            @onclick="HandleClick"
            @attributes="AdditionalAttributes">
        @ChildContent
    </button>
}

@code {
    [CascadingParameter]
    private DialogContext Context { get; set; } = null!;

    /// <summary>
    /// 显示在关闭按钮内部的 content（内容）。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 为 true 时，关闭组件不渲染自身的按钮元素。
    /// 而是将触发器行为通过 TriggerContext 传递给子组件。
    /// 当你希望某个自定义组件（如 Button）充当关闭按钮时使用。
    /// </summary>
    [Parameter]
    public bool AsChild { get; set; } = false;

    /// <summary>
    /// 应用到关闭按钮元素上的额外属性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// 自定义 click 处理程序。在 Dialog 关闭之后调用。
    /// </summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>
    /// 是否阻止默认的关闭行为。
    /// 为 true 时，仅触发 OnClick 处理程序。
    /// 默认值为 false（点击即关闭 Dialog）。
    /// </summary>
    [Parameter]
    public bool PreventClose { get; set; } = false;

    private static readonly AsChildTriggerDescription diagnostic = new("DialogClosePrimitive (or AlertDialogActionPrimitive or AlertDialogCancelPrimitive, which are built on it)", "close this dialog", "<button>");

    // 上一次渲染级联的上下文，保留下来以便首次 after-render 时询问是否有内容读取了它。
    private TriggerContext? lastTriggerContext;

    /// <summary>
    /// 当 AsChild 为 true 时传递给子组件的上下文。
    /// 对于关闭按钮，我们只提供 Close（不提供 Toggle），以便 Button
    /// 知道这是一个仅用于关闭的动作。
    /// </summary>
    private TriggerContext TriggerContext => lastTriggerContext = new()
    {
        IsOpen = Context.IsOpen,
        // 注意：Toggle 故意置为 null —— 这告诉 Button 它是一个仅用于关闭的按钮
        Close = () => Context.Close()
    };

    protected override void OnInitialized()
    {
        if (Context == null)
        {
            throw new InvalidOperationException(
                "DialogClosePrimitive must be used within a Dialog component. " +
                "Ensure DialogClosePrimitive is a child of a Dialog component.");
        }
    }

    private async Task HandleClick(MouseEventArgs args)
    {
        if (!PreventClose)
        {
            Context.Close();
        }

        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(args);
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            AsChildDiagnostics.WarnIfUnconsumed<DialogClosePrimitive>(Services, diagnostic, AsChild, lastTriggerContext, AdditionalAttributes);
        }
    }
}
