@namespace AtomBlazor.Primitives

<div data-state="@Context?.DataState"
     data-value="@Context?.Value"
     data-max="@Context?.Max"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [CascadingParameter]
    private ProgressPrimitive? Context { get; set; }

    protected override void OnInitialized()
    {
        if (Context == null)
        {
            throw new InvalidOperationException(
                "ProgressIndicator must be used within a Progress component.");
        }
    }

    /// <summary>
    /// 获取或设置子内容。
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 获取或设置应用到指示器元素上的额外属性。
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// 从父级 Progress 上下文获取完成百分比。不确定状态时为 null。
    /// </summary>
    public double? Percentage => Context?.Percentage;
}
