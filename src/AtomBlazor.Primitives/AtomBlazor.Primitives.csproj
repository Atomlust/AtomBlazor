<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <!-- 裁剪/AOT 兼容分析：trim 警告 + AOT 分析器 -->
    <IsAotCompatible>true</IsAotCompatible>
    <Version>0.2.1</Version>
    <!-- 作者与版权 -->
    <Authors>Atomlust Studio</Authors>
    <Company>Atomlust Studio</Company>
    <Copyright>Copyright © 2026 Atomlust Studio</Copyright>

    <!-- NuGet 包配置 -->
    <PackageId>AtomBlazor.Primitives</PackageId>
    <RootNamespace>AtomBlazor.Primitives</RootNamespace>
    <AssemblyName>AtomBlazor.Primitives</AssemblyName>
    <Description>无样式、可组合的 Blazor 基元组件（Primitives），内置 ARIA 属性与键盘导航支持，可用于构建自有组件库。</Description>
    <PackageTags>blazor;primitives;headless;ui;components;accessibility;aria</PackageTags>

    <!-- CA1716：Select 等命名空间与关键字重名，属领域术语，予以抑制 -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
    <!-- 开发期使用 ProjectReference 打包时会出现 NU5104 预览版本警告（稳定版 0.1.0 依赖 11.0.0-rtm 预发布包），抑制之 -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0-rtm.26480.113" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="/" />
    <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
