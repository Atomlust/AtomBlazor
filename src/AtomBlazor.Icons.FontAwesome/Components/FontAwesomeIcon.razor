@namespace AtomBlazor.Icons.FontAwesome

@if (IconEntry is not null)
{
    <svg
        width="@ComputedSize"
        height="@ComputedHeight"
        viewBox="@ViewBox"
        fill="@Color"
        class="@CssClass"
        role="img"
        aria-label="@AriaLabel"
        @attributes="AdditionalAttributes">
        @((MarkupString)SvgBody)
    </svg>
}
else
{
    @* 图标缺失时的回退显示 *@
    <span class="atom:text-destructive" role="alert" aria-label="Icon not found: @Name (@Variant)">⚠️</span>
}
