<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 裁剪/AOT 兼容分析 -->
    <IsAotCompatible>true</IsAotCompatible>
    <Version>1.0.0</Version>
    <!-- 作者与版权 -->
    <Authors>Atomlust Studio</Authors>
    <Company>Atomlust Studio</Company>
    <Copyright>Copyright © 2026 Atomlust Studio</Copyright>
    <!-- 开发期用 ProjectReference 打包时，被引用项目可能带预览版依赖而触发 NU5104；抑制之，避免开发包构建失败 -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>

    <!-- NuGet 包配置 -->
    <PackageId>AtomBlazor.Icons.FontAwesome</PackageId>
    <RootNamespace>AtomBlazor.Icons.FontAwesome</RootNamespace>
    <AssemblyName>AtomBlazor.Icons.FontAwesome</AssemblyName>
    <Description>AtomBlazor 的 Font Awesome Free 图标库——2066 枚图标，覆盖 3 种变体（solid、regular、brands），供 Blazor 应用使用。</Description>
    <PackageTags>blazor;icons;fontawesome;svg;ui;components</PackageTags>
    <!-- 包装代码 MIT；Font Awesome Free 美术为 CC-BY-4.0，见 THIRD-PARTY-NOTICES.txt -->
    <PackageLicenseExpression>MIT AND CC-BY-4.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" />
  </ItemGroup>

</Project>
