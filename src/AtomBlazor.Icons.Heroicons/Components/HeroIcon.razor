@namespace AtomBlazor.Icons.Heroicons

@if (!string.IsNullOrEmpty(SvgContent))
{
    @if (IsOutline)
    {
        @* Outline 变体：线条风格，带 stroke 属性 *@
        <svg
            width="@ComputedSize"
            height="@ComputedSize"
            viewBox="@ViewBox"
            fill="@Fill"
            stroke="@Stroke"
            stroke-width="@ComputedStrokeWidth"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="@CssClass"
            role="img"
            aria-label="@AriaLabel"
            @attributes="AdditionalAttributes">
            @((MarkupString)SvgContent)
        </svg>
    }
    else
    {
        @* Solid/Mini/Micro 变体：填充风格，无描边 *@
        <svg
            width="@ComputedSize"
            height="@ComputedSize"
            viewBox="@ViewBox"
            fill="@Fill"
            class="@CssClass"
            role="img"
            aria-label="@AriaLabel"
            @attributes="AdditionalAttributes">
            @((MarkupString)SvgContent)
        </svg>
    }
}
else
{
    @* 图标缺失时的回退显示 *@
    <span class="atom:text-destructive" role="alert" aria-label="Icon not found: @Name (@Variant)">⚠️</span>
}
