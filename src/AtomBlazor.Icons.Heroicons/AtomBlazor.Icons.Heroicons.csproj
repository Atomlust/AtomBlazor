<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 裁剪/AOT 兼容分析 -->
    <IsAotCompatible>true</IsAotCompatible>
    <Version>0.2.0</Version>
    <!-- 开发期使用 ProjectReference 打包时会出现 NU5104 预览版本警告（稳定版 0.1.0 依赖 11.0.0-rtm 预发布包），抑制之 -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>

    <!-- NuGet 包配置 -->
    <PackageId>AtomBlazor.Icons.Heroicons</PackageId>
    <RootNamespace>AtomBlazor.Icons.Heroicons</RootNamespace>
    <AssemblyName>AtomBlazor.Icons.Heroicons</AssemblyName>
    <Description>AtomBlazor 的 Heroicons 图标库——1288 枚图标，覆盖 4 种变体（outline、solid、mini、micro），供 Blazor 应用使用。</Description>
    <PackageTags>blazor;icons;heroicons;svg;ui;components</PackageTags>
    <!-- 包装与图标美术均为 MIT，见 THIRD-PARTY-NOTICES.txt -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0-rtm.26480.113" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="/" />
    <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
