<Project>
  <PropertyGroup>
    <!-- 包元数据 - AtomBlazor 全部包公共 -->
    <Authors>AtomBlazor Contributors</Authors>
    <Company>AtomBlazor</Company>
    <Copyright>Copyright (c) 2026 AtomBlazor</Copyright>

    <!-- 包许可：Apache-2.0 -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>

    <!-- 语言与目标框架：.NET 11 / C# 最新预览特性，不做向下兼容 -->
    <LangVersion>preview</LangVersion>

    <!-- 构建配置 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- 内部枚举与生命周期成员缺少 XML 注释的警告抑制 -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- 代码风格强制：构建即规范 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>
  <!-- 裁剪/AOT 兼容分析（IsAotCompatible）不在此集中设置：
       props 求值早于工程自身属性，按条件判断会误伤测试工程；
       由各库 csproj 显式开启 -->
</Project>
